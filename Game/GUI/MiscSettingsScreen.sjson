{
  MiscSettingsScreen =
  {
    Platform = "default"
    CloseSound = "/SFX/Menu Sounds/IrisMenuBack"
    /* NOTE(Dexter) 2/7/2025 -- OpenSound procs on opening every sub-menu. Storing the effective OpenSound in NewUpdateSound
       so that the SFX cue isn't hardcoded in-engine and remains configurable here. This only works for MiscSettingsScreen */
    NewUpdateSound = "/SFX/Menu Sounds/IrisMenuOpen"
    SelectionSound = "/SFX/Menu Sounds/IrisMenuToggle2"
    TransitionOnTime = 0.3
    TransitionOffTime = 0.35
    ForceShowCursor = true
    GamepadSelectionStyle = "FreeForm"
    FreeFormSelectGridLock = true
    FreeFormSelectInitialStepDistance = 24
    FreeFormSelectStepDistance = 16
    FreeFormSelectSuccessDistance = 8
    FreeFormSelectSuccessDistanceStep = 4
