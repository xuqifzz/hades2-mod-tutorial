    }
    {
      Id = "Circe_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是赫卡忒女士的旨意……"
    }
    {
      Id = "Circe_0109"
      InheritFrom = "BaseSubtitle"
