    }
    {
      Id = "Circe_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你，乖孩子。"
    }
    {
      Id = "Circe_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她从未辜负过我们！"
    }
    {
      Id = "Circe_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听到了吗，塞勒涅？"
    }
    {
      Id = "Circe_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "塞勒涅从来不会令人失望！"
    }
    {
      Id = "Circe_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，这真是太好了！看看你这孩子，一转眼都{#Emph}长得多大啦{#Prev}！你还记不记得巫术师喀耳刻呀？啊？噢，无所谓啦，{#Emph}哈哈哈{#Prev}。现在不是寒暄的时候。让我看看你的手相。"
    }
    {
      Id = "MelinoeField_1756"
      InheritFrom = "BaseNarrative"
      DisplayName = "我当然记得您，喀耳刻女士！所以这就是您那座出名的岛屿了！能够踏足这里，而不是登上另一艘沉船，真是令人兴奋。我们在这里相遇应该不是巧合吧？"
    }
    {
      Id = "Circe_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还是那么冰雪聪明！赫卡忒女士跟我讨论之后，决定让我暂时挪个窝，调查一下奥林匹斯山周围的动态。然后，今晚在我的水晶球里，我就看到了{#Emph}你{#Prev}！现在，怎么样才能让你更舒服一些？"
    }
    {
      Id = "Circe_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "乖孩子，我们两个有一个很相像的地方，那就是赫卡忒女士发现我们的时候，我们都恰好正需要像她那样的人。也许那个时候，是我和她同样喜爱野兽这一点让她对我心生怜悯……毕竟，我是个总和“狐朋狗友”为伍的“女巫”！"
    }
    {
      Id = "MelinoeField_1981"
      InheritFrom = "BaseNarrative"
      DisplayName = "怜悯您，这话怎么说？听起来不像是我认识的赫卡忒老师。她一直对您评价很高，而且也信赖您作为我们在这一关键地带的耳目。"
    }
    {
      Id = "Circe_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是我欠她的，而且我欠她的还更多。那时我还年轻，遭到放逐，在研习常常被人冠上莫须有的恶名的巫术时，是赫卡忒女士发现了我，向我展示我的道路并不会通向毁灭，而是会通向和谐。这条路确实道阻且长，但我如今坚定于此，再也不会偏离方向。"
    }
    {
      Id = "Circe_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在我宝石的切面中预见到了，你又一次要向这边来……或者我应该说，是要从这边{#Emph}路过{#Prev}啦。需要些什么药水和药膏，让你一路旅行更加顺利吗？"
    }
    {
      Id = "MelinoeField_1939"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然了，喀耳刻女士，谢谢您。不知道您这里有没有那种让我变得刀枪不入，或者让我沿途能找到大量珍稀材料的东西？"
    }
    {
      Id = "Circe_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "天啊，那可没有，乖孩子。哈！要知道效果越强，副作用就越大，魔法都是这样的。嗯，怎么说呢，创造奇迹也得保持适当的{#Emph}平衡{#Prev}！不知道这些你有没有看得上的？"
    }
    {
      Id = "Circe_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子啊，以前我每次见到你，你都在孜孜不倦地学习！你能抵达这里，就证明了你在学业上取得的成就。我以前总想让你来拜访我，那时候你还说这是不可能的事呢！"
    }
    {
      Id = "MelinoeField_1940"
      InheritFrom = "BaseNarrative"
      DisplayName = "事实证明，就算是命运三女神的预言，也有回旋的余地。不过，我还有许多东西要学……至少我每夜都这样告诫自己。那您呢？您现在对巫术的掌控已经炉火纯青了吧！"
    }
    {
      Id = "Circe_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在该轮到我说，这是不可能的事了！我这一辈子有四分之三的时间都用来研究附魔魔法，可我现在还没能改变哪怕一件事物的本质！我能改变的只有{#Emph}外在{#Prev}。但这样的追求实在是让人着迷！"
    }
    {
      Id = "Circe_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "让那些无穷无尽的幽灵舰队都见鬼去吧，哈！想去众神之山是吧，那得先看看会不会遇上我的小岛！他们那些粗野的船员来到这里，那就算他们倒霉，{#Emph}啊哈哈！{#Prev}而我则正好可以补充一下柴火的储备。"
    }
    {
      Id = "MelinoeField_1941"
      InheritFrom = "BaseNarrative"
      DisplayName = "您一定很怀念您的小岛更为隐蔽，没有这么多不速之客的时候。希望我没有打扰到您，女士！"
    }
    {
      Id = "Circe_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "天啊，当然不会！事实上，只有植物的沙沙声，以及这些小猪的呼哧声的话，有的时候实在是太安静了。你每次回到这里，我都热烈欢迎！"
    }
    {
      Id = "Circe_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎，乖孩子！不过，请原谅我不能邀请你参观我的小小木屋。这样的待遇任何人都享受不到，哼哼！绝对没有例外，哪怕是你也不行！"
    }
    {
      Id = "MelinoeField_1942"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，这个完全没问题。您不需要解释这些的！我们每个人都有自己的小屋，守护着自己的秘密。不然的话，还能怎么样呢？只有有了隐私，才能有心中的宁静啊。"
    }
    {
      Id = "Circe_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能理解真是太好了。最近，我会和野兽分享我朴素的家，但也就如此而已！当然，艾尤岛并不属于我；它是我的好伙伴，也可以是你的。所以，在这里的时候有什么需要的，不用客气，尽管拿就好。"
    }
    {
      Id = "Circe_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "……孩子啊，我一直想问，你究竟是怎么从你的家园出发，千里迢迢来到这里的呢？按我的理解，你在这里应该几乎无法呼吸才对！"
    }
    {
      Id = "MelinoeField_3494"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……女士，我们女巫的格言不是说，万事万物都有咒语应对嘛。具体到这个咒语，感觉几乎就像是在解除一道诅咒一样。"
    }
    {
      Id = "Circe_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "原来如此！不过也许我们每个人都身负某些奇怪的诅咒；要么得学会适应，要么就得找到克服的办法。"
    }
    {
      Id = "Circe_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒女士有的时候会跟我讲述你的进展，她最近告诉我，你终于与那个尘灰祭坛同调啦，吼吼！多么神奇啊……阿卡那之中有那么多可以为我们所用的力量。"
    }
    {
      Id = "MelinoeField_1977"
      InheritFrom = "BaseNarrative"
      DisplayName = "完全同意。通过领悟阿卡那，我发现了我此前从未意识到的力量。真是难以置信，以前我居然只把祭坛当作用来用来冥想、让自己聚精会神的地方。"
    }
    {
      Id = "Circe_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "能让自己聚精会神也很好呀！至少我自己的精力就总是到处分散。至于你天生的力量和魔法的锐利程度，或许还能更上一层楼。"
    }
    {
      Id = "Circe_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你所领悟的阿卡那牌中，有着以我为名的那一份力量。哦，当我像你这么大的时候，是多么渴望赢得“巫术师”的称号！真是世事难料啊。"
    }
    {
      Id = "MelinoeField_3495"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的道路一直对我启发颇深，喀耳刻女士。因为您并没有接受事物本来的面目，而是学会了如何将结果改为对自己有利的样子。据我所知，您做了些大幅度的改动呢。"
    }
    {
      Id = "Circe_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "与其践行我的道路，不如去寻找{#Emph}你自己{#Prev}的路！起初我不是想要改变世界嘛，因为我很讨厌自己看到的事物。但是，在赫卡忒女士的悉心教导下，我现在追求的是更好地理解事物本身……当然也会稍微动点手脚啦，{#Emph}哈哈哈！"
    }
    {
      Id = "MelinoeField_3496"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，关于阿卡那牌，我一直有一个疑惑。有一张牌上画的是您……但她却有着愤怒无比的双眼。那个不是真的您，对吧？"
    }
    {
      Id = "Circe_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子啊，这有谁说得准呢？当然她不是{#Emph}真的我{#Prev}啦，毕竟我就站在这里，而她在你的牌桌上嘛！阿卡那上描绘的只不过是个形象，反映的是{#Emph}你自己{#Prev}内心的力量。或许就连那双眼睛，也是来自于你……"
    }
    {
      Id = "Circe_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在巫术这方面一直都{#Emph}很有天赋！{#Prev}我一直都好奇它会怎么样逐渐改变你，因为钻研巫术的道路上，诱惑实在多得很啊！但你有着最好的老师！"
    }
    {
      Id = "MelinoeField_4524"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒老师常说，{#Emph}最好的老师是外面的世界……{#Prev}她指的可能就是您的岛屿，喀耳刻女士。您所指的诱惑是什么？"
    }
    {
      Id = "Circe_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "我指的是{#Emph}力量{#Prev}，孩子。施展咒语就能让自己如愿以偿，那还有什么{#Emph}拦得住{#Prev}你呢？不尝到教训的话，是没法领悟这个道理的。就比如说，你的左手，就是一个警示……"
    }
    {
      Id = "Circe_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我经常会有把你变成一只鸟儿的冲动，这样你的旅程就不用那么辛苦，但那样的话，你就得舍弃黑夜赐予的武器和炼金材料了……而且抵达众神之山时，一丝不挂的你，恐怕会冻得瑟瑟发抖……"
    }
    {
      Id = "MelinoeField_3521"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢！那还是免了吧，女士。虽然有的时候看到我的同伴们一个个都会飞，难免会让我心里有些嫉妒，但徒步行进也没有什么大不了的。"
    }
    {
      Id = "Circe_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点显而易见，孩子！不过，假如你哪个晚上改变了主意，想要体验一下作为飞禽走兽的生活，一定要立刻告诉我哦，好吗？"
    }
    {
      Id = "Circe_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子呀，虽然这些夜晚让你如此辛苦，但至少你的学习算是告一段落了吧！按赫卡忒女士的话说，你现在一定是在“最好的老师”那里深造呢……"
    }
    {
      Id = "MelinoeField_3522"
      InheritFrom = "BaseNarrative"
      DisplayName = "您说得没错，女士，只不过赫卡忒老师仍然坚持亲自检验我的学习成果；每次我准备离开厄瑞玻斯的边境时，都要与她过招。不过往这边走的时候就不用了！"
    }
    {
      Id = "Circe_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必你在地表所要面对的考验，不会比地底的更加轻松！而且，正是你的刻苦学习，才让你能够走得这么远啊！"
    }
    {
      Id = "Circe_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近赫卡忒女士的状态如何呀？距离我上一次沐浴在她的智慧之中，已经过去好久啦。因为她说我自己有自己的智慧！你一定比我更需要她的关注……"
    }
    {
      Id = "MelinoeField_1980"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，我……我不是有意夺走她对您的关注的。不过赫卡忒老师也不仅是忙着训练我，她还要引领匿踪者、给三岔路口设置防护结界，以及准备夺回属于我们的东西的计划。她期望我们每个人各司其职……她也期望着您。"
    }
    {
      Id = "Circe_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道，我知道……如果我刚刚的话语中流露出了不满的话，我得向你道歉，因为我对你绝对没有任何不满，更不用说对赫卡忒女士了！这点我可以向你{#Emph}保证{#Prev}，乖孩子。只不过……她在我眼中，就像妈妈一样！喔，她听到我这样说的时候气坏了，哈哈！"
    }
    {
      Id = "Circe_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜你身上带着伟大的塞勒涅的祝福啊，我看得出来，乖孩子！虽然明月远在天边，可她一直陪伴着我。而且她的月光还蕴藏着{#Emph}十足{#Prev}的变化魔力！"
    }
    {
      Id = "MelinoeField_1978"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿塞勒涅的光芒永远为我们闪耀，女士。如果不是有她的指引，我很可能无法找到正确的路，无法来到您身边。至于她的魔法……有的时候我会想，也许与其说是让我产生了变化，不如说是揭露了我的本质。"
    }
    {
      Id = "Circe_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "很有这种可能！我们的本质藏在什么地方，谁能说得清楚呢？变化的魔法就是揭示的魔法；当我们变化的时候，我们就会变得更加接近{#Emph}真实的自己{#Prev}。而不是与之背道而驰！"
    }
    {
      Id = "Circe_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么快就来了啊，乖孩子！肯定不只是因为路上{#Emph}顺风顺水{#Prev}而已吧。众神的信使赫尔墨斯为你提了提速，是不是？"
    }
    {
      Id = "MelinoeField_3391"
      InheritFrom = "BaseNarrative"
      DisplayName = "我今夜的确拥有他的祝福。众神虽然忙于战事，但仍然能抽身为我的远行提供助力；只有齐心协力，我们的力量才能达到顶峰。不过，您为什么突然问起这个？"
    }
    {
      Id = "Circe_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "没什么，只是众神对我现在的方位知之甚少，而我希望维持这种状态！毕竟这里容不下多少客人！而且，奥林匹斯众神看到我这么简陋的住所，肯定也会吓一跳吧。"
    }
    {
      Id = "Circe_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近我听到了很多双翅膀扇动的声音。鹰身女妖，飞向奥林匹斯山的围攻；黑色羽毛的纷争化身，在裂谷中兴风作浪……甚至还有那个叫伊卡洛斯的孩子，无拘无束地在空中翱翔！"
    }
    {
      Id = "MelinoeField_3392"
      InheritFrom = "BaseNarrative"
      DisplayName = "他在努力帮助我们……不过我觉得他也在享受自由，毕竟他生前一直活在约束之中；即使是死后化作暗灵，在冥界也有诸多限制。现在，他终于可以所心所欲，飞往自己想去的任何地方了。"
    }
    {
      Id = "Circe_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "尽管如此，他还是想飞来{#Emph}这里{#Prev}！可见他帮助我们的意愿有多么强烈。现在的他，跟他那不辞辛劳的父亲多么相像啊！既然如此，那就祝愿他在这一切结束之前，享受那双自由之翼好了！"
    }
    {
      Id = "Circe_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "外面的世界怎么样了，孩子？唉！我这样隐居在小岛上，恐怕是最后一个知道外面早已天翻地覆、灾祸横行的人吧！"
    }
    {
      Id = "MelinoeField_1979"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，而且这些都是克洛诺斯一人所致。看来{#Emph}时间{#Prev}想要让万物归于终焉，但我们不打算让他就这样肆意妄为。我们会把他的军团赶出奥林匹斯山，从他身下夺回我父亲的王座。"
    }
    {
      Id = "Circe_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，我们这些超凡之人，总是喜欢打打杀杀！这叫{#Emph}凡人{#Prev}怎么把我们当成榜样？不过放心，我也知道，有些战争非打不可，而且我还是会对赫卡忒女士和你鼎力支持。"
    }
    {
      Id = "Circe_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近那个叫美狄亚的连个影都见不着！她的岗位可远没有我的这么怡人，毕竟她得守着那座鬼城。真担心她在那样的地方研究巫术，会沾染上什么坏毛病！"
    }
    {
      Id = "MelinoeField_1982"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近有见过美狄亚女士。她看起来在埃费拉城还蛮自在的，虽然那座城市发生了那样的事情。不过，她一直都像现在这样，独爱诅咒和死灵魔法吗？"
    }
    {
      Id = "Circe_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，自从她长大成人，可以独立思考开始，就是这样了。或者应该说，从她可以保护自己开始。她是我的侄女没错，但她总是对我们血液的{#Emph}其他{#Prev}用途情有独钟。至少她还没有对我下过诅咒，哈哈。啊！但愿没有！"
    }
    {
      Id = "Circe_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里四面环海，一定让你很不安吧，孩子。但是对我来说，这里感觉就像家一样！哪怕是在俄刻阿诺斯的深渊之中，我感受到的舒适也比恐惧要多！"
    }
    {
      Id = "MelinoeField_1985"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在逐渐适应啦。我深入冥界的道路需要我涉足俄刻阿诺斯的外沿。那片水域很美，要是没有那些海妖就更好了。尤其是斯库拉和她的塞壬朋友们……也许您听说过她们？"
    }
    {
      Id = "Circe_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，当然！那是自然。我是在海洋深处长大的，打小就认得斯库拉。她总是在那{#Emph}嚷嚷个不停{#Emph}！吵死我了！也许我现在这么喜欢安静，就是拜她所赐。"
    }
    {
      Id = "Circe_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，那个斯库拉最近怎么样？要不是你说，我都还不知道她跑到你们冥界的深渊里去了。你说她跟几个塞壬勾搭在一起了，是么？她图什么啊，跟她们一起唱歌吗？"
    }
    {
      Id = "MelinoeField_3526"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是的。她一心想着出名，以及把人淹死。迄今为止，我已经不知道多少次被迫阻止她们的演出了。我的那本暗影之书上面说，她是受到了一位女巫的诅咒……您知道这诅咒出自谁手么？"
    }
    {
      Id = "Circe_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那本书一定很有意思！孩子啊，我是不会诅咒的。我的法术都是用来揭露事物的本质。上次我见到斯库拉时，她的本质早已昭然若揭。"
    }
    {
      Id = "Circe_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在想啊，乖孩子，如果那个斯库拉在你深入冥界的路上给你找麻烦的话，说不定我能帮上点忙？不过我得先拿到一样东西：一颗特别的珍珠。"
    }
    {
      Id = "MelinoeField_4340"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？我刚好带着好多从她那里拿的珍珠，您选一颗就好了。不过，还是先告诉我您的打算吧。"
    }
    {
      Id = "Circe_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这些都不行！那颗珍珠一定得带着专门的意图采回来。在一个黑暗恐怖的夜晚，带着溺死她的野心的目的，就像塞壬会对水手做的一样……！可以帮我这个忙吗？"
    }
    {
      Id = "MelinoeField_4341"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许吧，可是……我这样做的话，斯库拉会有什么下场？她确实总是阻挠我，但再怎么说也给俄刻阿诺斯的暗灵带去了些娱乐活动。"
    }
    {
      Id = "Circe_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "她将不会再对你构成威胁。在黑夜的影响力强大时，拿走斯库拉一颗宝贵的珍珠，然后念诵：{#Emph}“愿你的野心就此沉溺。”{#Prev}至少考虑一下？"
    }
    {
      Id = "MelinoeField_4343"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里有一颗从斯库拉那里拿来的珍珠，女士，但我并没有将您的意图融入其中。您说过，您的巫术目的是为了揭露事物的本质。她的本质，我早已一览无遗。"
    }
    {
      Id = "Circe_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以我才建议我们{#Emph}制伏{#Prev}她。不过，现在我明白了，对这种魔法不感兴趣……这也就意味着，你又通过了一道考验，哈哈哈！恭喜你啊，乖孩子！"
    }
    {
      Id = "MelinoeField_4344"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}什么？{#Prev}是老师让您这么干的吗？是要看我会不会仅仅因为可以这样做，就对一个无关紧要的敌人降下诅咒……？"
    }
    {
      Id = "Circe_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "是要看你会不会盲目地遵循长辈的命令。我们的巫术，只有有所克制，才能发挥出最大的效率，这个教训每个人都要自己领悟。当然了，如果斯库拉的威胁变得更大的话，嗯……就来跟我说吧。"
    }
    {
      Id = "Circe_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，我有些好奇，赫卡忒女士现在还会与那个暗灵战术家商量事情吗？就是个头不高，话倒是很多的那个。哦，他叫什么来着……？"
    }
    {
      Id = "MelinoeField_1983"
      InheritFrom = "BaseNarrative"
      DisplayName = "您是指奥德修斯么？他仍是我们的大业之中不可或缺的一份子。我之所以知道这条路线，以及沿途的危险，很大程度上就是拜他所赐。您为什么突然问起这个？"
    }
    {
      Id = "Circe_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！只是随口一问啦！只不过在我的印象里，那家伙总是朝三暮四的，在哪个地方都呆不住！所以他会一直为赫卡忒女士效力，让我还有点惊讶呢。不过，其实应该说是惊喜！"
    }
    {
      Id = "MelinoeField_1984"
      InheritFrom = "BaseNarrative"
      DisplayName = "您之前和他认识吗？我不记得您之前来三岔路口的时候有和他打过招呼，不过话说回来，那时候我一直在埋头训练。您上次来的时候，我还很小呢！"
    }
    {
      Id = "Circe_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这座小岛移动了位置之后，我去一趟三岔路口可比之前要{#Emph}麻烦多了{#Prev}。至于奥德修斯嘛，没错，我曾经遇见过他——他和他那一群猪头水手。乖孩子啊，那是很久以前的事了，哈哈！也许他在那次之后学到了些教训吧。"
    }
    {
      Id = "Circe_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "乖孩子，你身上带的是什么东西？呃，唔，看起来是一袋受诅咒的老骨头……请你赶紧把它带走！它在干涉这里的能量场！"
    }
    {
      Id = "Circe_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "你带来了不祥的气息啊，孩子。在我这完全不欢迎！我感知到的，是你身上的那袋羊拐骨……它们……来到这座岛上，是很久之前的事了……"
    }
    {
      Id = "MelinoeField_4519"
      InheritFrom = "BaseNarrative"
      DisplayName = "请别这样，女士。这袋羊拐骨，是奥德修斯本人送我的，而且它们为我提供了很多帮助。他想让我替他问一下，您愿不愿意通过这袋羊拐骨和他谈一谈。我不知道你们需要谈论些什么，但能看得出你们两个都深受其扰。"
    }
    {
      Id = "Circe_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "真让人受宠若惊！你有那么重要的任务在身，又何必委屈自己做{#Emph}他的{#Prev}信使！他要是有什么好话要说，大可以飘洋过海亲自过来，吼吼！可他{#Emph}没有{#Prev}。"
    }
    {
      Id = "MelinoeField_4520"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们需要大战术家坚守在他的岗位上。既然您能感知到这袋羊拐骨，就一定能感知到其中没有负面的意图。不过，还是很抱歉，让您烦心了。"
    }
    {
      Id = "Circe_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没关系的，乖孩子，又不是你的错！不过我暂时还没准备好和他说话。不过，等你下次把那袋骨头带来的时候……{#Emph}唔……{#Prev}或许我会愿意吧。"
    }
    {
      Id = "Circe_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "又是这袋羊拐骨。好吧，乖孩子，我是个言而有信的巫术师。你可以把我们的老朋友，那个战术家暗灵叫过来，让我听听他有什么话要说。"
    }
    {
      Id = "MelinoeField_4357"
      InheritFrom = "BaseNarrative"
      DisplayName = "好的，女士。{#Emph}奥德修斯，聆听我的呼唤；你求见之人，就在我的身畔！"
    }
    {
      Id = "Odysseus_0575"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士。我不会耽误你多少时间的。你还在照顾这些小猪崽呀！"
    }
    {
      Id = "Circe_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们可乖了呢。不过我看你不是为它们而来的吧，奥德修斯。你突然登门拜访，是想……？"
    }
    {
      Id = "Odysseus_0576"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们能找个地方见一面，简单说上几句么？我旁边这位女神恐怕没办法将我的投影维持太久。"
    }
    {
      Id = "Circe_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有什么好说的，就在这里说，赶紧的。没记错的话，我们早就达成共识，再也不相往来了，毕竟那时我们面对的困境，和你在海上遇到的有得一拼！"
    }
    {
      Id = "Odysseus_0577"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也记得，只是……你看，我还没有遇到过哪个无法突破的困境，而你也擅长变化之道。与其让我们的过去就地腐烂，我想也许我们可以……用你们的话说，让它“入土为安”。"
    }
    {
      Id = "Circe_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "说得轻巧，但是你和我都不会道歉，也都不会遗忘！我们已经把这件事翻来覆去地说过不知道多少次了。我早就研究透彻了！"
    }
    {
      Id = "Odysseus_0578"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也一样，女士。当时你我的处境，都与现在截然不同。现在……现在有我们都在意的人需要我们。哪怕不是为了我们自己，而是为了她们，我也希望我们能放下芥蒂。"
    }
    {
      Id = "Circe_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们早就放下芥蒂了，至少我是这么以为的。我对你没有恶意，水手！我们初次见面时，我就对你说了这句话；现在我要再说一次。我们有过属于我们的时刻，但它们早已褪了色，失去了魔力。"
    }
    {
      Id = "Odysseus_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就这样决定了。祝你事事顺遂，我的女士。其实我真正想说的是，遇到你为我的人生增色许多……因为你让我更了解我自己了。我们有你相助，我很感激。"
    }
    {
      Id = "Circe_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "……他就这么消失了，丢下一句话就走，跟以前一模一样。去吧，乖孩子，我这一晚上说的话已经够多了。"
    }
    {
      Id = "Circe_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次那场对话，我想对你说声谢谢。以及，谢谢你把奥德修斯带到我身边来。最开始，我……我感觉特别不自在，但是，在你走了之后……那种感觉也随之消失了。他现在成了暗灵；也难怪我觉得他有点阴魂不散。"
    }
    {
      Id = "MelinoeField_4358"
      InheritFrom = "BaseNarrative"
      DisplayName = "您和他之间接下来会怎么样，女士？有什么需要我替你跟他说的吗？"
    }
    {
      Id = "Circe_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用了。我已经明白，我们注定是要渐行渐远的，毕竟他不是那种会在一个地方呆太久的人！不过，如果非要留下什么回忆的话，能留下这么平静的，我已经知足了。"
    }
    {
      Id = "Circe_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "到现在你肯定见到了，纷争化身的黑色羽翼，最近常常会遮蔽夜空！她没有注意到我的小岛，但总是飞得很近，让人心惊胆战。最近她{#Emph}这么大怨气{#Prev}，到底是因为什么？"
    }
    {
      Id = "MelinoeField_3390"
      InheritFrom = "BaseNarrative"
      DisplayName = "真要说的话，我觉得厄里斯看起来比平常{#Emph}更快乐{#Prev}了。起初我还以为她投靠了克洛诺斯，但现在我觉得，她只是不想看到{#Emph}任何人{#Prev}成功。除了她自己。"
    }
    {
      Id = "Circe_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "唉，真是不健康的思想。我多么渴望世界上没有纷争……但我甚至都很难想象那会是什么样子。不要忽视她的力量，要时刻对她加以抑制。"
    }
    {
      Id = "Circe_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "得知普罗米修斯与众神为敌，真是令人遗憾……他肯定能看得出来，一心想要复仇，最终是得不到安宁的！真的没有办法和他{#Emph}讲讲道理{#Prev}吗？"
    }
    {
      Id = "MelinoeField_3380"
      InheritFrom = "BaseNarrative"
      DisplayName = "他没什么说话的欲望，不过最近，恐怕每个人都是这样！到最后我们总会在接近山顶的地方打起来。他好像总能预见谁会胜出……哪怕胜出的是我。"
    }
    {
      Id = "Circe_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，他以前也预见过自己的失败。你能想象那种感觉么，乖孩子？对未来的所有不幸了如指掌。就算是他曾经受到的惩罚，和这样的折磨比，恐怕也相形见绌。"
    }
    {
      Id = "MelinoeField_3381"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，您说，先见泰坦是真的能预知未来吗？普罗米修斯一副信誓旦旦的样子，但与其相信他，我觉得{#Emph}您{#Prev}有这样的能力的可能性还要大些。"
    }
    {
      Id = "Circe_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子，对于即将发生的事情，我有的时候能窥见惊鸿一瞥；前提是我为之投入大量的资源和精力。至于普罗米修斯，我觉得他始终能看到未来，无论他自己是否情愿。"
    }
    {
      Id = "MelinoeField_3382"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是，知道了未来具体将要发生什么，不就能够简单地改变未来么？比如说，假如我知道我们将要谈起这件事，那我就可以故意避而不谈……"
    }
    {
      Id = "Circe_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "但是这样的话，你最初知晓的就是错误的未来。更何况，这样的知识有可能非常危险！正是因为未来无法确定，我们才能怀揣希望，积极面对；这可是无比强大的能力……"
    }
    {
      Id = "Circe_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你已经亲眼见过那个巨大的魔物了，是不是，乖孩子？当然，我指的是提丰啦！我常常会好奇，他与自然界为何有那么深的联系……"
    }
    {
      Id = "MelinoeField_3385"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么样的联系？您刚刚都说了，他是个魔物！他不属于我们的世界。"
    }
    {
      Id = "Circe_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "但他就在那里，在你行程的终点等着你呢！有谁能说得清楚，我们的世界{#Emph}局限{#Prev}在哪个范畴，世界里又有哪些东西呢……？至少你我肯定都做不到，乖孩子！所以我觉得，所有存在的东西，都属于我们的世界。"
    }
    {
      Id = "Circe_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前那一夜，环绕着众神之山的那场可怕的风暴，突然间就{#Emph}散去{#Prev}了，取而代之的是皎洁的月光！我当时想着，说不定是你大功告成了呢，哈！哦，不过现在你又回来了……那场风暴也回来了。"
    }
    {
      Id = "MelinoeField_3386"
      InheritFrom = "BaseNarrative"
      DisplayName = "事实证明，要想让众魔之父偃旗息鼓，远没有那么容易……在提丰、普罗米修斯和克洛诺斯之间，真不知道谁对宙斯大人的复仇欲望最为强烈。"
    }
    {
      Id = "Circe_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒女士和你也在寻求你们自己的复仇。你在这道裂谷里见过卡律布狄斯，对吧？真是一股能够吞噬万物的力量！当我想到“复仇”二字时，满脑子都是它的那张血盆大口……"
    }
    {
      Id = "Circe_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，真是一团糟！我跟赫卡忒女士说过的，将整座岛屿搬过来很可能会产生某些副作用。但是谁能想到会把冷酷无情的卡律布狄斯一同带来呢？当然，她不在这座岛上，但是也{#Emph}相当近{#Prev}了！"
    }
    {
      Id = "MelinoeField_3523"
      InheritFrom = "BaseNarrative"
      DisplayName = "您这么一说，那个长了触手和尖牙的巨大漩涡，确实跟这个海峡有点格格不入。"
    }
    {
      Id = "Circe_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少她在这里和之前一样，不缺送到嘴边的航船！不过话说回来，她没给你添什么麻烦吧，乖孩子……？"
    }
    {
      Id = "Circe_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以众神之山上到底是怎么了？有些夜晚，地平线上突然燃起滔天烈焰，还伴随着雷云滚滚，我从没见过那样可怕的景象！"
    }
    {
      Id = "MelinoeField_3379"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些异象的源头是围攻奥林匹斯山的两股势力：泰坦普罗米修斯和他的劫掠者，以及怪物提丰本尊。我正要赶过去对付他们。"
    }
    {
      Id = "Circe_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "天哪，你一个人对付他们全部吗，乖孩子？不过也许你在{#Emph}地底{#Prev}面对的危险比这更加严峻！那就让我竭尽所能，保护你周全吧……！"
    }
    {
      Id = "Circe_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "我总是忘记，我们其实还算得上是亲戚呢，对不对？我老爸是耀眼的太阳本尊——泰坦赫利俄斯。跟众神关系很淡！平常对谁都很疏远。但他是……得墨忒尔女神的哥哥，而得墨忒尔是我的姑姑，也是你的外婆，对吧……？"
    }
    {
      Id = "MelinoeField_1973"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，喀耳刻女士，是这样没错！这样说来，我没想错的话，您就是我的姑姑了。真不知道我们是怎么把这些复杂的家族关系都理清楚的！话说回来，家人的情谊比起血脉更加重要，不是吗？"
    }
    {
      Id = "Circe_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是当然！不过，恐怕你得原谅我，因为我一直在回避所谓的“家人情谊”。以前在家人身边时，他们总会希望我面对不同的人做出不同的行为举止。那时的我，连怎么做{#Emph}自己{#Prev}都还没弄清楚呢！在这片小岛上，事情就简单多喽。"
    }
    {
      Id = "MelinoeField_3383"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前有一夜，您谈及了我们{#Emph}怀揣希望的强大能力{#Prev}。这让我想起了普罗米修斯之前曾说过的一番话，但当时的我没有听进去，就打断了他……"
    }
    {
      Id = "Circe_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "我意识到，对于像你这样孜孜不倦、刻苦学习的孩子来说，是不会仅仅满足于怀揣希望的！但我也能感觉到，就算是你，每一夜也持着开放的心态，希望任务的进展顺应自己的心意……"
    }
    {
      Id = "MelinoeField_3384"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我会为每一种可能性做出计划，而且时刻准备着在事情不可避免地偏离预期时随机应变。这是准备充分、未雨绸缪，而不只是怀揣希望。"
    }
    {
      Id = "Circe_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想怎么称呼都可以。但是，归根结底，你所描述的这种心境之中，还存在着另一股力量——我们一切动力的来源。它像火焰一样，需要细心呵护，否则很容易便会熄灭。"
    }
    {
      Id = "Circe_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "就在你抵达的时候，我感觉有什么东西发生了{#Emph}变化{#Prev}。是{#Emph}摩吕草{#Prev}，对吧？而且我没感觉错的话，还{#Emph}不少{#Prev}呢！在这里你不需要这样的保护。话说回来，它不会干扰你的巫术，真是个奇迹！"
    }
    {
      Id = "MelinoeField_1974"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在厄瑞玻斯把能找到的摩吕草都采集了起来。它们对魔法是有效果，但是只要装在我的包里，就不会干扰到我，而且还会一直保持新鲜。您是不喜欢摩吕草吗？我还以为各种花草树木都赢得了您的喜爱呢。"
    }
    {
      Id = "Circe_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的还没来得及赢得我的喜爱，就招来了我的提防！摩吕草有一种{#Emph}抑制{#Prev}效果，让我完全提不起兴趣！以至于我研究出了反制的办法。既然你在这里不需要它的魔力，那它就应该不会妨碍到我们！不过，一定要格外小心哦，孩子。"
    }
    {
      Id = "Circe_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊哈，我刚刚就预知到你的到来了，乖孩子，哈哈！不是什么天赋异禀，也不是什么先见之明，只不过是直觉再加上些水晶占卜术罢了。你有日常使用水晶占卜的习惯吗？"
    }
    {
      Id = "MelinoeField_1976"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔……我学会了如何洞视漆黑之石！我以前以为那块石头放在那里，只是为了帮助我们匿踪遁形，但它还有其他强大的用途。水晶就是这样！潜力无限。"
    }
    {
      Id = "Circe_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "大地母亲的珍宝哦，{#Emph}天啊！{#Prev}我有的时候都要嫉妒你们了，在地下埋藏着那么多的水晶和宝石！只要轻轻一碰，就能揭示它们各自的特质，哦吼吼！它们是多么璀璨啊！"
    }
    {
      Id = "MelinoeField_3393"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，我想顺便问一问，您在这里夜复一夜在忙的咒语是有什么作用呀？巩固内在力量，掩盖小岛的存在，滋养岛上的土地，之类的？"
    }
    {
      Id = "Circe_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我主要是在给那边的小猪崽做晚餐啦！以后有机会的话，我会邀请你跟我们共进晚餐的，只不过这样的餐食不一定合你的胃口啦，何况你还有更重要的事情要解决！"
    }
    {
      Id = "Circe_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你带着我送你的水晶雕像呢！最近的事态一夜比一夜严峻，它应该能让你振作一点。而且，我觉得它在月光的照耀下晶莹剔透，漂亮得很！"
    }
    {
      Id = "MelinoeField_3387"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实如此，谢谢您，喀耳刻女士。在我住的地方，周围的动植物与在这里见到的截然不同。能够拥有这样一件纪念品，提醒我这些差异，对我来说很有价值。"
    }
    {
      Id = "Circe_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，动植物都是我们很好的伙伴，对吧？它们很擅长聆听！而且他们会用灵魂说话，而不是用什么花言巧语。啊，不过，来吧，该让你继续旅程了！"
    }
    {
      Id = "Circe_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "你带了个动物魔宠呢，乖孩子！能见到一只野兽与{#Emph}你{#Prev}建立这样的联系，真是太好了！你们既是彼此的安全感的来源，又能为彼此提供支持，形成一种良性的循环，许多人与动物间的关系都是如此！"
    }
    {
      Id = "MelinoeField_3388"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，这是弗利诺斯，是我的好朋友，他总是乐意听我吐露心声。您这么了解魔宠，有没有哪件事您觉得要是知道得更早就好了，可以当作建议分享给我的呢？"
    }
    {
      Id = "Circe_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，当然有啊！不过你也不应该因为追求捷径，错过在旅程中探索和发现的经历。不过，也许我确实有些建议，可以与你分享……"
    }
    {
      Id = "Circe_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "我那{#Emph}神奇的{#Prev}戴斯奇拉用得顺不顺手啊，孩子？我早就知道你会是她的下一任使用者，但是如今又见到我最喜爱的法杖，难免还是有点触景生情，吼吼吼。赫卡忒女士当时可是{#Emph}好说歹说{#Prev}，我才甘愿把它拱手让出啊，哦嚯嚯嚯！"
    }
    {
      Id = "MelinoeField_1975"
      InheritFrom = "BaseNarrative"
      DisplayName = "我带着最高的敬意挥舞戴斯奇拉，以免辜负了使用过女巫之杖的前辈们。而她也没有辜负过我；我能安全来到这里就证明了这一点。您想要……想要重新握一握她么？"
    }
    {
      Id = "Circe_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，不，这样不行！属于我们的那段日子已经过去啦。更何况在我把她传给你之前，我都有点挥舞不动它了。愿她以汹涌的魔力保护你周全，就像当年保护我那样！"
    }
    {
      Id = "Circe_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能看得出来，你把戴斯奇拉照料得很好。让她饱尝了许多灵魂！因此，我想跟你分享一个{#Emph}梦境{#Prev}，梦里的事啊，现在想来还栩栩如生……"
    }
    {
      Id = "MelinoeField_3398"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于我和暮夜之杖的梦境吗，女士？听起来好具体。不过，梦有的时候就是这样……"
    }
    {
      Id = "Circe_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那个梦里，我看到了一个乍一看像是只胡狼的生物，身边围着一群已死之人。他的容貌庄严无比，而与此同时，有一句话在我脑海中响起：{#Emph}“我见你守卫凡人坟茔，护死者往生来世。”"
    }
    {
      Id = "MelinoeField_3399"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“我见你守卫凡人坟茔，护死者往生来世。”{#Prev}听起来可能是个唤醒咒语。所以，如果我在银辉之池旁，对戴斯奇拉念出这句话……"
    }
    {
      Id = "Circe_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那样的话，依我看，她便会向你揭示一重形态！作为她曾经的持有者，你和我的这份联系肯定不会是巧合！因此这份知识理应分享给你。"
    }
    {
      Id = "Circe_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子，你有按照我的建议，向戴斯奇拉念出那段咒语吗？那些字词还萦绕在我心头：{#Emph}“我见你守卫凡人坟茔，护死者往生来世。”"
    }
    {
      Id = "MelinoeField_3492"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有些犹豫，喀耳刻女士。如果我还没有准备好接受这份力量，那该怎么办？如果戴斯奇拉真的想向我揭示这一形态，那为什么还要多此一举？"
    }
    {
      Id = "Circe_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为有些知识需要传承。我们不会一直作为戴斯奇拉的持有者，但却会一直肩负黑夜的使命。"
    }
    {
      Id = "Circe_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "太好了，戴斯奇拉在你手中的形态，正是我梦中见到的样子！看来我向你转述的那句话确实激起了她的共鸣。对于这个崭新的形态，你有什么可以与我分享的吗？"
    }
    {
      Id = "MelinoeField_3493"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是一位亡者之神的形态……不是我的父亲，而是一个名为阿努比斯的存在。他在时间或空间上与我们相隔很远，但和我们一样是位冥界的守护者。谢谢您引导我发现这些秘密。"
    }
    {
      Id = "Circe_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "不客气，乖孩子，不客气！所以这个叫做阿努比斯形态？想不到，除了你父亲之外，还有其他掌管亡者的神明！不过，他的神权毕竟是命运三女神赋予的，也许她们还将这份权力赋予了别人……或者在未来的某天将会这样做。"
    }
    {
      Id = "Circe_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "乖孩子，你照顾魔宠的方式我很欣赏！依照我们的赫卡忒女士的意志，我现在要把我掌握的一些相关的知识传授给你。"
    }
    {
      Id = "MelinoeField_4531"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，谢谢您，女士！您所指的是什么样的知识？您一定比任何人都更了解野兽。"
    }
    {
      Id = "Circe_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "别急嘛，你会知道的！这是我最爱的咒语之一，所以我不想破坏了这个惊喜！"
    }
    {
      Id = "Circe_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我差点没认出来你的那只魔宠，这意味着你有好好利用魔宠化形咒语！哈！你的小伙伴们喜不喜欢改头换面的感觉呀？"
    }
    {
      Id = "MelinoeField_4533"
      InheritFrom = "BaseNarrative"
      DisplayName = "没听到他们有什么意见！不过我见到的这些变化，好像都只影响他们的外在。这是正常的吗？"
    }
    {
      Id = "Circe_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那当然！这就等同于让魔宠换身衣服，改改穿衣风格之类的。最近，我们没什么时间打扮自己，但至少可以让我们的小伙伴享受一下！"
    }
    {
      Id = "Circe_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，我就直说了，乖孩子，你今晚的样子好狼狈！你已经忍受了这么多的痛苦，但我还是不能在这儿留你太久，希望你能原谅……"
    }
    {
      Id = "MelinoeField_3389"
      InheritFrom = "BaseNarrative"
      DisplayName = "也希望您原谅我这副样子，女士。这片海域真是穷凶极恶，更何况我之前还不得不穿过一座死城。但我说这些，都只是在为自己的失误找借口……"
    }
    {
      Id = "Circe_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，让我尽自己所能帮助你吧，但是，我的天，不许再自怨自艾了！时间不允许你这个样子！就算事态严峻到无可挽回，你也总可以遁入暗影之中，养精蓄锐，然后重新出发。"
    }
    {
      Id = "Circe_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这些晚上都上哪去了，乖孩子？这边出了好多怪事，一个比一个匪夷所思！比方说，外面那些幽灵船，现在都跟无头苍蝇似的乱转。我都搞不清楚到底发生了什么！"
    }
    {
      Id = "MelinoeField_4534"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯被打败了，女士……而且是永远的那种！这很可能就是他的军队有失秩序的原因，不过这些军队都没有消失，克洛诺斯也还在。老师没有跟您说吗？"
    }
    {
      Id = "Circe_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的天啊，怎么会这样，怎么会这样……！不！除非……啊，我这里实在太偏僻了，可能错过了一些她传来的信息，我……{#Emph}噢！{#Prev}所以你是想对我说，你取得了胜利？"
    }
    {
      Id = "MelinoeField_4535"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是的！接下来要做的，就是确保他不会再次与众神作对，他和提丰都不会。"
    }
    {
      Id = "Circe_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！啊，哦，天啊……哈，天啊，这真是，哦！我得立刻联系赫卡忒女士！不过首先，请你快点选一个吧！"
    }
    {
      Id = "Circe_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒女士和我确认了你的成就的每一个细节，不过她可没有你说得那么谦虚！噢……真是伟大的成就，孩子！"
    }
    {
      Id = "MelinoeField_4536"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，喀耳刻女士。如果没有您的魔法，我可能永远都无法登上奥林匹斯山，而这是必须的步骤之一。您不介意我们继续这样吧？"
    }
    {
      Id = "Circe_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，要是我们不继续的话，我可要介意了！只要你还有更多事情要做，我就一定会尽力提供帮助！"
    }
    {
      Id = "Circe_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近奥林匹斯山上的天气好多了，很多时候我都能看到那边万里无云！你之前对付的那个魔物，连个影子也没有留下啊。"
    }
    {
      Id = "MelinoeField_4537"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰的残迹其实还存在，只不过几乎无法察觉了。但它们仍然可以被摧毁。"
    }
    {
      Id = "Circe_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你往那座山上跑，就是为了实现这点。提丰并不是自然的产物；魔物与野兽，区别就在于此！所以，我不会为他的消失而悲伤。我想，应该没人会吧。"
    }
    {
      Id = "Circe_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒女士告诉我，事情取得了神奇的进展……你跟命运三女神打了个照面？没几个人有过{#Emph}这样{#Prev}的经历啊，哈！喔……你有没有机会看看她们的手相？"
    }
    {
      Id = "MelinoeField_4538"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，女士，我没看到。在我遇到她们的地方，她们碰巧都笼罩在阴影之中。您对她们的新预言有什么看法……？"
    }
    {
      Id = "Circe_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么，她们说时代最终会{#Emph}发生变化？{#Prev}哈！既然你这么问了，我就直说了，这种预言不是{#Emph}一说一个准{#Prev}嘛！活的时间够久，你就能看得出来，与其说时代会变，不如说会像车轮一般循环往复。"
    }
    {
      Id = "Circe_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我可以把你变成几乎任何东西，但我觉得你现在就{#Emph}几近完美{#Prev}了！"
    }
    {
      Id = "Circe_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "把这里当自己家就好，虽然我知道你留不了多久。把手伸过来吧！"
    }
    {
      Id = "Circe_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢！我应该正好有某种药水或者药膏之类的，能为你派上用场！"
    }
    {
      Id = "Circe_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "要记住噢，乖孩子，我们不能改变自己的本质。能改变的只是{#Emph}外在{#Prev}而已。那么，伸出手来。"
    }
    {
      Id = "Circe_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，在这样魔力四射的夜晚再次与你相遇，真是太巧了！"
    }
    {
      Id = "Circe_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这里过着与世无争的生活。等你的战斗结束之后，强烈推荐你也试试！"
    }
    {
      Id = "Circe_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "在艾尤岛上无需多言，孩子。只用一个眼神，我就全明白了！"
    }
    {
      Id = "Circe_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很想留你喝口茶，但我知道你必须尽快上路。改日如何？"
    }
    {
      Id = "Circe_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "当我预言你今晚会再次造访时，我的小猪们都高兴得吭哧吭哧地叫呢！"
    }
    {
      Id = "Circe_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和我的小猪们平常少有招待客人的机会，因为这座小岛压根就没人能找得到！"
    }
    {
      Id = "Circe_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里很欢迎你，而且很安全，孩子！深吸一口气，放松肩膀，放松心灵……"
    }
    {
      Id = "Circe_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们无法{#Emph}彻底{#Prev}改变自己，乖孩子，但是我们可以稍微改变一下机运！{#Emph}哈哈哈，哈哈！"
    }
    {
      Id = "Circe_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，照这样下去，你很快就会出落成一位迷人的女神了！"
    }
    {
      Id = "Circe_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有任何想改变你的地方，乖孩子。但要我改的话也可以！以防万一，我们就来个临时的吧！"
    }
    {
      Id = "Circe_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神之山离这里并不算太远！让我为你做好准备，度过这最后一段{#Emph}穷山恶水{#Prev}吧！"
    }
    {
      Id = "Circe_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子啊，所谓活着，无非就是经历一系列源源不断的细微变化。"
    }
    {
      Id = "Circe_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的思想和选择决定了你是谁，但我能让你变得不止如此！"
    }
    {
      Id = "Circe_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都在找寻真我的路途上，但这条路总是蜿蜒而坎坷！所以，让我们做好完全的准备吧。"
    }
    {
      Id = "Circe_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的小屋实在是太寒碜了！当然，除了我自己，也没人会知道啦。"
    }
    {
      Id = "Circe_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我的水晶球里，我预见了你今晚的行程，而且很高兴你决定再次造访！"
    }
    {
      Id = "Circe_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这个惨淡的夜晚，终于出现了一个振奋人心的身影！让我们把今夜变得更好吧。"
    }
    {
      Id = "Circe_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的本性并非一成不变，而改变自我本身便是通往{#Emph}真我{#Prev}的过程……"
    }
    {
      Id = "MelinoeField_1943"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，过了那么久，我们终于有机会重逢，实在是太好了。您对我一直以来都是那么照顾，这对我来说意义重大。因此，作为回报，我想把这件礼物送给您。"
    }
    {
      Id = "Circe_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}蜜露！喔，谢谢你，乖孩子！{#Prev}我曾经试过自己提炼一些，但总是哪里弄得不对！不过话说回来，{#Emph}这个{#Prev}你收下，作为我的回礼，就当是这座小岛上的小小纪念品吧！"
    }
    {
      Id = "Circe_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "天啊！又一瓶蜜露要送给我？我还真不太习惯在这座小岛上收礼物。但我很高兴能多收一些，说不定收着收着就习惯了呢，啊哈哈！如果你{#Emph}坚持{#Prev}的话！"
    }
    {
      Id = "MelinoeField_1945"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}坚持{#Prev}是个很重的词，女士，但您说得没错，我希望您能收下它。也许这能帮助您改良您自己的配方……或者伴您度过一个愉快的夜晚，如果有机会的话。"
    }
    {
      Id = "Circe_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "不是所有神力的施展都需要贡品，你知道的吧。我们在奥林匹斯山上的亲戚……他们是对这些献礼习以为常了，但我可不一样！可别把我给惯坏了！"
    }
    {
      Id = "MelinoeField_3524"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯众神向来在世界各地广收献礼。而您独自生活在这座小岛上，想必不会像他们那样，面临习惯这些礼物的风险吧！"
    }
    {
      Id = "Circe_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这实在是太棒了！谢谢你，好孩子！我们这样的人往往缺少陪伴，能有你这样的同道中人时不时来探望我，真是让人开心，哪怕现在任务艰巨也丝毫不影响这点，哈哈哈哈！"
    }
    {
      Id = "MelinoeField_3525"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算等到这场战争结束，我也希望能像这样时不时来拜访您。您的岛屿是个神奇的地方，而您的巫术造诣也让我由衷敬佩。"
    }
    {
      Id = "Circe_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "有时我会担心，你的心地会变得冷酷……在这些历练之中变成铁石心肠。然而，紧接着你就会对我展现出这样的善意！你学到了很多，不过这种善良，好像是你的本性嘛！"
    }
    {
      Id = "MelinoeField_4521"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，我……这只是瓶蜜露啦，我只是想着，也许在这里没那么好搞到，就带了一瓶过来。就连在奥林匹斯山上，最近都很紧俏呢！不过，我很感谢您能在我身上看到您所想的那种特质。"
    }
    {
      Id = "Circe_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，{#Emph}又{#Prev}给我带礼物来了，真是谢谢你啊，孩子！你带过来的蜜露真的很甜，不过，我最近喝得都有点尝不出它的滋味了……所以这段时间就先别再送啦……？"
    }
    {
      Id = "MelinoeField_4522"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士，是我哪里说得或者做得不够好么？您一个人生活在这座小岛上，所以我就想着，也许你会喜欢这种异域的佳酿……"
    }
    {
      Id = "Circe_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实喜欢！只不过，每一瓶喝下去，都会令我想起曾经无比奢华的生活……那些东西，基本都被我抛在身后啦。而我不打算回头。"
    }
    {
      Id = "MelinoeField_4523"
      InheritFrom = "BaseNarrative"
      DisplayName = "我完全理解。不过，真的很感谢您，女士。感谢您的智慧，以及您的热情款待。"
    }
    {
      Id = "MelinoeField_4525"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道您现在不想要蜜露，喀耳刻女士，但我想也许您会对这个感兴趣？您可以把它用在巫术上，甚至拿去跟动物伙伴们分享也没问题。"
    }
    {
      Id = "Circe_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔！这不是{#Emph}仙馔密酒{#Prev}嘛！真是一件珍贵的礼物，就算在这些相对黑暗的夜晚，也是一道耀眼的光芒！这是为了庆祝什么的？一定是在我没注意的时候，发生了什么大事吧？"
    }
    {
      Id = "MelinoeField_4526"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，既然您教过我如何让自己心想事成……我想收到礼物这件事本身就可以拿来庆祝一番，不是么？"
    }
    {
      Id = "Circe_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实可以，谢谢你啦！那就敬我们的相遇吧，无论是今夜，还是之后的每一夜！至于我是要把它留下，还是要跟我的小猪崽们分享，就先容我想一想……"
    }
    {
      Id = "MelinoeField_4527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "希望您好好享受！"
    }
    {
      Id = "MelinoeField_4528"
      InheritFrom = "BaseNarrative"
      DisplayName = "您之前说，您不确定上一瓶仙酒是该留下，还是该分给小猪崽们。请允许我来化解这个左右为难的局面。"
    }
    {
      Id = "Circe_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，那想必这一瓶是该留下了！因为上次我的小猪崽们绝对都喝得饱饱的了。我从来没意识到，赫卡忒女士把你教导得这么慷慨大方！"
    }
    {
      Id = "MelinoeField_4529"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师教会了我怎么保护自己，怎么专注于任务，以及很多其他事情。但我对慷慨的认识，很大一部分都来自于您，女士。从前您在三岔路口的时候，那里总会更温暖几分。"
    }
    {
      Id = "Circe_0239"
      InheritFrom = "BaseNarrative"
