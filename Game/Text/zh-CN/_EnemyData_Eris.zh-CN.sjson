    }
    {
      Id = "ErisField_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}停停停！{#Prev}最新消息，宝贝，去奥林匹斯山的路现在{#Emph}暂停对外开放{#Prev}。"
    }
    {
