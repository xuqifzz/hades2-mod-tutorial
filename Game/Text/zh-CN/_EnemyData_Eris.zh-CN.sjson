    }
    {
      Id = "MelinoeField_3490"
      InheritFrom = "BaseNarrative"
      DisplayName = "告诉你吧，你有时能使用这个形态，唯一的原因就是匿踪者之誓。你感觉不到黑夜中的恐惧吗？"
    }
    {
