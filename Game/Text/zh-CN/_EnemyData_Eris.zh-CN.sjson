    }
    {
      Id = "ErisField_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}没有哦！{#Prev}说得好像我该害怕似的，可是盯着枪口直冒冷汗的人，分明是{#Emph}你{#Prev}啊。"
    }
    {
      Id = "ErisField_0391"
