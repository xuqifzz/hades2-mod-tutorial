    }
    {
      Id = "ErisField_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚外面好暗耶，是吧？就连裂谷里那些死掉的水手看起来都有点害怕。是出了什么事吗……？"
    }
    {
