    }
    {
      Id = "ErisField_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊！"
    }
    {
      Id = "ErisField_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你怎么能……这么{#Emph}残忍……？"
    }
    {
      Id = "ErisField_0114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}不！{#Prev}不不不不，等、等等！"
    }
    {
      Id = "ErisField_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，怎么又是这样，怎么{#Emph}又是这样！"
    }
    {
      Id = "ErisField_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，哈哈！我要让你加倍奉还！"
    }
    {
      Id = "ErisField_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我还以为我们是朋友……？！"
    }
    {
      Id = "ErisField_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你怎么能这样对我，宝贝？！"
    }
    {
      Id = "ErisField_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好黑……好冷……唔呃……"
    }
    {
      Id = "ErisField_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不……！你会后悔的……！"
    }
    {
      Id = "ErisField_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……遁入……暗影之中……？"
    }
    {
      Id = "ErisField_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可我不想走，我才{#Emph}刚来{#Prev}啊！"
    }
    {
      Id = "ErisField_0348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想送我回地狱，总得先打一场！"
    }
    {
      Id = "ErisField_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我永远会笑到最后的，宝贝！哈哈哈——唔啊！"
    }
    {
      Id = "ErisField_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}嗷嗷嗷嗷嗷嗷嗷！"
    }
    {
      Id = "ErisField_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}我……马上就……飞回来！"
    }
    {
      Id = "ErisField_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}好啦{#Prev}，好啦，那我走了。拜拜！"
    }
    {
      Id = "ErisField_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊！明晚同一时间，不见不散哦，宝贝！"
    }
    {
      Id = "ErisField_0482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗷！下次能不能{#Emph}给我点机会{#Prev}啦！"
    }
    {
      Id = "ErisField_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔呃，怎么这种事总会{#Emph}落到我的头上？{#Prev}"
    }
    {
      Id = "ErisField_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你怎么……这么快？"
    }
    {
      Id = "ErisField_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "难道我{#Emph}一次都没打中吗？"
    }
    {
      Id = "MelinoeField_1907"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是你先动的手。"
    }
    {
      Id = "MelinoeField_1908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是她先动的手。"
    }
    {
      Id = "MelinoeField_1909"
      InheritFrom = "BaseSubtitle"
      DisplayName = "离我远点。"
    }
    {
      Id = "MelinoeField_1910"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一边去。"
    }
    {
      Id = "MelinoeField_1911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "记好了。"
    }
    {
      Id = "MelinoeField_1912"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她总是不长记性。"
    }
    {
      Id = "MelinoeField_1913"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见了，纷争化身。"
    }
    {
      Id = "MelinoeField_1914"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这样舒服多了……"
    }
    {
      Id = "ErisField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，水手！想不到能在离家{#Emph}这么远{#Prev}的地方撞见你，真是太巧了。你要去哪呀？说不定我可以载你一程。"
    }
    {
      Id = "MelinoeField_1806"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要去哪你心知肚明。而且我自己就能抵达那里，就不劳你费心了。"
    }
    {
      Id = "ErisField_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确定吗？看起来你今夜过得{#Emph}相当{#Prev}不顺利呢。而且接下来只会越来越糟。"
    }
    {
      Id = "MelinoeField_1807"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道你在这里拐弯抹角地说些什么，厄里斯。有话就直说，要么就别挡路。"
    }
    {
      Id = "ErisField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我就直说咯：你无聊透了。我不{#Emph}喜欢{#Prev}你。而且你休想对我发号施令……！"
    }
    {
      Id = "ErisField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，你怎么{#Emph}这样{#Prev}？我明明已经跟你说得一清二楚了，可你站在那里的架势就好像之前什么都没发生，今晚也只是另一个普通的夜晚似的！"
    }
    {
      Id = "MelinoeField_1920"
      InheritFrom = "BaseNarrative"
      DisplayName = " 这对我来说{#Emph}就是{#Prev}另一个普通的夜晚，厄里斯。你与克洛诺斯为伍、与众神为敌，那又怎样？你不过是我前进路上的又一道阻碍罢了。"
    }
    {
      Id = "ErisField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕事实要让你失望了，小麻烦精：所谓“阻碍”，是指应该{#Emph}避开{#Prev}的东西！但在这道海峡中，你每一次都会遇上我，{#Emph}没有例外。"
    }
    {
      Id = "MelinoeField_3267"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么你要像这样，使出浑身解数阻拦我？你是纷争的化身啊，你应该让人无法预料才对！可以去袭击一下克洛诺斯的军队，换换心情的……"
    }
    {
      Id = "ErisField_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么会觉得我{#Emph}没那么干过{#Prev}？你又不是世界的中心，宝贝！而且我已经让人无法预料到{#Emph}极致{#Prev}了！不过我也不知道为什么总会撞见你。太{#Emph}随机{#Prev}啦！"
    }
    {
      Id = "ErisField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "要再来一次吗？我有的时候想不明白，你究竟是固执，还是单纯的……你懂的。不过这倒是无所谓啦。"
    }
    {
      Id = "MelinoeField_1921"
      InheritFrom = "BaseNarrative"
      DisplayName = "你站在……或者说，你悬浮在我和我的目标中间，厄里斯。我要告诉你的是：早晚你会意识到，这是个错误。"
    }
    {
      Id = "ErisField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，可是是人都会犯错的啦，对不对？要不然的话，咱俩都不会出现在这里了。所以说，你现在是准备好了吗？那就让我们来找点{#Emph}乐子{#Prev}吧。"
    }
    {
      Id = "ErisField_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "这真是{#Emph}棒极了{#Prev}，你不觉得吗，小麻烦精？现在，在我用子弹送你下地狱之前，我只想花点时间和你一起{#Emph}深吸口气、放松一下……{#Prev}对我们拥有的一切表示感恩。"
    }
    {
      Id = "MelinoeField_1922"
      InheritFrom = "BaseNarrative"
      DisplayName = "和你的这种莫名其妙的战斗……不得不说我完全找不到感恩的理由。不过，至少今夜的月色很美？"
    }
    {
      Id = "ErisField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这就对啦！{#Prev}那么现在，不如我们一起为她苍白的光芒涂上鲜血与灵液吧！顺便还能让大海喝个够！"
    }
    {
      Id = "ErisField_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你该不会以为，你在三岔路口向我示好，我就会在这里放你一马吧？大错特错，宝贝！我很清楚你来这里的目的。"
    }
    {
      Id = "MelinoeField_3075"
      InheritFrom = "BaseNarrative"
      DisplayName = "你清楚我来这里的目的，是因为我一遍又一遍直白地向你解释过了。可就算这样，你还是要摆出一副故弄玄虚的样子，假装事情实际上复杂得多。"
    }
    {
      Id = "ErisField_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，现在你还想要让我内疚，罪加一等。哼，我才不要听你说这些有的没的。没人能对我指手画脚，懂了吗？"
    }
    {
      Id = "MelinoeField_3076"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次你都做好了准备，急着想要与我开战。我从来没遇到过像你一样{#Emph}动力{#Prev}十足，却又全无{#Emph}动机{#Prev}的人。"
    }
    {
      Id = "ErisField_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "告诉你个惊天大秘密吧，宝贝——没有动机{#Emph}就是{#Prev}一种动机。好好想想吧！想不清楚的话，就让我的坚炮帮你开开窍。"
    }
    {
      Id = "ErisField_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，你比看起来要更强大，小麻烦精。既然上一次你对我做出了那样的事，那这次我也要给你来点{#Emph}狠的{#Prev}。"
    }
    {
      Id = "MelinoeField_1923"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们上一次会面之所以会有那样的后果，全是因为你的挑衅和攻击。今夜说不定后果会更糟。"
    }
    {
      Id = "ErisField_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你的意思是说，我们的选择有{#Emph}后、后果？{#Prev}拜托，骗小孩子的话你都信。话说回来！我现在要开火了喔。"
    }
    {
      Id = "MelinoeField_3082"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，我必须得说，尤其是对于一个自诩彻底混乱无序的人来说，你相当守时，而且很有恒心。我每次穿越裂谷，都会发现你在这里等着我。"
    }
    {
      Id = "ErisField_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "没必要非得揭我的短嘛！听着，我知道这是个问题，但我发誓，我能控制得住。答应我，别把这事跟别人说，好么？"
    }
    {
      Id = "MelinoeField_3083"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想让我答应你，不要告诉别人你很守时，而且做事很有恒心。为什么？你不想让别人对你的态度有所改观么？"
    }
    {
      Id = "ErisField_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，是啊！不过话说回来，我什么时候在意过任何人对我的态度……？我才不是那样的人！都怪你，非要在这扫我的兴！"
    }
    {
      Id = "MelinoeField_4060"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们之间的对决，你一次都没有迟到过——无论我抵达这片海滩的速度有多快，你都能赶在我前面。可是你的目标应该是变得{#Emph}更不可靠{#Prev}，而不是变得{#Emph}更可靠……？"
    }
    {
      Id = "ErisField_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的目标就是一辈子不要有什么鬼目标！就，感觉我是在经历人生的某个阶段啦。一定是你和涅涅的竞争激发了我的胜负欲。"
    }
    {
      Id = "MelinoeField_4061"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你以为{#Emph}我们{#Prev}是在竞争什么？争谁第一个被打回冥界吗？"
    }
    {
      Id = "ErisField_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可没说过我是在和{#Emph}你{#Prev}竞争，宝贝。而且你知道我从这整件事里领悟到了什么道理吗？纪律和混乱，从来都是相辅相成的。"
    }
    {
      Id = "ErisField_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许我按时出现也不是什么坏事。{#Emph}纷争化身，有求必应！{#Prev}还挺响亮的，是吧？"
    }
    {
      Id = "MelinoeField_4062"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你想变得可靠的话，仅仅是准时出现还不够，还得在某些方面能帮上忙才行。不过，也许这样的要求对你来说太高了。"
    }
    {
      Id = "ErisField_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是难以置信，差点就被你骗到，要开始怀疑自己是不是有什么问题了——就因为我{#Emph}在乎{#Prev}！不过你放心……既然你这么想找问题，我就给你{#Emph}弄出点问题看看！"
    }
    {
      Id = "ErisField_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山上每个人都把最好的给了你，是吗？一定把你{#Emph}骄傲坏了{#Prev}吧。众神通常很难达成什么共识。"
    }
    {
      Id = "MelinoeField_3078"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实。但在必要的时候，他们可以放下分歧、求同存异。你也不妨试一试。"
    }
    {
      Id = "ErisField_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道最了解山上情况的是谁吗？是阿瑞斯。如果说有人能把{#Emph}那个{#Prev}家族团结起来的话，那一定是战神。{#Emph}他{#Prev}的事业就连我都认可！"
    }
    {
      Id = "MelinoeField_3079"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你那么欣赏阿瑞斯，那我要告诉你，他对我伸出了援手；现在我身上就有他的祝福。不过，我猜你仍然没有让我过去的打算？"
    }
    {
      Id = "ErisField_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "你猜的没错！而且，就算阿瑞斯{#Emph}真的{#Prev}帮你弥补了所有的缺点，估计也只是因为他想让这场战争一直{#Emph}继续下去{#Prev}！他可以帮{#Emph}你{#Prev}；我也可以帮{#Emph}他{#Prev}。"
    }
    {
      Id = "ErisField_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "难以置信阿瑞斯居然{#Emph}帮你{#Prev}不帮我。我一直想要联系上他，毕竟我觉得他会愿意跟我聊聊的，但奥林匹斯山的风暴实在太猛烈了。欸，话说，你能不能……你懂的……"
    }
    {
      Id = "MelinoeField_3264"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想让我替你问一问战神愿不愿意帮助你，这样一来我去援助他和他家人、帮助他们背水一战抗击提丰的任务就会变得前所未有地艰难，是这个意思吗？"
    }
    {
      Id = "ErisField_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还真会{#Emph}嘲讽{#Prev}哦，小麻烦精！我只不过是求你{#Emph}帮我个忙{#Prev}，可是……你居然要借题发挥，反过来{#Emph}羞辱{#Prev}我。{#Emph}好吧！{#Prev}我凭{#Emph}自己{#Prev}也能吸引到战神的注意！"
    }
    {
      Id = "ErisField_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，小麻烦精，你{#Emph}好大！{#Prev}就好像你和涅涅生了个孩子一样！等等，这简直是我想象过的{#Emph}最糟糕{#Prev}的事情。而我想象过的事情可多了去了。"
    }
    {
      Id = "MelinoeField_3084"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就想象一下，我以现在的形态会对你做出什么样的事情。这都是拜巫术师喀耳刻所赐。要不是你从小胡作非为，说不定也能跟着她学到些东西。"
    }
    {
      Id = "ErisField_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么，学她做个{#Emph}怪人{#Prev}吗？这就是你和我的区别：你{#Emph}凡事{#Emph}都需要别人{#Emph}教你{#Prev}，而我可以{#Emph}全凭直觉{#Prev}！"
    }
    {
      Id = "ErisField_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊哈哈哈，你怎么成了个小不点啊，宝贝！好{#Emph}萌{#Prev}哦。一定是老喀耳刻干的好事，是吧？我在天上看到过她那座小岛，她在那捣鼓各种疯癫的实验。"
    }
    {
      Id = "MelinoeField_3085"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的很有学习巫术的天赋，厄里斯……刚才你轻而易举地就认出了一名资深巫术师的手笔。可你却只愿意以此污蔑我们的研究。"
    }
    {
      Id = "ErisField_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们的研究把你变成了个笑话！我只是指出这一点而已。好啦，不管接下来发生什么，谢谢你逗我开心哦！"
    }
    {
      Id = "ErisField_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道那个弱不禁风的小暗灵，叫什么来着……？{#Emph}伊、伊什么……伊卡洛斯！{#Prev}我见到他四处窥探，在天上飞来飞去……分明是在{#Emph}学我{#Prev}！他那对{#Emph}翅膀{#Prev}是在哪弄来的？"
    }
    {
      Id = "MelinoeField_3268"
      InheritFrom = "BaseNarrative"
      DisplayName = "放心，伊卡洛斯不是在学你。事实可能会让你很惊讶，但有些人会努力帮助我们……而不是像你一样，对我们的计划横加干预。"
    }
    {
      Id = "ErisField_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得他是在{#Emph}努力帮助你们{#Prev}？噗，拜托！他只是脑子有问题。说不定他偏爱{#Emph}鹰身女妖{#Prev}那一口，换上那身行头是为了跟她们套近乎呢……不过话又说回来，管他呢！"
    }
    {
      Id = "ErisField_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哇，看哪！{#Prev}你居然带了只丑陋的小鸟一起耶！估计你要是长了翅膀的话，也会长成那个蠢样子吧。可惜你想去哪里都得走着去。怪不得你一直那么{#Emph}不高兴{#Prev}！"
    }
    {
      Id = "MelinoeField_3269"
      InheritFrom = "BaseNarrative"
      DisplayName = "我才没有不高兴。而且我是坐船来的，谢谢你的关心！还坐了好几艘呢！还有，不许你当着我和拉奇的面说他的坏话。"
    }
    {
      Id = "ErisField_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，{#Emph}拜托。{#Prev}那只鸟一副煞白的样子，眼看是{#Emph}活不长{#Prev}了！来吧，也许我可以给它来个痛快。{#Emph}你{#Prev}也有份哦。"
    }
    {
      Id = "ErisField_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "购物终于告一段落了吗，小麻烦精？卡戎那艘浮夸的大船上，看起来确实有不少宝贝啊！不过他从来没卖给我过。"
    }
    {
      Id = "MelinoeField_4065"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕你得死了这条心。卡戎大人忠于冥界，而你则不然。就这么简单，就算你是他的妹妹，他也不会对你网开一面。"
    }
    {
      Id = "ErisField_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}忠于冥界{#Prev}，哼。至少我不是什么马屁精！不过既然你这么喜欢他，我就成全一下你——把你打得跟他一样只能嗷嗷叫！"
    }
    {
      Id = "ErisField_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜月光真的在指引你啊！真可惜塞勒涅没办法用马车带着你，“嗖”一下飞上奥林匹斯山。不过话说回来，她为什么不能啊？我还以为她是你朋友呢！"
    }
    {
      Id = "MelinoeField_4066"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许塞勒涅不愿轻易抛下她的责任，不过我知道这个概念对你来说理解起来可能有些困难。那你愿不愿意帮我一把，“嗖”一下飞上奥林匹斯山呢？"
    }
    {
      Id = "ErisField_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "免了吧。我这双翅膀也承受不了两个人的重量！不过，要是你想“轰”一下被我炸上天，我倒是{#Emph}乐意效劳。"
    }
    {
      Id = "ErisField_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "埃费拉港口的那个独眼巨人是什么毛病？前几夜有一次我飞过去的时候，差点被他乱丢的巨石砸到！"
    }
    {
      Id = "MelinoeField_4064"
      InheritFrom = "BaseNarrative"
      DisplayName = "他叫波吕斐摩斯。他眼睛看不见，所以没必要把他乱丢石头的行为当作是蓄意冒犯。他估计是想瞄准我来着。"
    }
    {
      Id = "ErisField_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，那就好！我拿了些他的羊走，别问为什么，本来还担心被他发现了呢。这下好了，我得到了牲口，你得到了石头！"
    }
    {
      Id = "ErisField_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，所以现在在正面战场上总揽全局的是{#Emph}普罗米修斯{#Prev}？我还以为他还在忙着被什么{#Emph}大鸟{#Prev}啄得死去活来呢。"
    }
    {
      Id = "MelinoeField_3080"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以作证，他和那只鸟现在达成了一致。唉，你就可怜可怜我吧，厄里斯。我在你这受一遍火焰和羽毛的洗礼，到奥林匹斯山的山顶还要再受一次。"
    }
    {
      Id = "ErisField_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "说得我有点心动呢，宝贝……{#Emph}不过{#Prev}，算你倒霉，因为我其实根本没有心哦。所以，来吧！迎接你今晚第一次火焰与羽毛的洗礼吧。"
    }
    {
      Id = "ErisField_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，小麻烦精，再闯过我的阻拦一次的话，接下来你要做什么？我从来没见过有谁费{#Emph}这么大功夫{#Prev}只为了见家人一面的。我们大多数人都唯恐避之不及呢！"
    }
    {
      Id = "MelinoeField_3081"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许你还没听说，但在奥林匹斯山顶的滚滚浓云之中，笼罩着的可是提丰。你居然还没有自己跑去见见他，让我都有点惊讶呢！总之，接下来是普罗米修斯，然后就是提丰。但首先是{#Emph}你{#Prev}。"
    }
    {
      Id = "ErisField_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是说，你来这里就是为了找越来越强的对手干架？{#Emph}宝贝——！{#Prev}我一直知道咱们关系不一般，但咱们的共同点比我想象得还要多耶！那还等什么，快开始吧。"
    }
    {
      Id = "MelinoeField_3265"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的永远不打算给我让出一条路来吗，厄里斯？你宁愿让提丰把奥林匹斯山夷为平地。只是到了那时候，恐怕这场战争也就结束了。"
    }
    {
      Id = "ErisField_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "那肯定！但在那之后一切也不会那么快回归秩序嘛，而且……谁知道提丰在那之后又会做出什么事呢？想想那些{#Emph}可能性{#Prev}，宝贝！"
    }
    {
      Id = "ErisField_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山昨晚发生了什么事，宝贝？风暴好像平息了一阵子。我几乎都想飞过去亲眼看看了，只是……只是那里太冷了，我不喜欢！"
    }
    {
      Id = "MelinoeField_3266"
      InheritFrom = "BaseNarrative"
      DisplayName = "发生的事情是，我在解决掉{#Emph}你{#Prev}之后，最终登上了奥林匹斯山的山顶，把众魔之父提丰狠狠打回了地面。"
    }
    {
      Id = "ErisField_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？哇，那你一定{#Emph}强到爆了{#Prev}，要么就是提丰{#Emph}弱到爆了{#Prev}！而且，既然你已经回来了，想必昨晚发生的事情一点意义都没有！"
    }
    {
      Id = "ErisField_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "有段时间没在这里见到你了，宝贝。话说那个提丰是怎么了？消失得无影无踪！"
    }
    {
      Id = "MelinoeField_4063"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰被逐出了我们所知的现实世界。抱歉，厄里斯。你是不是都没机会跟他认识？"
    }
    {
      Id = "ErisField_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实没有，不过他要是这么容易就被赶走的话，那就无所谓啦！所以话说回来，你现在去奥林匹斯山又是要干什么？最好不要是去参加什么{#Emph}宴会。{#Prev}因为没人邀请{#Emph}我！"
    }
    {
      Id = "ErisField_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的鹰身女妖多得很，不过她们都很好欺负。她们知道谁才是老大，把我像{#Emph}女神{#Prev}一样对待！"
    }
    {
      Id = "MelinoeField_3276"
      InheritFrom = "BaseNarrative"
      DisplayName = "你本来就是个{#Emph}女神{#Prev}，厄里斯。不过那些鹰身女妖好像不怎么分辨得出我的神性……"
    }
    {
      Id = "ErisField_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许她们不喜欢你，毕竟你没长翅膀？不过，要说不喜欢你的理由，那可{#Emph}真是{#Prev}多了去了……"
    }
    {
      Id = "ErisField_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "噗。你让我等得{#Emph}好辛苦{#Prev}啊！好不容易等到你，却又发现你跟那些船上的死人没什么两样！"
    }
    {
      Id = "MelinoeField_3275"
      InheritFrom = "BaseNarrative"
      DisplayName = "真抱歉，厄里斯。幸运的是，离这里不远处有一口清泉，应该能让我奇迹般地恢复如初。"
    }
    {
      Id = "ErisField_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那看来你已经{#Emph}很近{#Prev}了啊！也许你可以试试跑不跑得掉呢。毕竟，离开这里的路就在我身后……"
    }
    {
      Id = "ErisField_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，看起来路上那些尖酸刻薄的老水手给你砍得不轻啊！不过别担心，宝贝。{#Emph}我{#Prev}来结束你的痛苦！"
    }
    {
      Id = "ErisField_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次你{#Emph}差点{#Prev}就打败我了，宝贝！当时我感觉翅膀都变沉重了……就好像冥界在叫我{#Emph}回家{#Prev}似的。但现在我已经完全恢复了！"
    }
    {
      Id = "MelinoeField_3280"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是目前如此。很快你就会再次感到冥界在叫你回家了。而且不管你喜不喜欢，我都会送你回去。"
    }
    {
      Id = "ErisField_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，我{#Emph}最喜欢{#Prev}听人放狠话了！好吧，那咱们就来看看谁先回到家，怎么样？也许结果会和{#Emph}上回{#Prev}一样……"
    }
    {
      Id = "ErisField_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，宝贝，你这身行头到底是什么鬼啦？你是可以换换风格没错，但{#Emph}这{#Prev}也{#Emph}太太太过了{#Prev}。"
    }
    {
      Id = "MelinoeField_3077"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你一定是在说漆黑战衣。不瞒你说，这身衣服不代表我的着装审美，但它也不是为了美观而设计的。马上你就会明白了。"
    }
    {
      Id = "ErisField_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，我记得漆黑战衣的事！原来它就长{#Emph}这副{#Prev}样子啊？我还以为狮鹫坚炮看起来已经够离谱了呢！倪克斯的品味真是{#Emph}糟透了{#Prev}。"
    }
    {
      Id = "ErisField_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "噫，你看起来好像{#Emph}倪克斯{#Prev}！你穿的那件还是漆黑战衣，对吧？但你对它{#Emph}动了些手脚{#Prev}……"
    }
    {
      Id = "MelinoeField_3315"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是倪克斯自己的形态下的柯辛斯，它认定我有资格成为它的使用者。或许是因为这样一来，我就可以代替你的母亲好好管教管教你。"
    }
    {
      Id = "ErisField_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}管教我？{#Prev}宝贝，我以前也经常跟倪克斯对着干，但是从来没有像{#Emph}这样{#Prev}动过手。这样感觉{#Prev}有意思多了！！{#Emph}来吧，老妈，让我看看你的真本事。"
    }
    {
      Id = "ErisField_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "把你上一次从我这拿走的金苹果还回来，我这次就会考虑放你一马。怎么样？"
    }
    {
      Id = "MelinoeField_1924"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说那个很可能是被你{#Emph}偷{#Prev}来的金苹果？按说只有一座花园会结出那样的果实，而我强烈怀疑那个地方不会让你大摇大摆地走进去。"
    }
    {
      Id = "ErisField_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "一旦你领略到“不请自来”的魅力之后，生活就会变得精彩许多。好吧！既然这样，那个苹果你就留着好了。反正我也不差那一个……"
    }
    {
      Id = "ErisField_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "是什么在我耳边叮铃铃地响，该不会是铃铛的声音吧？喔，你把我给你的{#Emph}信物{#Prev}带来了，是不是！你以为那东西在{#Emph}这里{#Prev}能帮到你吗？"
    }
    {
      Id = "MelinoeField_3086"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕只是稍稍让你感到一些烦乱和困惑，我也觉得值。我知道，对你来说，哪怕是送出一件礼物这样简单的事情，也一定要有些不可告人的动机才行。"
    }
    {
      Id = "ErisField_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "那想必你送出礼物的时候，满脑子回响的只有纯洁得无可指摘的念头吧！怪不得你的头那么大，像个靶子一样！拜托，宝贝，没人会那样。就连你都做不到。"
    }
    {
      Id = "ErisField_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦不，你是带来了涅涅的邪眼吗？她还真不把所谓的公平当回事啊，居然让你用那种东西，就为了报复我！"
    }
    {
      Id = "MelinoeField_4068"
      InheritFrom = "BaseNarrative"
      DisplayName = "是我做出了带上邪眼的决定，不是涅墨西斯。不过她确实是报应化身，所以我觉得她如果知道的话，也会支持我的行为。"
    }
    {
      Id = "ErisField_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点拿屁股想也想得明白啦，宝贝。我是她的妹妹哎！倪克斯生的那堆垃圾里最不起眼的一个，比谁都小，比谁都好欺负。但我绝对会还手……甚至会{#Emph}先下手为强！"
    }
    {
      Id = "ErisField_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯愿意把他亮闪闪的胸针送一枚给你，一定说明你对他真的很特别！说不定他觉得你{#Emph}没他不行{#Prev}呢！宝贝啊，你看起来就是一副需要被英雄救美的样子。"
