      InheritFrom = "BaseNarrative"
      DisplayName = "我说啊，宝贝，你也太执着了！一遍又一遍{#Emph}又一遍{#Prev}地输给我，还是要坚持吗？"
    }
    {
      Id = "ErisField_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没法每次都阻止你，但至少每次都能拖慢你的脚步。"
    }
    {
      Id = "ErisField_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很有竞技精神，小麻烦精。输赢对我来说都无所谓。"
    }
    {
      Id = "ErisField_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}终于来啦！{#Prev}盯着空荡荡的海面看很容易让人看得不耐烦，你知道吧？"
    }
    {
      Id = "ErisField_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "从来没想过我这种人能培养出什么日常习惯，可是宝贝，你看看我现在的样子！"
    }
    {
      Id = "ErisField_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不会{#Emph}真的{#Prev}得徒步爬上后面那座山吧，小麻烦精？"
    }
    {
      Id = "ErisField_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "还等什么呢，宝贝！我没有整晚的时间，你也一样。"
    }
    {
      Id = "ErisField_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们两个的区别在于，我{#Emph}一点儿{#Prev}也不在意到底谁输谁赢。"
    }
    {
      Id = "ErisField_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}喜欢{#Prev}这样，不是么，小麻烦精？不用向我承认啦，你自己心里明白就好！"
    }
    {
      Id = "ErisField_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "我讨厌这么不出意料，但我又喜欢惹你生气，所以……算是扯平了吧！"
    }
    {
      Id = "ErisField_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "别往心里去，宝贝。有些事情就是非做不可，你明白的吧？"
    }
    {
      Id = "ErisField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我很想用愉快的闲聊拖慢你的步伐，但是我觉得还是{#Emph}这招更加有效。"
    }
    {
      Id = "ErisField_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，嘿！我知道我们最近的关系有点坎坷啦，但是……以后回忆起来的时候，我们大概会笑得很开心的！"
    }
    {
      Id = "ErisField_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来好像不是很想见到我嘛，宝贝！我什么{#Emph}坏事{#Prev}都还没做呢……"
    }
    {
      Id = "ErisField_0030"
      InheritFrom = "BaseNarrative"
