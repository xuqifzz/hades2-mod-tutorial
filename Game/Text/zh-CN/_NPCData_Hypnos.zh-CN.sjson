    }
    {
      Id = "Melinoe_3681"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}一定要奏效啊……{#Prev}修普诺斯大人，你已经沉眠很久了！我知道你迷失在梦境之中，但我会尽我所能，引你重返现实。现在，请深呼吸……！"
    }
    {
      Id = "Melinoe_3682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是……这是什么地方？"
    }
    {
      Id = "Hypnos_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼……呼唔，唔唔……"
    }
    {
      Id = "Melinoe_4638"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，修普诺斯大人，我们再试一次。我们得把你救出来，但首先，请你深呼吸。"
    }
    {
      Id = "Hypnos_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}唔唔……啧，啧，唔……呼呼呼……"
    }
    {
      Id = "Melinoe_4707"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道该怎么做，修普诺斯大人。这次你最好别再抗拒了，因为我得承认，我已经稍微有那么一点点不耐烦了。深呼吸！"
    }
    {
      Id = "Melinoe_3385"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你安睡之时好梦不断。而倘若你终将醒来的话……到那时要记得，这里有瓶蜜露等待你享用哦。"
    }
    {
      Id = "Hypnos_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼呼，欢迎来到……冥，唔，呼呼呼呼……"
    }
    {
      Id = "Melinoe_3482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等等，欢迎来到{#Emph}哪里……？"
    }
    {
      Id = "Melinoe_3386"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的睡眠经常会被噩梦侵扰……或者，也许是回忆吧，赫卡忒老师救出我那时的回忆。睡神啊，如果你的睡眠也为此所扰……至少你没有表露出任何迹象。"
    }
    {
      Id = "Hypnos_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……你有没有……呼……试过……呼噜……"
    }
    {
      Id = "Melinoe_3483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他刚刚是不是……我有没有试过什么……？"
    }
    {
      Id = "Hypnos_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……欢迎来到，冥……呼呼呼……"
    }
    {
      Id = "Melinoe_3684"
      InheritFrom = "BaseNarrative"
      DisplayName = "他说话了？他……他在试图和我交流！修普诺斯大人，我是墨利诺厄，冥王哈迪斯之女，我在寻找将你从梦中唤醒的办法！你能听得到我么？"
    }
    {
      Id = "Hypnos_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……我……没睡……我……没睡……哈哈……嗯，呼呼呼……"
    }
    {
      Id = "Melinoe_3685"
      InheritFrom = "BaseNarrative"
      DisplayName = "你为什么在梦境中也在沉睡？我要怎么做，才能让你回到我们身边？我们真的需要你……你的姐姐亲口对我说过，你的知识和智慧无人能及！"
    }
    {
      Id = "Hypnos_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……看样子这次……呼呼呼……你是直接走到了……呼呼呼……"
    }
    {
      Id = "Melinoe_3686"
      InheritFrom = "BaseNarrative"
      DisplayName = "我走到了{#Emph}哪里{#Prev}……？修普诺斯大人，我不明白。你得清醒一点！我在这里的时间不多了，如果这也不能唤醒你的话，我……我就一筹莫展了……"
    }
    {
      Id = "Hypnos_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……美梦……成真……呼呼呼……谢谢你……呼呼呼……来……看我……呼呼呼……"
    }
    {
      Id = "Hypnos_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……唔，啧啧，嗯……呼呼呼……"
    }
    {
      Id = "Melinoe_3688"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，他的意识……溜走了。我要怎么……唔啊。我得想一想……"
    }
    {
      Id = "Melinoe_3689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……目前只能祝你做个好梦了……"
    }
    {
      Id = "Hypnos_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……欢迎来到……谢谢你……愿意赴死……"
    }
    {
      Id = "Melinoe_4641"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有东西要给你，稍等一下……"
    }
    {
      Id = "Melinoe_4710"
      InheritFrom = "BaseNarrative"
      DisplayName = "你早该醒过来了。"
    }
    {
      Id = "Hypnos_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……又死了……啊……呼唔……"
    }
    {
      Id = "Melinoe_4642"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你在这里都在做梦的话，那我只能请求进入你的灵魂更深处了，修普诺斯大人。是否允许取决于你，但首先……请再次深呼吸。"
    }
    {
      Id = "Hypnos_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼……我的清单……从不会……"
    }
    {
      Id = "Melinoe_4711"
      InheritFrom = "BaseNarrative"
      DisplayName = "我必须再次深入你的心灵深处，大人，所以请原谅我擅自闯入。那么……我们开始吧。"
    }
    {
      Id = "Hypnos_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……无路……可逃……呼呼……"
    }
    {
      Id = "Melinoe_4647"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人？修普诺斯大人！你能听到吗？回应我！{#Emph}什么回应都可以！{#Prev}哪怕是动一动眼皮？哦，拜托，{#Emph}不要这样！"
    }
    {
      Id = "Hypnos_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……不会再……抓到我……上班睡……呼呼……"
    }
    {
      Id = "Melinoe_4648"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是梦到自己在……睡觉？或者梦到自己在{#Emph}做梦？{#Prev}我还是搞不清楚。他的意识到底潜到了多深的地方……？"
    }
    {
      Id = "Hypnos_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……塔纳托……一直……忙着工作……"
    }
    {
      Id = "Hypnos_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼嗯嗯……？！呼呼呼嗯嗯嗯……"
    }
    {
      Id = "Melinoe_4650"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊。这次比上次有进展，但……你到底在{#Emph}多少重{#Prev}梦境里？不过，如果你梦到了死亡化身的话……也许……{#Emph}嗯……"
    }
    {
      Id = "Melinoe_4651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "安睡吧，大人。"
    }
    {
      Id = "Melinoe_4714"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真是非常固执，大人……"
    }
    {
      Id = "Melinoe_4715"
      InheritFrom = "BaseNarrative"
      DisplayName = "……好，修普诺斯大人，我们再试一次。你仍然对我有所保留，对你自己也是。在你的意识某处，你一定还醒着，所以我们就去那里找你。再深呼吸一次！"
    }
    {
      Id = "Melinoe_4716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不……不，他……唔……"
    }
    {
      Id = "Melinoe_4717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里什么也没有……"
    }
    {
      Id = "Hypnos_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}呼呼呼……你……这么多次……呼……"
    }
    {
      Id = "Hypnos_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼，唔唔唔唔……呼，唔，唔唔唔……"
    }
    {
      Id = "Melinoe_4718"
      InheritFrom = "BaseNarrative"
      DisplayName = "可恶，修普诺斯大人，我到底要怎么做？稍等……这是什么，好像是一张便签……像是小孩子写的，歪歪扭扭的……上面写着：{#Emph}“你有试过说‘醒醒’吗？”{#Prev}等等，{#Emph}什么？"
    }
    {
      Id = "Hypnos_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}（吸气）（哈欠）"
    }
    {
      Id = "Melinoe_4719"
      InheritFrom = "BaseNarrative"
      DisplayName = "他打了个哈欠。修普诺斯大人……醒醒。{#Emph}醒醒！"
    }
    {
      Id = "Hypnos_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}（哈欠）{#Prev}欢迎来到冥——我，呃……等等。我在哪？这是{#Emph}啥？{#Prev}你是{#Emph}谁？"
    }
    {
      Id = "Melinoe_4720"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人，你……你{#Emph}醒了！{#Prev}这是位于界域之间的三岔路口。我是墨利诺厄，冥王哈迪斯与冥后珀尔塞福涅的女儿。欢迎！"
    }
    {
      Id = "Hypnos_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}（哈欠）{#Prev}等等等等等等，你说你是大人的女儿，这是{#Emph}什么意思？{#Prev}你{#Emph}好大一只{#Prev}，不是，你长得{#Emph}好快{#Prev}，不是，你才刚{#Emph}出生{#Prev}啊！除非……除非，我，呃……"
    }
    {
      Id = "Melinoe_4721"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经沉睡了……很长一段时间，大人。据我所知，自从泰坦克洛诺斯篡夺了我父亲的冥府之后，你就一直沉睡不醒。那件事发生之后，我们就一直在着手解决。"
    }
    {
      Id = "Hypnos_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哦不！{#Emph}啊！啊啊啊啊啊！{#Prev}哦不！哦不，哦不，他们会……这些蜜露从哪来的？哦，我再也当不成最佳员工了，哦{#Emph}不……！"
    }
    {
      Id = "Melinoe_4722"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，修普诺斯大人，拜托你{#Emph}冷静一点！{#Prev}一切都过去了！尤其是你现在又回到了我们身边。冥府也恢复如初了！至少在恢复了。"
    }
    {
      Id = "Hypnos_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "不不不你不明白……我迟了大到了，我{#Emph}迟了大到{#Prev}了！我得赶紧走了！我得赶紧走了， 谢谢你叫我起床，见到扎格列欧斯跟他说一声，就说我马上就到！"
    }
    {
      Id = "Hypnos_0047"
      InheritFrom = "BaseSubtitle"
