    }
    {
      Id = "Melinoe_3910"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人，我在塔耳塔罗斯的时候找到了一些种子，这些种子能长成罂粟花……就和你寝具上的那些一样。要是我用它们……啊，我有个主意……！"
    }
    {
      Id = "Melinoe_3911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我一定会小心的，我向你保证。"
    }
    {
      Id = "Hypnos_0003"
