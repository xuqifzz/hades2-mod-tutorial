    }
    {
      Id = "Hypnos_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼……呼唔，呼噜……"
    }
    {
      Id = "Melinoe_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "睡神啊，我们会找到唤醒你的办法的。我保证。"
    }
    {
      Id = "Hypnos_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼……唔，呼……"
    }
    {
      Id = "Melinoe_3910"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人，我在塔耳塔罗斯的时候找到了一些种子，这些种子能长成罂粟花……就和你寝具上的那些一样。要是我用它们……啊，我有个主意……！"
    }
    {
      Id = "Melinoe_3911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我一定会小心的，我向你保证。"
    }
    {
      Id = "Hypnos_0007_A"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼呼……呼呼……"
    }
    {
      Id = "Melinoe_5679"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不该擅自提起这件事，修普诺斯大人，不过……我成功遁入了潜意识的深渊，而且在那里找到了我哥哥……！感谢你激发了我对梦境的热爱。我毕生所求的目标……终于在昨晚感觉近在咫尺！"
    }
    {
      Id = "Hypnos_0006_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼……呼呼呼……"
    }
    {
      Id = "Melinoe_5680_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，睡眠化身，我始终无法遁入你潜意识的深渊。面对我哥哥的潜意识时，道路总是那么清晰……！好吧，我们肯定能找到别的办法。"
    }
    {
      Id = "Hypnos_0007_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼……呼呼……"
    }
    {
      Id = "Melinoe_5682"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人，你的母亲和其他人都安好！他们肯定都很期盼你的回归，而且都以为你在这一切之后会醒来，但是……你还是沉睡不醒。好吧，别担心……我做出过承诺，就一定会兑现诺言。"
    }
    {
      Id = "Hypnos_0007_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼呼……呼……呼……"
    }
    {
      Id = "Melinoe_5747"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在冥府体会到的那段可能出现的过往……在那里，你……你{#Emph}很不一样{#Prev}，修普诺斯大人。你究竟是{#Emph}谁{#Prev}……？我到底要怎么做，才能唤醒你……？"
    }
    {
      Id = "Melinoe_5778"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯大人……有一瞬间，我以为……我几乎忘了你还在这里，就好像……我梦到了你已经醒来了一样……？不，不可能。一定是我太累了。"
    }
    {
      Id = "Hypnos_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼，呼……"
    }
    {
      Id = "Melinoe_2272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我先告辞了，修普诺斯大人！"
    }
    {
      Id = "Melinoe_2109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她会在哪呢……"
    }
    {
