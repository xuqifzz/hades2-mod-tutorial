    }
    {
      Id = "Melinoe_2114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗨，暗灵们，赫卡忒在这附近吗……？哎，没见到她吗？"
    }
    {
      Id = "Storyteller_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}目光锐利的王女找到了一串脚印，意味着她的大敌不久之前刚从这片满是沙尘的土地上走过……"
    }
    {
      Id = "Melinoe_2105"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}嘘{#Prev}，荷马！你把我的每一步都说出来啦，我还怎么抓到她呀！"
    }
    {
      Id = "Storyteller_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呃，这这这，我，我，我不知道你是在对谁说话……我不知道冥界王女是在对谁说话！只知道她正继续她那宿命的狩猎。"
    }
    {
      Id = "Melinoe_2269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别再捉弄我了，帮我找找嘛！"
    }
    {
      Id = "Hecate_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……但，哈迪斯大人，我……"
    }
    {
      Id = "Hades_0048"
      InheritFrom = "BaseNarrative"
