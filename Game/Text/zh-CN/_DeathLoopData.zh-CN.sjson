    }
    {
      Id = "Melinoe_2432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我带你们四处转转吧。"
    }
    {
      Id = "Melinoe_2820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "炼金釜可以使用了……"
    }
    {
      Id = "Melinoe_1585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那个是不是……？"
    }
    {
      Id = "Melinoe_2439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这都是些什么……？"
    }
    {
      Id = "Melinoe_1900"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，小墨。出口在另一头……"
    }
    {
      Id = "Storyteller_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口乃是位于阳世与冥界之间的避风港；如今仍然忠于冥王哈迪斯者，尽皆藏身于此。"
    }
    {
      Id = "Melinoe_2959"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们齐心协力，一定能夺回我父亲的领域。"
    }
    {
      Id = "Storyteller_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这间营帐属于英勇的王女墨利诺厄；虽说布置简朴，却收拾得整齐有序、一尘不染。"
    }
    {
      Id = "Melinoe_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会生活在脏乱之中。"
    }
    {
      Id = "Storyteller_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}黑暗的冥界王女从不向他人揭露自己内心最深邃的恐惧，唯独对那只无言的两栖动物例外；它很久之前跳入了她的营帐，闯入了她的心灵。"
    }
    {
      Id = "Melinoe_1684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最深邃的恐惧全由你独享，弗利诺斯！"
    }
    {
      Id = "Storyteller_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}每当她需要时间深思熟虑、规划未来时，幽魅的王女墨利诺厄便会前往三岔路口的一片灌丛之中。"
    }
    {
      Id = "Melinoe_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "时间是我们的敌人……"
    }
    {
      Id = "Storyteller_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口为那召来梦魇的女巫和她的战友隐藏着计划和行踪，但他们能保持隐匿多久呢？"
    }
    {
      Id = "Melinoe_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "足够我执行任务了。"
    }
    {
      Id = "Storyteller_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}命运三女神，那三位隐居避世、裁夺命运的神明，她们未竟的夙愿如今由冥界王女代为保管。"
    }
    {
      Id = "Melinoe_1682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在她们的帮助下，我们未尝没有胜算。"
    }
    {
      Id = "Storyteller_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}就连高瞻远瞩、足智多谋、曾巧取豪夺无数城池的奥德修斯，也不足以推翻时间泰坦的统治……"
    }
    {
      Id = "Melinoe_1685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "人们总说，永远不要低估那个人……"
    }
    {
      Id = "Odysseus_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈，饶了我吧。"
    }
    {
      Id = "Storyteller_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "那位不悦的神明象征的是报应，此刻她凌人的目光正扫过三岔路口的每个人；他们是她守护的对象，既出于责任，又出于愤懑。"
    }
    {
      Id = "Melinoe_1687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最好别招惹涅墨西斯……"
    }
    {
      Id = "Nemesis_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随你的便。"
    }
    {
      Id = "Storyteller_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}饱受憎恨与恐惧的毁灭化身无论前往何处，皆是编织命运的三位女神的旨意，也唯有她们能预料到他神出鬼没的行踪。"
    }
    {
      Id = "Melinoe_1688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他确实懂得怎么样华丽登场……"
    }
    {
      Id = "Moros_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "王女殿下？"
    }
    {
      Id = "Storyteller_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}有一些亡魂永远漫无目的地徘徊，而另一些，甚至连徘徊的意愿都没有，便只是在某个固定的地点弥留。"
    }
    {
      Id = "Melinoe_1689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "朵拉确实需要多出去走走……"
    }
    {
      Id = "Dora_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想都别想。"
    }
    {
      Id = "Storyteller_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在诡计多端的克洛诺斯篡夺冥府之后，原先栖息该处的亡者之灵便尽数逃往了天涯海角。"
    }
    {
      Id = "Melinoe_1679"
      InheritFrom = "BaseSubtitle"
      DisplayName = "暗灵们，这里欢迎你们，而且很安全。"
    }
    {
      Id = "Storyteller_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}历史有许多值得借鉴之处，只要懂得如何从后人杜撰的字里行间一窥其真谛；至于如何实现这一点，则是毕生的课题。"
    }
    {
      Id = "Melinoe_2961"
      InheritFrom = "BaseSubtitle"
      DisplayName = "未来仍然扑朔迷离……"
    }
    {
      Id = "Storyteller_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}很久以前，冥界有过一间档案室，在那里工作的暗灵兢兢业业，将发生的一切事无巨细地记录在案；如今仍然有些暗灵愿意操持这份旧业。"
    }
    {
      Id = "Melinoe_2962"
      InheritFrom = "BaseSubtitle"
      DisplayName = "以前这样的工作一定报酬很丰厚吧。"
    }
    {
      Id = "Storyteller_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}音乐的天赋，乃是由光彩熠熠的阿波罗亲自赐予凡人；音乐一响起，听众的灵魂便会为之共鸣，无论这灵魂是死是生。"
    }
    {
      Id = "Melinoe_3750"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就让大家一起共鸣吧！"
    }
    {
      Id = "Storyteller_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口的希冀与欢愉都虚无缥缈、转瞬即逝，而彼处的那一间小小酒馆，便是这些微不足道的情感的主要源头。"
    }
    {
      Id = "Melinoe_1680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没时间休息……"
    }
    {
      Id = "Storyteller_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哀歌如水，在恸哭之河中顺流而下；但哪怕是在这样的河流中，也有生物寻得了生存与繁衍之法。"
    }
    {
      Id = "Melinoe_2964"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但我感觉它们有的宁愿被钓上岸……"
    }
    {
      Id = "Storyteller_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}一眼清泉坐落于此，从大地深邃之处汲取热量；泉水如此纯净澄澈，既能净化身体，亦能洗涤灵魂。"
    }
    {
      Id = "Melinoe_2963"
      InheritFrom = "BaseSubtitle"
      DisplayName = "进去一泡，说不定就再也不想出来了……"
