    {
      Id = "Storyteller_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口的训练场由无畏的航海家瑟勒米乌斯所监管；他名扬四海、威震八方，生前如此，死后亦然。"
    }
    {
      Id = "Melinoe_0033"
