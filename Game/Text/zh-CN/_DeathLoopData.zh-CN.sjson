      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}不好……"
    }
    {
      Id = "Storyteller_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}漆黑之石无比古老，甚至在时间诞生之前便存在了。它的表面看起来总会将胆敢在周围逗留的光芒与色彩吸纳殆尽。"
    }
    {
      Id = "Melinoe_1117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在我可以看透表面的黑暗了……"
    }
    {
      Id = "Storyteller_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这是一座献给黑夜的纪念碑，承载着她的意志与愿景；它矗立在训练场中，只对配得上这份殊荣的人揭露它的本质。"
    }
    {
      Id = "Melinoe_2960"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在我是核心成员了……"
    }
    {
      Id = "Storyteller_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}此时月黑风高，正是午夜时分；在冥界边际的一片阴森灌丛中，一位年岁尚幼、遭众神遗忘的王女正要展开一场狩猎……"
    }
    {
      Id = "Melinoe_2106"
      InheritFrom = "BaseSubtitle"
