      DisplayName = "没错！"
    }
    {
      Id = "Storyteller_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那阴魂聚集的三岔路口之中，栖息着各种各样的魑魅魍魉，有些仍保有生前的容貌，另一些则早已不复当年，空余灵魂本质的残响。"
    }
    {
      Id = "Melinoe_1132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还好吗，荷马？"
