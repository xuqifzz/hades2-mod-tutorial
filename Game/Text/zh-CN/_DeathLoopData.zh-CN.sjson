    }
    {
      Id = "Skelly_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "各位新人，这里欢迎你们！"
    }
    {
      Id = "Skelly_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "安魂石板为你们展示了来到这里的方法，而我将为你们揭示前路。"
    }
    {
      Id = "Skelly_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "队伍又有了新成员——众人拾柴火焰高！"
    }
    {
      Id = "Skelly_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "欢迎你检阅冥界先锋队！"
    }
    {
      Id = "Skelly_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这位是刚从俄刻阿诺斯来的！"
    }
    {
      Id = "Skelly_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在哀悼原野哭鼻子是没有用的，加入我们的队伍才是正道！"
    }
    {
      Id = "Skelly_0024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……而那，便是生命的真谛。牢记于心，学徒们！"
    }
    {
      Id = "Skelly_0025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……然后我就说……等、等等，有人来了。"
    }
    {
      Id = "Skelly_0037"
