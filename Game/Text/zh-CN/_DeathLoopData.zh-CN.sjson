    {
      Id = "Storyteller_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口的训练场由无畏的航海家瑟勒米乌斯所监管；他名扬四海、威震八方，生前如此，死后亦然。"
    }
    {
      Id = "Melinoe_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有这样的一位人中豪杰相助，我们一定不会失败。"
    }
    {
      Id = "Skelly_0011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错！"
    }
    {
      Id = "Storyteller_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那阴魂聚集的三岔路口之中，栖息着各种各样的魑魅魍魉，有些仍保有生前的容貌，另一些则早已不复当年，空余灵魂本质的残响。"
    }
    {
      Id = "Melinoe_1132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还好吗，荷马？"
    }
    {
      Id = "Storyteller_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}不好……"
    }
    {
      Id = "Storyteller_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三岔路口的队伍日益壮大；那些曾经不知何去何从的暗灵，如今纷纷投身墨利诺厄王女那正义的志业。"
    }
    {
      Id = "Melinoe_4085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "欢迎加入匿踪者的军队！"
    }
    {
      Id = "Storyteller_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}漆黑之石无比古老，甚至在时间诞生之前便存在了。它的表面看起来总会将胆敢在周围逗留的光芒与色彩吸纳殆尽。"
    }
    {
      Id = "Melinoe_1117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在我可以看透表面的黑暗了……"
    }
    {
      Id = "Storyteller_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这是一座献给黑夜的纪念碑，承载着她的意志与愿景；它矗立在训练场中，只对配得上这份殊荣的人揭露它的本质。"
    }
    {
      Id = "Melinoe_2960"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在我是核心成员了……"
    }
    {
      Id = "Storyteller_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在三岔路口通向外界的门扉旁，尘灰祭坛随着古老的力量而律动着，其力量无边无际，一如其上描绘的众多神明与英雄。"
    }
    {
      Id = "Melinoe_4086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "每个人中都有这样的魔力……"
    }
    {
      Id = "Storyteller_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}死亡般的苍白色泽现在自暗夜武器，或者说其中一把武器上散发而出；在命运的推手下，它们斩断不死灵魂的渴望如今再无遮拦。"
    }
    {
      Id = "Melinoe_4081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}墓地饥渴……"
    }
    {
      Id = "Storyteller_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}现如今，银辉之池中荡漾着暗夜武器的魅影，其形态与冥界王女先前所见大不相同。"
    }
    {
      Id = "Melinoe_4082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这么多不同的形态……"
    }
    {
      Id = "Storyteller_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}现如今，由命运三女神铸造的暗夜武器于冥界王女的精心养护下重逢，每一件都蓄势待发，准备将侵犯冥界的敌人赶尽杀绝。"
    }
