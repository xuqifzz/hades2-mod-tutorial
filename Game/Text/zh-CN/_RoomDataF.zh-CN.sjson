    }
    {
      Id = "MelinoeField_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "离塔耳塔罗斯更近了……"
    }
    {
      Id = "Storyteller_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}往下走到尽头，在冥界最深的深渊中，等待身穿藏红花裙的女神墨利诺厄的，便是她的远古大敌。"
    }
    {
      Id = "Melinoe_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你会帮我找到他的。"
    }
    {
      Id = "Storyteller_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}摆渡人卡戎，曾经护送亡者之人，如今撑船漂泊于冥河之上，为仍在反抗泰坦王的人提供援助。"
    }
    {
      Id = "Melinoe_1430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真不知道没了他我们要怎么办。"
    }
    {
      Id = "Storyteller_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在厄瑞玻斯的森林深处，暗藏着一些僻静之所，只有通过魔法手段才能发现。"
    }
    {
      Id = "Melinoe_0860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就知道我们可以找到这里。"
    }
    {
      Id = "Storyteller_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}坐落于厄瑞玻斯，曾经供等待审判的亡灵居住的那些古老建筑，如今要么成为了森林的一部分，要么早已破败不堪，难以辨认。"
    }
    {
      Id = "Melinoe_1686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里曾经一定很宏伟……"
    }
    {
      Id = "Storyteller_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在厄瑞玻斯的这个深幽之处，编织精巧的蛛丝令人目不暇接，其华美比起众神身上的服饰不会逊色半分。"
    }
    {
