  lang = "zh-CN"
  Texts = [
    {
      Id = "Storyteller_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}浓雾笼罩着迷宫般的厄瑞玻斯；无数亡魂徘徊于此，等候着永远不会到来的审判。"
    }
    {
      Id = "Melinoe_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很快就会有人来审判他们了。"
    }
    {
      Id = "Storyteller_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在令人窒息的厄瑞玻斯中，几乎所有错综复杂的小径最后都是死路；鲜有人能在此来去自如。"
    }
    {
      Id = "Melinoe_1433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在这里生活了一辈子才找得着路。"
    }
    {
      Id = "Storyteller_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}就连那些有能力随意进出三岔路口的人，也无法完全确定自己将会从三个秘密出口中的哪一个离开。"
    }
    {
      Id = "MelinoeField_4599"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我还记得路……"
    }
    {
      Id = "Storyteller_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}厄瑞玻斯的无眠暗灵不得安宁；只有扭曲的树木张牙舞爪，将他们拥入遍布荆棘的怀抱。"
    }
    {
      Id = "Melinoe_1690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "与我作对的到底是亡魂，还是树木？"
    }
    {
      Id = "Storyteller_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥界王女周遭的阴影如此凝重；纵使她有生自冥府的双眼，也无法轻易辨别潜藏在阴影之中的是何种恐怖。"
    }
    {
      Id = "Melinoe_1691"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看不穿阴影，那就刺穿阴影。"
    }
    {
      Id = "Storyteller_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}那踽踽独行的杀手如今不复存在；想来他大抵是从埃费拉城的断壁残垣间漫游至此，寻找一个无比重要、不容错过的目标。"
    }
    {
      Id = "MelinoeField_3661"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那个刺客为我而来。"
    }
    {
      Id = "Melinoe_1612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "迷失的亡魂。我会让那个泰坦付出代价。"
    }
    {
      Id = "Storyteller_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}恸哭之河蜿蜒而去，流经无数被雾霭笼罩的小路；亡魂在那滞缓的河水中涕泣，应得的安息无处寻觅。"
    }
    {
      Id = "Melinoe_0856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有家的感觉了！"
    }
    {
      Id = "Storyteller_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥界所拥有的不止亡者的灵魂：其间还暗藏着超乎想象的财富，甚至还有不死的泰坦们的躯壳。"
    }
    {
      Id = "Melinoe_1681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "早晚会把他们送回那里的。"
    }
    {
      Id = "Storyteller_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}虽然明月纤细的手指只能勉强触及凄惨的厄瑞玻斯，但是对于狩猎女神来说，在这片林中穿行并非难事。"
    }
    {
      Id = "Melinoe_1429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我得承认，她确实很厉害。"
    }
    {
      Id = "Storyteller_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在前面，冥界王女将再一次面对养育她的人；王女的每一分胜算，都来自对方的谆谆教诲……"
    }
    {
      Id = "Melinoe_1431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "学无止境。"
    }
    {
      Id = "Storyteller_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在厄瑞玻斯的边界外，藏着冥界的另一个区域；知晓此处的人少之又少，而能涉足此处的更是寥寥无几。"
    }
    {
      Id = "Melinoe_0859"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但愿如此。"
    }
    {
      Id = "Storyteller_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}进一步揭露了她丰富无比的经验后，三岔路口的女巫融身入影，独留冥界王女在此，思索自己学识的限度。"
    }
    {
      Id = "MelinoeField_3612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她的学识一定很渊博……"
    }
    {
      Id = "Storyteller_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这片位于厄瑞玻斯边界处的林地格外隐秘，或许只有月神本尊方能看得清楚；在这里，古老巫术的修习者可以磨练技艺，至臻完美。"
    }
    {
      Id = "MelinoeField_3652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也看得很清楚啊。"
    }
    {
      Id = "MelinoeField_4269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "老师，等我……"
    }
    {
      Id = "MelinoeField_4584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "重走路线……"
    }
    {
      Id = "MelinoeField_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向下的通道……"
    }
    {
      Id = "MelinoeField_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于……"
    }
    {
      Id = "MelinoeField_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "出了厄瑞玻斯……"
    }
    {
      Id = "MelinoeField_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "四下无人……"
    }
    {
      Id = "MelinoeField_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一片寂静……"
    }
    {
      Id = "MelinoeField_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呼。"
    }
    {
      Id = "Chronos_0940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真没礼貌……"
    }
    {
      Id = "Chronos_0941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……好罢。"
    }
    {
      Id = "Chronos_0942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "休想忽视我！"
    }
    {
      Id = "Chronos_0943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真想的话，就忽视我罢。"
    }
    {
      Id = "Chronos_0944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回来……！"
    }
    {
      Id = "Chronos_0945"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就继续前进罢，孙女！"
    }
    {
      Id = "MelinoeField_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，厄瑞玻斯。"
    }
    {
      Id = "MelinoeField_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该往下走了。"
    }
    {
      Id = "MelinoeField_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要下去了。"
    }
    {
