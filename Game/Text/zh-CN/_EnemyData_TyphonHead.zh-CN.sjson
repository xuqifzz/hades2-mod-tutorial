  lang = "zh-CN"
  Texts = [
    {
      Id = "Chronos_1065"
      InheritFrom = "BaseNarrative"
      DisplayName = "衷心希望我没有搅扰你的雅兴，小孙女，不过我恰好登上了这座神圣的山峰，想要一睹我的魔物朋友战斗时的神采。毕竟我只听过传言！"
    }
    {
      Id = "MelinoeField_3783"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你会在这样的夜晚出现的真正原因。嗯，无论是你还是提丰，我现在对付起来都已经得心应手了。不过你们一起上的话……"
    }
    {
      Id = "Chronos_1066"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，不必担心，我现在不过是个无害的幻象。所谓{#Emph}“无害”{#Prev}，自然指的是{#Emph}无法受到伤害{#Prev}。不过，至于能不能伤害到你……很快你就会知道答案。"
    }
    {
      Id = "Chronos_1231"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是不自量力，居然以为区区一个你，能奈何得了我们两个？哪怕是{#Emph}我{#Prev}的强大实力，在众神之父面前，也只能说是相形见绌！"
    }
    {
      Id = "MelinoeField_3784"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们两个都是我的手下败将。没有理由表示我无法再次胜利。你们两个很可能只会相互妨碍而已。"
    }
    {
      Id = "Chronos_1232"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很可能会为提丰带来{#Emph}些许不便{#Prev}，这点我承认。但是对你，小孙女……好嘛，我们拭目以待。"
    }
    {
      Id = "Chronos_1233"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前我使出浑身解数，却仍然让你制伏了提丰，真是岂有此理——真是荒谬至极！但这次，恐怕你不会有那么好的运气。"
    }
    {
      Id = "MelinoeField_3785"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么不会呢？你会出现在这里，仅仅是因为黑夜的意志把你召唤了出来，让我可以直接同时对付你们两个。"
    }
    {
      Id = "Chronos_1234"
      InheritFrom = "BaseNarrative"
      DisplayName = "蛊惑人心的一派胡言！你所看到的幻象之所以存在，完全是因为我自己的意志！你到底有多么狂妄，才会觉得像我一样强大的存在，仅凭{#Emph}一个念头{#Prev}便能由你呼来喝去！"
    }
    {
      Id = "Chronos_1235"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到底要把我的幻象拉到这座山顶上多少次？我该让你知道，这样做对我来说不费吹灰之力！"
    }
    {
      Id = "MelinoeField_3786"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好，爷爷，这样我就不会顾忌麻烦到你了；你这么一大把年纪，早该去享清福去了。我听说神佑群屿那里很适合度假呢！"
    }
    {
      Id = "Chronos_1236"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我还没打算退休呢，好孙女。倒是你应该趁早找个凉快地方待着，别来这插手大人们的事情。"
    }
    {
      Id = "MelinoeField_3790"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我诅咒你{#Prev}，克洛诺斯！等我干掉提丰，就来找你算账！"
    }
    {
      Id = "MelinoeField_3791"
      InheritFrom = "BaseNarrative"
      DisplayName = "立即撤销你对我的所作所为，泰坦，否则我誓要把你从这世界上彻底抹去！"
    }
    {
      Id = "Chronos_1162"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，好吓人啊。但是小女孩可不能这样对爷爷讲话……看来你是{#Emph}欠管教{#Prev}了啊。 "
    }
    {
      Id = "MelinoeField_3792"
      InheritFrom = "BaseNarrative"
      DisplayName = "这怎么可能？我早就不再是曾经那个小女孩了，可是……"
    }
    {
      Id = "MelinoeField_3793"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和那个魔物就尽管笑吧，泰坦，看看谁能笑到最后！"
    }
    {
      Id = "MelinoeField_3794"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得这很有意思吗，泰坦？！"
    }
    {
      Id = "MelinoeField_3795"
      InheritFrom = "BaseNarrative"
      DisplayName = "你犯下了滔天大错，泰坦！"
    }
    {
      Id = "MelinoeField_3796"
      InheritFrom = "BaseNarrative"
      DisplayName = "等我解除这道咒语，就要{#Emph}让你好看！"
    }
    {
      Id = "MelinoeField_3798"
      InheritFrom = "BaseNarrative"
      DisplayName = "很快你就会意识到，我早就不是曾经那个小女孩了！"
    }
    {
      Id = "MelinoeField_3797"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这样羞辱我，是会付出代价的！"
    }
    {
      Id = "MelinoeField_3799"
      InheritFrom = "BaseNarrative"
      DisplayName = "看你们能笑到什么时候，心理扭曲的蠢货！"
    }
    {
      Id = "MelinoeField_3186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我能打到他，可是……"
    }
    {
