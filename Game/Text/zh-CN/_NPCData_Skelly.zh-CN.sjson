      Id = "Skelly_0601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呦，你这是什么意思……"
    }
    {
      Id = "Melinoe_4977"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在尽量控制自己，不要总去想这一切结束之后会发生什么，指挥官。我知道我应该全神贯注于当下的任务，但是……眼看任务有可能要告一段落，我很难不去想未来的事情。"
    }
    {
      Id = "Skelly_0614"
      InheritFrom = "BaseNarrative"
      DisplayName = "停！我跟你说过多少次了，{#Emph}永远别管未来的事{#Prev}，丫头。那样做是不会有好下场的。唯一重要的，是当下！"
    }
    {
      Id = "Melinoe_4978"
      InheritFrom = "BaseNarrative"
