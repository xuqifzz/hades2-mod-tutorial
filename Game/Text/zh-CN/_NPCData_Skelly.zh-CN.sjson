  lang = "zh-CN"
  Texts = [
    {
      Id = "Melinoe_1708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "克洛诺斯必死无疑，指挥官。"
    }
    {
      Id = "Skelly_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你好啊。"
    }
    {
      Id = "Skelly_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "晚上好，年轻人。"
    }
    {
      Id = "Skelly_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "彼此彼此。"
    }
    {
      Id = "Skelly_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然！"
    }
    {
      Id = "Skelly_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "Skelly_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "月光在上，是的。"
    }
    {
      Id = "Skelly_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，丫头，弄死他。"
    }
    {
      Id = "Skelly_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，必死无疑！"
    }
    {
      Id = "Melinoe_3273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "大功告成……！"
    }
    {
      Id = "Skelly_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而现在……暗夜的斗士，即将获得她的{#Emph}奖励{#Prev}……"
    }
    {
      Id = "Melinoe_3274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦……"
    }
    {
      Id = "Skelly_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在，年轻人：收起你的目光吧，免得你被这无上的{#Emph}荣耀{#Prev}震惊得无所适从！"
    }
    {
      Id = "Skelly_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只有最{#Emph}超凡{#Prev}的礼物，才配得上你的{#Emph}超凡{#Prev}壮举！"
    }
    {
      Id = "Skelly_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "第一场战斗以失败告终。但这是场战争，年轻人，前面还有许多场战斗等着你呢！唯一的问题是，你有没有{#Emph}必胜{#Prev}的信念？我看未必，所以{#DialogLegendaryFormat}给我来上{#Prev}{#EmphLegendary}二十下{#Prev}，证明自己的决心吧！"
    }
    {
      Id = "Melinoe_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "瑟勒米乌斯指挥官，您真的要我当着您所有学徒的面，打您整整二十下吗？"
    }
    {
      Id = "Skelly_0452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}没错。{#Prev}往死里打！"
    }
    {
      Id = "Melinoe_0019_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，长官！"
    }
    {
      Id = "Skelly_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿，年轻人，我只是在这边该干啥干啥啦……毕竟，你不费吹灰之力就打败了{#DialogLegendaryFormat}时间泰坦{#Prev}，我还有什么所谓的人生经验值得传授给你的呢？"
    }
    {
      Id = "Melinoe_4159"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，我是来感谢您的。要不是您之前的谆谆教诲，我一定无法取得胜利。"
    }
    {
      Id = "Skelly_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，对！我差点把之前给你的谆谆教诲忘了！那我也要祝贺你让我输掉了和学徒们的赌局，因为我押的是另一边……"
    }
    {
      Id = "Melinoe_4160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等等，您{#Emph}押的是……？"
    }
    {
      Id = "Skelly_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}没有！"
    }
    {
      Id = "Skelly_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的前路坎坷无比，年轻人。所以记好了，我{#Emph}永远{#Prev}会在这里，供你宣泄{#Emph}满腔怒火{#Prev}。以及与你训练。"
    }
    {
      Id = "Melinoe_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最好的老师就是外面的世界……"
    }
    {
      Id = "Skelly_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我不想指责你{#DialogLegendaryFormat}懒惰{#Prev}，但我不得不指出，自从你上次击败我以来，已经过了许多个夜晚了，年轻人。"
    }
    {
      Id = "Melinoe_4052"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以为我在这里的训练基本上已经完成了，指挥官。所有的暗夜武器都在我的掌控之中，而且我对他们已经很是熟悉。我还有必要反复置您于死地吗，指挥官？"
    }
    {
      Id = "Skelly_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，当然，说到底选择权在你，但你别忘了：永远有更多值得你学习的东西，而且要想学到，只有一个办法！"
    }
    {
      Id = "Melinoe_4053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就是反复击打您。"
    }
    {
      Id = "Skelly_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而且还要勤加练习，来吧！"
    }
    {
      Id = "Skelly_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "人生在世，就得知道什么时候该憋住自己的情绪，什么时候又该将情绪宣泄出来。而当你想要宣泄情绪，或者想挑一把{#DialogLegendaryFormat}暗夜武器{#Prev}试试的话，一定要记住：我就在这里。"
    }
    {
      Id = "Melinoe_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我的怒火是留给克洛诺斯的，长官。"
    }
    {
      Id = "Skelly_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看我的学徒们是多么有耐心，钻研着你的一招一式！如果你想要向他们演示一下你的战斗技艺，或者只是想发泄一下情绪，不要犹豫，揍我个{#DialogLegendaryFormat}七荤八素{#Prev}便是。"
    }
    {
      Id = "Melinoe_2256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}七荤八素{#Prev}，长官……？"
    }
    {
      Id = "Skelly_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "记住，年轻人，在这里和你训练的，是手无寸铁的对手。在外面，那些骷髅会{#Emph}移动{#Prev}……而且一等你露破绽，他们就会毫不犹豫地把你千刀万剐！在和我对练的时候，是学不到如何面对那种压力的。"
    }
    {
      Id = "Melinoe_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我明白。"
    }
    {
      Id = "Skelly_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "你那根拐杖用得如何了？你后面{#DialogLegendaryFormat}那滩水{#Prev}里说不定能找到更趁手的武器，{#DialogLegendaryFormat}前提是{#Prev}你得有足够的银矿。拿到新武器之后，一定要记得在我身上试试！"
    }
    {
      Id = "Melinoe_2257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "请不要这样说戴斯奇拉，长官。"
    }
    {
      Id = "Skelly_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "看得出你早就等不及想要出去好好教训教训我们的敌人了，年轻人！那就不用特地为我停留啦。{#DialogLegendaryFormat}快去吧！"
    }
    {
      Id = "Melinoe_3803"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一句话都不说就从三岔路口跑出去，总感觉哪里不对。更何况，您肯定有什么宝贵的人生经验想要与我分享。"
    }
    {
      Id = "Skelly_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，你听好了：就算你在我或者谁的头顶看到一个感叹号，就像在说{#Emph}“快来跟我说话”{#Prev}那种……就算是那样，如果你没有心情的话，也不用硬聊，好么？"
    }
    {
      Id = "Melinoe_3804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我不想跟谁说话，就不搭理谁咯。"
    }
    {
      Id = "Skelly_0395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，爱咋咋地！"
    }
    {
      Id = "Melinoe_4161"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直好奇一件事，指挥官。您不在这里的时候，是去了什么地方？我是说，有的时候您只有在我更换暗夜武器之后才会现身……"
    }
    {
      Id = "Skelly_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，这不关任何人的事，这是我的隐私！每个人都需要独处的时间，不是么？一个能够收拾心情、理清头绪的地方？"
    }
    {
      Id = "Melinoe_4162"
      InheritFrom = "BaseNarrative"
      DisplayName = "您说得对，指挥官……抱歉，是我唐突了。我们是匿踪者；我们栖身于朦胧之中，守护我们的秘密。"
    }
    {
      Id = "Skelly_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而且我们绝不会打探彼此的私事。"
    }
    {
      Id = "Skelly_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近你那个{#DialogLegendaryFormat}祭坛{#Prev}起了一些变化啊，年轻人，而且我注意到你在那里驻足越来越频繁了！或许是在那里觉醒了全新的力量，还是怎么回事？"
    }
    {
      Id = "Melinoe_3364"
      InheritFrom = "BaseNarrative"
      DisplayName = "我为那里的尘灰进行了圣化，因此可以更为深刻地洞悉阿卡那的潜力了，指挥官。这需要少量的月尘，以及大量的专注……或者反过来也行。"
    }
    {
      Id = "Skelly_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#DialogLegendaryFormat}月尘？{#Prev}说起来，那个{#DialogLegendaryFormat}残魂商人{#Prev}最近好像开始兜售那玩意了，不过我{#Emph}听说{#Prev}对你这样的女巫来说，自己炼制一些也不是问题。听起来你最好多囤点货！"
    }
    {
      Id = "Melinoe_3365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可能是的……"
    }
    {
      Id = "Skelly_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "那边{#DialogLegendaryFormat}那滩银色的小水洼{#Prev}里刚才发生了什么，年轻人，我感受到了！是你干的，抑或是命运三女神自己的安排？"
    }
    {
      Id = "Melinoe_2529"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在银辉之池中揭示了暗夜武器的不同形态。准确地说，不算是它们的真实形态……而是不同的形态，每一种都蕴含着无限力量。"
    }
    {
      Id = "Skelly_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，{#DialogLegendaryFormat}暗夜武器！{#Prev}你的哥哥之前也用过差不多的一套武器，而且那些武器也会切换形态。话说回来，如果你想要试一试武器全新的力量，别忘了我就在这里。"
    }
    {
      Id = "Melinoe_2530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我知道的，指挥官。"
    }
    {
      Id = "Skelly_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "我送你的那颗附魔的{#DialogLegendaryFormat}牙齿{#Prev}一定是莫大的助益吧，对不对？不过话说回来，既然你这么快就回来了，也许这个助益也算不上“莫大”……"
    }
    {
      Id = "Melinoe_2586"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有您的牙齿的话，我上一次一定走不了那么远，指挥官。不过，您为什么叫它“{#Emph}更{#Prev}幸运的牙齿”？难道还有另一颗幸运牙齿吗？"
    }
    {
      Id = "Skelly_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，才没有！那可是我在旅行中找到的独一无二的绝世法宝。有了它，你就能像沉船上的水手一样，死死抓住救命的浮木，为自己赢得一线生机。"
    }
    {
      Id = "Melinoe_2587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好强的画面感……"
    }
    {
      Id = "Melinoe_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官……您一定能告诉我一些关于我哥哥的事情吧。我与亲人之间的纽带越强，我们的胜算就越大。您认识他，对吧？"
    }
    {
      Id = "Skelly_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，我认识他。他是个好小子，至少大多数时候算是吧。不过他不会希望你这么惦记着他的。他只希望你……我想，他最希望你……最希望你{#DialogLegendaryFormat}狠狠揍我{#Prev}。能多狠就多狠，能揍多少下就揍多少下。这也是{#Emph}我{#Prev}对你的希望！"
    }
    {
      Id = "Melinoe_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，好吧。"
    }
    {
      Id = "Melinoe_4171"
      InheritFrom = "BaseNarrative"
      DisplayName = "我哥哥一定非常强大，毕竟就连我父亲有时都不是他的对手。您可以教我几招他的拿手招式吗？"
    }
    {
      Id = "Skelly_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，绝对不行！我的每个学徒都要自己闯出一条路来。坚持做你自己吧，也许有一天，你也会强大到能把你老爸打得屁滚尿流！"
    }
    {
      Id = "Melinoe_4172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "指挥官！我父亲现在还困在塔耳塔罗斯，被锁在镣铐里！"
    }
    {
      Id = "Skelly_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就更简单了！"
    }
    {
      Id = "Melinoe_4946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "指挥官，我没理由对我父亲动手啊！"
    }
    {
      Id = "Skelly_0582"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许只是{#Emph}没到时候！"
    }
    {
      Id = "Skelly_0749"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的学徒们说，你最近与{#DialogLegendaryFormat}冥界王子{#Prev}本尊交上了手，而且你在战斗中凶狠得像个邪魔。而我对他们说，{#Emph}别逗。"
    }
    {
      Id = "Melinoe_5673"
      InheritFrom = "BaseNarrative"
      DisplayName = "是真的，指挥官！我突然发现自己身处某个竞技场中，周围看起来像是至福乐土。在那里，扎格列欧斯和我为观战的暗灵献上了一场拳拳到肉的表演赛！"
    }
    {
      Id = "Skelly_0750"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我看起来毫无意义啊，丫头， 毕竟你们都是我一手栽培出来的！你们俩{#Emph}旗鼓相当！{#Prev}我都不知道有什么可比的！"
    }
    {
      Id = "Melinoe_5674"
      InheritFrom = "BaseSubtitle"
      DisplayName = "指挥官，我们一点都不一样。"
    }
    {
      Id = "Skelly_0751"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那小子也会这么说。"
    }
    {
      Id = "Melinoe_4156"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近见到了我的父亲，指挥官……他身在塔耳塔罗斯的最深处，被锁在了镣铐里，沦为了时间的囚徒。他受尽了折磨……就连您的名字他都不记得了！"
    }
    {
      Id = "Skelly_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "那，呃，那真是太糟糕了，年轻人！你老爸和我，我们当年可是最铁的哥们儿。也许他只是受的折磨太多，把以前的事都忘记了吧。"
    }
    {
      Id = "Melinoe_4157"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是无法相信，他居然会把自己最信任的参谋之一忘得一干二净。一定有什么办法能帮助他回想起来。"
    }
    {
      Id = "Skelly_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}不行！{#Prev}你得耐心一点，等他自己想起来。"
    }
    {
      Id = "Melinoe_4169"
      InheritFrom = "BaseNarrative"
      DisplayName = "您会怀念以前的日子吗，指挥官？我指的是您在冥府任职的时候。那时您负责训练我的哥哥，在那里受尽崇敬。"
    }
    {
      Id = "Skelly_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那确实是一段峥嵘岁月。但是，如果我一直像个{#DialogLegendaryFormat}小婴儿{#Prev}一样哇哇大哭，沉湎于过去的话，是绝无可能获得今天的职位的。我永远活在当下！"
    }
    {
      Id = "Melinoe_4170"
      InheritFrom = "BaseNarrative"
      DisplayName = "但是您曾经拥有的一切都不复存在了。其他为冥府效力的人……{#Emph}再怎么说{#Prev}，您对他们的下落也会有些担心吧？"
    }
    {
      Id = "Skelly_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，他们都是{#Emph}神{#Prev}！他们应该没事的啦！"
    }
    {
      Id = "Melinoe_4173"
      InheritFrom = "BaseNarrative"
      DisplayName = "您知道么，我一直都对您胸前的那些勋章很好奇……您的第一枚勋章是什么时候赢得的？最有纪念意义的又是哪一枚？"
    }
    {
      Id = "Skelly_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你是说这些小玩意啊？最早的那个，呃，自从{#DialogLegendaryFormat}伊利昂之战{#Prev}的时候我就戴上了！我戳死了不知道多少人，才赢得了那一枚呢！其他的则是来自于世界各地大大小小的战役啦。"
    }
    {
      Id = "Melinoe_4174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "什么类型的战役？"
    }
    {
      Id = "Skelly_0490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我说了啊，世界各地的战役！"
    }
    {
      Id = "Skelly_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么用那种复杂的表情看着我，年轻人？也许你是在寻找智慧，希望我为你带来启迪？"
    }
    {
      Id = "Melinoe_4178"
      InheritFrom = "BaseNarrative"
      DisplayName = "……指挥官，哪怕是现在，我对您的过去还是几乎一无所知。我得承认……有的时候我开始感觉，你或许有些事情在瞒着我。"
    }
    {
      Id = "Skelly_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？！绝对没有。听着，我在这里是为了训练你的武艺，不是为了念叨以前那些有的没的！不过，好吧。你究竟想要知道什么？"
    }
    {
      Id = "Melinoe_4179"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我想要知道您的真实身份。"
    }
    {
      Id = "Skelly_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那我不告诉你。"
    }
    {
      Id = "Melinoe_4180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……算了。"
    }
    {
      Id = "Skelly_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，那个，我知道我们上次聊得不太愉快，而且我也不想和你闹别扭，所以我就跟你直说吧。"
    }
    {
      Id = "Melinoe_4181"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啊，指挥官。您说的话我总是洗耳恭听。"
    }
    {
      Id = "Skelly_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "是这样的，小丫头，这件事情说出来恐怕会让我惹上大麻烦：你想要知道的事情，我不仅不想告诉你，而且也{#Emph}不该{#Prev}告诉你。"
    }
    {
      Id = "Melinoe_4182"
      InheritFrom = "BaseNarrative"
      DisplayName = "而我猜，您也没办法向我解释背后的原因，对吧。难道是有人强迫您对我隐瞒真相？"
    }
    {
      Id = "Skelly_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，就信我这一次吧，好么？你有你的使命，我也有我的。"
    }
    {
      Id = "Melinoe_4183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……这件事没完。"
    }
    {
      Id = "Melinoe_4997"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，如果我要一如既往地信任您的话，那我就得知道您对我没有任何隐瞒。如果您是在担心透露实情会被人报复的话，我向您发誓我会支持您、保护您周全。"
    }
    {
      Id = "Skelly_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，我担心的是，如果我将实情和盘托出，你就再也没办法像原来那样看待我了！这样对我们两个恐怕都不好。"
    }
    {
      Id = "Melinoe_4998"
      InheritFrom = "BaseNarrative"
      DisplayName = "我宁愿您坦诚相告，让我能够看到真实的您。而且我保证会为您保密，决不背叛您的信任。"
    }
    {
      Id = "Skelly_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哎，既然如此……我的真实身份，确实不是你想象中的“指挥官”那么简单。{#Emph}非也！{#Prev}我{#Emph}远远不止{#Prev}于此……我还在世时，是人们口中的{#Emph}瑟勒米乌弥翁国王{#Prev}！但这还不止，{#Emph}远远不止！{#Prev}我死后还有幸得到你爸爸的任命，是他亲自册封的三位{#DialogLegendaryFormat}亡者判官{#Prev}之一！"
    }
    {
      Id = "Melinoe_4999"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，这也……这也太厉害了！所以……所以在冥界陷落之后，您是躲到了这里避难？"
    }
    {
      Id = "Skelly_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "我，呃，呵呵呵，被你言中了。而我们的敌人，自那之后就一直对我穷追不舍！所以我的行踪，决不能透露给任何人！你的父亲，你的哥哥……{#Emph}任何人都不行。"
    }
    {
      Id = "Melinoe_5000"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么就连我父亲和哥哥都不能知道？他们一定很想知道您安然无恙！"
    }
    {
      Id = "Skelly_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不行！{#Prev}这种秘密联络，必须由我亲自进行。"
    }
    {
      Id = "Melinoe_5001"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我一直以为我父亲是自己判决亡者的。"
    }
    {
      Id = "Skelly_0642"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他确实自己下了很多判决。"
    }
    {
      Id = "Melinoe_2924"
      InheritFrom = "BaseNarrative"
      DisplayName = "您有看到么，指挥官？卡戎大人来探望我们了！我们的补给线终于得到了保障，反攻也由此正式开始。"
    }
    {
      Id = "Skelly_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，当然！老卡戎上次过来，还是好久之前的事了。我们最好在他身边都好好表现！但是，呃……补给线那回事，你又是听谁说的？"
    }
    {
      Id = "Melinoe_2925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，是他亲口跟我说的，长官！用他的方式。"
    }
    {
      Id = "Skelly_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦……"
    }
    {
      Id = "Skelly_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，年轻人，我想问你一个关于老卡戎的问题。你好像能听懂他说的话！那他，呃，有没有提起过什么关于我的事……？"
    }
    {
      Id = "Melinoe_2926"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，我……抱歉，但是他没有提起过。不过下次我一定会为您美言几句的！您是我们不可或缺的重要人物，这点应当向卡戎大人说明才是。"
    }
    {
      Id = "Skelly_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不！{#Prev}我的意思是，呃，就，别……别跟他说这些！别拿这种琐事去打扰冥河摆渡人，何况现在他都忙成那样了……！别给他添麻烦，好吗？"
    }
    {
      Id = "Melinoe_2927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，好！"
    }
    {
      Id = "Melinoe_2996"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，您曾经是我父亲冥府中的贵客，所以您一定认识刻耳柏洛斯，对不对？我觉得我在哀悼原野见到了他，他从头到脚都裹着一层瘴气。他一直都像那样狂躁吗？"
    }
    {
      Id = "Skelly_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没有，以前他通常只是乖乖坐在那里。我跟他是老相识了，只不过……我喜欢和他保持战术距离，毕竟他某种意义上是只{#Emph}狗狗{#Prev}，而我某种意义上是堆{#Emph}骨头{#Prev}。所以他现在成了你的麻烦，是吗？"
    }
    {
      Id = "Melinoe_2795"
      InheritFrom = "BaseNarrative"
      DisplayName = "那不是他的错。克洛诺斯一定是把他从冥府赶了出来，让他在那片原野上游荡。但如果我能把他身上的瘴气驱除干净，我相信他会重回平静的。"
    }
    {
      Id = "Skelly_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我得先提醒你，就算是以前，他也不喜欢洗澡……"
    }
    {
      Id = "Melinoe_2995"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，您曾经是我父亲冥府中的贵客，所以您一定认识刻耳柏洛斯，对不对？我在哀悼原野找到了他，他从头到脚都裹着一层瘴气。他一直都像那样狂躁吗？"
    }
    {
      Id = "Melinoe_2997"
      InheritFrom = "BaseNarrative"
      DisplayName = "那不是他的错。克洛诺斯一定是把他从冥府赶了出来，让他在那片原野上游荡。我破除了他身上的瘴气，让他安静了下来。不过，可能很快就要给他再洗一次了。"
    }
    {
      Id = "Skelly_0626"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以那只巨大狗狗最近怎么样？还是在哀悼原野干坏事吗？估计他只是闲得无聊了。"
    }
    {
      Id = "Melinoe_4987"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以帮他摆脱控制他的东西，但那些东西似乎总会回来。"
    }
    {
      Id = "Skelly_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "那当然了。他可是恶名昭著的{#DialogLegendaryFormat}冥界看门犬{#Prev}！怎么，你不会以为他让你通过了一次，就再也不会阻拦你了吧？"
    }
    {
      Id = "Melinoe_4988"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，我原本是这么希望的。"
    }
    {
      Id = "Skelly_0628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那算你倒霉。"
    }
    {
      Id = "Skelly_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，顺带一提，我想跟你说一声，{#Emph}干得漂亮{#Prev}，恭喜你实现了你的目标！你有实现你的目标，对吧……？把{#DialogLegendaryFormat}克洛诺斯{#Prev}杀了个屁滚尿流？"
    }
    {
      Id = "Melinoe_2920"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，指挥官，我战胜了他。但是，我的终极目标还远没有实现。"
    }
    {
      Id = "Skelly_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，目标就是这个样子的啦！上一个目标刚刚实现，下一个就出现了……那就带着这种势头，杀过去吧！"
    }
    {
      Id = "Melinoe_2921"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命。"
    }
    {
      Id = "Skelly_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说前一夜，你实现了你征程的目标啊，年轻人！我谨代表我和我所有的门徒，为你的这一壮举献上最为衷心的祝贺。"
    }
    {
      Id = "Melinoe_3371"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，指挥官！不过，我能向胜利迈出这一步，全都得益于老师、奥德修斯和您的的敦敦教诲呢。"
    }
    {
      Id = "Skelly_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "太谦虚了，不过说得没错！"
    }
    {
      Id = "Skelly_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以现在你已经揍了克洛诺斯好几回了！跟我们这儿的暗灵说说，接下来会发生什么：他一次次地卷土重来，你要如何才能杀死他？"
    }
    {
      Id = "Melinoe_4353"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，虽然我很想把最新的任务进展说给大家听，但我们都知道，我任务的细节是不容透露的。就算对您也一样。"
    }
    {
      Id = "Skelly_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}就算对我也一样。{#Prev}但至少你可以告诉我，你哥他，他会没事的吧？只是有点担心那小子……"
    }
    {
      Id = "Melinoe_4354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会上您的当的，指挥官。"
    }
    {
      Id = "Skelly_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的学徒们报告说，你抵达了目的地，却在最后功亏一篑。啊，太遗憾了。走了{#Emph}那么远{#Prev}，却只能前功尽弃……"
    }
    {
      Id = "Melinoe_4989"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，现在这样的“鼓励”对我没有益处。我把克洛诺斯逼得退无可退，但最后没能抵挡住他的反扑。这样一来，我也失去了偷袭他的机会！"
    }
    {
      Id = "Skelly_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没错，这糟透了。听着，我很不想这么说，但如果我是你的话，估计就要{#DialogLegendaryFormat}就此隐退{#Prev}了。浪费了这么好的机会，还有什么颜面见人？"
    }
    {
      Id = "Melinoe_4990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "指挥官……！"
    }
    {
      Id = "Melinoe_3807"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，这里的战士们是怎么看待普罗米修斯的？我知道有些凡人很崇拜他，可他现在成了我们的敌人，也许这会让您和您的学徒感到有些为难。"
    }
    {
      Id = "Skelly_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "就是那个为我们带来了火种、理智、美食、艺术，以及其他各种东西的泰坦啊！在那之后，他还因此遭到了众神的报复。我可受不了那家伙，我看他这是咎由自取！"
    }
    {
      Id = "Melinoe_3808"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，他为你们做了这么多事，你还受不了他？不过，有些凡人确实很难取悦……"
    }
    {
      Id = "Skelly_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你倒是说说，他是对你以礼相待，还是想要置你于死地？说不定他以前对我们的好都是为了收买人心呢！毕竟他最近也没给我们帮上什么忙。"
    }
    {
      Id = "Melinoe_3809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他确实想要置我于死地……"
    }
    {
      Id = "Skelly_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "不介意的话帮我跟那些暗灵澄清一下，{#DialogLegendaryFormat}众魔之父{#Prev}才没有回来呢！他们把这谣言传得神乎其神，就连{#Emph}我{#Prev}说的话都不信了！"
    }
    {
      Id = "Melinoe_4059"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，那个……我昨天夜里刚刚跟提丰交过手。克洛诺斯在地底筹划阴谋时，进攻奥林匹斯山的就是那个怪物。"
    }
    {
      Id = "Skelly_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！我，呃，我……我当然知道，我只是……我只是在考验我的学徒们有没有坚持己见的勇气！事实证明他们有。做得好啊，各位！"
    }
    {
      Id = "Melinoe_4060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "所以您一直都知道提丰回来了？"
    }
    {
      Id = "Skelly_0456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那当然！那当然……"
    }
    {
      Id = "Skelly_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，那个，你愿意跟我的学徒们说一声，就说我教了你很多对付{#DialogLegendaryFormat}提丰{#Prev}的手段吗？他们最近有点不服管教，所以，呃，你就帮我个忙吧！"
    }
    {
      Id = "Melinoe_4061"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是，指挥官，您从来没教过我那些……{#Emph}啊{#Prev}，我明白这是怎么一回事了。您想要考验一下我是不是一经煽动，就会去散布谣言！"
    }
    {
      Id = "Skelly_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，没错！没错，就是这么一回事。不过我是真心在求你，拜……拜托，年轻人，你就帮我这一次吧，好不好……？"
    }
    {
      Id = "Melinoe_4062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我是绝不会让您和我蒙羞的。"
    }
    {
      Id = "Skelly_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}……可恶。"
    }
    {
      Id = "Melinoe_4228"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，我要怎样才能打败一个我无法感知到血量的敌人？ 风暴召唤者提丰在我面前掩盖了自己的生命力……但他也一定有他的极限。"
    }
    {
      Id = "Skelly_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道吧，年轻人，我们大多数人和你不一样，没办法感应到其他人的血量。所以我们就一直打，打到有一边死掉为止！也许会有迹象能反映他的状态，比如{#DialogLegendaryFormat}伤痕啦淤青啦{#Prev}之类的？"
    }
    {
      Id = "Melinoe_4229"
      InheritFrom = "BaseNarrative"
      DisplayName = "他不是无敌的。众神曾经用纯粹的力量击败过他……"
    }
    {
      Id = "Skelly_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "往死里打就对了！对其他人都有效！"
    }
    {
      Id = "Skelly_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "替我们的赌局分个胜负吧，年轻人。这些暗灵坚信你{#Emph}亲手{#Prev}打败了{#DialogLegendaryFormat}众魔之父{#Prev}！而作为理智的声音，我的观点是：{#Emph}别闹。"
    }
    {
      Id = "Melinoe_4063"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰最近的失利并非我一人所为，指挥官。我们有整座奥林匹斯山的助力，而且还不止！"
    }
    {
      Id = "Skelly_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！没错，呃，对，我就是这么说的：技术层面上来讲，这件事不是由你{#Emph}一个人{#Prev}完成的。听见了么，学徒们？！当时她有一堆花里胡哨的{#DialogLegendaryFormat}祝福{#Prev}加持，而且谁知道还有别的什么东西！"
    }
    {
      Id = "Melinoe_4064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "所以说，这场赌局是您赢了？"
    }
    {
      Id = "Skelly_0462"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那当然！"
    }
    {
      Id = "Skelly_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又一次把{#DialogLegendaryFormat}提丰{#Prev}从山顶打下去了！也许{#Emph}块头越大，摔得就越狠。"
    }
    {
      Id = "Melinoe_4165"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没有从这个角度考虑过，指挥官，但您说得对！独眼巨人波吕斐摩斯倒下的时候，摔得也蛮狠的。"
    }
    {
      Id = "Skelly_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看吧，就是因为他块头大嘛！"
    }
    {
      Id = "Melinoe_4065"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的学徒们最近士气如何，指挥官？面对普罗米修斯和提丰的重重威胁，只怕最坚定的信念都有可能会动摇。"
    }
    {
      Id = "Skelly_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，他们好着呢！看看他们的样子你就知道了，要多勇敢有多勇敢。不管发生什么灾难，对这里的我们来说，都只是又一夜而已！"
    }
    {
      Id = "Melinoe_4066"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是在努力{#Emph}防止{#Prev}灾难的发生，不是让灾难成为常态。总之，如果事情有什么变化的话，请一定要让我知道。我们需要你们所有人保持最佳状态。"
    }
    {
      Id = "Skelly_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听到了吗，你们这些家伙？保持最佳状态，不然{#Emph}后果自负！"
    }
    {
      Id = "Skelly_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能感觉到一份重担压在了你的肩上，年轻人。没有老阿特拉斯的那份那么沉重，但也够沉重的了！"
    }
    {
      Id = "Melinoe_1580"
      InheritFrom = "BaseNarrative"
      DisplayName = "您对我的下一步计划有什么建议么，指挥官？我是该去地下世界追猎我们的大敌，还是去援助奥林匹斯山上的众神？"
    }
    {
      Id = "Skelly_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有叫你贪心的意思，{#Emph}但是{#Prev}……要我说，你应该去“能获得你所最需要的资源的地方”，{#Emph}不要犹豫{#Prev}！我们这有地表所没有的东西，反之亦然，对不对？"
    }
    {
      Id = "Melinoe_1581"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……大概吧……"
    }
    {
      Id = "Skelly_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "你穿过了原本封住的通道，踏上了前往地表的冒险，真是勇气可嘉。但是{#Emph}拜托！{#Prev}你们这些冥界佬是没法在地表生活的！除非有什么{#DialogLegendaryFormat}咒语{#Prev}能帮上忙……"
    }
    {
      Id = "Melinoe_3366"
      InheritFrom = "BaseNarrative"
      DisplayName = "应该有，指挥官，只不过……那道咒语需要只能在{#Emph}地表{#Prev}找到的炼金材料……但是，我在完成咒语之前，怎么可能收集到它们呢？"
    }
    {
      Id = "Skelly_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也不知道，要不试试{#DialogLegendaryFormat}拼命往那里跑{#Prev}？就算呆不了多久也没事，只要你手够快，把需要的东西拿到，然后赶紧撤回来就好了！"
    }
    {
      Id = "Melinoe_3367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来有点狼狈，不过……"
    }
    {
      Id = "Skelly_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "这次你在地表待得比之前久多了。感觉怎么样？"
    }
    {
      Id = "Melinoe_1578"
      InheritFrom = "BaseNarrative"
      DisplayName = "地表战火纷飞。奥林匹斯众神派了赫拉克勒斯来控制局面。滞留的亡灵无处不在。所以……总的来说，{#Emph}不怎么样{#Prev}。"
    }
    {
      Id = "Skelly_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "亡灵！听起来是招揽学徒的好机会。所以说，记得{#DialogLegendaryFormat}冲向他们{#Prev}，好么？"
    }
    {
      Id = "Melinoe_1579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，长官。"
    }
    {
      Id = "Skelly_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没理解错的话，你最近前往地表的旅途没有持续多久啊，年轻人。想在地表活下去很艰难，向来都是这样！跟轻松惬意的冥界完全不同。"
    }
    {
      Id = "Melinoe_4177"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还没有适应。在那里，一切感官都被放大了……我没能躲过敌人的攻击时，痛得也更厉害。"
    }
    {
      Id = "Skelly_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呀，那你可遭老罪咯。"
    }
    {
      Id = "Skelly_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说你去海底走了一趟。你知道么，年轻人，我也曾经亲自探索过那些深渊！但我不得不承认，我只在很久之前去过一次，而且没有待很久！"
    }
    {
      Id = "Melinoe_1044"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，当然……！您在生前是远近闻名的航海家！所以说，您是船只失事，最终葬身海底了吗？"
    }
    {
      Id = "Skelly_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "才不是！我死得要光荣得多。"
    }
    {
      Id = "Skelly_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近在深海中对付那些潜伏者啦、海蛇啦之类的东西还算顺利吗？不要以为了解了它们就意味着应付得来它们。"
    }
    {
      Id = "Melinoe_2531"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们比在这里徘徊的失落亡魂要强大得多。而且他们不知恐惧，出手时非常果断，毫不迟疑。"
    }
    {
      Id = "Skelly_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "要记住，年轻人，它们不过是会走路的鱼而已。不喜欢说话，只喜欢拿三叉戟捅人！可别被它们捅了。"
    }
    {
      Id = "Melinoe_2532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白。"
    }
    {
      Id = "Skelly_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近的海上旅行体验如何，年轻人？地表那无边无际的浩瀚汪洋让我记忆犹新。多么湛蓝，多么平静！"
    }
    {
      Id = "Melinoe_1045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}平静？{#Prev}跟我的亲身体验好像差得有点多。"
    }
    {
      Id = "Skelly_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该死，以前是很平静的……"
    }
    {
      Id = "Skelly_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和我的学徒们在此恭喜你登上了奥林匹斯山，年轻人！在我们还活着的时候，我们只有在梦中才能攀登那高耸入云的山峰……"
    }
    {
      Id = "Melinoe_3805"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢您的鼓励，指挥官，但我到了那里，还要再往上爬一段路。那边四处都是克洛诺斯的军队……山上的防御措施还把我认成了敌人。"
    }
    {
      Id = "Skelly_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "开什么玩笑！由众神亲手打造的奇械，居然会用那些致命的武器对准{#Emph}你{#Prev}？千里迢迢赶过去为他们解围的{#Emph}你{#Prev}？"
    }
    {
      Id = "Melinoe_3806"
      InheritFrom = "BaseSubtitle"
      DisplayName = "差不多是这么回事。"
    }
    {
      Id = "Skelly_0398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那可真糟糕。"
    }
    {
      Id = "Melinoe_1046"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个旧储物柜……所以说，这是我家族的传家之宝。"
    }
    {
      Id = "Skelly_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错了，在我记忆中一直都是。看到它你就会明白，你身上的重担不需要孤身一人承担。此外，有了它，你收集到的{#DialogLegendaryFormat}信物{#Prev}就可以统统存放在一起了。多方便啊！"
    }
    {
      Id = "Melinoe_1047"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来这便是奥林匹斯山礼尚往来习俗的象征了。现在，延续这个习俗的重任，落到了我们身上。"
    }
    {
      Id = "Skelly_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Skelly_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在储物柜里存放的{#DialogLegendaryFormat}信物{#Prev}越来越多了，年轻人。做得很好，但我必须提醒你，不要只是为了收藏而收藏……"
    }
    {
      Id = "Melinoe_1048"
      InheritFrom = "BaseNarrative"
      DisplayName = "赠予本身就是一种回报。倘若送礼时的动机不纯，蜜露便会变得酸涩。"
    }
    {
      Id = "Skelly_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，在我的训练场上绝对不许“动机不纯”。"
    }
    {
      Id = "Skelly_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的暗夜武器有些异样……有某种{#Emph}灵光{#Prev}笼罩着其中的一件。{#DialogLegendaryFormat}墓地饥渴{#Prev}……"
    }
    {
      Id = "Melinoe_2490"
      InheritFrom = "BaseNarrative"
      DisplayName = "一道相对简单的咒语。我料想到了暗夜的武器与亡者会有更深的联系。您能一眼看出也不意外。"
    }
    {
      Id = "Skelly_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托……虽然我头盖骨后面没长眼睛，但是我能感受到寒意向我的白骨传来！你要是也想要多一些{#DialogLegendaryFormat}骨骸{#Prev}的话，就{#DialogLegendaryFormat}使用有墓地饥渴的武器{#Prev}吧！"
    }
    {
      Id = "Melinoe_2491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有机会的话，我会的。"
    }
    {
      Id = "Skelly_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "那块{#DialogLegendaryFormat}安魂石板{#Prev}大有可为，年轻人！我们军队之中暗灵的数量与日俱增，他们在死后还有机会实现自己的价值！"
    }
    {
      Id = "Melinoe_2495"
      InheritFrom = "BaseNarrative"
      DisplayName = "要等到我的冥王父亲重回王座，他们的生活才能得到真正的改善。"
    }
    {
      Id = "Skelly_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，这点毋庸置疑！但首先，我们要为之战斗！"
    }
    {
      Id = "Skelly_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "那块{#DialogLegendaryFormat}漆黑之石{#Prev}点亮的时候，我的学徒们可都吓了一跳！你知道它是什么，对吧？"
    }
    {
      Id = "Melinoe_2818"
      InheritFrom = "BaseNarrative"
      DisplayName = "它出自混沌深渊，是黑暗的纯粹结晶——在它无数的切面中，呈现着无数的结局。也许这些结局没有任何一个出自命运的设计。"
    }
    {
      Id = "Skelly_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，当然。"
    }
    {
      Id = "Skelly_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都看到你融入了那块{#DialogLegendaryFormat}漆黑之石{#Prev}。又多了一个让你立即行动，攻敌不备的手段！{#Emph}真不错！"
    }
    {
      Id = "Melinoe_2928"
      InheritFrom = "BaseNarrative"
      DisplayName = "那块漆黑之石一直都放在那里。它远不止是纪念黑夜和混沌的碑石；追本溯源，它比表面上古老得多。但我此前从来没有把它当作过进攻的手段……"
    }
    {
      Id = "Skelly_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "毕竟它也不能拿来砸我的脑壳嘛。不过我{#Emph}懂你{#Prev}！"
    }
    {
      Id = "Skelly_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "你经常往那个{#DialogLegendaryFormat}漆黑之石{#Prev}里面钻啊，年轻人。我和学徒们都觉得，那里面一定有什么好东西！"
    }
    {
      Id = "Melinoe_4154"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，实话说，那里面也不是什么世外桃源。每当我使用漆黑之石的时候，在很多方面都和平常的夜晚没有什么不同，除了……我真的不该多说。"
    }
    {
      Id = "Skelly_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎拜托，为什么不说？又不会有人告你的状。我说，难道我们还没有赢得你的信任吗，还是怎么的？"
    }
    {
      Id = "Melinoe_4155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "漆黑之石的秘密，要留给漆黑之石自己揭晓。"
    }
    {
      Id = "Skelly_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你认真的？"
    }
    {
      Id = "Skelly_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的双眼没有欺骗你！在这里的出口旁边，是大名鼎鼎的{#DialogLegendaryFormat}匿踪者之誓{#Prev}，应该是叫这个名字吧。与其问我它是从哪来的，不如问问你自己到底能{#Emph}吃多少苦{#Prev}！"
    }
    {
      Id = "Melinoe_2813"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在我可以浏览誓言了……黑夜的誓言。我有胆量立誓么……？然后散播黑暗所带来的恐惧……？"
    }
    {
      Id = "Skelly_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，你怎么回事，难不成是{#Emph}害怕{#Prev}了吗？你手里的那些暗夜武器，它们估计爱死这些{#DialogLegendaryFormat}恐惧{#Prev}、{#DialogLegendaryFormat}誓言{#Prev}之类的了。要我说，试试也无妨！能出什么岔子呢？"
    }
    {
      Id = "Melinoe_2814"
      InheritFrom = "BaseNarrative"
      DisplayName = "比如，让整个世界的凡人永世陷入折磨与绝望之中……？"
    }
    {
      Id = "Skelly_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没关系的啦！"
    }
    {
      Id = "Skelly_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "有了{#DialogLegendaryFormat}匿踪者之誓{#Prev}后，凡人是不是真的永世陷入折磨之中了？你那些{#DialogLegendaryFormat}暗夜武器{#Prev}，应该都很享受增长的恐惧吧！"
    }
    {
      Id = "Melinoe_2815"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗夜武器确实对匿踪者之誓有所反应；随着我完成黑夜的任务，它们的力量也在逐渐增长，啜饮着凡人对黑暗的恐惧中诞生的梦魇。"
    }
    {
      Id = "Skelly_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来棒极了！"
    }
    {
      Id = "Melinoe_2816"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道您见多识广，指挥官，可是……您究竟是怎么对匿踪者之誓有这么多了解的？据我所知，它甚至在我父亲统治冥界之前就已经存在了。"
    }
    {
      Id = "Skelly_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没错，你爸爸用的是另一种策略。他对他的惩罚契约情有独钟！他跟你哥的矛盾达到顶峰时，甚至还让你哥去签了那个契约。那小子还真的说签就签，然后{#Emph}热度{#Prev}就真的蹭蹭往上蹿啦！"
    }
    {
      Id = "Melinoe_2817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您没有回答我的问题呢。"
    }
    {
      Id = "Skelly_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我是不会回答的！因为我也有自己的誓言要遵守。"
    }
    {
      Id = "Skelly_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "昨晚那么可怕，我们都提心吊胆的。有{#DialogLegendaryFormat}匿踪者之誓{#Prev}发挥作用，在外面闯荡可没那么容易！"
    }
    {
      Id = "Melinoe_4175"
      InheritFrom = "BaseNarrative"
      DisplayName = "誓言的确会让我的任务更困难，但它们也在一点一滴地增进我的实力。您是在建议我把誓言放宽松一点吗？"
    }
    {
      Id = "Skelly_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是说，如果你受不了的话，就给那玩意调低点，这边没人会说什么的！我宁愿你{#Emph}放宽松{#Prev}一点，也不想你彻底{#Emph}放弃{#Prev}啊。"
    }
    {
      Id = "Melinoe_4176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这两项都不够好。"
    }
    {
      Id = "Skelly_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "你现在一定觉得自己很厉害了吧，毕竟克洛诺斯那些家伙都被你一遍又一遍地干趴下了！但你有把自己逼到极限吗？还是说，你让自己过得太{#DialogLegendaryFormat}轻松{#Prev}了？"
    }
    {
      Id = "Melinoe_4163"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕没人会觉得打败时间泰坦是件轻松的事，指挥官。不过我明白您的意思。匿踪者之誓在呼唤我……"
    }
    {
      Id = "Skelly_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，用一用嘛，我和学徒们都用上激将法了！这样你就可以给你的{#DialogLegendaryFormat}暗夜武器{#Prev}升升级，我们也可以看看会发生什么！{#Emph}双赢！"
    }
    {
      Id = "Melinoe_4164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "除非我失败。"
    }
    {
      Id = "Skelly_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你？失败？怎么可能。"
    }
    {
      Id = "Skelly_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "你那{#DialogLegendaryFormat}尘灰祭坛{#Prev}散发出的熏香和烟雾之类的，让这里的暗灵精神抖擞啊！就连我也倍感亢奋。"
    }
    {
      Id = "Melinoe_2588"
      InheritFrom = "BaseNarrative"
      DisplayName = "这让我很欣慰，指挥官。哪怕只是在行动之夜略微花一点时间在祭坛前冥想，都能让我感觉信心倍增。"
    }
    {
      Id = "Skelly_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就继续去做你该做的事吧！"
    }
    {
      Id = "Skelly_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的磨练永远不会白费，年轻人！你并非肉体凡胎；每一夜的经历，都会增长你的知识和力量！尤其是如果你开一下那个{#DialogLegendaryFormat}神力模式{#Prev}的话，就更加势不可挡了！"
    }
    {
      Id = "Melinoe_2922"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是只凭神力就能完成我的任务，那就好了，指挥官。不过，您最后那句话说……呃……您到底在说什么？"
    }
    {
      Id = "Skelly_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，{#DialogLegendaryFormat}神力模式{#Prev}啊？就是一个{#Emph}模式{#Prev}啦，你只要{#Emph}按一下{#Prev}就能打开了！再按一下就能关闭，全凭你的心意！我的意思是，它就是个选项啦，所以你想开的话就开吧！"
    }
    {
      Id = "Melinoe_2923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只是个选项……"
    }
    {
      Id = "Skelly_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "你现在有{#DialogLegendaryFormat}魔宠{#Prev}了！啊，你的学徒就是我的学徒，年轻人。你不在的时候，它们会在这里得到训练和照顾，而且只要它们愿意，也随时欢迎它们揍我哦？"
    }
    {
      Id = "Melinoe_3552_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好的，长官。"
    }
    {
      Id = "Skelly_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的部队非常感谢你为训练场做出的这些改进，年轻人！很快这里就能成为一座名副其实的兵营了！"
    }
    {
      Id = "Melinoe_3810"
      InheritFrom = "BaseNarrative"
      DisplayName = "任何对士气的提升都是值得的。您还有其他想要看到的改进吗？"
    }
    {
      Id = "Skelly_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你知道的，我这个人别无所求！时不时过来狠狠砸一下我的脑壳，我就心满意足了。"
    }
    {
      Id = "Melinoe_3811"
      InheritFrom = "BaseSubtitle"
      DisplayName = "需要别的东西，就跟我说哦。"
    }
    {
      Id = "Skelly_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，感受{#DialogLegendaryFormat}姊妹双刃{#Prev}穿髓刺骨的快意！也许这是砍过我的武器中最锋利的一对了！"
    }
    {
      Id = "Melinoe_2492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "能使用它们是我的荣幸。"
    }
    {
      Id = "Skelly_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你唤醒了那对双刃的全新力量。我就知道它们肯定有什么花哨的把戏！你哥哥以前的那些武器，也都差不多是这样激活的！"
    }
    {
      Id = "Melinoe_4273"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府兵器也有隐藏形态……不过我很好奇，会是谁的形态呢？也许有一个形态属于您呢，指挥官！命运三女神不止将武器赐予过诸神，也赐予过凡间的英雄……"
    }
    {
      Id = "Skelly_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "当心啊，年轻人！这些武器的秘密，不要在光天化日之下大声嚷嚷嘛……"
    }
    {
      Id = "Melinoe_4274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您说得对。抱歉。"
    }
    {
      Id = "Skelly_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "那{#DialogLegendaryFormat}月石之斧{#Prev}的蛮横力量是你的了！外面没什么是它一斧子劈不开的，就连{#Emph}我{#Prev}也不例外！"
    }
    {
      Id = "Melinoe_2493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实分量十足。"
    }
    {
      Id = "Skelly_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "这可是{#DialogLegendaryFormat}暗影之炬{#Prev}，年轻人！有这两件武器在手，你看起来简直就和咱们的女巫老大一模一样。愿它们永远为你点亮前路，以及点燃你不喜欢的人。"
    }
    {
      Id = "Melinoe_2494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会像老师一样战斗的。"
    }
    {
      Id = "Skelly_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "我必须得向{#DialogLegendaryFormat}银白之颅{#Prev}的持有者致敬！要是我自己的颅骨也像那样有白银加固，能够产生令人震撼的爆炸就好了！"
    }
    {
      Id = "Melinoe_3812"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只有这么好的颅骨，才配得上敲您的头。"
    }
    {
      Id = "Skelly_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以这就是大名鼎鼎的{#DialogLegendaryFormat}漆黑战衣{#Prev}啊！这样的武器，全世界都从未见过！大概是因为所有蠢到挡在它面前的人，都被它轰成炮灰了吧！"
    }
    {
      Id = "Melinoe_3813"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感觉它就像是为我量身打造的一样……"
    }
    {
      Id = "Skelly_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，你现在的无数成就，和你未来所能获得的相比，都只会相形见绌！只要你能证明自己的力量，{#DialogLegendaryFormat}永恒的荣耀{#Prev}就非你莫属了！"
    }
    {
      Id = "Melinoe_3269"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些布幔上的图案……这一定是传说中的帷幕之礼，对黑夜最为衷心的仆人的嘉奖……！指挥官，把这些摆在这里做什么？它们不应该被暗灵看到才对！"
    }
    {
      Id = "Skelly_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，这么说吧，规矩最近变了！用你的话说，这些{#Emph}“嘉奖”{#Prev}，现在就等待你来赢取……只要你能完成{#DialogLegendaryFormat}匿踪者之誓{#Prev}为你布置的任务！当然，你肯定也猜到了，这些任务绝非等闲之举。"
    }
    {
      Id = "Melinoe_3270"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这只是对于我的贪欲和傲慢的考验……在誓言上轻率冒进，誓必会将我的任务置于危险之中。"
    }
    {
      Id = "Skelly_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，别跟个{#Emph}小婴儿{#Prev}似的啦！"
    }
    {
      Id = "Skelly_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，你准备好赢得那边的帷幕之礼了吗？还是说，你打算就这样浪费掉夺得{#DialogLegendaryFormat}永恒荣耀{#Prev}的大好时机？"
    }
    {
      Id = "Melinoe_3271"
      InheritFrom = "BaseNarrative"
      DisplayName = "永恒荣耀……如果那是对完成了超凡壮举的嘉奖，那我会欣然接受。但要把追寻荣耀本身当作目标？总感觉哪里不对……至少，这从来不是属于我们的方式。"
    }
    {
      Id = "Skelly_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我们的方式可以{#Emph}改变{#Prev}，你说不是么？我们不能总是困于过去，一成不变、固步自封！当然，我不是给你{#Emph}上压力{#Prev}啦，小丫头，只是……我总觉得，这些东西注定要属于你，所以你应该努力争取才是。"
    }
    {
      Id = "Melinoe_3272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我会考虑的。"
    }
    {
      Id = "Skelly_0358_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "已经成功了一半了，小丫头！不过，要赢得帷幕之礼，就必须在{#DialogLegendaryFormat}恐惧{#Prev}蔓延的夜晚征服地上和地下世界，二者缺一不可。准备好继续挑战了吗？"
    }
    {
      Id = "Melinoe_3362"
      InheritFrom = "BaseNarrative"
      DisplayName = "为了冥界的荣誉，以及黑夜永恒不灭的统治，我会尽我所能。但那是否足以让我赢得帷幕之礼，我心里也没数。"
    }
    {
      Id = "Skelly_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，这叫什么态度？你都完成冥界的挑战了，现在只需要去把地表的挑战也完成，帷幕之礼就归你了！至少第一件归你。快去，快去！"
    }
    {
      Id = "Melinoe_3363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好的……！"
    }
    {
      Id = "Skelly_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "已经成功了一半了，年轻人！不过，要赢得帷幕之礼，就必须在{#DialogLegendaryFormat}恐惧{#Prev}蔓延的夜晚征服地上和地下世界，二者缺一不可。准备好继续挑战了吗？"
    }
    {
      Id = "Skelly_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，这叫什么态度？你都完成地表的挑战了，现在只需要去把冥界的挑战也完成，帷幕之礼就归你了！至少第一件归你。快去，快去！"
    }
    {
      Id = "Skelly_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "第二件{#DialogLegendaryFormat}帷幕之礼{#Prev}近在{#Emph}咫尺{#Prev}！其实你要是想走过去摸一摸的话我也拦不住你，但、但总之，你、你有没有准备好使用{#DialogLegendaryFormat}匿踪者之誓{#Prev}，然后完成另一边的挑战？"
    }
    {
      Id = "Melinoe_3485"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是故意要给您留悬念的，指挥官，但我们恐怕得拭目以待了。"
    }
    {
      Id = "Skelly_0373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要不是我不用呼吸，我就要为你屏住呼吸了！"
    }
    {
      Id = "Skelly_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "最后一件，也是最有纪念意义的{#DialogLegendaryFormat}帷幕之礼{#Prev}几乎就要属于你了！如果你能在誓言下完成两条路线之一，那么另一条对你来说，也一定只是闲庭信步而已！"
    }
    {
      Id = "Melinoe_3486"
      InheritFrom = "BaseNarrative"
      DisplayName = "只怕您所说的这个“闲庭”里面处处暗藏杀机。"
    }
    {
      Id = "Skelly_0375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "某些地方嘛……肯定是的。"
    }
    {
      Id = "Melinoe_3288"
      InheritFrom = "BaseNarrative"
      DisplayName = "想不到帷幕之礼居然是那些雕像……我一直以为礼物是帷幕本身……那些幕布是用命运三女神最为精美的丝线织就的。说起来，之前那些帷幕哪去了？"
    }
    {
      Id = "Skelly_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那些啊，我们，呃，我们把那些帷幕送回阴影之中了，正如它们从阴影之中来。它们不过是些包装材料，你知道的吧？留在这里的才是{#DialogLegendaryFormat}货真价实的宝贝{#Prev}，我发誓！"
    }
    {
      Id = "Melinoe_3289"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是觉得很难以置信，黑夜居然会用这样浮夸的塑像作为对我的嘉奖。不过，也许这些礼物比起送给{#Emph}我{#Prev}，更重要的是送给那些聚集在我们麾下的人……"
    }
    {
      Id = "Skelly_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么一说还真是，那些暗灵确实喜欢趁你不在的时候，对着雕像{#Emph}仔细{#Prev}端详。就算你不在这里，也可以鼓舞他们的斗志！还有什么比这更能称得上是{#DialogLegendaryFormat}永恒的荣耀{#Prev}？"
    }
    {
      Id = "Melinoe_3290"
      InheritFrom = "BaseNarrative"
      DisplayName = "就因为我专门为了一己私利滥用匿踪者之誓，这些暗灵就得到了鼓舞……？"
    }
    {
      Id = "Skelly_0324_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}没错！{#Prev}他们很容易满足！但你好像不是这样。天啊，我之前从来没想过，黑夜战将居然会一直这样问东问西！给个痛快话吧，你到底想不想要这些雕像？"
    }
    {
      Id = "Melinoe_3291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我……我想要！"
    }
    {
      Id = "Skelly_0325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很好！毕竟那些是一经拆封概不退换的。 "
    }
    {
      Id = "Melinoe_3292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……什么？"
    }
    {
      Id = "Skelly_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "怎么了！"
    }
    {
      Id = "Melinoe_3275"
      InheritFrom = "BaseNarrative"
      DisplayName = "……指挥官，这该不会……该不会是{#Emph}我{#Prev}吧？"
    }
    {
      Id = "Skelly_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是命运所预言的{#DialogLegendaryFormat}黑夜战将{#Prev}！传说她将让{#DialogLegendaryFormat}恐惧{#Prev}贯穿敌人的肺腑，让胆敢与冥界为敌之人闻风丧胆，诸如此类！我看得出你现在相当不知所措——没错，这便是她凛凛的威仪！而这还仅仅是第一座而已！"
    }
    {
      Id = "Melinoe_3276"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实是很不知所措。那，其他的礼物也像这个一样……呃，一样精美吗？总之，我不确定我能不能接受两倍，或者三倍于此的荣耀，更何况我的任务本身已经相当艰巨……"
    }
    {
      Id = "Skelly_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，所以你感受到了{#DialogLegendaryFormat}恐惧{#Prev}。不要在恐惧面前屈服，年轻人！要屈服的话，那就屈服于对其他辉煌的礼物的{#DialogLegendaryFormat}好奇心{#Prev}吧！想一想，那将会是何等的荣光！现在你可以选择做半途而废的懦夫，或是做{#DialogLegendaryFormat}黑夜战将{#Prev}——你要怎么选？"
    }
    {
      Id = "Melinoe_3277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我一定要这一刻给您答复吗？"
    }
    {
      Id = "Skelly_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不用啦，你想考虑多久都行。"
    }
    {
      Id = "Melinoe_3280"
      InheritFrom = "BaseNarrative"
      DisplayName = "……指挥官，我……我一时不知道该说什么才好！但我非常荣幸，真的。"
    }
    {
      Id = "Skelly_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你{#Emph}是该{#Prev}荣幸才对！你压根就不知道我——我是说{#Emph}命运三女神{#Prev}——费了多大的功夫才把这些东西准备好！但{#DialogLegendaryFormat}黑夜战将{#Prev}理应赢得最上乘的奖励——也就是你还没有见到的，最后一件礼物！"
    }
    {
      Id = "Melinoe_3281"
      InheritFrom = "BaseNarrative"
      DisplayName = "一想到还有比这更“上乘”的雕像，我就觉得魂不守舍。它上面也盖着黑夜的帷幕……我要是偷偷看一眼的话，又有谁能阻止我呢？{#Emph}您{#Prev}似乎也已经看过了。"
    }
    {
      Id = "Skelly_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来，你可能终究不是{#DialogLegendaryFormat}黑夜战将{#Prev}啊，居然会提出这样卑鄙的计策！你想要赢得至高的荣誉，就必须先用荣誉约束自己！而荣誉就意味着不许偷看！还等什么，快去用{#DialogLegendaryFormat}匿踪者之誓{#Prev}吧！"
    }
    {
      Id = "Melinoe_3282"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我不知道。这整件事在我眼里都多少有些不明智。虽然我很感谢您的鼓励，您的话语也让我很受鼓舞，但也许我不应该这么快就把自我价值建立在积累物质的财富上。"
    }
    {
      Id = "Skelly_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，年轻人，你怎么能这么说呢！"
    }
    {
      Id = "Melinoe_3285"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我感到万分荣幸，指挥官。既因为我能够为冥界效力，也因为我赢得了这么……这么引人浮想联翩的雕像。我原本以为艺术的意义在于展现美；我从没想过艺术还能激起这么多……复杂的情感。"
    }
    {
      Id = "Skelly_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "光是我想破脑袋把这些东西趁你不注意运过来，就激起了我很多复杂的情感呢！话说回来，{#DialogLegendaryFormat}恭喜你啊{#Prev}。我们本来打算为你举办一场庆功宴，但是……呃，这件事情不该被别人知道。所以这就只能当作我们之间的小秘密了。"
    }
    {
      Id = "Melinoe_3286"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以这就意味着，我真的成为黑夜战将了吗？永恒的荣耀也属于我了？"
    }
    {
      Id = "Skelly_0321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这还用问。"
    }
    {
      Id = "Melinoe_3287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……好。"
    }
    {
      Id = "Skelly_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "你拥有的每件{#DialogLegendaryFormat}暗夜武器{#Prev}都有独特的招式！不要执着于为它们分个强弱；只要听从你心底的声音做出选择就好。"
    }
    {
      Id = "Melinoe_4054"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果它们在我的心底都有声音呢？虽然只是低语啦。"
    }
    {
      Id = "Skelly_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就选有奖励骨骸的那一个！"
    }
    {
      Id = "Skelly_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "碰到外面那些蠢货的时候，如果他们身上有{#DialogLegendaryFormat}黄色的屏障{#Prev}，就务必要当心了！在你击穿他们的防护之前，他们随时可以还手！"
    }
    {
      Id = "Melinoe_4167"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实，那些有护甲的敌人无论我怎么打，都是纹丝不动。"
    }
    {
      Id = "Skelly_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很正常的，谁来都一样。"
    }
    {
      Id = "Skelly_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "小丫头，在外面找到的那些{#DialogLegendaryFormat}尘灰{#Prev}一定要顺手拿走。这样你就可以把它们糊到你的祭坛上，解锁那些酷炫的{#DialogLegendaryFormat}卡牌{#Prev}了！用不了多久，你就会变得越来越强。"
    }
    {
      Id = "Melinoe_4166"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿卡那会揭示我最大的潜能……在过往的灰烬中，能瞥见未来的可能性。"
    }
    {
      Id = "Skelly_0481_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "把那些蠢货统统打扁的可能性！"
    }
    {
      Id = "Skelly_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "不在战斗中使用的话，你的那些训练是派不上用场的。假如我现在拿着根棍子追你，而你想让我原地站定。来，让我见识见识你的{#DialogLegendaryFormat}缚身法阵{#Prev}！"
    }
    {
      Id = "Skelly_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "别忘了对你的{#DialogLegendaryFormat}法阵{#Prev}善加利用。可以让那些蠢货寸步难行！而且，如果你用的是{#DialogLegendaryFormat}欧米伽{#Prev}版本的话……轰！"
    }
    {
      Id = "Melinoe_4168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "缚身法阵确实有很多妙用……"
    }
    {
      Id = "Skelly_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "施展你的巫术会耗费魔力。但这是暂时的——因为等到你抵达你要去的下一个地点的时候你的魔力值就会完全恢复了！所以{#Emph}该用就用{#Prev}，没什么舍不得的！"
    }
    {
      Id = "Skelly_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在外面遇到的蠢货，有一些皮糙肉厚得很！但你那些华丽的{#DialogLegendaryFormat}欧米伽招式{#Prev}可以轻松将他们融化掉。{#Emph}战斗打得累？{#Prev}{#DialogLegendaryItalicFormat}蓄力显神威。"
    }
    {
      Id = "Melinoe_4055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "魔力需要节省，只有需要时才能动用。"
    }
    {
      Id = "Skelly_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而你{#Emph}需要{#Prev}胜利！"
    }
    {
      Id = "Skelly_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道伟大的塞勒涅将她的{#DialogLegendaryFormat}巫咒{#Prev}之一赐予了你。那是很强大的效果，但你必须得先用许多魔力为它充能！呃，就像给水晶充能一样！"
    }
    {
      Id = "Melinoe_3359"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，我原本还以为您的造诣主要是在武术层面的。这样说来，您对魔法的内在原理也了如指掌吗？"
    }
    {
      Id = "Skelly_0342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是。"
    }
    {
      Id = "Skelly_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "身为潜伏于暗影之中的冥界居民，你有许多别人难以企及的天赋，年轻人！比如说，{#DialogLegendaryFormat}当你冲刺的时候，什么都伤不到你！{#Prev}"
    }
    {
      Id = "Melinoe_3357"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是匿踪者……与黑暗和亡者形影不离。我有能力躲开任何攻击，没错，但只有那么短短的一刹那。而且就算如此……只靠闪避，是没有办法取得胜利的。"
    }
    {
      Id = "Skelly_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，如果我是你的话，我就会到处闪来闪去！看到你冲刺的时候背后那条{#DialogLegendaryFormat}踪迹{#Prev}了吗？一旦它消失，就意味着你可以{#Emph}再次{#Prev}冲刺了！"
    }
    {
      Id = "Melinoe_3358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}如影随形……"
    }
    {
      Id = "Skelly_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的身手越来越快了，年轻人。真的很快！真希望我也可以像你一样，一个{#DialogLegendaryFormat}冲刺{#Prev}就能让人{#DialogLegendaryFormat}望尘莫及{#Prev}，或者跑得飞快，像只……像只母狼之类的！好了，去给我跑上几圈！"
    }
    {
      Id = "Skelly_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里随时欢迎新学徒。在外面见到那些发呆的亡者之灵的时候，要牢记你的训练，{#DialogLegendaryFormat}径直跑向他们{#Prev}！他们会醒悟过来的。"
    }
    {
      Id = "Melinoe_1577"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们不仅仅会“醒悟”，长官。他们随时准备着加入我们的战斗。现在，他们已经知道我的真实身份，以及我们的阵营所象征的意义。"
    }
    {
      Id = "Skelly_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿你多多撞上他们。"
    }
    {
      Id = "Skelly_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "我那跑来跑去抢东抢西的日子或许已经过去了，但你的才刚刚开始，丫头！在外面一定要睁大你的眼睛，不要放过任何你能加以利用的东西，而且一定要记得在包里装上最合适的{#DialogLegendaryFormat}工具{#Prev}。"
    }
    {
      Id = "Melinoe_2254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您还有过跑来跑去……抢东抢西的日子？"
    }
    {
      Id = "Skelly_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，遇上什么烦心事了吗？看到你面露难色，我就知道我那丰富的经验又有机会派上用场了。来吧，跟我说说！"
    }
    {
      Id = "Melinoe_3368"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，指挥官……我只是在想我需要的各种各样的炼金材料。它们有的长在不同的区域，有的需要不同的工具……要把这些全都记在脑子里真的很难。"
    }
    {
      Id = "Skelly_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你不用非得记在脑子里啊！那个不知为何能把你所有东西装下的{#DialogLegendaryFormat}紫色袋子{#Prev}……你的笔记不也都在里面吗？所以如果你记不起来该去哪里采集某件东西，看看{#Emph}那里{#Prev}就好！事实上，你现在就可以去看一眼！"
    }
    {
      Id = "Melinoe_3369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "笔记确实都在那里……"
    }
    {
      Id = "Skelly_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和冥界的联系，意味着你在每个路口都能感知到前面有什么。就好像洞见未来的一扇扇窗户！你也许还不清楚那些标志都意味着什么，但你早晚会弄明白的。"
    }
    {
      Id = "Melinoe_4056"
      InheritFrom = "BaseNarrative"
      DisplayName = "洞见未来的一扇扇窗户……这样一来，在道路分岔时，我就可以选择看起来最好的那一条路了。"
    }
    {
      Id = "Skelly_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我是你的话，肯定会这么做。"
    }
    {
      Id = "Skelly_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "随着经验积累，人们便能摸清许多事物的窍门。而{#Emph}我的{#Prev}窍门之一便是侦测骨骸，各种形状各种大小的骨骸，都逃不过我的法眼！丫头，你身上的骨骸可真不少啊。"
    }
    {
      Id = "Melinoe_3480"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在亡者的界域，指挥官。骨骸在这里很容易找到，尤其是在这么接近地表的地方。不过……这些东西可能在残魂商人那里会更有用。"
    }
    {
      Id = "Skelly_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正要这么说呢！或许你能在某道咒语中用上这些骨骸没错，但是我们的{#DialogLegendaryFormat}残魂商人{#Prev}老兄肯定会照单全收。"
    }
    {
      Id = "Melinoe_3481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是我喜欢囤着……"
    }
    {
      Id = "Skelly_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，在你每夜出发之前，一定要做出明智的选择！要去祭坛选{#DialogLegendaryFormat}阿卡那{#Prev}，要选{#DialogLegendaryFormat}暗夜武器{#Prev}，要选随身的{#DialogLegendaryFormat}信物{#Prev}，还要选{#DialogLegendaryFormat}魔宠{#Prev}，{#Emph}我的天……"
    }
    {
      Id = "Melinoe_3370"
      InheritFrom = "BaseNarrative"
      DisplayName = "您这样说起来，确实感觉要考虑很多东西，指挥官。但是我的目标始终明确：{#Emph}找到泰坦、杀死泰坦。解救我的家人、解救奥林匹斯。"
    }
    {
      Id = "Skelly_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔，听起来像是四件不一样的事情啊……"
    }
    {
      Id = "Skelly_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算在外面挨了揍，也不要灰心丧气，知道了么？借助你的{#DialogLegendaryFormat}祭坛{#Prev}和那边{#DialogLegendaryFormat}那滩银色的小水洼{#Prev}，你会在一次次磨炼之中变得更加强大，直到只有{#Emph}你揍别人{#Prev}的份！"
    }
    {
      Id = "Melinoe_2255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您是指银辉之池，长官。"
    }
    {
      Id = "Skelly_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经达到了你{#DialogLegendaryFormat}阿卡那悟性{#Prev}的上限了啊。大家都会遇到这种事的！你只需要多弄来一些{#DialogLegendaryFormat}魂魄{#Prev}，然后很快就能领悟更多卡牌了！"
    }
    {
      Id = "Melinoe_3355"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和亡者的牵绊，我和过往的牵绊……而祭坛就是连结这一切的导体！欸，指挥官，您也可以将阿卡那牌化为己用吗？"
    }
    {
      Id = "Skelly_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，我以前画得还挺像的，不过，呃，可能还是没有原本的画好看吧。"
    }
    {
      Id = "Melinoe_3356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您是{#Emph}“画为己用”{#Prev}吗，长官……？"
    }
    {
      Id = "Skelly_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么了，年轻人，是不是有种一筹莫展的感觉？虽然你是一筹莫展没错啦，但至少你在精神层面上有所进展！"
    }
    {
      Id = "Melinoe_4057"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是什么进展，指挥官……？我离消灭泰坦的目标还有很长的距离。我得走得更远才行。"
    }
    {
      Id = "Skelly_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你只是需要记住多用{#DialogLegendaryFormat}冲刺{#Prev}，别老挨打，还有多整点那些{#DialogLegendaryFormat}阿卡那牌{#Prev}，一下子强度就上去了！再有就是，每晚会发生的事情都会有所不同啦。"
    }
    {
      Id = "Melinoe_4058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "希望今晚发生的事情别那么糟糕。"
    }
    {
      Id = "Skelly_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，{#Emph}诅咒{#Prev}这把越来越脆的老骨头，再也没办法像以前那样承受你的反复攻击了！以前我真的很耐打，但最近，我再也不敢这么说了……"
    }
    {
      Id = "Melinoe_4947"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，您怎么了？我还以为您一直渴望被我拥有的所有武器打个遍呢，打得越狠越好。现在我应该有所保留吗？"
    }
    {
      Id = "Skelly_0584"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不行！{#Prev}我的毕生所求唯有承受尽可能多的攻击，直到散落一地，然后再把自己拼回来。你现在比之前强了太多，可我却{#Emph}没有长进！{#Prev}这可不行！但你确实有办法改变这样的局面……"
    }
    {
      Id = "Melinoe_4948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是什么？一道……提升{#Emph}骨质密度{#Prev}的咒语？"
    }
    {
      Id = "Skelly_0585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "考虑一下吧，好吗？"
    }
    {
      Id = "Melinoe_4949"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，您教给我的“骨质增密”……这道咒语代价不菲。您确定您做好准备了吗？咒语一经施展，就再也无法撤销。"
    }
    {
      Id = "Skelly_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻人，我{#Emph}生来{#Prev}就做好了准备。换位思考一下吧，难道你不想有能力承受一顿真正的毒打么？"
    }
    {
      Id = "Melinoe_4950"
      InheritFrom = "BaseNarrative"
      DisplayName = "我更希望能完全躲过攻击，不过我也能理解您这样想的原因。您的骨骼能承受的伤害会大幅提升……只要您最享受的不是“散落一地”那部分就好。"
    }
    {
      Id = "Skelly_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "你多虑了，因为我散落一地的时候，就是没有挨打的时候，而{#Emph}挨打{#Prev}才是我享受的，这点我跟你说清楚。所以，怎么还不去施展咒语？"
    }
    {
      Id = "Melinoe_4951"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我在研究了……"
    }
    {
      Id = "Skelly_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊哈哈哈，一群蠢货！现在我彻底{#DialogLegendaryFormat}刀枪不入{#Prev}了，很快……很快，你们就将为在背后说我坏话而付出惨痛的代价！{#Emph}大仇得报，指日可待！！"
    }
    {
      Id = "Melinoe_4955"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，您这是什么意思？您就像变了个人一样！我只是施展了“骨质增密”这道咒语而已！"
    }
    {
      Id = "Skelly_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你这样做，正中我的下肋骨。因为现在，{#Emph}再也没有人{#Prev}能杀死我了！有种你就试试看，看看会发生什么！"
    }
    {
      Id = "Skelly_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}啊哈哈哈哈哈哈！"
    }
    {
      Id = "Skelly_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，希望你学到教训了，丫头！你原本以为我变得比你面对过的任何敌人都要强大，结果却发现你施展的“骨质增密”实则收效甚微……"
    }
    {
      Id = "Melinoe_4959"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，之前见到您那副，唔，醉心于力量的样子，我真的担心自己酿成了大错。我还从来没有见过您的那一面。"
    }
    {
      Id = "Skelly_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "那一面你{#Emph}再也{#Prev}见不到了！只要你吃一堑长一智，别再像这样随便施展陌生人给的咒语！"
    }
    {
      Id = "Melinoe_4960"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是您不是陌生人啊，您是我们信任的盟友！不是吗……？"
    }
    {
      Id = "Skelly_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，没错，但是……唉，就忘了这件事吧，好吗？就像以前那样打我吧，无所谓了。"
    }
    {
      Id = "Melinoe_4961"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好吧……"
    }
    {
      Id = "Melinoe_4962"
      InheritFrom = "BaseNarrative"
      DisplayName = "指挥官，我很庆幸您不是我们心怀怨恨的死敌，骗我施展了一道能唤醒您真正恐怖力量的咒语，但是……骨质增密咒语生效之后，您到底有没有感到什么变化？"
    }
    {
      Id = "Skelly_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你知道的，我确实感觉比之前硬一些了，年轻人，所以谢啦！我真的一直都知道这个咒语只会有这样的效果，不过你被我骗到了，是不是？"
    }
    {
      Id = "Melinoe_4963"
      InheritFrom = "BaseNarrative"
      DisplayName = "是吧，只是……其实我主要是意识到，如果某个夜晚您一去不返，我会很伤心。您不只是我们的指挥官……还是我的朋友。"
    }
    {
      Id = "Skelly_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，丫头，你这话是认真的？说实在的，有时候我只是{#Emph}站在这里发呆{#Prev}而已。甚至不只是{#Emph}有的时候{#Prev}！"
    }
    {
      Id = "Melinoe_4964"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我当然是认真的，指挥官。"
