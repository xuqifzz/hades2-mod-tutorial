    }
    {
      Id = "Skelly_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近的伟大成就早就传开啦，年轻人！而我也要亲自赞扬你一番：克洛诺斯那档子事，你做得好哇。"
    }
    {
      Id = "Melinoe_5002"
      InheritFrom = "BaseNarrative"
      DisplayName = "非常感谢，指挥官，不过……您还在这里干什么？我一直以为您会回到您在冥府的荣耀岗位上，可惜最后也没有等到。"
