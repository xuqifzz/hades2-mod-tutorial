    }
    {
      Id = "Melinoe_1097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "晚上好。"
    }
    {
      Id = "HecateField_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "准备好为你所做的一切付出代价吧，无耻老贼！还是说，你指望我饶你一命，就因为你一时疏忽，让我挣脱了你的束缚？"
    }
    {
      Id = "Chronos_1520"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我脑海之中……这些、这些……凭空浮现的思绪……！都是{#Emph}你的{#Prev}所作所为么，女巫！我……我对你毫无记忆，可是……你{#Emph}究竟{#Prev}是谁……？"
    }
    {
      Id = "MelinoeField_5144"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯……！老师，{#Emph}等等！{#Prev}我可以……我想我可以解释。"
    }
    {
      Id = "HecateField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄！我们这是在哪里？上一秒，我发现我们的大敌入侵了厄瑞玻斯，而下一秒，却看到他跪倒在我脚边！这怎么可能……？你做了什么……？"
    }
    {
      Id = "MelinoeField_5188"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您……您不记得……因为您不在那里，没有和我在一起。但是你，克洛诺斯！现在我是你的什么人……？"
    }
    {
      Id = "Chronos_1465"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是……我的孙女……墨利诺厄……我认识你；在此生我与你为敌，而在另一个截然不同的生命中，却并非如此……而我现在意识到……那一切不过是一场梦。一个{#Emph}幻觉！{#Prev}所以……现在，我只剩……只剩{#Emph}此世{#Prev}了么？"
    }
    {
      Id = "MelinoeField_5189"
      InheritFrom = "BaseNarrative"
      DisplayName = "你所见到的一切，都是你自己酿成的恶果！至于这另一种生命历程……你现在记得多少？"
    }
    {
      Id = "Chronos_1466"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我记得你小时候，在这座冥府，和我相处的时光。我记得那时的你，和我开开心心地玩着捉迷藏！我也记得你和扎格列欧斯经常会打起来，但是是亲昵的打闹……不是我们今夜那样的生死对决。我从未意识到，我们之间还可以有这样的过往……{#Emph}更好的{#Prev}过往。"
    }
    {
      Id = "HecateField_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "更好的过往……？{#Emph}笑话！{#Prev}那一切都从未发生！这一切都{#Emph}从未改变！{#Prev}你应该{#Emph}彻底消失{#Prev}，泰坦……！而不是在脑海中涌现虚假的记忆！"
    }
    {
      Id = "MelinoeField_5147"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那些在他脑海中涌现的记忆……我也记得。我原本有机会过上那样的生活……如果这个泰坦没有袭击冥府的话。"
    }
    {
      Id = "Chronos_1467"
      InheritFrom = "BaseNarrative"
      DisplayName = "可我确实袭击了冥府！受尽了憎恨，受尽了白眼！孙女，完成你下定决心要做的事罢！因为我再也不愿在这样的世界继续存在，这样面对你们所有人！现在的每分每秒，都是煎熬……！"
    }
    {
      Id = "HecateField_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}住口！{#Prev}墨利诺厄，快清醒过来。无论你做了什么，这个卑鄙老贼已经死到临头了，别再给他施展阴谋诡计的机会！{#Emph}消灭他！"
    }
    {
      Id = "MelinoeField_5148"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，请让我证明给您看……！克洛诺斯！爷爷。听我说：你得镇定下来。用你仍然剩余的力量，释放我们的家人！"
    }
    {
      Id = "Chronos_1468"
      InheritFrom = "BaseNarrative"
      DisplayName = "（吸气）我们的家人……？他们……对啊，他们还被我囚禁着！这么长一段时间……一直都被我囚禁着。我都做了什么……？"
    }
    {
      Id = "Hades_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的家人……！这是哪里……？这是……这是我的{#Emph}冥府？{#Prev}父亲……！这是什么意思？！"
    }
    {
      Id = "Chronos_1469"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，哈迪斯……也许王女可以为你们解释清楚。至于王后、王子，以及其他人……墨利诺厄，他们只需要听到你的声音。而我会在这里等着接受他们的审判，以及你的审判。"
    }
    {
      Id = "Selene_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "……容我稍作打断，我们已经抵达了旅途的第一站，各位。奥林匹斯就离这里不远。"
    }
    {
      Id = "Chronos_1028"
      InheritFrom = "BaseNarrative"
      DisplayName = "……感谢你驾着银色的战车载了我一程，尊敬的月神；但我是时候上路了。但愿我与哈迪斯的谈话，为我面对另外两个儿子做了一些准备……"
    }
    {
      Id = "MelinoeField_5172"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们已经把发生的事情告诉了叔父宙斯，也给出了我们的建议，但他肯定有很多问题想要你当面回答。现在他应该已经在等你了。牢记你的这一次机会，爷爷。"
    }
    {
      Id = "Chronos_1479_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "时间不会遗忘，也永远不该迟到。但愿宙斯了解到那些更坏的可能性切实存在之后，至少愿意允许我为你提供后续的帮助。"
    }
    {
      Id = "MelinoeField_5218_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是不敢想象，发生的那些事情，竟然搅乱了整个时间流……"
    }
    {
      Id = "Chronos_1528"
      InheritFrom = "BaseNarrative"
      DisplayName = "我更愿意认为，这是对自己的那一刻顿悟所致！虽然我年事已高，但似乎对自己的了解还有所欠缺啊。不过话又说回来……又有谁能完全了解自己？好了，是时候道别了。还有，孙女……谢谢你。"
    }
    {
      Id = "MelinoeField_3907"
