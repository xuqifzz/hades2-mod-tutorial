    }
    {
      Id = "Chronos_0928"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你来了这里，奥林匹斯众神要如何抵御提丰？"
    }
    {
      Id = "Chronos_0930"
      InheritFrom = "BaseSubtitle"
