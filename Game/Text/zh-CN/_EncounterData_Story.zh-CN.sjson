    }
    {
      Id = "Chronos_0629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你的顽固令我无话可说，孙女。"
    }
    {
      Id = "Chronos_0630"
      InheritFrom = "BaseSubtitle"
