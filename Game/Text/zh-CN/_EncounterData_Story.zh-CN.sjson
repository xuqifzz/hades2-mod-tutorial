    }
    {
      Id = "MelinoeField_3570"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯！老师！这是怎么回事？发生了什么？！"
    }
    {
      Id = "HecateField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄……！我们这是在哪里？上一秒，我发现我们的大敌入侵了厄瑞玻斯，而下一秒，却看到他跪倒在我脚边！这怎么可能……？你做了什么……？"
    }
    {
      Id = "MelinoeField_4975"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一切都是按计划做的！可是扎格列欧斯，我告诉过他……我{#Emph}警告{#Prev}过他！在他的时间里，他应该杀死那个泰坦，{#Emph}结束{#Prev}这一切！"
    }
    {
      Id = "Chronos_1373"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯{#Emph}放过{#Prev}了我！他把我接回了家！从那一刻起……我过上了完全不同的生活……可我现在意识到……那不过只是一场梦。一个{#Emph}幻觉！{#Prev}但是……你们还是改变了我的轨迹……！"
    }
    {
      Id = "MelinoeField_4976"
      InheritFrom = "BaseNarrative"
      DisplayName = "别把我当成傻子！难道你指望我相信，你突然想起了很久以前和扎格列欧斯的一场对话，然后现在开始后悔了么？"
    }
    {
      Id = "Chronos_1374"
      InheritFrom = "BaseNarrative"
      DisplayName = "后悔？哦，远远不止。在这里，在冥府里……你从小就喜欢玩捉迷藏。而且，你和扎格列欧斯经常会打起来……但是是相亲相爱的打闹……不是{#Emph}我们{#Prev}之间那种苦大仇深的对决。我从未意识到，我还可能有这样的过去……{#Emph}更好的{#Prev}过去。"
    }
    {
      Id = "MelinoeField_5061"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}更好的过去……？{#Prev}可是，这一切都没有发生过……什么都{#Emph}没有改变！{#Prev}你本来应该{#Emph}彻底消失……{#Prev}而不是涌现出虚假的记忆来。我在你身边快乐地长大……简直是天方夜谭！我不明白……"
    }
    {
      Id = "HecateField_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有人能完全理解自己；墨利诺厄，这个卑鄙老贼已经败了，别再给他施展那些伎俩的机会！{#Emph}了结他。"
    }
    {
      Id = "Chronos_1375"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊！完成你下定决心要做的事吧，孙女！因为我再也不愿在这样的世界继续存在，{#Emph}这样{#Prev}面对你们所有人！现在的每分每秒，都是煎熬……！"
    }
    {
