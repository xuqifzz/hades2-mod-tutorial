    }
    {
      Id = "Chronos_0924"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你这顽固不化的丫头……"
    }
    {
      Id = "Chronos_0926"
      InheritFrom = "BaseSubtitle"
      DisplayName = "祝你去塔耳塔罗斯一路顺风，孙女。"
    }
    {
      Id = "Chronos_0925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "夜夜如此，很享受么？"
    }
    {
