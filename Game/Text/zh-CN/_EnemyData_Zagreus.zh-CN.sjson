    }
    {
      Id = "MelinoeField_4242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "承让了，哥哥。"
    }
    {
      Id = "MelinoeField_4243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是不是意味着我现在是最强战士了？"
    }
    {
      Id = "MelinoeField_4992"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拿下你了，哥哥……"
    }
    {
      Id = "Zagreus_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这下有点尴尬了。墨利诺厄，你怎么来了？我正在这享受观众的喝彩呢。至福乐土的最强战士——或者战士们——被击落神坛的样子，大家一直都喜闻乐见。"
    }
    {
      Id = "MelinoeField_4237"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，你好啊，扎格列欧斯！哇，这就是至福乐土啊，不过我说不清我是怎么过来的。我只记得在卡戎的商店里捡起了一张……燃烧着的羊皮纸……"
    }
    {
      Id = "Zagreus_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，众神在上……你居然接受了一份地狱契约。附加条款都通读了一遍，然后还觉得这是个好主意？"
    }
    {
      Id = "MelinoeField_4238"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……可能没有仔细看附加条款那块，就，我看那里密密麻麻列了一大堆嘛，所以……你能不能跟我简单说一下，我这是同意了什么……？"
    }
    {
      Id = "Zagreus_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "首先是免费旅行到至福乐土……！然后嘛，就是跟当前的至福乐土最强战士打一场表演赛。不过在这种情况下，表演赛指的是生死之战。准备好了么？"
    }
    {
      Id = "Zagreus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "给暗灵观众们来一场精彩的演出吧！"
    }
    {
      Id = "MelinoeField_4239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果你坚持的话！"
    }
    {
      Id = "Zagreus_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "各位，热烈欢迎我们冥界的王女！"
    }
    {
      Id = "Zagreus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没记错的话上次三下五除二就把你拿下了，妹妹，所以见到你还敢在这么高强度的竞技环境下出现，让我稍稍有点惊讶啊。"
    }
    {
      Id = "MelinoeField_4612"
      InheritFrom = "BaseNarrative"
      DisplayName = "我已经习惯了时不时遭受挫折。你呢？你之前在时间里被困了那么久，肯定让你身体和心灵的敏锐程度大打折扣吧。"
    }
    {
      Id = "Zagreus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道，感觉就是一刹那的事！不过，我{#Emph}身体和心灵的敏锐程度{#Prev}究竟如何，不如接下来就由你来帮我{#Emph}评判{#Prev}一下。"
    }
    {
      Id = "Zagreus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我安保专家的的生涯里有那么一段时间，胜利的次数实在是多到数不过来！所以……上次真是多谢你啊，让我尝到了失败的滋味！"
    }
    {
      Id = "MelinoeField_4614"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用这么客气。和你一样，我最近也不像曾经那样经常失败了。不过，我不知道这能得出什么结论……毕竟，我们在这里，总有一个人会输？"
    }
    {
      Id = "Zagreus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗灵们不会容忍有其他情况发生的。那就拿出真本事来，让这场比赛的胜负永生难忘吧！"
    }
    {
      Id = "MelinoeField_4539"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你现在回到安保专家的岗位上了！冥界的大门仍然还开着，对你来说逃出冥界一定更容易了吧。"
    }
    {
      Id = "Zagreus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "是这样没错！尤其是最后那一段，我原本得从刻耳柏洛斯那里通过，还要面对更难对付的东西。现在，与其说是逃脱行动，不如说是巡视一番而已。"
    }
    {
      Id = "MelinoeField_4540"
      InheritFrom = "BaseNarrative"
      DisplayName = "这也能叫{#Emph}巡视一番？{#Prev}我们现在几乎是身处一场生死对决中，只为了让一群嗜血的暗灵看个尽兴。"
    }
    {
      Id = "Zagreus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "别这么说，妹妹，至福乐土的暗灵可是我们最为宝贵、最有影响力的一批居民！如果泼洒一些鲜血就能让他们满意，那我觉得是非常值得的牺牲。"
    }
    {
      Id = "Zagreus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你的那个三岔路口到底是在哪里？我不是安保专家嘛，感觉早该有人告诉我了才对。"
    }
    {
      Id = "MelinoeField_4603"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，三岔路口在厄瑞玻斯，不过单单是知道这一点并不足以让你找到它。爸爸妈妈没跟你说吗？"
    }
    {
      Id = "Zagreus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有。估计他们是担心我一去就不想回来了吧，毕竟{#Emph}你{#Prev}那么喜欢那里。要么就是他们想保护你的隐私。好吧！我们总可以在{#Emph}这里{#Emph}相见。"
    }
    {
      Id = "Zagreus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "吉加罗斯的重量我到现在还不太适应……以前我有很多武器可以选择，你知道么！不过现在看起来好像只能用别人挑剩下的了。"
    }
    {
      Id = "MelinoeField_4604"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少其中有两件武器的现任持有者我很熟悉。冥界之刃在涅墨西斯手里大显神通，而狮鹫坚炮……被厄里斯拿去了。"
    }
    {
      Id = "Zagreus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正想念那两件呢！不过我也用了她们的形态一段时间，所以也许现在这样也是应该的。它们最好是有人好好打理，起码得打理得比这根破矛要好。"
    }
    {
      Id = "MelinoeField_4605"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，你是怎么把吉加罗斯拿到手的？你从来没跟我说过。爸爸真的把它当作礼物送给你了吗？"
    }
    {
      Id = "Zagreus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "我说服了他，就像你提议的那样！{#Emph}“老爸，想让你的安保专家尽快树立威信的话，得把象征冥府权威的武器给我用用才行。”{#Prev}反正这柄矛也给他留下了很多不好的回忆。"
    }
    {
      Id = "MelinoeField_4606"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是指{#Emph}输给你{#Prev}的回忆吗……？在我小时候，赫卡忒老师把你是如何打败他的故事全都讲给我听了。"
    }
    {
      Id = "Zagreus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这个老师还真是神出鬼没啊，她那时候一定是在暗中为妈妈效力。嗯，既然你的魔法什么的都是她教的，那她知道那么多也就不意外了！"
    }
    {
      Id = "Zagreus_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我认识这柄阴森镰刀的主人——倪克斯之子，死亡的化身。某种意义上，你也认识！需要我替你把镰刀还给他么，正好这样我也就不用挨镰刀了？"
    }
    {
      Id = "MelinoeField_5175"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你慷慨的提议，不过我现在还需要它。此外，如果他需要把它要回去的话，倪克斯知道该怎么找到我。话说回来，你和塔纳托斯最近怎么样？"
    }
    {
      Id = "Zagreus_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，我们好着呢。比之前困在时间里动弹不得好多了；还有墨纪拉也是。他们都很想你！墨纪拉让我替她打个招呼，塔纳托斯则说：{#Emph}“请替我转达王女，我对她感激不尽。”"
    }
    {
      Id = "MelinoeField_4547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "替我跟他说，谢谢他的镰刀！"
    }
    {
      Id = "Zagreus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，你可以……就这么直接走上地表，一路走到奥林匹斯山，然后还不会死？我从来都走不出去多远。"
    }
    {
      Id = "MelinoeField_4607"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能那样做，全靠一道复杂的咒语，名叫“解开宿命羁绊”。没有那道咒语，我也走不了多远。你一定很渴望亲眼见到奥林匹斯山……也许……"
    }
    {
      Id = "Zagreus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，妹妹，没必要为了我违抗命运！我宁愿事情维持原样啦。也许等冥界重新开张，我会更渴望去看看奥林匹斯山的辉煌，但是……目前来说，至福乐土的辉煌就足够了！"
    }
    {
      Id = "Zagreus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得出那道光芒……你把我的求神卡带上了！所以现在事态没那么严峻了，奥林匹斯众神还像原先那样，对祝福什么的有求必应吗？"
    }
    {
      Id = "MelinoeField_4608"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我觉得我们的亲戚还挺迫切地想要确保一切维持现状。看起来有点奇怪啦，毕竟事情还是一团糟……不过也许没有之前那么糟了。"
    }
    {
      Id = "Zagreus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么说来，让事情暂时保持在熟悉的范围内，听起来也算是比较令人欣慰的变化了。嘿，我们也可以把这些凶狠的打斗当作{#Emph}我们的{#Prev}日常！"
    }
    {
      Id = "Zagreus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么回事，咒语起副作用了？上次见到你这么小一个，可能还是在我的一场梦里。"
    }
    {
      Id = "MelinoeField_4990"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是女巫喀耳刻的手笔，而且我告诉你，这是刻意而为的！等你看到我有多灵活之后，就笑不出来了。"
    }
    {
      Id = "Zagreus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来也没在笑话你，不过我觉得这里的暗灵估计会喜欢我们在开战前飙点垃圾话。那就来吧，{#Emph}小妹！"
    }
    {
      Id = "Zagreus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹妹，你，呃……听着，你现在这样，让我对我的身高有那么一点点不自信。你是怎么变这么高的，或者更重要的是，我怎么才能变这么高？"
    }
    {
      Id = "MelinoeField_4989"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你得去到一座偏远的小岛上，去拜访巫术师喀耳刻，所以对你来说可能太远了点。不过，这个效果只是暂时的啦。"
    }
    {
      Id = "Zagreus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连你的声线都变了！好吧，知道我感受到的屈辱只是暂时的，也算是一点安慰。那就让我来领教一下吧，{#Emph}小妹。"
    }
    {
      Id = "MelinoeField_5173"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府的员工恢复得怎么样，大家现在都缓过来了吗？我对他们有着很美好的记忆……童年和少年时的一幕幕，都印在我的脑海里。"
    }
    {
      Id = "Zagreus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们对你也深有同感，不过另一些时候，他们对发生的事情还感到很困惑。话说回来，谢谢你的关心，大家都缓过来了！都没有缺胳膊少腿什么的……除了杜莎，她本来就没有那些。"
    }
    {
      Id = "MelinoeField_5174"
      InheritFrom = "BaseNarrative"
      DisplayName = "听到这些我很欣慰，除了他们很困惑的那部分。从官方角度来说，你不能告诉他们发生了什么，对么？不过，请替我跟杜莎和其他人打个招呼，问候一下他们。"
    }
    {
      Id = "Zagreus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "没问题。以及，不管是不是“官方角度”，现在你的名号可怕着呢！我们那个喜欢散布流言的宫廷乐师俄耳甫斯，格外喜欢关于“黑暗的墨利诺厄”的恐怖故事。而且我没有理解错的话，马上你就要在这里展露恶魔般的身手了！"
    }
    {
      Id = "MelinoeField_4548"
      InheritFrom = "BaseNarrative"
      DisplayName = "爸爸妈妈最近怎么样？倪克斯呢？最近发生的这些事，对他们来说一定不好适应。"
    }
    {
      Id = "Zagreus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，他们挺好的。你自己见爸妈见得也不少吧，我都听说了。他们现在经常去巡视塔耳塔罗斯，也许有一部分原因就是为了多见见{#Emph}你。"
    }
    {
      Id = "MelinoeField_4549"
      InheritFrom = "BaseNarrative"
      DisplayName = "也说不定只是想去过一过二人世界呢。那你呢，你现在的工作就是在至福乐土，取悦这里的暗灵观众么？"
    }
    {
      Id = "Zagreus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我更喜欢把它看成是{#Emph}激励{#Prev}，而不是{#Emph}取悦{#Prev}，但如果你非要问得这么尖锐的话，那……没错。确保冥界的暗灵开心，是我们的第一要务！当然，还有确保他们不要跑出去。"
    }
    {
      Id = "Zagreus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说你在那个岔路口过得怎么样？在那里有朋友，以及“不止朋友”吗？跟我说说呗。"
    }
    {
      Id = "MelinoeField_4611"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，算是有吧，嗯。两种都有。那里很宁静。我可以透过树冠，看到月亮和星辰……有的时候还会下雨呢。"
    }
    {
      Id = "Zagreus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，要被雨淋啊。听说那种感觉不好受，不过也许实际上还不错！你也没有真正见过我的朋友和“不止朋友”，不过往后谁知道呢？我们有永恒的时间。除非我们谁在这里一不小心把对方杀掉。"
    }
    {
      Id = "Zagreus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近修普诺斯回来了！你根本无法想象他回来的时候有多开心。几乎是一下蹦到了我怀里，不过也有可能是被吓破了胆。"
    }
    {
      Id = "MelinoeField_4544"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不确定他有没有意识到，在他睡过去了的大部分时间里，冥府都没有在运转。我还没来得及解释，他就跑掉了。你知不知道他记不记得我们看到过的另一个过往……？"
    }
    {
      Id = "Zagreus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得他应该记得？他现在还因为这一切，有点心神不宁……也可能是因为睡过了头，现在格外精神吧。他还是很喜欢看我失败之后回到冥府的样子，也还是会把我的每次死亡记录在案。所以如果你想让他高兴一下，那么机会来了！"
    }
    {
      Id = "Zagreus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前不是说过，在你们那个秘密女巫营地里，有个叫瑟勒米乌斯的？他最近过得怎么样？"
    }
    {
      Id = "MelinoeField_4545"
      InheritFrom = "BaseNarrative"
      DisplayName = "他和以往一样信念坚定，在向我们忠诚的暗灵传道授业。此外，他还算是我的训练伙伴。不过，我突然意识到，我好像该为他保密……"
    }
    {
      Id = "Zagreus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯哼。估计他只是站在那里，满足自己被各种强力武器殴打的变态欲望吧。话说回来……我突然意识到，一定是受他影响，现在{#Emph}我{#Prev}也有点想挨打……"
    }
    {
      Id = "Storyteller_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥界王女即将再次与她率性的哥哥扎格列欧斯兵刃相向；落入时间泰坦手掌心的那段时日，有许多久经磨砺的战斗招式，都被他抛到了九霄云外。"
    }
    {
      Id = "Zagreus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，老头，是你！我正纳闷你上哪去了呢。你狠心抛弃了我，去我亲爱的妹妹那边了，是这么回事吗？"
    }
    {
      Id = "MelinoeField_4550"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你说什么？荷马一直都在我这啊。你们是怎么认识的？我错过了什么……？"
    }
    {
      Id = "Zagreus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "我都不知道怎么回答这个问题，实在是说来话长。你说他叫{#Emph}荷马{#Prev}？我早该想到他会有个这么搞笑的名字。不如我们再给他来一段值得后世流传的故事吧！"
    }
    {
      Id = "Zagreus_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "先警告你哦，妹妹，我现在感觉特别精神。你一定是对夜之圣镜做了什么。它一直都能增强我的能力，但{#Emph}这次{#Prev}增强的不止一星半点。"
    }
    {
      Id = "MelinoeField_4991"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不觉得这是圣境的力量，但可以肯定地告诉你，这和黑夜有关。你是个令人恐惧的对手，扎格列欧斯……现在的你，受到了倪克斯本尊的黑暗力量加持。"
    }
    {
      Id = "Zagreus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，所以{#Emph}还是{#Prev}你做的嘛。好吧！等哪天晚上我把父亲的惩罚契约翻出来，然后给{#Emph}你{#Prev}叠一堆强化，看看到时候{#Emph}你{#Prev}是什么滋味！"
    }
    {
      Id = "MelinoeField_4541"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这个人山人海的竞技场之外，我还会有机会再见到你吗？我们应该一起品尝仙酒，而不是为了取悦观众杀个你死我活。"
    }
    {
      Id = "Zagreus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕除了命运三女神没人知道，而且按我最近听到的说法，就连她们也未必知道！至于仙酒，你已经拿到了我的信物，所以就免了吧！"
    }
    {
      Id = "MelinoeField_4542"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}什么？{#Prev}蜜露和仙酒不是仅仅用来换取信物的！与亲人、战友和所爱之人建立纽带的重要性，你是最应该明白的啊。"
    }
    {
      Id = "Zagreus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "那当然，不过……到现在我们已经一起经历过很多了啊！而且我在你出生之前，就已经认识你了。不过好吧，你想要正式一点，那也没问题！"
    }
    {
      Id = "MelinoeField_4543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喔，好啊！那么现在，至死方休？"
    }
    {
      Id = "Zagreus_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至死方休！不过别真死了！"
    }
    {
      Id = "Zagreus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我有点开始担心这里的这些暗灵会觉得，我们其实关系非常好，而你也不是传言中的什么冥界复仇的恐怖噩兆。"
    }
    {
      Id = "MelinoeField_4616"
      InheritFrom = "BaseNarrative"
      DisplayName = "那要不要我像这样朝你怒吼，然后讨要你的项上人头，甚至你的灵魂……？"
    }
    {
      Id = "Zagreus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来不错，而且我们总可以让我们温暖的闲聊简短一些。现在，与我决一死战吧，邪魔妹妹！"
    }
    {
      Id = "Zagreus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，妹妹，让我们为至福乐土的暗灵献上一场值得铭记的对决吧！"
    }
    {
      Id = "Zagreus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "记住，如果你真的打赢了，那是因为我在让着你，好吗？"
    }
    {
      Id = "Zagreus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然很高兴见到你，但是我这次逃脱行动{#Emph}在你出现之前{#Prev}真的很顺利……"
    }
    {
      Id = "Zagreus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们有一点很像，你也喜欢不看条款就签订契约。"
    }
    {
      Id = "Zagreus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的魔法对我的矛。父亲的矛。啊你懂我意思啦。"
    }
    {
      Id = "Zagreus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "得找个机会在没这么暴力的情况下好好聊聊，不过，现在嘛……"
    }
    {
      Id = "Zagreus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "我闯过了至福乐土那么多次，总不能在这时候退缩嘛。"
    }
    {
      Id = "Zagreus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "又见面了，妹妹！该让我们手中的武器说话了。"
    }
    {
      Id = "Zagreus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，兄弟姐妹之间确实经常这样斗个不停。"
    }
    {
      Id = "Zagreus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "别对我手下留情哦，不然观众是不会买账的！"
    }
    {
      Id = "Zagreus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "你面对的不是上一任最强战士，可得好好感谢我啊。"
    }
    {
      Id = "Zagreus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "猜猜怎么着，暗灵们？看来我们有一场特别的表演赛！"
    }
    {
      Id = "Zagreus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么总是刚好在我的辉煌时刻出现？"
    }
    {
      Id = "Zagreus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿，墨利诺厄，你看起来状态真好！不过可能好景不长，抱歉……"
    }
    {
      Id = "Zagreus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "你比老爸还难打！别告诉他是我说的。"
    }
    {
      Id = "Zagreus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，妹妹，这种事我可以做一整天。还是一整夜？反正随时都行！"
    }
    {
      Id = "Zagreus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "让我看看尊贵的瑟勒米乌斯都教了你些什么。"
    }
    {
      Id = "Zagreus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "你总是我日常逃脱行动中的惊喜，妹妹！大多数时候是吧。"
    }
    {
      Id = "Zagreus_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "跟你交手一直很愉快，妹妹！尤其是我没有输的时候。"
    }
    {
      Id = "Zagreus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可不会让这些观战的暗灵失望，妹妹！"
    }
    {
      Id = "Zagreus_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "……唔！一点都没留手么，可恶……"
    }
    {
      Id = "MelinoeField_4241"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯，你还好么？我刚才不太确定我们是要表演一下，还是动真格的。"
    }
    {
      Id = "Zagreus_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那我只能当作你最后决定{#Emph}动真格{#Prev}了。总之，有人问起来的话，就说我见到自己的亲妹妹，不忍心下重手！现在，我得先撤了，我，呃，流了点血……"
    }
    {
      Id = "Zagreus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔啊……恭喜你，墨利诺厄，现在你在我眼里是{#Emph}强得要命{#Prev}这一档的了。比之前的{#Emph}还挺能打{#Prev}那一档高了不少。"
    }
    {
      Id = "MelinoeField_4551"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢了，哥哥，我确实有在努力。在这里取得胜利，通常来说会有什么奖品吗？"
    }
    {
      Id = "Zagreus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "……一般只有黑暗，不过……我确实有件东西想送给你。一直都想找机会把这种东西送给别人……"
    }
    {
      Id = "MelinoeField_4552"
      InheritFrom = "BaseSubtitle"
