    }
    {
      Id = "Nemesis_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来确实像她们能干出来的事。不过，瞎猜也没用，对吧？而且现在怎样，我们又回到谁都不能自己做主的时代了？又或者一直都不能。"
    }
    {
      Id = "Melinoe_5271"
      InheritFrom = "BaseNarrative"
