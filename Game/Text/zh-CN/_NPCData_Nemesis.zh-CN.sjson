    }
    {
      Id = "Eris_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！涅墨西斯，你怎么能这么残忍？你是我的{#Emph}亲姐姐{#Prev}耶！为什么非要跟我{#Emph}手足相残{#Prev}啦！更何况，你该不会真觉得自己能{#Emph}抓得到{#Prev}我吧？你太{#Emph}慢{#Prev}了。"
    }
    {
      Id = "Nemesis_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "走着瞧。"
    }
    {
      Id = "Eris_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}你{#Prev}走着瞧。"
    }
    {
      Id = "Nemesis_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我知道这些，小子。你的人生在所有凡人之中，是最烂的那一档。比平均短得多，也凄惨得多。所以，现在你得到了些补偿。"
    }
    {
      Id = "Icarus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，所以，女神你是说，我在死后会过上更好的生活，因为我在死前的生活，基于你的某种评级系统来说，是{#Emph}最烂的那一档{#Prev}……是这样吗？"
    }
    {
      Id = "Nemesis_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。别浪费机会，也别太贪心，你就没问题。继续做你在做的就好。"
    }
    {
      Id = "Icarus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是……我能在这里，跟你们呆在一起，实在是太幸运了。用短暂的生命换取永恒的美好，按照你的逻辑，肯定不算公平。我到底做了什么，才配得上{#Emph}这种事……？"
    }
    {
      Id = "Nemesis_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "首先，你{#Emph}没有{#Prev}问太多问题。其次，别把永恒当作理所当然。"
    }
    {
      Id = "Icarus_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会的。我发誓。"
    }
    {
      Id = "Nemesis_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡人最近一定以为，不管做什么坏事都不会遭到报应……"
    }
    {
      Id = "Nemesis_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正忙着站岗呢，你又不是看不出来。"
    }
    {
      Id = "Nemesis_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么多的恶行在凡间发生，肆无忌惮……"
    }
    {
      Id = "Nemesis_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "去吧。你还有任务等着你完成。"
    }
    {
      Id = "Nemesis_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来可以去地表，给作恶之人带去报应的……"
    }
    {
      Id = "Nemesis_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这哪也去不了，所以你就继续忙你的{#Emph}任务{#Prev}去吧。"
    }
    {
      Id = "Nemesis_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都会得到我们应得的东西，分毫不多，分毫不少。"
    }
    {
      Id = "Nemesis_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "你出去的时候，错过了一堆好事呢。"
    }
    {
      Id = "Nemesis_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "你忙你的去。我就待在这。"
    }
    {
      Id = "Nemesis_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉失陪了，我还在站岗，相信你看得出来。"
    }
    {
      Id = "Nemesis_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "唉，我到底做了什么，要遭这样的报应……"
    }
    {
      Id = "Nemesis_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么快就又振作起来了么，王女殿下？"
    }
    {
      Id = "Nemesis_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "去帮我砸几个脑袋，这是他们的报应。"
    }
    {
      Id = "Nemesis_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "真不知道你在外面到底都在做些什么。"
    }
    {
      Id = "Nemesis_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "在外面别太自私，留点给我来对付。"
    }
    {
      Id = "Nemesis_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这小身板，还是赶紧出去多练练吧，嗯？"
    }
    {
      Id = "Nemesis_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "要哭的话找你的赫卡忒老师去，她就在那边。"
    }
    {
      Id = "Nemesis_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "“三岔路口的女巫”能教你的就只有那么多。"
    }
    {
      Id = "Nemesis_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "王女殿下，记好了：因果循环，报应不爽。"
    }
    {
      Id = "Nemesis_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在上面待了好一阵子呢，是吧……"
    }
    {
      Id = "Nemesis_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "去了那么久，还以为你迷路了。"
    }
    {
      Id = "Nemesis_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "大老远回来一趟，舔舔伤口，就要再次上路了？"
    }
    {
      Id = "Nemesis_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "还以为你很久以前就会放弃了呢。"
    }
    {
      Id = "Nemesis_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "三岔路口仍然无事发生，你都问过一千次了……"
    }
    {
      Id = "Nemesis_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还真是不知疲倦啊。"
    }
    {
      Id = "Nemesis_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "毫无意义的安保工作，全在我的掌控之中。"
    }
    {
      Id = "Nemesis_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "去吧，你有要务在身，就别在这跟我聊天了。"
    }
    {
      Id = "Nemesis_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要帮我站会儿岗的话，随时欢迎。"
    }
    {
      Id = "Nemesis_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "找到克洛诺斯，杀死克洛诺斯。去吧。"
    }
    {
      Id = "Nemesis_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯必死无疑，王女。"
    }
    {
      Id = "Nemesis_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要是想放弃的话，别忘了跟赫卡忒说，我随时乐意接手。"
    }
    {
      Id = "MelinoeField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个你拿着，涅墨西斯！敬你的不惧权威。愿你的直觉永远不会辜负你。"
    }
    {
      Id = "NemesisField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真觉得现在这个时候，咱俩应该坐下好好喝一杯，扯些有的没的吗？我又不是没有更重要的事情做。"
    }
    {
      Id = "Melinoe_0685"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯？也许我们可以有个新的开始。我给你准备了份礼物……"
    }
    {
      Id = "Nemesis_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不需要你的施舍，王女殿下，也不需要你拿这些来诱惑我，不管我有没有在值班。你这样做一定是有求于我，所以这个你拿着！忙你自己的去吧。"
    }
    {
      Id = "Nemesis_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是想让我在赫卡忒那惹上麻烦，还是怎么的？我劝你在我把你的瓶子砸碎之前，赶紧把它拿走，连你的小身板一起在我眼前消失。"
    }
    {
      Id = "Melinoe_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是想让你惹上麻烦，涅，我只是……呃。要不还是……算了吧。"
    }
    {
      Id = "Nemesis_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，给我的？我看你是找不到别的办法试你的毒药了吧。你们这些女巫的心思，没你想得那么隐秘。"
    }
    {
      Id = "Melinoe_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，这样说话的人往往是被女巫毒得最惨的。"
    }
    {
      Id = "Nemesis_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃。"
    }
    {
      Id = "Nemesis_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，怎么又是这一出。听着，上一次的事我已经原谅你了。但这不意味着我想让你再给我弄来更多这种东西。我不喜欢欠任何人人情。"
    }
    {
      Id = "Melinoe_2097"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就收下好好享受吧，涅。而且，我听说你巴不得想要再尝尝我们女巫的毒药呢。没见过比你更喜欢那东西的人了。"
    }
    {
      Id = "Nemesis_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到底为什么老是这样做？你赢了，好么？你打败了我。我输在了起跑线上。我现在最不需要的就是你的同情。"
    }
    {
      Id = "Melinoe_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯……我真的不知道我要怎么做才好。现在外面全是我们的敌人。我们真的还需要更多敌人吗？"
    }
    {
      Id = "Nemesis_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你不是我的敌人，墨利诺厄。我只是……别管我了，你走吧。"
    }
    {
      Id = "Melinoe_2250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，涅……"
    }
    {
      Id = "Nemesis_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "建议你早点放弃蜜露这码事。好东西太多，就会遭报应。到现在，你也该知道我的态度了。"
    }
    {
      Id = "Melinoe_4430"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你大公无私，不能允许自己拥有比别人更多的好东西。但是，如果真发生了那种事，你会怎么做？难道你要惩罚自己吗？"
    }
    {
      Id = "Nemesis_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。别装得你不会这么做似的。赫卡忒有一点好我得承认，那就是她对纪律很严格。有的时候，我们就是需要对自己严格一点。"
    }
    {
      Id = "Melinoe_4431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有的时候，我们也需要对自己好一点啊。"
    }
    {
      Id = "Melinoe_4432"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道任何事物在你眼中都过犹不及，不过我想多来一瓶仙酒，应该也不会让天平为之倾倒吧，你说呢，涅？"
    }
    {
      Id = "Nemesis_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "说不定还真会。我不打算去小酒馆验证，所以你还是把它收回去吧。现在实在不是放纵的时候。"
    }
    {
      Id = "Melinoe_4433"
      InheritFrom = "BaseNarrative"
      DisplayName = "不如你先拿着，等到你觉得应当犒劳自己的时候再享用。只要你没有在放纵自己，应该就不用担心了，对吧？"
    }
    {
      Id = "Nemesis_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要浪费这样的东西，随你。但我只会把它囤起来，估计再也不会重见天日，虽然这地方本来也没有什么“天日”可言。总之，你没意见就好。"
    }
    {
      Id = "Melinoe_4434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我没意见。"
    }
    {
      Id = "Melinoe_4435"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，我又给你带了件东西，供你“囤起来再也不见天日”。毕竟，也许什么时候它就是你“应得”的了，谁知道呢，对吧。"
    }
    {
      Id = "Nemesis_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你{#Prev}不知道而已。是什么让你觉得我配得上这种东西？我最近又没有什么拿得出手的功绩。"
    }
    {
      Id = "Melinoe_4436"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我不是负责裁决这种事情的人，但我{#Emph}真的{#Prev}觉得你配得上。你对自己一定比对其他人都要严格。要是你偶尔能看到你在我眼中的样子，那就好了。"
    }
    {
      Id = "Nemesis_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道你这话是什么意思。我们目标一致，而且都对自己很严格。那又如何。总之，这个我也囤起来了。"
    }
    {
      Id = "Melinoe_4437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "应该的。"
    }
    {
      Id = "Nemesis_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "仙馔密酒。听好了，我“囤起来不见天日”的东西已经要堆满了。漫到外面可不好。"
    }
    {
      Id = "Melinoe_4438"
      InheritFrom = "BaseNarrative"
      DisplayName = "你随时可以邀请我一起去小酒馆，稍微消耗一下你的囤货。为什么要永远这么囤着？除了你之前说的那些理由。"
    }
    {
      Id = "Nemesis_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "你再这样，我就哪也不和你去了。而且我不喜欢你不把“过犹不及”这点当回事。这是我的专业领域。不是你的。"
    }
    {
      Id = "Melinoe_4439"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，涅墨西斯，冒犯到你不是我的本意；很难相信我会这样说，更何况还是发自内心的，因为我们以前总是针锋相对、口无遮拦。"
    }
    {
      Id = "Nemesis_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "那时候事情确实简单，不是么。但现在我们被困在这种莫名其妙的循环当中，直到我们打破循环为止，而我现在就要那么做。永远。不许。再送。仙酒。"
    }
    {
      Id = "Melinoe_4440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "永远吗？那浴盐呢？"
    }
    {
      Id = "Nemesis_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（笑）"
    }
    {
      Id = "Melinoe_3354"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我知道你有很大的概率会拒绝，但是……我这里有一瓶{#Emph}格外特别{#Prev}的毒药，所以我就想，也许可以和你在小酒馆分享一下，就咱俩，怎么样？"
    }
    {
      Id = "Nemesis_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "瞧你那副毕恭毕敬的样子！说起来，一人一半的话，大概就没那么容易醉了……呃，你猜怎么着？我同意了，就依你吧。"
    }
    {
      Id = "Nemesis_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "……承认吧：那次你被我打得落花流水。应该是我第一次以为自己有机会，能让赫卡忒青睐我的时候。那时我想，只要再多像那样打败你几次就好了。"
    }
    {
      Id = "Melinoe_2099"
      InheritFrom = "BaseNarrative"
      DisplayName = "你强得像个怪物，涅！从那以后，我一想到要和你对练就发怵。但是，要想取得进步，最好的办法就是和更强的对手切磋。"
    }
    {
      Id = "Nemesis_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这就是我最近遇到瓶颈的原因。我们不再像以前那样对练了。一想就烦。"
    }
    {
      Id = "Melinoe_2100"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等……难道你站岗的时候，每天都在想我们以前对练的场景？我是应该感到荣幸，还是应该害怕？"
    }
    {
      Id = "Nemesis_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "得了吧，赶紧把你那半瓶“毒药”喝掉！我没工夫一整晚坐在这里拍你的马屁。说实话，我们最烂的特质全被凡人继承去了。"
    }
    {
      Id = "Melinoe_2101"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是在说笑啦。不过，也许我比我自己所想象得要更加自我中心一些。我{#Emph}确实{#Prev}从母亲身上继承到了些凡人的血脉……"
    }
    {
      Id = "Nemesis_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，这的确让你与众不同。好了，我得回去了。要是赫卡忒发现咱俩交好，只怕咱俩都会吃不了兜着走。"
    }
    {
      Id = "Nemesis_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我感觉这“毒药”要发作了。你最好赶紧走人，免得看到我倒在地上不省人事。"
    }
    {
      Id = "Melinoe_2102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会为你保密的。"
    }
    {
      Id = "Melinoe_3104"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，我们最近这副紧张的架势已经持续一段时间了，所以我想问你要不要放松一下。一起去一趟温泉。"
    }
    {
      Id = "Nemesis_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯。说起来，确实该洗个澡了。我说的是{#Emph}你{#Prev}。不过，我去洗一洗也不是不行，所以……就当我答应了吧。"
    }
    {
      Id = "Melinoe_3105"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上一次脱掉这身盔甲是什么时候了？"
    }
    {
      Id = "Nemesis_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "有一阵子了。没什么脱盔甲的理由。你也看到了，得解开束带，然后再解皮带，快麻烦死了。没了盔甲感觉很奇怪，就好像我……我也说不清。"
    }
    {
      Id = "Melinoe_3106"
      InheritFrom = "BaseNarrative"
      DisplayName = "……卸下了担子？或者，至少舒服了一些？"
    }
    {
      Id = "Nemesis_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵。有的时候放放松大概也不错。但放松是一回事，懈怠又是另一回事了。"
    }
    {
      Id = "Melinoe_3107"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没觉得我们现在有懈怠的风险，涅。"
    }
    {
      Id = "Nemesis_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "这风险比你想得大得多。我们在这懒洋洋地泡着澡，外面发生什么都一概不知……"
    }
    {
      Id = "Melinoe_3108"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们这不是“懒洋洋地泡澡”。我们这是在放松筋骨，养精蓄锐，这样才能更好地面对外面发生的事情。"
    }
    {
      Id = "Nemesis_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，该开工了。不过，这身盔甲确实感觉比之前轻了……"
    }
    {
      Id = "Melinoe_3109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重，涅。"
    }
    {
      Id = "Melinoe_3110"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，涅，你有空再去泡一次温泉么？卸下担子，让头脑清醒一下……"
    }
    {
      Id = "Nemesis_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃。肩膀正好有点硬，说不定有帮助。我不喜欢脱掉盔甲的感觉，但没办法，有得就有失。"
    }
    {
      Id = "Nemesis_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "还记得你第一次打赢我的时候吗？应该说是{#Emph}对练{#Prev}，不过无所谓了。一击正中我的后颈。被你利用到了我们的身高差。出乎我的意料。"
    }
    {
      Id = "Melinoe_3111"
      InheritFrom = "BaseNarrative"
      DisplayName = "我输给你太多次了，以至于到后面我意识到，我可以诱使你轻敌。就算是你这样的人，也容易败在这种招数上。"
    }
    {
      Id = "Nemesis_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "结果你没想错。当时我{#Emph}气坏了{#Prev}。发誓说我再也不会轻敌。然后却又马上对自己说，你永远不会在任务上赢过我。{#Emph}我们的{#Prev}任务。"
    }
    {
      Id = "Melinoe_3112"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也只是骄傲了点而已。你没打算彻底浇灭你的傲气，对吧？只要控制住，不要过火了就好。况且，我们所追求的目标是一致的，并不冲突呀。"
    }
    {
      Id = "Nemesis_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "是这样没错。但我只能逼自己到一定程度。看到你越变越强，越来越接近目标……让我能把自己逼得更狠，我正需要这样。"
    }
    {
      Id = "Melinoe_3113"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到你是这么想的。我还一直以为，我的好胜心都是从{#Emph}你{#Prev}那里学来的呢。总之……如果你有什么别的需要，一定要跟我说哦。就比如，需要帮忙穿上那身盔甲的话。"
    }
    {
      Id = "Nemesis_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，下次脱盔甲也可以叫你帮忙。不过，我也不能太适应这种事情。"
    }
    {
      Id = "Nemesis_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，坐够了。是时候站一站了，这样才公平。"
    }
    {
      Id = "Melinoe_3115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我们走吧。"
    }
    {
      Id = "Melinoe_4441"
      InheritFrom = "BaseNarrative"
      DisplayName = "你从来没有拒绝过浴盐，涅墨西斯。所以你意下如何？只要你觉得我们有赢得稍事休息的权利。"
    }
    {
      Id = "Nemesis_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "有么。不过我的肌肉确实很僵硬，有点碍事了。所以，有何不可。"
    }
    {
      Id = "Nemesis_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "很难相信我居然和你坐在这里。很长一段时间里，我看都不想看你一眼。想把你像根树枝一样折成两半。现在我却会叫你帮我解开盔甲的束带。"
    }
    {
      Id = "Melinoe_4442"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都有改变的能力，不是么？你一定深信这一点，不然的话你降下的神罚不就没有意义了么？总不能是为了惩罚而惩罚吧。"
    }
    {
      Id = "Nemesis_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "惩罚本身就是一半的意义。不过你说得对。吸取教训的能力很重要。犯错就要改过自新；看到他人犯错则要引以为戒。不过，我不觉得我有什么改变；变了的人是你。"
    }
    {
      Id = "Melinoe_4443"
      InheritFrom = "BaseNarrative"
      DisplayName = "是我么？我还是一心扑在我的责任上啊。就算现在，我也想着快点泡完，好回去做我该做的事……而不是在这里好好享受与你相处的时光。"
    }
    {
      Id = "Nemesis_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我们会来这里，就是因为你有胆量邀请我。不过，好吧。也许你并没有变那么多。也许只是我出于某种原因，比之前更欣赏你了。"
    }
    {
      Id = "Melinoe_4444"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也深有同感。不过，自从一起训练那时起，我就一直很仰慕你。能像这样与你相处，以及能和你在战场上并肩杀敌，都让我非常开心。"
    }
    {
      Id = "Nemesis_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也一直想，只不过以前的我觉得没有那样的条件而已。好了，话说够了。不帮我揉揉背，放松放松肌肉么？"
    }
    {
      Id = "Nemesis_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "……反正比之前舒服，这点我得承认。不过，别以为在外面我会让着你。这样只是两不相欠而已。"
    }
    {
      Id = "Melinoe_4446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是自然。"
    }
    {
      Id = "Melinoe_0683"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，那个，我大概知道你会怎么回应，但我还是想问：想不想去泡泡温泉？一起去放松一下？"
    }
    {
      Id = "Nemesis_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，呃……感谢你的邀请，但我现在在站岗，估计要站到时间把我们所有人都带走为止。而且这身盔甲脱起来麻烦得很……"
    }
    {
      Id = "Melinoe_0684"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，想跟我一起去河边待会儿吗？宣泄一下压力，或者……也许我可以把你推到河里之类的？"
    }
    {
      Id = "Nemesis_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以上到地表去找十恶不赦的恶人算总账，你却要让我找几条可怜的鱼做目标？呃，算了吧。"
    }
    {
      Id = "Melinoe_3487"
      InheritFrom = "BaseNarrative"
      DisplayName = "我好像在钓鱼栈桥看到了些动静。恐怕我们得去彻头彻尾调查一番了，对不对？"
    }
    {
      Id = "Nemesis_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "不去的话，我也只能在这站岗站到地老天荒，是吧？行吧，我就给你个面子。鱼会不会给你面子，就不好说了。"
    }
    {
      Id = "Nemesis_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "一出生就是一条鱼。在恸哭之河里翻腾了一辈子，只为了被{#Emph}你{#Prev}钓上来。它们到底是做了什么，才会遭到这样的报应？"
    }
    {
      Id = "Melinoe_3237"
      InheritFrom = "BaseNarrative"
      DisplayName = "这种事你不应该最清楚吗？也许是命运三女神的意志决定我们生下来是什么。然后你根据我们做出的选择，确保每个人都得到自己应得的东西。"
    }
    {
      Id = "Nemesis_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是每个人都有着平等的出身，这种事就会简单许多。但我家里除了我之外，没有人认为生活应该是公平的。"
    }
    {
      Id = "Melinoe_3238"
      InheritFrom = "BaseNarrative"
      DisplayName = "世界上有各种各样的生物，有的甚至像这些鱼一样，一辈子住在恸哭之河里，这样的生活怎么可能公平呢？"
    }
    {
      Id = "Nemesis_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们得建立一些体制，才能更好地决定谁来定夺凡人如何出生、如何投胎转世。改天再说这个吧。我好像在那边看到了动静。"
    }
    {
      Id = "Nemesis_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们给了它们公平竞争的机会，不是么。真是旗鼓相当的智力对决。"
    }
    {
      Id = "Melinoe_2308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "涅墨西斯一定是先出发了……"
    }
    {
