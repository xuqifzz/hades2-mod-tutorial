    {
      Id = "Melinoe_5273"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算任务完成了，你也仍然要专注于冥界么？地表上肯定也有很多新鲜事。"
    }
    {
      Id = "Nemesis_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒说，你现在要做的事，需要和之前有{#Emph}完全相同{#Prev}的条件。不管你在做什么，我可不想给你搞砸了。"
