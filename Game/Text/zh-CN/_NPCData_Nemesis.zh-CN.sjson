    {
      Id = "Eris_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "……嗯哼？那你又觉得你能做什么呢，嗯，涅涅？在你们这个小小的{#Emph}三岔路口{#Prev}里，你可不能对我大打出手哦。"
    }
    {
      Id = "Nemesis_0242"
      InheritFrom = "BaseNarrative"
