    }
    {
      Id = "Hecate_0870"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点显而易见。有很多需要报应的地方，地上和地下都一样，毕竟变革已然来临……而你将秉承黑夜的意志带去报应，无论何时，无论何地，由你自行定夺。"
    }
    {
      Id = "Nemesis_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "带去报应，无论何时何地，由我自行定夺……你的意思是，我可以继续了？我做了什么，才配得上你这样对我？"
    }
    {
      Id = "Hecate_0871"
      InheritFrom = "BaseNarrative"
