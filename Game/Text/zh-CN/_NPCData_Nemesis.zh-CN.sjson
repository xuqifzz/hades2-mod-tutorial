      DisplayName = "走了。"
    }
    {
      Id = "Nemesis_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我走了。"
    }
    {
      Id = "Nemesis_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "晚安。"
    }
    {
      Id = "Nemesis_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该走了。"
    }
    {
      Id = "Nemesis_0157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该上路了。"
    }
    {
      Id = "Nemesis_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "够了。"
    }
    {
      Id = "Nemesis_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见。"
    }
    {
      Id = "Nemesis_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回头见。"
    }
    {
      Id = "Nemesis_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别搞砸了。"
    }
    {
      Id = "Nemesis_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你继续。"
    }
    {
      Id = "Nemesis_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "走吧。"
    }
    {
      Id = "Melinoe_2253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她就这么……？"
    }
    {
      Id = "MelinoeField_1480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她踏入了混沌之门……"
    }
    {
      Id = "MelinoeField_1481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她进去了……"
    }
    {
      Id = "MelinoeField_1482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她去见卡俄斯了？"
    }
    {
      Id = "Melinoe_2245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就这么走了。"
    }
    {
      Id = "Melinoe_2251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她走了。"
    }
    {
      Id = "Melinoe_2252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好吧……！"
    }
    {
      Id = "Melinoe_2246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "晚安……"
    }
    {
      Id = "Melinoe_2247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见……"
    }
    {
      Id = "Melinoe_2248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也一样。"
    }
    {
      Id = "Melinoe_2249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "照顾好自己。"
    }
    {
      Id = "NemesisField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "好事全让你错过了。但至少你这次不用脏了自己的手。"
    }
    {
      Id = "Melinoe_2140"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，你在这里干什么？三岔路口现在是谁在站岗？"
    }
    {
      Id = "NemesisField_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "爱谁谁，我休假呢。敢跟赫卡忒说你见过我，你就会后悔的。另外，{#Emph}这里很欢迎你，而且很安全{#Prev}，毕竟我刚为你开了条路出来。"
    }
    {
      Id = "Melinoe_2141"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不需要你的帮助，你只要尽到自己被分配的责任就行。"
    }
    {
      Id = "NemesisField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？我看你需要能得到的{#Emph}一切帮助{#Prev}。这个给你，算你没白跑这一趟，收下就赶紧走吧。"
    }
    {
      Id = "NemesisField_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你来迟了。这里的事我已经解决了，不过我相信后面还有更多麻烦等着你。"
    }
    {
      Id = "MelinoeField_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你执意要亲自对付克洛诺斯的话，至少我们可以合作一下吧？"
    }
    {
      Id = "NemesisField_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不能被看到和你一起行动，而且也不需要你的帮助。但我明白你需要我帮忙，所以这个你拿去，当作是封口费。明白了么？"
    }
    {
      Id = "NemesisField_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你需要能得到的一切帮助，所以这个拿去！反正我也不需要。"
    }
    {
      Id = "NemesisField_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "这边净是些没用的垃圾。拿去吧，清理垃圾的任务就交给{#Emph}你{#Prev}了。"
    }
    {
      Id = "NemesisField_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个我完全不需要，但是你看起来很需要的样子。"
    }
    {
      Id = "NemesisField_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "假装你没看到我。假装我没让你过得更轻松。"
    }
    {
      Id = "NemesisField_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，敌人都被你杀完了耶，你真厉害。这是你的丰厚奖励。"
    }
    {
      Id = "NemesisField_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "下次你和赫卡忒聊天的时候，最好别给我提起这件事。"
    }
    {
      Id = "NemesisField_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看咱们谁先到吧。来，这个算我让你的。"
    }
    {
      Id = "NemesisField_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "看你身上没带多少东西，这个你拿去，就当帮我减负了。"
    }
    {
      Id = "NemesisField_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正打算把这个丢掉，你就出现了……"
    }
    {
      Id = "NemesisField_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没可能比我更先到的。我甚至可以让你一手。"
    }
    {
      Id = "NemesisField_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "想见的不是我？我只是在这稍微停一下，确认一下方位。本来一片宁静祥和，没想到突然冒出来个你。"
    }
    {
      Id = "MelinoeField_1972"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在这附近有见到一个温柔的宁芙吗？她平时经常呆在这座桥上。"
    }
    {
      Id = "NemesisField_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定是被我吓跑了。比起找什么宁芙，我还有更重要的事。总之，你快走吧。再这样友善地闲聊，招惹到这里游荡的暗灵就不好了。"
    }
    {
      Id = "NemesisField_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥界以前一直都流淌着黄金。但克洛诺斯却把它们都铸成了小小的金币！现在流通得到处都是了。"
    }
    {
      Id = "MelinoeField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡戎大人会处理好这件事的，很快就会。我会把找到的金币都交给他，换取他的货物。"
    }
    {
      Id = "NemesisField_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看这件事我来做也一样，如果你想来做笔交易的话。别担心，凡是你给我的钱，我都会在卡戎那花掉的。"
    }
    {
      Id = "NemesisField_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，看看是谁来了！你该不会也在这片原野上迷路了吧？要是我有地图的话，我倒想卖给你一份，但我看你也付不起钱，所以我大概会自己借助地图离开这里吧。"
    }
    {
      Id = "MelinoeField_1970"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕地图也派不上什么用场，因为这里的道路似乎每夜都在变化。不过我至少有办法借助这里散布的金树辨别方向。你呢？"
    }
    {
      Id = "NemesisField_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "金树。我还以为它们除了增添些伤感的氛围，再没别的用处了。也许赫卡忒在那口炼金釜旁边絮絮叨叨个没完的时候，我应该听得再专心点。"
    }
    {
      Id = "NemesisField_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个换你点金币如何。总不能让卡戎饿死，你懂的。"
    }
    {
      Id = "NemesisField_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正需要点金币，但是无缘无故从你手上抢不公平，所以来场交易如何。"
    }
    {
      Id = "NemesisField_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有金币的话，咱们来场交易如何。"
    }
    {
      Id = "NemesisField_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里有你能用得上的东西，不过别想白占我便宜。"
    }
    {
      Id = "NemesisField_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "这东西能帮你走得更远，但价格不便宜就是了。"
    }
    {
      Id = "NemesisField_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要成为最厉害的人，总得付出些代价。"
    }
    {
      Id = "NemesisField_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有笔交易，不过你得一手交钱，一手交货。"
    }
    {
      Id = "NemesisField_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "身为王女，你总该有点零花钱，对不对？"
    }
    {
      Id = "NemesisField_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这一路捡了多少金币？可以在我这换点有用的。"
    }
    {
      Id = "NemesisField_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "我直接把你抢个精光也没问题，但那样就太不公平了。"
    }
    {
      Id = "NemesisField_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些杂碎一点都不能打。以前咱俩对练的时候……几乎从没有机会给你结结实实来上一下。每次都会被你闪开。"
    }
    {
      Id = "MelinoeField_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也没办法呀！那时候的我，被你“结结实实来上一下”早就躺地上了。但我有勤加练习！"
    }
    {
      Id = "NemesisField_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你是比以前壮实了。不过壮了多少呢？要不现在让我来上一下试试，如果你能承受得住，我找到的这个好东西就归你了。成交么？"
    }
    {
      Id = "NemesisField_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是在跟着我吗？平常可不会在一晚上见你这么多次。走你自己的路去。"
    }
    {
      Id = "MelinoeField_1971"
      InheritFrom = "BaseNarrative"
      DisplayName = "走我{#Emph}自己{#Prev}的路？你是说，我现在走的这条，由老师和大战术家精心规划，旨在最大化我成功的可能性的这条道路，不是{#Emph}我{#Prev}该走的路？"
    }
    {
      Id = "NemesisField_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是说别老让我撞见。不过，嘴这么欠的话，先让我狠狠给你来上一下如何？"
    }
    {
      Id = "NemesisField_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，有时候总想把谁揍一顿，你一定理解这种感觉。你愿意的话，我不会亏待你的……"
    }
    {
      Id = "NemesisField_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的血液还在沸腾……我得找点什么东西出出气。只要让我结结实实来上一下就够了。"
    }
    {
      Id = "NemesisField_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "为了得到这个东西我流了点血。你想要的话，也得流点血。"
    }
    {
      Id = "NemesisField_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "你很强壮，挨上一下准没问题，对吧。对咱们两个都划得来……"
    }
    {
      Id = "NemesisField_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "你来这里的路上已经受了不少次打击了……"
    }
    {
      Id = "NemesisField_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来这里的路上狠狠挨了一下，你要不要也尝尝是什么滋味。"
    }
    {
      Id = "NemesisField_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "想从我手上拿东西，你就要以鲜血作为代价。"
    }
    {
      Id = "NemesisField_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要的话，最好准备好流点血。"
    }
    {
      Id = "NemesisField_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "依我看，恐怕你连我的一次攻击都吃不消吧。"
    }
    {
      Id = "NemesisField_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在想，要是你连我的一击都承受不住，那你就一点胜算都没有。"
    }
    {
      Id = "NemesisField_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候阿尔忒弥斯会帮我一把，但{#Emph}你{#Prev}呢？几乎整座奥林匹斯山都在帮你，但{#Emph}就算这样{#Prev}还是不够。他们可真是好帮手啊。"
    }
    {
      Id = "MelinoeField_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要说众神的坏话，不如对着他们说。所以你想让我怎么做？"
    }
    {
      Id = "NemesisField_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想尝一尝那种力量的滋味。来吧，我会跟你换的……"
    }
    {
      Id = "NemesisField_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "你亲戚发的那些祝福……你肯定有用不上的吧？"
    }
    {
      Id = "NemesisField_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里有你需要的东西，但你得拿奥林匹斯的虚假力量作为交换。"
    }
    {
      Id = "NemesisField_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "把众神借你的力量分我一些，我就把我的力量也分一些给你。"
    }
    {
      Id = "NemesisField_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也不用什么都靠奥林匹斯山吧。"
    }
    {
      Id = "NemesisField_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要我的东西，你就得放弃一些东西作为代价。"
    }
    {
      Id = "NemesisField_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有奥林匹斯众神的帮助，你也不该有，这样才公平。"
    }
    {
      Id = "NemesisField_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "山上的那些神可不会给我他们的帮助，但你会不会呢？"
    }
    {
      Id = "NemesisField_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "你放弃一个小小祝福的话，奥林匹斯众神肯定不会在意的，对吧？"
    }
    {
      Id = "NemesisField_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "要让你放弃一些奥林匹斯的力量，需要开出怎样的价码？"
    }
    {
      Id = "NemesisField_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "你总是在依靠亲戚们的帮助。不如你放弃一些试试。"
    }
    {
      Id = "NemesisField_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就到了，这里的烂摊子都被我收拾干净了。这让你很不爽，我知道。别憋着……让我看看你到底有多强壮。"
    }
    {
      Id = "MelinoeField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不想和你打架，涅墨西斯。我现在甚至都不想和你说话。"
    }
    {
      Id = "NemesisField_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "没说要跟你打一架。我是让你{#Emph}揍我{#Prev}。看看你打不打得动我。不会亏待你的。"
    }
    {
      Id = "NemesisField_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "瞧你满腔怒火的样子。释放出来吧。能打疼我，我就给你些回报。"
    }
    {
      Id = "NemesisField_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些杂碎都打不到我。对他们不公平。不如你替他们揍我一顿。"
    }
    {
      Id = "NemesisField_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看你这副装横的模样。来啊，使出浑身力气揍一揍我试试。免费的。"
    }
    {
      Id = "NemesisField_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "让我看看你到底有多强。揍我一顿，不许留手。"
    }
    {
      Id = "NemesisField_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "看得出你很生气。那就发泄出来吧，让我看看你有多少能耐。"
    }
    {
      Id = "NemesisField_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看你，一副要吃人的样子。让我见识一下你到底有几斤几两。"
    }
    {
      Id = "NemesisField_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "胜者为王，败者为寇。所以来让我见识一下你的本事吧。"
    }
    {
      Id = "NemesisField_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些杂碎碰都碰不到我一下。但你总比他们强，对吧？"
    }
    {
      Id = "NemesisField_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是觉得你压根不够格，不过欢迎你来证明给我看。"
    }
    {
      Id = "NemesisField_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你变强了，但永远都达不到我的水平。来啊，试试看。"
    }
    {
      Id = "NemesisField_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "你敢对赫卡忒说一个字，我就剁了你，懂吗？那就快走吧，这里交给我来处理。"
    }
    {
      Id = "MelinoeField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是我的任务，不是你的。而且你这样玩忽职守让我很失望。你非得证明你比我更强吗？"
    }
    {
      Id = "NemesisField_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁知道呢，是又怎么样。不如这么着：你身上有金币，对吧？那些杂碎马上就要涌过来了。谁杀得更多，谁就把另一个人的金币拿走。如何？"
    }
    {
      Id = "MelinoeField_0015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "非得要赌点什么你才满意吗？"
    }
    {
      Id = "NemesisField_0007"
      InheritFrom = "BaseSubtitle"
      DisplayName = "废话少说，专心面对敌人，说不定你还有几分胜算！"
    }
    {
      Id = "MelinoeField_4082"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，准备再次累得大汗淋漓了嘛，涅？"
    }
    {
      Id = "NemesisField_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "再这么说话，结束之后我要的就不只是金币了。来吧。"
    }
    {
      Id = "NemesisField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "你做不到的话，我就去亲自解决掉克洛诺斯。不过一码事归一码事。"
    }
    {
      Id = "NemesisField_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "等这里的事解决之后，我们中有一个会更富有，另一个则会更贫穷。"
    }
    {
      Id = "NemesisField_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么这么快就到了？哼，无所谓。还是老规矩，来赌一把吧。"
    }
    {
      Id = "NemesisField_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里湿漉漉的，歌声也烦得我够呛，但这件事非做不可。"
    }
    {
      Id = "NemesisField_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正准备杀出条血路，所以不如一起上吧。"
    }
    {
      Id = "NemesisField_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神一定是在眷顾你，因为我正准备帮你把脏活累活全干完。"
    }
    {
      Id = "NemesisField_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些杂碎应该够我们两个对付的了。做好准备。"
    }
    {
      Id = "NemesisField_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不用你帮忙，不过不如让我们来找点乐子……"
    }
    {
      Id = "NemesisField_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些都归我了，而且等我杀完，你的钱也要归我。"
    }
    {
      Id = "NemesisField_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看这次命运三女神会更青睐你还是我。"
    }
    {
      Id = "NemesisField_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要是没溜出来的话，恐怕还在三岔路口的岗位上发呆呢。"
    }
    {
      Id = "NemesisField_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "赌上的可是你的金币，所以我建议你拼命一点。"
    }
    {
      Id = "NemesisField_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "正好缺点钱花。打完之后你的钱就归我了，怎么样。"
    }
    {
      Id = "NemesisField_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "想想前面有卡戎的商店等着你，所以拼尽全力吧。"
    }
    {
      Id = "NemesisField_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正准备一个人解决这些，你就出现了。好吧，那就分你一半。"
    }
    {
      Id = "NemesisField_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "一人一半吧，差不多。我的意思是，你少杀几个，我就多拿点钱。"
    }
    {
      Id = "NemesisField_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "打得不好的话，我解决他们之后，你的金币就归我了。"
    }
    {
      Id = "NemesisField_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有冥界之刃在手，用不着你的帮助，谢谢。"
    }
    {
      Id = "NemesisField_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要多拿点钱，那就试试能不能赢过我。做好准备，他们来了。"
    }
    {
      Id = "NemesisField_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "来场友谊赛如何，王女殿下？来吧，比个高下。"
    }
    {
      Id = "NemesisField_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说克洛诺斯喜欢金币，所以他是不会介意我们在这里比一比的。"
    }
    {
      Id = "NemesisField_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以{#Emph}真正的行动{#Prev}就在这里展开，是么。让我们看看泰坦大军的精锐到底有几斤几两。"
    }
    {
      Id = "NemesisField_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你居然没有用那招溜之大吉，真是意外。"
    }
    {
      Id = "MelinoeField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "你根本就不了解我。你擅自离开岗位这么远，还违抗了赫卡忒老师亲口对你下达的命令，到底是在想什么？"
    }
    {
      Id = "NemesisField_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在{#Emph}想{#Prev}的是，也许你没有拿下那个泰坦的本事。我有。少废话了，快走吧。"
    }
    {
      Id = "NemesisField_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "第一次在这里撞见你的时候，我还以为你一定会向赫卡忒打小报告。但你没有。"
    }
    {
      Id = "MelinoeField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "算你走运，赫卡忒没要求我给她汇报情况。至少，你这样也能为我吸引些敌人的注意力。"
    }
    {
      Id = "NemesisField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "乐意之至。不管你怎么做，我都不会让步，但现在这样……更方便我专注。专注于手头的任务。"
    }
    {
      Id = "NemesisField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，你把我送给你的邪眼带上了，真是令人感动。让招惹过你的敌人尝尝你的厉害吧。"
    }
    {
      Id = "MelinoeField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "相信我们的敌人很快就会遭到报应了。不过，这只眼睛看起来就像是活的一样。你该不会在用它偷窥我吧？"
    }
    {
      Id = "NemesisField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "得了吧。我巴不得少看你两眼。现在快走吧，省得一会儿邪眼对我也生效了。"
    }
    {
      Id = "MelinoeField_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，前面老师把守的那里，你是怎么过去的？她总会在厄瑞玻斯的边界等我。"
    }
    {
      Id = "NemesisField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "你自己已经给出了答案。她等的人是{#Emph}你{#Prev}，不是我。我早就过了需要训练和测试的阶段了。而且我也很擅长躲避她。"
    }
    {
      Id = "NemesisField_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "刚刚碰上阿尔忒弥斯了。她和我加在一起，今夜得帮你干掉一半敌人了吧。"
    }
    {
      Id = "MelinoeField_3632"
      InheritFrom = "BaseNarrative"
      DisplayName = "但这一定是我应得的，对吧？而且别担心，前面应该还有很多敌人需要我自己解决。猎神今夜过得怎么样？"
    }
    {
      Id = "NemesisField_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来还不错，我们好好聊了聊。本来我还以为她有意在避开我，不过想不到她有什么理由那样做。"
    }
    {
      Id = "MelinoeField_3633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也想不到呢。"
    }
    {
      Id = "NemesisField_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "在战场上和你一起畅快厮杀，比起在三岔路口的酒馆里小口喝酒惬意多了，不是么？"
    }
    {
      Id = "MelinoeField_3629"
      InheritFrom = "BaseNarrative"
      DisplayName = "给那些犯下罪行的敌人降下神罚，在你眼中是件很惬意的事吗？虽然我也会享受工作完成之后的成就感啦。等等，重点不会是{#Emph}“和我一起”{#Prev}吧？"
    }
    {
      Id = "NemesisField_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就闭嘴吧。我们以前经常对练，和现在这一幕很像，仅此而已。除了你，还没见过有人能跟上我的水平的，更别说超过我了。"
    }
    {
      Id = "MelinoeField_3630"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我们之间的关系，就只是良性竞争而已吗？"
    }
    {
      Id = "NemesisField_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = " 我说了，闭嘴。你还想有什么关系。"
    }
    {
      Id = "MelinoeField_3631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……晚点再跟你说。"
    }
    {
      Id = "NemesisField_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我出汗了？我出汗了。以前从来没有过这种事，那些不过是些杂兵，我……{#Emph}哦，该死……"
    }
    {
      Id = "MelinoeField_3620"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么了，涅，你还好么？我们的敌人说不定用了下毒之类的阴损手段，让我看看你的伤口……"
    }
    {
      Id = "NemesisField_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "别碰我！不是那么回事。走吧。"
    }
    {
      Id = "MelinoeField_3621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿……"
    }
    {
      Id = "NemesisField_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里不像温泉池那里那么舒服，是不是啊，王女？而且单打独斗也够累的。"
    }
    {
      Id = "MelinoeField_3622"
      InheritFrom = "BaseNarrative"
      DisplayName = "本来不用单打独斗的，但之前我提出可以一起杀入冥界的时候，你拒绝了我。现在改变想法了吗？"
    }
    {
      Id = "NemesisField_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是对你有些想法，不过跟之前的无关。你闯入了我的脑海；我想让你从那里出去。以前跟我对练时，你就总在让我分心。现在，情况更糟了。"
    }
    {
      Id = "MelinoeField_3623"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在说什么啊，{#Emph}我{#Prev}又做什么了……？……哦。你说“对我有些想法”，是指……对我有了些感情。那我们现在要怎么办……？"
    }
    {
      Id = "NemesisField_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还不清楚，但是……可以现在这里待一会儿，直到该走了为止。毕竟这里很安静。不是要逼你留下来，只是……最近我独处太多，想要平衡一下。"
    }
    {
      Id = "NemesisField_0453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，这个我不需要，不过也许你用得上。"
    }
    {
      Id = "MelinoeField_3627"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，涅……"
    }
    {
      Id = "MelinoeField_3628"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我和你一样，对美好的事物没有非分之想。我应该专心执行任务，你也应该专心于你的责任，所以恐怕我没法安心做那样的事。你能理解的，对么？"
    }
    {
      Id = "NemesisField_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能。当我没问。至少我们坦诚地聊了聊。我该走了，不过……迟点见。"
    }
    {
      Id = "MelinoeField_3624"
      InheritFrom = "BaseNarrative"
      DisplayName = "……平衡一下……唔，如果我们要舒服一些，而且不想把动静搞得太大的话，那你{#Emph}必须{#Prev}得把盔甲放一边才行。要不我先帮你脱掉，然后我们就看着来？"
    }
    {
      Id = "MelinoeField_3625"
      InheritFrom = "BaseNarrative"
      DisplayName = "……呼，你的盔甲穿起来比脱掉难得多，不过总归是穿好了。你还好么，涅？至少我没有再让你分心了……？"
    }
    {
      Id = "NemesisField_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "感觉是的，嗯，我好一些了。满足了。那你呢，你有没有……就……"
    }
    {
      Id = "MelinoeField_3626"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也很满足！好刺激……！我们本来应该专注于任务，而不是缓解彼此的孤独，不过……这算不算是非分之事，就留给你来定夺啦。"
    }
    {
      Id = "NemesisField_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "目前来说刚刚好。我该走了，不过之后再有类似的需求，我会来找你的。"
    }
    {
      Id = "MelinoeField_1968"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里到处都湿漉漉的，穿着那身盔甲一定很难受吧。看来你没有找到别的向下的路？"
    }
    {
      Id = "NemesisField_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "除了这条路之外，就只剩至福乐土了，那条路咱俩都休想通过。对克洛诺斯来说，有什么比把整个冥界封个严实更能彰显他权威的吗？"
    }
    {
      Id = "MelinoeField_1969"
      InheritFrom = "BaseNarrative"
      DisplayName = "还好他漏了一处。不过，他现在已经意识到我们在用这条路了。至少，他知道我在用了。"
    }
    {
      Id = "NemesisField_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是感谢你的提醒！难怪这边的鱼见人就咬。总之，我先走了。这套盔甲应该不会生锈，但还是小心为上。"
    }
    {
      Id = "MelinoeField_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "你打败过斯库拉和她的塞壬朋友们吗？我真希望不用听她们唱歌就能通过那里，哪怕就一次也好……"
    }
    {
      Id = "NemesisField_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们才不敢招惹我。等等，你跟她们{#Emph}打{#Prev}起来了？你到底干了什么，才会跟一个{#Emph}乐队{#Prev}结下梁子？"
    }
    {
      Id = "MelinoeField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我也说不清楚。但她们一见到我就要跟我拼命。"
    }
    {
      Id = "NemesisField_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谁知道你怎么搞的。"
    }
    {
      Id = "MelinoeField_0760"
      InheritFrom = "BaseNarrative"
      DisplayName = "在哀悼原野的彼端，通往塔耳塔罗斯的路上……那里把守着一个怪物……你知道它是什么吗？"
    }
    {
      Id = "NemesisField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只知道它是个麻烦。我不是每次都能找到那条路，而且就算我能找到，那个东西也会把我逼退。但你别担心，我已经在琢磨对策了。"
    }
    {
      Id = "NemesisField_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "问你件事；先说好，你敢拿这个笑话我，我就让你后悔：我到底要……要怎么进入塔耳塔罗斯。我成功穿过了哀悼原野，却发现前面是条死路。每一次都是。"
    }
    {
      Id = "MelinoeField_1966"
      InheritFrom = "BaseNarrative"
      DisplayName = "塔耳塔罗斯被封死了。我能进去的唯一原因就是我与生俱来的神权；就连克洛诺斯也无法将其夺走。不过，要不是有老师的帮助，我就不会知道解开封印的方法。"
    }
    {
      Id = "NemesisField_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "屁用没有，当我没问。一定有别的路可以进去，要是没有的话，我就闯出来一条。至于现在，趁你还有机会，好好享受没有竞争的感觉吧。"
    }
    {
      Id = "MelinoeField_3676"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于进入塔耳塔罗斯的路，你取得什么进展了吗？考虑到现在的形势，我真想把与生俱来的权力转移给你，但据我所知这应该不太可能。"
    }
    {
      Id = "NemesisField_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有我自己与生俱来的权力，谢了。以及，确实有进展。维修通道入口附近，那只三个头的魔兽……它会挖地洞。"
    }
    {
      Id = "MelinoeField_3677"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的计划就是利用那只魔兽在身后留下的隧道，抵达冥界最深处吗？你知道那是刻耳柏洛斯，是我父亲养的狗，对吧？"
    }
    {
      Id = "NemesisField_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "那不正好，又多了一个隧道会把我带往目的地的理由。早晚有一夜会的。记住我的话。"
    }
    {
      Id = "MelinoeField_3678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我记住了……"
    }
    {
      Id = "NemesisField_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟你说过，我会找到办法进来的。你爸这地界不错。不过，克洛诺斯大概把一切都翻修过了。"
    }
    {
      Id = "MelinoeField_3679"
      InheritFrom = "BaseNarrative"
      DisplayName = "恭喜你潜入了冥界最深处，涅墨西斯。如果你有在吸引敌军的兵力的话，那就更好了，毕竟这里敌人多得很。你杀到克洛诺斯那里了吗？"
    }
    {
      Id = "NemesisField_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次我到了一个肯定是冥府的地方，结果你猜怎么着？他们不让我进去。我试过敲门，试过砸门，全都没有。所以卡戎把我送回去了。"
    }
    {
      Id = "MelinoeField_3680"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡戎让你搭了他的船？他从来都没让我搭过！"
    }
    {
      Id = "NemesisField_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那看来你是没有这个与生俱来的权力，王女。"
    }
    {
      Id = "MelinoeField_3681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……啊。"
    }
    {
      Id = "NemesisField_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "知道你还没打算停下，你猜怎么着？我也一样。无论你现在要去做什么，都别想丢下我。"
    }
    {
      Id = "MelinoeField_4081"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然！去跟老师或者克洛诺斯爷爷聊一聊，他们就会告诉你我们目前的一切计划了。"
    }
    {
      Id = "NemesisField_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "好。与此同时，有人问起来的话，就说我在外面活动活动筋骨。"
    }
    {
      Id = "MelinoeField_0761"
      InheritFrom = "BaseNarrative"
      DisplayName = "你当初一定以为，这个时候你早就已经把克洛诺斯拿下了吧。你是不是压根就没见到他？有抵达过冥府附近吗？"
    }
    {
      Id = "NemesisField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "总有东西挡我的路。通往塔耳塔罗斯的路发生了许多改变。尤其是抵达了哀悼原野之后。"
    }
    {
      Id = "MelinoeField_0762"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能大概感觉到该往哪边走。要不是老师明令禁止，我肯定会提议我们结伴前进。"
    }
    {
      Id = "NemesisField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "别想了，不管她禁不禁止，这事都没可能。我要单独行动。这样对我们两个都好。"
    }
    {
      Id = "MelinoeField_1211"
      InheritFrom = "BaseNarrative"
      DisplayName = "你穿的那一身重甲不会妨碍行动么？一定不太好受吧，尤其是在腰部。"
    }
    {
      Id = "NemesisField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "不好受就对了，这可是盔甲。此外，又不是每个人都想像你似的，光着半个身子就上战场。"
    }
    {
      Id = "MelinoeField_1212"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真该试试光着半个身子上战场的感觉。说不定你会喜欢呢！"
    }
    {
      Id = "NemesisField_0015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不了，我更喜欢刀枪不入。"
    }
    {
      Id = "NemesisField_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}该死！{#Prev}我到底要输给你金币多少次？这个赌注的规则也许太偏向你那边了。"
    }
    {
      Id = "MelinoeField_1967"
      InheritFrom = "BaseNarrative"
      DisplayName = "规则是你自己定的。你从来不会刻意“偏向”我的，对吧，涅？不过，你也不会允许自己制定出对我不公平的规则就是了。"
    }
    {
      Id = "NemesisField_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "我越来越觉得，这可能是我的一个弱点。好吧，去给你自己买点好的吧，王女殿下。正好省得我走到哪都叮当响了。"
    }
    {
      Id = "NemesisField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "有段时间没跟你打过赌了。最近老见你去地表“透气”。还以为你终于想通了，要把这里的事情交给我来处理呢。"
    }
    {
      Id = "MelinoeField_1213"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我在这里的事情还没完呢。而且看起来你也差得远嘛。最近没什么进展吧？这任务很难，我知道的。"
    }
    {
      Id = "NemesisField_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "闭嘴吧你。"
    }
    {
      Id = "NemesisField_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "别再硬撑着了。早点承认自己的失败，我就能早点让你见识见识我的厉害。"
    }
    {
      Id = "NemesisField_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，卡戎，生意还真好啊。"
    }
    {
      Id = "NemesisField_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "没看到我正跟我哥说话呢吗？"
    }
    {
      Id = "NemesisField_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "别烦我，我正买东西呢。"
    }
    {
      Id = "NemesisField_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "别插队。是我先到的。"
    }
    {
      Id = "NemesisField_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回去找赫卡忒吧，这里我接管了。"
    }
    {
      Id = "NemesisField_0327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我一直都在说，你不是那块料。"
    }
    {
      Id = "NemesisField_0328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别让我听到你因此埋怨命运女神。"
    }
    {
      Id = "NemesisField_0329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我还以为你很能忍呢。"
    }
    {
      Id = "NemesisField_0330"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是你的报应，我早该知道的。"
    }
    {
      Id = "NemesisField_0331"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这就招架不住了，真可怜。"
    }
    {
      Id = "NemesisField_0332"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就这样，还要我们都指望你？"
    }
    {
      Id = "NemesisField_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，你可以做得比这更好的。"
    }
    {
      Id = "NemesisField_0334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "去吧，小身板，滚回家去。"
    }
    {
      Id = "NemesisField_0335"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你从来都顶不住压力。"
    }
    {
      Id = "NemesisField_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "算你走运。"
    }
    {
      Id = "NemesisField_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感谢命运三女神。"
    }
    {
      Id = "NemesisField_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "算你走运。"
    }
    {
      Id = "NemesisField_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是你应得的。"
    }
    {
      Id = "NemesisField_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那又怎样。"
    }
    {
      Id = "NemesisField_0407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你要那个干什么？"
    }
    {
      Id = "NemesisField_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是幸运。"
    }
    {
      Id = "NemesisField_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好极了。"
    }
    {
      Id = "NemesisField_0420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哇哦。"
    }
    {
      Id = "NemesisField_0421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那又怎样。"
    }
    {
      Id = "NemesisField_0414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "搞什么？"
    }
    {
      Id = "NemesisField_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回来战斗！"
    }
    {
      Id = "NemesisField_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你在干什么？"
    }
    {
      Id = "NemesisField_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还手啊！"
    }
    {
      Id = "NemesisField_0408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你这又是何苦。"
    }
    {
      Id = "NemesisField_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又多了一个要守护的暗灵。"
    }
    {
      Id = "NemesisField_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你干了什么。"
    }
    {
      Id = "NemesisField_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "多感人啊。"
    }
    {
