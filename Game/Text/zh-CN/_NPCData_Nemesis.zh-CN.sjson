    }
    {
      Id = "Nemesis_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说你找到了命运三女神。我不相信是那么回事。估计你都没有在找。是她们找到了{#Emph}你{#Prev}。"
    }
    {
      Id = "Melinoe_5270"
      InheritFrom = "BaseNarrative"
