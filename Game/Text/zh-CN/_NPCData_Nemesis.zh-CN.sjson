    }
    {
      Id = "Nemesis_0473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "倒也无妨。"
    }
    {
      Id = "MelinoeField_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她在这做什么？"
    }
    {
      Id = "NemesisField_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当心邪眼。"
    }
    {
      Id = "NemesisField_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "来得正是时候。"
    }
    {
      Id = "NemesisField_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这边我正要处理。"
    }
    {
      Id = "NemesisField_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "打个赌如何。"
    }
    {
      Id = "NemesisField_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想跟我打个赌么？"
    }
    {
      Id = "NemesisField_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我打赌我能杀掉更多敌人。"
    }
    {
      Id = "NemesisField_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我劝你别挡我的路。"
    }
    {
      Id = "NemesisField_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你觉得你能杀得比我多么？"
    }
    {
      Id = "NemesisField_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别挡我的路。"
    }
    {
      Id = "NemesisField_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还觉得你能赢得了我么？"
    }
    {
      Id = "NemesisField_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你觉得你更厉害，那就证明给我看。"
    }
    {
      Id = "NemesisField_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "赢了我，我的金币就归你。"
    }
    {
      Id = "NemesisField_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我杀得更多，你的金币就是我的了。"
    }
    {
      Id = "NemesisField_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "准备好战斗，否则就别挡路。"
    }
    {
      Id = "NemesisField_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很好，正愁没有金币呢。"
    }
    {
      Id = "NemesisField_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就知道你会出现。"
    }
    {
      Id = "NemesisField_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "惊喜。"
    }
    {
      Id = "NemesisField_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "注意。"
    }
    {
      Id = "NemesisField_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们来了。"
    }
    {
      Id = "NemesisField_0250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "出来吧……"
    }
    {
      Id = "NemesisField_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "开始了。"
    }
    {
      Id = "NemesisField_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也该来了。"
    }
    {
      Id = "NemesisField_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看好。"
    }
    {
      Id = "NemesisField_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们是自找的。"
    }
    {
      Id = "NemesisField_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于……"
    }
    {
      Id = "NemesisField_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等了好久了。"
    }
    {
      Id = "NemesisField_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "咱们开始吧。"
    }
    {
      Id = "NemesisField_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "让我看看你的身手。"
    }
    {
      Id = "NemesisField_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是他们的报应。"
    }
    {
      Id = "NemesisField_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "来啊。"
    }
    {
      Id = "NemesisField_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "清算时间到。"
    }
    {
      Id = "NemesisField_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看我让他们清醒清醒。"
    }
    {
      Id = "NemesisField_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "派上点用场。"
    }
    {
      Id = "MelinoeField_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我看到他们了。"
    }
    {
      Id = "MelinoeField_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "动手吧。"
    }
    {
      Id = "MelinoeField_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真没有耐心……"
    }
    {
      Id = "MelinoeField_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看好了。"
    }
    {
      Id = "MelinoeField_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不一定轮得到你。"
    }
    {
      Id = "MelinoeField_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "管好你自己。"
    }
    {
      Id = "MelinoeField_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就开始吧！"
    }
    {
      Id = "MelinoeField_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就来吧！"
    }
    {
      Id = "MelinoeField_0048"
      InheritFrom = "BaseSubtitle"
      DisplayName = "比赛开始。"
    }
    {
      Id = "MelinoeField_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看看谁笑到最后，涅！"
    }
    {
      Id = "Nemesis_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么快就碰壁了！你这小身板，挨了一拳就滚回来了吧。她派你步行出发，还只许你一个人去，真是不可理喻。"
    }
    {
      Id = "Melinoe_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁都不服，还成天抱怨，能有{#Emph}现在这个任务{#Prev}你就知足吧。"
    }
    {
      Id = "Nemesis_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，闭嘴吧你。"
    }
    {
      Id = "Nemesis_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们是不会帮你的，知道吧。我是指命运三女神。不是谁的祈求都能得到她们的怜悯。要说的话，你这样做恐怕只会让事情更糟。"
    }
    {
      Id = "Melinoe_1541"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你只是太看不起你的姐姐们了。既然她们曾经帮助过我哥哥，那她们就也有可能对我们伸出援手。毕竟，这件事就连她们也无法置身事外。"
    }
    {
      Id = "Nemesis_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你是指牵扯到了她们的“家人”？她们才不在乎。她们只知道忙着操弄每个人的生命，让一切看起来都像是意外。"
    }
    {
      Id = "Melinoe_1542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你不该这样说她们的……"
    }
    {
      Id = "Nemesis_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "难以置信，在命运女神面前摇尾乞怜居然真的有用。那边那一大张卷轴……真是她们送来的？"
    }
    {
      Id = "Melinoe_1543"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，而且还是由摩罗斯大人亲自送来的呢。他当时看起来有点赶时间，所以我们没说上几句话。你们两个关系亲近吗？"
    }
    {
      Id = "Nemesis_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是倪克斯的子女；倪克斯的子女就没有关系亲近的。但我们还算面熟。某些穷凶极恶的凡人遭报应时，我们两个都要各司其职。"
    }
    {
      Id = "Melinoe_1544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很难想象那样的场面。"
    }
    {
      Id = "Nemesis_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "从没想过会在这里见到摩罗斯。不过话又说回来，三岔路口早晚会迎来毁灭，也算意料之中。"
    }
    {
      Id = "Melinoe_1545"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么把这说得像个{#Emph}坏消息{#Prev}似的。所有倪克斯的子女在这里都受欢迎。这是老师亲口承诺过的。"
    }
    {
      Id = "Nemesis_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "无所谓。我大概该过去打个招呼……"
    }
    {
      Id = "Melinoe_2234"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和卡戎大人之间的关系那么淡吗？每次你去找他的时候，都只会问关于他货物的事情。不过至少你也在给他提供金币。"
    }
    {
      Id = "Nemesis_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "你可能理论上来说是有个哥哥，但你没体验过真有个哥哥在身边的感觉。卡戎不喜欢说话；我尊重这一点。"
    }
    {
      Id = "Melinoe_2235"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？他好像从来都不介意跟我说话呀，虽然是用他自己的方式。"
    }
    {
      Id = "Nemesis_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "说不定是因为你生而{#Emph}独特{#Prev}吧。"
    }
    {
      Id = "Nemesis_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，我是没想到，你会去跟卡俄斯套近乎……想要让整个世界上最古老的力量站在你这一边？自作聪明。祂可是根本意义上{#Emph}毫无偏颇{#Prev}的存在。"
    }
    {
      Id = "Melinoe_3228"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来你也有去跟祂套近乎嘛！我看见过你纵身跳入混沌之门，那副样子摆明了是知道它会通向何处。你也不是第一次了？"
    }
    {
      Id = "Nemesis_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "与你无关。我只是告诉你，别以为卡俄斯只会帮{#Emph}你{#Prev}，不会帮其他人。因为那样不公平。"
    }
    {
      Id = "Melinoe_3229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有道理。"
    }
    {
      Id = "Nemesis_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "让我猜猜。命运三女神除了给你安排了一堆苦差之外，什么都没给你。石破天惊的启示半个没有；脏活累活让你照单全收。"
    }
    {
      Id = "Melinoe_1546"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没那么无知，不至于怀疑命运的安排。一则小预言的应验或许能为更重要的预言创造条件。"
    }
    {
      Id = "Nemesis_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "自欺欺人。"
    }
    {
      Id = "Nemesis_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们一直在原地踏步。我应该上阵杀敌！而不是在这个不经邀请压根没法抵达的地方站岗放哨。该死……"
    }
    {
      Id = "Melinoe_0679"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得在现在的事态下，加强这里的安全措施再合理不过了。不过，要是你不这么觉得的话，那就找老师说理去，别冲我发脾气。"
    }
    {
      Id = "Nemesis_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哼……"
    }
    {
      Id = "Nemesis_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不配。你配不上这一切。这不公平。但现在也由不得你了。所以，现在唯一的问题是：你到底要怎么办才好？"
    }
    {
      Id = "Melinoe_3930"
      InheritFrom = "BaseNarrative"
      DisplayName = "很快你就会知道了！不过，你怎么能这么笃定我配不上，以及这件事不公平？"
    }
    {
      Id = "Nemesis_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈！也不想想我是谁。"
    }
    {
      Id = "Nemesis_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心，你在外面没错过什么。我就一直杵在这里，念着祝你旗开得胜、祝你安全归来之类的祈祷词。所以说，有用吗？"
    }
    {
      Id = "Melinoe_1549"
      InheritFrom = "BaseNarrative"
      DisplayName = "还行，谢了。以及，你可能想不到，没有得到你的支持这点，反而鞭策着我努力前进。"
    }
    {
      Id = "Nemesis_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "“没有得到支持”这句话，还轮不到你说……"
    }
    {
      Id = "Nemesis_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "这都多少次行动了？还好我们的泰坦朋友正忙着对付你山上的那些亲戚，没功夫处理你。"
    }
    {
      Id = "Melinoe_1568"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，我没在数。这种事情急不得。不过，要是{#Emph}你{#Prev}的话，一定第一次就把泰坦解决掉了吧？"
    }
    {
      Id = "Nemesis_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "反正现在是没法知道了，对吧？"
    }
    {
      Id = "Nemesis_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直以为……只要我比你训练得更加刻苦，她就会重新考虑。会把任务交给我。于是我把自己累得半死。结果半点用都没有。"
    }
    {
      Id = "Melinoe_1547"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也有在努力训练啊。而且老师对于我们每个人的职责分配，一直都说得很清楚。你改变不了你与生俱来的身份，我也改变不了我的。"
    }
    {
      Id = "Nemesis_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这不公平……"
    }
    {
      Id = "Nemesis_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "又来跟我闲扯淡干什么，{#Emph}滚出去{#Prev}用你的小身板对付泰坦去啊！你到底在等什么？"
    }
    {
      Id = "Melinoe_1567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真没礼貌！"
    }
    {
      Id = "Nemesis_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "又失败了。差不多要放弃了吧？你不像我一样燃着熊熊斗志。这事对你来说算不上私仇。"
    }
    {
      Id = "Melinoe_1550"
      InheritFrom = "BaseNarrative"
      DisplayName = "算不上{#Emph}私仇{#Prev}？你有在三岔路口见过我妈么，涅？我爸呢？我哥呢？他们都被克洛诺斯夺走了！"
    }
    {
      Id = "Nemesis_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "我失去的也不止我妈。而且至少我{#Emph}认识{#Prev}她。你妈对你来说又算是什么人？你只不过是从她子宫里爬了出来而已。"
    }
    {
      Id = "Melinoe_1551"
      InheritFrom = "BaseSubtitle"
      DisplayName = "住口。"
    }
    {
      Id = "Melinoe_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上次说的，关于我妈妈的那番话。太过分了。"
    }
    {
      Id = "Nemesis_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼。好吧。我们在这里没法互相残杀，但话语也能伤人。如果我们是在战场上动真格的话，别指望我手下留情。"
    }
    {
      Id = "Melinoe_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这我知道。"
    }
    {
      Id = "Nemesis_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说，他们状况如何？你的家人。珀尔塞福涅王后、扎格列欧斯王子，那一票人。王子暂时还没有把这柄剑要回去的打算吧？"
    }
    {
      Id = "Melinoe_5251"
      InheritFrom = "BaseNarrative"
      DisplayName = "他没提起来过，他……我也不知道怎么说，我挺喜欢他的。也许是我跟他不像其他家族的某些兄弟姐妹一样，在一起相处了千万年吧。至于我的父母，他们……满足了我对他们的所有想象，应该可以这么说。"
    }
    {
      Id = "Nemesis_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯。很可能是因为你的想象填补了很多空白。不过，至少你找到了他们，而且有了个好的开始。别把这一切当作理所应当。"
    }
    {
      Id = "Melinoe_5252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我绝对不会的。"
    }
    {
      Id = "Nemesis_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说上次你一路杀到了塔耳塔罗斯。你走了多远？有回到那个{#Emph}本该属于你的家{#Prev}吗？"
    }
    {
      Id = "Melinoe_3223"
      InheritFrom = "BaseNarrative"
      DisplayName = "你指的是冥府的话，是的，我回到了那里。不过现在与其管它叫“冥府”，还不如管它叫{#Emph}“克洛诺斯府”{#Prev}。他在那里等着我，不出所料，而且……他很强，这点也不出所料。"
    }
    {
      Id = "Nemesis_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是他对你来说{#Emph}太{#Prev}强了。好吧，不能怪你，至少你努力了。所以现在你有什么计划，继续去找他讨打，直到他把你打得彻底丧失斗志？还是说，现在就已经走到那一步了？"
    }
    {
      Id = "Melinoe_3224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我的任务保持不变。"
    }
    {
      Id = "Nemesis_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那好！"
    }
    {
      Id = "Nemesis_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到你比我先一步见到克洛诺斯。我知道你面对他毫无胜算，只是……我还以为你一时半会儿到不了那里。"
    }
    {
      Id = "Melinoe_3098"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这是拐着弯夸我吗？又或者，也许你是想跟我道歉？"
    }
    {
      Id = "Nemesis_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "都不是。"
    }
    {
      Id = "Nemesis_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是来冲我炫耀的，是么。{#Emph}“我干掉他啦！我干掉了泰坦耶！”{#Prev}哼，不重要。他还活着，你是知道的，不是么？"
    }
    {
      Id = "Melinoe_2965"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是来炫耀的，而且我知道。但这仍然是个进展。我能击败克洛诺斯一次，就能击败他更多次。而且终有一夜……他再也无法回来。"
    }
    {
      Id = "Nemesis_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。因为在那一夜，我会亲手了结他。"
    }
    {
      Id = "Melinoe_2966"
      InheritFrom = "BaseSubtitle"
      DisplayName = "然后你就可以炫耀了，对吧？"
    }
    {
      Id = "Nemesis_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "我该承认，我之前确实错了。我压根没想过你能找到克洛诺斯；至少没想过你会比我更先到那里。至于你一次又一次地打败他，就更出乎我的意料了。所以……我错了。对不起。"
    }
    {
      Id = "Melinoe_3225"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，你知道么，听到这样的话从你口中说出来让我很震惊。看起来我们彼此都很擅长出乎对方的意料嘛。不过，说真的……谢谢你。"
    }
    {
      Id = "Nemesis_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用谢我。只是说句公道话。我本来有机会追上你的，但却没法克服路上的重重难关。或许我本来也有机会打败克洛诺斯吧。但是现在恐怕就不好说了。"
    }
    {
      Id = "Melinoe_3226"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要灰心！还有很多事情需要完成。我们需要你的力量震慑敌人，也需要你的警惕保护家园。我们匿踪者只有携手同心，才能取得胜利，否则就只会自取灭亡。"
    }
    {
      Id = "Nemesis_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "忍不住要给我来一段励志演说，是吧。"
    }
    {
      Id = "Melinoe_3227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……是呢。"
    }
    {
      Id = "Nemesis_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "杀不死克洛诺斯，也杀不死提丰，所以现在怎么办？就这么坚持下去，直到有人撑不住？还以为我们的计划多高明呢。"
    }
    {
      Id = "Melinoe_4428"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦唤醒了那个魔物，自以为占据了上风。但我们会把这场危机变为转机。提丰的力量无比强大；这力量可以为我们所用。"
    }
    {
      Id = "Nemesis_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的以为时间泰坦会亲手奉上打倒他自己的关键？听起来不太聪明。"
    }
    {
      Id = "Melinoe_4429"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的计划从一开始就是利用他不知道的东西。"
    }
    {
      Id = "Nemesis_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我看他知道得比你多得多。"
    }
    {
      Id = "Melinoe_1570"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅，我又做了一场梦。我梦到了你的妈妈，和我的爸爸……我爸爸在为你妈妈担忧，她……她被泰坦的魔法控制了。"
    }
    {
      Id = "Nemesis_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "把冥界的众多事务托付给哈迪斯，是我妈判断失误。哈迪斯从来没有掌管冥界的权力，至少在命运三女神赋予他之前没有。我妈当时一个人管理一切很辛苦。命运三女神可能本意只是想给她派去个帮手。"
    }
    {
      Id = "Melinoe_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是说，命运三女神赐予了我爸爸掌管冥界的神权，只是为了帮倪克斯分担一些她的责任？"
    }
    {
      Id = "Nemesis_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Melinoe_0622"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵。"
    }
    {
      Id = "Melinoe_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，关于我做的那场梦……克洛诺斯，他……要求我父亲告诉他命运三女神的藏身之处。"
    }
    {
      Id = "Nemesis_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "很聪明，毕竟我妈是绝对不会松口的。命运三女神虽然按说是我的姐妹，但就连我也不知道她们到底在哪。只要她们不被人发现，就没有人能对她们的设计做手脚。"
    }
    {
      Id = "Melinoe_1571"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想说的是，克洛诺斯似乎找到了命运三女神的所在，而且可能会强迫她们改变对未来的编织。你好像对此不是很在意。"
    }
    {
      Id = "Nemesis_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你认真的？{#Prev}我从不觉得这一切会有什么好下场，难道不是写在脸上的吗？"
    }
    {
      Id = "Melinoe_1572"
      InheritFrom = "BaseNarrative"
      DisplayName = "他究竟为什么能找到她们？命运三女神难道不该早就料到这个威胁了吗？"
    }
    {
      Id = "Nemesis_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们总在编织命运，这意味着她们也只能预见不久后的未来。而克洛诺斯，他就是时间本身。{#Emph}时间{#Prev}的脚步总比人想象得快。"
    }
    {
      Id = "Melinoe_5278"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯找到了命运的三位织匠，把她们流放了，然后现在找不到她们了。你好像对此不是很在意。"
    }
    {
      Id = "Melinoe_5279"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是怎么做到的……？难道命运三女神无法预见威胁么？"
    }
    {
      Id = "Nemesis_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连我妈的武器都更青睐你。我本以为暗夜武器会先为我而苏醒。没想到命运三女神另有打算。"
    }
    {
      Id = "Melinoe_1569"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得命运三女神也很照顾你啊。你的武器可是冥界之刃斯第格思！英雄、神明乃至泰坦都曾经倒在这把刀下。"
    }
    {
      Id = "Nemesis_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "说得好像它该退休了似的。"
    }
    {
      Id = "Melinoe_0613"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅，你这么在意凡间的公正，但为什么好像对我们的公正不上心呢？克洛诺斯夺走了我们的{#Emph}一切{#Prev}！你说过每个人都应该得到报应，不是么？"
    }
    {
      Id = "Nemesis_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵。你看，事情是这样的。据我所知，在克洛诺斯统治的时候，凡人其实过得更舒服。他们管那段时间叫{#Emph}黄金时代{#Prev}。"
    }
    {
      Id = "Melinoe_2749"
      InheritFrom = "BaseNarrative"
      DisplayName = "那他们真该谢谢他的大恩大德！只可惜他对自己的子女就没这么慷慨了。你觉得他对几个凡人发发善心，他的罪孽就能既往不咎了吗？"
    }
    {
      Id = "Nemesis_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，你想想。有没有可能……有没有可能{#Emph}这就是{#Prev}我们的报应？"
    }
    {
      Id = "Melinoe_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们不该遭受这样的命运，涅墨西斯。我们被迫藏在阴影之中，还被夺走了家人。你难道不想让{#Emph}你的家人{#Prev}得到公正的待遇吗？"
    }
    {
      Id = "Nemesis_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈。"
    }
    {
      Id = "Melinoe_0616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "行吧。"
    }
    {
      Id = "Melinoe_1561"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你上次去地表是什么时候了？"
    }
    {
      Id = "Nemesis_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "太久之前了。别忘了，我现在被困在这，哪都去不了。但反正地表也没救了。为什么问这个？"
    }
    {
      Id = "Melinoe_1562"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯请求我有机会去拜访一下地表。我想知道该做什么样的心理准备。"
    }
    {
      Id = "Nemesis_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "就像我说的，没救了。多亏我们的泰坦朋友，现在亡者都在地表横着走。对你来说就跟回家了一样。"
    }
    {
      Id = "Melinoe_1563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真让人期待。"
    }
    {
      Id = "Melinoe_3211"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯请求我有机会去拜访一下地表。我想着来问问你有什么建议。"
    }
    {
      Id = "Nemesis_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的到地表去了。他们本可以找个更有经验的人，但也许我在他们眼里还是不够格吧。"
    }
    {
      Id = "Melinoe_1575"
      InheritFrom = "BaseNarrative"
      DisplayName = "前往地表是我任务的一部分。不过，地表的人一定也很想念你。目光所及，都是苦难……"
    }
    {
      Id = "Nemesis_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "正义已经不再重要了。那些凡人是咎由自取。也许我们也一样。"
    }
    {
      Id = "Melinoe_1576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别这么说……"
    }
    {
      Id = "Nemesis_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该向下出发，向你的目标前进，而不是往上跑。忘了那座山吧。那不是你的战斗。"
    }
    {
      Id = "Melinoe_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的家人在奥林匹斯山上被克洛诺斯大军压境，凭什么说这不是我的战斗？"
    }
    {
      Id = "Nemesis_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为克洛诺斯现在在下面，正坐在你爸的王座上享受生活呢。他才是你的目标，其他的一切都不需要你操心。"
    }
    {
      Id = "Melinoe_0619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你说不需要就不需要。"
    }
    {
      Id = "Melinoe_4424"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么我从没有在地表见到过你，涅？想必我们在那里也有值得你出手的敌人吧。"
    }
    {
      Id = "Nemesis_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "任务只有一个，杀死克洛诺斯。我不像你，不会被细枝末节耽搁。你每在神山浪费一夜，克洛诺斯在冥界的力量就增长一分。"
    }
    {
      Id = "Melinoe_4425"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不觉得提丰的反复现身会让整件事变得更难处理么？他不是那种可以长久无视的麻烦。"
    }
    {
      Id = "Nemesis_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "无视不了么？学学我。"
    }
    {
      Id = "Nemesis_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯回来了。你做了什么？你召唤了她吗？我看到你们两个说话了。"
    }
    {
      Id = "Melinoe_3099"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到你的妹妹，你一点都不开心吗？我对她的影响力比你好不到哪去。老师倒是仍然和以前一样，全当她不存在。"
    }
    {
      Id = "Nemesis_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "理想情况下，厄里斯应该呆在离这里非常远的地方。还好这个地方没人能不请自来，否则就算是她带着克洛诺斯到了我们家门口，我也不会太意外。"
    }
    {
      Id = "Melinoe_3100"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的觉得倪克斯的亲生女儿会背叛我们吗？我知道厄里斯很特别，可是……"
    }
    {
      Id = "Nemesis_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "你爸还是克洛诺斯的亲生儿子呢。{#Emph}他们{#Prev}关系处得怎么样？"
    }
    {
      Id = "Melinoe_3101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……有道理。"
    }
    {
      Id = "Melinoe_3102"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯选择了与我们为敌。正当我快要抵达我在地表的目的地时，她拦住了我，然后用狮鹫坚炮的枪林弹雨向我问好。"
    }
    {
      Id = "Nemesis_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "毫不令人意外。所以我们能怎么做？把她赶走是不可能的，因为“凡是倪克斯的儿女，三岔路口都欢迎”，不知道是谁出的馊主意。实在不行，就只能{#Emph}再{#Prev}给她些机会，等她改过自新了？"
    }
    {
      Id = "Melinoe_3103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我明白你的意思。"
    }
    {
      Id = "Melinoe_3220"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有没有办法跟厄里斯讲讲道理？让她别挡着我去奥林匹斯山的路。再不然的话，把她死死按在地上说不定也行？"
    }
    {
      Id = "Nemesis_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "我压根不想在她身上浪费任何时间，不过把她死死按在地上这事听着还挺爽。话说，最近你没见到她在冥界出没，对吧。"
    }
    {
      Id = "Melinoe_3221"
      InheritFrom = "BaseNarrative"
      DisplayName = "除了三岔路口之外，没有。不过你是什么意思？是想建议我躲着她，完全专注于藏身地底的克洛诺斯吗？现在事情对我来说没有那么简单了。"
    }
    {
      Id = "Nemesis_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没说这样会更简单。但不想跟厄里斯打交道的话，你始终可以专注于你的主要目标。或者把这件事交给{#Emph}我{#Prev}，要我说本来就该如此。"
    }
    {
      Id = "Melinoe_3222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "知道了。"
    }
    {
      Id = "Nemesis_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "你让厄里斯尝到了些教训，是么。隔着这么大老远，我都能听到她的鬼哭狼嚎。上次亲手揍她已经太久远了。至少现在{#Emph}有人{#Prev}替我管教她。"
    }
    {
      Id = "Melinoe_3218"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许是你们之间那些野蛮的斗殴助长了她的坏脾气。话说回来，说不定你的坏脾气也是因此而来的。除非你确定你们两个从头到尾都没有改变过，但那样的话，你们打来打去究竟是为了什么呢？"
    }
    {
      Id = "Nemesis_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又不是不认识她。她总喜欢没事找事。你也不是不认识{#Emph}我{#Prev}。我遇到事从来不忍着。至于你，先去学学怎么礼貌地接受别人的赞美吧。"
    }
    {
      Id = "Melinoe_3219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我一定是没听出来。"
    }
    {
      Id = "Nemesis_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是吧。"
    }
    {
      Id = "Melinoe_5260"
      InheritFrom = "BaseNarrative"
      DisplayName = "有人跟你说过你跟你妈妈长得有点像么，涅墨西斯？见过她之后，我就意识到你们的共同点了。事实上，第一次见到她的时候，我……嗯，总之是这样啦。"
    }
    {
      Id = "Nemesis_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "不像。别想了。第一次见到她的时候，你怎么了？"
    }
    {
      Id = "Melinoe_5261"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，第一次见到她，我……就，我被她的容貌震撼到了！是好的那种震撼。她看起来就像是你，只不过穿上了华美的长袍，眉头也更舒展了一些。"
    }
    {
      Id = "Nemesis_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就是这么夸人的。没人想长得像自己的母亲。而且我跟她长得也不像。除了头发，大概。"
    }
    {
      Id = "Melinoe_5262"
      InheritFrom = "BaseNarrative"
      DisplayName = "得墨忒尔女士说我和我妈长得很像，我听了很开心呢！珀尔塞福涅王后美得很动人。"
    }
    {
      Id = "Nemesis_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你觉得她和倪克斯的关系，会有我们这么好吗？"
    }
    {
      Id = "Melinoe_5263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那怎么可能。"
    }
    {
      Id = "Nemesis_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "昨晚我遇上了倪克斯。所以每当她在哈迪斯和珀尔塞福涅身边呆够了，她就会去找卡俄斯清静清静。可以理解。"
    }
    {
      Id = "Melinoe_5258"
      InheritFrom = "BaseNarrative"
      DisplayName = "她去卡俄斯那里才不是为了躲我父母！冥界发生了那么多事，你不觉得她和卡俄斯会有很多事情要讨论吗？"
    }
    {
      Id = "Nemesis_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实。想象一下他们都能讨论什么。“这里真是一如既往地黑，卡俄斯。”“还真是，倪克斯。”"
    }
    {
      Id = "Melinoe_5259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（笑）抱歉。"
    }
    {
      Id = "Melinoe_5255"
      InheritFrom = "BaseNarrative"
      DisplayName = "你母亲重新出现在你生命里的感觉如何？我还在适应我自己的母亲出现在我生命里的感觉，虽然我没办法每夜都见到她。"
    }
    {
      Id = "Nemesis_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "我怀疑倪克斯也不会常来。从来都是这样。但她也始终没有真正离去。在时间存在之前，黑夜就已经存在了。没人敢招惹她。"
    }
    {
      Id = "Melinoe_5256"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到这个，听起来你现在又获得了批准，可以自由地裁定谁该遭到报应了，虽然你之前也一直在这么做啦。没必要一直追着克洛诺斯不放嘛！"
    }
    {
      Id = "Nemesis_0422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，我跟他还没完。"
    }
    {
      Id = "Melinoe_5257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一点都不意外呢！"
    }
    {
      Id = "Melinoe_1552"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，涅，你之前对老师口无遮拦，惹上了多大的麻烦？那次实在是太不尊重人了，比你平时还过分得多。"
    }
    {
      Id = "Nemesis_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵！看起来，又得多站好多岗了。但我觉得值。总得有人来平衡一下你的阿谀奉承。"
    }
    {
      Id = "Melinoe_1553"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就知道，你根本分不清什么是最基本的礼貌，什么是你口中的“阿谀奉承”。"
    }
    {
      Id = "Nemesis_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你只是她的工具，你该知道的。"
    }
    {
      Id = "Melinoe_1554"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和老师之间的关系一直都是这样吗？我以前还以为你最讨厌的人是{#Emph}我{#Prev}呢。"
    }
    {
      Id = "Nemesis_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "王女殿下，你一直都幼稚得令人发指。至于赫卡忒，在她决定用{#Emph}站岗放哨{#Prev}来浪费我的能力之前，我还没这么讨厌她。"
    }
    {
      Id = "Melinoe_1555"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个决定是她很久之前做的了。所以你就打算一直记恨她么？还是说你要做些什么？"
    }
    {
      Id = "Nemesis_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在容忍她，这还不够吗？我在兑现我对我妈许下的诺言。否则，我早扬长而去了，让你失望都来不及。"
    }
    {
      Id = "Melinoe_1556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，那样我会很失望的。"
    }
    {
      Id = "Nemesis_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还纳闷赫卡忒怎么突然没影了呢。原来是专门为了拦住你啊！然后你就哭着回来了。看来她不希望你成功。"
    }
    {
      Id = "Melinoe_1557"
      InheritFrom = "BaseNarrative"
      DisplayName = "她希望我能准备好迎接前路的挑战。"
    }
    {
      Id = "Nemesis_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这都不还嘴，真没劲。"
    }
    {
      Id = "Nemesis_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "你通过了她的小小测试。痛打她的感觉一定很爽。我没机会跟她过招，所以就只能想象了。"
    }
    {
      Id = "Melinoe_1558"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们不是单纯地在“过招”。你对巫术一无所知。"
    }
    {
      Id = "Nemesis_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我只知道她一定打不过我……"
    }
    {
      Id = "Nemesis_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "下次要说我的坏话，你就当着我的面说。不过，我知道你们女巫更喜欢暗箭伤人。"
    }
    {
      Id = "Melinoe_2236"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到底在说什么？我觉得你是在刁难我，而且完全不在意我的感受。听到了么！我是{#Emph}当着你的面{#Prev}说的。"
    }
    {
      Id = "Nemesis_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯又来教育我了。难道不是你干的好事？"
    }
    {
      Id = "Melinoe_2237"
      InheritFrom = "BaseNarrative"
      DisplayName = "他只是担心我们相处得不融洽。你又没有藏着掖着，而且他一向善于观察，你总不会不知道吧。"
    }
    {
      Id = "Nemesis_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "住。口。"
    }
    {
      Id = "Melinoe_1559"
      InheritFrom = "BaseNarrative"
      DisplayName = "我终于在外面遇上阿尔忒弥斯了。她有没有路过三岔路口，跟大家打个招呼？"
    }
    {
      Id = "Nemesis_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有。所以她最近在这一带出没吗？我还以为她正忙着集结你的叔叔阿姨们呢。等等，你是说，就算{#Emph}有了她的帮助{#Prev}，你也到不了目的地？"
    }
    {
      Id = "Melinoe_1560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哪有那么简单……！"
    }
    {
      Id = "Melinoe_2242"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有没有在外面遇见过阿尔忒弥斯？为了见上她一面的话，像你这样反复违抗命令，说不定也算是值得。"
    }
    {
      Id = "Nemesis_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又知道了。你难道真以为我溜进那片林子里，只是为了瞎折腾些有的没的？"
    }
    {
      Id = "Melinoe_2243"
      InheritFrom = "BaseNarrative"
      DisplayName = "那，你们两个至少没有起什么冲突吧？"
    }
    {
      Id = "Nemesis_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没有，放心。"
    }
    {
      Id = "Nemesis_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，又在唱。猎神看起来是要抢她弟弟的饭碗啊。你居然还没有凑过去一起唱，真让人惊讶。毕竟又是一件可以“勤加练习”的事。"
    }
    {
      Id = "Melinoe_4460"
      InheritFrom = "BaseNarrative"
      DisplayName = "可能看起来有些浪费时间，但我们唱歌不只是因为无事可做。歌声有种净化心灵的魔力。"
    }
    {
      Id = "Nemesis_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，对。阿尔忒弥斯跟我说过，你们说的“净化心灵”都是什么意思。还好我站得够远，不会怎么影响到我。"
    }
    {
      Id = "Melinoe_4461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来我们得为你唱大点声了。"
    }
    {
      Id = "Nemesis_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "又在跟修普诺斯说话了？他听不见你，别自作多情了。睡熟了就是这样，你该不会不知道吧。"
    }
    {
      Id = "Melinoe_0686"
      InheritFrom = "BaseNarrative"
      DisplayName = "睡眠没有你说得那么简单。我觉得他仍然能感受到我的言语和意图。"
    }
    {
      Id = "Nemesis_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "“感受到言语和意图”，嗯……我认识的修普诺斯完全有这个本事。"
    }
    {
      Id = "Nemesis_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "我简直不敢相信！你终于把修普诺斯叫醒了，结果我却在睡觉，错过了全程？他和你梦想得一样吗？"
    }
    {
      Id = "Melinoe_5276"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，呃……他的礼貌程度跟我想得不太一样，而且也没有对我特别感激。不过，我在睡过头之后，也会有起床气。然后，他就急匆匆地走了。"
    }
    {
      Id = "Nemesis_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "算你倒霉！一直以为他会很对你胃口。好吧，如果你最后回你父亲的冥府工作，你们会再见面的。现在，至少我不用{#Emph}每晚{#Prev}听他鼾声如雷了。"
    }
    {
      Id = "Melinoe_5277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这倒确实……"
    }
    {
      Id = "Melinoe_2238"
      InheritFrom = "BaseNarrative"
      DisplayName = "顺便一问，你之前怎么对纳西索斯意见这么大？我知道他有时候是有点气人，但是他人没有那么坏啦。"
    }
    {
      Id = "Nemesis_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "你该看看他对那个可怜宁芙干的好事。他让她的心碎了个彻底。但却对此一无所知，而且毫不在意。"
    }
    {
      Id = "Melinoe_2239"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到你还是个性情中人。还以为情人间的小小纠纷犯不上让你出手呢。"
    }
    {
      Id = "Nemesis_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "纳西索斯只在意自己，对身边的任何人都不管不顾。我不得不给他点教训，以儆效尤。我让他陷入了热恋。热恋的对象是他的倒影。至死方休。"
    }
    {
      Id = "Melinoe_2240"
      InheritFrom = "BaseNarrative"
      DisplayName = "那他死后成了暗灵，却仍然被他自己的倒影迷得神魂颠倒，这又怎么解释。"
    }
    {
      Id = "Nemesis_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "喂，女巫是你，又不是我。你知道诅咒总是这样的。"
    }
    {
      Id = "Melinoe_2241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……总是容易用出问题。"
    }
    {
      Id = "Melinoe_3232"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，说到纳西索斯。就算我真有那个本事，我也不会解除你在他身上降下的诅咒。他看起来对现状还挺满足的，何况……我能看得出来你真的认为他罪有应得。唯一的问题是，这个诅咒对回声的处境毫无帮助。"
    }
    {
      Id = "Nemesis_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "回声……就是因为那个宁芙，我才把纳西索斯加入“待办事项”。你的意思是，这样干脆利落、毫无后顾之忧的天罚，仍然不足以平复她的心情？"
    }
    {
      Id = "Melinoe_3233"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。你让他们两个之间扯平了，但他们两个的问题却都没有得到解决。解铃还须系铃人；最后解开彼此心结的，还是他们自己。"
    }
    {
      Id = "Nemesis_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "大概还得依靠你的帮助和鼓励吧？唉，我是无所谓，只要他们两个没有谁过得比对方好太多就行。听起来你把他们俩都说了一通，所以我相信他们两边的待遇算得上公平。"
    }
    {
      Id = "Melinoe_3234"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说你并不在乎他们过得怎么样，只在乎他们“公平”。"
    }
    {
      Id = "Nemesis_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你终于明白了。"
    }
    {
      Id = "Nemesis_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "又有个泰坦与我们作对了，是吗？{#Emph}普罗米修斯！{#Prev}据说还是有脑子的那一种。一转眼，就成了敌人。他本来可能站在我们这边的，要不是你的家族……你知道的。"
    }
    {
      Id = "Melinoe_3604"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，大名鼎鼎的{#Emph}“把他拴在一座山上让一只鹰啄食他的肝脏千万年”{#Prev}事件。想来不是奥林匹斯众神最骄傲的时刻吧。"
    }
    {
      Id = "Nemesis_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对这件事观感还不够差的话，随时欢迎来问我，复仇是不是他应得的。"
    }
    {
      Id = "Melinoe_3605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "涅，别忘了他是个叛徒。"
    }
    {
      Id = "Nemesis_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以奥林匹斯众神现在得对付提丰了，是么？不知道克洛诺斯是和他做了交易，还是仅仅把他唤醒然后放了。无论如何，这样的计划需要相当的胆识。"
    }
    {
      Id = "Melinoe_3927"
      InheritFrom = "BaseNarrative"
      DisplayName = "你听起来很欣赏他嘛！我相信如果你告诉克洛诺斯你的真实感受的话，他一定会张开双臂欢迎你加入他的阵营。"
    }
    {
      Id = "Nemesis_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "触到痛处了？行吧。说与不说，敌人这次智谋胜过了我们，事实就摆在那里。所以，你就别浪费时间往地表跑了……等等，你不会想要跟那个东西{#Emph}打一场{#Prev}吧？"
    }
    {
      Id = "Melinoe_3928"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的以为我会弃我的家人于不顾，让他们独自在奥林匹斯山上面对那个魔物？那你根本就不了解我。"
    }
    {
      Id = "Nemesis_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你要是回不来，那就更没机会了解了。"
    }
    {
      Id = "Melinoe_3929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那还真是遗憾。"
    }
    {
      Id = "Nemesis_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定有不少人帮你，才能让提丰从山上滚下去。哦，我们都听说了。你有十几个亲戚都在那边，有的还很强大。不知道他们还要你去干啥？"
    }
    {
      Id = "Melinoe_4422"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们确实很有能力，但现在都撤入了奥林匹斯山的一角固守。最重要的是我们最近这场仗打赢了，而我也尽了我的一份力，确保计划得以顺利执行。"
    }
    {
      Id = "Nemesis_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是想让出功劳，还是想让我别找你的麻烦？反正你能赢的主要原因，是那个魔物活该。不过，一报还一报，你就等着瞧吧。"
    }
    {
      Id = "Melinoe_4423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这话是什么意思？"
    }
    {
      Id = "Nemesis_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你会明白的。"
    }
    {
      Id = "Nemesis_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "你准是把提丰气坏了。这不是你唯一的目的，对吧？还是说，你太沉醉于荣耀之中，忘记了我们真正的敌人是谁？"
    }
    {
      Id = "Melinoe_4426"
      InheritFrom = "BaseNarrative"
      DisplayName = "众魔之父是个迫在眉睫的威胁；如果你亲眼见过他，你就会明白了。如果奥林匹斯山被他毁灭，那么克洛诺斯就会胜利。到那时候，我们就再也拿他没办法了。"
    }
    {
      Id = "Nemesis_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "拿他没办法的是你。冥界本来就不需要那些神。要不是他们，克洛诺斯现在也不会坐在那里。"
    }
    {
      Id = "Melinoe_4427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感谢命运三女神，我们还有你对付他。"
    }
    {
      Id = "Nemesis_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感谢命运三女神。"
    }
    {
      Id = "Nemesis_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在炼金釜旁边折腾了这么久，可算是给这里带来了一些变化。之前净看你在那瞎忙活……"
    }
    {
      Id = "Melinoe_0691"
      InheritFrom = "BaseNarrative"
      DisplayName = "巫术通常是对自身的修炼，而这样的成果往往不会立即显现。不过，你注意到了这些，我很开心。"
    }
    {
      Id = "Nemesis_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，好吧……"
    }
    {
      Id = "Melinoe_3235"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么我再也没有在训练场见到过你了？以前你总是把心头的愤懑都宣泄在那里，但现在就好像你把怒火都留给了{#Emph}我{#Prev}似的。"
    }
    {
      Id = "Nemesis_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "别太把自己当回事了。我是把怒火留给{#Emph}克洛诺斯{#Prev}。而且你没注意到的话，训练场越来越像是为你量身打造的了。从那个祭坛，到武器陈列，都是这样。"
    }
    {
      Id = "Melinoe_3236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "因为只有我在用啊……"
    }
    {
      Id = "Nemesis_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我需要个人空间。"
    }
    {
      Id = "Melinoe_1564"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯，你曾经在地表待了那么久……那里一定有什么值得你久留的事物吧？"
    }
    {
      Id = "Nemesis_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，当然。凡人最喜欢自命不凡，把自己奉若神明。我会把他们揪出来，然后让他们认清自己的位置。"
    }
    {
      Id = "Melinoe_1565"
      InheritFrom = "BaseNarrative"
      DisplayName = "认清自己的位置……我猜是通过各种独出心裁的惩戒手段实现的咯？"
    }
    {
      Id = "Nemesis_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。我们都该得到我们应得的东西：分毫不多，分毫不少。"
    }
    {
      Id = "Melinoe_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "但凡人不是应该有自己的方式，确保正义得到执行吗？就像我父亲以前那样？"
    }
    {
      Id = "Nemesis_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈！有是有。"
    }
    {
      Id = "Melinoe_0680"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿。你想念在地表的生活，不是吗？生活在凡人之中之类的。"
    }
    {
      Id = "Nemesis_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，凡人专门有个词，用来称呼蓄意作恶，以及麻木不仁：“邪恶”。我总能察觉到邪恶行径的踪迹。然后我便会追踪到它的源头。不管那源头是谁，我都会让他付出代价。"
    }
    {
      Id = "Melinoe_1566"
      InheritFrom = "BaseNarrative"
      DisplayName = "但现在你被困在了这里，这些邪恶行径也失去了控制……"
    }
    {
      Id = "Nemesis_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想必是愈发猖獗了。"
    }
    {
      Id = "Nemesis_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近在到处分发蜜露。不知道你又在瞎折腾什么。这种奖赏又不是每个人都应得的。"
    }
    {
      Id = "Melinoe_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}应得？{#Prev}你不会又觉得，这种事轮到{#Emph}你{#Prev}来定夺了吧？"
    }
    {
      Id = "Nemesis_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然。你以为我是{#Emph}谁？{#Prev}要是每个人都能凭空得到自己应得的东西，我就没有存在的理由了。"
    }
    {
      Id = "Melinoe_0612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来很糟糕……"
    }
    {
      Id = "Nemesis_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "生活就是这样。"
    }
    {
      Id = "Melinoe_1573"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前那瓶蜜露，我真的不是有意让你不舒服的。只是，你一直是我学习的榜样，而我……我想尽我的一份心意。"
    }
    {
      Id = "Nemesis_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "别惦记那事了。我前一夜找机会尝了尝，不像是下了毒的。所以这事儿就算翻篇了。"
    }
    {
      Id = "Melinoe_1574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还想要么？"
    }
    {
      Id = "Nemesis_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃……"
    }
    {
      Id = "Nemesis_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "缓过劲儿来了，王女殿下？三岔路口一切都好，没什么要汇报的。"
    }
    {
      Id = "Melinoe_2229"
      InheritFrom = "BaseNarrative"
      DisplayName = "能有你在这恪尽职守地站岗放哨，真是我们的幸运，涅墨西斯……！好啦，别装了。你那边出什么事了，你是什么时候回来的？"
    }
    {
      Id = "Nemesis_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "我压根不知道你在说什么，而且这也不关你的事。愿命运三女神助{#Emph}你{#Prev}完成{#Emph}你的任务{#Prev}。"
    }
    {
      Id = "Melinoe_2230"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有你想的那么容易，是不是？想不到堂堂报应化身居然会这么心高气傲，不知道自己的斤两呢。"
    }
    {
      Id = "Nemesis_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "闭嘴。"
    }
    {
      Id = "Melinoe_2231"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师知道你在外面闯荡的事情了吗？据我所知，没什么能逃过她的双眼。"
    }
    {
      Id = "Nemesis_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "强烈建议你管好自己的分内之事。我不是赫卡忒的棋子，而{#Emph}你{#Prev}应该懂得对我感恩。"
    }
    {
      Id = "Melinoe_2232"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么，就因为你让我们全都置身危险之中？我没有要你帮忙，涅墨西斯。"
    }
    {
      Id = "Nemesis_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是因为你太弱。"
    }
    {
      Id = "Melinoe_3230"
      InheritFrom = "BaseNarrative"
      DisplayName = "头几次在外面碰上你时，我以为你只是在发泄心中的不满。但你夜复一夜地外出。你的决心很坚定，但我担心你早晚会被抓到。"
    }
    {
      Id = "Nemesis_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "没人打小报告就不会。何况，赫卡忒很可能已经知道了。她又不蠢。她只是想让我尝到点苦头，好学到点教训。虽然我不知道她想让我学到什么，但我没意见。"
    }
    {
      Id = "Melinoe_3231"
      InheritFrom = "BaseNarrative"
      DisplayName = "好。我觉得我们其实都学到了很多。但我得说清楚，不管你有多努力想要达成我的任务目标，我都没有任何将其拱手让人的打算。"
    }
    {
      Id = "Nemesis_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "反正总得有人去做。"
    }
    {
      Id = "Nemesis_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "冒失成那样，就为了一点小小的赌注。这么想压我一头么？"
    }
    {
      Id = "Melinoe_2233"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也可以反过来问你。你怎么这么快就回来了？一定是之后也没走多远吧。"
    }
    {
      Id = "Nemesis_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。我也冒失了……"
    }
    {
      Id = "Nemesis_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "邪眼在你那派上了些用场啊。有谁逼你提前结束一夜，下一晚你就能对他们做同样的事。是个老传统，但屡试不爽。"
    }
    {
      Id = "Melinoe_4462"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你的礼物。在一些我最终胜出的对决中，确实是邪眼起到了关键作用。不过，我究竟是在代表正义制裁他们，还是说仅仅是在报仇雪恨，有的时候我也说不清楚。"
    }
    {
      Id = "Nemesis_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "分清楚何谓正义，何谓复仇，确实需要费些功夫。不过，别在这种事情上把自己绕进去了。你做得没问题。"
    }
    {
      Id = "Melinoe_4463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也就是说我都分清楚了？"
    }
    {
      Id = "Nemesis_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "应该是的。"
    }
    {
      Id = "Nemesis_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "你比纳西索斯还要自恋。我看到训练场里你的那些雕像了。要想变成那副模样，你还得练上好些时日。"
    }
    {
      Id = "Melinoe_4464"
      InheritFrom = "BaseNarrative"
      DisplayName = "不、不是……那些雕像和我一点关系都没有。唔，我是赢得了它们没错，它们是献给“黑夜战将”的“帷幕之礼”！呃，这样听起来是有点自恋……"
    }
    {
      Id = "Nemesis_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "别紧张。话说回来，那些雕像还挺像那么回事。我以前总说，你绝对不可能比我还壮。这就是我的报应。"
    }
    {
      Id = "Melinoe_4465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "因果循环……"
    }
    {
      Id = "Nemesis_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么显眼的王座，放在我的岗位旁边是什么意思。诱惑我么。从来没见{#Emph}你{#Prev}在任务中坐下休息；你见过我这样吗？"
    }
    {
      Id = "Melinoe_4458"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有，我只是……我觉得也许你会喜欢至少有这么个选择。这又不是什么过分的东西，对吧？而且你{#Emph}确实{#Prev}站得太久了。"
    }
    {
      Id = "Nemesis_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "规矩是我定的，不是你。我一坐下，就不想站起来了。尤其是穿着{#Emph}这么一身{#Prev}盔甲。何况，“站岗”这个词，{#Emph}“站”{#Prev}字占了一半。"
    }
    {
      Id = "Melinoe_4459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你想的话，我也可以叫人把王座搬走。"
    }
    {
      Id = "Nemesis_0341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "先放着吧。"
    }
    {
      Id = "Melinoe_4447"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在外面相遇的时候，感觉就像是一场梦一样。尤其是我们把所有的责任都丢在了一旁，完全不像你我一贯的作风……"
    }
    {
      Id = "Nemesis_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "意思是你后悔了。行吧。我不后悔。又不是养成习惯了，更何况……把你从我脑海里赶出去了。正合我意。"
    }
    {
      Id = "Melinoe_4448"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？对我来说完全不一样。从那之后，你在我脑海里出现得反而越来越频繁了。而且我也不后悔！"
    }
    {
      Id = "Nemesis_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "不后悔么？好吧，总之，报应是这样的。有的人会赢，有的人会输，没有人能独吞一切。不过，也许以后我们可以……平衡一下。我们之间这码事，不该这样一边倒。"
    }
    {
      Id = "Melinoe_4449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一言为定。"
    }
    {
      Id = "Nemesis_0329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一言为定。"
    }
    {
      Id = "Melinoe_4450"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅，我们在外面相遇那次……我想确定你没有在生我的气。至少没有比平常更生气。你说我在让你分心；这不是我所希望的。"
    }
    {
      Id = "Nemesis_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道。没关系。我们没事。除非你打算翻来覆去地说。我觉得现在我们理解彼此了，而你和我都喜欢像这样心照不宣。总之，外面见。"
    }
    {
      Id = "Melinoe_4451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "外面见。"
    }
    {
      Id = "Nemesis_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么时候开始的。以前，你都不愿正眼看我。我也受不了你，一副怂样。然后一切都变了。我想搞清楚具体的时间点。"
    }
    {
      Id = "Melinoe_4452"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你的感情，是随着时间渐渐增长的。你在我心头激起的那种愤怒……我渐渐喜欢上了那种感觉。我只是从没想过你会有所回应。"
    }
    {
      Id = "Nemesis_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "本来以为你是个花架子。从来没意识到你有多强壮，而且不止是身体上。以及，现在的你知道适可而止了。"
    }
    {
      Id = "Melinoe_4453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是在夸我耶。"
    }
    {
      Id = "Nemesis_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是。"
    }
    {
      Id = "Melinoe_4471"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，涅，有时候我能读出你的想法，而现在有事情在困扰着你。所以说吧，怎么了？如果你愿意和我说的话……"
    }
    {
      Id = "Nemesis_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，这……听着，我从没有跟人保持过长久的亲密关系。就这么回事。所以，我在想我们之间会怎么发展，然后发现会走向一个我不喜欢的结局。"
    }
    {
      Id = "Melinoe_4472"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的认为，我们未来的走向是已经定死的吗？命运三女神虽然是你的姐姐，但你也不用非得让自己陷入什么自我实现的预言中啊。"
    }
    {
      Id = "Nemesis_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，但是……问题是，比起独处，我开始更喜欢和你待在一起了。如果发展下去的话，就会……"
    }
    {
      Id = "Melinoe_4473"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我知道。好事太多，就会遭报应。不过，我们一定要一直担心未来的事情吗？好好珍惜能待在一起的时间就好。不用给自己太多压力啦。"
    }
    {
      Id = "Nemesis_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "……不用给自己太多压力，是么……也许你说得对。我总能找到达成平衡，又不至于把一切搞砸的办法。"
    }
    {
      Id = "Melinoe_4474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "值得一试。"
    }
    {
      Id = "Nemesis_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，你跟厄里斯是怎么回事？还以为你足够理智，知道跟她保持距离，至少在你有选择的时候。"
    }
    {
      Id = "Melinoe_4454"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许在选择伙伴这件事上，我的判断力不太够用，涅墨西斯。她和我没有多少共同点，可是……和她相处的时候，我很难保持理智。"
    }
    {
      Id = "Nemesis_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，关于她的事，你会承担后果的。我的事也一样，但方式不同。也许这就是吸引人的地方吧。总之，别把她带过来就好。"
    }
    {
      Id = "Melinoe_4455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没这个打算啦。"
    }
    {
      Id = "Nemesis_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和毁灭处得不错，也在情理之中。起初我以为他会让你望而却步，就和其他人的反应一样，但你们两个都太喜欢服从命令了。想必你们有很多共同点。"
    }
    {
      Id = "Melinoe_4456"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和他应该从来没有在一起讨论过我们有多喜欢服从命令的事，不过我们确实相处得不错。这不会给你带来困扰吧？如果会的话，你会和我直说的。"
    }
    {
      Id = "Nemesis_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果会的话，我会和你直说的。摩罗斯从来都不是那种高高兴兴的人；严格说来我们都不是。不过，他过得好的话，估计对其他人来说也是件好事。毕竟他牵扯到的人很多。"
    }
    {
      Id = "Melinoe_4457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他看起来比之前更高兴了吗？"
    }
    {
      Id = "Nemesis_0338"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许只是我这么觉得。"
    }
    {
      Id = "Nemesis_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们说你彻底消灭了提丰。我一个字都不相信。到底发生了什么？"
    }
    {
      Id = "Melinoe_5006"
      InheritFrom = "BaseNarrative"
      DisplayName = "“彻底消灭了提丰”确实是种简明扼要的说法。过程涉及了一道名叫“魔物解离”的复杂咒语，以及其他最好不要明说的细节。总之，是的，我相信他已经不在了。"
    }
    {
      Id = "Nemesis_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是不死不灭之身……他不会就这么“不在了”的，要真是这样，为什么不对克洛诺斯做一样的事？或者对任何烦你太久的人？"
    }
    {
      Id = "Melinoe_5007"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于克洛诺斯我们另有打算。至于其他人，暂时还没有任何人烦我那么久啦。"
    }
    {
      Id = "Nemesis_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "暂时？呵。"
    }
    {
      Id = "Melinoe_5008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道老师出事了吗？克洛诺斯就在我眼前把她抓走了！要是你没有擅离岗位的话，她……{#Emph}唉！"
    }
    {
      Id = "Nemesis_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说什么，{#Emph}克洛诺斯把她抓走了。{#Prev}昨晚才见过她。不过，她现在在哪……？"
    }
    {
      Id = "Melinoe_5009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我刚说过了！{#Prev}她可能在冥府里，和其他人关在一起，但是我……我还没能定位到她。这种事情怎么可能发生，我们本来能做些什么？"
    }
    {
      Id = "Nemesis_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是认真的。等等，就在你眼前发生，你怎么不做些什么？{#Emph}我都不在场！"
    }
    {
      Id = "Melinoe_5010"
      InheritFrom = "BaseNarrative"
      DisplayName = "我太迟了！你又有什么借口？至少你该意识到这样的威胁有出现的可能！"
    }
    {
      Id = "Nemesis_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "连俯瞰一切的塞勒涅都没预料到，凭什么{#Emph}我{#Prev}能？不过……不要声张。去把她找回来，不然我就去。"
    }
    {
      Id = "Melinoe_5011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会的。"
    }
    {
      Id = "Nemesis_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "终于从你父亲的冥府回来了。赫卡忒没事吧？她被泰坦抓走之后，我……我该对站岗更上心一些，而且……我不会很快原谅自己。就是这样。"
    }
    {
      Id = "Melinoe_5012"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师只会希望你能学到教训。我现在有点怀疑，她会不会是故意被抓走，以此更接近我们的目标。也许你该去找她谈谈……？"
    }
    {
      Id = "Nemesis_0408"
      InheritFrom = "BaseNarrative"
