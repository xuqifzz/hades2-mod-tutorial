    }
    {
      Id = "Nemesis_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "不见得。修普诺斯先前是在冥府，在我妈的照料下工作。不过我时不时会撞见他。他什么时候醒来的话，希望在你们两个终于见面时，我能在场。"
    }
    {
      Id = "Melinoe_0682_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你，涅……"
    }
    {
      Id = "Hecate_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要擅自离开你的岗位，涅墨西斯。还是说，难道你已经像你妹妹一样，到了要公开与我作对的地步？我真不敢想象，你们的母亲见到你们这副样子，会怎么教育你们。"
    }
    {
      Id = "Nemesis_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你没资格拿我妈的名号在这狐假虎威。要是你当初有好好尽到身为侍女的责任，警告她冥府即将遇袭，这一切根本就不会发生。"
    }
    {
      Id = "Hecate_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说话最好掂量掂量，省得我亲自封住你的嘴！你大可以继续执着于过往，哪怕你根本没有亲眼目睹当时的情况，或者你也可以尽倪克斯的子女该尽的责任。又或者你要去找厄里斯，我也不拦着你！随你怎么选。"
    }
    {
      Id = "Nemesis_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}（叹气）"
    }
    {
      Id = "Hecate_0868"
      InheritFrom = "BaseNarrative"
      DisplayName = "……不服管教、不负责任、谎话连篇、仗势欺人、顽固不化，还给暗灵树立坏的榜样……你看，还有什么要补充的么？"
    }
    {
      Id = "Nemesis_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "……懒散怠惰、薄情寡义、玩忽职守。赫卡忒，我……老师，我接受你的审判，我的行为没有任何借口。"
    }
    {
      Id = "Hecate_0869"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢命运，至少你还愿意承认。那么，现在，既然倪克斯已经回来了，我也该让她把你接走了。冥府肯定用得上更多帮手？"
    }
    {
      Id = "Nemesis_0418"
