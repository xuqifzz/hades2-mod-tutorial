      Id = "Scylla_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "你肯定都不认识，这点我很确定！而且，最近发生那么多变故，这个场地已经不打算安排新的演出了。所以别指望看到别人了！你永远都只能看{#Emph}我{#Prev}。我和姐妹们的演出。"
    }
    {
      Id = "Scylla_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}打住！{#Prev}什么都别说，女士，在演出中说话是很不礼貌的，你不知道么！反正我听{#Emph}你{#Prev}说话也听够了！不过，你肯定还没{#Emph}听够{#Prev}我们吧。"
    }
    {
      Id = "Scylla_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "看呐，姐妹们！我们有观众了！来，让观众体验一下{#Emph}爽到死{#Prev}的感觉，好不好？"
    }
    {
      Id = "Scylla_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，好了，姐妹们，大的要来了！这就是我们{#Emph}一炮走红{#Prev}的机会！就是现在！！"
    }
    {
      Id = "Scylla_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哦{#Prev}，这位女士，又见面了！我们一直在{#Emph}排练{#Prev}呢！想听听我们最新的单曲吗？"
    }
    {
      Id = "Scylla_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}最喜欢{#Prev}精彩的演出了，对不对，这位女士？而我们{#Emph}最喜欢{#Prev}让观众心满意足！对不对，姐妹们？"
    }
    {
      Id = "Scylla_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就是我们歌曲的魔力，姐妹们！只要{#Emph}听过{#Prev}我们的音乐，就会像被洗脑了一样，想忘也忘不掉……！"
    }
    {
      Id = "Scylla_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真是{#Emph}知难而上{#Prev}呢，这位女士。我们也一样！姐妹们，音乐，起！"
    }
    {
      Id = "Scylla_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到了吗，姐妹们？要是我们的歌没有魅力的话，她就不会一次次跑回来了，对不对？"
    }
    {
      Id = "Scylla_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "这位女士，我们还在练习最新的单曲呢！所以你来得{#Emph}正好{#Prev}哦。"
    }
    {
      Id = "Scylla_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "这位女士，来和我们一起创造{#Emph}迷人的音乐{#Prev}吧！肯定比{#Emph}你{#Prev}在做的事情有价值多了。"
    }
    {
      Id = "Scylla_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真该听一听我们的{#Emph}经典曲目{#Prev}，哈哈！哦，不过首先，是我们{#Emph}最新的热门单曲……"
    }
    {
      Id = "Scylla_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我们通常不办私人演唱会的啦……但是，为了你，我们{#Emph}什么都{#Prev}做得出来哦……"
    }
    {
      Id = "Scylla_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "下一首歌献给我们的{#Emph}所有粉丝{#Prev}！尤其是{#Emph}你{#Prev}哦。"
    }
    {
      Id = "Scylla_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在，这位女士，让音乐{#Emph}充满你的灵魂{#Prev}，海水{#Emph}灌满你的肺部{#Emph}吧！"
    }
    {
      Id = "Scylla_0049"
      InheritFrom = "BaseNarrative"
