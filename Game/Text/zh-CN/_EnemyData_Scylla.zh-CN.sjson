    {
      Id = "Scylla_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}老掉牙的曲子……？{#Prev}听见了吗，姐妹们？我觉得她是想说我们{#Emph}最经典的曲目{#Prev}，或者是{#Emph}最热门的单曲{#Emph}，你们说对不对？呵！女士啊，你不明白，观众喜欢的，就是最好的！"
    }
    {
      Id = "Scylla_0309"
