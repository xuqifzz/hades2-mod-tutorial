    }
    {
      Id = "Scylla_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}晚上好，俄刻阿诺斯！！{#Prev}大家今晚过得怎么样？你们准备好来一场{#Emph}演出{#Prev}了吗？"
    }
    {
      Id = "Scylla_0051"
