    }
    {
      Id = "MelinoeField_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "整个世界清静了。"
    }
    {
      Id = "MelinoeField_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我讨厌她。"
    }
    {
      Id = "MelinoeField_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再练练吧！"
    }
    {
      Id = "MelinoeField_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你倒是唱啊……"
    }
    {
      Id = "MelinoeField_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是报上一晚的仇。"
    }
    {
      Id = "Scylla_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，{#Emph}吼吼吼{#Prev}，难以置信！{#Emph}难以置信。{#Prev}看呐，姐妹们，来了位{#Emph}女士{#Prev}耶！从来没有女士来看过我们的演出，你一定是与众不同，你叫什么名字？哦，快坐好，我们正准备开始呢，对不对，姐妹们？"
    }
    {
      Id = "Melinoe_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "……塞壬。我早该知道，那些歌声的源头是你们。所以说，你们现在是在冥界安家了？"
    }
    {
      Id = "Scylla_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的压力刚刚好！不用在粉丝们的注视和苦苦哀求中创作，那样压力太大了。{#Emph}“斯库拉，你的下一首歌什么时候出呀？！”"
    }
    {
      Id = "Melinoe_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些所谓的“粉丝”，不是都被你们拖入海底淹死了吗？现在恐怕一个都不剩了吧？"
    }
    {
      Id = "Scylla_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "不许你说我{#Emph}粉丝{#Prev}的坏话！喂，姐妹们……？不如我们给她来一首经典曲目，你们说呢？"
    }
    {
      Id = "Scylla_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "准备好享受一场吧，女士！有一位光荣的赞助商让我们的梦想统统成真了：一个{#Emph}全新的{#Prev}舞台，以及……一次与这片海域名字{#Emph}最响亮{#Prev}的生物合作的机会！"
    }
    {
      Id = "MelinoeField_3538"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡律布狄斯要跟你们一起登台演出……？这不是什么赞助商的作为，这是黑夜的意志。随着恐惧蔓延，噩梦会化作现实……看起来这次是我的噩梦化作现实了。"
    }
    {
      Id = "Scylla_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "随你怎么说我们赞助商的坏话，他可是很有品味的人，而你，一点品味都没有！多亏了他，我们准备首次演出我们的新单曲，而你无论做什么都阻止不了我们……！至少阻止不了第一段。"
    }
    {
      Id = "Scylla_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "又来黑我们了吗，女士？{#Emph}没用的啦！{#Prev}不管你做什么，观众都会以为是演出的一部分。他们来这里不是仅仅为了欣赏音乐，而是为了{#Emph}全套体验！"
    }
    {
      Id = "MelinoeField_3539"
      InheritFrom = "BaseNarrative"
      DisplayName = "看着你和你的乐队一遍遍地惨遭毒打，就是你所谓的“全套体验”吗？你们这些艺术家真是在为艺术献身啊。"
    }
    {
      Id = "Scylla_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错！我为了我的演艺生涯，为了{#Emph}这个舞台{#Prev}，为了{#Emph}这一刻{#Prev}，可谓{#Emph}付出了一切！{#Prev}而且我已经准备好付出更多……{#Emph}你{#Prev}有同样的觉悟吗？！"
    }
    {
      Id = "Scylla_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "如你所见，我们又回到以前的小舞台了，不过我相信只是这一夜而已！我们的赞助商一定会出手相救，把我们放到真正{#Emph}属于我们{#Prev}的{#Emph}聚光灯{#Prev}下的，嗯！早晚会的！"
    }
    {
      Id = "MelinoeField_3540"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到底觉得这个神秘的赞助商是什么人，能决定我们起冲突的地点，还能决定可怕的卡律布狄斯会不会作为特邀嘉宾登场？"
    }
    {
      Id = "Scylla_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "别想骗我说出口，女士。舞台，你可以闯；风格，你可以抄；粉丝，你想要也可以来抢！但要夺走我们的{#Emph}赞助商{#Prev}，简直是痴心妄想！！"
    }
    {
      Id = "Scylla_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候我们喜欢回到这个小场地表演，重温旧日时光！很多粉丝都希望我们不要忘本。"
    }
    {
      Id = "MelinoeField_3541"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以他们让你们干什么，你们就干什么？把自己的想法强加给你们，听起来不像是粉丝会做的事啊。"
    }
    {
      Id = "Scylla_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你这话一说出口，我就知道你连半个粉丝都没有过。我们能站在这里，全是因为观众们喜欢听我们的歌。所以这其实是一种双向奔赴：我们付出音乐，而水手们付出生命！{#Emph}你也一样！"
    }
    {
      Id = "Scylla_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就是我们{#Emph}期待已久{#Prev}的大场面！我早就跟姐妹们说过，很快我们就能重新站上大舞台，回到聚光灯之下。哦，只可惜我们名气越大……吸引来的{#Emph}黑粉{#Prev}也就越多……"
    }
    {
      Id = "MelinoeField_3542"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你们现在是打算把黑粉和粉丝一起淹死吗？如果是这样的话，黑粉怎么还会越来越多呢？"
    }
    {
      Id = "Scylla_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "这种事就用不着你的小脑瓜操心了，女士！你有更大的麻烦要解决，比如我们的特邀嘉宾……它还碰巧很擅长一下子淹死很多黑粉。"
    }
    {
      Id = "Scylla_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚真是人声鼎沸呢，女士！我们不是每次都有这么多观众的，虽然按我们的水准，来再多的观众也不为过啦！不过话又说回来，按我们现在这种阵仗，吸引到一些路人粉也是在所难免的！"
    }
    {
      Id = "MelinoeField_3543"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥界的暗灵没那么有空，没办法夜夜都来给你们的演唱会捧场，斯库拉。再说了，你就那么几首歌，都不够唱的。"
    }
    {
      Id = "Scylla_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又知道了？！我们喜欢唱最红的那几首，但我们的歌还多着去呢！想必你都没有听过吧，毕竟你是我们{#Emph}最路人的路人粉{#Prev}了！"
    }
    {
      Id = "MelinoeField_3544"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，有了上次那个大场面之后，斯库拉与塞壬乐队下一步打算怎么发展？找个更大的场地？写些更好听的歌？"
    }
    {
      Id = "Scylla_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "更大的场地，{#Emph}有可能！{#Prev}更好听的歌，{#Emph}绝无可能。{#Prev}因为我们的音乐已经是{#Emph}最顶级{#Prev}的了！我们真的想的话，随时可以写更多，嘿嘿！不过现在，我和姐妹们的{#Emph}胃口{#Prev}可不止于此……"
    }
    {
      Id = "Scylla_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡律布狄斯今晚没能出席，真是太可惜了，女士！她本来应该要到场的。估计是回到了海面上，大吃大喝去了吧！"
    }
    {
