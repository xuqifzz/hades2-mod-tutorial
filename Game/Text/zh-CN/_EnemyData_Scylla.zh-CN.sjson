    }
    {
      Id = "Scylla_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们的{#Emph}作品{#Prev}就是最有力的{#Emph}语言{#Prev}！此外，我不仅仅是主唱，还是她们的经纪人！她们两个现在恕不接受采访哦，尤其是不接受来自{#Emph}你这种家伙{#Prev}的！"
    }
    {
      Id = "Scylla_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前有天晚上，我跟姐妹们开会的时候聊了聊——{#Emph}主要是我在聊啦{#Prev}，但我们不禁好奇，你到底是来{#Emph}干什么{#Prev}的？杰蒂觉得你有可能是个{#Emph}探子？"
    }
    {
      Id = "MelinoeField_2556"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来杰蒂很有洞察力……因为我确实是黑夜的密探。冥界落入了泰坦之手；我们要为真正的冥界之主恢复地位。无论是谁挡在我们面前。"
    }
    {
      Id = "Scylla_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "不敢相信耶，杰蒂，居然被你{#Emph}说中了？！{#Prev}是星探找上门来了！那你不用再找了， 星探女士，因为无论在海里还是海外，你都找不到更有才华的歌星啦！{#Emph}看好了！"
    }
    {
      Id = "Scylla_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "你其实不是什么星探，对吧，女士？只是想拿我们寻开心，想让我们心怀希望，再让我们狠狠撞到礁石上！你怎么能这么{#Emph}恶毒！"
    }
    {
      Id = "MelinoeField_2557"
      InheritFrom = "BaseNarrative"
      DisplayName = "让你们心怀希望？听好了，我要找的人是{#Emph}克洛诺斯{#Prev}，不是你们。不过，也许有别的探子会对你们感兴趣吧。"
    }
    {
      Id = "Scylla_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，姐妹们！就连{#Emph}这位{#Prev}女士都能看得出来——都能{#Emph}听{#Prev}得出来，我们是冉冉升起的新星！你一定会为我们多美言几句的，{#Emph}对不对？"
