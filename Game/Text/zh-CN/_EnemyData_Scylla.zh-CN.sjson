      Id = "Scylla_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "我{#Emph}才不是{#Prev}什么刺甲贝！你把那句话咽回去！我要{#Emph}逼你{#Prev}把那句话咽回去！"
    }
    {
      Id = "Melinoe_2038"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，听我说！我上次不是有意要冒犯你的，而且我也从来没说过你是刺甲贝。你要发脾气的话，至少也找个真实存在的理由吧。"
    }
    {
      Id = "Scylla_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "听听，姐妹们，她还在拿刺甲贝说事呢，简直没完了！取笑我的小贝壳，嗯，{#Emph}哼哼{#Prev}！那就让她见识见识，在{#Emph}我们{#Prev}的地盘上，黑粉会有什么样的下场！"
    }
    {
      Id = "Scylla_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}吼吼{#Prev}，这位女士又见到我们，好像很惊讶啊？我们哪儿都不会去呢。毕竟，这可是我们的{#Emph}复出巡演{#Prev}！"
    }
    {
      Id = "Melinoe_2042"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为上次已经把你们解决了，结果你们还在这里。非得让我把你们赶回大海不可吗？"
    }
    {
      Id = "Scylla_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，那可不好说哦。非得让杰蒂和罗茜在演出中{#Emph}倾注{#Prev}全部心血吗？用不着！因为她们本来就会这样做！{#Emph}对不对{#Prev}，姐妹们？"
    }
    {
      Id = "Scylla_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，你一直想要{#Emph}杀掉{#Prev}我哎，这位女士！我从前海洋宁芙的那一面总对我说，我要{#Emph}忘掉这码事{#Prev}，让它随波而去！但是，我现在不喜欢再听从她的声音了。"
    }
    {
      Id = "MelinoeField_2018"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不再听从自己的声音，那就难怪了。我知道海洋宁芙是杀不死的。我只是需要你们让开条路。"
    }
    {
      Id = "Scylla_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "听到了吗姐妹们？我好像听到这位女士说她{#Emph}需要我们{#Prev}耶，嚯嚯！我们的艺术真的可以改变人们的生命！不如我们现在就把{#Emph}她的生命{#Prev}改变一下吧……？"
    }
    {
      Id = "Scylla_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看是谁啊，今晚的演出来得这么早！这位女士，大门这时候压根就不该打开呢！虽然我们也没指望{#Emph}你{#Prev}遵守这些非常合理的公共礼仪啦。"
    }
    {
      Id = "MelinoeField_2718"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我现在对表演场地已经很熟悉了。至于演出，如果你们还没准备好的话，那就太好了！因为我其实根本不想听。"
    }
    {
      Id = "Scylla_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，那{#Emph}算你倒霉{#Prev}！你是来得很早没错，但恰恰好赶上了{#Emph}私人专场预热演出{#Prev}，马上就要开始了哟！"
    }
    {
      Id = "Scylla_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，这位女士，我想请问，你{#Emph}究竟{#Prev}是怎么对我们每个把戏都了如指掌的？当然，我知道我们一直在排练同一幕啦。可是一般来说这样的演出早就杀疯了！"
    }
    {
      Id = "Melinoe_2041"
      InheritFrom = "BaseNarrative"
      DisplayName = "足智多谋的奥德修斯让我替他打个招呼。他跟我说过你们的全部事迹。你之前说一旦被你抓住就永远逃不掉，但据{#Emph}我{#Prev}所知，他的水手除了六个不幸的家伙外，其他全都从你手上逃掉了。"
    }
    {
      Id = "Scylla_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}奥德修斯，哈！{#Prev}哦，他还咬着钩呢！{#Emph}“放长线才能钓大鱼”{#Prev}，他大概也会这么说吧。我们的歌谣一定还在他的{#Emph}小小脑袋{#Prev}里回响呢！而现在，轮到你咯……"
    }
    {
      Id = "Scylla_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都知道你为什么一次次来到这里，不是么，女士？你就跟奥德修斯，以及其他人一样！不过……他说的什么{#Emph}冥界王女{#Prev}，又是怎么回事？"
    }
    {
      Id = "MelinoeField_3584"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在你已经不需要操心那个了。所以，你觉得我一次次回到这里，是因为我喜欢你们的音乐？那我为什么不找个地方坐下来好好听，非要和你们大打出手？"
    }
    {
      Id = "Scylla_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "现场音乐重在互动。光是坐着听可不行！你应该把自己沉浸其中……彻底{#Emph}淹没{#Prev}在现场的氛围里，哈哈！而你这样做的次数，比在场的其他人都多哦。"
    }
    {
      Id = "MelinoeField_4354"
      InheritFrom = "BaseNarrative"
      DisplayName = "斯库拉，你介意跟一个我们都认识的人联系一下吗？只会占用你一点点时间。{#Emph}奥德修斯，聆听我的呼唤；你求见之人，就在我的身畔！"
    }
    {
      Id = "Scylla_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就知道你会回来，水手。只要听过我们的歌，就没有人不回来的！除非淹死了，但是还有人就算淹死了也要回来呢。啊，总得再听一次才行，是吧？"
    }
    {
      Id = "Odysseus_0567"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，斯库拉，你们的塞壬之歌，让凡间的我印象极为深刻！我再也不想假装不是这么回事了。"
    }
    {
      Id = "Scylla_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，既然你要听，那就请吧！我们老粉丝的愿望，就算豁出去了也要满足。你以前的船员，应该有好多都已经坐在观众席上了！被我夺走的那些。"
    }
    {
      Id = "Odysseus_0568"
      InheritFrom = "BaseNarrative"
      DisplayName = "当时我们别无选择，只能乘船远离你们，而且有很多好人为此献出了生命。但现在，至少冥界王女能为他们带来一场值得铭记的演出！"
    }
    {
      Id = "Scylla_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥界王女……你是说这位女士？哈！你一直都是那种喜欢耍阴谋诡计的家伙，一点儿都没有变啊。那么，你们都竖起耳朵听好了……"
    }
    {
      Id = "MelinoeField_4355"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得有位水手可能想再跟你说两句！{#Emph}奥德修斯，聆听我的呼唤；你求见之人，就在我的身畔！"
    }
    {
      Id = "Scylla_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次的演出怎么样啊，奥德修斯，和你记忆中一样好吗？既然你{#Emph}又{#Prev}回来了，那就肯定是了。不过，恐怕你也没什么选择的余地啦！"
    }
    {
      Id = "Odysseus_0569"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来这里是因为冥界王女召唤了我，斯库拉。不过，能再次听到你的音乐，也未尝不是一件美事。我不想耽误你们的演出，所以我就在观众席坐着了，好么？"
    }
    {
      Id = "Scylla_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，那就去吧，呵。我们可不想人人都冲到台上来！更别说这个{#Emph}冥界王女{#Prev}在的时候了，她把聚光灯都抢走了！"
    }
    {
      Id = "MelinoeField_3590"
      InheritFrom = "BaseNarrative"
      DisplayName = "不介意我问的话，你变成这个样子是拜谁所赐，斯库拉？因为，我没理解错的话，你不是一直都……这副模样。"
    }
    {
      Id = "Scylla_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦吼，完全是拜我自己所赐呢，谢谢你，女士！你以为我会把才华归功给别人吗？比如有个{#Emph}年迈的音乐大师{#Prev}把我收做关门弟子，之类的吗？"
    }
    {
      Id = "MelinoeField_3591"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的音乐才华是与生俱来的，这点我并不怀疑；我是想问你是怎么变成海怪的。你受到了个诅咒，对吧？"
    }
    {
      Id = "Scylla_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈！哦，你是不会懂的，人越是出名，绯闻就越多！就因为别人{#Emph}嫉妒{#Prev}，仅此而已！这些流言蜚语都无法穿透我坚实的外壳。没有哪个有才华的艺术家，会因为几句恶语中伤而停下脚步！"
    }
    {
      Id = "MelinoeField_3592"
      InheritFrom = "BaseNarrative"
      DisplayName = "你认识巫术师喀耳刻么？她曾经说起来过，她小时候跟你有交集……不过，我不确定你们关系怎么样。"
    }
    {
      Id = "Scylla_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}巫术师{#Prev}喀耳刻，抱歉，没听说过！我只认识一个喀耳刻，她毫无才华，可怜兮兮，在赫利俄斯的子女里数得上是最废物的那个！所以，{#Emph}你说的这个{#Prev}喀耳刻，是怎么说我的？"
    }
    {
      Id = "MelinoeField_3593"
      InheritFrom = "BaseNarrative"
      DisplayName = "按她的说法，你声音从小就很嘹亮。也许你那个时候就已经在练歌，为有朝一日的声名鹊起做准备了吧。"
    }
    {
      Id = "Scylla_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直都很清楚自己想要成为什么样的人，女士。这是我的使命！喀耳刻和其他那些人……他们不过是想挡我的路！你也一样。"
    }
    {
      Id = "Scylla_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "哟，这不是那个爱蹭热度的小妹妹嘛！又去见你的好朋友克洛诺斯先生了，嗯？他{#Prev}最爱{#Prev}我们的演出了！这下不得不把你淹死了，免得你夺走我们的赞助！"
    }
    {
      Id = "MelinoeField_2558"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我不是去找他要赞助的。而且我们也{#Emph}不是{#Prev}朋友。我只是有些事要找他解决……而{#Emph}你们{#Prev}每夜都要对此横加阻拦。"
    }
    {
      Id = "Scylla_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}找他有事{#Prev}？那你一定是谁家的小公主吧，光凭你自己是{#Emph}没可能{#Prev}跟他攀上关系的！你知道吗，我们有些人，可是凭{#Emph}实力{#Prev}出道的哦！"
    }
    {
      Id = "Scylla_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "这位女士，我得跟你说清楚喔，你可不能这样{#Emph}夜复一夜{#Prev}地骚扰克洛诺斯先生！他不怎么关注我们的演出，而我们希望事情保持现状。"
    }
    {
      Id = "MelinoeField_2559"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得克洛诺斯一点都不在乎你们。所以，要不就退一步，专心写你们的歌，别一直想着把我淹死了，好么？"
    }
    {
      Id = "Scylla_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，姐妹们，她压根就不明白！不过别担心啦。永远不会有人关停我们的演出，因为我们{#Emph}场场爆满{#Emph}呢！人们都{#Emph}慕名而来！"
    }
    {
      Id = "Scylla_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "到现在，俄刻阿诺斯的每个人都听过我们的名字了，女士！尤其是{#Emph}我{#Prev}的！可惜你这么拼了命地给我们招黑，却只能适得其反！"
    }
    {
      Id = "MelinoeField_3606"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然这样说有抬杠之嫌，但我还真遇到过一个人，对你们的演出毫不在意。他宁愿盯着一池清水出神，也不愿意听你们唱歌。"
    }
    {
      Id = "Scylla_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，众口难调嘛，对吧？要是一味地迎合所有人的话，我们就太没有{#Emph}原则{#Prev}了……说到这个，像{#Emph}你{#Prev}这样的人，恐怕连原则是什么都不知道吧！"
    }
    {
      Id = "Scylla_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "俄刻阿诺斯这一带有许多让人喜欢的地方，你不觉得么？这里的回音海陆两收，堪称完美……而且波塞冬一点儿都管不着！"
    }
    {
      Id = "MelinoeField_3607"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里刚好位于海洋和冥界的交界处，被你们钻了空子。如果你们有朝一日回到波塞冬大人的水域的话，恐怕他不会轻饶你们。"
    }
    {
      Id = "Scylla_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，如果我们回到{#Emph}他的{#Prev}水域的话，那时候我们可是大明星了，谅他也{#Emph}不敢{#Prev}动我们！他也好，别的神也罢！不管我们去哪，都是万众瞩目的焦点。"
    }
    {
      Id = "Scylla_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们以前可是在{#Emph}地表{#Prev}演出的，你知道么！我们就是在那时候火起来的！甚至{#Emph}卡律布狄斯{#Prev}都有几次来为我们暖场热身，你能想象吗？"
    }
    {
      Id = "MelinoeField_2561"
      InheritFrom = "BaseNarrative"
      DisplayName = "那又怎么了？之前那晚卡律布狄斯就帮我热了热身。他甚至一开口就停不下来！"
    }
    {
      Id = "Scylla_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "鬼才信呢！不过我敢打赌，你是从地表来的，是不是？别以为你能和我们这些{#Emph}地下{#Prev}歌手相提并论，你这一辈子都当不成{#Emph}非主流{#Prev}！"
    }
    {
      Id = "MelinoeField_3598"
      InheritFrom = "BaseNarrative"
      DisplayName = "和别人共享聚光灯，听起来不太像是你会做的事啊，斯库拉。如果你一直跟卡律布狄斯这种更大的明星联动，什么时候才能打响自己的名号呢？"
    }
    {
      Id = "Scylla_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡律布狄斯虽然长了张大嘴，但我们以唱功见长。水手们通常都会被夹在我们两个中间，{#Emph}左右为难{#Prev}，所以我们就想……为什么不让他们{#Emph}两者兼得{#Prev}呢？"
    }
    {
      Id = "MelinoeField_3599"
      InheritFrom = "BaseNarrative"
      DisplayName = "而且你们看起来也不像是很容易共事的那种人。但你们却能求同存异，达成一致，不管是为了取悦观众，还是为了阻止我。几乎都要对你们刮目相看了呢。"
    }
    {
      Id = "Scylla_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，虽然这样的话我们经常听到，但这对我们来说还是{#Emph}意义非凡{#Prev}！尤其是出自我们最{#Emph}刻薄{#Prev}的批评家口中！虽然这不会阻止我们一如既往地想要淹死你啦，女士……但还是{#Emph}谢谢你{#Prev}哦。"
    }
    {
      Id = "Scylla_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "有在我们的休息室看到什么喜欢的东西么，嗯？也许你没注意到门口的标语，但那是我们的{#Emph}私人空间{#Prev}，粉丝{#Emph}不得入内{#Prev}哦！"
    }
    {
      Id = "MelinoeField_2554"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们那所谓的{#Emph}休息室{#Prev}好巧不巧，建在了一个排水口上，而那个排水口通往下面的哀悼原野。建议你们把那些破烂作品都倒进那里面冲掉，因为下水道正是它们的归宿。"
    }
    {
      Id = "Scylla_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，你去看我们的{#Emph}作品{#Prev}了啊！就算有些点子没有用上，那又怎样？学不会{#Emph}割舍{#Prev}的话……就没法成就{#Emph}好作品{#Prev}哦。"
    }
    {
      Id = "Scylla_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就接着黑我们吧，女士！我们现在{#Emph}声势浩大{#Prev}，而且鳞片厚得很！{#Emph}“斯库拉唱歌像狗叫！斯库拉那头亮丽的秀发像蛇一样！”{#Prev}什么话我们都听过了！"
    }
    {
      Id = "MelinoeField_4307"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有打算说那些话；听起来都很莫名其妙。也许如果你不要总是惹怒观众，他们对你的评价会更客气一点。"
    }
    {
      Id = "Scylla_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们说的话一点都伤不到我们！至少伤不到{#Emph}我{#Prev}，毕竟我的壳最厚。我在意的只有他们的{#Emph}欢呼{#Prev}和{#Emph}尖叫{#Emph}……听久了就都混在一起，区分不开了……"
    }
    {
      Id = "Scylla_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，原来只是你啊！还以为又是那些水手呢，最近来这里的水手越来越多了。看看这{#Prev}一大群{#Prev}观众！我们真是{#Emph}人气高涨{#Prev}呀！"
    }
    {
      Id = "MelinoeField_2560"
      InheritFrom = "BaseNarrative"
      DisplayName = "说不定那些水手只是克洛诺斯派去攻打众神的船舰被击沉后，落入水中的残兵败将。我最近经常去收拾他们。"
    }
    {
      Id = "Scylla_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这位女士，恕我不能苟同。我们的名声是来自于经典的口口相传！而现在，无论你做什么，都不能阻止我们了！"
    }
    {
      Id = "Scylla_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "这位女士啊，你要知道，罗茜、杰蒂和我……我们三个经历过远比这更大的挫折。就凭你几句恶评，是不会把我们拆散的！"
    }
    {
      Id = "MelinoeField_2555"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道我为什么在这里跟你浪费时间，斯库拉。罗茜和杰蒂也是！你甚至都没让她们两个开过口。"
    }
    {
      Id = "Scylla_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们的{#Emph}作品{#Prev}就是最有力的{#Emph}语言{#Prev}！此外，我不仅仅是主唱，还是她们的经纪人！她们两个现在恕不接受采访哦，尤其是不接受来自{#Emph}你这种家伙{#Prev}的！"
    }
    {
      Id = "Scylla_0193"
      InheritFrom = "BaseNarrative"
