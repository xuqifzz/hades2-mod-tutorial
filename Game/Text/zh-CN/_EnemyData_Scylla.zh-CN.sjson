      Id = "Scylla_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "是不是预感到灭顶之灾又要来临了？那就别让她等着了，姐妹们！音乐，起！"
    }
    {
      Id = "Scylla_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你不了解海洋风貌的话，贸然前来这里可能会很危险哦！{#Emph}哦吼吼！{#Prev}不过看来你已经亲身体会到这一点了！"
    }
    {
      Id = "Melinoe_2045"
      InheritFrom = "BaseNarrative"
      DisplayName = "这海里一切都湿漉漉，臭烘烘的。而且现在我还必须得听{#Emph}你{#Prev}对我说风凉话。还要听你那要人命的歌谣，我没猜错吧？"
    }
    {
      Id = "Scylla_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "太对了！而且我们会一直演奏下去，直到每一个音符都{#Emph}完美无瑕{#Prev}。现在的还是半成品。所以你就将就着听吧……"
    }
    {
      Id = "Scylla_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "看呐，姐妹们，她受伤了！她已经受了{#Emph}很重很重{#Prev}的伤哦。也许我们可以给她{#Emph}奏上一曲{#Prev}，让她走得更安详一些，对不对？"
    }
    {
      Id = "Melinoe_2046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我告诉你们，你们再招惹我的话，我现在承受的痛苦在我要对{#Emph}你们{#Prev}造成的痛苦面前不值一提。"
    }
    {
      Id = "Scylla_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "斗志还挺顽强的吗，是不是？那正好，我们最讨厌没有激情的观众了！来吧，女士，到内场来！演出马上就要开始了！"
    }
    {
      Id = "Scylla_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "看呐，姐妹们！我们有观众了！来，让观众体验一下{#Emph}爽到死{#Prev}的感觉，好不好？"
    }
    {
      Id = "Scylla_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，好了，姐妹们，大的要来了！这就是我们{#Emph}一炮走红{#Prev}的机会！就是现在！！"
    }
    {
      Id = "Scylla_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哦{#Prev}，这位女士，又见面了！我们一直在{#Emph}排练{#Prev}呢！想听听我们最新的单曲吗？"
    }
    {
      Id = "Scylla_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}最喜欢{#Prev}精彩的演出了，对不对，这位女士？而我们{#Emph}最喜欢{#Prev}让观众心满意足！对不对，姐妹们？"
    }
    {
      Id = "Scylla_0040"
      InheritFrom = "BaseNarrative"
