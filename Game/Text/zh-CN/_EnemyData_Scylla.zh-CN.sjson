    }
    {
      Id = "MelinoeField_4312"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的指望我相信，{#Emph}《好想要挖》{#Prev}和{#Emph}《女巫之眼》{#Prev}都跟我毫无关系吗？不过，如果你对我有意思的话，那你表达的方式真的很特别。"
    }
    {
      Id = "Scylla_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "想什么呢！是{#Emph}你{#Prev}总来看{#Emph}我们{#Prev}的演出啊，女士。显然是{#Emph}你对我有意思！{#Prev}要么就是看上了乐队里的谁。这点杰蒂知道，罗茜知道，{#Emph}整个俄刻阿诺斯{#Prev}都知道！"
    }
    {
      Id = "MelinoeField_4313"
      InheritFrom = "BaseNarrative"
