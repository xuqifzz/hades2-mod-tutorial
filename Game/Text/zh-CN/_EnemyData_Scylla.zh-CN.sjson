    }
    {
      Id = "Melinoe_1102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于……"
    }
    {
      Id = "Melinoe_1103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她们非得唱个不停……"
    }
    {
      Id = "MelinoeField_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "整个世界清静了。"
    }
    {
      Id = "MelinoeField_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我讨厌她。"
    }
    {
      Id = "MelinoeField_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再练练吧！"
    }
    {
      Id = "MelinoeField_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你倒是唱啊……"
    }
    {
      Id = "MelinoeField_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是报上一晚的仇。"
    }
    {
      Id = "Scylla_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，{#Emph}吼吼吼{#Prev}，难以置信！{#Emph}难以置信。{#Prev}看呐，姐妹们，来了位{#Emph}女士{#Prev}耶！从来没有女士来看过我们的演出，你一定是与众不同，你叫什么名字？哦，快坐好，我们正准备开始呢，对不对，姐妹们？"
    }
    {
      Id = "Melinoe_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "……塞壬。我早该知道，那些歌声的源头是你们。所以说，你们现在是在冥界安家了？"
    }
    {
      Id = "Scylla_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的压力刚刚好！不用在粉丝们的注视和苦苦哀求中创作，那样压力太大了。{#Emph}“斯库拉，你的下一首歌什么时候出呀？！”"
    }
    {
      Id = "Melinoe_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些所谓的“粉丝”，不是都被你们拖入海底淹死了吗？现在恐怕一个都不剩了吧？"
    }
    {
      Id = "Scylla_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼，不许你说我{#Emph}粉丝{#Prev}的坏话！喂，姐妹们……？不如我们给她来一首经典曲目，你们说呢？"
    }
    {
      Id = "Scylla_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我就知道！{#Prev}她又{#Emph}回来{#Prev}了！这位女士，你准备好再听一场演出了吗？我们已经反反复复排练了无数遍。你问我们为什么这么努力？因为有朝一日我会成为{#Emph}大明星{#Prev}！哦，我和姐妹们都会！"
    }
    {
      Id = "Melinoe_1042"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们在音乐上的雄心壮志，为什么要无缘无故转变成针对{#Emph}我{#Prev}的暴力行为？"
    }
    {
      Id = "Scylla_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "别理她，姐妹们，她只是在给我们招黑！我们从头来一遍，{#Emph}三，二，一，走！"
    }
    {
      Id = "Scylla_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我一直想当着一大群观众的面唱歌，你知道吗？而且不要对着那些粗野的水手唱，要去到陆地上那种巨大的{#Emph}圆形剧场{#Prev}才过瘾！"
    }
    {
      Id = "Melinoe_1828"
      InheritFrom = "BaseNarrative"
      DisplayName = "这方面我一窍不通。圆形剧场里的演出一般来说会有淹死观众的环节吗……？"
    }
    {
      Id = "Scylla_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，当然啦……凡人们会把剧场挤得人山人海，大喊大叫扑腾半天，只为了探出个头来，{#Emph}嘿嘿{#Prev}！但你在这里，一个人就能独享一场演出呢！"
    }
    {
      Id = "Melinoe_1830"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，我以为担当主唱的会是塞壬们呢。但每次对我放声歌唱的都是{#Emph}你{#Prev}，斯库拉……"
    }
    {
      Id = "Scylla_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "别听她瞎说，姐妹们！你们的背景音是这场演出的脊梁骨！我有歌声，{#Emph}你们{#Prev}有音乐，我们一起就有{#Emph}魔力{#Prev}！让她尝尝我们的厉害，好不好？"
    }
    {
      Id = "Scylla_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "杰蒂、罗茜和我，我们三个人的关系是有过起起伏伏。偶尔拌拌嘴也正常嘛！但上次我们竟然在{#Emph}公众场合{#Prev}大打出手了，都是你害的！这样可绝对不行。"
    }
    {
      Id = "MelinoeField_2720"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道这样说算不算是安慰，但我对她们施的巫咒都只是暂时的。说实话，我都没想到会对她们有用呢！暗夜苏生通常只对亡者有效。"
    }
    {
      Id = "Scylla_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是我的乐队。而且，就算有人要让杰蒂和罗茜争得面红耳赤，那个人也{#Emph}绝对不该是你{#Prev}！对吧，姐妹们？"
    }
    {
      Id = "Scylla_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来，这位女士真是对我们欲罢不能嘛，是不是？哦，没关系的，大家都是这样啦，尤其是水手哦，毕竟我们{#Emph}实在{#Prev}是迷人！所以你是水手吗？"
    }
    {
      Id = "Melinoe_2040"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的自信心令人自愧不如，但我之所以来这里，只是因为必须要穿过这个夸张的舞台而已。所以不如跳过演出吧。"
    }
    {
      Id = "Scylla_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我有个更好的想法：所以不如{#Emph}开始{#Prev}演出吧？我们所需要的只是一点点观众而已，而{#Emph}你{#Prev}现在恰好在我们最需要你的地方。 "
    }
    {
      Id = "Scylla_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "人们总说……我们的歌声{#Emph}人间难得几回闻{#Prev}，但最近我们都没什么人来捧场。哦，该不会是你干的好事吧？我就知道{#Emph}有人{#Prev}在背地里糟蹋我们的名声……"
    }
    {
      Id = "Melinoe_1043"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们的名声是由你们自己的行为决定的。更何况，我认识的人恐怕听都没听过你们。"
    }
    {
      Id = "Scylla_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，姐妹们！在观众们到来之前，让我们再{#Emph}倾尽全力{#Prev}排练一场！观众们{#Emph}肯定{#Prev}会来的！我的直觉{#Emph}不可能错{#Prev}！"
    }
    {
      Id = "Scylla_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，作为我们的粉丝，我想请问一下，你这么喜欢斯库拉与塞壬，最主要的原因是什么，嗯？我们最新的热门单曲？我们无可挑剔的风格？"
    }
    {
      Id = "Melinoe_2039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们的风格说实话不太合我的品味，至少这个我很确定。"
    }
    {
      Id = "Scylla_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，没事的！又不是每个人都有好{#Emph}品味{#Prev}啦。至少你有勇气承认嘛，不过你敢这样批评我们，我们还是要用实力堵上你的嘴哦。"
    }
    {
      Id = "Scylla_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哦，太好了！{#Prev}你刚刚好赶上了我们的演出！我们最近在排练一首新歌，名叫《好想要挖（掉你双眼然后淹死你）》，嘿嘿！这首歌是基于亲身体会，有感而发的哦。"
    }
    {
      Id = "Melinoe_1829"
      InheritFrom = "BaseNarrative"
      DisplayName = "这首歌会比我来的路上听到的那首好吗？"
