    }
    {
      Id = "Melinoe_1208"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，卡戎大人。希望我们能尽快恢复家族之间的传统习俗，然后步入丰饶的新时代。"
    }
    {
      Id = "Charon_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}啊啊啊啊啊啊啊啊……"
    }
    {
      Id = "Melinoe_3383"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道您只需要金币，大人。但我仍然想多给您一些东西！您对冥界恪尽职守、忠心不二；我一直都以您为榜样。"
    }
    {
