      Id = "Melinoe_5439"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道喝酒不开船，开船不喝酒，大人，可是……您为我们做了这么多，不该只收几枚金币作为回报！就当蜜露是我们另一种表达谢意的方式吧。"
    }
    {
      Id = "Charon_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}欸欸……"
    }
    {
      Id = "Melinoe_5440"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听说在以前，您会暗中将仙酒一路送到塔耳塔罗斯的深渊。而我了解您的为人，大人，您是绝对不会擅自品尝货物的，所以这一瓶请您收下。这不是一件货物，而是一件礼物。"
    }
