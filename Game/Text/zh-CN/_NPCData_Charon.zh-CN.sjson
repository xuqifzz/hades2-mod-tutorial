    {
      Id = "Melinoe_5441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "希望那样的时间很快就能来临……"
    }
    {
      Id = "Melinoe_5442"
      InheritFrom = "BaseNarrative"
      DisplayName = "请收下吧，大人。如果您打算把另一瓶仙酒留待不时之需的话，那这一瓶也许您可以和某位同事分享，不用特地留着。"
    }
    {
      Id = "Charon_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}啊啊啊啊啊啊，唔唔唔唔……？咳咳嗯嗯……"
    }
    {
