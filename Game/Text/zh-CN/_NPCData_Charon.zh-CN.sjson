      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}杀啊啊啊啊啊啊啊……"
    }
    {
      Id = "MelinoeField_3501"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡戎大人，您是要把这个交给我么？这张羊皮纸上的图案……黑夜的印记，一只三头狮，还有一行字……{#Emph}我见你如入无人之境，将敌人碾作齑粉。{#Prev}这是……佐利菲特的唤醒咒语？"
    }
