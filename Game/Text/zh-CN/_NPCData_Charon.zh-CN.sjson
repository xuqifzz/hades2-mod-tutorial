    }
    {
      Id = "Melinoe_3384"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们能取得现在的进展，全都依赖着心中的毅力，大人。愿您的决心永不动摇！每当我有些犹疑的时候，我都会想到有您这样可靠的盟友，然后就会感到安心许多。"
    }
    {
