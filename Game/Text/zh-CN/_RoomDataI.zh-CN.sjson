    }
    {
      Id = "MelinoeField_3577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}珀尔塞福涅王后！扎格列欧斯王子！回到我们身边！"
    }
    {
      Id = "Persephone_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄……！你……你怎么长这么大了？可是……好像本应如此……我……哦，我的心……"
    }
    {
      Id = "Zagreus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈……哈哈{#Prev}，墨利诺厄，真的是你……！你看起来就和噩梦里的映像一模一样……那是很久以前了，那时你还没出生呢。我们成功了么……？啊，我怎么在发抖……"
    }
    {
      Id = "Chronos_1470"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们会恢复的；给他们些时间。现在，还等什么，快来取走我的性命，让我归于湮灭！{#Emph}你{#Prev}，吾儿，或者那个女巫，又或者{#Emph}你{#Prev}，孙女，谁来都行！我{#Emph}受够{#Prev}这一切了！你们渴望一个没有我的世界？那就{#Emph}如你们所愿！{#Prev}"
    }
    {
      Id = "Zagreus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，不要……！我们一起经历了那么多，你怎么还能说出这种话？我发过誓要保护你，而且……哦，众神啊……冥府怎么变成这样了？"
    }
    {
      Id = "Chronos_1471"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府变成这样，因为我夺走了它，扎格列欧斯。而且毁掉了它！不必再为我说话了；你从来没见过我的真实面目。你见到的不过是一种……{#Emph}可能性{#Prev}，仅此而已。而你，墨利诺厄……真不敢想象，我……我居然让你经受了这一切。向我复仇罢。"
    }
    {
      Id = "MelinoeField_5190"
      InheritFrom = "BaseNarrative"
      DisplayName = "……不。这场你死我活的家庭争斗，该告一段落了。还有谁记得发生了什么？那些记忆，像珍视的时光一样生动，但却来自我们可能度过的另一种人生……！母亲，你还记得么？"
    }
    {
      Id = "Persephone_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我记得。你……儿时的你是那么好奇，有的时候……甚至我也有些招架不住。因此，扎格列欧斯，以及克洛诺斯，他们……常常会帮我照顾你。"
    }
    {
      Id = "Hades_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我现在也记得了。我记得扎格列欧斯发现了我父亲，把他带了过来，与我们生活在了一起。但与此同时……我又一直是个囚徒。在{#Emph}我们{#Prev}的这个时间里，是{#Emph}他的{#Prev}囚徒……"
    }
    {
      Id = "HecateField_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "珀尔塞福涅王后，冥王哈迪斯，不要被这些涌入你们脑海的{#Emph}假象{#Prev}蒙蔽了！就连你们的子女，似乎都无法摆脱其影响。你们全都被那泰坦的魔法蛊惑了！"
    }
    {
      Id = "MelinoeField_5151"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，不是这样的！您不明白么？我们要解构时间……而这就是我实现的方式。您总是说，这是我的任务，手段也由我自己决定。这就是我选择的道路。"
    }
    {
      Id = "HecateField_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，你搞砸了！你的任务是确保克洛诺斯{#Emph}必死无疑{#Prev}，可他就在那里，活得好好的！墨利诺厄……到底是什么事情，驱使你走上了这样一条路？"
    }
    {
      Id = "MelinoeField_5152"
      InheritFrom = "BaseNarrative"
      DisplayName = "是您的教导啊！是您告诉我要独立思考，而不……而不仅仅是执行命令！但如果您仍然相信，消灭克洛诺斯就能让我们所有的问题迎刃而解……那您还在等什么？"
    }
    {
      Id = "HecateField_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我永远不会宽恕这个泰坦的所作所为……对这个世界，对你的家人，对你……以及对我，所做的一切。"
    }
    {
      Id = "Persephone_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "亲爱的赫卡忒……我的侍女。没有人说你非得宽恕他不可。我从来没有听过你如此痛苦的声音。在此世，我的上一段记忆……是在克洛诺斯袭击之前，我们将墨利诺厄托付给了你，让你不惜一切代价保护她……而你做到了……！你做到了！"
    }
    {
      Id = "Hades_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "……在我们最危难的时刻，你是我们最后的希望，尊敬的岔路女巫。为此，也为你所做的一切，你有我们的感激。永恒的感激。"
    }
    {
      Id = "HecateField_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我不过是做了我的分内之事，冥王冥后陛下。而我现在，一如既往，愿意为您竭智尽忠……那么，墨利诺厄……接下来你想怎么做……？"
    }
    {
      Id = "MelinoeField_5153"
      InheritFrom = "BaseNarrative"
      DisplayName = "接下来……？有好多事情要做……比如说，要让这座冥府恢复秩序！母亲……父亲……你们都见到了另一种可能性。就让我们给克洛诺斯一个发挥作用的机会吧，从帮助我们翻修冥府开始。你们愿意准许我这样做吗？"
    }
    {
      Id = "Persephone_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我批准！克洛诺斯，我们跟你还没完。人们总说，时间能治愈一切创伤。证明给我们看。"
    }
    {
      Id = "Hades_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我批准。但只有这一次机会。拜仁慈的冥界王女所赐。"
    }
    {
      Id = "Chronos_1472"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你们愿意……给我这样一次机会？可我无法改变已经发生之事……无法撤回我犯下的那些，不可饶恕的罪孽。"
    }
    {
      Id = "MelinoeField_5154"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是时间本尊。我们不是在要求你退回过去。我们是在要求你迈向未来。"
    }
    {
      Id = "Chronos_1527"
      InheritFrom = "BaseNarrative"
      DisplayName = "迈向未来……我从来都只懂得这一件事。那么，就让时间……复原这座府邸，以及……弥补一切。"
    }
    {
      Id = "Hades_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "女儿，拜托……"
    }
    {
      Id = "HecateField_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还在等什么……？"
    }
    {
      Id = "HecateField_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "墨利诺厄……！"
    }
    {
      Id = "HecateField_0322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔呃……？！泰坦……！"
    }
    {
      Id = "MelinoeField_3569"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……什么？！"
    }
    {
      Id = "Chronos_1463"
      InheritFrom = "BaseSubtitle"
