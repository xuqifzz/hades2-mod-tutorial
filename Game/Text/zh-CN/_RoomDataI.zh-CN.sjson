    }
    {
      Id = "Persephone_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄……！你……你怎么长这么大了？我……哦，我的心……"
    }
    {
      Id = "Zagreus_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿……嘿嘿，墨利诺厄，是你……！你做到了……！我、我……最后还是决定好好跟爷爷谈谈，让他放弃他的计划。那是你出生很久之前的事了。啊，我的头好痛……"
    }
    {
      Id = "Chronos_1378"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们会恢复的；给他们些时间。现在，还等什么，快让我彻底湮灭罢！{#Emph}你{#Prev}，吾儿，或者那个女巫，又或者{#Emph}你{#Prev}，孙女，谁来都行！我受够这场无休无止的争斗了。你们渴望一个没有我的世界？那就{#Emph}如你们所愿！"
    }
    {
      Id = "Zagreus_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，不要……！妹妹，你……你不记得了么？在你成长的过程中，爷爷一直都在！那是一场梦吗？不，不可能只是一场梦……妹妹，给他一次机会吧。"
    }
    {
      Id = "Chronos_1379"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯，不必再为我求情了。我们所经历的，不过是一种可能性，仅此而已。而你，墨利诺厄……真不敢想象，我……我居然让你经受了这一切。向我复仇罢。"
    }
    {
      Id = "MelinoeField_5062"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我跟你们两个都有账要算。扎格列欧斯……我那么信任你，我把整个家族的未来都托付给了你……！而你和这个泰坦说的那些事，我一点都不记得。只有你们两个能记得起来，这不是巧了么！"
    }
    {
      Id = "Zagreus_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么叫{#Emph}巧了？！{#Prev}是你对我们施展了你的什么“梦境时间女巫魔法”！而且如果你仍然觉得，杀死爷爷就能把这个荒唐家庭中的问题都解决掉，那也怪不得你那花哨的魔法没起到预想中的效果！"
    }
    {
      Id = "Hades_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}够了！{#Prev}这座该死的府邸中不许争吵；更何况还是{#Emph}你们两个之间！{#Prev}你们难道想要等到上了年纪，变得苦大仇深、满心愤怒吗？就像{#Emph}他{#Prev}一样？就像{#Emph}我{#Prev}一样？"
    }
    {
      Id = "MelinoeField_5063"
      InheritFrom = "BaseNarrative"
      DisplayName = "……父王……正是我的愤怒，才让我走到了今天这一步。而且，你怎么能拿自己与这个泰坦相比？看看他对你做的事！"
    }
    {
      Id = "Hades_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "是我们对{#Emph}彼此{#Prev}做的事。众神和泰坦……注定要永生不死，但又从来学不到教训。做你该做的事吧……但不要以我的名义复仇。"
    }
    {
      Id = "MelinoeField_5064"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我始终可以以我自己的名义复仇……但我们不如先确保克洛诺斯逆转他所造成的伤害。全部逆转！扎格列欧斯想要给他一个机会……而我想让他把夺走的时间还给我们。"
    }
    {
      Id = "Hades_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "……既然如此，那就给他一次机会！听到了么，父亲？拜冥界王女的仁慈所赐，你有一次机会，归还你夺走的一切。就从把这座冥府变回原样开始！这里现在丑陋得不堪入目！"
    }
    {
      Id = "Chronos_1426"
