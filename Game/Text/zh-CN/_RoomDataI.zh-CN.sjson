      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥界著名的密室迷阵环环相扣、变化无穷；其内部结构现如今暴露在外，乃是无数个彼此相结的金齿轮盘，在泰坦的旨意下周而复始、运转不息。"
