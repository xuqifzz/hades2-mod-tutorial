    }
    {
      Id = "Storyteller_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}曾经金碧辉煌的冥府如今已成过眼云烟，取而代之的是一座崭新的宫殿，其上刻画着征服世界的时间泰坦克洛诺斯的面容。"
    }
    {
      Id = "MelinoeField_1435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是丑陋无比……"
    }
    {
      Id = "Storyteller_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在塔耳塔罗斯的无底深渊中，残忍无情的众神之祖克洛诺斯统御着他的叛军，一面向奥林匹斯展开攻势，一面将冥界控制在自己的股掌之间。"
    }
    {
      Id = "MelinoeField_1436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在这里，奥林匹斯也奈何不了他……"
    }
    {
      Id = "Storyteller_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}残暴的泰坦篡窃来的要塞如今疏于防备，静待墨利诺厄潜入其中；这要么是因为泰坦的兵力派遣到了它处，要么便说明他自以为胜券在握。"
    }
    {
      Id = "MelinoeField_1437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许是兼而有之。"
    }
    {
      Id = "Storyteller_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在王女深入敌营所造成的混乱之中，摆渡人卡戎旁若无人地驾舟驶过，为王女带来了各种各样的走私货物。"
    }
    {
      Id = "MelinoeField_1434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他的身手比我还隐秘……"
    }
    {
      Id = "Storyteller_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥府已然重拾昔日的庄严，沉重大门上的浮雕也换回了正确的面容。然而，冥界王女心中所想的，是另一个入口。"
    }
    {
      Id = "MelinoeField_4266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是时候游游泳了……"
    }
    {
      Id = "Storyteller_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}此处的冥河再次涌现殷红，汇入冥界的心脏，与千百年前别无二致；纵使塔耳塔罗斯仍然散落着泰坦的黄金，映出刺目光芒。"
    }
    {
      Id = "MelinoeField_4267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不会一直这样的。"
    }
    {
      Id = "Storyteller_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}昔日冥府遭到破坏的大殿如今只剩诡异的宁静。深知不朽的泰坦势必归来，王女此时别无所求，只愿找到某件能助她破局的器物。"
    }
    {
      Id = "MelinoeField_1438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "应该还在王子的卧室里……"
    }
    {
      Id = "Storyteller_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}克洛诺斯如此阴险狡诈，一时落败后势必会卷土重来；但王女每一次得胜，都能重新拾回一些她本以为永远失落的珍贵回忆。"
    }
    {
      Id = "MelinoeField_1439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我还依稀记得这里……"
    }
    {
      Id = "Storyteller_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哪怕是不死不灭的神明，也无法完全抵御时间的无情摧残；然而在今夜，冥界王女似乎做到了这看似不可能之事。"
    }
    {
