    {
      Id = "Storyteller_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}塔耳塔罗斯中，这间被长久遗忘的秘密房间为冥界王女带来了些许慰藉；此情此景与另一段时光之中，她的亲生哥哥在此驻足的场面如出一辙。"
    }
    {
      Id = "MelinoeField_1433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不知为何，这里的泉水仍然相当清澈……"
    }
    {
      Id = "Storyteller_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}萨提尔们曾经潜藏在冥界的顶层，和它们使唤的鼠兽一起，为泰坦王的回归进行着邪恶的筹谋。"
    }
    {
      Id = "MelinoeField_1663"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这些萨提尔早就该下冥界了。"
    }
    {
      Id = "Storyteller_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}熠熠生辉的纯金。真正的冥王鄙视这种金属，不仅是因为其质地柔软，还因为他的泰坦父亲对其情有独钟。也正因此，它成为了过往时代的象征。"
    }
    {
      Id = "MelinoeField_1664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "亮闪闪的，但那又如何？"
    }
    {
      Id = "Storyteller_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}曾经为世人所畏惧的冥界之王，现如今已然沦为了阶下囚，一如曾在这里收押的无数卑劣暗灵一般；只不过那些暗灵早已被泰坦放了出来，只剩冥王一人独囚于此。"
