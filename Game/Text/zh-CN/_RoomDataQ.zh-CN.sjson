{
  /*
  This file was autogenerated on 9/16/2025 at 4:12 AM
  by the BuildText tool.
  */
  lang = "zh-CN"
  Texts = [
    {
      Id = "MelinoeField_2927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这……这风暴……！"
    }
    {
      Id = "MelinoeField_4198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呼……我回来了。"
    }
    {
      Id = "MelinoeField_2928"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里发生了什么……"
    }
    {
      Id = "MelinoeField_2929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最高峰……"
    }
    {
      Id = "MelinoeField_4199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呼……提丰的风暴……"
    }
    {
      Id = "MelinoeField_4200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呼……又一种可能性……"
    }
    {
      Id = "MelinoeField_2930"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，提丰……"
    }
    {
      Id = "MelinoeField_2931"
      InheritFrom = "BaseSubtitle"
      DisplayName = "提丰在等着我……"
    }
    {
      Id = "Storyteller_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}起初，这场笼罩奥林匹斯山顶的风暴看似是众神的自卫手段，然而，在其怪物般的外表下，掩盖的真相远比这要邪恶得多。"
    }
    {
      Id = "MelinoeField_3251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该去找到风暴的源头了。"
    }
    {
      Id = "MelinoeField_3252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……提丰。"
    }
    {
      Id = "Storyteller_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}众神的要塞现在摇摇欲坠，而这震动的源头正是提丰——素有“众魔之父”、“风暴中的巨物”之称的他，现在不知为何竟能藏身于此，与王女近在咫尺……"
    }
    {
      Id = "MelinoeField_3253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要么是我们找到他，要么是他找到我们……"
    }
    {
      Id = "Storyteller_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}毁天灭地的提丰，众多魔物的生父与统领，曾在众神手上陨落；由于那场古老而苦涩的失利，他现在誓要让众神付出无比惨痛的代价。"
    }
    {
      Id = "MelinoeField_3254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很快，他就会再次在众神手上陨落。"
    }
    {
      Id = "Storyteller_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}提丰的风暴虽然不再压迫奥林匹斯，却再度将冥界王女席卷……因为还存有其他的可能性，在其中众魔之父仍然存活。"
    }
    {
      Id = "MelinoeField_5024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "活不了多久了。"
    }
    {
      Id = "Storyteller_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}捷足的赫尔墨斯送来的寥寥无几的物资，代表着在王女即将登临奥林匹斯山顶之际，众神能为她提供的最终助力。"
    }
    {
      Id = "MelinoeField_3255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有就行，我不挑……"
    }
    {
      Id = "Storyteller_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}提丰那些可怖的子孙后代有着各异的体型和外表，其中不乏尤为邪恶，尤为庞大的怪物，王女最近刚刚杀死过一些。"
    }
    {
      Id = "MelinoeField_3262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会把他们全部杀掉。"
    }
    {
      Id = "MelinoeField_2956"
      InheritFrom = "BaseSubtitle"
      DisplayName = "更多的入侵迹象……"
    }
    {
      Id = "MelinoeField_3231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……什么东西在监视我……"
    }
    {
      Id = "MelinoeField_3232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……有什么东西在这里……"
    }
    {
      Id = "MelinoeField_3233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我记得这个地方……"
    }
    {
      Id = "MelinoeField_3234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……尾巴要来了……"
    }
    {
      Id = "MelinoeField_3235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……尾巴的房间……"
    }
    {
      Id = "Storyteller_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这座要塞乃是奥林匹斯众神面对风暴的最后一条防线，而众魔之父只用了众多蛇形长尾中的一条，便得以将要塞的地面层层贯穿。"
    }
    {
      Id = "MelinoeField_3256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他会把这座要塞撕成碎片……"
    }
    {
      Id = "MelinoeField_3257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会是他最后见到的景象。"
    }
    {
      Id = "MelinoeField_3685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，这是什么……"
    }
    {
      Id = "MelinoeField_3686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "眼睛不是用来干这种事的！"
    }
    {
      Id = "MelinoeField_3687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就给我看好了，提丰。"
    }
    {
      Id = "MelinoeField_3688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看好了，魔物。"
    }
    {
      Id = "MelinoeField_3690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来有东西在注视着我。"
    }
    {
      Id = "MelinoeField_3689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你想要{#Emph}再丢一只{#Prev}眼睛吗？"
    }
    {
      Id = "Storyteller_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}凡是与那纵观万物的提丰为敌者，绝无可能逃离他的仇恨，因为他身上长满了眼睛，无时无刻不在四下搜索，就连灵魂都会被他看穿。"
    }
    {
      Id = "Storyteller_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼风唤雨的提丰诞下的万千子孙，自众神要塞的裂缝中鱼贯而入，大有将整座山脉夷为平地之势。"
    }
    {
      Id = "MelinoeField_3263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最好当心脚下。"
    }
    {
      Id = "MelinoeField_5010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你们，扎格列欧斯……吉加罗斯……"
    }
    {
      Id = "MelinoeField_3453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该离开这里了……"
    }
    {
      Id = "Storyteller_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}终于，席卷众神要塞的可怖风暴显现出了停歇之势，或许是因为它那可怖的根源现已无迹可寻。"
    }
    {
      Id = "MelinoeField_3258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少，暂时如此……"
    }
    {
      Id = "Storyteller_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}提丰这一令人绝望的大敌被冥界王女从山巅击落，嚎叫着坠入了大地，带着他的怒意一起烟消云散；但一夜过后，他又会卷土重来。"
    }
    {
      Id = "MelinoeField_3259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我的家人可以享受片刻的安宁了。"
    }
    {
      Id = "Storyteller_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}再一次，这世界最可怕的魔物无迹可寻。而就连他再度肆虐这座山巅的可能性，都随之变得愈发渺茫。"
    }
    {
      Id = "MelinoeField_5025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不给他留一丝机会。"
    }
    {
      Id = "Storyteller_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}骁勇善战的王女终是击退了那夜夜不知疲倦，向众神之山攻来的远古魔物；哪怕是时间本尊也无法阻止她。"
    }
    {
      Id = "MelinoeField_3619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们的把戏我都见过了。"
    }
    {
      Id = "Storyteller_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}纵使心头有千般苦涩、万般不甘，众神之父与众魔之父仍然无法夺取这座神圣的山峰，亦无法将其夷为平地。"
    }
    {
      Id = "MelinoeField_3659"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而我们会确保他们永远无法得逞。"
    }
    {
      Id = "MelinoeField_3456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一道以太之门……？"
    }
    {
      Id = "Storyteller_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}能够亲眼目睹奥林匹斯之王的辉煌宫殿者寥寥无几；唯有被认可之人，方能获准进入，而其他人甚至无法在山间觅得它的位置。"
    }
    {
      Id = "MelinoeField_3608"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，就是这里了……"
    }
    {
      Id = "Storyteller_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}前方矗立着奥林匹斯神王与王后的宫殿，深藏不露，防备万全；正是在这座要塞之中，奥林匹斯众神一次又一次将无数凶神恶煞的敌人拒之门外。"
    }
    {
      Id = "MelinoeField_3611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要坚持住啊……"
    }
    {
      Id = "MelinoeField_4245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就连提丰也不例外。"
    }
    {
      Id = "MelinoeField_5011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这场风暴将会消散……"
    }
    {
      Id = "MelinoeField_3454"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就快……到了……"
    }
    {
      Id = "MelinoeField_3455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "通往圣殿的路……"
    }
    {
      Id = "Storyteller_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}宙斯的宫殿傲然屹立，宏伟无比；在众神的合力拥护下，那权力的王座安然无恙，纵使如此凶残的敌人，也无法撼动其分毫。"
    }
    {
      Id = "MelinoeField_3609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里一定就是圣殿的庭院了……"
    }
    {
      Id = "Storyteller_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}技艺精湛的阿波罗演奏出的宁静乐章，在宫廷内绕梁不散，如同一束纯粹的光芒，驱散众神心中的阴霾。"
    }
    {
      Id = "MelinoeField_3610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他弹得真好……"
    }
    {
      Id = "MelinoeField_3468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是……？"
    }
    {
      Id = "MelinoeField_3469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "音乐……"
    }
    {
      Id = "MelinoeField_3470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "神王和王后……"
    }
    {
      Id = "MelinoeField_3471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们在这……"
    }
    {
      Id = "MelinoeField_3834"
      InheritFrom = "BaseNarrative"
      DisplayName = "出现在这一头还真不习惯！我看到了……应该是厄瑞玻斯吧。等等，老师，那是{#Emph}您{#Prev}吗？您能听到我吗？"
    }
    {
      Id = "HecateField_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}以哈迪斯之名。奥林匹斯，我在此领受神谕！{#Prev}……墨利诺厄？你在那边听得见的话，快回来吧。我们还有事情要商量。"
    }
    {
      Id = "MelinoeField_3835"
      InheritFrom = "BaseNarrative"
      DisplayName = "……各位，我得走了。请务必保重，以及替我向其他人说一声抱歉，没能见上他们一面再走。我会回来的！"
    }
    {
      Id = "MelinoeField_3926"
      InheritFrom = "BaseNarrative"
      DisplayName = "……接下来就是克洛诺斯了。我会需要你们的祝福，各位！"
    }
    {
      Id = "MelinoeField_5022"
      InheritFrom = "BaseNarrative"
      DisplayName = "……听起来我近期是没有机会再来拜访了，所以……谢谢大家，也请向其他人转达我美好的祝愿。我们用祝福保持联络吧！"
    }
    {
      Id = "MelinoeField_3927"
      InheritFrom = "BaseNarrative"
      DisplayName = "……见到你们真开心！我先告辞了！"
    }
    {
      Id = "MelinoeField_3923"
      InheritFrom = "BaseNarrative"
      DisplayName = "……先再见了，各位！希望下次回来时，能见到大家都安然无恙。"
    }
    {
      Id = "MelinoeField_3925"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我们离目标越来越近了，各位。保重！"
    }
    {
      Id = "MelinoeField_3924"
      InheritFrom = "BaseNarrative"
      DisplayName = "……如果提丰卷土重来，我会回来的！"
    }
  ]
}
