  lang = "zh-CN"
  Texts = [
    {
      Id = "MelinoeField_1243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "乖狗狗，快醒醒！"
    }
    {
      Id = "MelinoeField_2118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喂，回来……！"
    }
    {
      Id = "MelinoeField_2119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "刻耳柏洛斯，回来……！"
    }
    {
      Id = "MelinoeField_1241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要开始了……"
    }
    {
      Id = "MelinoeField_1242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "来了……"
    }
    {
      Id = "MelinoeField_1244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这不是你的本来面目！"
    }
    {
      Id = "MelinoeField_1245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很快你就会神清气爽了！"
    }
    {
      Id = "MelinoeField_3535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你们又是从哪个熔岩池里钻出来的？"
    }
    {
      Id = "MelinoeField_2120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你们都别来掺和这个！"
    }
    {
      Id = "MelinoeField_2121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不许你们骚扰那只狗狗！"
    }
    {
      Id = "MelinoeField_2122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别再骚扰那只狗了！"
    }
    {
      Id = "MelinoeField_2123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "都给我离开这里！"
    }
    {
      Id = "MelinoeField_2124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你们非要折磨他吗？"
    }
    {
      Id = "MelinoeField_2125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他被这些东西感染了……"
    }
    {
      Id = "MelinoeField_2126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这么多邪魔……"
    }
    {
      Id = "MelinoeField_3533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他的身体在冷却！"
    }
    {
      Id = "MelinoeField_3534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只剩最后一层熔岩了……"
    }
    {
      Id = "MelinoeField_1221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}绝望的魂灵，退散吧！"
    }
    {
      Id = "MelinoeField_1222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你们这些暗灵，不许再缠着他！"
    }
    {
      Id = "MelinoeField_1223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "刻耳柏洛斯，你自由了！"
    }
    {
      Id = "MelinoeField_1224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你自由了！"
    }
    {
      Id = "MelinoeField_4572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，乖狗狗，冷静下来！"
    }
    {
      Id = "MelinoeField_4573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "为了找乐子试图杀掉我的事，可以告一段落了！"
    }
    {
      Id = "MelinoeField_4574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我觉得“重走路线”做到这种程度已经够了……"
    }
    {
      Id = "MelinoeField_4575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来你这下玩够了！"
    }
    {
      Id = "MelinoeField_4576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "坐下，狗狗，够了！"
    }
    {
      Id = "MelinoeField_4577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了！你肯定累得够呛了！"
    }
    {
      Id = "MelinoeField_4186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "放风时间……{#Emph}结束了！"
    }
    {
      Id = "MelinoeField_4187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "放风时间……{#Emph}结束了……！"
    }
    {
      Id = "MelinoeField_0936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他去哪了……？"
    }
    {
      Id = "MelinoeField_0937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要好起来啊，刻耳柏洛斯……"
    }
    {
      Id = "MelinoeField_0938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没事的，你安全了……"
    }
    {
      Id = "MelinoeField_0939"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看起来已经好多了嘛……"
    }
    {
      Id = "MelinoeField_0941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你又一次自由了，至少暂时如此。"
    }
    {
      Id = "MelinoeField_0942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "去找你的主人吧。"
    }
    {
      Id = "MelinoeField_0943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回到主人身旁，去你的小窝里呆着吧。"
    }
    {
      Id = "MelinoeField_0944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再次得到安宁吧。"
    }
    {
      Id = "MelinoeField_0934"
      InheritFrom = "BaseNarrative"
      DisplayName = "刻耳柏洛斯……真的是你。"
    }
    {
      Id = "Storyteller_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}褪去了折磨的外衣，在塔耳塔罗斯的大门外，那吞噬灵魂的渊狱魔兽显现出另一幅面目：不是什么名不见经传的瘴气怪物，而是那恶名昭著的地狱凶犬。"
    }
    {
      Id = "MelinoeField_0935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，等等，别走！"
    }
    {
      Id = "Storyteller_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}怒意褪去，原形显现，地狱的看门犬刻耳柏洛斯望向冥界王女——六只眼睛流露的凶光中，闪过一丝认出故人般的温情，然而这温情转瞬即逝。"
    }
    {
      Id = "MelinoeField_0940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "冷静点啦。只是我而已嘛……！"
    }
    {
      Id = "Storyteller_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}心情暂且平复之后，恐怖的刻耳柏洛斯将注意力从王女身上转移到了塔耳塔罗斯的大门上。"
    }
    {
      Id = "Storyteller_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}从三头恶犬刻耳柏洛斯的外表很难看出，他刚刚究竟是经历了一场恶战，还是嬉戏了一番。"
    }
    {
      Id = "Storyteller_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}塔耳塔罗斯的三头守卫又一次恢复了神智。"
    }
    {
      Id = "Storyteller_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}地狱之犬的毛皮仍被一团团魂魄纠缠着，但他却已然露出了心满意足的神情。"
    }
    {
      Id = "Storyteller_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}暂且摆脱了方才的窘境后，可怕的刻耳柏洛斯向王女投去了感激的目光。"
    }
    {
      Id = "Storyteller_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}地狱恶犬的脸上闪过一丝亲切的神情，似乎认出了王女。"
    }
    {
      Id = "Storyteller_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}褪去了厚重的瘴气外衣，三头恶犬刻耳柏洛斯终于如梦初醒。"
    }
    {
      Id = "Storyteller_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}然后，便出现了三张可怕却又熟悉的犬类面容。"
    }
    {
      Id = "Storyteller_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}接着，刻耳柏洛斯那三颗长着利齿的头颅纷纷垂下，为刚才的行为感到羞愧难当。"
    }
    {
      Id = "Storyteller_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}王女制伏了恐怖的刻耳柏洛斯，让他的神智如拨云见日，身形也恢复如初。"
    }
    {
      Id = "Storyteller_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}只剩最后一丝力气的冥界王女总算是制住了那头恶犬。"
    }
    {
      Id = "Storyteller_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三头恶犬刻耳柏洛斯现在收敛了无边的怒意，也藏起了他的尖牙。"
    }
    {
      Id = "Storyteller_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}终于摆脱了炼狱般的难忍奇痒，喷火的三头看门犬露出欣喜的神情。"
    }
    {
      Id = "Storyteller_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三颗长满尖牙的红色狗头看向冥界王女，露出了感激的神情。"
    }
    {
      Id = "Storyteller_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}可怕的地狱之犬再一次变回了那为人熟知的、凶恶得难以用言语形容的形态。"
    }
    {
      Id = "Storyteller_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}对于恐怖的地狱犬来说，嬉戏的时间再一次结束了。"
    }
    {
      Id = "Storyteller_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冷峻而机智的冥界王女找到了安抚这头野兽的办法。"
    }
    {
      Id = "Storyteller_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在一场惊天动地的交锋之后，恐怖的刻耳柏洛斯恢复了他原本的形态。"
    }
    {
      Id = "Storyteller_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}终于，复仇心切的王女又一次战胜了拦路的地狱恶犬。"
    }
    {
      Id = "Storyteller_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}梦魇般的刻耳柏洛斯重回镇定，然后再次离去，或许是去告知他的主人女儿将要抵达的消息。"
    }
    {
      Id = "Storyteller_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}喷火的地狱恶犬终于认出了冥界的王女，暂时冷静了下来。"
    }
    {
      Id = "Storyteller_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}让地狱恶犬刻耳柏洛斯奇痒无比、反复抓挠的无数细小邪灵终于还了他个清净，至少暂时如此。"
    }
    {
      Id = "Storyteller_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哪怕是最为炽热的火焰也可以被熄灭，不过冥界的三头守护者始终可以召唤更多。"
    }
    {
      Id = "Storyteller_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}如果这一切对于三头的刻耳柏洛斯来说只是场游戏的话，那么至少现在他总算是玩累了。"
    }
    {
      Id = "Storyteller_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}刻耳柏洛斯的放风时间终于告一段落，但不久后他就能迎来下一次机会。"
    }
    {
      Id = "Storyteller_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}永远燃烧着的地狱恶犬终于冷却了下来，至少暂时如此。"
    }
    {
      Id = "Storyteller_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}令人恐惧的冥界大门的看守者决定，是时候打道回府了。"
    }
    {
      Id = "Storyteller_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三个脑袋的、凶神恶煞的、彻底清理干净毛发的刻耳柏洛斯再次步入冥界深处，回到了他舒适的窝里。"
    }
    {
      Id = "Storyteller_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}王女又一次设法抵御住了刻耳柏洛斯本尊的利爪与烈焰。"
    }
    {
      Id = "Storyteller_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}今夜地狱三头犬的玩耍时间已然告一段落。"
    }
    {
      Id = "Storyteller_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}要想确保时间自由向前流淌，似乎就必须给脏兮兮的地狱犬清洗干净。"
    }
    {
      Id = "Storyteller_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}对于这只格外野蛮、格外凶残的野兽而言，方才的一切不过是场嬉戏。"
    }
    {
      Id = "Storyteller_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}喷吐烈火的地狱守护者今晚不用再遛了。"
    }
    {
      Id = "Storyteller_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}深思熟虑之后，凶残的刻耳柏洛斯决定还是不要吃掉王女为好。"
    }
    {
      Id = "Storyteller_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这头恶犬此刻或许在想：“这可比把守冥界的大门有意思多了。”"
    }
  ]
