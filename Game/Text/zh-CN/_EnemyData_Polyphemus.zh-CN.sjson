    }
    {
      Id = "Polyphemus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "你吓到我的羊了。在这座镇子里，这可是大忌。"
    }
    {
      Id = "Melinoe_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "我为我的冒失行径道歉，巨人。我该怎么做才能弥补你的损失呢？我愿意补偿你。"
    }
    {
      Id = "Polyphemus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你会好好补偿我的。犯这个大忌的惩罚，就是被活吞。被{#Emph}我{#Prev}活吞。抱歉，这规矩不是我定的。"
    }
    {
      Id = "Melinoe_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "不至于那么严重吧。没有必要执行毫无道理的法律。"
    }
    {
      Id = "Polyphemus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，逗你呢！规矩其实{#Emph}就是{#Prev}我定的。而且羊肉我已经吃腻了。"
    }
    {
      Id = "MelinoeField_2448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那你就吃灰去吧！"
    }
    {
      Id = "Medea_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得好好谢谢你，女术士！夜晚注入了恐惧后，某些平日里无法开展的实验，现在终于可以落实了。只不过，我也因此有义务在这里考验你，就如同赫卡忒大人在下面所做的一样。"
    }
    {
      Id = "MelinoeField_3546"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}考验{#Prev}我！美狄亚女士，那这么大一个挡在我路上的独眼巨人要怎么办？他会想把我们两个都生吃掉的！"
    }
    {
      Id = "Polyphemus_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}没这个打算。{#Prev}这边这个女巫不太合我的口味。而且……我们现在达成了个小小协议。毕竟现在这里多了这么多尸体，我的嗅觉没有以前那么灵敏了。"
    }
    {
      Id = "Medea_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要对付的还是独眼巨人！我来这里的目的，只不过是以我自己的方式践行黑夜的意志。尽量当我不存在就好，不过我得承认，这可能有点困难……"
    }
    {
      Id = "MelinoeField_4331"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士！您不是应该在从事研究工作吗？{#Emph}考验我{#Prev}又是怎么回事？挡在我路上的独眼巨人会想把我们两个都生吃掉的！"
    }
    {
      Id = "Medea_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不会是认真的吧，独眼巨人？亡者的尸体可不能吃，否则的话各种疾病够你受的！"
    }
    {
      Id = "Polyphemus_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟你打包票，它们吃起来也很美味！只不过要掌握发酵的程度。不过总之，我们可以晚点再讨论这个。有个{#Emph}热乎的{#Prev}家伙来了。"
    }
    {
      Id = "MelinoeField_3547"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，我不敢相信您和他居然这样熟络了起来。黑夜的誓约真的需要您和我们的敌人结盟吗？"
    }
    {
      Id = "Medea_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们只不过是有着共同的利益，女术士！独眼巨人仍然挡在{#Emph}你的{#Prev}路上，所以对他不用留情！而我则是应{#Emph}你自己{#Prev}的要求，为你今夜的旅程增添几分凶险而已。"
    }
    {
      Id = "Polyphemus_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个女巫哪去了，还有那些尸体呢，哈？我都快要喜欢上之前的那种气味了……"
    }
    {
      Id = "MelinoeField_3548"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和我们所有人都一样，受制于黑夜的意志，独眼巨人。美狄亚女士之前正是因此才出现在这里。就我个人而言，我发现不用同时应对你们两个，会让我更加轻松一些。"
    }
    {
      Id = "Polyphemus_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想要{#Emph}轻松一些{#Prev}，那你来这里要干什么？在我见过的城镇里，没有哪座比你刚刚穿过的那座更难走，更何况事情对你来说只会越来越难。"
    }
    {
      Id = "Polyphemus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这块肉，居然把问题解决了！女巫回来了，遍地的尸体也回来了！我感觉好极了。不过你马上就要感觉{#Emph}糟透了{#Prev}。"
    }
    {
      Id = "MelinoeField_3549"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，您确定您应该帮{#Emph}他{#Prev}，而不是帮我吗？不过，黑夜的意志永远不容置疑，而且这些都是我立下誓言的后果……"
    }
    {
      Id = "Medea_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "黑夜总会带来恐惧，女术士……对不可能之事，以及对未知的恐惧。我只是为此尽自己的责任，所以，请不要在意我！你该面对的，是波吕斐摩斯大人。"
    }
    {
      Id = "Polyphemus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈！波吕斐摩斯大人。我喜欢这个名号！毕竟，“大人”一听就吃得很多。现在，快过来吧，让我把你变成地上的又一具尸体。"
    }
    {
      Id = "Polyphemus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算这里多了这么多尸体，我也不会错过你的气味。你在我的地盘上。从此以后，你都要叫我{#Emph}“波吕斐摩斯大人”{#Prev}。"
    }
    {
      Id = "MelinoeField_3550"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定不是认真的。你的地位又不会因为你的一个念头而发生改变！还是说美狄亚女士的毒药又让你产生了新的幻觉？"
    }
    {
      Id = "Medea_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "别盯着{#Emph}我{#Prev}看，女术士。我会在这里，只是因为黑夜的意志，而且我已立下沉默之誓……尽管这誓言实在难以遵守。"
    }
    {
      Id = "Polyphemus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "她说她不想和你讲话。可你却总要说个不停。你知道么？我也不想跟你讲话了。"
    }
    {
      Id = "Polyphemus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我跟你说，感觉不太对劲。好像有点痒，又有点烧灼感，之类的。你确定这能帮我睡个好觉？"
    }
    {
      Id = "Medea_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，对于凡人来说，这种药物会让他们获得永恒的睡眠，在那之前还会先有无与伦比的痛苦。我没有对你做出任何保证，而且……说实话？也许这种药物拿来治你不算合适……"
    }
    {
      Id = "Polyphemus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少它没有让我的嗅觉出太大问题。不然我就不会知道，我们这又多了一个需要你{#Emph}治一治{#Prev}的人。"
    }
    {
      Id = "Polyphemus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅、嗅）呃，我这该死的鼻子全堵上了。感觉我可能是对你身上的某种药物过敏，女巫。"
    }
    {
      Id = "Medea_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "能毒死最强壮的公牛的药物，在您身上都收效甚微，波吕斐摩斯大人。也许您只是我们必须要对付的那个女术士有生理性的厌恶？"
    }
    {
      Id = "Polyphemus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅）什么，她{#Emph}在这里{#Prev}吗？呃啊，要是她站在我面前我都闻不到，那我的鼻子真是不行了。"
    }
    {
      Id = "Polyphemus_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（嗅）她在{#Emph}那{#Prev}啊……"
    }
    {
      Id = "Polyphemus_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅、嗅）在这样的晚上我要怎么做才好？我闻不到她的话，就不知道该朝哪边踢了。"
    }
    {
      Id = "Medea_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "波吕斐摩斯大人，您的鼻腔一定是彻底堵死了。你口中的那个人就在你{#Emph}面前{#Prev}！下一次，我得找点能帮上您的东西才行。"
    }
    {
      Id = "Polyphemus_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅）好啊，好主意，其实也没有那么糟糕啦。只是，闻不到自己的食物的话，就没办法好好享受美餐了。"
    }
    {
      Id = "Polyphemus_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（嗅）啊……"
    }
    {
      Id = "Polyphemus_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "（深呼吸）啊，你知道么，我觉得这法子管用哎！现在我连几块地之外的每一具尸体都能闻得一清二楚。你真是个好人，女巫！话说你给我用的到底是什么啊？"
    }
    {
      Id = "Medea_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那个啊……只是些古老的药草，我姑姑给我的，放了好久了。本来还以为永远都派不上用场呢，但是……我又不忍心把它们统统扔掉。"
    }
    {
      Id = "Polyphemus_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你对我真是大方。不过我现在打算稍微吃点东西。或者稍微睡上一会儿？你想多留一阵子吗？"
    }
    {
      Id = "Medea_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，{#Emph}正有此意……"
    }
    {
      Id = "Medea_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "……无论如何，波吕斐摩斯大人，我们是不该这样私下交谈的，毕竟这与我的职责不符。但如果您需要别的药草或是毒药，我就住在离这不远的地方。"
    }
    {
      Id = "MelinoeField_3663"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，就算没有匿踪者之誓的作用，您也还是要和波吕斐摩斯沆瀣一气吗？真是难以置信！他可是几次三番想要把我吃进肚子里去啊！"
    }
    {
      Id = "Polyphemus_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这块肉，这叫什么态度。女巫都说了她不想跟你说话。你有什么要说的，就冲着{#Emph}我{#Prev}来啊。"
    }
    {
      Id = "Medea_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "郊区真是安静得令人毛骨悚然！我早就习惯了闹市区的喧嚣，以及弥留其中的血腥、腐烂的气息。"
    }
    {
      Id = "MelinoeField_3816"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，赫卡忒老师知道您在这里的所作所为么？她没有提起过您要考验我的事。"
    }
    {
      Id = "Medea_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人无所不知、无所不晓。但现在，既然匿踪者之誓为你掌控，誓言的后果自然也是由你来定。而今夜，你立下了敌手之誓！你不知道，我等这一夜等了多久……"
    }
    {
      Id = "Medea_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真的只能做黑暗中的一道阴影么……？若是出手相助的同时，还能出言相激，那该有多好。波吕斐摩斯大人，替我跟她多说点话，好么？"
    }
    {
      Id = "Polyphemus_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啊，你说了算，女巫。来吧，就让我跟这块肉好好{#Emph}培养一下感情{#Prev}。"
    }
    {
      Id = "Polyphemus_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，有这个女巫在旁边还{#Emph}真不赖{#Prev}。我平常不咋爱说话，更多靠闻的和听的，你懂的。所以我不如让她多说点……"
    }
    {
      Id = "Medea_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "容我暂且打破我的沉默之誓，女术士，但你这副模样真是{#Emph}狼狈{#Prev}！{#Emph}半死不活{#Prev}都不足以形容你有多接近{#Emph}死亡{#Prev}。而现在，独眼巨人和我将会把你进一步逼向极限。"
    }
    {
      Id = "MelinoeField_3818"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在埃费拉城里确实遇到了些麻烦，感谢您的关心。我知道黑夜的意志不允许您在这里对我有丝毫怜悯。"
    }
    {
      Id = "Medea_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "依我看，你现在要担心的，恐怕不是黑夜的意志……波吕斐摩斯大人早就已经{#Emph}垂涎三尺{#Prev}了。这就是血腥气息的魔力！尤其是{#Emph}你{#Prev}的鲜血格外甜美。"
    }
    {
      Id = "Medea_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "角落里那些该死的解毒池……毒茄参在浸血的土壤中生命力格外旺盛，但与此同时它们也过滤出了毒素。算你走运。"
    }
    {
      Id = "MelinoeField_3819"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的毒素毒性实在剧烈，我一中招就感觉仿佛全身都烧了起来，哪怕解毒池就在附近。"
    }
    {
      Id = "Medea_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "谬赞了，女术士，我只是尽力而为！你甚至还会发现，无论你被中毒多少次，你都不会产生抵抗力……至于免疫就更不要想了。"
    }
    {
      Id = "Medea_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "通常来说，我的诅咒和毒药相当致命。但你居然可以抵御它们！我不知道是该欣赏你，还是该对自己感到失望。"
    }
    {
      Id = "MelinoeField_3931"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为这是对我的能力和进步的测试呢！结果好像要测试的是您最新的实验成果啊。"
    }
    {
      Id = "Medea_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定要非此即彼么？赫卡忒大人教导我们，学习永无止境。只有这样，才能化作最为致命的毒药……"
    }
    {
      Id = "Medea_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是世事无常啊，女术士！我们刚刚还在我的炼金釜旁有说有笑，而现在却走到了{#Emph}这一步。"
    }
    {
      Id = "MelinoeField_3932"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道您在这里是因为我们立下的誓言，美狄亚女士。但这位独眼巨人就没有这么好的理由了……"
    }
    {
      Id = "Medea_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，你闯入了他的领地，这是其一；而他现在饥肠辘辘，这是其二！看看他啊，他都饿得说不出话来了。波吕斐摩斯大人，你得说点什么！"
    }
    {
      Id = "Polyphemus_0508"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我看这次，就让我的{#Emph}脚{#Prev}替我说话吧！"
    }
    {
      Id = "Medea_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，女术士！看来你是下定决心要将誓言贯彻到底了。你的对手仍然是波吕斐摩斯大人，因此在这之后请容我尽可能保持沉默。如此失礼并非我的本意。"
    }
    {
      Id = "MelinoeField_3817"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道您来这里是因为形势所迫，美狄亚女士，所以我显然没有敌意。唔，至少对您没有，但是对{#Emph}波吕斐摩斯“大人”{#Prev}，我就不太确定了。"
    }
    {
      Id = "Medea_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "这下他又生气了。希望你理解，我对独眼巨人的行为概不负责……就连我自己的行为，都不见得是{#Emph}我{#Prev}的责任。"
    }
    {
      Id = "Medea_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我还蛮喜欢这里的！虽然我很喜欢在城市一隅开展自己的实验，但是偶尔在户外活动活动也有益身心。"
    }
    {
      Id = "MelinoeField_3815"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是您各种各样的毒药也能“有益身心”就好了，美狄亚女士。黑夜的意志难道没有禁止我们使用某些毒物么？"
    }
    {
      Id = "Medea_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样么……？或许是最近的章程更新我还不太熟悉；不过比起血液里的些许毒素，现在的你还有更大的麻烦。{#Emph}喔，独眼巨人……？"
    }
    {
      Id = "Polyphemus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "没看到我忙着呢吗？我什么也看不到。我有抱怨过吗？没有。我只是闷头放羊。"
    }
    {
      Id = "Melinoe_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "像你的羊这样神经兮兮的动物，我还真是第一次见。"
    }
    {
      Id = "Polyphemus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "羊跑得很快。这活不容易。而且当有人在我地盘上吵个不停的时候，就更难了。所以，我还有什么选择呢？只能把你吃掉了，对不对？"
    }
    {
      Id = "Polyphemus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "你本来可以和我做朋友的。说不定我还能送你两只羊。但是，你居然嘲笑我的眼睛。"
    }
    {
      Id = "Melinoe_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没做过这种事。我只是需要通过这里前往码头。但你每次都非要挡我的路。"
    }
    {
      Id = "Polyphemus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你该学学换位思考。你是我的话，会怎么做呢？你会说：{#Emph}“我不喜欢你对待我的方式，我要把你吃掉。”"
    }
    {
      Id = "Polyphemus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在努力控制饮食。一日三餐，定时定量，不吃零食。可是每次你一来，计划就泡汤了。"
    }
    {
      Id = "Melinoe_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我们那，上弦月期间是禁食的，而且我们会种很多营养丰富的植物和真菌。你想要的话，不如下次我给你带一些来？"
    }
    {
      Id = "Polyphemus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我不能把你留着以后再吃。因为你会逃跑。你们这些人最喜欢逃跑。哦，我有办法了！我先把你的腿吃掉！"
    }
    {
      Id = "Melinoe_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想得美。"
    }
    {
      Id = "Polyphemus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁让你直接叫我名字的，嗯？我可从来没跟你介绍过我自己。怎么，下次你是不是就要叫我一声“老波”，跟我称兄道弟了？"
    }
    {
      Id = "MelinoeField_2858"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这家伙见着活的就想吃掉，恐怕没有什么能{#Emph}称兄道弟{#Prev}的人吧。不过，我们还是可以交朋友的！咱们就把你想要吃我那码事抛诸脑后吧，你说怎么样？"
    }
    {
      Id = "Polyphemus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不行！{#Prev}我朋友已经够多了。后面养着的那些羊，还有下面埋着的那些死人。不过，我真正需要什么，你是{#Emph}知道{#Prev}的吧？嗯，我觉得你知道。"
    }
    {
      Id = "Polyphemus_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里生活，有好也有坏。比如说最近，经常有人来打扰我，但我的睡眠质量没得说。我也不知道，也许我该搬走才是……"
    }
    {
      Id = "MelinoeField_3164"
      InheritFrom = "BaseNarrative"
      DisplayName = "我非常支持这个决定。话说回来，你本来就更习惯在海岛上生活，对吧？城市生活，哪怕是在这样的城郊地带……对你来说节奏都太快了。"
    }
    {
      Id = "Polyphemus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道{#Emph}你{#Prev}想让我做什么。不过，说到海岛生活，我确实很是想念。仍然时不时会有讨厌的家伙打扰我，但远没有现在这么频繁。"
    }
    {
      Id = "Polyphemus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只想一个人呆着。搬到乡下，做个安安静静的牧羊人。但你偏偏要来打乱我的退休计划。"
    }
    {
      Id = "MelinoeField_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没做过这种事。我要去码头。是你主动要来阻止我的。你本来可以好好管教你的羊群的。"
    }
    {
      Id = "Polyphemus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我会{#Emph}管教{#Prev}好我的羊群的。但在那之前，我得先好好管教{#Emph}你{#Prev}这种人。以前这种事我可没少做。"
    }
    {
      Id = "Polyphemus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "（叹气）听着，我只是个平凡的牧羊人，想要与世无争地生活。但你要明白，我得保护我自己的羊群。此外，我还得吃东西。"
    }
    {
      Id = "MelinoeField_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "你管这叫与世无争？！也许你在妨碍我之前应该再好好想想，我可是在想办法扑灭这肆虐的战火……！"
    }
    {
      Id = "Polyphemus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "战死的人从不会打扰我。反倒是活着的人总来给我添麻烦。还好，{#Emph}活着的人{#Prev}比{#Emph}战死的人{#Prev}更好吃。"
    }
    {
      Id = "Polyphemus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我每次在这个宁静的牧场，隔着大老远就能听到你在镇子上闹出来的动静。甚至在我的羊被吓到之前。"
    }
    {
      Id = "MelinoeField_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我意识到天上掉下来的那些石头全落在我身边不是什么巧合了。你的听力非常棒，准头也不错。"
    }
    {
      Id = "Polyphemus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，谢谢。我敢肯定，你的{#Emph}口味{#Prev}也非常棒。现在站好别动，让我再练习练习我{#Emph}“不错的准头”{#Prev}。"
    }
    {
      Id = "MelinoeField_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次你都知道我来了，哪怕我的脚步放得再轻，或者再怎么掩盖我的气味都一样。你的感官真是锐利。"
    }
    {
      Id = "Polyphemus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，毕竟，当你失去了眼睛的时候……你就得学会用其他感官弥补。而且我的眼力本来也不怎么样。我从来就没法分辨一个东西是近是远。"
    }
    {
      Id = "MelinoeField_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算这样，失去眼睛也肯定特别不好受。而现在，你就用这些增强的感官牧羊……"
    }
    {
      Id = "Polyphemus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "“增强的感官”，我喜欢这种说法。听着，这个世界是个丑陋的地方。我和你之间的区别就在于，我不再用盯着这个世界看了。现在，站好了……或者拼命跑吧，对我来说压根没有区别。"
    }
    {
      Id = "MelinoeField_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你这么在意你的羊群，为什么非要让它们置身危险之中呢？更别说把它们囫囵吞掉了。现在就让它们离开这里吧。"
    }
    {
      Id = "Polyphemus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说什么？我才不需要你来教我怎么牧羊，而且……这些羊又没其他地方可去。再说了，咱们可是它们的{#Emph}晚餐节目{#Prev}。"
    }
    {
      Id = "Polyphemus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道是谁这样羞辱我吗？没有人。没有人抢走了我的羊，没有人夺走了我的眼睛。"
    }
    {
      Id = "MelinoeField_2447"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是啊，有的时候怪不了别人，只能怪自己。"
    }
    {
      Id = "Polyphemus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "总有一天，没有人会为此付出代价。但你嘛，现在你就该还债了。哈。当然，我只是在打比方！我不想要你的钱。我只想把你……一口吞进肚子里。"
    }
    {
      Id = "MelinoeField_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前说过，没有人夺走你的眼睛，没有人抢走你的羊。那你是怎么失去它们的？"
    }
    {
      Id = "Polyphemus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有人对我耍了阴招，就这么简单。有一群水手以为他们可以带上我的羊，然后溜之大吉，所以我就吃掉了几个。我是说，吃掉了几个水手！但在我不注意的时候，没有人暗算了我。然后他就跑掉了……"
    }
    {
      Id = "MelinoeField_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你之后一直想要报复这个“没有人”，是吗？"
    }
    {
      Id = "Polyphemus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我自己没这个打算！总有一天，总有人会让没有人付出代价。不过，今天，我就要让你在这里{#Emph}付出代价{#Prev}。"
    }
    {
      Id = "Polyphemus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "怪不得{#Emph}没有人{#Prev}是你的朋友。除了你之外，能从我手上逃掉的，也就只有他和他那些狐朋狗友了。就是那个一无是处的垃圾派你来对付我的？"
    }
    {
      Id = "MelinoeField_1949"
      InheritFrom = "BaseNarrative"
      DisplayName = "他的大名叫奥德修斯！他是一位伟大的战术家，是个英雄。不过你不用惦记着杀死他这件事了，因为他早就死了。再也用不着你费心了。"
    }
    {
      Id = "Polyphemus_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管他是死是活，我都要把他吃掉。不管他说自己叫什么，他在我眼里都是个无名小卒。现在，就让你替他见识见识我的厉害，怎么样？"
    }
    {
      Id = "Polyphemus_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "这次{#Emph}没有人{#Prev}没和你在一起，是吗？那家伙就是擅长跑路。我知道我看过他最后一眼，嗅到过他最后一缕气息，而现在，也许我也听完了他最后一句话。"
    }
    {
      Id = "MelinoeField_4359"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我不觉得奥德修斯有常来拜访的打算。这意味着你没机会听到他第一次从你那逃走后发生的事了。那个故事很精彩呢！"
    }
    {
      Id = "Polyphemus_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "有什么大不了的。没有人是个鬼鬼祟祟的贼……谁会想跟那种人有什么故事？"
    }
    {
      Id = "Polyphemus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}（嗅、嗅） {#Prev}你知道么，我闻过的东西，从来都忘不了。而你身上有着很久很久以前我所熟悉的味道。我认得出这些骨头。在你之前，{#Emph}没有人{#Prev}拿过它们。"
    }
    {
      Id = "MelinoeField_1948"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说的一定是这些羊拐骨……如果它们曾经让你倒过霉的话，那也许你就该知道，接下来你要面对什么了。"
    }
    {
      Id = "Polyphemus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}没有人{#Prev}是你的{#Emph}朋友{#Prev}，你是这个意思吗？那我首先要碾碎你的骨头，接着要把你整个吃掉。还有那些羊拐骨，我也不会放过。"
    }
    {
      Id = "Polyphemus_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，晚餐，闻起来好像你又把那些羊拐骨带来了啊。真的是{#Emph}没有人{#Prev}给你的，是么？"
    }
    {
      Id = "MelinoeField_4356"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不如亲口问问他，独眼巨人。{#Emph}奥德修斯，聆听我的呼唤；你求见之人，就在我的身畔！"
    }
    {
      Id = "Polyphemus_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}没有人……{#Prev}一点也闻不出来是你，但这是你的声音没错。为什么不{#Emph}靠近一点{#Prev}，让我好好闻闻呢？"
    }
    {
      Id = "Odysseus_0571"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕现在的我你是吃不掉了，独眼巨人，因为我已经死了很久了。在你面前的只是一个暗灵的投影，但我确实想跟你说两句话！"
    }
    {
      Id = "Polyphemus_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你真的死了啊。我一直想着亲手杀死你。结果又是你笑到了最后。"
    }
    {
      Id = "Odysseus_0572"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是来笑你的，只是来问你个问题。当初你抓住了我和我的人，杀了其中几个，最后却在我们逃亡途中被刺瞎了眼睛……这一切值得么？"
    }
    {
      Id = "Polyphemus_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我吃过的饭，一般都不会记得。这应该很正常吧。不过你的船员，我记得一清二楚……肉质很紧实，在太阳底下发酵了很久。但你要说值不值得拿我的眼睛来换？{#Emph}不值。{#Prev}那次我吃了大亏。"
    }
    {
      Id = "Odysseus_0573"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也替我、替他们感到不值。啊，那好吧！看来我们都给彼此留下了苦涩的伤疤啊。只不过我的创伤只是精神上的。那接下来，就让王女收拾你吧，你个混蛋杀人魔。"
    }
    {
      Id = "Polyphemus_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "滚一边去，伙计。反正我压根就没想再见到你。"
    }
    {
      Id = "MelinoeField_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于一个“与世无争”的牧羊人来说，你可真够顽固不化的。是波塞冬跟你有什么仇什么怨吗？这码事难道是因为{#Emph}这个{#Prev}？"
    }
    {
      Id = "Polyphemus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我从不{#Emph}记仇{#Prev}……我有仇都是{#Emph}当场{#Prev}报的。好了，问题时间结束……现在到{#Emph}吃饭{#Prev}时间了。"
    }
    {
      Id = "MelinoeField_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "我发誓，这是我最后一次提到波塞冬了。不过，你知道么，他是我叔叔。虽然不知道这样说有什么分量……但是，如果他真的让你误以为你是他儿子的话，我对此很抱歉。"
    }
    {
      Id = "Polyphemus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，好吧，我确实喜欢假装什么“有其父必有其子”，万一呢。但知道他不是我真正的爸爸，我也很高兴。毕竟要不然的话，待会儿我要吃掉的，就是我自己的小堂妹了。那样就太怪了。"
    }
    {
      Id = "Polyphemus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "喂，所以，你跟克洛诺斯又有什么仇？他想带来改变，那又怎么样。这里的生活很艰难。说不定会变得更轻松一些。"
    }
    {
      Id = "MelinoeField_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会的。那边那座城，你口中的那个“镇子”，本应该生机勃勃。现在它成了一道溃烂的创口，一座死城。这都是那个泰坦的功劳。"
    }
    {
      Id = "Polyphemus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的羊，只要活着就很开心。它们从不抱怨。但像你这样的家伙呢？你有太多“理想”了。我看我还是直接把你{#Emph}吃掉{#Prev}吧，省得琢磨这些有的没的。"
    }
    {
      Id = "MelinoeField_2829"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，你这样徒劳无功地阻拦我，克洛诺斯到底会给你什么回报？"
    }
    {
      Id = "Polyphemus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道关你这块肉什么事。是你闯到我的牧场里来，还把我的镇子搅得一团糟；把你撵走是我的分内之事。"
    }
    {
      Id = "MelinoeField_2830"
      InheritFrom = "BaseNarrative"
      DisplayName = "埃费拉城不是你的镇子。除非泰坦是这么给你安排的，但这座城也轮不到他分配。总之，准备好收获你今晚的报酬了吗？"
    }
    {
      Id = "Polyphemus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你对我的{#Emph}安排{#Prev}一无所知。首先，我总是先拿钱后办事。只不过有你在……我就有{#Emph}额外奖励{#Prev}。"
    }
    {
      Id = "Polyphemus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚的空气很{#Emph}污浊{#Prev}。而且并不仅仅是来自{#Emph}你{#Prev}，或者是镇子上的腥臭味。一定又是那个没安好心的女巫。你们俩是一伙的？"
    }
    {
      Id = "MelinoeField_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你认识美狄亚女士的话，那你一定该知道，她不是好惹的。她会毫不犹豫的为我的敌人降下诅咒，包括你。"
    }
    {
      Id = "Polyphemus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是个威胁么？我觉得是。你不能这样到处威胁人，至少在这个镇子里不行。你的{#Emph}小伙伴{#Prev}知道该躲在我闻不到她的地方。她比{#Emph}你{#Prev}聪明得多。"
    }
    {
      Id = "MelinoeField_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么你每次都要阻拦{#Emph}我{#Prev}，而大力士赫拉克勒斯却可以想去哪就去哪，永远不会被你找麻烦？至少他是这么说的。"
    }
    {
      Id = "Polyphemus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "这叫{#Emph}双标{#Prev}，小羊羔。就算没有眼睛，我也知道他的块头比你大得多。挨你一顿揍，我正好打个盹儿；挨他一顿揍，够我睡到下周的了。还是算了吧。"
    }
    {
      Id = "Polyphemus_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "我熟悉你的气味，但你到底长什么样，我一点头绪都没。也许你长得跟我牙缝里塞的这根牧羊杖差不多吧。毕竟你身上一点肉都没有。"
    }
    {
      Id = "MelinoeField_3159"
      InheritFrom = "BaseNarrative"
      DisplayName = "说不定你知道我的样貌的话，就没那么容易把我当作牲口看待了吧。我有着一头浅色头发，颜色像小麦一样；身披藏红花裙和白银甲胄，手中则是在混沌深渊中铸造的暗夜武器。"
    }
    {
      Id = "Polyphemus_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，小麦和藏红花！加点羊奶，再加点海盐，这个那个的，然后往火里一丢……就是香喷喷的烤面包了。"
    }
    {
      Id = "MelinoeField_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "其他的独眼巨人都去哪了？你们的族人曾经帮助众神战胜了泰坦，为他们打造了武器之类的。但{#Emph}你{#Prev}如今却对他们倒戈相向……"
    }
    {
      Id = "Polyphemus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么，你以为我们最多只有一只眼，就要“保持接触”吗？他们做过什么，后来怎么样了，我都不在乎。尤其是当我{#Emph}饿了{#Prev}的时候，就更不在乎了……"
    }
    {
      Id = "Polyphemus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前你说，你是什么{#Emph}不死不灭的冥界王女{#Prev}？听起来阳间不是你该待的地方。"
    }
    {
      Id = "MelinoeField_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要去拜访我的亲戚们。但你总要拦我的路。好像比起安逸的牧羊生活，你更喜欢杀个你死我活。"
    }
    {
      Id = "Polyphemus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦呦，你这块肉好像还长了个脑子嘛！安逸的退休牧羊生活是一回事，适当运动增进食欲又是一回事，压根不冲突，难道不是吗？"
    }
    {
      Id = "Polyphemus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅）你身上散发着亡者的恶臭。但你不是从镇子上来的。你来自下面。恐怕阳间不是你该待的地方。"
    }
    {
      Id = "MelinoeField_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "城门口那道屏障是你弄出来的吗？那上面画满了克洛诺斯的标志，而你看起来就像是屏障失效时的备用措施。"
    }
    {
      Id = "Polyphemus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，{#Emph}那个{#Prev}东西啊，嗯。我知道它永远拦不住你的。但他们还是每次都会去把它修好。就好像有人不想让你来这里一样……"
    }
    {
      Id = "Polyphemus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "那边那些码头是我亲手建造的。我在那边认识些人，但凡是海面上的船，无论是小艇还是战舰，他们都会清点清楚。我们知道你要去哪。"
    }
    {
      Id = "MelinoeField_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们知道了又怎么样？你不过是克洛诺斯的一个仆人罢了。等这一切尘埃落定，众神会找你算账的。"
    }
    {
      Id = "Polyphemus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，你又懂了？那些神只在意他们自己人。我对他们来说就是个笑话罢了。但是对{#Emph}你{#Prev}来说呢？你觉得我是个笑话吗？"
    }
    {
      Id = "Polyphemus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前那晚，在我睡着的时候，你从我的谷仓里穿了过去。你本可以把那里抢个精光，但你没有。你只是在我的井里喝了口水，然后就上路了。"
    }
    {
      Id = "MelinoeField_1929"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又不是贼。再说了，你住的那地方脏死了！与其挡我的路，你还不如花些时间把那里好好收拾收拾。需要帮忙的话跟我说一声就好，反正我很快就要再从那里经过。"
    }
    {
      Id = "Polyphemus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用了，谢谢。那里要是干干净净的话，我的鼻子就不灵了。还有，你给我{#Emph}闭嘴{#Prev}！{#Emph}我{#Prev}可从来没有对{#Emph}你{#Prev}的生活习惯指指点点！"
    }
    {
      Id = "Polyphemus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，你到底是以为自己能去哪？在后面那座港口上，不可能找得到愿意载{#Emph}你这种人{#Prev}的船。话说回来……最近那里一艘船都没有了。"
    }
    {
      Id = "MelinoeField_1947"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯的不死舰队仍然在色萨利裂谷中航行。据我所知，每当一艘船沉没的时候，就会有另一艘船从深渊中升起取而代之，船上满载着早已溺死的水手……"
    }
    {
      Id = "Polyphemus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "扯什么淡。现在死人都会开船了？我还以为他们只能拿来当吃的呢。也许我该教教他们，让他们帮我做些家务……"
    }
    {
      Id = "Polyphemus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以裂谷那头怎么样？听说那边在下雪，冻得要死。住在那个破烂地方一定糟透了。"
    }
    {
      Id = "MelinoeField_2831"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你是说奥林匹斯山吗？山上的众神很喜欢那里，所以现在正跟你所支持的那个泰坦的军队打得不可开交。不过……你说得没错，那里是很冷。"
    }
    {
      Id = "Polyphemus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，我永远没可能去那种地方安家。我对气候的态度和我对食物一样，最好是热乎的。当然，生吃食物我也不介意。总不能太挑剔嘛。"
    }
    {
      Id = "Polyphemus_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "死人……有时候也会说话，或者说，试着说话。毕竟他们在这里没什么别的事干。知道他们在说什么吗？我最开始听不太清，但听起来似乎很像……{#Emph}普罗米修斯。"
    }
    {
      Id = "MelinoeField_3165"
      InheritFrom = "BaseNarrative"
      DisplayName = "先见泰坦。虽然你们可能还没见过面，但他是你的盟友之一；毕竟你们侍奉的似乎是同一个主子。所以那些亡灵谈起普罗米修斯，具体都说了些什么？"
    }
    {
      Id = "Polyphemus_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "基本上只是些咕哝。也许是他们跟我一样，肚子饿了吧！毕竟，如果我听到的故事没错，普罗米修斯真的从众神那里偷了火种……那他说不定很懂烤肉。"
    }
    {
      Id = "MelinoeField_3166"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还记得我们第一次见面的时候，你在我眼里{#Emph}硕大无朋{#Prev}……比我面对过的绝大多数对手都大得多。但现在，你已经很难算得上是我的对手了。"
    }
    {
      Id = "Polyphemus_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，谢谢。我也还记得我们第一次见面的时候，我的睡眠周期一塌糊涂！但现在好多了。而且我的身材还保持的不错！“硕大无朋”，是吧？"
    }
    {
      Id = "MelinoeField_3167"
      InheritFrom = "BaseNarrative"
      DisplayName = "后来我才明白，事物的大小都是相对的。比如说，在众魔之父——提丰面前，你就是个小不点。他才是真正的“硕大无朋”。"
    }
    {
      Id = "Polyphemus_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我就姑且相信你吧。不过话说回来，他又能有多大？要我猜的话，分成三顿吃，怎么都能吃得下。好久没尝过怪物肉了……"
    }
    {
      Id = "Polyphemus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "有意思。真没想到，自从反反复复遇上你之后，我的睡眠质量得到了质的飞跃。"
    }
    {
      Id = "MelinoeField_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？那如果你原地站好，不要还手的话，我把你打晕还更容易呢。"
    }
    {
      Id = "Polyphemus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，重点是在于打斗本身。我不全力以赴的话，是没办法得到优质睡眠的。更何况还有美餐一顿的机会。"
    }
    {
      Id = "MelinoeField_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，要是你有睡眠障碍的话，一定有别的办法可以治，不需要非得时不时挨我一顿揍。"
    }
    {
      Id = "Polyphemus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我试过很多办法。吃饱了睡觉。饿着肚子睡觉。都不管用。但这个呢？这个目前管用得很……"
    }
    {
      Id = "Polyphemus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅）我闻到了{#Emph}血的味道{#Prev}。我正打算准备下一餐饭呢……但是镇上的迎宾委员会好像已经帮我把你准备妥当了。"
    }
    {
      Id = "MelinoeField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "你口中的“迎宾委员会”，不过是克洛诺斯的走狗……而且他们会为他们的傲慢付出代价。你该不会真的想把赌注都押在他们身上吧？"
    }
    {
      Id = "Polyphemus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我以前对于会盯着我看，或者会对我说话的食物，总有些不太能接受。但现在这点已经不再困扰我了。"
    }
    {
      Id = "Polyphemus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，我能感觉到，镇上的迎宾委员会已经把你收拾了一顿。把你的肉都打得{#Emph}松松软软{#Prev}的。正好让我下口。"
    }
    {
      Id = "MelinoeField_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "那座城里全是没有埋葬的亡者。我能杀掉他们，但他们只会再次醒来，非常烦人。你也一样。"
    }
    {
      Id = "Polyphemus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有什么可烦的。这是{#Emph}我的{#Prev}牧场，不是你的。而且这里的每只小羊羔都要听{#Emph}我{#Prev}使唤。"
    }
    {
      Id = "Polyphemus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇！上一次正当我以为拿下你了的时候，你却溜走了。没想到你还会回来，再给我一次机会。"
    }
    {
      Id = "MelinoeField_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "你后面还会有大把{#Emph}机会{#Prev}。但你每一次都会失败，我向你保证。"
    }
    {
      Id = "Polyphemus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "还不如保证让我尝尝你{#Emph}骨头上的肉{#Prev}。虽然我感觉你身上也没多少。"
    }
    {
      Id = "Polyphemus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不喜欢玩弄我的食物。更不喜欢{#Emph}被我的食物玩弄{#Prev}。你那个突然消失的把戏，这次我会格外留意的。"
    }
    {
      Id = "MelinoeField_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是不死不灭的冥界王女；在你得手之前，暗影便会将我带走。你还是要无休无止地与我打下去吗？"
    }
    {
      Id = "Polyphemus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "那当然！每个人都会失手的，就连你也一定不意外。等你失手的时候……我倒要看看你所说的“不死不灭”到底是真是假。"
    }
    {
      Id = "Polyphemus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次差点就被你打倒了，但还是差了一点。你是回来完成任务、要我小命的吗？那你不会是第一个。但是我还活得好好的，而其他想要我小命的人，猜猜他们都怎么着了？"
    }
    {
      Id = "MelinoeField_1946"
      InheritFrom = "BaseNarrative"
      DisplayName = "要{#Emph}什么{#Prev}小命？你不是我的任务目标。我宁愿从你身边溜过去，跟你井水不犯河水，只可惜你那该死的嗅觉和听觉实在是太灵敏了。"
    }
    {
      Id = "Polyphemus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，谢谢夸奖。那你一定知道我是怎么锻炼听觉和嗅觉，让它们保持灵敏的，对吧？当你有这样的天赋的时候，就得{#Emph}勤加利用{#Prev}才行。"
    }
    {
      Id = "Polyphemus_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿！我想跟你说声谢谢。上次我被你揍完之后，睡得可舒服了，你知道吗？"
    }
    {
      Id = "Melinoe_0938"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又回来了。而且你还很感谢我上次打败了你？我还以为你是会记仇的那种。"
    }
    {
      Id = "Polyphemus_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是当然，只不过……我不知道多久没有踏踏实实地睡上一觉了。被你打晕之后，我一觉醒来，感觉从来没有这么精神过！而且还饿得很。"
    }
    {
      Id = "Polyphemus_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "啧！别想着从我旁边溜过去。怎么，你以为我会刚好在这打盹吗？没可能的事。"
    }
    {
      Id = "Melinoe_0939"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁知道呢。你还是执意挡我的路的话，只会再挨一顿揍，用不了多久就会被我送入梦乡。这就是你想要的吗？"
    }
    {
      Id = "Polyphemus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！真是两难的选择！我一直都很困，没错。但也一直都很饿。这样说来，看来我是{#Emph}稳赚不赔{#Prev}了啊。"
    }
    {
      Id = "Polyphemus_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "事情不太对劲时，我总能察觉得到；就比如说现在。你到底在打什么主意，晚餐？总不能是专门来做我的盘中餐吧。虽然你想从我这里溜走时，时不时就会落得那样的下场。"
    }
    {
      Id = "MelinoeField_3160"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我没打算从你这里溜走；事实上，我这次是为{#Emph}你{#Prev}而来，独眼巨人。万物的本源想要看看我有没有能力把你送入梦乡。"
    }
    {
      Id = "Polyphemus_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}万物的本源……？{#Prev}所以你是接了个任务，要来干掉我，是{#Emph}这么个意思{#Prev}吗？好啊，你可不是第一个想这样做的人。那就让我向你{#Emph}演示{#Prev}一下，其他想这样做的人都是什么样的下场吧。"
    }
    {
      Id = "Polyphemus_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿！万物的本源想让我跟你说一声， 你实在是差得远，所以你的任务取消了。而且，现在我可以吃掉你。"
    }
    {
      Id = "MelinoeField_3161"
      InheritFrom = "BaseNarrative"
      DisplayName = "很难相信原初混沌会因为这种事情而联络{#Emph}你{#Prev}。恐怕这都是这场试炼的一部分吧。"
    }
    {
      Id = "Polyphemus_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果这是某种{#Emph}试炼{#Prev}的话，那我就是裁判了。我在此判决你为{#Emph}晚餐{#Prev}。希望你和你的{#Emph}原初混沌{#Prev}朋友对此没有异议。"
    }
    {
      Id = "Polyphemus_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "我脖子后面汗毛直竖，而且不是因为你。也有可能是因为你，但是……感觉就像我被人当作目标了似的。好一阵子没有过这种感觉了。"
    }
    {
      Id = "MelinoeField_3162"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是针对你，独眼巨人。但黑夜的誓言要求我打败你。至于内在的原理，你就不用费心思琢磨了，不如我们直接开打吧。"
    }
    {
      Id = "Polyphemus_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "黑夜的什么玩意？你说的前一段话我半个字都没听清，但你要{#Emph}直接开打{#Prev}，我可就来劲了！"
    }
    {
      Id = "Polyphemus_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你可以影响夜里事物运作的规律？凭我的直觉，以及你说的那些莫名其妙的话，我就能感觉出来你没安好心。你是什么{#Emph}女巫{#Prev}吗？"
    }
    {
      Id = "MelinoeField_3163"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里不止美狄亚女士会用巫术。既然你终于意识到我们真正的力量了，那我就提醒你一下：你挡我的路，就是在违背黑夜本尊的意志。"
    }
    {
      Id = "Polyphemus_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看，你又开始说莫名其妙的话了。不过，我正好也有种莫名其妙的食欲！就拿你开开胃吧。"
    }
    {
      Id = "MelinoeField_3163_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你终于意识到我们真正的力量了，那我就提醒你一下：你挡我的路，就是在违背黑夜本尊的意志。"
    }
    {
      Id = "MelinoeField_4123"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不用再为泰坦克洛诺斯效力了，独眼巨人！他与奥林匹斯众神之间的战争结束了，如果你还没听说过的话。我对你没有敌意。你快走吧！"
    }
    {
      Id = "Polyphemus_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还正纳闷为啥没人给我付钱了呢。还以为是我最近牧羊牧得不咋样。"
    }
    {
      Id = "MelinoeField_4124"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯之前难道是雇你来{#Emph}牧羊{#Prev}的吗？我还以为他是要你看守城镇的大门。"
    }
    {
      Id = "Polyphemus_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "你什么都不懂。你真的以为，我跟我的羊群一起经历了那么多事，现在却要抛下它们吗？混口饭吃而已，总有别的办法的。"
    }
    {
      Id = "MelinoeField_4125"
      InheritFrom = "BaseNarrative"
      DisplayName = "看得出你没有听从我上次的劝告，为了你的羊群好，带它们离开这里。也对，毕竟你只是把它们当作食物。你打算在这里阻拦我到什么时候？"
    }
    {
      Id = "Polyphemus_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "应该还要一段时间。这儿有我的羊群，有我的谷仓，最近我睡得还很好……非得搬家不可么？搬去别的地方？得把东西全收起来，再全铺开，我可不想那么麻烦。"
    }
    {
      Id = "MelinoeField_4126"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能过上这么舒服的生活真是幸运，而我偏偏有你挡在路上，真是倒霉。"
    }
    {
      Id = "Polyphemus_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这是住在这里的又一个优点：每晚都能做运动。"
    }
    {
      Id = "Polyphemus_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说那场战争结束了，是什么意思，啊？整座城都是老样子。没记错的话，亡者应该去地下，而不是在街上乱逛。"
    }
    {
      Id = "MelinoeField_4360"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们跟克洛诺斯的战争是结束了，只是……还有一些细节需要我们落实，而且冥界还需要一定程度的修缮，所以还没有恢复原先的秩序。"
    }
    {
      Id = "Polyphemus_0523"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，太糟糕了。我都想劝你下去帮帮他们了，可惜那样的话有可能会打乱我的睡眠习惯，而我最近碰巧又睡得很好。那就来吧，差不多该说晚安了。"
    }
    {
      Id = "MelinoeField_4361"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都交手这么多次了，你还不知道我的名字呢，是么，独眼巨人？对你来说，我仍然只是“晚餐”而已。"
    }
    {
      Id = "Polyphemus_0524"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，这可是你自己说的。而且，在这里咚咚跺脚，吓到我的羊的，{#Emph}又不是我{#Prev}……好吧好像有时候确实是我，但你懂的。"
    }
    {
      Id = "Polyphemus_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "有段时间没听到你的动静了！很高兴你又回来了。过去那么久，我的睡眠时间都快被吃完了。"
    }
    {
      Id = "MelinoeField_4364"
      InheritFrom = "BaseNarrative"
      DisplayName = "有那么一刹那，我还以为你是真的很高兴见到我。结果你只想让我把你打晕。"
    }
    {
      Id = "Polyphemus_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。要么就站住别动，让我把你吃掉。但你好像对那个不感兴趣，那就把我打晕吧。我这个人向来不挑剔。"
    }
    {
      Id = "MelinoeField_4362"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们没法一直这样下去，你知道吧，独眼巨人。未来某个时候，埃费拉城会重建，街道上会有熙熙攘攘的凡人，港口则是要出海的水手……而不是像现在这样。"
    }
    {
      Id = "Polyphemus_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "你算什么，神谕者吗？他们要是想把城镇重新建起来的话，那敢情好。到时候我就能过上{#Emph}饭来张口{#Prev}的日子了！现在嘛，只好先拿你将就一下了。"
    }
    {
      Id = "Polyphemus_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "我发现，我话说得太多，睡眠就会受到影响。也许我们该少聊点天，直接干正事。但我不想那么没礼貌，所以，你……你还有什么话要说吗，晚餐？"
    }
    {
      Id = "MelinoeField_4363"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那当然，你听好了：你永远吃不掉我，也永远阻止不了我，但我欢迎你继续尝试，也谢谢你的那些羊毛！"
    }
    {
      Id = "Polyphemus_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你说什么……所以这段时间里我那些羊毛全都是{#Emph}你{#Prev}偷的？哎呦，这回我是{#Emph}真生气{#Prev}了……"
    }
    {
      Id = "Polyphemus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "又越界了，小羊羔。你知道接下来会发生什么的。"
    }
    {
      Id = "Polyphemus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗅）什么东西这么臭……哦，我还说呢。原来是{#Emph}你{#Prev}啊。"
    }
    {
      Id = "Polyphemus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "别想溜过我的羊群。也别想溜过我。"
    }
    {
      Id = "Polyphemus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "总有一个晚上……我会把你抓住，然后一口吃掉。"
    }
    {
      Id = "Polyphemus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在离我的晚餐时间还有一阵子，不过嘛！计划是死的，人是活的。"
    }
    {
      Id = "Polyphemus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！你知道我隔着大老远就能闻到你了吧？"
    }
    {
      Id = "Polyphemus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "又来找死了，是吗？"
    }
    {
      Id = "Polyphemus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "想挨顿揍的话，随时欢迎。我最喜欢揍人了。"
    }
    {
      Id = "Polyphemus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "一般来说，我不喜欢吃生的。但是嘛，我又很喜欢尝试新鲜事物。"
    }
    {
      Id = "Polyphemus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}嘘！{#Prev}我好像听到了什么。你也听到了，对么？晚餐的钟声……"
    }
    {
      Id = "Polyphemus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "嚯，真想不到啊，又到晚餐时间了……"
    }
    {
      Id = "Polyphemus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "整天放羊，我的食欲越来越好喽……"
    }
    {
      Id = "Polyphemus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎回归羊群，小羊羔。现在，过来吧……"
    }
    {
      Id = "Polyphemus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前睡了个好觉，但吃的不够了……"
    }
    {
      Id = "Polyphemus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想要去港口，我想要吃掉你。就是这样。"
    }
    {
      Id = "Polyphemus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "在镇子上要记得小心落石哦。"
    }
    {
      Id = "Polyphemus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "送到嘴边的肉，哪有不吃的道理，何况是从镇外大老远运来的……"
    }
    {
      Id = "Polyphemus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真的该想个办法，别让你再次逃掉才行……"
    }
    {
      Id = "Polyphemus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又回来给我“放”了吗，嗯，小羊羔？"
    }
    {
      Id = "Polyphemus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "没人能进入这座城，也没人能离开；这就是规矩。"
    }
    {
      Id = "Polyphemus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "还真得谢谢你。最近我睡得就像小婴儿一样香甜。"
    }
    {
      Id = "Polyphemus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "放了一整天的羊，是时候享受一下被揍晕的感觉了。"
    }
    {
      Id = "Polyphemus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕我没法把你吃掉，我也至少能好好睡上一觉。"
    }
    {
      Id = "Polyphemus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来差不多该上床睡觉了。不过首先，我得运动一会儿……"
    }
    {
      Id = "Polyphemus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "真想一脚把你踢到月亮上，可惜我看不到月亮在哪。"
    }
    {
      Id = "Polyphemus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的想再被我踩两脚的话，乐意奉陪。"
    }
    {
      Id = "Polyphemus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想要和我的羊落得一样的下场，就继续来吧。"
    }
    {
      Id = "Polyphemus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你等着吧，早晚有一天你会落到我手上的。"
    }
    {
      Id = "Polyphemus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "还没到晚餐时间，但是话又说回来，我平常的晚餐吃得太晚了。"
    }
    {
      Id = "Polyphemus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "踩到我的草坪，就要付出代价，这就是规矩。"
    }
    {
      Id = "Polyphemus_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次你两下就把我放倒了，好久没睡得那么爽了！"
    }
    {
      Id = "Polyphemus_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次是一口肉都没尝到，但你总不能一直躲下去……"
    }
    {
      Id = "Medea_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "你拿着我最喜欢的勒瓦尔的形态呀！独眼巨人这下要倒霉了。"
    }
    {
      Id = "Medea_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神海拉的形态……我会很享受亲眼见证她力量的过程。"
    }
    {
      Id = "Medea_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜是个满月，月光刺目……在这样的夜晚，我都要羡慕您了，波吕斐摩斯大人。"
    }
    {
      Id = "Medea_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来正在炼制一种新的药剂，但是这种事情值得我放下手边的一切。"
    }
    {
      Id = "Medea_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的气味真是独特，尸体的味道和牧羊人的羊群交织在一起……"
    }
    {
      Id = "Medea_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的毒药是为夺人性命设计的，但对付不死不灭的神明也绝不含糊。"
    }
    {
      Id = "Medea_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "再一次在死亡的边缘起舞吧，女术士。"
    }
    {
      Id = "Medea_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "来向我们展示一下你对死灵术的理解吧。"
    }
    {
      Id = "Medea_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人需要我测试一下你的能耐。不介意的话，我们开始吧？"
    }
    {
      Id = "Medea_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里，我取你鲜血时可不会有丝毫迟疑，女术士。"
    }
    {
      Id = "Medea_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近的研究费了我不少心血；难得有这种换换心情的机会。"
    }
    {
      Id = "Medea_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "说不定我已经对你下了诅咒呢，女术士！看看你能不能解消我的魔法吧。"
    }
    {
      Id = "Medea_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "当心，免得我割开你细皮嫩肉的喉咙，就像宰杀呜咽的婴孩那般。"
    }
    {
      Id = "Medea_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "像这样的夜晚，总要有人献出鲜血。至于是你是我，就不得而知了。"
    }
    {
      Id = "Medea_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "鲜血很快就会洒落，但你不必担心；每一滴都将物尽其用。"
    }
    {
      Id = "Medea_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "敌人可不会因为你年纪轻轻就手下留情，女术士。"
    }
    {
      Id = "Medea_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，女术士！为我们之前对你做出的事情一雪前耻吧……"
    }
    {
      Id = "Medea_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听从黑夜意志的召唤。而且实话说，这种事情我求之不得。"
    }
    {
      Id = "Medea_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "你立下了敌手之誓，因此借用凡人的话说：{#Emph}你是自找的。"
    }
    {
      Id = "Medea_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的巫术可以在转瞬间杀死任何生灵，但你不在此列。只不过，中毒的过程还是会很不好受。"
    }
    {
      Id = "Medea_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么会对我的诅咒有如此之强的抵抗力，女术士……？"
    }
    {
      Id = "Medea_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "……好吧，波吕斐摩斯大人。看来我们只能改夜再叙了。"
    }
    {
      Id = "Medea_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "唤起黑夜的意志时，最好不要有丝毫退意。"
    }
    {
      Id = "Polyphemus_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……软绵绵的……"
    }
    {
      Id = "Polyphemus_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……好……唔唔……好痒……"
    }
    {
      Id = "Polyphemus_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我的……羊……"
    }
    {
      Id = "Polyphemus_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……好……好累……"
    }
    {
      Id = "Polyphemus_0186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……别……别想……"
    }
    {
      Id = "Polyphemus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我还在……睡觉呢……"
    }
    {
      Id = "Polyphemus_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……爸……晚点……再叫我……"
    }
    {
      Id = "Polyphemus_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……就……睡一会儿……"
    }
    {
      Id = "Polyphemus_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……羊……不许……乱跑……"
    }
    {
      Id = "Polyphemus_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "睡一小会……就起来……"
    }
    {
      Id = "Polyphemus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……啊……真舒服……"
    }
    {
      Id = "Polyphemus_0440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "三只羊……四只羊……五只羊……"
    }
    {
      Id = "Polyphemus_0441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……七只羊……八只羊……九只羊……"
    }
    {
      Id = "Polyphemus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "十只羊……呃呃……一只羊……两只羊……"
    }
    {
      Id = "Polyphemus_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哎呀，我也只是挑着吃了一点而已……"
    }
    {
      Id = "Medea_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "是你……"
    }
    {
      Id = "Medea_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来了……！"
    }
    {
      Id = "Medea_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "女术士……"
    }
    {
      Id = "Medea_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，是了。"
    }
    {
      Id = "Medea_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "独眼巨人。"
    }
    {
      Id = "Medea_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "谨遵黑夜的意志。"
    }
    {
      Id = "Medea_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "人都到齐了。"
    }
    {
      Id = "Medea_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "晚上好啊，二位。"
    }
    {
