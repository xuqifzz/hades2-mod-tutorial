{
  /*
  This file was autogenerated on 8/22/2025 at 4:13 AM
  by the BuildText tool.
  */
  lang = "zh-CN"
  Texts = [
    {
      Id = "MelinoeField_0718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿众神守护我们。"
    }
    {
      Id = "MelinoeField_0717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重，宙斯之子。"
    }
    {
      Id = "Heracles_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你们这些女巫……"
    }
    {
      Id = "Heracles_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哼。"
    }
    {
      Id = "Heracles_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哼。"
    }
    {
      Id = "Heracles_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}嗯。"
    }
    {
      Id = "Heracles_0425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "什么？"
    }
    {
      Id = "Heracles_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们不会的。"
    }
    {
      Id = "Heracles_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没那个必要。"
    }
    {
      Id = "Heracles_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我知道我自己的路。"
    }
    {
      Id = "Heracles_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别把我带上。"
    }
    {
      Id = "Heracles_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "引我们去哪？"
    }
    {
      Id = "Heracles_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别再这么叫我。"
    }
    {
      Id = "Heracles_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就是所谓的帮手？真让人无话可说。听我一句劝，{#Emph}妹子{#Prev}：别挡我的路，我的兵器可没长眼。现在，快滚，然后告诉派你来的人，我工作时一向单干。"
    }
    {
      Id = "MelinoeField_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的威胁我收到了，宙斯之子。我要去码头，不过我明白这座城市现在被封锁了。"
    }
    {
      Id = "Heracles_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你就该明白，是时候回头了。这座城镇{#Emph}死了{#Prev}，而且不会让活人通过。"
    }
    {
      Id = "MelinoeField_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是冥王之女；亡者都应当听命于我。他们也许只是需要一些激励。"
    }
    {
      Id = "Heracles_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "不怕死的话就试试吧。但别说我没警告过你。"
    }
    {
      Id = "Heracles_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，妹子。场面很快就要变得难看了，而我既不需要有人帮忙，也不需要有人见证。"
    }
    {
      Id = "MelinoeField_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要通过这里。而且直到背叛冥府之人全部倒在我们脚边之前，我是不会走的。"
    }
    {
      Id = "Heracles_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈！{#Prev}那好吧。那我们就各自为战。但恐怕我的胃口比你大得多。"
    }
    {
      Id = "Heracles_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "慢着，妹子。记住，之前的事一个字都不许说出去，否则别怪我不客气。我们可以好好杀上一场，然后各走各的路。"
    }
    {
      Id = "MelinoeField_3762"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后如果达成某种条件的话，也许我们会在我上山的路上再次相遇。多好的事啊。"
    }
    {
      Id = "Heracles_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "可不是嘛。看来我们达成了共识。那么，该让他们血流成河了。"
    }
    {
      Id = "Heracles_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说你取得了胜利，但我知道这不是结束。始终有更多事要做。那么，来吧。"
    }
    {
      Id = "Heracles_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看是谁又露面了。想挣点外快的话，那你来得正好。"
    }
    {
      Id = "Heracles_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在工作，妹子。你想帮一把的话，我不介意，别帮倒忙就行。"
    }
    {
      Id = "Heracles_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是不想跟你{#Emph}拉家常{#Prev}，但我有任务在身。所以最好赶紧开工。"
    }
    {
      Id = "Heracles_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一副渴望鲜血的样子。过来大饱口福吧。"
    }
    {
      Id = "Heracles_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "别在那傻站着，妹子。我们有场战争要打。"
    }
    {
      Id = "Heracles_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "享受这里的宁静吧，妹子。很快就会有人来要我们的命了。"
    }
    {
      Id = "Heracles_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要是无意再造杀业，那就站远点。{#Emph}能站多远站多远{#Prev}。"
    }
    {
      Id = "Heracles_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神一定在等着我们献上又一场精彩演出，是不是。"
    }
    {
      Id = "Heracles_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么我还在跟你说话，妹子？不如都省省口舌吧。"
    }
    {
      Id = "Heracles_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "跟我聊得太熟了的话，以后有你后悔的时候。这种事情发生过很多次了。"
    }
    {
      Id = "Heracles_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "你以为你认识我，妹子。但你错了。"
    }
    {
      Id = "Heracles_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "我建议你时刻跟我保持距离，女巫。"
    }
    {
      Id = "Heracles_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些神都一个样……"
    }
    {
      Id = "Heracles_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "去忙你自己的事吧，妹子。我在工作。"
    }
    {
      Id = "Heracles_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "你来不来，这艘船都要沉入海底。"
    }
    {
      Id = "Heracles_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "前面的水域凶险得很，妹子。掉进水里的话，别指望我下去捞你。"
    }
    {
      Id = "Heracles_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "又一个偷渡者。还以为只有我呢。"
    }
    {
      Id = "Heracles_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些船员曾被大海吞没，现在他们将再次沉入海底。"
    }
    {
      Id = "Heracles_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "这艘船真是一团糟。你就站好吧，让我把这里打扫一番。"
    }
    {
      Id = "Heracles_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "巧了，我也正要往众神之山去。"
    }
    {
      Id = "Heracles_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有把这艘船砸成碎片的冲动，但那样我们就都得游泳了。"
    }
    {
      Id = "Heracles_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以众神之名夺取这艘船，不过话说回来，你也是众神的一员，不是么？"
    }
    {
      Id = "Heracles_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "这地方没什么躲闪的空间，所以最好和我的巨槌保持距离。"
    }
    {
      Id = "Heracles_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "这片黑暗的水域有种独特的宁静感，不觉得么，妹子？"
    }
    {
      Id = "Heracles_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "你往别处去吧。这座该死的山现在四处受敌，由不得我们合兵一处。"
    }
    {
      Id = "Heracles_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神现在需要所有帮得上忙的人，所以你我才会在这里相遇。"
    }
    {
      Id = "Heracles_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，来得好。我刚才还觉得，一个人扛下所有有点太孤独了呢……"
    }
    {
      Id = "Heracles_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "建议你保持距离，免得和其他人一样滚下山去。"
    }
    {
      Id = "Heracles_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在人人都想在奥林匹斯山上分一杯羹啊，不是么。但众神的东西可由不得他们擅动。"
    }
    {
      Id = "Heracles_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这片冰天雪地里，最好当心你的脚下。跌落山崖可不是儿戏。"
    }
    {
      Id = "Heracles_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "还有什么比把萨提尔砸入冻土之中更光荣的事情吗？"
    }
    {
      Id = "Heracles_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "是我先来的，妹子。想杀点鹰身女妖什么的，自己找去。"
    }
    {
      Id = "Heracles_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "对晚点要发生的事情来说，这不过是热身，不是么，妹子？"
    }
    {
      Id = "Heracles_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里，若是你碰巧挡路，我会收手。但在山顶？绝对不会。"
    }
    {
      Id = "Heracles_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "很快，你将再次同时面对我和窃火者，但就让我们先演一会儿吧。"
    }
    {
      Id = "Heracles_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正准备把眼前会动的一切杀个干净，你和你的宠物除外。"
    }
    {
      Id = "Heracles_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁更有效率，谁的功劳就越大。干活拿钱，就这么简单。"
    }
    {
      Id = "Heracles_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "好久没有在这里把一切会动的东西杀个干净了。"
    }
    {
      Id = "Heracles_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在你父亲的迷宫里摸索的时候，我把所有的荣耀都独吞了。"
    }
    {
      Id = "Heracles_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们正在养成将会动的东西格杀勿论的习惯。"
    }
    {
      Id = "Heracles_0643"
      InheritFrom = "BaseNarrative"
      DisplayName = "你受了伤，所以最好退后，让我独享荣耀。"
    }
    {
      Id = "Heracles_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还活着。这有我的功劳，毋庸置疑，但……面对夺取了这座城市的污秽之物，还能有一战之力的，你是我见过的第一个。"
    }
    {
      Id = "MelinoeField_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的目标是清理这些污秽的源头。他潜伏在冥界的深处，不过我首先要去奥林匹斯山处理些事情。"
    }
    {
      Id = "Heracles_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "真巧！我不久之前刚从那里回来。所以众神开始部署战略了……你自己多加小心，妹子。"
    }
    {
      Id = "Heracles_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你是什么——你是个可恶的女巫。我警告你，只要你敢对我念一句咒语……或者哪怕伸一根手指……我就把你捏爆。"
    }
    {
      Id = "MelinoeField_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会有那种事的……不过，可以告诉我你为什么对“可恶的女巫”有这么大情绪吗？你见过多少位女巫？"
    }
    {
      Id = "Heracles_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的问题太多了。你越了解我，就越容易操纵我。现在，你该走了。"
    }
    {
      Id = "MelinoeField_3765"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯，你在色萨利裂谷里做什么，又是怎么来到这里的？不过话说回来，你一定是个游泳健将。"
    }
    {
      Id = "Heracles_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你问了，没错，我擅长各种运动。游泳。跳跃。砸人。"
    }
    {
      Id = "MelinoeField_3766"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以这是你巡逻路线的一部分？很难想象，如果没有你的帮助，我的旅途遇到的敌人会比现在还多。"
    }
    {
      Id = "Heracles_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果没有我，很多事情都会不一样。不过最近没什么人承认这一点，你倒是个例外。航行一路顺风，妹子。"
    }
    {
      Id = "MelinoeField_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "能有你效力，是奥林匹斯的荣幸，宙斯之子。"
    }
    {
      Id = "Heracles_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实效力于奥林匹斯众神。我为他们效力很久了，服从他们一个又一个不切实际的命令。他们为我带来了名声、荣耀……他们{#Emph}造就{#Prev}了我。而且对我百用不厌。"
    }
    {
      Id = "MelinoeField_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "但{#Emph}你{#Prev}厌倦了{#Emph}他们{#Prev}。那……你还在这里干什么？"
    }
    {
      Id = "Heracles_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我过往的工作也可以证明，我也不会厌倦{#Emph}他们{#Prev}。我接受任务，然后完成，就这么简单。"
    }
    {
      Id = "Heracles_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎来到你家祖传的山，妹子。跟你梦想中的一样么？曾经这也是我梦寐以求的地方。后来，我看开了。"
    }
    {
      Id = "MelinoeField_3767"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你仍然在保卫这里。你说得好像你失去了存在的意义一样，但我见过你战斗时的样子。"
    }
    {
      Id = "Heracles_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“意义”。{#Prev}众神让我付出了一切，才允许我在这里加入他们，但来到这里之后，也只是让我继续保卫他们的荣耀。要不了多久，你也会找到{#Emph}你自己{#Prev}的意义。"
    }
    {
      Id = "Heracles_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "……看来你获得了她的祝福。不费吹灰之力就获得了她的力量。她的认可……"
    }
    {
      Id = "MelinoeField_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是在说赫拉吗？她当然愿意这样做，我们都是一边的。而且还不止，我们是一家人。"
    }
    {
      Id = "Heracles_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}一家人。{#Prev}也难怪，与家庭相关的一切，都属于王后陛下的领域。婚姻、生育，都不外如是。不过是精美包装的诅咒罢了。"
    }
    {
      Id = "Heracles_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你真的是哈迪斯的女儿，那我们就是堂兄妹了，不是么？不过，以我父亲的为人，你的堂兄堂姐肯定多得数不过来……"
    }
    {
      Id = "MelinoeField_3989"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近在奥林匹斯神之中，我就见到了好几位堂兄堂姐。但我基本上算是独自长大的。"
    }
    {
      Id = "Heracles_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你该感谢命运三女神。亲戚越少，义务就越少……也就越少因为自己的出身被卷入争斗之中……"
    }
    {
      Id = "Heracles_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管我走到哪，亡者都认识我。很烦。以前可以大开杀戒，而不用担心被人认出来。"
    }
    {
      Id = "MelinoeField_3997"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就是出名的后果吧。在我的家乡，暗灵们都对你赞不绝口！我们甚至可能还有一副挂画，上面画着你冒险时的场面呢。"
    }
    {
      Id = "Heracles_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们对我一无所知，除了谎言与半真半假的传闻。我不需要一群盲目的信众。"
    }
    {
      Id = "MelinoeField_3993"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有在这一带见到过美狄亚女士么？她留着黑色长发，穿一袭黑衣。她说不定能帮你消灭一些敌人。毕竟双拳难敌四手。"
    }
    {
      Id = "Heracles_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "我已经欠过她一次，那时我……状态不佳。女巫的恩情，我是不会再欠了。你们这种人，给得少，拿得多。"
    }
    {
      Id = "MelinoeField_3994"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫到底对你做了什么？听起来好像是她帮了你，但你却毫不领情。"
    }
    {
      Id = "Heracles_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你们的能耐。我敬畏一座正在爆发的火山，不意味着我愿意靠近它。"
    }
    {
      Id = "MelinoeField_4009"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你往返奥林匹斯山的时候，有没有见过一个长了翅膀的年轻人飞过水面，投下炸弹骚扰泰坦的舰队？"
    }
    {
      Id = "Heracles_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "工匠狄德勒斯之子。那对翅膀不是真的，而且他已经是暗灵了。他和他父亲都是。"
    }
    {
      Id = "MelinoeField_4010"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是这样的……他好像很崇拜你。如果有机会能跟你见上一面，让他做什么他都愿意。我想着也许可以帮你们安排一下。"
    }
    {
      Id = "Heracles_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对崇拜者没兴趣。尤其是那种自己沉到水里淹死，还要麻烦我去捞的家伙。让我留在他的想象里就好。"
    }
    {
      Id = "MelinoeField_4011"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，也就是我们之前提到过的狄德勒斯之子，得知你可能有帮助他下葬之后，非常感动。他说让我跟你说一声“谢啦”……我觉得他还有很多话想对你说。"
    }
    {
      Id = "Heracles_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃。少拿他那些多愁善感来折腾我。"
    }
    {
      Id = "Heracles_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说命运三女神不在了。真可惜。我一直都想亲手除掉她们。虽然她们是杀不死的。"
    }
    {
      Id = "MelinoeField_3771"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一直都想杀死命运三女神……因为她们赐予了你无与伦比的力量，让你成为了世间的英雄，给后世留下无数佳话么？"
    }
    {
      Id = "Heracles_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "显然，若不是她们，我是不会在这里的。至少现在她们知道这是什么滋味了……命运被人系在线头上，毫无话语权的滋味。去他的命运女神！我们需要的，唯有正义而已。"
    }
    {
      Id = "Heracles_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前成功离开过这里。但那个独眼巨人一定闻到了你的味道。那家伙很壮。"
    }
    {
      Id = "MelinoeField_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "这句话来自你，分量可不小，不过你一定比他还强壮得多。你有考虑过和他比试比试么？这样可以帮我省下很多麻烦。"
    }
    {
      Id = "Heracles_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对他那样的人没有兴趣。此外，他体内也流淌着神明的血脉，与你我无异。我们总是打来打去的话，多少有点不成体统了，不是么？"
    }
    {
      Id = "Heracles_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹子啊，咱们的父亲们真是给咱们留下了个烂摊子，你说是不是。明明是最强大的神明所生，却活得像孤儿弃子……与野兽无异。"
    }
    {
      Id = "MelinoeField_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "给我们留下烂摊子的是克洛诺斯。如果他一死了之的话，我们现在一定过着平静的生活。在各自的父亲身边。"
    }
    {
      Id = "Heracles_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的父亲和我的父亲，你都没见过吧？是，现在确实烽火连天、战事不断，但至少我们离{#Emph}他们{#Prev}远远的。"
    }
    {
      Id = "MelinoeField_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来和摆渡人很熟。你们之前一起共事过吗？"
    }
    {
      Id = "Heracles_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以前拜访过你们的冥界。摆渡人是我的供货商。看来他也为你提供服务……你把货都抢空了。"
    }
    {
      Id = "MelinoeField_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我又不是偷偷买的……"
    }
    {
      Id = "Heracles_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "友情提示：小心埃费拉城的巷子，里面有只没死透的巨型野猪在四处嗅探。它是为我而来。"
    }
    {
      Id = "MelinoeField_3992"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不狩猎野猪，反而成了野猪的猎物？是我听错了吗？"
    }
    {
      Id = "Heracles_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和它，在它还没这么……死气沉沉的时候，结下了梁子。本来有机会彻底了结它的；闹成现在这样，是我咎由自取。"
    }
    {
      Id = "MelinoeField_3768"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近在奥林匹斯山上有遇到过泰坦普罗米修斯吗？率领军队攻打你家园的，似乎就是他。"
    }
    {
      Id = "Heracles_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "是么？还有这种事。他难道不该被捆在别的什么山上，被啄食血肉么？"
    }
    {
      Id = "MelinoeField_3769"
      InheritFrom = "BaseNarrative"
      DisplayName = "你居然不知道他重获自由了？你应该狩猎的是他，不是这些牲口。是谁给你下达的任务？"
    }
    {
      Id = "Heracles_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "我直接听命于神王与王后。如果你对我完成工作的方式有任何意见，找他们说去。"
    }
    {
      Id = "Heracles_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到过山顶了没有？如果还没有的话，先给你打个招呼：等在那里的不是什么善茬。至少我听说是这样。"
    }
    {
      Id = "MelinoeField_3770"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你是指提丰？奥林匹斯众神没有派你去对付{#Emph}他{#Prev}，而是让你在远离真正危险的这里砸这些杂兵，说实话让我很不理解。"
    }
    {
      Id = "Heracles_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯众神无法容忍像我这样的“半神”窃取他们的荣耀。他们只会让我干脏活累活，不会把重要的事交给我。你这两者都没落下，可得好好感谢命运三女神。"
    }
    {
      Id = "Heracles_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那座山顶，跟那个魔物对峙……是什么感觉？我还没跟那么大的敌人交过手。至少目前还没有。"
    }
    {
      Id = "MelinoeField_4021"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这之前，我也没遇到过像提丰这么大的敌人。他的身形巨大固然算是他的破绽，但要同时面对他、那场风暴，以及他的无数子嗣，确实很容易让人难以招架。"
    }
    {
      Id = "Heracles_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "难以想象，我曾经杀死的那个多头蛇，竟然只是他的众多后代之一。但在未来的岁月里，总会有比他更棘手的怪物……"
    }
    {
      Id = "Heracles_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的工作完成了……但这样的循环永不会停止。对了，之前的事情，没往心里去吧。"
    }
    {
      Id = "MelinoeField_3763"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，完全没有。我之前一直好奇被你的巨槌狠狠砸一下是什么感觉，现在我不好奇了。"
    }
    {
      Id = "Heracles_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = " 嗯，我也不喜欢留什么悬念。以及，如果你想再来体验一下我的巨槌，你知道在哪能找到我。"
    }
    {
      Id = "Heracles_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和我想得不一样。你没有告我的状；而且在我横插一手时，还能打败普罗米修斯。你为什么这么做？你是怎么做到的？"
    }
    {
      Id = "MelinoeField_3777"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有我自己的理由，也有我自己的手段。你该不会希望我和盘托出吧？你自己也没有向我敞开心扉嘛。"
    }
    {
      Id = "Heracles_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以为我{#Emph}好好问{#Prev}的话，也许你会愿意回答，不过换做是我也不会说。好吧，你说得也对。你不想说，我也没办法逼你。"
    }
    {
      Id = "Heracles_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次我们像这样战斗的时候，等到尘埃落定，你已经消失得无影无踪。像乘着夜色的小偷一样溜之大吉。"
    }
    {
      Id = "MelinoeField_3764"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不得不先走一步。我想着你解决剩下的应该没问题，毕竟你平常都是单干。"
    }
    {
      Id = "Heracles_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "是。但我不喜欢战斗中有人突然消失。要么留在我的视线里，要么别挡我的路。"
    }
    {
      Id = "Heracles_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的血是红色的。你并不完全是神。半人半神……两边的好事都让我们尝尽了。"
    }
    {
      Id = "MelinoeField_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的母亲是凡人，对吧？我母亲一半是神，一半是人。我们的血液中流淌着死亡。但你不一样……"
    }
    {
      Id = "Heracles_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我不一样。{#Prev}我不是神，不是凡人，也不是暗灵。如你所言，我的血液中流淌着死亡。凡人生来便注定死去，而我生来还注定要杀戮。"
    }
    {
      Id = "Heracles_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "嚯，这不是我给你的那颗狮牙么。我还有很多颗，而你当时看起来挺需要多加几分凶残。"
    }
    {
      Id = "MelinoeField_3990"
      InheritFrom = "BaseNarrative"
      DisplayName = "它的力量确实非常有用，不过为什么要把它送出去呢？我越强大，就越容易夺走本属于你的荣耀。"
    }
    {
      Id = "Heracles_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "答案很简单，妹子。我不想要了。不想要那颗牙，也不想要荣耀。把我的活都干了也无所谓，反正永远也干不完。"
    }
    {
      Id = "Heracles_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的那些魔法把戏……都是借来的。明明有自身的力量可以依靠，为什么转而信任身外之物？"
    }
    {
      Id = "MelinoeField_3998"
      InheritFrom = "BaseNarrative"
      DisplayName = "魔法和力量并不冲突，这两者归根结底都来源于自身，只不过是训练的方式不同。"
    }
    {
      Id = "Heracles_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看不然，妹子。你在吸收月亮的力量、大地的力量，以及……谁知道还有什么。但在这个世界，你靠不得别人，只能靠自己。"
    }
    {
      Id = "Heracles_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "你使用武器的水平，超出了我的预料。我曾经想要掌握天底下每一种武器，但最后……却习惯了最简单的棒槌。"
    }
    {
      Id = "MelinoeField_3985"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是暗夜武器的使用者，它们的各种形态都为我所用；我永远不会只选择其中的某一种。你不会担心自己太安于现状了吗？"
    }
    {
      Id = "Heracles_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会。这条路走得够久，你就会明白，任何武器都能完成工作。到那一步，选择就不重要了。不过，我还是会带着各种武器，单纯是做做样子。"
    }
    {
      Id = "Heracles_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不在的时候，我完全没有在想你的事。要不然的话，一定会以为你已经放弃了。"
    }
    {
      Id = "MelinoeField_3995"
      InheritFrom = "BaseNarrative"
      DisplayName = "这句话我真不知道该怎么接，除了我最近也没怎么想你的事。有什么人或事是你经常会想的吗？"
    }
    {
      Id = "Heracles_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "我经常会想那些被我碾碎的尸体。你如果想加入它们的话，我随时乐意效劳。"
    }
    {
      Id = "MelinoeField_3996"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不用了，我现在这样挺好的。"
    }
    {
      Id = "Heracles_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们说，这场战争终于接近尾声了。但我们的敌人好像消息不太灵通。"
    }
    {
      Id = "MelinoeField_4005"
      InheritFrom = "BaseNarrative"
      DisplayName = "反正我们目前也还需要他们。奥林匹斯众神有跟你说过下一个阶段计划的具体内容吗？"
    }
    {
      Id = "Heracles_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "反正意思就是让我们接着打。没有什么变化。以前从来没有过，现在又凭什么会有？"
    }
    {
      Id = "MelinoeField_4006"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在说什么呢？有很多变化啊！奥林匹斯山不再受到威胁了。冥府也恢复如初。"
    }
    {
      Id = "Heracles_0280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向来如此。"
    }
    {
      Id = "MelinoeField_4022"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一切结束之后，你有什么打算？或者说，你想去做什么？"
    }
    {
      Id = "Heracles_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "……何必问呢？我一般不会过多思考我“想要”什么，除了刹那间的野蛮冲动。"
    }
    {
      Id = "MelinoeField_4023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是想听听你是怎么想的。我一生都在履行我对家族的义务，现在突然卸下了担子，我不知道……"
    }
    {
      Id = "Heracles_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你算是彻底问错人了，妹子。有梦的话，就去追吧。现在，别碍我的事。"
    }
    {
      Id = "MelinoeField_4007"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦普罗米修斯最近听起来很高兴。你知道背后的原因吗？"
    }
    {
      Id = "Heracles_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "我怎么知道，知道又能怎样？我们在这里从不谈论他，在哪里都一样。"
    }
    {
      Id = "MelinoeField_4008"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就谈论你吧。你在这件事中如愿以偿了么？命运三女神宣布凡人的时代即将来临。"
    }
    {
      Id = "Heracles_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还记得的话，我只是个半神。我永远也不会“如愿以偿”。但当变革的时刻终于来临时，我会欣然接受。但愿下一个时代不再需要众神，也不再需要我这样的人。"
    }
    {
      Id = "Heracles_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "我后来又想了想，妹子。我得承认，我把你的成就说得太轻了。你能完成那样的任务，实在是不容易。"
    }
    {
      Id = "MelinoeField_4019"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少我有大力士赫拉克勒斯的帮助——大部分时候有，不然任务只会更加困难。不过，谢谢你。你能这样想，让我很开心。"
    }
    {
      Id = "Heracles_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必。现在看来，我们可以继续做我们该做的事，而不用背负实现不可能之事的压力了。这种感觉还不错。"
    }
    {
      Id = "Heracles_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的话太多了，你知道吗，女巫？我们少点寒暄，就能多杀点人。"
    }
    {
      Id = "MelinoeField_4018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道你说的寒暄是指什么，但如果你想少说点话的话，那当然是你的自由。"
    }
    {
      Id = "Heracles_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "说话从来不是我的长处。而你或许意识到了，我是那种喜欢扬长避短的人。"
    }
    {
      Id = "Heracles_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你非找个人聊天不可的话，我建议你去找那边的摆渡人。"
    }
    {
      Id = "Heracles_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没看见我，我也没看见你。该走人了。"
    }
    {
      Id = "Heracles_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "别在我这浪费时间了，妹子，我不在乎。"
    }
    {
      Id = "Heracles_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管你要对我说什么，我不想听。"
    }
    {
      Id = "Heracles_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看起来像是想跟你聊天的样子吗？"
    }
    {
      Id = "Heracles_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃。你害我忘了自己数到多少个了。"
    }
    {
      Id = "MelinoeField_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "伟大的宙斯之子，我想把这瓶蜜露送给你，希望它在你为众神卖力时能为你止渴。他们一定非常感激有你这样强大的助力。"
    }
    {
      Id = "Heracles_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呵。{#Prev}也好，省得我下次表忠心时再自己去找了。辛苦你了，这个你拿去吧。"
    }
    {
      Id = "Heracles_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的不打算只给我半瓶蜜露么？毕竟我只是个半神……我得到了神的力量，却很少能享受神的奢侈。"
    }
    {
      Id = "MelinoeField_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "过度奢侈本来也没有什么益处。不过稍稍享受一下也没坏处啦！希望在你有机会享受时，这瓶蜜露能让你心情舒畅。"
    }
    {
      Id = "Heracles_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的以为我蠢到会喝{#Emph}这瓶东西{#Prev}？谁知道你在里面下了多少咒，恐怕我喝上一口就会发疯，或者更惨……"
    }
    {
      Id = "MelinoeField_3772"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以父亲之名向你发誓，我绝对没有做过这样的事。而且如果我那样做了的话，蜜露一定会变质，一眼就能看得出来。你想我先喝一口，好让你放心吗？"
    }
    {
      Id = "Heracles_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不。我自己丢掉就是了。"
    }
    {
      Id = "Heracles_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "想用一瓶{#Emph}饮料{#Prev}收买我？不可能。你在浪费资源和时间，包括{#Emph}我的{#Prev}时间。你杀了敌人就能分一份奖金；除此之外的好处想都不要想。"
    }
    {
      Id = "MelinoeField_3773"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解。不过，我们仍然在为同一个家族效力，而且我亲眼见过你为了击退他们的敌人，付出了多少努力。因此我很感激。"
    }
    {
      Id = "Heracles_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（嗤鼻）"
    }
    {
      Id = "Heracles_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "山上那些神，从来没有亲自送过我这种东西。因此我现在一看到蜜露就犯恶心，尤其是在那次……和酒神比了一场之后。不过那是很久之前了。"
    }
    {
      Id = "MelinoeField_3774"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和迪奥尼索司大人比过酒量？就算有你这样的体魄，按照我的理解，这种事情也相当危险。"
    }
    {
      Id = "Heracles_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "的确。"
    }
    {
      Id = "MelinoeField_3775"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说众神从来没有与你分享过蜜露，可我现在就有一瓶要送给你。也许你可以逐渐找回对蜜露的喜爱。"
    }
    {
      Id = "Heracles_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "够了，女巫。我告诉过你我不在乎，而且最近我也没有将它转手献给众神的打算。我对{#Emph}你{#Prev}的忍耐，也同样在接近其限度。"
    }
    {
      Id = "MelinoeField_3776"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能忍耐我，我已经知足了。我见过你工作时的样子，一心杀敌，不求回报。你为奥林匹斯山献出了这么多；愿你永远不用献出自己的灵魂。"
    }
    {
      Id = "Heracles_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……那我得还有灵魂才行。"
    }
    {
      Id = "MelinoeField_3778"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说我和你想得不一样；你也和我的预期大不相同，赫拉克勒斯。我听说过你的壮举，而且也从没见过如此勇猛的战士。但我知道你不止如此。这个请你收下！只有这种属于众神的礼物，才配得上你的神力。"
    }
    {
      Id = "Heracles_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "仙馔密酒……你真的把我当作另一位神明看待。我有一半凡人的血脉；这样的礼物我消受不起，而你仅仅是提出要送给我，便已玷污了它的意义。你想从我这里得到什么？"
    }
    {
      Id = "MelinoeField_3779"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只想要你意识到，神明之中也有尊重你、敬仰你的人。倘若有失完美就意味着有失神格，那我们之中就再没有人能自称神明。"
    }
    {
      Id = "Heracles_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "……真知灼见啊，妹子。好吧，倘若未来有一天，家族中的其他人能认同你的观点，我们就一起干了这瓶。现在，我就先保管着了。"
    }
    {
