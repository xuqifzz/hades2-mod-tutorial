    }
    {
      Id = "Icarus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的是你啊！那个，不用你说，我也知道我不该出现在这里。但我从远处看到了这艘船，就想着一定得凑近看一看才行。现在我要飞走了！所以嘛……嘿，咱们就假装这一切都没有发生，好吗？"
    }
    {
      Id = "MelinoeField_1930"
      InheritFrom = "BaseNarrative"
      DisplayName = "站住，伊卡洛斯！我没打算让你就这么飞走，至少也得留下来跟我聊上两句吧。比方说，你卷入这场糟糕透顶的战争之中做什么？"
    }
    {
      Id = "Icarus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在做我{#Emph}一直{#Prev}在做的事：拖慢这些混蛋。如果每个像我一样的人都出一份力的话，这场战争很可能早就结束了。"
    }
    {
      Id = "MelinoeField_1931"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实有这个可能。但这是众神和泰坦之间的战争。我不想看到你受伤。"
    }
    {
      Id = "Icarus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "想劝我的话可太迟了，墨利！好了，我已经耽搁你太久了，但是在我走之前，让我给你一件我最新的作品吧。绝对运作正常，我保证！"
    }
    {
      Id = "Icarus_0025_D"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的胳膊……！再也没有长好了，是么？真的很对不起，我当初不应该让你陷入那样的境地……"
    }
    {
      Id = "MelinoeField_2010"
      InheritFrom = "BaseNarrative"
      DisplayName = "那不是你的错。那时候的我……对自己的能力太过自信了。老师总是告诫我，世界上没有让暗灵复生的办法，但我就是不相信。是我自己轻举妄动，因此学到了无法忘记的教训。"
    }
    {
      Id = "Icarus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感觉糟透了……再也没脸去见三岔路口的任何人。我还以为我再也见不到你了，当时我想，也许那样是最好的。我……我那时有千丝万绪需要理清。"
    }
    {
      Id = "MelinoeField_2011"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你现在理得怎么样了？至少你学会了飞行呢！那可是你最大的恐惧，如今已经被你克服了。而且还戴着你父亲的翅膀！"
    }
    {
      Id = "Icarus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "这对翅膀是我自己的，墨利。这也是我克服恐惧的一部分。我必须得学会自己的事情自己做，就像那时的你一样。对了，不管怎么说，我仍然觉得你的胳膊看起来很酷。现在，这个你收下吧。"
    }
    {
      Id = "Icarus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "我学会飞行已经有一段时间了！一开始总让我想起小时候的恐惧。我临终的时刻……我想要逼自己一遍又一遍地经历。说不清为什么。"
    }
    {
      Id = "MelinoeField_2012"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，你只是在年轻的时候犯了个错而已。为什么要永生永世拿这个来折磨自己呢？我还以为你想学会飞行，是想证明给你父亲看呢。"
    }
    {
      Id = "Icarus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，墨利。我永远没办法在他面前证明我自己。但是在一遍遍尝试使用翅膀的过程中，我……我开始喜欢上飞行了！让我可以从另一个角度看待事物。"
    }
    {
      Id = "MelinoeField_2013"
      InheritFrom = "BaseNarrative"
      DisplayName = "你飞在天上的时候感觉可自在了！我以前一直觉得，如果我能让你复原的话，也许某个夜晚，我们会一起学习飞行。我到现在都想体验一下那种感觉。"
    }
    {
      Id = "Icarus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定无法想象，我有多渴望那样的机会。但是学飞行这件事我必须自己完成。我现在很想载你一程，只可惜……唉，暗灵哪里能配得上女神呢。"
    }
    {
      Id = "MelinoeField_2013_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "你飞在天上的时候感觉可自在了！我以前一直觉得，如果我能让你复原的话，也许某个夜晚，我们可以一起飞行……"
    }
    {
      Id = "MelinoeField_2015"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，你和以前不一样了。现在的你看起来……更有生命力。你在天上翱翔的时候，我时不时会瞥见你的脸，而你的脸上……有一种我之前从没见过的快乐。"
    }
    {
      Id = "Icarus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，怎么说呢……一方面是因为我在飞吧，飞行确实屡试不爽……另一方面是因为我能见到你，见到你单枪匹马和克洛诺斯的大军杀得有来有回。你的训练全都派上了用场。太酷了……"
    }
    {
      Id = "MelinoeField_2016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是“单枪匹马”啦，伊卡洛斯，不过……知道你享受飞行，让我很欣慰！飞在天上的感觉一定神清气爽。"
    }
    {
      Id = "Icarus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，墨利。你总是一眼就能看穿我，所以我也没有什么好装的啦。真希望你哪个晚上也能体验一下，然后跟我说说你的感受。"
    }
    {
      Id = "Icarus_0033_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，墨利。你总是一眼就能看穿我，所以我也没有什么好装的啦。"
    }
    {
      Id = "MelinoeField_2150"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这么喜欢飞行，为什么还要帮我呢？一旦我父亲重归冥王宝座，冥界的大门就会再度关闭，你也被迫要回到那里去了。"
    }
    {
      Id = "Icarus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道。我会很怀念飞行的感觉，这是肯定的。但是，我觉得如果真到那一步的话，我也不是活不下去——不是{#Emph}存在{#Prev}不下去，你懂我的意思。目前来说，我只是想尽可能利用好当下。毕竟，我们这些凡人或多或少都体会过，没有什么是永恒的。"
    }
    {
      Id = "Icarus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你带着我送你的那个小锤子，是吗？那是我做的第一把锤子呢！至少是第一把能用的。说来有点好笑，做一个用来做东西的东西……"
    }
    {
      Id = "MelinoeField_2158"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，让你这样割爱怎么好意思嘛！你应该好好收藏着它，作为你匠人技艺成长的见证。要不是你告诉我，我还以为这是你父亲的杰作呢！"
    }
    {
      Id = "Icarus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "它在你的手中，比在我手中有意义得多。创造能让别人变得更强的工具……就是我自己变得更强的证明。所以你帮了我个大忙啦，墨利！"
    }
    {
      Id = "Icarus_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，最近你有让我的旧锤子派上用场，是么？我还以为也许你会把它放在某个角落吃灰呢。在我手里经历了那么多之后，它也有资格好好休息一下了！"
    }
    {
      Id = "MelinoeField_4033"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你不想我这么用它吗？如果你的本意是给它找个角落吃灰的话，也许应该给它裹上毛皮，这样吃灰吃得更多。"
    }
    {
      Id = "Icarus_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，不，我觉得你现在这样用它很好。看起来它上面的魔力比以前更强了！我只是很高兴它能帮上忙啦。"
    }
    {
      Id = "MelinoeField_2014"
      InheritFrom = "BaseNarrative"
      DisplayName = "你自己都说了，你不该出现在这里，伊卡洛斯。克洛诺斯是打开了冥界的大门不假，但你仍然属于我们，属于地下世界。回来吧。"
    }
    {
      Id = "Icarus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我总是会把一切搞砸，你知道的。我只是想对谁派上用场，哪怕一次也好！所以，求你了……让我留在这里吧。让我做好这一次！"
    }
    {
      Id = "Icarus_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "船上的那些卑劣之徒没什么脑子，但它们下手很重。我、我知道你很厉害，不……不只是“很厉害”，但我还是担心……万一出了什么差错……那你要怎么办？"
    }
    {
      Id = "MelinoeField_2156"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师教给我的第一件事就是永远不要倒下。如果我的力量将要流失殆尽，我就会用最后的力量遁入阴影之中，一如我从阴影中来。到现在，这对于我来说基本算是条件反射了。"
    }
    {
      Id = "Icarus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后，在三岔路口，等到下一个晚上，你就又蓄势待发了？只可惜你不能“遁”回上一次离开的地方……"
    }
    {
      Id = "Icarus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你怎么会出现在{#Emph}这里{#Prev}？我还以为你会被束缚在冥界，但你却就这样站在我面前，上阵杀敌、夺取战舰，就跟没事人似的！"
    }
    {
      Id = "MelinoeField_2152"
      InheritFrom = "BaseNarrative"
      DisplayName = "我仍然被束缚在那里，只不过是为自己稍稍松了松绑。不过我现在感觉仍然难受得要命，所以就算克洛诺斯的军团一时半会儿阻止不了我，我的血脉诅咒也终究会让我止步。"
    }
    {
      Id = "Icarus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？可是你看起来美极了！呃，我是说，我是说你看起来{#Emph}气色很好{#Prev}，不像是有受到诅咒之类的影响。也许只是有些晕船吧！嘿，好啦……不说了，赶紧选一件吧？"
    }
    {
      Id = "Icarus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们上次这样联手出击，已经是好几夜之前的事了，对吧，墨利？我想着你早晚会出现的，除非……除非你落入了克洛诺斯的魔爪，或者发生了其他可怕的事情。"
    }
    {
      Id = "MelinoeField_3100"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你真的在为我担心的话，谢谢你，伊卡洛斯……但以后不用这样啦。忧虑对我们没有好处；如果你因此分心，就没办法全力对付泰坦的大军了。"
    }
    {
      Id = "Icarus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没关系，分心对我来说算是家常便饭了！除了在工作的时候，以及在天上飞的时候。说起来，这不是巧了嘛，最近我一直在忙这两件事！"
    }
    {
      Id = "MelinoeField_2147"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，你父亲近况如何？你不知道我在外面找到狄德勒斯之锤的时候有多开心……我从来没有在外面碰上过他，所以从来没法亲自向他表达我的感谢。"
    }
    {
      Id = "Icarus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵！下次我再撞见他的时候，一定会亲自替你向他致意的，不过我也有一阵子没见过他了。很高兴他的锤子能派上用场。再选一件装备吧？"
    }
    {
      Id = "Icarus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前那次，你问起来我的父亲……虽然你可能已经知道了，但是实话说，我也从来没在这边碰上过他。我觉得他可能是退休了！"
    }
    {
      Id = "MelinoeField_2148"
      InheritFrom = "BaseNarrative"
      DisplayName = "狄德勒斯……{#Emph}退休了？{#Prev}可我刚刚才找到他的一把锤子！自从这一切开始以来，他一直为我提供了莫大的助益，他怎么可能……等等……{#Emph}难道说……？"
    }
    {
      Id = "Icarus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利，我是他的学徒呀！他造东西造了一辈子了，也是时候休息了。我的水平跟他肯定无法相提并论，但反正也没有别的人选了……总之，那些锤子还算好用吧？"
    }
    {
      Id = "MelinoeField_2149"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，我没弄明白。你是说，我找到的那些{#Emph}狄德勒斯之锤{#Prev}都是你的杰作？那难道不该叫{#Emph}伊卡洛斯{#Prev}之锤吗？"
    }
    {
      Id = "Icarus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，我们已经名声在外啦。在这种时候把我父亲的名字换成我自己的，听起来不是很明智。嘿，求你件事，别把这个秘密告诉别人，好么？"
    }
    {
      Id = "MelinoeField_2154"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的翅膀、你的炮弹，甚至就连最新的狄德勒斯之锤都是你自己做的……你已经是卓有成就的工匠了呢！"
    }
    {
      Id = "Icarus_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，墨利，我父亲像我这么大的时候早就远近闻名了，这甚至是在我死前的事。我永远也没法超过他。"
    }
    {
      Id = "MelinoeField_2155"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是那个意思。你的作品是你自己的，而且很好用呢！超级好用。你究竟什么时候才打算从你父亲的阴影中走出来？"
    }
    {
      Id = "Icarus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "想不到你也会问出这种问题！我父亲虽然不是什么神……但是他很可能是凡间有史以来最杰出的艺术家和发明家。我永远也无法企及他的高度，不用他说我也知道。不过，我已经不再想向他证明自己了。"
    }
    {
      Id = "MelinoeField_3098"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么会对暗夜武器这么了解，能设计出这么多量身定制的改造，让我一拿到锤子就能派上用场？暗夜武器可是高度机密，况且本来也没有多少改进的空间。"
    }
    {
      Id = "Icarus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "我爸爸曾经为你爸爸效力过，还记得么？冥界那些层层嵌套、紧密相连的房间，就是他设计的。他一定赢得了很多信任……也得知了很多秘密。"
    }
    {
      Id = "MelinoeField_3099"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后呢，难道他会把这些秘密分享给在他眼里那个“永远不成器”的学徒……？"
    }
    {
      Id = "Icarus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你是在怀疑我也赢得了我父亲的信任……那你就多虑了！在暗夜武器这方面，我{#Emph}有可能{#Prev}偷偷翻了翻他的笔记和蓝图啦……"
    }
    {
      Id = "MelinoeField_4042"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近才第一次见到我的父亲……本来以为只有老师会这么严厉，但他也是一样。考虑到他那些传闻，倒也算是意料之中，但还是令我唏嘘。也许你的父亲这点是跟他学的。"
    }
    {
      Id = "Icarus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "我几乎都要羡慕你了，这么长一段时间都没有见过自己的父亲。以前有一次我用我父亲的锤子，犯蠢把它搞坏了，我就说那是一场失败的实验。结果他说：“不，你才是我失败的实验。”他一直都是这么不近人情。"
    }
    {
      Id = "MelinoeField_4043"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，这也太可怕了！他一定不是这个意思。你是他的传人啊！你的作品都继承了他的名号。"
    }
    {
      Id = "Icarus_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得我的父亲以自己的方式爱着我，他只是比起言辞，更擅长发明创造。不过你父亲肯定跟他不一样啦。他可是堂堂{#Emph}死者之主{#Prev}！一听就是个硬茬，对吧？"
    }
    {
      Id = "Icarus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，三岔路口的大家最近过得都怎么样？奥德修斯大师是不是终于能看到自己的计划一步步实现啦？"
    }
    {
      Id = "MelinoeField_2157"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是的。多亏了他规划的路线，我才能来到这里。说起来，该不会是他派你来做这些事的吧？部署戴着机械翼、背着爆炸物的暗灵，听起来很像是大战术家会做出来的事……"
    }
    {
      Id = "Icarus_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是自己来的。不过说不定我们所有人都是大战术家计划的一部分，只是还没意识到而已。他总是告诫我们要懂得见机行事……也许我现在才终于明白这句话的深意。"
    }
    {
      Id = "MelinoeField_3634"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，我希望你能回来。回到三岔路口来。你想在这片战场上帮助我们；和奥德修斯以及我们麾下的暗灵相互照应，一定会让你的突袭更加卓有成效。"
    }
    {
      Id = "Icarus_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "只怕其他人不会像你这样想，墨利。我在这里一个人也没什么不好的，何况人多了还会让我不自在。也许是一生住在监狱般的高塔里，落下的后遗症吧。"
    }
    {
      Id = "MelinoeField_3635"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你回来的话，我们就能更经常见到彼此了？而且三岔路口也没有那么拥挤吧，你说呢？就考虑一下嘛……"
    }
    {
      Id = "Icarus_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，好吧，我会的。我是说我会考虑一下。但如果我去到三岔路口之后，岔路女巫嘭地一声给我变成只蜥蜴暗灵之类的，良心受谴责的可是你哦。"
    }
    {
      Id = "MelinoeField_3636"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到你决定回来，我真是太开心了！过了这么久之后重回三岔路口，感觉如何？"
    }
    {
      Id = "Icarus_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "最开始有一点不自在，但是紧接着你就来了。而且又能见到奥德修斯大师也很开心，他为我的飞行路径出了出主意。我不会待得太久，打扰到大家了吧……？"
    }
    {
      Id = "MelinoeField_3637"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会的，放心！既然你不讨厌三岔路口，那就希望你以后还能再来啦。而且，也许你可以考虑把那里当作是个休息放松的住处，而不是要登门拜访的地方。"
    }
    {
      Id = "Icarus_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "那里可是个“路口”啊，墨利，我从来没想过还能把那里当作住处！嘿……以及，谢谢你推我一把哦。"
    }
    {
      Id = "Icarus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你，呃……你长大了啊！是长大了一点……我……嘿，这不是我的错觉吧？一般来说，我是不用这样仰着头看你的啊。"
    }
    {
      Id = "MelinoeField_3095"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是一点魔法啦，是巫术师喀耳刻的手笔。效果是临时增强我的力量，不过看起来有很明显的副作用……"
    }
    {
      Id = "Icarus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "也不是什么坏事啦，只是我一下就注意到了……！哦，我好像盯着你看太久了……我得赶紧停下来。这个给你。"
    }
    {
      Id = "Icarus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是怎么了，墨利，你变得好{#Emph}小{#Prev}哎！不是说你平常很{#Emph}大{#Prev}啦。我、我、我是说……你的大小一直都刚刚好，但你平常更……呃，还是当我什么都没说吧？"
    }
    {
      Id = "MelinoeField_3096"
      InheritFrom = "BaseNarrative"
      DisplayName = "没关系的，伊卡洛斯。你一定是注意到了巫术师喀耳刻对我施加的魔法，这是在今夜生效的一道防护性咒语。效果真的那么明显吗？"
    }
    {
      Id = "Icarus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不！{#Prev}不，不是很明显！呃，我只是……我常常会注意到小的东西，我是指小细节——或大或小的细节！总之，我很喜欢啦。当然这不重要。来吧！该送你启程了。"
    }
    {
      Id = "Icarus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前那一夜，我见到地平线上有一对巨大的黑色双翼；绝对不是什么鹰身女妖。简直就像是那个厄里斯……不过，她不是还在三岔路口，跟你们在一起吗？"
    }
    {
      Id = "MelinoeField_2153"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，我这不也从三岔路口出来了嘛。不过……说来不幸，纷争化身确实最近在挡我的路。所以她基本上是和我同时抵达的吗？"
    }
    {
      Id = "Icarus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这么一问，好像还真是！啊，我本来还以为，她出现在这里是因为{#Emph}我{#Prev}做了什么事呢！没想到她只不过是和以前一样，老是跟着你到处跑呀。"
    }
    {
      Id = "MelinoeField_4031"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不该让厄里斯对你呼来喝去的，你知道么。我听到你们在三岔路口的谈话了。她只会说大话而已……尤其是在{#Emph}那里{#Prev}，因为她在那用不了狮鹫坚炮。"
    }
    {
      Id = "Icarus_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "说得轻巧，你和她一样是不死之身。我们这些暗灵知道，不该招惹那些不死不灭的神明。"
    }
    {
      Id = "MelinoeField_4032"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在{#Emph}我面前{#Prev}可不会畏畏缩缩的。伊卡洛斯，你又不是胆小鬼。为什么要让纷争化身欺负你呢？"
    }
    {
      Id = "Icarus_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得，当下的冲突已经够多了。厄里斯其实吓不到我。我只是不介意让她以为自己得逞了。嘿，她又不是什么智慧女神，对吧？"
    }
    {
      Id = "Icarus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近，我看见奥林匹斯山的山顶有烈焰喷涌而出。我还以为是火山爆发！结果，我凑近一看，发现竟然是你！正跟别人打得不可开交。然后有一只发了疯的老鹰飞过来，把我赶走了。"
    }
    {
      Id = "MelinoeField_3091"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是泰坦普罗米修斯，以及他的宠物。他背叛了众神，现在正亲自率兵攻打奥林匹斯山。他自称知道未来发生的事，自称为凡人而战……而他的武器，就是从我家人手上盗走的圣火。"
    }
    {
      Id = "Icarus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到他已经重获自由了。话说回来，克洛诺斯和众神的这场争端，又和凡人有什么关系？我以为他只是想要报仇雪恨！普罗米修斯估计也一样……"
    }
    {
      Id = "Icarus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，我来晚了！路上撞见了一只老鹰。要是我还有肝脏的话，也许我可以让他啃两口，然后我们就成好朋友了……至少普罗米修斯好像就是这么干的。"
    }
    {
      Id = "MelinoeField_3093"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来不止是凡人，鸟类也很爱戴他啊。不过，听起来你好像对普罗米修斯没有多少好感。看来他对凡人的喜爱，并不是所有凡人都领情呢。"
    }
    {
      Id = "Icarus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……毕竟我跟他又没见过面嘛！我还活着的时候，我们信仰的是众神，又不是泰坦。而且普罗米修斯激怒了众神，所以……嗯，单凭你不喜欢他这点，就足以让我也不喜欢他了。"
    }
    {
      Id = "Icarus_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "三岔路口有些暗灵，最近在谈论普罗米修斯的事。有些好像还挺喜欢他的，至少比克洛诺斯受欢迎多了。他一定很有魅力吧？"
    }
    {
      Id = "MelinoeField_4048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不这么觉得，但他对自己的理念确实非常执着。他为了凡人甘愿受尽折磨……哪怕他知道，绝大多数凡人永远不会意识到，更不会领情。"
    }
    {
      Id = "Icarus_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来有点像是在卖惨哎。要是他真的无所不知，怎么还会被抓住？而且众神很可能本来也会把火种赐予凡人的！"
    }
    {
      Id = "Icarus_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "我发誓，我之前有个晚上见到了大英雄赫拉克勒斯……！他只需要纵身一跃，就能从一艘船跳到另一艘船；每一槌下去，都有一个亡灵水手应声倒地！我飞得离他远远的。"
    }
    {
      Id = "MelinoeField_4035"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该没看错。奥林匹斯众神派他阻击泰坦的军团和舰队。我们偶尔有过合作，但他总是对我有所戒备……"
    }
    {
      Id = "Icarus_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "你跟{#Emph}赫拉克勒斯{#Prev}合作过？噢，要是哪天我有机会亲眼见到他就好了……！但我都不知道我该跟他说什么。“嘿！我跟其他人一样，都觉得你棒极了！”"
    }
    {
      Id = "MelinoeField_4036"
      InheritFrom = "BaseNarrative"
      DisplayName = "我之前见缝插针地跟赫拉克勒斯提了一下你。可惜他现在不太愿意见人，除非对方是众神要他击杀的目标。不过……他好像认识你。"
    }
    {
      Id = "Icarus_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？他怎么可能……{#Emph}他{#Prev}才是名声在外的那个啊！你确定他提到的名字是我，而不是狄德勒斯么？"
    }
    {
      Id = "MelinoeField_4037"
      InheritFrom = "BaseNarrative"
      DisplayName = "他确实也提到了狄德勒斯，因为……他好像见证了你临终的时刻。按他的说法，我推测……他可能是潜到了海里，把你的遗体捞了上来，好为你下葬。"
    }
    {
      Id = "Icarus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "为我{#Emph}下葬{#Prev}，可我……我一直都好奇我是怎么来到这里的，因为那时候我的记忆很模糊。结果居然是伟大的赫拉克勒斯亲自为我下葬！{#Emph}太神奇了！{#Prev}嘿，替我跟他说一声，就，就说“谢啦”，好么？"
    }
    {
      Id = "Icarus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以大力神赫拉克勒斯近况如何？有他在为众神而战，泰坦军团还能推进到这里，说实话有点出乎我的意料呢。"
    }
    {
      Id = "MelinoeField_4038"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯近况如何……这个问题我很难回答。我从来没见过如此勇猛的战士，但他同时也很有戒备心。我告诉他你想对他说声“谢啦”之后，他就“呃”了一声，别的什么也没说。"
    }
    {
      Id = "Icarus_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "他“呃”了一声……他回应我了。而且他知道我是谁！啊，谢谢你，墨利，这真是天大的好消息！嘿，我相信他只是累到了，休息一下就好了，你说呢？"
    }
    {
      Id = "Icarus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山上有一场灾难性的风暴正在酝酿，让我完全没办法靠近。那上面出什么事了……？"
    }
    {
      Id = "MelinoeField_3087"
      InheritFrom = "BaseNarrative"
      DisplayName = "那场风暴之中藏着真正的威胁。克洛诺斯重新唤醒了众魔之父，并且将他放了出来。我们所对抗的那些军队……只是拖延时间的佯攻手段。"
    }
    {
      Id = "Icarus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说那里面是{#Emph}提丰{#Prev}？！哦，众神啊……我小的时候，总会在我的塔里向你们祈祷，希望一切平安如意。现在，恐怕是你们该祈祷了……"
    }
    {
      Id = "MelinoeField_3088"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我们会消灭那个怪物。我还不知道该怎么做才能实现这个目标，但应该不需要用到祈祷。"
    }
    {
      Id = "Icarus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "那，以防万一，我还是帮你们祈祷一下好了！反正也没什么坏处。不过，一定要多加小心啊，墨利。以及，在你上路之前……先来选一个强化吧。"
    }
    {
      Id = "Icarus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你真的去挑战提丰了？我飞到了离那场风暴尽可能近的地方，瞥见了他一眼！他打你简直就像踩虫子一样！虽然虫子大概没办法用魔法手段逃跑……"
    }
    {
      Id = "MelinoeField_3089"
      InheritFrom = "BaseNarrative"
      DisplayName = "虫子还有翅膀呢，这方面比较像你啦！不过确实，我可以证明提丰的体型和力量都和你见到的一样。幸运的是，我比他更快……而且还有奥林匹斯山上的每位神明作为后盾。"
    }
    {
      Id = "Icarus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "但他们的力量，在我的发明面前只会{#Emph}黯然失色{#Prev}……！呃，我、我、我，我不该开这样的玩笑的……他们不会听到了吧……？别跟他们说哦。"
    }
    {
      Id = "Icarus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "前一夜，我看你飞入了奥林匹斯山的山顶……消失在了那场可怕的风暴之中。我甚至都没法靠近！那里面是什么样子？"
    }
    {
      Id = "MelinoeField_3090"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，里面糟糕透顶……我平常挺喜欢下雨的，但那里的暴风雨完全是另一回事。提丰被引入了众神的要塞，那里是通往宙斯宫殿的最后一道防线……而宙斯的宫殿，很可能就是他真正的目标。"
    }
    {
      Id = "Icarus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以众神一直在把他赶下去，但他一直在往上爬，一遍又一遍，想要实现同样的目标？看来是场意志的对决啊！用智慧对决应该会简单一些，大概吧。"
    }
    {
      Id = "Icarus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "在上一次你来过这里之后发生了一些事……这些船，它们一艘接一艘地全都{#Emph}沉了{#Prev}！我之前从没见过这片海域那样宁静。{#Emph}你是不是……？"
    }
    {
      Id = "MelinoeField_2151"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是不是抵达了我父亲的冥府，找到了克洛诺斯，然后把他杀掉了？没错。他是不是又复活了，意味着我做的一切很可能都是无用功？也没错。"
    }
    {
      Id = "Icarus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直都知道你一定能拿下他的，墨利。唔，现在你也看到了，他的船队又重新升起来了！但要我说，听起来像是你发现了他的一处弱点。"
    }
    {
      Id = "Icarus_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在海上一定见到过卡律布狄斯吧，就是那个{#Emph}超级巨大漩涡噩梦章鱼{#Prev}？我见过它一口吞掉像这么大的航船。我一直都躲得远远的！"
    }
    {
      Id = "MelinoeField_4034"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不像你那么幸运，没有“躲得远远的”这个选项。有些夜晚，我被迫要跟卡律布狄斯面对面……它那应该算是个“面”吧？要是你愿意冒险的话，我正好需要你的支援。"
    }
    {
      Id = "Icarus_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，这个{#Emph}真不行{#Prev}。我说过我愿意为你一头撞进太阳里，墨利，但卡律布狄斯，绝对不行。我对飞行的恐惧是一码事，对章鱼的恐惧是另一码事。"
    }
    {
      Id = "Icarus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是……？不可能。你身边那个真的是弗利诺斯吗？他以前只会开开心心地坐在那里！或者伤心地坐在那里，我一直都分辨不出来。而现在，他来跟你并肩作战了……"
    }
    {
      Id = "MelinoeField_3097"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，绝无仅有的那一个！我也从没想过他有这样的本领，直到老师告诉了我更多和魔宠合作的秘密。"
    }
    {
      Id = "Icarus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直以为魔宠只是宠物而已！嗯，弗利诺斯？真高兴能再见到你，好兄弟。{#Emph}保护好墨利哦，好么……？"
    }
    {
      Id = "Icarus_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "想把我介绍给你另一位长了翅膀的朋友吗？看起来像是只渡鸦，不过我从没见过像他这样的……"
    }
    {
      Id = "MelinoeField_4041"
      InheritFrom = "BaseNarrative"
      DisplayName = "对哦，不好意思，二位！伊卡洛斯，这是拉奇，我的魔宠。拉奇，这是伊卡洛斯，我的好朋友！你们俩的翅膀真是“翼”曲同工。"
    }
    {
      Id = "Icarus_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯！很高兴认识你，拉奇。我会向你学习飞行技术的，我一直都觉得我还有进步的空间。"
    }
    {
      Id = "Icarus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看他们对你做了什么，那些该死的……啊！真抱歉我没能更早赶来，墨利……你有没有考虑过直接回去？我的意思是，你都伤成{#Emph}这样{#Prev}了，为什么还要继续……"
    }
    {
      Id = "MelinoeField_3094"
      InheritFrom = "BaseNarrative"
      DisplayName = "我伤得不像你想的那么严重啦，伊卡洛斯，而且我知道自己的极限在哪里。不过，谢谢你的关心。"
    }
    {
      Id = "Icarus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是……我只是真的很不忍心看到你这副样子。哪怕你的伤口明天就会愈合，现在你也一定十分痛苦。总之……也许我的一些发明能帮助你继续前进。"
    }
    {
      Id = "Icarus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真应该看看我有多少发明一点用都没有。我知道它们的强度参差不齐，但我拿出来的这些都已经是百里挑一了。 这点我向你保证。"
    }
    {
      Id = "MelinoeField_4039"
      InheritFrom = "BaseNarrative"
      DisplayName = "有我这样的人愿意为你测试，对你的发明创造一定也有帮助吧。毕竟，不经过检验，就没办法知道它们好不好用，对么？"
    }
    {
      Id = "Icarus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗤鼻声）你不是在帮我测试啦，墨利！我的锤子都经过了极为缜密的测试，然后才能冠上狄德勒斯的名号。不过，要是你有什么反馈的话，欢迎告诉我哦。"
    }
    {
      Id = "Icarus_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近在做一件东西，已经做了一段时间了，之前没跟你说是因为我想等做好了再告诉你。总之我又检验了一番，现在应该已经可以啦。"
    }
    {
      Id = "MelinoeField_4040"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，好期待。你的发明肯定需要不少时间来准备和生产。这件是干什么用的？"
    }
    {
      Id = "Icarus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "你会明白的，不过简单来说，它能让几乎所有事变得更好啦，就，就跟{#Emph}你{#Prev}一样。要是你不感兴趣的话，也不是非得用的！"
    }
    {
      Id = "Icarus_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道暗夜武器可以变化成很多不同的形态，但看到它们变成{#Emph}这副样子……{#Prev}嘿，你一定是做出了什么壮举，才赢得了它们的恩赐，对吧？"
    }
    {
      Id = "MelinoeField_4030"
      InheritFrom = "BaseNarrative"
      DisplayName = "大概吧？要不然就是暗夜武器想让我这段时间一直使用它们，不管是用哪个形态。说起来，你的锤子是怎么在暗夜武器变形之后仍然能派上用场的？"
    }
    {
      Id = "Icarus_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为我专门确保了这一点！而且，看到不同的形态实战的表现，总能给我很多灵感。"
    }
    {
      Id = "Icarus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴能在这里见到你！我以前从来不会往这边飞，但是这次我发现，鹰身女妖和自动机的数量都少了一些……嗯，还发现了{#Emph}你{#Prev}啦。今晚一切顺利吗？"
    }
    {
      Id = "MelinoeField_3092"
      InheritFrom = "BaseNarrative"
      DisplayName = "比你来之前好多了，多亏有你。所以，你感觉怎么样？众神之山符合你的想象吗？"
    }
    {
      Id = "Icarus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "基本符合……考虑到凡人无论生前还是死后都不该目睹奥林匹斯山的辉煌。不过，我更想看到的是你，墨利。来，这个应该能为你接下来的攀登提供助力。"
    }
    {
      Id = "Icarus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近这座山不像以前那样被风暴肆虐了，不过你的家人{#Emph}真的{#Prev}要容忍这些萨提尔之类的东西继续糟蹋他们的家园吗？看起来不像他们的做派……"
    }
    {
      Id = "MelinoeField_4054"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，他们能引我找到提丰……或者说是提丰超越时间的某种残留。我们在和我爷爷合作，嗯，可以说是在清理时间线吧。"
    }
    {
      Id = "Icarus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}爷爷{#Prev}，你、你不会是在说{#Emph}克洛诺斯{#Prev}吧？而且照你这么说，提丰还{#Emph}存在{#Prev}？不是说他被消灭了吗，我都没再看到过任何他的迹象了啊。嘿，这一定是那种超出凡人理解范围的事情，对吧？"
    }
    {
      Id = "MelinoeField_4055"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也没能完全理解……关于时间及其运行的规律，我们还有很多不了解的地方，不过我们都在慢慢学习。"
    }
    {
      Id = "Icarus_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不觉得时间有什么复杂的啦。遇到坏事时间就拖拖拉拉的，遇到好事时间就走得太快。不过我自己也还在学习怎么样应对啦。"
    }
    {
      Id = "MelinoeField_4044"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以用了灵质秘药之后，你有机会感受清风的吹拂、海浪的拍打么？我之前没办法确定它的效力能持续多久，所以希望你能尽量把它好好利用起来。"
    }
    {
      Id = "Icarus_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是自从我存在以来最美好的一个夜晚，真的。感受清风和海浪，那样结束那个夜晚，真是太完美了！最开始我还以为是寒冷让我麻木，后来才意识到是秘药渐渐失效了。"
    }
    {
      Id = "MelinoeField_4045"
      InheritFrom = "BaseNarrative"
      DisplayName = "那一夜对我来说也很特别。是这样的，我的外婆得墨忒尔曾与一个凡人相爱……在那之后她生下了我母亲，后来我母亲又生下了我！所以我算不上是真正的女神啦，而且一直对我身为凡人的那部分很有兴趣。"
    }
    {
      Id = "Icarus_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是个真正的女神，墨利。你身上有凡人的血液，那就更棒了。总之，那真的是很美妙的一段时光……虽然现在已经结束了，但至少我还有回忆！"
    }
    {
      Id = "MelinoeField_4046"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许我们还能有更多。我是指，更多的回忆。毕竟，考虑到灵质秘药能起到那样的效果……我说不定能再做一些呢。"
    }
    {
      Id = "Icarus_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "（吸气）哇，如果我的心脏还在跳动的话，只怕是要撞开我的胸口了！要是能再跟你共度一个夜晚，我甘愿付出任何代价……不过和上次不一样，我会有耐心的。我发誓。"
    }
    {
      Id = "Icarus_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是自从我存在以来最美好的一个夜晚。和你一起感受生命，然后还能感受清风和海浪！最开始我还以为是寒冷让我麻木，后来才意识到是秘药渐渐失效了。"
    }
    {
      Id = "MelinoeField_4047"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很高兴。我一开始还担心我会不会又伤害到你了。我们现在所拥有的……也许和你所渴望的不完全一样。但这对我而言意义重大，也是我所能给予的全部。"
    }
    {
      Id = "Icarus_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "这对我来说意义也很重大。而且你给予我的，远比我所梦想过的更多……嘿，所以就让我给你把好锤子，作为对你的报答吧？"
    }
    {
      Id = "Icarus_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上{#Emph}哪儿{#Prev}去了，墨利？有太多个晚上没在这里见到你了，哪儿都找不到你。有什么事情不对劲，我不知道具体是什么，但感觉克洛诺斯可能又有了新的阴谋。他的军队动向十分{#Emph}诡异{#Prev}……！"
    }
    {
      Id = "MelinoeField_4049"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯的军队动向诡异，是因为他{#Emph}放弃{#Prev}了这场战争！伊卡洛斯……我们的战争胜利了！冥府恢复了正统！具体的方法我跟你说了你也不会相信，但这是{#Emph}真的！"
    }
    {
      Id = "Icarus_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯放弃了，等等，{#Emph}什么……？不可能！{#Prev}可是我们刚刚就在{#Emph}这里{#Prev}消灭了他的一支部队！你{#Emph}真的{#Prev}是认真的……"
    }
    {
      Id = "MelinoeField_4050"
      InheritFrom = "BaseNarrative"
      DisplayName = "我什么时候骗过你嘛！时间泰坦{#Emph}变了。{#Prev}在他的存续受到威胁的那一刻，我们终于让他幡然醒悟。我现在在去奥林匹斯山的路上，去确保那里的事态保持稳定。"
    }
    {
      Id = "Icarus_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "我，我简直{#Prev}无法相信{#Prev}！啊，我是想说，我当然可以相信。嘿！你{#Emph}终于{#Prev}搞定他了！你这算是搞定他了，对吧？呃，我不知道该说什么……这些你选一个收下吧？"
    }
    {
      Id = "MelinoeField_4050_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "我什么时候骗过你嘛！时间泰坦{#Emph}变了。{#Prev}在他的存续受到威胁的那一刻，我们终于让他幡然醒悟。"
    }
    {
      Id = "Icarus_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，上次我们在三岔路口聊天的时候，我……我不是故意要惹你生气的，墨利。只是……我之前没有想过，你会需要像现在这样一直战斗下去。"
    }
    {
      Id = "MelinoeField_4056"
      InheritFrom = "BaseNarrative"
      DisplayName = "你当时问我，我的余生要怎么过，我一下就慌了神。我从来没考虑过那么长远的事。"
    }
    {
      Id = "Icarus_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，估计你也不需要找到答案啦，毕竟你还是要往这边跑。而且估计也要往冥界去。"
    }
    {
      Id = "MelinoeField_4057"
      InheritFrom = "BaseNarrative"
      DisplayName = "规律的生活确实有让人安心的地方。不过，我必须得接受，也许这就是唯一一件我该做的事。唯一一件我擅长的事。"
    }
    {
      Id = "Icarus_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不需要接受这种事，墨利。我父亲做的唯一一件事就是工作。他觉得那就是他的使命！但是你跟他不一样。总之……余生什么的，等等也无妨啦！嘿，咱们可以先过好今晚，然后再一步步来，对吧？"
    }
    {
      Id = "MelinoeField_4051"
      InheritFrom = "BaseNarrative"
      DisplayName = "伊卡洛斯，我跟你说，我终于体验到飞行的感觉了！我跟月神一起，坐上了她的马车。虽然驾车的不是我，但那种感受确实令人难以忘怀。"
    }
    {
      Id = "Icarus_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你去到了{#Emph}那么高{#Emph}的地方？{#Emph}太棒了！{#Prev}月神本尊带你横跨天穹，哇。我曾经想过，也许{#Emph}我{#Prev}飞得再高一点，就能触碰到她，但是，呃……我最终说服自己打消了这个念头。"
    }
    {
      Id = "Icarus_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，所以真的还有更多的事要做咯？要说与克洛诺斯的战争真的结束了，看到这些战舰的人恐怕都很难相信吧。以及那些鹰身女妖，也一点都没有变得更友善啊。"
    }
    {
      Id = "MelinoeField_4052"
      InheritFrom = "BaseNarrative"
      DisplayName = "里面一定有些是时间泰坦的狂热信徒，仍然相信他会再次崛起。但我们在努力确保克洛诺斯和提丰的威胁永远不会再次发生。只是，为了实现这个目标，我需要重新走过我曾经去往奥林匹斯山的路线。"
    }
    {
      Id = "Icarus_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样啊……那好。也就是说，我可以继续飞行，而且可以继续在{#Emph}这里{#Prev}见到{#Emph}你{#Prev}……那听起来很不错嘛。"
    }
    {
      Id = "MelinoeField_4053"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没错！我们原本以为战争结束意味着你得把翅膀摘下来。但是，我父亲对冥界的翻修工作，看起来要开展很长很长的时间。"
    }
    {
      Id = "Icarus_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想，最终我还是得回到我该去的地方。但现在，我想尽可能好好把握住这段时间。"
    }
    {
      Id = "Icarus_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近没在这里见到你呢！是在冥界忙吗，还是泡上温泉、喝上仙酒了？"
    }
    {
      Id = "MelinoeField_4059"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算真是那样，我也不会这么轻易承认呢。不过，你说得对，我们在这里有段时间没见过面了。有什么新鲜事要报告吗？"
    }
    {
      Id = "Icarus_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "报告，我很高兴能见到你，不过这应该不算什么新鲜事啦。你爷爷在复活他死掉的追随者上也非常{#Emph}高效{#Prev}，如果这是你们计划的一部分的话。这里都人满为患了！"
    }
    {
      Id = "Icarus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "我喜欢我们现在的日常，墨利！感觉一直这样下去，也永远不会厌烦。我们现在配合那么默契……就连闲聊都可以省了。"
    }
    {
      Id = "Icarus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正在天上闲逛，突然看到你，就想过来打个招呼。见到你真好，墨利。"
    }
    {
      Id = "Icarus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚的海面很不平静，不过天色倒是不错。嘿，你要照顾好自己哦？"
    }
    {
      Id = "Icarus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "我好像在海岸线那边见到厄里斯了。给她带去点惊喜怎么样？"
    }
    {
      Id = "Icarus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是能在这里多留一会儿，和你聊会儿天的话，让我干什么都行。但我知道现在不是时候。"
    }
    {
      Id = "Icarus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的酷毙了，墨利。我在天上什么都看到了！嘿，继续加油哦？"
    }
    {
      Id = "Icarus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道，你还要赶路。幸运的是，我正好有可以帮助你赶路的东西。"
    }
    {
      Id = "Icarus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你觉得以后我们回首往昔的时候，会不会怀念这段时光？"
    }
    {
      Id = "Icarus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道你是怎么夜复一夜坚持下来的，但我很高兴看到你还在坚持。"
    }
    {
      Id = "Icarus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到你总是很高兴，墨利，哪怕只是照个面。除了你没人愿意帮我测试这些东西！"
    }
    {
      Id = "Icarus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "海岸线上目前看不到敌人！不过，过了这里，就不保证咯。"
    }
    {
      Id = "Icarus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来的时候好像解决掉了一两个。嘿，总比没有强吧？"
    }
    {
      Id = "Icarus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近一直在改良这些。想要哪个就拿哪个！"
    }
    {
      Id = "Icarus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管你要选哪一件，我都保证你百分百满意。"
    }
    {
      Id = "Icarus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山就在不远处。也许这些东西能帮你爬上去。"
    }
    {
      Id = "Icarus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你时间不多，所以这个你拿去，路上用得着。"
    }
    {
      Id = "Icarus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "状态很好嘛……！刚才我看得都有点担心了。"
    }
    {
      Id = "Icarus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是我可以的话，真想现在就带你飞到众神的宫殿……"
    }
    {
