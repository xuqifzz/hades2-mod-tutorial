    }
    {
      Id = "Icarus_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "感觉这艘船随时都有可能沉没，所以咱们还是不要逗留太久……"
    }
    {
      Id = "Icarus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这些东西会有能派上用场的。今夜我就只带了这么多。"
    }
    {
      Id = "Icarus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些达不到我父亲的水准，但我觉得也还说得过去啦……"
    }
    {
      Id = "Icarus_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近一直在想，跟你一起在这里的时候，总感觉前所未有地兴奋……"
    }
    {
      Id = "Icarus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山离这里没多远了。我一会儿就往那边飞，先帮你吸引点火力。"
    }
    {
      Id = "Icarus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "有很多暗灵相信你，相信你努力要实现的未来。"
    }
    {
      Id = "Icarus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真的想说，这对翅膀比我父亲做的{#Emph}好多了{#Prev}！"
    }
    {
      Id = "Icarus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "我敢打包票，我从来没有想到过死后会过上这样的生活。"
    }
    {
      Id = "Icarus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你能照顾好自己，但是让我看看我能帮到什么忙吧。求你了。"
    }
    {
      Id = "Icarus_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到你总是很开心，墨利……我现在虽然站在这里，但却感觉像是在飞一样！"
    }
    {
      Id = "Melinoe_3264"
      InheritFrom = "BaseNarrative"
      DisplayName = "你现在可以想飞到哪就飞到哪啦！不过，我很高兴你没有飞得太远，去到我追不到的地方。这个你收下！你那媲美众神的翅膀配得上这样的礼物。"
    }
    {
      Id = "Icarus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦拜托，我是能在奥林匹斯山周围翱翔，但这又不意味着我可以像他们一样享用这种东西！嘿，不过也许有你的许可，也不是不行？你猜怎么着，我也有份礼物要给你。"
    }
    {
      Id = "Icarus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你给我的上一瓶蜜露实在是{#Emph}太{#Prev}美味了，根本无法想象要是我还活着的话会是什么感觉。我本来没好意思开口再要一瓶，但是……既然你主动给了，那我就不客气了！"
    }
    {
      Id = "Melinoe_3266"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用客气，拿去吧！也许现在你成了暗灵反而会更好。你们凡人吃喝是为了生存，但蜜露满足的是另一种需求。"
    }
    {
      Id = "Icarus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "我小的时候被困在一座塔上，因此算是衣食无忧，但是{#Emph}这个{#Prev}？我不会说我嫉妒众神，尤其是他们最近遭受了这些事情……但说真的，他们的饮料是真不赖。"
    }
    {
      Id = "Melinoe_3499"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神一直过着养尊处优的生活……可是你的生命却那么短暂，那么困苦。你一定还有很多遗憾想要弥补，所以我想，也许这个能帮上忙！"
    }
    {
      Id = "Icarus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "很久以前，我一直想找到一瓶上好的蜜露，作为礼物送给你……但我始终没有付诸行动。我得把这件事也加入“要是我当初不这样就好了”的清单里。"
    }
    {
      Id = "Melinoe_3500"
      InheritFrom = "BaseNarrative"
      DisplayName = "别太执着于过去了。你之前还以为再也见不到我了呢，但我现在就站在你面前呢。我很珍惜我们在一起的这一刻。"
    }
    {
      Id = "Icarus_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会永远铭记于心。"
    }
    {
      Id = "Icarus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "几乎感觉不到这个瓶子……只能感受得到它的分量。不过，我还有之前的美好回忆，可以帮我填补这样的空缺。说来可笑，我已经记不清自己死了多久，但还没有完全适应死后的生活。"
    }
    {
      Id = "Melinoe_4529"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许我们都永远无法彻底习惯自己的样子。不过，你居然会对自己的童年有美好的回忆，让我有些惊讶。"
    }
    {
      Id = "Icarus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还说上我了！你自己不也常常感慨小时候静静地呆在水边，听流水和蛙鸣声的时光么？有的时候我们会忘却伤痛，有的时候伤痛又是我们唯一记得的东西。不过，我会把这一刻也牢牢记住的。"
    }
    {
      Id = "Icarus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "我小时候实在是太莽撞了。我爸一直跟我说要小心谨慎，但我当时被困在一座该死的高塔上……再怎么胡作非为也伤不到自己。可现在……我唯一的希望就是不要把事情搞砸。"
    }
    {
      Id = "Melinoe_4530"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于能在天空中自由飞翔的人来说，你也太容易困在自己的思绪中啦。你面对的不是什么考验，伊卡洛斯。是我。而我就是单纯喜欢能做自己的你。"
    }
    {
      Id = "Icarus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，墨利，我怎么配得上你……！你是冥界不死不灭的王女，而我只是一个失败的学徒——就连自己父亲最简单的命令都执行不了的学徒——早早夭折之后弥留的暗灵。你真的就喜欢{#Emph}这样{#Prev}的我？"
    }
    {
      Id = "Melinoe_4531"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，你才不是你所说的那样。我对你的感情完全不是出自怜悯，你又为什么要这么妄自菲薄呢？抛下这些思绪吧。但你真正的感受，永远不用对我隐瞒。"
    }
    {
      Id = "Icarus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会试试的……我一定会的，要不然也太蠢了。所以，嗯……！继续前进，永不退缩？"
    }
    {
      Id = "Melinoe_4532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是的，不过也别忘记珍惜当下哦。"
    }
    {
      Id = "Melinoe_4558"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来你第一次尝到仙酒的时候很喜欢，所以我想再送你一瓶，供你自己独享。挑个好时机好好品尝吧。"
    }
    {
      Id = "Icarus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "供我自己独享，挑个好时机……{#Emph}哇，真的吗？{#Prev}哦，拜托，墨利，这真的太贵重了！我都拿不出像样的回礼！"
    }
    {
      Id = "Melinoe_4559"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么可能！你给我的东西比这要贵重得多。而且我指的不仅仅是你辛苦打造的那些锤子。"
    }
    {
      Id = "Icarus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "我所做的这些事，但凡是你的暗灵仰慕者，哪个不会尽心尽力地去做嘛……如果说暗灵还有“心”的话。"
    }
    {
      Id = "Melinoe_4560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等等，所以说你是我的“暗灵仰慕者”咯？"
    }
    {
      Id = "Icarus_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呀，够啦。总之，我收下了哦。"
    }
    {
      Id = "Melinoe_4561"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有个想法，不如我再送你一瓶仙酒，但这次，你不许再假装自己只是个普通的暗灵。你远不止如此。而且你在我眼中，也不仅仅是朋友而已。"
    }
    {
      Id = "Icarus_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "……好吧，可是……你不觉得，我们之间可能有缘无份么？我触碰你时，感觉就像一阵清风，仿佛我不在这里，而是在一个时空……"
    }
    {
      Id = "Melinoe_4562"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}就在{#Prev}这里。我也担心自己会受伤，可我每晚还是会像这样出发。因为，不愿冒受伤的风险……或者说不愿面对必然受伤的结果的话，就永远无法做到我该做的事。有些时候，这样做是值得的。"
    }
    {
      Id = "Icarus_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "我受点伤不算什么，又有谁会在意呢？但万一我{#Emph}害你{#Prev}受了伤，我还有什么面目苟活……还有什么面目苟{#Emph}存{#Prev}于世，你知道我的意思。可是……啊！我真的无法相信我在和你争这个，墨利，我其实从来没有这么{#Emph}开心{#Prev}过！但我也很{#Emph}害怕……"
    }
    {
      Id = "Melinoe_4563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这份恐惧，我们可以一起面对。"
    }
    {
      Id = "Melinoe_4564"
      InheritFrom = "BaseNarrative"
      DisplayName = "不如再来一瓶仙酒，就当做个实验，因为我发现这种能让他人感到温暖的饮品，似乎不知为何反而会让你感到凄凉。"
    }
    {
      Id = "Icarus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，太好了，我正愁自己还不够凄凉呢。你是知道原因的，不是么？我们之前就尝试过这一切，但却行不通。要是行得通该多好啊，可是……唉。"
    }
    {
      Id = "Melinoe_4565"
      InheritFrom = "BaseNarrative"
      DisplayName = "我现在更有经验了。有的时候，试一次行不通，那就得再试一次。哪怕一直失败，我也愿意一直试下去，直到成功为止。"
    }
    {
      Id = "Icarus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利，我同意你的说法……但前提是尝试的代价不能那么惨痛！就拿你来说，唔……你还有一条胳膊，嗯。还有两条腿。你真的愿意把它们都押上，就为了我吗？就为了让我变得{#Emph}完整？"
    }
    {
      Id = "Melinoe_4566"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，我知道我没办法将你永远变回血肉之躯。但我们之间的这份感情……这条一直存在的纽带……我愿意看看它究竟通往何方。如果你愿意的话，我想和你一起。"
    }
    {
      Id = "Icarus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "我当然愿意，墨利。让我跟你一起上刀山下火海，哪怕是一头撞进太阳里我也愿意。"
    }
    {
      Id = "Melinoe_4567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我有主意了。"
    }
    {
      Id = "Melinoe_4570"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心，这不是另一瓶仙酒。这个叫做灵质秘药。没有我曾经试过的那道咒语那么强力，但我觉得这个应该会有用的。"
    }
    {
      Id = "Icarus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在说什么，墨利？等等……这个秘药可以让我变{#Emph}完整？{#Prev}或者是部分完整，嘿，比如变条胳膊出来之类的？"
    }
    {
      Id = "Melinoe_4571"
      InheritFrom = "BaseNarrative"
      DisplayName = "它可能可以让你恢复对自我的感知，就好像你还活着一样。但是效果不会持续太久，可能最多一个晚上吧。为了让它更安全，只能做出这样的让步。"
    }
    {
      Id = "Icarus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗，也就是说……我可以再度成为我自己了……感受清风的吹拂，感受海浪的拍打！但只有一夜的时间。你、你能做出更多吗？"
    }
    {
      Id = "Melinoe_4572"
      InheritFrom = "BaseNarrative"
      DisplayName = "还是不要操之过急了。一下摄入太多的话，这种东西是可能会有副作用的。向我发誓你不会那样做。"
    }
    {
      Id = "Icarus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在此发誓，我使用灵质秘药的时候，绝不会操之过急。我曾经忽视过非常合理的建议，因而付出了惨重的代价。我不会再犯同样的错误。"
    }
    {
      Id = "Melinoe_4573"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就请在你觉得合适的时候使用它吧，或许可以挑一个格外特别的夜晚。而且，先把它当作一次性的东西吧。"
    }
    {
      Id = "Icarus_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你……真的很谢谢你……"
    }
    {
      Id = "Melinoe_4533"
      InheritFrom = "BaseNarrative"
      DisplayName = "顺便一提，你有见过翻修后的温泉么？是个放松解乏的好地方，要不要去看看？"
    }
    {
      Id = "Icarus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "和你吗？现在吗？好啊！嘿，不过，别指望泉水对我的皮肤有什么保养作用哦？"
    }
    {
      Id = "Icarus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "……有的时候生活真是匪夷所思。在我活着的时候，我从来不可能想象得到，未来的某一天我会{#Emph}这样{#Prev}度过。"
    }
    {
      Id = "Melinoe_4535"
      InheritFrom = "BaseNarrative"
      DisplayName = "这只是个温泉啦，伊卡洛斯。虽然泉水受到了净化，还有各种魔法的作用，但说到底也就是个温泉。你还能飞天入地，阻击海上的舰队呢……这怎么会比那些事更匪夷所思啦。"
    }
    {
      Id = "Icarus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵。重点是我在这里啦，和你在一起。你真的好美，墨利。也不是说你需要我们这些暗灵和凡人的赞美啦！嘿，阿弗洛狄忒本尊肯定都告诉过你，不是么？"
    }
    {
      Id = "Melinoe_4536"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，别这样说，阿弗洛狄忒是我们坚定的盟友。要是她嫉妒我的话，怎么会像现在这样，毫不吝惜她那些无比强力的祝福呢。"
    }
    {
      Id = "Icarus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是这个意思啦。我们凡人……常常会有某种羞耻心。我们的身体很脆弱，而且有时很丑……但神明就完全不会有这种顾虑。"
    }
    {
      Id = "Melinoe_4537"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不觉得有什么好羞耻的啦。我认识像你这样的暗灵，还有奥德修斯……你们和神明也很接近嘛！"
    }
    {
      Id = "Icarus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，谢谢你这样说。而且在这里泡一泡，真的很放松呢。能和你在这里共度时光，我真的很开心。"
    }
    {
      Id = "Icarus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "……要是能再多待一会儿就好了。不过刚才真的好棒。谢谢你带我一起来。"
    }
    {
      Id = "Melinoe_4539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真好啊……"
    }
    {
      Id = "Melinoe_4540"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次一起去泡温泉很开心，而且我想着你说不定又想泡一泡了。要不就现在？"
    }
    {
      Id = "Icarus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！唔，我的翅膀需要修一修，不过……我在说什么啦，那个等一等又无妨。我们走吧？"
    }
    {
      Id = "Melinoe_4541"
      InheritFrom = "BaseNarrative"
      DisplayName = "你很安静，伊卡洛斯。在想什么呢？除了你打造的那对壮观的翅膀需要修理的事。"
    }
    {
      Id = "Icarus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，我只是在想……我所度过的绝大多数夜晚，都远没有这么愉快。我希望这一夜能过得久一些。当然还有那对倒霉翅膀的事啦！要是它真那么“壮观”，就不会坏了。"
    }
    {
      Id = "Melinoe_4542"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得，壮丽的事物往往恰好是脆弱的。不过，这对翅膀看起来比你说的要牢固嘛！至少应该比狄德勒斯那对颇负盛名的翅膀牢固，毕竟那对翅膀辜负了你。"
    }
    {
      Id = "Icarus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "是我辜负了那对翅膀。我父亲的翅膀是用羽毛和蜂蜡做的，当时他只能弄到那些材料。蜂蜡必须要保持冷却，但我飞得太高，碰到了太阳。现在想想，其实好像应该在夜里出发……"
    }
    {
      Id = "Melinoe_4543"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你们当时没有做选择的余地，毕竟是别人的阶下囚。所以后来发生了什么？你的翅膀融化了？"
    }
    {
      Id = "Icarus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，是的。展翅翱翔实在是太刺激了，我飞得忘乎所以。总之，最后我掉了下去。新的这对翅膀用的是像鸟骨一样的材质，所以没那么容易裂开。不过，咱们还是不要说过去的事了，好么？比起过去，我更喜欢现在啦。"
    }
    {
      Id = "Icarus_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}……呼！{#Prev}人们总是说“死者安息”，但我{#Emph}太久{#Prev}没有像这样这么放松地休息过了。嘿，谢谢啦！"
    }
    {
      Id = "Melinoe_4545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不客气！"
    }
    {
      Id = "Melinoe_4555"
      InheritFrom = "BaseNarrative"
      DisplayName = " 嘿，你不忙的话，想和我一起去泡会儿温泉吗？"
    }
    {
      Id = "Icarus_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "你都不知道我有多想，但我现在真的不行……我跟奥德修斯大师说好了一会儿就出发。"
    }
    {
      Id = "Melinoe_4546"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，如果你不急着飞走的话，要不跟我一起去一趟钓鱼栈桥？那里景色很不错，而且很安静。"
    }
    {
      Id = "Icarus_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啊，听起来很棒！不过先说好，我从来没学过钓鱼，所以帮不上什么忙可别怪我哦。"
    }
    {
      Id = "Icarus_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "……在我的故乡，鱼是主要的食物来源之一。说来很奇怪，我……我从来没有真的把它们当作活物，没有想过它们和我一样都是有生命的。好吧，不算是{#Emph}和我一样{#Prev}，但你懂我的意思。我那时候还是个孩子！什么都不懂啦。"
    }
    {
      Id = "Melinoe_4547"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们凡人吃的所有东西都是生物，或者至少曾经有过生命。我很欣慰我没有进食的需求……我一直都不喜欢这个想法，吞噬其他生灵，只为让自己的生命得到延续。"
    }
    {
      Id = "Icarus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "所谓凡人，不就是整天都要做不喜欢的事嘛。这是我们跟你们最大的区别之一，另一个区别则是我们很容易就会死掉。除了挣扎求生，我们还有什么选择呢？"
    }
    {
      Id = "Melinoe_4548"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许确实别无选择。自然界的许多生灵都在挣扎求生，从渴望一缕阳光的花朵，到这边这个拐弯抹角想让我教你钓鱼的你！"
    }
    {
      Id = "Icarus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈哈。好吧，我知道钓鱼需要保持安静……所以不如你来演示一下，我就在旁边静静地看着好了。"
    }
    {
      Id = "Icarus_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我真的很享受刚才的时光，就连静静等鱼上钩那部分也喜欢。谢谢你带我一起来。"
    }
    {
      Id = "Melinoe_0768"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不客气。"
    }
    {
      Id = "Melinoe_4556"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在想，也许我们可以再去一次钓鱼栈桥？如果你愿意的话。"
    }
    {
      Id = "Icarus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我很想去，但是我今晚不能在这里待太久啦。嘿，以后再邀请我，好么？"
    }
    {
      Id = "Melinoe_4549"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你喝过仙酒吗，伊卡洛斯？没有的话，那待会儿就让你见识见识。当然，前提是你愿意，而且有时间哦。"
    }
    {
      Id = "Icarus_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "实话说，我不仅没有尝过，而且在你开口问之前，我都从来没有想过这种事情。你确定我可以尝吗……？"
    }
    {
      Id = "Icarus_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "……别的暗灵都在看着我们耶，墨利。他们这么仰慕你，要不是我已经死了，很可能会咒我去死吧。"
    }
    {
      Id = "Melinoe_4550"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心啦。如果有暗灵嫉妒过头的话，最后也只会吸引到涅墨西斯的注意而已。而且他们为什么要在意呢？我见他们比见你要多啊。"
    }
    {
      Id = "Icarus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，只是……身为凡人，我们很多人都容易嫉妒。尤其是当我们看到我们在意的人和别人在一起的时候。有点不好解释，但我觉得根源在于我们内心都知道，自己的时间少得可怜。"
    }
    {
      Id = "Melinoe_4551"
      InheritFrom = "BaseNarrative"
      DisplayName = "但现在你们既然都在这里了，就有着永恒的时间了啊。只要克洛诺斯还没有把一切都不可逆转地毁掉。不过，我们众神大概有的时候也会有这样的感觉。"
    }
    {
      Id = "Icarus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}真的吗？{#Prev}拜托，墨利，你能不能哪怕举出一件让你嫉妒的事？你看起来那么从容自信，对自己拥有的一切也从无怨言……我从来没有见过你渴望任何不属于你的东西。"
    }
    {
      Id = "Melinoe_4552"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你一定是没有观察仔细。比方说，我很嫉妒老师。我永远都不可能成为她那样的女巫，甚至连她的一半都不如。而且我戴起帽子来也远没有她那么优雅。"
    }
    {
      Id = "Icarus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，那看来是我想错了！原来你会嫉妒岔路女巫的{#Emph}帽子{#Prev}啊。嘿，现在我们可以开喝了吗？也可以给别的暗灵留一些啦！"
    }
    {
      Id = "Icarus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哇。我生前从来没品尝过这样的东西。死后也没有。众神喝这种饮料是很平常的事吗……？"
    }
    {
      Id = "Melinoe_4554"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少对有些神来说是啦！"
    }
    {
      Id = "Melinoe_4557"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又拿到了一瓶仙酒，如果你愿意的话，我们可以一起去小酒馆分着喝？"
    }
    {
      Id = "Icarus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真的很想去，不过……我们收到报告说，裂谷出现了一支新的舰队，我最好先去会会他们。"
    }
    {
      Id = "Icarus_0394"
