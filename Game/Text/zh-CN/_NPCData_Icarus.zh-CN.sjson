    }
    {
      Id = "Icarus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，驶向奥林匹斯山的舰船数量基本上每晚都没有变化。他们的任务似乎没有受到一丝一毫的影响。"
    }
    {
      Id = "Odysseus_0436"
