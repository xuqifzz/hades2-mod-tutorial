    }
    {
      Id = "Icarus_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "……此外，我还想向您道谢，女士。谢谢您接纳了我，也谢谢您允许我回到这里，以及谢谢您愿意将事情托付给我！别的暗灵很少能像我这样幸运。"
    }
    {
      Id = "Hecate_0877"
