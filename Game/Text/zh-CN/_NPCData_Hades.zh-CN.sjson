    }
    {
      Id = "Storyteller_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三头的刻耳柏洛斯用凌厉的目光同时扫视着房间的每一个角落。"
    }
    {
      Id = "Storyteller_0246"
      InheritFrom = "BaseNarrative"
