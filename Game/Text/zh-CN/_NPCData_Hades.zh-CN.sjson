    }
    {
      Id = "Hades_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "坐下，刻耳柏洛斯……"
    }
    {
      Id = "Hades_0142"
      InheritFrom = "BaseSubtitle"
