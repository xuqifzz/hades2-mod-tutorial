    }
    {
      Id = "Storyteller_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}恶名昭著的凶犬刻耳柏洛斯端坐在主人身侧，保持着警戒。"
    }
    {
      Id = "Storyteller_0248"
      InheritFrom = "BaseNarrative"
