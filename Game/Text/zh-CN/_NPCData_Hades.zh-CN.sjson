    }
    {
      Id = "Hades_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但愿如此。"
    }
    {
      Id = "Hades_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意……"
    }
    {
      Id = "Hades_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呸！{#Prev}又一个行刑者，妄图摧垮我的意志。你尽管试吧，我倒要看看你这小身板有什么能耐。泰坦王找不到更像样的助手了吗？"
    }
    {
      Id = "Melinoe_1056"
      InheritFrom = "BaseNarrative"
      DisplayName = "你……你是……你是这头魔兽的主人吗？"
    }
    {
      Id = "Hades_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这头魔兽的主人？{#Prev}哈，哈哈！倘若人们还没有忘记我的话，我能想到比这糟得多的称号。不过，这头魔兽怎么对你连吼都不吼一声……"
    }
    {
      Id = "Melinoe_1057_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}（吸气）{#Prev}哈迪斯大人，您是我的……父亲，我是……墨利诺厄。我是您的女儿。"
    }
    {
      Id = "Hades_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我的女儿。墨利诺厄？仁慈的命运啊……！你不能来这里。他会找到你的。他会找到你，然后……"
    }
    {
      Id = "Melinoe_1058"
      InheritFrom = "BaseNarrative"
      DisplayName = "……然后我会让他命丧当场。他在哪？"
    }
    {
      Id = "Hades_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "他在我的冥府里！那是你本该在的地方，我也一样。看着我，女儿。就连我都不是他的对手。你认为你与他交手会有什么样的下场？"
    }
    {
      Id = "Melinoe_1059"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认为他会低估我。父亲，先让我为您松绑！"
    }
    {
      Id = "Hades_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不！{#Prev}不，这样做毫无益处，只会带来更大的灾难。现在，你快离开这里。不过，让我把残余的力量赐予你吧。"
    }
    {
      Id = "MelinoeField_1689"
      InheritFrom = "BaseNarrative"
      DisplayName = "……然后我会让他命丧当场。他就在这附近，不是吗？"
    }
    {
      Id = "MelinoeField_1688"
      InheritFrom = "BaseNarrative"
      DisplayName = "……然后我会让他命丧当场。而且这已经不是第一次了。"
    }
    {
      Id = "Hades_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不是第一次了{#Prev}，此话当真？那你更应该明白这样做毫无意义！看看我，女儿。我现在面对他毫无还手之力。哪怕我曾经与他交过手，曾经{#Emph}置他于死地{#Prev}！"
    }
    {
      Id = "MelinoeField_1690"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很抱歉，父亲。但我决意前进，即使是您也拦不住我。现在，请先让我为您松绑！"
    }
    {
      Id = "Hades_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么又回来了？我告诉过你，你{#Emph}不能{#Prev}来这里！"
    }
    {
      Id = "Melinoe_1061"
      InheritFrom = "BaseNarrative"
      DisplayName = "而我也告诉过{#Emph}你{#Prev}，我会回来找你的。不过克洛诺斯才是我的目标。你之前战胜过他。你能告诉我他有什么弱点吗？任何弱点？"
    }
    {
      Id = "Hades_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我{#Prev}在{#Emph}其他五位神明{#Prev}的帮助下才战胜他！你孤身一人，有什么胜算？他没有弱点，除了他的傲慢。而现在看来，你也一样有这个弱点。"
    }
    {
      Id = "Melinoe_1062"
      InheritFrom = "BaseNarrative"
      DisplayName = "那看来我们旗鼓相当。父亲，你被这样折磨多久了？我真的没有什么能为你做的吗？"
    }
    {
      Id = "Hades_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得我被困在这样的地方，还会有时间的观念吗？而且我已经说过：你能做的就是{#Emph}知难而退{#Prev}，不要赌上一切。快走吧，匿踪遁形。"
    }
    {
      Id = "Hades_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道你是如何活过泰坦的攻击的，如果你真的与他对峙过的话。快告诉我，你有没有受伤……你还好么？"
    }
    {
      Id = "Melinoe_1063"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还……好么？我这一生都在为这一刻做准备，要将篡夺冥府之人绳之以法。所以，在泰坦被消灭之前，我必须一次次回来找你。"
    }
    {
      Id = "Hades_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "……对不起……对不起。必须这样的话，那就回来找我吧。我何尝不想亲自出马报仇雪恨。但现在我只能这样帮助你了。"
    }
    {
      Id = "MelinoeField_1495"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到你这副样子让我很心痛，父亲。但是，我也因此心境更加澄澈、更加坚强。幸好这个房间没有被那些萨提尔占据……"
    }
    {
      Id = "Hades_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，他们没有蠢到那种程度，知道该躲着我……或者也许是躲刻耳柏洛斯。啊，如果看到我这幅落魄的模样能让你怒火中烧的话，那也算是件好事。"
    }
    {
      Id = "MelinoeField_1496"
      InheritFrom = "BaseNarrative"
      DisplayName = "倒不是怒火中烧；我没有那种苦大仇深的感觉。也许在塔耳塔罗斯的其他地方有，但是一到这里，那种感觉就会荡然无存。我只希望我出现在这里不会给你带来更大的痛苦。"
    }
    {
      Id = "Hades_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会的。我唯一的痛苦……便是我和你的母亲，你的哥哥，还有这只狗，我们没有……我们没办法看着你长大。现在每次见到你……那种缺失感都会稍稍得到填补。"
    }
    {
      Id = "Hades_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若你愿意满足我无端的好奇……我的冥府现状如何？你的哥哥，他以前差不多算是那里的装修主管。只怕泰坦和他的品味大相径庭。"
    }
    {
      Id = "MelinoeField_1573"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，除非扎格列欧斯对镶金装饰和泰坦那副不可一世的面容情有独钟，否则的话，那里估计是被改头换面了……"
    }
    {
      Id = "Hades_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃……你真是继承了你母亲那过犹不及的直率。就不能告诉我一切都{#Emph}安然无恙{#Prev}么！有些时候，我们只能在谎言中寻求慰藉。"
    }
    {
      Id = "Hades_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "我自己都不敢相信我会问出这样的问题，但我还是想问：奥林匹斯近况如何？即使被困在这个房间之中，我也不难看出泰坦的军团正在发动战争。"
    }
    {
      Id = "MelinoeField_1692"
      InheritFrom = "BaseNarrative"
      DisplayName = "地表世界现在亡者横行，而奥林匹斯山正被克洛诺斯的军队围攻。我们的家人正在抵御他们的攻势。我在努力帮助奥林匹斯众神打破僵局，但总的来说，上面的情况实在有些惨不忍睹。"
    }
    {
      Id = "Hades_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}惨不忍睹……{#Prev}你的意思是，你亲眼目睹了这一切？{#Emph}这怎么可能？"
    }
    {
      Id = "MelinoeField_1693"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是指我们被束缚在冥界的宿命。如果我说，我掌握了一种手段，能让我在一段时间内忍受地表的空气，你会相信么？至少，在这段时间里我足以给他们带去些改变……或者，至少足以让我为之努力。"
    }
    {
      Id = "Hades_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "不可能……但最近似乎不可能的事情总是一桩又一桩地发生。所以，你必须击败泰坦，同时还要为奥林匹斯山解围。让你背负这么重的担子，真是荒谬至极……"
    }
    {
      Id = "Hades_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "难以想象，你居然亲眼见到了奥林匹斯山……你的哥哥从来没有这样的机会。而至于我……我一生都待在这里，对山顶的景象已经毫无记忆。"
    }
    {
      Id = "MelinoeField_2833"
      InheritFrom = "BaseNarrative"
      DisplayName = "那里曾经一定非常壮观。但现在那里满是泰坦的军团……以及没有心智的自动机，在它们眼里我和敌人没什么两样，都该被置于死地。"
    }
    {
      Id = "Hades_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就告诉过他们，不能依赖这种机械！真正的军队应当出于荣誉而战，如果不是出于恐惧的话。它们的自动机{#Emph}什么感情都没有{#Prev}！它们能怎么战斗？"
    }
    {
      Id = "Hades_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里黑暗翻涌，我已经很久没有过这种感觉了。这一定不是那个泰坦的所作所为。倘若不是你造成的，那便一定是出自那岔路女巫之手。"
    }
    {
      Id = "MelinoeField_2009"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲，{#Emph}我将效力于暗影之下，复归于暗影之中。{#Prev}我已经立下了匿踪者之誓；我将为冥界效忠，执行黑夜之意志。"
    }
    {
      Id = "Hades_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对匿踪者的了解恐怕比你预想得少。如此最好，否则只怕那个泰坦知道得也会比现在多得多。那么，但愿你能明智地执行黑夜的意志……"
    }
    {
      Id = "Hades_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "你手中的那颗颅骨，莫非是……它怎么在你的手里？它曾被交由你母亲保管……为了护她周全，某种意义上，也是护你周全。"
    }
    {
      Id = "MelinoeField_2836"
      InheritFrom = "BaseNarrative"
      DisplayName = "银白之颅勒瓦尔中，属于母亲的那个形态认为我有资格持有它……不过，最初为我收集暗夜武器，助我开展任务的，是我的老师赫卡忒。"
    }
    {
      Id = "Hades_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神所铸造的武器！她们的编排总让我们看起来愚蠢无比。那颗颅骨对冥后的保护，实在与我的期望相去甚远；但现在想来，或许只是因为它的使命尚未完成。"
    }
    {
      Id = "Hades_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次你来过之后，这里突然一片嘈杂。我也说不清具体是什么时候。那些泰坦的爪牙全都乱作了一团，嚷叫个不停。发生了什么？"
    }
    {
      Id = "MelinoeField_1493"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们也许是在担心它们的主子，或者忙着复活他吧。因为我终于将他杀死了。而且那不会是最后一次。"
    }
    {
      Id = "Hades_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "鲜血与黑暗啊，哈……唔呃！这样说来，你实现了曾经需要半座奥林匹斯山才能完成的壮举……全凭你一个人。"
    }
    {
      Id = "MelinoeField_1494"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是一个人。哪怕奥林匹斯众神无法亲临现场，我也得到了他们的力量；正如你也赐予了我力量一样。父亲，我们一定能阻止他。至于现在……至少我们可以杀死他。"
    }
    {
      Id = "Hades_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "他会卷土重来，寻求复仇的。他谋权篡位的这出戏码，全都是因他睚眦必报的心性而起。既然如此，那就去再次杀死他吧。至少……这样一遍遍地死去活来，应该能让他无暇他顾。"
    }
    {
      Id = "MelinoeField_1691"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们也许是在担心它们的主子，或者忙着复活他吧。因为我又一次杀死了他。而且不会是最后一次。"
    }
    {
      Id = "Hades_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "鲜血与黑暗啊，哈……唔呃！想不到你竟能……曾经需要半座奥林匹斯山才能完成的壮举……全凭你一个人…………"
    }
    {
      Id = "MelinoeField_1568"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯夺走我们的家人和冥府，而你委托三岔路口的女巫将我带走的那天……我不知怎么有那天的记忆，或者说是我梦到了当时的情境。克洛诺斯他……是不是要求你告诉他命运三女神的藏身处？"
    }
    {
      Id = "Hades_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么会知道……？或许是命运三女神亲自准许你获得了那样的启示。我的父亲是在寻找他们，但我没有向他透露任何事。就算我想，也无从透露，因为没有人知道那三位女神栖身何处，除了{#Emph}她们{#Prev}自己。"
    }
    {
      Id = "MelinoeField_1569"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你从来没有告诉过克洛诺斯命运三女神的藏身处？那他是怎么找到她们的？她们已经沦为了他的俘虏。也许这是新近发生的事，但我很确定。"
    }
    {
      Id = "Hades_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？！不……但如果你所言非虚，那只怕我父亲的征服大业，远比我想象得要更加接近成功。如果就连她们都无法阻止他……女儿，{#Emph}你{#Prev}又有什么胜算……？"
    }
    {
      Id = "MelinoeField_4150"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你从来没有告诉过克洛诺斯命运三女神的藏身处？那他是怎么找到她们的？她们已经沦为了他的俘虏……我是指，在这一切发生之前。这点我很确定。"
    }
    {
      Id = "Hades_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}什么？{#Prev}为什么我现在才知道这种事？那我们一定要迫使他说出真相，然后立刻找到她们！"
    }
    {
      Id = "Hades_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "女儿，告诉我。那个泰坦呆在塔耳塔罗斯做缩头乌龟，可他的军队为何那么有序，足以向奥林匹斯山发起进攻？"
    }
    {
      Id = "MelinoeField_2832"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在那里有另一个泰坦要对付——普罗米修斯，他在率领那里的军队发起进攻。我不知道他是怎么获得自由的，也不知道他到底想要什么……除了向众神复仇。"
    }
    {
      Id = "Hades_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "向众神复仇，难道这点作为动机还不够强烈么？我当时不想与他的惩罚扯上任何关系，但你的宙斯叔叔，他……唉，他总想向我证明，他惩罚人的方式比我更有创造力……"
    }
    {
      Id = "MelinoeField_3101"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲，恐怕奥林匹斯山上的事态比我们想象得还要严峻……因为克洛诺斯唤醒了提丰……那个提丰超级、{#Emph}超级大{#Prev}……而且一心想要将宙斯圣殿夷为平地。"
    }
    {
      Id = "Hades_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "呸！那泰坦行事如此鲁莽，真是好不出人意料。只怕你的宙斯叔叔，不像上次与这魔物交手时那样生龙活虎了。"
    }
    {
      Id = "MelinoeField_3102"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来不怎么惊讶。你们之前是怎么打败提丰的？我从来没有跟像他这样的东西交过手。"
    }
    {
      Id = "Hades_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "你压根不该跟这样的东西交手，女儿！让宙斯自己收拾自己的烂摊子吧。上一次，光靠他的闪电就够了……虽然我总觉得，身为风暴的实体，提丰应该免疫这种手段才对。"
    }
    {
      Id = "MelinoeField_3103"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不打算抛弃我们的家人，让他们独自面对这样的威胁。"
    }
    {
      Id = "Hades_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你来错地方了。倘若你认为对泰坦加以阻挠便能阻止提丰，那就错了。那样的魔物绝无可能受人控制。去亲眼看看吧。"
    }
    {
      Id = "MelinoeField_3930"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来不怎么惊讶。你们之前是怎么打败提丰的？迄今为止，我对付它的手段都没法造成什么持久的伤害。"
    }
    {
      Id = "Hades_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你的{#Prev}手段？让宙斯自己收拾他的烂摊子去。上一次，光靠他的闪电就够了……虽然我总觉得，身为风暴的实体，提丰应该免疫这种手段才对。"
    }
    {
      Id = "Hades_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于提丰，最近有什么新消息么，女儿？以前，宙斯总把他单枪匹马消灭那个魔物的事迹挂在嘴边。现在，只怕他也沦落到了四处求援的境地。"
    }
    {
      Id = "MelinoeField_3104"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲，如果你还对宙斯叔叔心怀怨怼的话，获利的只会是我们的敌人。提丰仍在奥林匹斯山的山巅肆虐……他可以被击退，但每次过不了多久就会卷土重来。"
    }
    {
      Id = "Hades_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们曾将他深埋在一座山下。其他办法都不奏效；所以我们只能动用非凡的神力，才完成这一壮举。嗯……想必我的弟弟总有某种{#Emph}计划{#Prev}吧。他从来不缺计划。"
    }
    {
      Id = "Hades_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "……很久以前，在我们第一次被迫与提丰交手时，谁敢想象罪魁祸首竟是已经长眠地底的泰坦王。当时我们以为，哪怕是傲慢如{#Emph}他{#Prev}，也不会妄想能让这样的魔物屈服于他的意志！"
    }
    {
      Id = "MelinoeField_3105"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯所料想到的，大概只是那个魔物会立刻攻击奥林匹斯山罢了。他怎么能唤起这样的怪物，整座奥林匹斯山却毫无察觉？"
    }
    {
      Id = "Hades_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "倪克斯本尊落入泰坦王的魔爪后，所有发生在大地深处的事情都无人知晓。而现在……尽管提丰和泰坦都曾倒在我们手上……我们却从没有同时对付过他们两个。"
    }
    {
      Id = "Hades_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "有段时间没有见到你了……也许你在忙着对付提丰，防止他攻入我弟弟的那座“坚不可摧”的山顶宫殿吧。"
    }
    {
      Id = "MelinoeField_3106"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，我近期的行动大概来说就是这样。提丰也许看起来无法被战胜，但只要是活物就不喜欢被人反复击打面部。"
    }
    {
      Id = "Hades_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一古老的战术，你的父辈在年轻时屡试不爽。我早有预感会是这样；说到底，没有什么东西会被时间改变。"
    }
    {
      Id = "Hades_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "除了普罗米修斯之外，还有谁成了克洛诺斯的爪牙？我想要知道所有胆敢与我们为敌的泰坦，以及与他们狼狈为奸的人。"
    }
    {
      Id = "MelinoeField_2835"
      InheritFrom = "BaseNarrative"
      DisplayName = "除了那一大群烧杀劫掠的萨提尔，我能想到的有那个独眼巨人，波吕斐摩斯……还有倪克斯之女厄里斯……不过她也有可能只是在凭自己的心意行事。"
    }
    {
      Id = "Hades_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "纷争化身从来不甘受制于人，倪克斯早就清楚一点。至于那个独眼巨人……他和你的波塞冬叔叔曾经有些不愉快，也许是那件事令他耿耿于怀。嗯……这样看来，至少敌人的名单还不算特别长。"
    }
    {
      Id = "Hades_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "女儿，告诉我……那个岔路女巫的下落，如果你知道的话。当一切看似都无可挽回时……我和你母亲，我们把你托付给了她来照顾。"
    }
    {
      Id = "MelinoeField_1497"
      InheritFrom = "BaseNarrative"
      DisplayName = "那之后她就一直在照顾我、训练我。不过，我们最好不要在这里谈及她。匿踪者仍然匿踪遁形……这样说应当就足够了。"
    }
    {
      Id = "Hades_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好。她一直……啊，你说得对，还是不要多言为好。不过，倘若你有机会的话，务必向她转达我最诚挚的感激。"
    }
    {
      Id = "Hades_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "倪克斯本尊……就连她面对那个泰坦也无力还手。黑夜化身的两个儿子也和她一起，在我的冥府中效力……只怕他们如今也落到了克洛诺斯手上。"
    }
    {
      Id = "MelinoeField_2008"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，修普诺斯在我们这里！在那之后他一直睡得很沉，也许是某种……心理防御机制吧，因为我们迄今还没有找到唤醒他的方法。勇敢无畏的瑟勒米乌斯也和我们在一起！"
    }
    {
      Id = "Hades_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯{#Emph}又{#Prev}睡着了？你口中的另一个名字我毫无印象……但在时间的摧残下，我的记忆已经大不如前。不过，只要岔路女巫仍然在引领匿踪者……那么黑夜的意志便还没有彻底倒下。"
    }
    {
      Id = "Hades_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的两个兄弟都有对你伸出援手，对么？宙斯毫无疑问又躲在他那固若金汤的宫殿中发号施令，而波塞冬一定是又在夸夸其谈，仿佛胜利近在咫尺……"
    }
    {
      Id = "MelinoeField_2007"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲，他们之所以战斗，是为了保卫他们的家园……也是为了能救出你啊！你说得对，他们都没有怎么流露出担忧的神色，但是不那样做是有原因的！恐惧是会蔓延的。"
    }
    {
      Id = "Hades_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们在地表世界之上安逸了太久，只知享受、不问世事……！但是，你还是不要听我对他们的抱怨了吧。倘若你有机会认识你的亲生哥哥，或许就能更加理解兄弟姐妹之间这种互相贬损的冲动……"
    }
    {
      Id = "Hades_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个该死的泰坦对刻耳柏洛斯做了什么，才会致使他一次次魂不守舍地冲进这里，过不了多久又被赶出去？每次都要一整队的萨提尔才能撵得动他……"
    }
    {
      Id = "MelinoeField_1498"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯把他赶去了上面的哀悼原野。然后，愤怒和绝望会蒙蔽他的心灵，让他失去理智。我每次都要经过他所停留的地方。"
    }
    {
      Id = "Hades_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你每次都得面对那样狼狈不堪的他。谢谢你，女儿。谢谢你对这只喜怒无常的野兽手下留情。他习惯了更安逸的日子，但也吃过比这更大的苦。你那时候太小，没有与他培养感情的机会，但也许……也许现在为时还不晚。"
    }
    {
      Id = "Hades_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "刻耳柏洛斯最近非常焦躁；我逐渐意识到，这并不只是因为他常常被迫在哀悼原野上游荡。他很可能是察觉到了提丰的回归。"
    }
    {
      Id = "MelinoeField_3316"
      InheritFrom = "BaseNarrative"
      DisplayName = "和我交过手的每一个怪物，恐怕都能以某种方式追溯到提丰。我怀疑他和他的后代不会有多么亲近的关系，就连刻耳柏洛斯也不例外。"
    }
    {
      Id = "Hades_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也这样认为。看起来我们都无法逃脱父辈的影响；虽说我们每个人如今的处境，都与父辈相去甚远。"
    }
    {
      Id = "Hades_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最好不要离刻耳柏洛斯太近，或者说，不要让那只狗离得太近。不过……三岔路口的女巫曾经也养过一只猎犬，和你带来的这只颇有几分神似……"
    }
    {
      Id = "MelinoeField_3319"
      InheritFrom = "BaseNarrative"
      DisplayName = "那她一定就是你所说的那一只。她名叫赫库芭，我相信她会很尊重你和刻耳柏洛斯的。况且，他俩在哀悼原野已经见过面了……"
    }
    {
      Id = "Hades_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来是个既忠诚又勇敢的伙伴。这两种品质向来难以共存，对野兽和其他生物来说都是如此。刻耳柏洛斯，在她面前要好好表现。"
    }
    {
      Id = "MelinoeField_1577"
      InheritFrom = "BaseNarrative"
      DisplayName = "刻耳柏洛斯去哪了，父亲？他一般都守在这里的。我之前明明在哀悼原野见到他了啊！"
    }
    {
      Id = "Hades_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "我派他去搞出些动静来。让泰坦的军队无暇他顾。他们最终会把他赶回去，但是凭他们的本事没法对他造成伤害。"
    }
    {
      Id = "MelinoeField_1578"
      InheritFrom = "BaseNarrative"
      DisplayName = "那看来就只有你和这块巨石了。看起来它得有好一阵子没有被推上山坡了。克洛诺斯没有逼你这么做吗？"
    }
    {
      Id = "Hades_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "那种事对我来说，要比对寻常的暗灵来说容易许多。此外，这些锁链无法被解开，除非泰坦亲自下令。但我宁可在这里呆到天荒地老，也绝不会对他俯首称臣。"
    }
    {
      Id = "MelinoeField_1579"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说这块巨石曾经是一个凡人国王的伙伴？我……我感受到了某种东西。一块普普通通的巨石，里面却蕴藏着如此深厚的能量……"
    }
    {
      Id = "Hades_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你这么说，那我就当真了。那块巨石和我……我们不像它和它的上一任主人那么亲密。不过你或许可以从中汲取些魔力，毕竟你得了岔路女巫的真传。"
    }
    {
      Id = "MelinoeField_1578_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "那看来就只有你和这块巨石了。看起来它得有好一阵子没有被推上山坡了。你说这块巨石曾经是一个凡人国王的伙伴？我……我感受到了某种东西。一块普普通通的巨石，里面却蕴藏着如此深厚的能量……"
    }
    {
      Id = "Hades_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "那块巨石有向你揭示什么事物吗？我不知道我为何这样问，大概仅仅是出于毫无根据的迷信……但我见过你时不时会走到它面前。"
    }
    {
      Id = "MelinoeField_4153"
      InheritFrom = "BaseNarrative"
      DisplayName = "提起曾经关押在这里的囚犯时，你的言语很温和，就好像你已经宽恕了他。我以前以为，在塔耳塔罗斯，这种事情绝无可能。现在，这块巨石会提示我，事实并不是我想的那样。"
    }
    {
      Id = "Hades_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们曾经关押在这里的卑劣之徒，大多都全无得到宽恕或是获得自由的希望。但就连他们也逃了出去，纵使我认为他们不配。那就让这块巨石立在这里，作为过去一切，以及未来一切的见证吧。"
    }
    {
      Id = "Hades_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "……是鲜血的气味。你负了伤。但你还是执意要去面对泰坦么？唉，至少你命丧于此的话，也算是落叶归根。"
    }
    {
      Id = "MelinoeField_1571"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论发生什么事，我都不会命丧于此的。至于我的伤势，也许卡戎大人碰巧有生命精华的存货。"
    }
    {
      Id = "Hades_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕到了现在，摆渡人仍然在操持旧业么？荒唐。冥府的大小事宜全都停摆了！不过……我该记得，他所效忠的乃是冥界，而不是我。"
    }
    {
      Id = "Hades_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "女儿。跟我说些关于你的事情吧，我对你实在是一无所知。比如……比如你平常都喜欢做什么？除了做你……现在在做的这件事。"
    }
    {
      Id = "MelinoeField_1994"
      InheritFrom = "BaseNarrative"
      DisplayName = "喜欢做什么？唔……我喜欢把我的炼金材料收拾得整整齐齐，这样练习巫术的时候，我需要什么都能立刻找到。我还喜欢……呃，父亲，这样感觉好不真实……"
    }
    {
      Id = "Hades_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔。确实对于闲聊来说，时间和地点都不合适……不过，也许，有朝一日……我们会有更多机会谈论这些。但现在，还有大仇未报。"
    }
    {
      Id = "Hades_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有死里逃生的本事，算是家族遗传了。你的哥哥扎格列欧斯还在的时候，他那小身板也抗揍得很。那小子真是执拗。"
    }
    {
      Id = "MelinoeField_1572"
      InheritFrom = "BaseNarrative"
      DisplayName = "别说得跟他死了似的！虽然他被克洛诺斯挟持了，母亲和其他人也一样，但是等这一切结束……我们一定会再次相见的。"
    }
    {
      Id = "Hades_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么能如此笃定？这一切都仍是未知数！那个泰坦……我的父亲……他是不会善罢甘休的。他是我们当中最执拗的那个。"
    }
    {
      Id = "Hades_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "你降生的时候，你的母亲自豪得很。我们……我们很长一段时间一直以为，我们不会再要另一个孩子了。但我们最终决定再试一次。"
    }
    {
      Id = "MelinoeField_1574"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你们也做到了身为父母最重要的职责。你们{#Emph}保护{#Prev}了我。至于母亲，我见过她那美丽的笑容。在我拥有的那幅画像里，她看着我，笑得好开心。"
    }
    {
      Id = "Hades_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "那幅画像还在？！那个女巫，她一定是把它带走了……冒了那么大的风险，就为了那样的东西。你要知道，你母亲的笑容无比灿烂……任何画像在她本人面前都会黯然失色。无论画师的技艺多么精湛。"
    }
    {
      Id = "MelinoeField_1995"
      InheritFrom = "BaseNarrative"
      DisplayName = "你见到了当时发生的事情……克洛诺斯对我母亲、我哥哥，以及其他人的所作所为。他们现在都去哪了？他把他们关在了哪里？"
    }
    {
      Id = "Hades_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也不知道最新的消息。他……他用了某种办法，让所有人都停住了。我见到他们时，他们像雕像一样纹丝不动；确切地说，不是被石化，而像是被困住了，就在我的冥府大厅里。他一定是把他们转移到了冥府更深的地方……"
    }
    {
      Id = "MelinoeField_1996"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算在我战胜克洛诺斯的那些夜晚，冥府的大部分区域也都被封住了，更何况我没办法待太久。我们到底要怎么做，才能救出他们？"
    }
    {
      Id = "Hades_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许你非常有礼貌地问一问那个泰坦，他就会发发慈悲，把人放了？女儿啊，我不知道如何解除他的魔法，也没法提供什么有用的建议。但我至少可以为你提供{#Emph}这个{#Prev}。"
    }
    {
      Id = "Hades_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "从前，我总能察觉到每个亲戚的祝福；他们的神恩，在冥界是不允许出现的。现在，我的感知力一定是变得迟钝了，因为直到刚才，我才察觉到了阿瑞斯的影响……"
    }
    {
      Id = "MelinoeField_3317"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对地表祝福的感知力并没有变得迟钝，父亲。我和其他神明都见过之后，才见到了阿瑞斯。似乎是现在的形势太严峻了，以至于他都想要帮助我们结束这场战争。"
    }
    {
      Id = "Hades_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是这样和你说的么……？以我对我侄子的了解，他会甘愿让一场战争结束，一定是因为在那之后可以发动规模更大的战争。不过，如果他自称站在你这一边，那就不必怀疑他会对你撒谎。"
    }
    {
      Id = "MelinoeField_3317_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对地表祝福的感知力并没有变得迟钝，父亲。我和其他神明都见过之后，才见到了阿瑞斯。"
    }
    {
      Id = "Hades_0203_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "以我对我侄子的了解，他会甘愿让一场战争结束，一定是因为在那之后可以发动规模更大的战争。不过，如果他自称站在你这一边，那就不必怀疑他会对你撒谎。"
    }
    {
      Id = "Hades_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个房间里……曾经关押着我的一个囚犯。凡间的一位国王，妄图想要瞒过死神！我命令他把那块巨石沿着那条路推上去，永生永世不得停歇。但就算这样，他仍然原谅了我。"
    }
    {
      Id = "MelinoeField_1575"
      InheritFrom = "BaseNarrative"
      DisplayName = "忘了他吧，父亲。现在还对某些已死的凡人耿耿于怀，又有什么用处呢？克洛诺斯想让你被罪恶感吞噬。不要让他如愿以偿。"
    }
    {
      Id = "Hades_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "你误会了。那名囚犯，他的名字叫西西弗斯。那边那块巨石，和他就像朋友一样。他临走的时候……拜托他的朋友留下来陪我。他说，在更多人来陪我之前，就先和它做个伴吧。"
    }
    {
      Id = "MelinoeField_1576"
      InheritFrom = "BaseNarrative"
      DisplayName = "原来如此……那我很感谢那块巨石和那位国王的好意。克洛诺斯一定没有料到，你以前的囚犯居然会对你爱戴有加。"
    }
    {
      Id = "Hades_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，恨我的人更多。有一些当即就加入了泰坦的军团，留在了塔耳塔罗斯里。当然，他们不敢待在任何我目光能及之处。"
    }
    {
      Id = "MelinoeField_1575_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "忘了他吧，父亲。现在还对某些已死的凡人耿耿于怀，又有什么用处呢？"
    }
    {
      Id = "Hades_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "你母亲让我转达她最温暖的问候；她很遗憾，这次没能与我一起来。在我暂时离开的时候，冥府有些事务需要{#Emph}她来{#Prev}处理。"
    }
    {
      Id = "MelinoeField_4164"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你，也请替我问候母亲。所以，你有机会来{#Emph}这里{#Prev}，而她却在{#Emph}那里{#Prev}处理事务……你们是抽签决定谁来做什么的吗？"
    }
    {
      Id = "Hades_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是抽签将我分配到了此界；此后我便再也没有那样做过。此外，这件事没那么复杂：来到这里，我便能为你的成功提供最大的助益。"
    }
    {
      Id = "Persephone_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，墨利诺厄，你回来了！我们想着或许能在这里见到你……好吧，是哈迪斯这么想的。换做是我，恐怕怎么也猜不到。"
    }
    {
      Id = "Hades_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从你离开之后，你母亲和我就一直期待再次见到你。你过得好么？三岔路口的一切，都在掌控中么？"
    }
    {
      Id = "MelinoeField_4148"
      InheritFrom = "BaseNarrative"
      DisplayName = "一切都很好，父亲。很高兴能在这个房间里见到气色这么好的你，不过……为什么还要回来这里？我还以为你会觉得，随便哪个地方都比这里强呢。"
    }
    {
      Id = "Hades_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府已经回复了部分秩序，但塔耳塔罗斯的其余部分，仍然渗透着我父亲那奢靡的品味。只怕等到他对我们家族的伤害尽数恢复，这些毫无格调的装饰也拆不干净！"
    }
    {
      Id = "MelinoeField_4149"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷会尽他的一份力的。这也意味着我能过来打个招呼。"
    }
    {
      Id = "Hades_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，那在你重走路线这件事上，我也该尽自己的绵薄之力。如果说我现在还能帮得上忙的话。"
    }
    {
      Id = "MelinoeField_5008"
      InheritFrom = "BaseSubtitle"
      DisplayName = "冥府的煤灰……"
    }
    {
      Id = "MelinoeField_4169"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们两个最近过得怎么样？要让冥府和冥界重回正轨，背后的压力一定很大吧。"
    }
    {
      Id = "Hades_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，和我曾经身陷囹圄，时刻为我的家人和爱犬担心，还要亲眼看着冥界变得面目全非相比，这样的压力不算什么。"
    }
    {
      Id = "Persephone_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的情况就很不一样了。上一秒我还是个刚刚生下宝宝的母亲，现在却已经时过境迁……不过，那时的你真的是个非常可爱的小宝宝，墨利诺厄。"
    }
    {
      Id = "MelinoeField_4170"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许，你们随时可以考虑再生一个？何况，我们现在家庭成员的数量，和奥林匹斯相比还差得远呢。"
    }
    {
      Id = "Hades_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！别用这种言论来诱惑命运了，无论她们现在身在何处。有你和你哥，就够我受的了。"
    }
    {
      Id = "MelinoeField_4154"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府的翻修工作进展如何了？甚至在我还没走的时候，进度看起来都相当可观了呢。"
    }
    {
      Id = "Hades_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "事物的外表往往会欺骗，女儿，想必你早已懂得这个道理。初步工作开展起来还算快。但要将细节处理妥当，就需要远胜于此的时间。"
    }
    {
      Id = "Persephone_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "尤其是有人坚持，所有的细节都得跟原来一模一样。"
    }
    {
      Id = "Hades_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "为何要忍受不完美？所有我们未曾想要改变的事物，都必须如我们所愿恢复如初。"
    }
    {
      Id = "MelinoeField_4155"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来是个大工程。有什么我能帮上忙的吗？"
    }
    {
      Id = "Persephone_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事还是交给我们好了，墨利诺厄。能在这里见到你，我们很高兴！你爸爸可以为你送上祝福，而且还能出来透透气、换换心情！不是么，哈迪斯？"
    }
    {
      Id = "Hades_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嘟囔）赶紧选个祝福走吧，闺女。"
    }
    {
      Id = "Hades_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪里都能看到黄金，呸！折射出的金属光泽简直要刺瞎我的眼睛。这个翻修工作，怕是永无竣工之日了！就连冥府修缮完成，都还{#Emph}遥遥无期！{#Prev}"
    }
    {
      Id = "Persephone_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "没关系的，哈迪斯。不久之前，事态还比这严峻得多，而且我们也经受过更猛烈的风暴。怎么突然这么着急？"
    }
    {
      Id = "Hades_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算不为我而修，也要{#Emph}为你而修！{#Prev}这片领地理应回到你一直喜欢的样子。但现在别无他法，也只能再忍受一阵我父亲的品味……抱歉，墨利诺厄！呃，选一个吧。"
    }
    {
      Id = "MelinoeField_4156"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到你们两个都在这里，真的让我很高兴。那些萨提尔之类的都不会来打扰你们吗？"
    }
    {
      Id = "Hades_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "毕竟需要违背现实运作的法则之人，可不是我和你的母亲啊，女儿。看来，我父亲必须得接受他的狂热信徒抱头鼠窜一段时间，以免我们之间再产生{#Emph}不必要的误会{#Prev}。"
    }
    {
      Id = "Persephone_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "不过还是让我说得更直接一点吧，墨利诺厄。萨提尔之类的东西一见到我们就落荒而逃了。有的时候一边跑，还一边会发出山羊的叫声呢！"
    }
    {
      Id = "Hades_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你没有那么幸运。你母亲和我来这里，让你为最终的对决做些准备，也是最起码的事情。"
    }
    {
      Id = "Hades_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们听说你在来的路上，闺女。所以你母亲和我都尽快赶来了，确保能及时向你致意。"
    }
    {
      Id = "Persephone_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么把我的计划全说出去了，哈迪斯！我们只是想来跟你打个招呼啦，墨利诺厄。毕竟我们暂时还不能邀请你回冥府。"
    }
    {
      Id = "MelinoeField_4159"
      InheritFrom = "BaseNarrative"
      DisplayName = "爸爸妈妈，你们好呀。家里最近都还好么？扎格列欧斯，还有其他的冥府员工？"
    }
    {
      Id = "Hades_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们都已经回到了岗位上；既然跟你打过招呼，我们也该回去了。去铲除我父亲弥留于此的威胁吧；而我们就负责铲除他一塌糊涂的装修风格。"
    }
    {
      Id = "Persephone_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟你爸说，如果我们要在这个房间时不时与你相见的话，不如就优先把这里修缮一番好了。结果你猜你爸怎么说？"
    }
    {
      Id = "Hades_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只不过是说，我们应该最后再对这个房间进行修缮……因为我不愿意失去对这里的回忆。不过，按照现在的进度，也许它在几个{#Emph}时代{#Prev}之内都会维持现状。"
    }
    {
      Id = "Persephone_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的女儿，加入了匿踪者……按官方角度来说，哈迪斯和我都不该{#Emph}知道{#Prev}你的存在……以及你的住处……一概不知。"
    }
    {
      Id = "Hades_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "捍卫冥界的安宁，是我们每个人的义务……但我记得，倪克斯凭借她的高瞻远瞩，确实安排了一些额外的预防措施，没错。"
    }
    {
      Id = "MelinoeField_4457"
      InheritFrom = "BaseNarrative"
      DisplayName = "到现在，我都不确定匿踪者的秘密到底有多少人知道了。这整件事情中，有那么一两次，我们必须得从暗影之中显现，采取行动。"
    }
    {
      Id = "Persephone_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "倪克斯肯定会第一个表示，在其他人心中激发出某种特定的恐惧，对冥界来说是件好事。不过我感觉自己很幸运，因为在那些捕风捉影的复仇故事之外，我们还能认识真正的你，墨利诺厄。"
    }
    {
      Id = "Hades_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯……我的父亲……你提出的需求，他有没有一一应允？没有突然变卦，或是阳奉阴违的事情吧？"
    }
    {
      Id = "MelinoeField_4165"
      InheritFrom = "BaseNarrative"
      DisplayName = "他一直在做他自己……我指的是，新的那个自己。看起来很想痛改前非，而且甚至对消除这里和天界残存的负面影响，显露出了相当的热情。"
    }
    {
      Id = "Hades_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论如何，我们都不该放下戒备。不过，我的父亲从来无法对他的轻蔑加以掩饰。如果这点已经被你除去……那他确实已经不再是我所知的那个泰坦。"
    }
    {
      Id = "MelinoeField_4171"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷在神佑群屿过得怎么样？很高兴知道宙斯大人和你能在那里找到一个适合他的岗位。"
    }
    {
      Id = "Hades_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我父亲在这一新的领域展现出了相当的才能，至少目前如此，这点令我惊讶。这份工作任务不算太重，但神佑群屿的居民有时会相当挑剔，这点很是棘手。"
    }
    {
      Id = "MelinoeField_4172"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以爷爷是在那里照顾至福乐土最自负的那一批人，确保他们的需求都得到满足，之类的吗？"
    }
    {
      Id = "Hades_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "本质上就是如此。他很注重细节，而且不容易忘事。我们会继续监管他，确保他一直如此。"
    }
    {
      Id = "Hades_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "大多数人对这个房间望而却步，然而最近有一个面容与倪克斯极为相近的人闯了进来。她怒气冲冲地朝我行了个礼，然后就径直走过去了！是倪克斯的哪个女儿吗？"
    }
    {
      Id = "MelinoeField_5028"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来像是涅墨西斯。她对亲手杀死克洛诺斯的渴望，简直比我还要强烈。现在她在追杀那些残迹，就和我一样。我和她之间达成了一些共识。"
    }
    {
      Id = "Hades_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "听得我几乎都要可怜那些残迹了。要么面对她的报应，要么面对你的复仇，如果你们没有一起上的打算。"
    }
    {
      Id = "Hades_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想，修普诺斯的回归，我们应该感谢你。不过，直到他回来，我才意识到他之前不见了。"
    }
    {
      Id = "Persephone_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "但这只不过是因为我们最近不像之前那样，有那么多新来的暗灵。不是么，哈迪斯？"
    }
    {
      Id = "Hades_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都还没有开庭审判！不过无论如何，等待接受审判的暗灵越来越多了，而我们需要修普诺斯让他们保持秩序，告知他们最近的事情。"
    }
    {
      Id = "Persephone_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "不过，要是给不出重新开庭的具体时间，修普诺斯恐怕很难让他们都安心等待吧。"
    }
    {
      Id = "Hades_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我们何必把这些行政管理上的琐事说给闺女听。我原本想说的只是，倪克斯失踪的这个儿子现在找回来了。待办事项又少了一件。"
    }
    {
      Id = "Hades_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和你母亲没听错吧，你和你哥哥兵刃相见了？就在至福乐土的中心，大庭广众之下……？"
    }
    {
      Id = "MelinoeField_4376"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，父亲，不是您想的那样！我觉得用您的话说，应该是场“表演赛”；一场友好的切磋，仅此而已。不过，扎格列欧斯对我可没有手下留情。"
    }
    {
      Id = "Hades_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来，是那小子做了个明智的决定，又或者更像是你做出的。冥界近来如此动荡，或许你口中的这种“表演赛”，正是暗灵们所需要的。"
    }
    {
      Id = "Persephone_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "提振士气么！至福乐土的暗灵，好像是会喜欢这种暴力的娱乐。好吧，只要墨利诺厄和扎格列欧斯都愿意……"
    }
    {
      Id = "Hades_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "你师承三岔路口的女巫，而他则师承凡间战场上最强大的战士。究竟孰强孰弱，或许确实值得争辩一番。"
    }
    {
      Id = "Persephone_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也拥有我的祝福，你是知道的，对么，墨利诺厄？只可惜，在我们清理克洛诺斯的残余时，我没办法打破现有的循环，为你提供更实质的帮助。"
    }
    {
      Id = "Hades_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "我自己的祝福，想必便足够了吧？我们闺女已经打败过这个泰坦许多次了……既然当前的办法已有成效，就不必再加变数。"
    }
    {
      Id = "MelinoeField_4163"
      InheritFrom = "BaseNarrative"
      DisplayName = "仅仅是见上你们两个一面，就足以让我获得坚持到底的意念了。不过我相信，有了母亲的祝福，我还会变得更强。毕竟她有掌管生死的力量……！"
    }
    {
      Id = "Persephone_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，从那个角度来说确实……也许我继承我母亲的地方，比我有时展现出的还多。"
    }
    {
      Id = "Hades_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "女儿……你的母亲让这个独属于死者的界域焕发出了生机，而我们都因此受益匪浅。"
    }
    {
      Id = "Persephone_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们送给你的那颗小小石榴。那是我们用最好的宝石专门订做的，数量非常有限，一直想着等你长大了就送一颗给你……"
    }
    {
      Id = "MelinoeField_4459"
      InheritFrom = "BaseNarrative"
      DisplayName = "想不到吧，这么快就长大了！以及，谢谢你们。它很漂亮，而且总能让我感觉离你们更近了。"
    }
    {
      Id = "Persephone_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说石榴是有这样的功效。有的人吃了几颗石榴籽，就再也不想离开冥界了呢！"
    }
    {
      Id = "Persephone_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "银白之颅勒瓦尔……倪克斯曾经把它送给了我，供我防身，以防万一。我从来没想过，就算它不在我手中，也仍然保护了我。"
    }
    {
      Id = "MelinoeField_4461"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在你想把它拿回去么，母亲？既然你已经回来了，也许我和勒瓦尔的缘分也差不多到这里了。"
    }
    {
      Id = "Persephone_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，无论这是命运的安排还是我自主的决定，我都觉得不必了，谢谢你。既然银白之颅已经助你走了这么远，那你们两个一定配合得很默契。"
    }
    {
      Id = "Persephone_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候，我真希望我们能多在一起待一会儿，你知道么？但然后我就会想起{#Emph}我自己{#Prev}成长过程中的感受。只是……如果有任何需要，别忘了我们就在这里，好么？"
    }
    {
      Id = "MelinoeField_4467"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不会忘记的。跟外婆生活在一起是什么感觉？她看起来很强大，而且敢爱敢恨……我很喜欢她。"
    }
    {
      Id = "Persephone_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "听到你这么说我很高兴。得墨忒尔和我，我们时不时会有些矛盾，但自从我搬来这里后就缓和了一些。我从中得出的结论是，子女都需要自己的空间……无论放手对父母来说有多么艰难。"
    }
    {
      Id = "Hades_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神的回归，我们已有所耳闻。这件事与你有多少关系，我们无意探知，但请告诉我们……至少，她们没有什么大碍，对么？"
    }
    {
      Id = "MelinoeField_4157"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来是的。你这么一说，我感觉克洛托她还挺兴奋的，她说的话比其他两位加起来都多呢！以至于我都有点难以想象她不兴奋的时候会是什么样子……"
    }
    {
      Id = "Hades_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，也许我们算是幸运……因为她们有时会显得阴晴不定。她们的心情或许不是编织出的命运好坏的唯一标准，但想必一定至少有所联系。"
    }
    {
      Id = "Persephone_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们听说她们会暂时停下手中的编织。不过，你肯定不相信，对吗，哈迪斯？"
    }
    {
      Id = "Hades_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "我断然不会相信。不过，我无意干涉你们两个各自得出自己的结论。"
    }
    {
      Id = "Persephone_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄，对于命运三女神所预言的新时代，你有什么看法？你知道的，你身上也有一部分凡人的血脉……也许这样是最好的安排。"
    }
    {
      Id = "MelinoeField_4158"
      InheritFrom = "BaseNarrative"
      DisplayName = "在命运三女神看起来撒手不管这段时间里，我们做得还不错……所以如果以后也是这个样子，我愿意拭目以待。不过，如果众神不会再拥有这么大的话语权，冥界会变成什么样？"
    }
    {
      Id = "Hades_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们会适应的，如同我们一直所做的那般。但除非这个{#Emph}新纪元{#Prev}致使凡人失去了他们最根本的特质，让他们不再{#Emph}终有一死{#Prev}，否则我认为我们在这里所做的事，仍然有着不可或缺的意义。"
    }
    {
      Id = "MelinoeField_4464"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们两个……有没有机会联系一下三岔路口的女巫……联系一下赫卡忒，时不时与她聊一聊？"
    }
    {
      Id = "Persephone_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "考虑到她所处的职位，我们暂时恐怕没办法和她在大庭广众之下一起喝仙酒，不过其实和你也是一样的情况。我们确实会听到她的消息，但我们尊重她的隐私。"
    }
    {
      Id = "MelinoeField_4465"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我明白了，不过……总之，我觉得……如果时不时能收到你们两个的消息的话，对她来说一定意义非凡，如果你们不介意的话？她为你们的回归付出了太多努力……付出最多的人非她莫属。"
    }
    {
      Id = "Persephone_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈哈哈，那好。我觉得我们应该能找到办法，透过帷幕跟她传些话，对吧，哈迪斯？赫卡忒对我们的恩情，我们永远不该忘记。毕竟，她对我们的小女儿有救命之恩。"
    }
    {
      Id = "Hades_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "别在这犯傻了，女儿。你是阻止不了他的。在时间的长河中，一切都是必然。"
    }
    {
      Id = "Hades_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "你来这里看我，冒的风险太大了。"
    }
    {
      Id = "Hades_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的儿子从来不听我的话；我真是愚蠢，居然以为你会和他不一样。"
    }
    {
      Id = "Hades_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的力量已经所剩无几，但我仍会为你提供助力。"
    }
    {
      Id = "Hades_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢你照顾刻耳柏洛斯，但你也要照顾好你自己。"
    }
    {
      Id = "Hades_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和你哥哥一样倔，不是么……"
    }
    {
      Id = "Hades_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "每当你回到这里……我的一部分力量也得以恢复。"
    }
    {
      Id = "Hades_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要冒不必要的风险，女儿。愿你匿踪遁形。"
    }
    {
      Id = "Hades_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "你曾经战胜过那个泰坦；你知道需要做什么。"
    }
    {
      Id = "Hades_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "我现在这副模样，实在难堪大用。不必特意绕路来找我。"
    }
    {
      Id = "Hades_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要对那个泰坦心慈手软。他绝不会顾及你是他的家人。"
    }
    {
      Id = "Hades_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "动身吧，女儿。我这里不需要你的帮助。"
    }
    {
      Id = "Hades_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "三岔路口的女巫向我发过誓，一定会保你无虞；确保她信守她的诺言。"
    }
    {
      Id = "Hades_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这样的时代，还能跟你和刻耳柏洛斯共享片刻的安宁，感觉就像做梦一样。"
    }
    {
      Id = "Hades_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从这只狗跑了回来，我们就在等候你的到来。"
    }
    {
      Id = "Hades_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "去吧，去报仇雪恨。我们家族的仇恨，支撑你的怒火绰绰有余。"
    }
    {
      Id = "Hades_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "他不仅仅是泰坦。他是时间本尊，而时间永远不会停止……"
    }
    {
      Id = "Hades_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些锁链让我意志消沉，但不至于将我击垮。"
    }
    {
      Id = "Hades_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是没想到，我女儿的一个个青春夜晚，居然要如此度过……"
    }
    {
      Id = "Hades_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些祝福不过是举手之劳，但如果它们能派上用场，那便如此为好。"
    }
    {
      Id = "Hades_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯让我替他向你问好。冥界最近事务繁忙，让他脱不开身。"
    }
    {
      Id = "Hades_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲对塔耳塔罗斯的所作所为真是奇耻大辱，日后必须彻底将其恢复原貌……"
    }
    {
      Id = "Hades_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我们还能做些什么，为你的行动提供助益，尽管开口。"
    }
    {
      Id = "Hades_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "相信三岔路口的女巫与其他人近来过得都好？"
    }
    {
      Id = "Hades_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲或许已经洗心革面，但倘若见到他过往的残迹，那便格杀勿论。"
    }
    {
      Id = "Hades_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "让我们确保我们所经受的一切，永远不会再度上演。"
    }
    {
      Id = "Hades_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于我父亲旧日的残迹，我永远有愤怒可以与你分享。"
    }
    {
      Id = "Hades_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府的事务尽在掌控之中。相信你那边的事情也是一样。"
    }
    {
      Id = "Hades_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的工作让你往返地表日益频繁；能在这里见到你，为父很高兴。"
    }
    {
      Id = "Persephone_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "你小时候一定是个可爱的小女孩儿，但现在也不算太差。"
    }
    {
      Id = "Persephone_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "总有某天或者某夜，我们得把这个房间清理干净，哈迪斯……"
    }
    {
      Id = "Persephone_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "去让那个克洛诺斯的可能性看清楚，这个家族到底谁说了算。"
    }
    {
      Id = "MelinoeField_1499"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲，我知道这个理论上算是违禁品，但也许把这瓶蜜露送给你，会让你稍稍感到一丝慰藉？"
    }
    {
      Id = "Hades_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "可恶，跟你哥哥一个德性……恐怕我现在无福消受，精神和身体都不允许。不必考虑给我带来什么慰藉；专注于给敌人带去你的怒火吧。"
    }
    {
      Id = "MelinoeField_4206"
      InheritFrom = "BaseNarrative"
      DisplayName = "母亲、父亲，你们重新回到了我的生命中，让我无比感激。我们还有好多话要讲，不过也有着无限的时间。所以目前来说，就请先收下这瓶蜜露，作为重回冥府的乔迁之礼吧。"
    }
    {
      Id = "Persephone_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，谢谢你，真是太完美了！我们在冥府的库存都消失了……也许是克洛诺斯嗜好这一口吧。"
    }
    {
      Id = "Hades_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "至高山巅的蜜露……很难想象，我们曾经在这里禁止了这种饮品，不过那是在你出生很久之前的事了。谢谢你，女儿。我们也有一样东西要送给你。一件小小的纪念品，但也象征着我们的家。"
    }
    {
      Id = "Persephone_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你，女儿。我们肯定能用得上的。事实上，哈迪斯正好有个打算呢。"
    }
    {
      Id = "Hades_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你准许的话，女儿……我想要将这瓶蜜露送给帮助冥界翻修工作的暗灵工人。作为对他们辛苦劳动的额外感谢。这样做合你的心意么？"
    }
    {
      Id = "MelinoeField_4377"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然，父亲，你怎么处置都好。而用来奖励历尽这一切却仍然忠于我们的暗灵，想来是件无比有意义的事情。"
    }
    {
      Id = "Persephone_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是一瓶品质上乘的蜜露。我们就开心地收下了！你知道么，有的时候你会让我想起你哥哥……"
    }
    {
      Id = "Hades_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些传承自上面，由我们所共享的习俗……我希望你不要盲目遵循。我们今天的处境，或许也与这样的传统脱不了干系。"
    }
    {
      Id = "MelinoeField_4378"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和你一样对这样的事情持保守态度，父亲，不过……在众神的诸多传统之中，将蜜露送给我们在意的人，应该属于其中的精华而非糟粕，至少我是这样认为的。"
    }
    {
      Id = "Hades_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……也许你是对的。"
    }
    {
      Id = "Hades_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定有许多其他人会乐意收到你这样的礼物。生长在三岔路口的幽闭之中……我担心你曾经过的是非常孤独的生活。哪怕喜欢孤独的人，只怕也难耐那样的寂寞。"
    }
    {
      Id = "Persephone_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "孤独不见得总是坏事，可是……当时的你，一定很不好受。"
    }
    {
      Id = "MelinoeField_4379"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们不用这样担心啦。在三岔路口长大确实很辛苦，但是……我从来没有感到过孤单。我始终有人可以倾诉……有的时候，甚至会对一座纪念你们的喷泉说话。"
    }
    {
      Id = "Hades_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的言语恐怕没有什么说服力，哪怕我和你一样，都希望我能被说服。倘若你在我的府上长大，我们一定会对你关怀备至，而不是让你为生活所迫辛苦劳动……尤其是在你这样的年纪。"
    }
    {
      Id = "MelinoeField_4380"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没有为我需要做的那些事后悔过，父亲。而我交到的朋友，我也非常珍惜。也许我成长的过程中本可以过上更加富足的生活，但也拥有了我所需要的一切。除了我的父母。以及哥哥，以及狗狗。"
    }
    {
      Id = "Persephone_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那现在，你也拥有我们了。"
    }
    {
      Id = "MelinoeField_4381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感谢命运。"
    }
    {
      Id = "MelinoeField_4382"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道有些蜜露会送给我们忠诚的暗灵，但我希望你和母亲能亲自品尝这一瓶。无论什么时候都好。"
    }
    {
      Id = "Hades_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "适合享受这种饮料的时候……也许要等到冥界翻修工作彻底完成，我们清点好所有的物资，安排好每个暗灵的去向，然后才有机会拥有片刻的喘息吧。"
    }
    {
      Id = "Persephone_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，省省吧，哈迪斯。我们肯定能抽个时间，早点让墨利诺厄如愿的。你比任何人都清楚，工作是永远做不完的，所以见到喘息的机会，就要自己抓住才行嘛。"
    }
    {
      Id = "Hades_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然王后发话了，那就如此吧。谢谢你的礼物，女儿。但你真的不用在我们身上花这些心思。我们已经重新拥有了彼此。我自己再也没有什么所求之物了。"
    }
    {
      Id = "MelinoeField_4383"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然现在你们有了一瓶蜜露，可以用来庆祝比较小的事情，我还希望你们能收下这个，用来庆祝更加独特的时光。也许是距此很久以后，等到我们都忘却了分开生活是什么感觉，又恰好想要举杯畅饮一番的时候。"
    }
    {
      Id = "Persephone_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是……仙馔密酒，而且色泽如此亮丽，一定是直接取自源头……女儿，{#Emph}谢谢你！"
    }
    {
      Id = "Hades_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "来自天界的仙馔密酒……我几乎已经无法记起它的滋味。但分开生活的滋味，我永远也无法忘却。我们也都不应该指望时间帮我们磨平伤痛。让我们都牢牢记住，我们是如何才走到今天这一步。"
    }
    {
      Id = "MelinoeField_4384"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我很小的时候，赫卡忒老师说过类似的话……过往的痛苦不会消除，只会随着年岁的增长，发作得越来越不频繁。既然这样，也许我们应该庆祝这样的记忆本身。哪怕是距此千百年之后，我也很乐意。"
    }
    {
      Id = "Persephone_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "千百年之后的庆祝，我们总能有充裕的时间准备了吧，所以……为什么不呢，哈迪斯？这样的仙酒，放到那时一定更加香醇。"
    }
    {
      Id = "MelinoeField_4385"
      InheritFrom = "BaseNarrative"
      DisplayName = "到时候，如果我能帮忙筹备些什么的话，请让我知道。又或者在你们整顿冥府的期间，还有什么别的事情我能帮上忙，也跟我说一声。"
    }
    {
      Id = "Persephone_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "这种话，应该我们向你说才是。在你降生的时候，哈迪斯和我感谢命运女神，让我们喜得千金。但我们当时完全意识不到，你对我们究竟有多么宝贵……"
    }
    {
      Id = "MelinoeField_4207_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你们……！"
    }
    {
      Id = "Persephone_0028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "收下吧，女儿。"
    }
    {
      Id = "MelinoeField_4207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你们的礼物。"
    }
    {
      Id = "Hades_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我无心于此。"
    }
    {
      Id = "Hades_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "与你哥哥一模一样。"
    }
    {
      Id = "Hades_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "住手。"
    }
    {
      Id = "Hades_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "女儿？"
    }
    {
      Id = "Hades_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，鲜血与黑暗……"
    }
    {
      Id = "Hades_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果必须的话，就拿我发泄吧。"
    }
    {
      Id = "Hades_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你不需要像我一样失败。"
    }
    {
      Id = "Hades_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别折腾我了。"
    }
    {
      Id = "Hades_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我说了，别折腾我了。"
    }
    {
      Id = "Hades_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你和她同样笃定，岔路女巫。所以说，这对你来说不会是种负担？照顾她，以及……对她上心，就像这一切都没有发生的话，我们会做的那样……？"
    }
    {
      Id = "HecateField_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "大人，我不是她的母亲；她失去的东西，我无法弥补。但我曾向您立下过誓言，一定会保证她不受任何伤害，这则誓言仍有效力。而我始终会对她上心，无论她是否与我住在一起。"
    }
    {
      Id = "Hades_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你呢，墨利诺厄？你下定主意了么？虽然我并不惊讶，但仍然必须问清楚，因为你在这里的决定受到比我的律法更古老的规则管辖；一旦立下誓言，便无可逆转。为匿踪者效力……"
    }
    {
      Id = "MelinoeField_5065"
      InheritFrom = "BaseNarrative"
      DisplayName = "……即是在暗影中效力。我深知这一点，父亲，而且我的这个决定绝非草率做出，只是……我还不能离开三岔路口。尤其是现在，我的使命还没有完成，毕竟按克洛诺斯的说法，我们还要面对其他的可能性。"
    }
    {
      Id = "Hades_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "他的新计划……真是苦了你了，为了扭转我们认知的时间，担起了如此大任，到头却又要为了确保事情再无变故而背负更多使命。"
    }
    {
      Id = "MelinoeField_5066"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我不介意。这件事对我来说非常重要。我想，我要么会成为{#Emph}时间的守护者{#Prev}，要么会成为{#Emph}时间杀手{#Prev}，一切都取决于克洛诺斯的表现。"
    }
    {
      Id = "Hades_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "就好像他此前度过了完全不同的生命历程一样。我仍然感觉相当难以接受。你的宙斯叔叔得要自己做出判断了。"
    }
    {
      Id = "MelinoeField_5067"
      InheritFrom = "BaseNarrative"
      DisplayName = "叔父大人有我们完整的报告……看看他如何决定吧。这些变动适应起来并不容易，不是么？但我很快就能见到你了，还有妈妈、刻耳柏洛斯，以及扎格列欧斯。我们肩负的责任应该意味着我们会经常相遇。"
    }
    {
      Id = "Hades_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "理应如此！刻耳柏洛斯已经忍不住自己跑去哀悼原野，在那里横冲直撞了。我和你的母亲很快也会回到岗位上。至于你哥，他早晚会从哪冒出来的。"
    }
    {
      Id = "MelinoeField_4985"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会很期待的。很高兴你回来了，父亲。"
    }
    {
      Id = "Zagreus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，这可真是稀奇。你们两个竟然同时出现在了休息室里！你怎么来了，爷爷？"
    }
    {
      Id = "Chronos_1413"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我怎么来了{#Prev}，我还没找到我孙女，就这么简单！我把整座冥府翻了个底朝天，都没有找到她的一丝踪迹！她的身手已经和你一样隐秘了，哈迪斯。"
    }
    {
      Id = "Hades_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "又或许是你上了年纪，眼力大不如前了。她往厨师长那边跑去了，现在还躲在那里，一声不吭。快去吧，免得她等得太久，没了耐心。"
    }
    {
      Id = "Zagreus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……父亲的意思是，{#Emph}我们也不知道我的好妹妹躲到哪里去了！{#Prev}任何地方都有可能！你有在管理大厅找过吗？天哪，我怎么说话跟修普诺斯似的。"
    }
    {
      Id = "Chronos_1414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，感谢你们的提示。"
    }
    {
      Id = "Zagreus_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "加油！"
    }
    {
      Id = "Chronos_1415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "孙女啊，你在哪……？"
    }
    {
      Id = "MelinoeField_5053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（笑）"
    }
    {
      Id = "Persephone_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "我美丽的女儿……我还是很难相信真的是你！人们都说孩子一转眼就长大了，可是……可是这也太快了。{#Emph}太{#Prev}快了……"
    }
    {
      Id = "MelinoeField_3887_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，母亲……我已经尽快赶来了，但还是……花了一些时间。不是么，爷爷……？"
    }
    {
      Id = "Chronos_1400"
      InheritFrom = "BaseNarrative"
      DisplayName = "……确实。珀耳塞福涅王后，我多么希望能将我一时糊涂从你们手中夺走的时间和记忆都物归原主。人们常说，最残忍的莫过于时间……他们说得没错。"
    }
    {
      Id = "Persephone_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "人们还说时间能治愈一切创伤，但这点对我来说还有待证实……尤其是目前，冥府的员工都还在恢复中。在我的家族之中，赢得宽恕的过程十分艰难，克洛诺斯。不过，你似乎有永恒的时间为之努力。"
    }
    {
      Id = "MelinoeField_4986"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到这个，我们也有永恒的时间寻找命运三女神。就算在倪克斯的帮助下，也还是找不到她们的任何踪迹么？"
    }
    {
      Id = "Chronos_1427"
      InheritFrom = "BaseNarrative"
      DisplayName = "全无音讯。我将她们逐入了深渊……倘若我知道她们位于何处，她们便能找到办法回到这里。但是，倘若我基于我所经历的其他可能性建立的假说正确的话……我们还有机会找到她们。"
    }
    {
      Id = "MelinoeField_5068"
      InheritFrom = "BaseNarrative"
      DisplayName = "你指的是关于时间运作方式的那个假说……你确定我们必须确保其他的条件与之前尽可能接近，才能验证它吗？"
    }
    {
      Id = "Chronos_1428_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，是的！那是妥善验证理论的唯一方式。现在看来，我自己对时间运作方式的认识，还有所欠缺啊……"
    }
    {
      Id = "MelinoeField_4987"
      InheritFrom = "BaseNarrative"
      DisplayName = "会有办法改正这一点的。唔，母亲……？谢谢你的照顾，以及你所做的一切。能够见到你真是太好了。"
    }
    {
      Id = "Persephone_0012_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也一样！考虑到未来的安排，我们应该过不了多久就能再见面了。至于克洛诺斯，你也先退下吧。你已经尽到了现阶段你该尽的责任，无论有多么微不足道。"
    }
    {
      Id = "Chronos_1382"
      InheritFrom = "BaseNarrative"
      DisplayName = "王后陛下，我向你献上我的感谢，以及我的承诺。至少，冥府现在已经大抵恢复你所喜爱的模样。当然，在这座府邸之外，还有很多事情尚待完成。"
    }
    {
      Id = "MelinoeField_3889"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，嗯……父亲会亲自督办冥界的翻修工作。听起来他之前有过类似的经验。至于我们，我们的车已经到了。"
    }
    {
      Id = "Chronos_1027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "的确。我准备好了。"
    }
    {
      Id = "Storyteller_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}将哀悼原野搅得天翻地覆的渊狱魔兽如今镇定地坐在那里，等待着并非冥界王女的某人。"
    }
    {
      Id = "Storyteller_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}自从在这道深渊中找到他的主人之后，凶恶的刻耳柏洛斯便始终忠心耿耿地守护着他，不离不弃。"
    }
    {
      Id = "Storyteller_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}三头恶犬刻耳柏洛斯不允许任何人靠近他，也不允许任何人靠近他的主人。"
    }
    {
      Id = "Storyteller_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}地狱恶犬露出无数利齿，仿佛在说：走开。"
    }
    {
      Id = "Storyteller_0128"
      InheritFrom = "BaseNarrative"
