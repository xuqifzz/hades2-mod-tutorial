    }
    {
      Id = "Hades_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是头喜怒无常的野兽。"
    }
    {
      Id = "Hades_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他不想跟你玩。"
    }
    {
      Id = "Storyteller_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}恶名昭彰的三头魔犬刻耳柏洛斯在他最爱的位置上休息，现如今看向冥界王女的三副神情与先前不复相同。"
    }
    {
      Id = "MelinoeField_3890"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，乖狗狗，虽然还不需要你去把守冥界的大门，但是趴在这里一定也很惬意吧。话说，能不能让我摸摸你？像我哥哥给我示范的那样。"
    }
    {
      Id = "MelinoeField_1681"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你听不见我说话，但是……你在我父亲受难之时为他带来了些许慰藉，谢谢你。"
