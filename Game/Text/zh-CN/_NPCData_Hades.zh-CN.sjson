    }
    {
      Id = "Storyteller_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在冥界的真王身侧，三头恶犬不再怒形于色。"
    }
    {
      Id = "Storyteller_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}凶猛的地狱犬刻耳柏洛斯如今心中不剩半点信任，对任何人都是那副呲牙咧嘴的模样。"
    }
    {
