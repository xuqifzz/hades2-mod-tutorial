    }
    {
      Id = "Storyteller_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}残暴无情的地狱恶犬如今允许冥界王女走上前来。"
    }
    {
      Id = "Storyteller_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}无论冥界之神、亡者之主前往何方，地狱的看门犬都会紧随其后。"
    }
    {
      Id = "Storyteller_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}曾经把守地狱大门的三头恶犬对冥界王女收敛了残暴的本性。"
    }
    {
      Id = "Storyteller_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}出于未知的原因，这只凶残的野兽决定不要把王女一口吞掉。"
    }
    {
      Id = "Storyteller_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}冥界王女不知怎的，让地狱恶犬像中了她的魔法一般顺从。"
    }
    {
      Id = "Hades_0139"
