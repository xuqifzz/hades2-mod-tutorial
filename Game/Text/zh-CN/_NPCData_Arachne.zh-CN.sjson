    }
    {
      Id = "Arachne_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这里有许多新织好的衣裳，任你挑选！"
    }
    {
      Id = "Arachne_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的丝绸比看起来更加坚韧——希望这些衣服能保护你的安全。"
    }
    {
      Id = "Arachne_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你穿丝绸的样子实在是美丽动人，你知道的，对吧？"
    }
    {
      Id = "Arachne_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "挑一件试试吧，朋友，然后我就不打扰你咯。"
    }
    {
      Id = "Arachne_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道我的小窝对你来说总要绕一段路，所以谢谢你专门来拜访我。"
    }
    {
      Id = "Arachne_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确定不要来几只美味的苍蝇尝尝吗？超级鲜嫩的哦！"
    }
    {
      Id = "Arachne_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么说，有看上眼的没有？{#Emph}哈哈哈哈……"
    }
    {
      Id = "Arachne_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，多留意旁边的蜘蛛茧哦！都是我专门为你捕获的。"
    }
    {
      Id = "Arachne_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管是在天上还是地下，你都找不到质量更高的丝绸啦。"
    }
    {
      Id = "Arachne_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，你才刚要走，我都要开始想你了。常回来看看，好么？"
    }
    {
      Id = "Arachne_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "在满月的映衬下，你实在是……美得令人震惊。"
    }
    {
      Id = "Arachne_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "我刚才还在想，好像那是你穿过树林的沙沙声？然后你就出现了！"
    }
    {
      Id = "Arachne_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是我能为你做更多事就好了，朋友……"
    }
    {
      Id = "Arachne_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "你现在一定很艰难，但不要动摇信念，好么？"
    }
    {
      Id = "Arachne_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "答应我，哪怕有任何一点不完美，都要跟我说哦。"
    }
    {
      Id = "Arachne_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "人们以前总说，我的丝绸就像温暖的拥抱……{#Emph}哈哈哈哈……"
    }
    {
      Id = "Arachne_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你找到最完美的那件之前，我是不会放你走的哦。"
    }
    {
      Id = "Melinoe_1606"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次经过厄瑞玻斯，想到有可能遇到你，都会让我心安。这是一点小心意，献给你温馨的小窝。"
    }
    {
      Id = "Arachne_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，天哪，你真是太好了！我想，这个应该能吸引到一大群苍蝇吧！实在是{#Emph}太太太太太{#Prev}感谢你了！那这个你要收下哦，不然就太让我过意不去了……！"
    }
    {
      Id = "Arachne_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，这难道是……哦不，我真的不该收下的，何况我之前已经收过一次你的礼物了。能为像你这样的人做衣服已经是我的无上荣耀了，而且这本身就是对我的奖励！再说了，这东西是给神明享用的……"
    }
    {
      Id = "MelinoeField_1797"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神们常常享受蜜露不错，但蜜露并不只是给他们的。比如这一瓶就是给你的！送给我的好朋友。"
    }
    {
      Id = "Arachne_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你对我真是太好啦！我只是做了换成任何人都会做的事情而已，可是{#Emph}你{#Prev}呀，你给我的简直是王族的待遇！这蜜露……上一次我尝了一口。实在是太棒了，不该浪费在苍蝇身上……也不该浪费在蜘蛛身上。"
    }
    {
      Id = "MelinoeField_1798"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许确实不该浪费在苍蝇身上。但这就是专门送给{#Emph}你{#Prev}的呀。这是代表友谊的礼物，我们之间的情谊越深厚，它的味道就越甜美。愿它能让你在寒冷的夜晚感受到温暖。"
    }
    {
      Id = "Arachne_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托啦，真不用送我这么多东西的！如果我还是原来的样子的话，只怕是要从脸颊羞红到脚趾头了！毕竟……好久好久都没有人送过我礼物了，你知道吗？"
    }
    {
      Id = "MelinoeField_1799"
      InheritFrom = "BaseNarrative"
      DisplayName = "我喜欢送你这样的礼物，阿拉克涅。有的时候，看到你在这里孤零零的样子，真的让我很难过。我一直没办法在你这里久留……所以也许，在我不在身边的时候，这瓶蜜露会帮助你回想起我们共度的快乐时光。"
    }
    {
      Id = "Arachne_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定会的。我不会忘记你对我的好。"
    }
    {
      Id = "Arachne_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈哈{#Prev}，抱歉失礼啦，我只是觉得……{#Emph}想想{#Prev}天上那些神明会怎么想，他们最{#Emph}引以为傲{#Prev}的传统，居然被用来献给这世界上最{#Emph}低贱{#Prev}的生物。"
    }
    {
      Id = "MelinoeField_1800"
      InheritFrom = "BaseNarrative"
      DisplayName = "你可不是低贱的生物！你的织术出神入化；你的声音悦耳动听；你的友谊让人信赖。你是独一无二的，阿拉克涅！而且，能认识这样的你，我很开心。没错，就是这样的你。真的。"
    }
    {
      Id = "Arachne_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……哎呀，我……你会这样想，我真的受宠若惊……只是……太可惜了，你没有在我最好的时光里认识我，你知道么？哎，可是我在说什么啦，我只不过是个……{#Emph}哈、哈、哈、哈……"
    }
    {
      Id = "Arachne_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你这样做只是出于好意，朋友，但……情到深处难自禁，我……我，唔……我担心我有点要开始胡思乱想了！我喜欢一个人独处，可是……可是有的时候，我又觉得一个人很孤独。"
    }
    {
      Id = "MelinoeField_1801"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有时也会觉得孤独。可是每当我来拜访你可爱的小窝时，我就感觉……唔，我也说不清楚，我……我只是想让你开心一点！也许就像你所说的，是“情到深处难自禁”吧。"
    }
    {
      Id = "Arachne_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你看你，怎么能在{#Emph}这种地方{#Prev}“难自禁”啦！你可是个女神啊，是完美无瑕的存在……你明白吗？不知道有多少人想要在你面前搔首弄姿，只为博你一笑呢！"
    }
    {
      Id = "MelinoeField_1802"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算有这样的人，那也无所谓。我和你之间的关系……任何其他人都无法替代。"
    }
    {
      Id = "Arachne_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这样啊……{#Emph}哈哈哈哈……"
    }
    {
      Id = "MelinoeField_4400"
      InheritFrom = "BaseNarrative"
      DisplayName = "我希望你能收下这份礼物：众神的仙馔密酒。你有我们的才华，甚至还有我们的骄傲。所以我觉得，让你拥有我们最隆重的礼物，又有何不可呢？"
    }
    {
      Id = "Arachne_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "仙馔密酒……你个大傻瓜，再这样下去你会宠坏我的！你给了我这么多礼物，要我怎么办才好嘛！我喝到天荒地老都喝不完啦！"
    }
    {
      Id = "MelinoeField_4401"
      InheritFrom = "BaseNarrative"
      DisplayName = "要喝到“天荒地老”，可是很长一段时间呢。而且，这些东西本来就最适合分享。也许可以留到你的服装店盛大开业的那天！"
    }
    {
      Id = "Arachne_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，这倒是个好主意。好啦，那我就把它好好存起来，而我碰巧有个很合适的办法……那就是用最好的丝绸把它层层缠住。"
    }
    {
      Id = "MelinoeField_4402"
      InheritFrom = "BaseNarrative"
      DisplayName = "这瓶仙酒送给你，预祝“阿拉克涅的别出心裁”生意红红火火。我发现有个盼头总会让自己更有动力，哪怕期盼的事情还很遥远。"
    }
    {
      Id = "Arachne_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你真是太慷慨了，朋友，要是我能触碰到你的话，真想好好抱一抱你，而且你看起来也很愿意，可是……我最好还是在远处欣赏你啦。"
    }
    {
      Id = "MelinoeField_4403"
      InheritFrom = "BaseNarrative"
      DisplayName = "可我不在远处，我就在这里呀。而且我想让你知道，我很高兴你没有变。要是你变回去了的话……我怕我可能会失去你。"
    }
    {
      Id = "Arachne_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是{#Emph}这么小{#Prev}的我才更容易失去呀，一转眼就不知道去哪了呢！不过，谢谢你，真的。以前我觉得，你会说一些话只是因为可怜我，但现在我明白你是真心的。"
    }
    {
      Id = "Arachne_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "不许再送我仙酒了，朋友，拜托啦。我都要没地方放了！而且你已经给了小小的我太多太多啦。"
    }
    {
      Id = "MelinoeField_4404"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然，不过……也许我们两个有机会的话，可以小酌一杯。比如现在……？毕竟你都要没地方放了嘛。"
    }
    {
      Id = "Arachne_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔！如果你不太忙的话，我真的很乐意。可以帮我打开瓶子吗？这个盖子对我来说有点紧……"
    }
    {
      Id = "Arachne_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "……谢谢你愿意给我这么多的时间、这么多的爱。大多数的凡人都讨厌蜘蛛……恐怕你们这些神明也是一样的吧。"
    }
    {
      Id = "MelinoeField_4405"
      InheritFrom = "BaseNarrative"
      DisplayName = "对不理解的事物产生恐惧是很正常的。我是个女巫；我们经常被人这样对待。也许这就是我从一开始就感觉和你有缘的原因吧。"
    }
    {
      Id = "Arachne_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "你感觉和我有缘，是因为你{#Emph}一脚踩上{#Prev}了我，我的朋友！还好你听到了我当时歇斯底里的尖叫。那可不是认识新朋友最理想的方式……"
    }
    {
      Id = "MelinoeField_4406"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许不是吧，但从结果来说，也算是好事嘛。而且从那之后，我就再也没有踩到过你，对吧？"
    }
    {
      Id = "Arachne_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，这个嘛，应该是没有啦。说起来，仙酒这东西还真是不一般！而且只要喝一口，就能回味好久！"
    }
    {
      Id = "MelinoeField_4407"
      InheritFrom = "BaseNarrative"
      DisplayName = "对吧？很高兴你喜欢。它在和你在意的人分享时味道最甜美，而这一瓶显然很不错。"
    }
    {
      Id = "Arachne_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就是说你真的在意我，哈。有超级长一段时间，我都不允许自己这样想。但现在，你{#Emph}知道{#Prev}我永远都变不回去了，却还是在做你自己。"
    }
    {
      Id = "MelinoeField_4408"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也做不成别人呀。那你呢？如果你能做到任何事，能做任何人，你会怎么选？"
    }
    {
      Id = "Arachne_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我……嗯，我会选择做全世界最棒的织匠。就像我现在选的那样。"
    }
    {
      Id = "Arachne_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是太棒了，朋友！非常感谢你和我共度时光，以及你所做的一切。"
    }
    {
      Id = "MelinoeField_4410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是应该的。毕竟友谊是相互的嘛。"
    }
    {
      Id = "Melinoe_1915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿拉克涅，这也太好看了……！"
    }
    {
      Id = "Arachne_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "加油，加油……！"
    }
    {
      Id = "Arachne_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦不……！"
    }
    {
      Id = "Arachne_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不敢看了……！"
    }
    {
      Id = "Arachne_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（倒吸一口气）"
    }
    {
      Id = "Arachne_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喂！"
    }
    {
      Id = "Arachne_0290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哇，悠着点！"
    }
    {
      Id = "Arachne_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你想来玩玩吗？"
    }
    {
      Id = "Arachne_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没打到哦！"
    }
    {
      Id = "Arachne_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "抓不到我！"
    }
    {
      Id = "Arachne_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "太慢啦！"
    }
    {
      Id = "Arachne_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又没打到！"
    }
    {
      Id = "Arachne_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哈哈{#Prev}，没打到哦！"
    }
    {
      Id = "Arachne_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就差一点哦！"
    }
    {
      Id = "Arachne_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}啊啊啊！{#Prev}开玩笑的啦，没打到我呢。"
    }
    {
      Id = "Arachne_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你好呀，我的朋友！我之前碰巧看到摆渡人在恸哭之河上划船，我猜他是来找{#Emph}你们{#Prev}的，毕竟他船上装着各种各样的物资。他真是慷慨，一点都不介意我搭他的顺风船呢。也可能是他没看到我啦，{#Emph}哈哈哈哈……"
    }
    {
      Id = "Melinoe_3141"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎，阿拉克涅，很高兴在这里见到你！我很肯定，像你这样彬彬有礼的乘客，卡戎是不会介意的。我想让你在这里待得尽可能舒服，有什么我可以为你做的吗？"
    }
    {
      Id = "Arachne_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用了，谢谢你。我不打算在这里待很久啦。毕竟，我还得坐摆渡人的船回去呢。我把这边的丝绸都补好，然后就走啦。保重哦，好么？"
    }
    {
      Id = "Melinoe_3142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也一样……"
    }
    {
      Id = "Arachne_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哦，别担心，我会没事的！我对这一片森林应该已经了如指……{#Emph}呃，了如腿脚{#Prev}啦！我一直都很感谢你的盛情款待，伟大的泰坦。"
    }
    {
      Id = "Hecate_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里很欢迎你，而且很安全，阿拉克涅。不过，现在请恕我失陪。近期发生的这些事，越来越耗费我的精力了……"
    }
    {
      Id = "Arachne_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解，真的。那我就不打扰你啦。再见了哦！"
    }
    {
      Id = "Hecate_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见。"
    }
    {
      Id = "Arachne_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "……可是，可是{#Emph}这怎么可能{#Prev}……泰坦，这究竟是什么意思？如果你说的句句属实，那……那就意味着，你对我说了那么多次“这里很欢迎你，而且很安全”……都是在骗我咯。是这么回事吗？"
    }
    {
      Id = "Hecate_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "你完全有愤怒的理由。雅典娜对你施下诅咒时，用的确实是我的毒药。但诅咒你的是她，而不是我。本来这{#Emph}一切{#Prev}我都不打算让你知道。然而，墨利诺厄说服了我，让我改变了原本的想法。"
    }
    {
      Id = "Arachne_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我不知道还有什么好说的。所以这确实是{#Emph}你的{#Prev}错。要不是你的{#Emph}帮助{#Prev}，雅典娜就没法对我做出这种事。你们泰坦和众神……你们都是一个样。晚安吧！"
    }
    {
      Id = "Hecate_0548"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿拉克涅，别这样……{#Emph}唔……"
    }
    {
      Id = "Arachne_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然可以啦！"
    }
    {
      Id = "Arachne_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好说！"
