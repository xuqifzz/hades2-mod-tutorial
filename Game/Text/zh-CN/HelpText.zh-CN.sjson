      Id = "Cosmetic_CardDeck02_Flavor"
      DisplayName = ""
      Description = "对银月姊妹来说，阿卡那牌和暗夜武器缺一不可；二者兼备，方为万全。"
    }
    {
      Id = "Cosmetic_CardDeck03"
      DisplayName = "紧密联系牌背"
      Description = "{$Keywords.CosmeticDeck}：内含 {#UpgradeFormatDark}{$WorldUpgradeData.Cosmetic_CardDeck03.NumBackings} {#Prev}种可替换主题，描绘了每件暗夜武器的一种替代形态。"
    }
    {
      Id = "Cosmetic_CardDeck03_Flavor"
      DisplayName = ""
      Description = "据称，暗夜武器的每一位持有者，都至少与一位其他持有者有着紧密的联系。"
    }
    {
      Id = "Cosmetic_CardDeck04"
      DisplayName = "遥远联系牌背"
      Description = "{$Keywords.CosmeticDeck}：内含 {#UpgradeFormatDark}{$WorldUpgradeData.Cosmetic_CardDeck04.NumBackings} {#Prev}种可替换主题，描绘了每件暗夜武器的一种古老形态。"
    }
    {
      Id = "Cosmetic_CardDeck04_Flavor"
      DisplayName = ""
      Description = "暗夜武器的持有者，在其黑暗的起源与对冥界的责任上有着诸多共通之处。"
    }
    {
      Id = "Cosmetic_CardDeck05"
      DisplayName = "魔宠牌背"
      Description = "{$Keywords.CosmeticDeck}：内含 {#UpgradeFormatDark}{$WorldUpgradeData.Cosmetic_CardDeck05.NumBackings} {#Prev}种可替换主题，描绘了你自己的各个{$Keywords.FamiliarPlural}。"
    }
    {
      Id = "Cosmetic_CardDeck05_Flavor"
      DisplayName = ""
      Description = "哪怕对于最热衷于阿卡那牌的研习者来说，生命的本质也是永恒的谜题；究竟是何种力量，能束缚万千生灵？"
    }
    {
      Id = "Cosmetic_CardDeck06"
      DisplayName = "恐惧牌背"
      Description = "{$Keywords.CosmeticDeck}：内含 {#UpgradeFormatDark}{$WorldUpgradeData.Cosmetic_CardDeck06.NumBackings} {#Prev}种可替换主题，风格与令人恐惧的{$Keywords.Shrine}相呼应。"
    }
    {
      Id = "Cosmetic_CardDeck06_Flavor"
      DisplayName = ""
      Description = "立下誓言之人，迟早会对恐惧培养出一种良性的敬意，否则便只能任由自己为其吞噬。"
    }
    {
      Id = "Cosmetic_CardDeck07"
      DisplayName = "隐藏联系牌背"
      Description = "{$Keywords.CosmeticDeck}：内含 {#UpgradeFormatDark}{$WorldUpgradeData.Cosmetic_CardDeck07.NumBackings} {#Prev}种可替换主题，描绘了每件暗夜武器的一种异域形态。"
    }
    {
      Id = "Cosmetic_CardDeck07_Flavor"
      DisplayName = ""
      Description = "或许在遥远的其他国度，在这些与我们所知的冥界遥相呼应的世界，也会有神明冉冉升起。"
    }
    {
      Id = "Cosmetic_CardDeck08"
      DisplayName = "命运羁绊卡牌"
