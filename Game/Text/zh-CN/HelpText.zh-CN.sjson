    }
    {
      Id = "WorldUpgradeFishingPoint_Flavor"
      DisplayName = ""
      Description = "恸哭之河泄洪乃是不祥之兆，因此在涨水之后，栈桥很快便被封了起来。"
    }
    {
      Id = "CharFates"
      DisplayName = "命运三女神"
      Description = "{$Keywords.CharNyx}的三个行踪隐秘的女儿。所谓机缘巧合，往往都是她们的刻意编排。"
    }
    {
      Id = "CharNyx"
      DisplayName = "倪克斯"
      Description = "黑夜的化身，其意志和力量乃是冥界存续的根基。"
    }
    {
      Id = "CharHades"
      DisplayName = "哈迪斯"
      Description = "他乃是死者之主，命运三女神任命的冥界之王。"
    }
    {
      Id = "CharSelene"
      DisplayName = "塞勒涅"
      Description = "明月的化身，在静谧之中驱车穿越夜空，将一切纳入眼帘。"
    }
    {
      Id = "CharMoros"
      DisplayName = "摩罗斯"
      Description = "毁灭的化身，{$Keywords.CharNyx}众多为世人所恐惧的子女之一，命运三女神的使者与护卫。"
    }
    {
      Id = "CharCharon"
      DisplayName = "卡戎"
      Description = "人人畏惧的冥河摆渡人以他自己的方式为冥界效力。"
    }
    {
      Id = "CharChronos"
      DisplayName = "克洛诺斯"
      Description = "时间泰坦篡夺了冥府，渴望一统三界。"
    }
    {
      Id = "CharTyphon"
      DisplayName = "提丰"
      Description = "庞大无比的众魔之父，比他的子孙加在一起还要可怕。"
    }
    {
      Id = "CharOdysseus"
      DisplayName = "奥德修斯"
      Description = "足智多谋的战术家，生前屡出奇策、逢凶化吉，因此闻名遐迩。"
    }
    {
      Id = "CharIcarus"
      DisplayName = "伊卡洛斯"
      Description = "这个暗灵是凡间最伟大的工匠的儿子，亦是他的学徒。"
    }
    {
      Id = "CharSkelly"
      DisplayName = "瑟勒米乌斯"
      Description = "三岔路口的训练大师，曾在冥府中担任要职。"
    }
    {
      Id = "CharNemesis"
      DisplayName = "涅墨西斯"
      Description = "报应的化身，{$Keywords.CharNyx}众多为世人所恐惧的子女之一，三岔路口的哨卫。"
    }
    {
      Id = "CharEris"
      DisplayName = "厄里斯"
      Description = "纷争的化身，{$Keywords.CharNyx}的小女儿，喜爱搬弄是非、煽风点火，没人治得住她。"
    }
    {
      Id = "CharChaos"
      DisplayName = "卡俄斯"
      Description = "万物因他而始，主宰世界的原初力量也因他而生。"
    }
    {
      Id = "CharNarcissus"
      DisplayName = "纳西索斯"
      Description = "他的自恋酿成了诅咒，令他永远目不转睛地凝望着自己美丽的倒影。"
    }
    {
      Id = "CharDora"
      DisplayName = "朵拉"
      Description = "她在死后无忧无虑地飘着，忘却了他人的存在，也忘却了生前的自己。"
    }
    {
      Id = "CharArachne"
      DisplayName = "阿拉克涅"
      Description = "她引以为傲的技艺绝非狂妄自大，但却仍让妒火焚心的神明降下天罚。"
    }
    {
      Id = "WorldUpgradeMorosUnlock"
      DisplayName = "招来毁灭"
      Description = "祈求{$Keywords.CharMoros}再次出现，并让他带来{$Keywords.CharFates}的旨意。"
    }
    {
      Id = "WorldUpgradeMorosUnlock_Flavor"
