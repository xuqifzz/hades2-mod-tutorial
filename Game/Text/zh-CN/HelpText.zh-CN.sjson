    }
    {
      Id = "UseGhostRecruit"
      DisplayName = "{SI} 致意"
    }
    {
      Id = "Ghost_Agent01"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}荣耀"
      Description = "为真正的冥王和冥后伸张正义！当然还有您，王女殿下！"
    }
    {
      Id = "Ghost_Agent02"
      DisplayName = "死因：{#CauseOfDeathFormat}背刺"
      Description = "我们对三岔路口女巫的信任决不动摇！（好吧，其实我有点动摇……）"
    }
    {
      Id = "Ghost_Agent03"
      DisplayName = "死因：{#CauseOfDeathFormat}变质的肉"
      Description = "克洛诺斯必死无疑，殿下！愿他死得比我更惨！"
    }
    {
      Id = "Ghost_Agent04"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}被爱"
      Description = "她看了我！她打招呼的时候在看着我！"
    }
    {
      Id = "Ghost_Agent05"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}长生不死"
      Description = "我们准备好为你而死了，王女！再死一次又何妨！"
    }
    {
      Id = "Ghost_Agent06"
      DisplayName = "死因：{#CauseOfDeathFormat}鼠兽"
      Description = "时间泰坦是杀不死的！就连宙斯和他的兄弟们都无法消灭他！"
    }
    {
      Id = "Ghost_Agent07"
      DisplayName = "死因：{#CauseOfDeathFormat}疫病"
      Description = "诅咒冥王的敌人身患恶疾！还有胆敢惹怒您的人也一样，王女殿下！"
    }
    {
      Id = "Ghost_Agent08"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}美餐"
      Description = "真希望我能和涅墨西斯切磋一次……你们其他人都不是我的对手。"
    }
    {
      Id = "Ghost_Agent09"
      DisplayName = "死因：{#CauseOfDeathFormat}诅咒"
      Description = "你一定是在开玩笑。你知道我们要面对的是谁吗？"
    }
    {
      Id = "Ghost_Agent10"
      DisplayName = "死因：{#CauseOfDeathFormat}箭伤"
      Description = "说实话，要不是那些奥林匹斯神，我们很多人都不会来到这里……"
    }
    {
      Id = "Ghost_Agent11"
      DisplayName = "死因：{#CauseOfDeathFormat}坠落"
      Description = "你知道要去到塔耳塔罗斯得下落多久吗？"
    }
    {
      Id = "Ghost_Agent12"
      DisplayName = "死因：{#CauseOfDeathFormat}年迈"
      Description = "愿克洛诺斯为他的所作所为付出代价，王女！"
    }
    {
      Id = "Ghost_Agent13"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}声名"
      Description = "我才不管你们怎么说！我该去的是至福乐土，不是这里！"
    }
    {
      Id = "Ghost_Agent14"
      DisplayName = "死因：{#CauseOfDeathFormat}卡律布狄斯"
      Description = "这让我想起了当水手的日子……奥德修斯大师一定还记得我，我很确定！"
    }
    {
      Id = "Ghost_Agent15"
      DisplayName = "死因：{#CauseOfDeathFormat}惊恐"
      Description = "我现在被吓得动弹不得，希望你能理解。"
    }
    {
      Id = "Ghost_Agent16"
      DisplayName = "死亡年龄：{#CauseOfDeathFormat}{$TempTextData.AgeOfDeath}"
      Description = "我居然有机会亲口对阿尔忒弥斯说“愿明月指引你”！！"
    }
    {
      Id = "Ghost_Agent17"
      DisplayName = "死因：{#CauseOfDeathFormat}蛇咬"
      Description = "最近各个地方都有暗灵来到这里！"
    }
    {
      Id = "Ghost_Agent18"
      DisplayName = "死因：{#CauseOfDeathFormat}中毒"
      Description = "考虑到当下的环境，小酒馆真是生机勃勃。"
    }
    {
      Id = "Ghost_Agent19"
      DisplayName = "死因：{#CauseOfDeathFormat}纵欲"
      Description = "我们不配沐浴在您的荣光中，王女殿下！至少，我不配！"
    }
    {
      Id = "Ghost_Agent20"
      DisplayName = "死因：{#CauseOfDeathFormat}过敏"
      Description = "我们刚刚带着给奥德修斯大师的情报回来了！您要多加小心哦，王女殿下！"
    }
    {
      Id = "Ghost_Agent21"
      DisplayName = "死因：{#CauseOfDeathFormat}献祭"
      Description = "真想再看一看至福乐土的辉煌啊……"
    }
    {
      Id = "Ghost_Agent22"
      DisplayName = "死因：{#CauseOfDeathFormat}瘟疫"
      Description = "人生本就悲惨，现在死了也不好过。"
    }
    {
      Id = "Ghost_Agent23"
      DisplayName = "死因：{#CauseOfDeathFormat}独眼巨人"
      Description = "我不想念地表，我的朋友们都在这里了！"
    }
    {
      Id = "Ghost_Agent24"
      DisplayName = "死因：{#CauseOfDeathFormat}鹰身女妖"
      Description = "真的有一整支舰队在驶向奥林匹斯山吗？"
    }
    {
      Id = "Ghost_Agent25"
      DisplayName = "死因：{#CauseOfDeathFormat}巨蟒"
      Description = "世上的每一只怪物……都是提丰的子孙后代吗？"
    }
    {
      Id = "Ghost_Agent26"
      DisplayName = "死因：{#CauseOfDeathFormat}飞龙"
      Description = "不知道提丰和时间泰坦哪个更糟……"
    }
    {
      Id = "Ghost_Agent27"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}飞行"
      Description = "那边那个披着翅膀的，不是狄德勒斯家的小子吗？"
    }
    {
      Id = "Ghost_Agent28"
      DisplayName = "临终夙愿：{#CauseOfDeathFormat}和平"
      Description = "我们真的很喜欢您对这里的改造，王女殿下！"
    }
    {
      Id = "Ghost_Agent29"
      DisplayName = "来自：{#CauseOfDeathFormat}色萨利"
      Description = "厄里斯的垃圾丢得太多，都捡不过来了，王女殿下！"
    }
    {
      Id = "Ghost_Agent30"
      DisplayName = "来自：{#CauseOfDeathFormat}埃费拉"
