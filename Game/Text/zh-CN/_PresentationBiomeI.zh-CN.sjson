    {
      Id = "Storyteller_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}重回正统的冥王和冥后迅速安排好了这份相对轻松的工作，而仍然忠于他们的暗灵很快便响应了号召。"
