    {
      Id = "Storyteller_0523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}于是，冥界王女、时间泰坦和其他人，都在冥府住了下来，帮助挽回那些还没有永远失落之物。"
