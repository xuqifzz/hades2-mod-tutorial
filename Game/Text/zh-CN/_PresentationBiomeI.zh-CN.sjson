      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}他们和那个泰坦一起，拾回了过往的许多碎片……"
    }
    {
      Id = "Storyteller_0525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}……而很快，冥府就回到了更加接近往日的面貌。然而，紧接着，奥林匹斯传来召见的消息，而王女知道，她留在冥府的时日，即将告一段落……"
