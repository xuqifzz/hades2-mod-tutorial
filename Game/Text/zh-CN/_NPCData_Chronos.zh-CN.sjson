    }
    {
      Id = "Chronos_1058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}克洛诺斯必死无疑{#Prev}，是这么说的么？"
    }
    {
      Id = "Chronos_1059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}克洛诺斯必死无疑。"
    }
    {
      Id = "Chronos_1060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}克洛诺斯必死无疑！"
    }
    {
      Id = "Chronos_1480"
      InheritFrom = "BaseNarrative"
      DisplayName = "你愿意允许我偶尔在这里与你相见么，孙女？我深知我此前在厄瑞玻斯对你的言辞不甚讨喜……但在此世，或许我们还可以重新开始。"
    }
    {
      Id = "MelinoeField_4137"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我得适应一下不要一见到你就动手，不过可以试试。为什么是这里，这里有什么特别的吗？"
    }
    {
      Id = "Chronos_1481"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，首先，我知道怎么找到这里！其次，你也经常会经过这里！总之，你现在已经亲眼窥见弥留在奥林匹斯和冥界的真实可能。让我们消灭会引来破败的那些吧。"
    }
    {
      Id = "MelinoeField_5181"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来不错。在这个过程中，奥林匹斯和冥界都会紧盯着你的一举一动。别浪费了你唯一的机会。"
    }
    {
      Id = "Chronos_1482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也一直这样告诫自己！"
    }
    {
      Id = "Chronos_1085"
      InheritFrom = "BaseNarrative"
      DisplayName = "你父亲和他弟弟宙斯真是慷慨，给了我能为冥界尽到些绵薄之力的机会。神佑群屿是整个至福乐土最好的地方！而在我的治理下，那里定会永远如此。"
    }
    {
      Id = "MelinoeField_4139"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，这是对你无上的敬意！凡间最伟大的战士，一定有很多都在那里。有了这份新的责任在身，你还有时间像这样与我会面么？"
    }
    {
      Id = "Chronos_1086"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，依我看，比以前还更方便了。至福乐土离这里实在不算远；你有机会一定要去看看，等你父亲的冥府修缮工作竣工之后。不过，恐怕这得是下一个时代的事了。"
    }
    {
      Id = "MelinoeField_4140"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲确实像是那种完美主义者。好啦，祝你在新的岗位上一切顺利。命运允许的话，塔耳塔罗斯见。"
    }
    {
      Id = "Chronos_1087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "重走路线时一切小心！"
    }
    {
      Id = "MelinoeField_5032"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，我好奇一件事……我们面对的那么多可能性……我明白我胜利之后会发生什么，至少大概明白。可是如果我在里面失败，那又会怎么样？"
    }
    {
      Id = "Chronos_1390"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那种可能性会留下……仅此而已！不必为这种事煞费苦心；你我都知道，那些可能性多了去了！想要在其中立于不败之地，恐怕并不现实。"
    }
    {
      Id = "MelinoeField_5033"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还会有别的机会弥补我的失误吗？回到那个可能性中，把问题解决？"
    }
    {
      Id = "Chronos_1391"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道！或许不会！或许就连你的所谓{#Emph}失败{#Prev}，也未必不能达成期待中的结果。还有很多事我无法完全理解……纵使承认这点实在令人汗颜。"
    }
    {
      Id = "MelinoeField_5034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也一直在学习。"
    }
    {
      Id = "MelinoeField_4141"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，说起来，命运三女神到底怎么了？你真的流放了她们，而又不知道她们去哪儿了吗？"
    }
    {
      Id = "Chronos_1088"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，的确。这是我铸成的又一桩大错，我无比希望能够予以补救。我已使出浑身解数，在充斥着各种可能的深渊之中寻觅她们，只可惜……她们可能身在任何地方，如此做无异于大海捞针。"
    }
    {
      Id = "MelinoeField_4142"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定有什么我们可以做的事情。她们会不会身处危险之中？以及，如果我们最终找到她们的话，你不担心她们报复你么？"
    }
    {
      Id = "Chronos_1089"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得坦言，比起担心她们，我某种程度上确实更担心{#Emph}我{#Prev}的下场。但我过往抵抗命运的尝试，无一不以失败告终。如果她们终将回归，我就只能任由她们处置……"
    }
    {
      Id = "MelinoeField_4143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一定能想到办法的。"
    }
    {
      Id = "MelinoeField_5029"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，你是怎么唤醒提丰的？我一直好奇这一点。而且，这么一个庞然大物，居然还能打奥林匹斯一个措手不及……"
    }
    {
      Id = "Chronos_1387"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，我……我宁愿不要谈起这些苦涩的记忆，不过……那个魔物的苏醒，某种程度上与扎格列欧斯找到我的时候，我所经历的事情相仿。当然，规模要比我大得多。"
    }
    {
      Id = "MelinoeField_5030"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白了，我不愿意勉强你，不过……这个问题可能很奇怪，但你和提丰彼此很熟吗？"
    }
    {
      Id = "Chronos_1388"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是众魔之父……而他对自己的子孙都毫不在意，更不用说其他人了。他不过是一种终结的手段而已。大概可以说，我们是在彼此利用罢。"
    }
    {
      Id = "MelinoeField_5031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我明白了。就这样吧。"
    }
    {
      Id = "Chronos_1389"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好。"
    }
    {
      Id = "MelinoeField_5035"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这一切发生之后，你跟普罗米修斯有联络么？我跟他始终相处不来。不过，我好像发现了，他并不是真的站在你那一边……"
    }
    {
      Id = "Chronos_1392"
      InheritFrom = "BaseNarrative"
      DisplayName = "那家伙很{#Emph}聪明{#Prev}。甚至对他自己而言，可以说是聪明反被聪明误。你们之间走到了大打出手的地步，让我很遗憾。不过，我和他之间已经再无联络……为了让情况尽可能与之前相仿。"
    }
    {
      Id = "MelinoeField_5036"
      InheritFrom = "BaseNarrative"
      DisplayName = "尽管他给众神惹来了许多麻烦，但他对现在的情况做出了相当谨慎的判断。如果他真的能预料到每一种结局，那也许这一切都说得通了。"
    }
    {
      Id = "Chronos_1393"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来像是我认识的那个普罗米修斯。"
    }
    {
      Id = "MelinoeField_5182"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我不太愿意承认，爷爷……但我觉得，你对奥林匹斯众神发起的那场苦涩的战争，至少让我们的一些亲戚领悟到了一些事情。虽然他们是神明……但他们也知道，自己并不完美。"
    }
    {
      Id = "Chronos_1483"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……完美，据我所知，可望而不可即！不过是个追求的目标罢了。我的孩子们或许很是固执，不愿改正自己的缺点，但这样的性情恐怕是从{#Emph}我{#Prev}身上继承来的。"
    }
    {
      Id = "MelinoeField_5183"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算这样……现在战争终于结束，在地表和这里都有许多事情要做。我渐渐意识到，我们在冥界的“翻修”工作，或许某种意义上并不止步于冥界。"
    }
    {
      Id = "Chronos_1484"
      InheritFrom = "BaseNarrative"
      DisplayName = "等你到了我这个年纪，或许就会怀念起世界本来的面貌。也许这就是年长者的诅咒罢！愿我们一家人仍能带领世界，步入更加繁荣昌盛的时代。"
    }
    {
      Id = "MelinoeField_5184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "希望如此。"
    }
    {
      Id = "MelinoeField_4554"
      InheritFrom = "BaseNarrative"
      DisplayName = "我面对的那些，你的其他可能性……跟他们说话的时候，就好像这一切都没发生过，感觉真的很奇怪。"
    }
    {
      Id = "Chronos_1311"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，的确如此。然而，这点恰恰能够证明，他们不过是可能性而已。因此，在杀个你死我活之前，顺着他们说两句也无妨。"
    }
    {
      Id = "MelinoeField_4555"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你介入这件事情，不会有什么负担吧？亲手消灭和你看起来完全一样的存在……消灭你自己？"
    }
    {
      Id = "Chronos_1312"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我是{#Emph}我{#Prev}啊。难道我们不是由自身的经历造就的吗，孙女？摒弃自己旧有的观念与陋习……何尝不是一件振奋人心的事！所以，就让我们继续罢。"
    }
    {
      Id = "Chronos_1290"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你戴上了我送给你的时间腕饰。还以为你会把它丢进冥界的深渊呢！流转不息的齿轮装置很令人着迷，不是么？"
    }
    {
      Id = "MelinoeField_4369"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实很别致。这是狄德勒斯大师的作品么？把这些小小的轮盘紧密贴合在一起，让它们达成完美的和谐……"
    }
    {
      Id = "Chronos_1291"
      InheritFrom = "BaseNarrative"
      DisplayName = "塔耳塔罗斯那不断变化的连环密室，的确是灵感来源之一。你所说的“完美的和谐”……或许只有这种以这种方式才能实现！但它确实{#Emph}可以{#Prev}实现。"
    }
    {
      Id = "MelinoeField_4370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好像是这么回事。"
    }
    {
      Id = "Chronos_1292"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，在俄刻阿诺斯，你有可能会遭遇我残余的法术，将你放入某个失序的时空。我还没有找到办法阻止那道咒语……"
    }
    {
      Id = "MelinoeField_4371"
      InheritFrom = "BaseNarrative"
      DisplayName = "你居然无法控制你自己的魔法？我当时还在想，究竟是你干的，还是某一个仍在与我们为敌的你。"
    }
    {
      Id = "Chronos_1293"
      InheritFrom = "BaseNarrative"
      DisplayName = "我显然无法推卸全部责任，但确实是{#Emph}他们{#Prev}之中某个干的，没错。至于你为什么这么易受影响……也许这是我们之间的某种联系罢。扛得住什么，遭不住什么，都如出一辙……"
    }
    {
      Id = "Chronos_1313"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕是现在，你身上也有着我孩子们的祝福。看到他们仍然在帮助你，让我倍感欣慰，毕竟我带来了如此严峻的危机，对他们的家园造成了如此惨烈的破坏……"
    }
    {
      Id = "MelinoeField_4556"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来我们都在尽自己的力量，让一切重回正轨。奥林匹斯众神对偶尔的剑拔弩张也并不陌生，虽然也许都不像上次那样激烈。"
    }
    {
      Id = "Chronos_1314"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，毕竟，如果我们要永生永世留在这个小小的世界，那么努力缓解我们对彼此造成的伤痛，也是情理之中……感谢你们所有人的支持。"
    }
    {
      Id = "MelinoeField_4559"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，涅墨西斯说她在塔耳塔罗斯好像遇到你了。你们的会面顺利吗？"
    }
    {
      Id = "Chronos_1317"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那可以说是非常顺利！我原本以为只有{#Emph}你{#Prev}能对付我那些叫人讨厌的残迹，但事实证明，{#Emph}涅墨西斯{#Prev}也行！而且她很有实力。"
    }
    {
      Id = "MelinoeField_4560"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以她是认真的！她在你的帮助下与一个残迹交了手，而且最终取得了胜利？她是怎么做到的，用冥界之刃把他砍成了碎片么？"
    }
    {
      Id = "Chronos_1318"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，细节我还是不透露为好，不过……她用的手段很有效率。这样做能奏效，一定是因为她的路线与你之前的非常接近！"
    }
    {
      Id = "MelinoeField_4561"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她真的做到了……"
    }
    {
      Id = "Chronos_1315"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一个问题想问你，孙女，如果你愿意分享你的看法的话。你觉得我该不该允许自己把胡须蓄起来？大概是为了在我的儿子们之间，显得不那么像个异类……"
    }
    {
      Id = "MelinoeField_4557"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，呃……这个主要取决于个人喜好吧。我个人觉得，你留胡子的话肯定会显老。而且，我的父亲和叔叔们肯定没有指望你变得像他们一样。"
    }
    {
      Id = "Chronos_1316"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说得很有道理。我一直更喜欢把自己打理得清爽一些。也许我的儿子们反其道而行之，也有这方面的原因……"
    }
    {
      Id = "MelinoeField_4558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有可能……"
    }
    {
      Id = "MelinoeField_4372"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，好消息。命运三女神回来了！而且她们听起来没有找你报仇的打算。相反，她们还允诺了一个新的时代……"
    }
    {
      Id = "Chronos_1294"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这确实是天大的好消息！尤其是不用担心报仇的事，而且很高兴知道那三位已经从暂时的放逐之中找到了回来的路。但这个{#Emph}新时代{#Prev}又是怎么一回事？"
    }
    {
      Id = "MelinoeField_4373"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……听起来她们好像不打算像之前那样编织得那么频繁了。而且，到了某个时候，据说众神将不会再在凡间的事务上，拥有那么大的话语权……"
    }
    {
      Id = "Chronos_1295"
      InheritFrom = "BaseNarrative"
      DisplayName = "可这简直和{#Emph}我{#Prev}统治的那个黄金时代如出一辙……！也难怪，等你活过亿万年的时间，就会发现事物背后都有循环往复的规律；旧有的事物，转眼便成为新的事物再度兴起。我们的家人对这件事怎么看？"
    }
    {
      Id = "MelinoeField_4374"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得我们都需要考虑一番，不过我们有很多时间。这个时代可能不会很快到来。"
    }
    {
      Id = "Chronos_1296"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许……但就算如此，这个时代亦有可能在你不知不觉中悄然而至。这是经验之谈……"
    }
    {
      Id = "MelinoeField_4375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "时间有时转瞬即逝……"
    }
    {
      Id = "Chronos_1434"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直都很欣赏凡人……命运三女神决定，他们将会有为自己做主的机会，让我很是欣慰。我很期待看到结果如何。"
    }
    {
      Id = "MelinoeField_5074"
      InheritFrom = "BaseNarrative"
      DisplayName = "普罗米修斯一定是希望实现那个共同目标，才想要与你合作。我对凡人的了解，大多来自于亡者……生者有哪些地方值得欣赏呢？"
    }
    {
      Id = "Chronos_1435"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，只是他们很珍惜时间……至少，有些人很珍惜。毕竟，他们活在世上、自由呼吸的时间，实在是少之又少。从某些方面来说，这令人惋惜，但从另一些方面来说，何尝不发人深省啊。"
    }
    {
      Id = "MelinoeField_5075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实看得出他们有这样的品质。"
    }
    {
      Id = "MelinoeField_5071"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，你有没有……有没有感受到过以前那种苦涩与仇恨……？对众神，对你失去的黄金时代，诸如此类的？"
    }
    {
      Id = "Chronos_1432"
      InheritFrom = "BaseNarrative"
      DisplayName = "过往的错误终究无法逆转。相当长一段时间里，那些感受都被我当作执念；以至于我永远无法彻底甩开它们。但是，你给了我这一次机会。"
    }
    {
      Id = "MelinoeField_5072"
      InheritFrom = "BaseNarrative"
      DisplayName = "你当时看起来那么不肯退让，那么坚持你自己的那套理念。有的时候我还是无法相信，仅仅是获得了更好的过去的记忆，就足以让你转变想法。"
    }
    {
      Id = "Chronos_1433"
      InheritFrom = "BaseNarrative"
      DisplayName = "当时的我也很无措。我看着你长大的记忆……那只不过是我的存在中无比微小的一个片段，但却相当重要。有的时候，改变在一瞬间就可以发生。"
    }
    {
      Id = "MelinoeField_5073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那，希望你永远保持现在的样子。"
    }
    {
      Id = "Chronos_1073"
      InheritFrom = "BaseNarrative"
      DisplayName = "……真是无法想象，击败我的任务，差点就落到了你的头上！这件事最终没有发生，真是我的幸运，因为我可没办法轻松抵挡报应化身的攻势；我想不出谁会有那样的本事！"
    }
    {
      Id = "Nemesis_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也想不出，所以你最好别轻举妄动。如果你和王女需要多个人手，帮你收拾你的烂摊子，就跟我说。早就想发挥点作用了。"
    }
    {
      Id = "Chronos_1074"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样说来，我们当前行动的本质，你已经知晓了？有数量繁多的可能性，必须一个个排除。如果你真的愿意帮忙……"
    }
    {
      Id = "Nemesis_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "又有何妨。早就有这个打算了，一路下到塔耳塔罗斯都不是问题，就是进不了冥府。"
    }
    {
      Id = "Chronos_1075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这种小事，对我而言不在话下！"
    }
    {
      Id = "Nemesis_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我洗耳恭听。"
    }
    {
      Id = "Chronos_1030"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好，你终于到了！现在你一丝不苟地走完了曾经的路线，我应当可以操纵时间的轨迹，将你置身于冥府之中，而在你父亲的王座上，会坐着我的一道残迹。准备好了么？"
    }
    {
      Id = "MelinoeField_4128"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，先等等。我赢了会怎么样，输了又会怎么样？你确定这一切真的能奏效么？"
    }
    {
      Id = "Chronos_1031"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，没错，我相当确定！本质上来说，这无异于我所创造的那些水仙花平原的幻象！而你也一样，早已证明挣脱那些临时的束缚，对你来说不过是轻而易举之事。"
    }
    {
      Id = "MelinoeField_4129"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以我要和之前一样进入冥府，用同样的手段解决掉这个克洛诺斯的残迹……然后剩下的就交给你？"
    }
    {
      Id = "Chronos_1032"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是。首先，我在你进入时引发时间的变动，然后里面那个心术不正的我，就任你处置！我们联手，彻底消灭他存在的{#Emph}任何可能！"
    }
    {
      Id = "MelinoeField_4130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好的， 那……我去了！"
    }
    {
      Id = "MelinoeField_4131"
      InheritFrom = "BaseNarrative"
      DisplayName = "先等等。这会和在奥林匹斯山山顶发生的事情一样么？你召唤出另一条原本可能存在的时间线……"
    }
    {
      Id = "Chronos_1034"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，发生的事情会如你所言，至少我希望如此！当然，我们每次如此穿越时间，在其中等待着的，可能都会有细微的差别……"
    }
    {
      Id = "MelinoeField_4134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那好。"
    }
    {
      Id = "Chronos_1046"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，孙女，这会和之前的发展完全一样！你跃入长河之中，而我确保你汇入正确的溪流。"
    }
    {
      Id = "Chronos_1035"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你来了，小孙女。现在你一丝不苟地走完了曾经的路线，我便可以将你移入另一条时间线，在其中魔物提丰的残迹仍然威胁此地。准备好了么？"
    }
    {
      Id = "MelinoeField_4132"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以现在我要纵身一跃，登上山顶，在那里我会找到另一条时间线的提丰和他的爪牙，像以前一样解决掉他们，然后剩下的就交给你？"
    }
    {
      Id = "Chronos_1036"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果一切不出我所料的话，正是如此！我会在你离开时引发时间的变动；找到那个魔物，然后战胜他，如此反复，我们最终就能彻底消灭他存在的{#Emph}任何可能。"
    }
    {
      Id = "MelinoeField_4133"
      InheritFrom = "BaseNarrative"
      DisplayName = "先等等。这会和在冥府发生的事情一样么？你召唤出另一条原本可能存在的时间线……"
    }
    {
      Id = "Chronos_1047"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，孙女，你知道会发生什么！跃向山顶罢，而我会确保你汇入正确的溪流。"
    }
    {
      Id = "MelinoeField_4204"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷……？我们家人们所承受的创伤，或许永远无法真正愈合，但是……至少你已经做出了初步的努力。所以，这是送给你的。"
    }
    {
      Id = "Chronos_1284"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，多好的瓶子啊，谢谢你，小孙女！奥林匹斯的蜜露……不过，看起来确实品质上乘。现在的习俗还是予以某种形式的回礼，对么？那这个就请你收下罢。"
    }
    {
      Id = "Chronos_1285"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你真是太慷慨了。冥府本来有着数目不多的存货，但我当时被仇恨蒙蔽了心智……呃，把它们全砸碎了。这一瓶，我一定会妥善保管。"
    }
    {
      Id = "MelinoeField_4365"
      InheritFrom = "BaseNarrative"
      DisplayName = "请收下吧，别忘了蜜露是用来品尝的。至于你砸碎的那些，瓶子里的蜜露会渗入大地，所以……说不定冥府比之前更敞亮些了。"
    }
    {
      Id = "Chronos_1286"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一瓶的金色光泽……我想象不出比这更美丽的颜色了，真的。在此世，我之前没有意识到，奥林匹斯和我一样喜欢黄金的色泽。不过，你似乎更喜欢白银啊，孙女……"
    }
    {
      Id = "MelinoeField_4366"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，一直都是。我们在月亮与星辰下战斗……白银反射的皎洁光芒，会让我想起它们。不过话说回来，黄金现在会让我想起阿波罗，他很好相处，如果你们还没见过的话。"
    }
    {
      Id = "Chronos_1287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿波罗，那个音乐家。确实像是个很有天赋的小伙子……"
    }
    {
      Id = "Chronos_1288"
      InheritFrom = "BaseNarrative"
      DisplayName = "上回我喝了你之前送的蜜露，哎呦，真是美妙的滋味……随后我便意识到，爷爷我目前的表现，恐怕还不足以赢得被你这样对待的资格罢。"
    }
    {
      Id = "MelinoeField_4367"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是什么资格，只是一件简单的礼物而已。甚至都不是最豪华的那种！你有机会得试试仙馔密酒才行，尤其是考虑到你那么喜欢黄金的色泽。"
    }
    {
      Id = "Chronos_1289"
      InheritFrom = "BaseNarrative"
      DisplayName = "仙馔密酒，是啊……也许未来某个时间，我会有机会和这一大家子人一起分享一瓶仙酒罢。但我知道，那需要相当一段时间的努力才有可能实现。现在就先免了罢，孙女。我们还有太多事务尚待完成。"
    }
    {
      Id = "MelinoeField_4368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，那就留给以后的时间吧。"
    }
    {
      Id = "MelinoeField_4205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是件不同寻常的装置……而且是纯金的。谢谢你。"
    }
    {
      Id = "Chronos_1033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
