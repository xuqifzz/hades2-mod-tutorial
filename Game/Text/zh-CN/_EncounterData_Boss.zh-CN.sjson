    {
      Id = "MelinoeField_0917"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃……你好？"
    }
    {
      Id = "MelinoeField_0918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，停下！站住！"
    }
    {
      Id = "MelinoeField_0919"
      InheritFrom = "BaseSubtitle"
      DisplayName = "三个头……你是……"
    }
    {
      Id = "MelinoeField_1109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "刻耳柏洛斯，真的是你吗？！"
    }
    {
      Id = "MelinoeField_1110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我一定会帮助你的，好狗狗！付出什么代价也在所不辞！"
    }
    {
      Id = "MelinoeField_3532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在你浑身都是岩浆……是敌手之誓导致的吗？"
    }
    {
      Id = "MelinoeField_2566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他走了么……？"
    }
    {
      Id = "MelinoeField_2567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，他没走。冷静下来，刻耳柏洛斯！我们会治好你的……"
    }
    {
      Id = "MelinoeField_4571"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喜欢在这里撒欢，是不是呀？"
    }
    {
      Id = "MelinoeField_4567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我知道你不喜欢洗澡，但是是时候了！"
    }
    {
      Id = "MelinoeField_0920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你是不会让开的，对吗？"
    }
    {
      Id = "MelinoeField_0921"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你觉得你在守护什么，嗯？"
    }
    {
      Id = "MelinoeField_0926"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我承认，你真够警觉的。"
    }
    {
      Id = "MelinoeField_0927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "地狱之门的守卫……"
    }
    {
      Id = "MelinoeField_0923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当心喽……"
    }
    {
      Id = "MelinoeField_4566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，乖狗狗！想再来玩一玩吗？"
    }
    {
      Id = "MelinoeField_4568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又见面了，刻耳柏洛斯！我们开始吧？"
    }
    {
      Id = "MelinoeField_4569"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗨，乖狗狗！我们来吧。"
    }
    {
      Id = "MelinoeField_4570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "作为一只老狗，你还真精神嘛……！"
    }
    {
      Id = "MelinoeField_0922"
      InheritFrom = "BaseSubtitle"
      DisplayName = "抱歉，但我必须通过这里。"
    }
    {
      Id = "MelinoeField_0924"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不怕你……"
    }
    {
      Id = "MelinoeField_0925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别把你的悲痛发泄在我身上！"
    }
    {
      Id = "MelinoeField_4184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "乖狗狗，这对你来说只是玩闹而已吗？"
    }
    {
      Id = "MelinoeField_4183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，乖！我们再来一次，跟之前一样！"
    }
    {
      Id = "MelinoeField_4185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又在泥潭里打滚了吗，乖狗狗？"
    }
    {
