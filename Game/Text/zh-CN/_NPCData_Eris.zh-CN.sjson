    }
    {
      Id = "Eris_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会找到属于自己的路。"
    }
    {
      Id = "Eris_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你确实很需要。"
    }
    {
      Id = "Eris_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随便啦！"
    }
    {
      Id = "Eris_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "怎么了，宝贝？"
    }
    {
      Id = "Eris_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "想我了吗，小麻烦精？我今天心情好，所以就想着飞到你们这边看看，毕竟这里{#Emph}你们这么欢迎我，这里又这么安全{#Prev}，是吧。你最近在忙什么呢？"
    }
    {
      Id = "Melinoe_2419"
      InheritFrom = "BaseNarrative"
      DisplayName = "没在忙什么啦，厄里斯！所以，你是怎么想到要回来的？有一段时间，我还以为你真的决定一走了之了呢。"
    }
    {
      Id = "Eris_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉让你失望咯，但我总不能袖手旁观嘛！尤其是最近发生了这么多事。{#Emph}你{#Prev}这段时间可是{#Emph}忙得很啊{#Prev}，嗯？"
    }
    {
      Id = "Melinoe_2653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "无论你听说了什么，都请你务必保密。"
    }
    {
      Id = "Eris_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "想我了吗，小麻烦精？我今天心情好，所以就想着飞到你们这边看看，毕竟这里{#Emph}你们这么欢迎我，这里又这么安全{#Prev}，不是么？不过，咱俩可是{#Emph}好久{#Prev}没见了呢。"
    }
    {
      Id = "Melinoe_3122"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看还不够久。虽然我很希望你不要再那么不成熟了，厄里斯，但是你会回来这里，唯一的理由就是想要继续胡作非为吧。"
    }
    {
      Id = "Eris_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么，就算你觉得我不是来看望你的，那我来看看我姐难道还不行吗？我懂啦，你还是对我之前拖慢你的脚步这件事心怀芥蒂，不过……我以后不会再这样做了，我发誓。所以，就当咱们和好啦？"
    }
    {
      Id = "Melinoe_3213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那要看你的表现了。"
    }
    {
      Id = "Eris_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "和好啦！"
    }
    {
      Id = "Eris_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道我这次回来的{#Emph}真正{#Prev}原因吧，小麻烦精？是因为事情{#Emph}终于{#Prev}要变得{#Emph}有趣{#Prev}起来了！可是你居然想要结束这一切……！"
    }
    {
      Id = "Melinoe_2421"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不会被你的三言两语动摇决心。相信你除了对我说这些，以及把垃圾丢得到处都是之外，还有更重要的事情去做吧？"
    }
    {
      Id = "Eris_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又知道了？反正我就是{#Emph}有权利{#Prev}赖在这不走，你休想摆脱我！而且你也摆脱不了克洛诺斯啦。事情再也{#Emph}回不去{#Prev}了！"
    }
    {
      Id = "Melinoe_2422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们不是要回到过去，而是要争取更好的未来。"
    }
    {
      Id = "Eris_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "说实话，我真搞不懂你们这些人。一天到晚非要让事情回到以前的样子。尤其是{#Emph}你{#Prev}！你都不知道自己都错过了什么！"
    }
    {
      Id = "Melinoe_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是在努力让事情回到正轨，而不是回到过去。不过，厄里斯，你到底是什么意思？"
    }
    {
      Id = "Eris_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是什么意思？{#Emph}你{#Prev}是什么意思！你们这群人都跟疯了似的，非得要在万事万物里找个{#Emph}“意思”{#Prev}出来，真是{#Emph}没意思{#Prev}！就不能放轻松点，好好享受一下美好时光？"
    }
    {
      Id = "Melinoe_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在现在的形势下，我做不到。"
    }
    {
      Id = "Melinoe_2654"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你……你之前说我都不知道自己错过了什么。这话怎么说？"
    }
    {
      Id = "Eris_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "首先，说的肯定不是你的{#Emph}家人{#Prev}啦！拜托，好好看看你自己。你这辈子一天都没有真正活过！你胸膛里有颗心脏在砰砰直跳，你却只把它当成供血的器官，当成身体里的一块肌肉！"
    }
    {
      Id = "Melinoe_2655"
      InheritFrom = "BaseNarrative"
      DisplayName = "心脏{#Emph}确实{#Prev}是块肌肉。而且你说我一“天”都没有真正活过，那又怎么样？我本来就习惯昼伏夜出。怎么了，难道依你看，在奥林匹斯山有难，冥界彻底失陷的时候，我应该去吃顿好的庆祝一下吗？"
    }
    {
      Id = "Eris_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "这主意不错嘛！但你只想要一切都安然无恙、井然有序、毫无变数——{#Emph}无聊透顶{#Prev}。"
    }
    {
      Id = "Melinoe_2656"
      InheritFrom = "BaseSubtitle"
      DisplayName = "才不是呢。"
    }
    {
      Id = "Eris_0030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你确定吗……？"
    }
    {
      Id = "Melinoe_2657"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着……你有一点说得没错，我确实不知道在克洛诺斯卷土重来之前，世界是个什么样子。你总是暗示那时候比现在还要糟糕。怎么可能呢？"
    }
    {
      Id = "Eris_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就跟你说过了，宝贝！你爸，我妈，还有他们手下的人……整天把人呼来喝去的，压根就没人治得了他们！对我就是管东管西，一点空间都不给。没有奥林匹斯的命，却得了{#Emph}奥林匹斯的病{#Prev}！"
    }
    {
      Id = "Melinoe_2658"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以你宁愿生活在彻头彻尾的混乱中，也不愿在既定的规则下过有序的生活？"
    }
    {
      Id = "Eris_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一针见血！"
    }
    {
      Id = "Eris_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的想知道以前事情是怎么样的吗，小麻烦精？那就想想让你夜复一夜爬出帐篷的动力源泉。是什么让你这样{#Emph}斗志昂扬{#Prev}？说，你想到了什么？"
    }
    {
      Id = "Melinoe_2662"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啊。当然是我在意的人，他们在指望着我。而且，我希望能不断学习，不断精进我的体魄、心灵和意志。"
    }
    {
      Id = "Eris_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "真有志气。现在，想象你已经拥有了想要的一切……所以你丧失了动力，再也不想追求任何东西……"
    }
    {
      Id = "Melinoe_2663"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我想象不到。所以，你是想说，当时除了你，所有人都在沉迷享乐，不思进取？但是现在角色反转了，是吗？"
    }
    {
      Id = "Eris_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "算了，说了你也听不懂。"
    }
    {
      Id = "Eris_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}啊，哈哈！{#Prev}你把我吓得够呛，小麻烦精！怎么一声不吭地就过来了，害得我差点把你打成筛子。劝你以后小心点！"
    }
    {
      Id = "Melinoe_2667"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不喜欢你扛着那东西四处招摇的样子。提醒你一下，免得你不知道：“在训练场之外不许亮出武器”这条规矩仍然生效。"
    }
    {
      Id = "Eris_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“武器”？啊哈！{#Prev}拜托，在你面前的可是狮鹫坚炮耶。就连{#Emph}泰坦{#Prev}都曾被它轰成渣！这是件艺术品。{#Emph}休想{#Prev}把它从我手中夺走！"
    }
    {
      Id = "Melinoe_2668"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有没有打算跟我说说，你当初到底是怎么把它弄到手的？按说它应该是归我{#Emph}父亲{#Prev}保管的……却不知怎的落到了{#Emph}你{#Prev}手里。"
    }
    {
      Id = "Eris_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来他保管东西的水平有待提高！"
    }
    {
      Id = "Eris_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，搞什么啦！狮鹫坚炮变回原样了！我一定是碰到了什么隐藏的开关之类的，可是……它在这里连{#Emph}正常运作{#Prev}都不行，更别提改变形态了！"
    }
    {
      Id = "Melinoe_4275"
      InheritFrom = "BaseNarrative"
      DisplayName = "适可而止吧，厄里斯。虽然你暂时是狮鹫坚炮的持有者，但它并不仅仅会听命于你。就算它允许你瞄准、开火……"
    }
    {
      Id = "Eris_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是它{#Emph}现在{#Prev}允许我瞄准开火就好了！最好别让我发现是你搞的鬼，小麻烦精，或者如果{#Emph}真是你{#Prev}的话……你快给我把它{#Emph}变回去{#Prev}！我喜欢它另一种形态！"
    }
    {
      Id = "Melinoe_4276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "它能听见你说话，你知道的吧。"
    }
    {
      Id = "Melinoe_2669"
      InheritFrom = "BaseNarrative"
      DisplayName = "你为什么非得让这里堆满垃圾，厄里斯？真的要把自己弄得这么不受人待见么？"
    }
    {
      Id = "Eris_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，什么时候我需要别人“待见”我了？你们这些人最喜欢管大地要这要那的。我只是帮你们还点东西回去罢了！"
    }
    {
      Id = "Melinoe_2670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔呃……真有你的……"
    }
    {
      Id = "Melinoe_2671"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说回来，你在这里四处乱丢的到底是什么东西？{#Emph}独眼巨人肉条？{#Prev}你是怎么的，碰巧捡了一仓库，永远也吃不完？"
    }
    {
      Id = "Eris_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你猜怎么着？被你说中了！而且你永远猜不到我是在哪捡来的。这玩意吃着真上头，只要习惯了这个味道，就根本停不下来！你要来点吗？"
    }
    {
      Id = "Melinoe_2672"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不要。"
    }
    {
      Id = "Eris_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不用跟在我屁股后面捡垃圾的，知道的吧。我本来打算找时间自己收拾一下的！而且话说回来，你把那些垃圾捡走，是拿去干什么了？"
    }
    {
      Id = "Melinoe_4231"
      InheritFrom = "BaseNarrative"
      DisplayName = "我把它们交给了残魂商人，他会把我们不再需要的东西收归大地。你也可以自己去嘛……！残魂商人就在那边……"
    }
    {
      Id = "Eris_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，好啦。我不想给人添麻烦嘛！不过也许下次，我会趁你不在的时候翻遍{#Emph}你的{#Prev}东西，然后让那边的残魂商人帮你{#Emph}收归大地{#Prev}！"
    }
    {
      Id = "Melinoe_4232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你敢。"
    }
    {
      Id = "Eris_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "起初我还以为你是误打误撞找到这里来的。但你一而再再而三地来，都多少次了。怎么了，宝贝，有什么事想告诉我吗？"
    }
    {
      Id = "Melinoe_2673"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我……我是被你吸引……被你到处乱扔的垃圾吸引来的！我看你是存心的吧。"
    }
    {
      Id = "Eris_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也太容易上钩了啦。"
    }
    {
      Id = "Melinoe_2674"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你到底为什么在这里？别告诉我是克洛诺斯派你来的。你不希望我成功，这点你表达得很明确。"
    }
    {
      Id = "Eris_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，你的话怎么这样伤人！你根本就不了解我，是不是？我没给{#Emph}你{#Prev}加油助威，并不代表我就非得给{#Emph}那家伙{#Prev}摇旗呐喊啊。"
    }
    {
      Id = "Melinoe_2675"
      InheritFrom = "BaseNarrative"
      DisplayName = "那能不能告诉我，你真正支持的到底是什么人？"
    }
    {
      Id = "Eris_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你就猜去吧。"
    }
    {
      Id = "Melinoe_2681"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你怎么总是一个人回来？你在我眼里从来不算沉默寡言，而且看起来很喜欢和别人打交道呢，虽然打交道的方式有些独特……"
    }
    {
      Id = "Eris_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，宝贝，我的理由说来很奇怪呢，如果我实话告诉你的话，你是不会喜欢的。因此我{#Emph}真的{#Prev}很想告诉你！但转念一想，你也一定{#Emph}真的{#Prev}很想知道，这样一来，我就又{#Emph}不想{#Prev}告诉你了。"
    }
    {
      Id = "Melinoe_2682"
      InheritFrom = "BaseNarrative"
      DisplayName = "反正我大概能确定，你不是由我凭空想象出来的。你知道的吧，就是那种在脑海里窃窃私语，引人走上歧途的幻象。"
    }
    {
      Id = "Eris_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但你真的能{#Emph}百分百{#Prev}确定吗？"
    }
    {
      Id = "Melinoe_2683"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在克洛诺斯和众神间战火纷飞，以至于尸横遍野、民不聊生，这些都是你亲眼所见。可你还是完全不为所动？"
    }
    {
      Id = "Eris_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁说我{#Emph}不为所动{#Prev}？恰恰相反，我都{#Emph}不能自已{#Prev}了。我很想好好活在当下，你是知道的，可是……我有一种预感，等到我回首这段往事时，一定会惆怅地感慨：{#Emph}“那是最好的时代。”"
    }
    {
      Id = "Melinoe_2684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "对你来说是的，对其他人可不是。"
    }
    {
      Id = "Eris_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，所以呢……？"
    }
    {
      Id = "Eris_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真是身在福中不知福啊，小麻烦精。我从小到大，身边从来就没缺过自以为比我更优秀的哥哥姐姐们。看啊，大名鼎鼎的{#Emph}报应{#Prev}就在那边！旁边还有{#Emph}死亡{#Prev}、还有{#Emph}毁灭{#Prev}！压根没有人把什么{#Emph}纷争{#Emph}放在眼里。"
    }
    {
      Id = "Melinoe_2685"
      InheritFrom = "BaseNarrative"
      DisplayName = "其实，摩罗斯说不定比你想象得更能理解你呢。你们这些倪克斯的子女，人们往往唯恐避之不及，但那又如何？你又不需要人人都跟你做朋友，只要有几个至交好友便足够了。更何况，{#Emph}“纷争”{#Prev}这个概念完全归你管，你想怎么定义就怎么定义，是不是？"
    }
    {
      Id = "Eris_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这，这倒没错……"
    }
    {
      Id = "Eris_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，别恨我，好吗？这些事情真的不是我的错啦，虽然我一直向你撒谎、玩弄你的感情、用坚炮轰你、逼你为我捡垃圾、在你背后说你坏话……"
    }
    {
      Id = "Melinoe_3131"
      InheritFrom = "BaseNarrative"
      DisplayName = "说实话，哪怕是这样，我潜意识里还是觉得一定是我自己哪里做得不够好，不过……厄里斯，我不恨你。至少，我对你的感情不完全是恨。不过……你说不是你的错，那又能是谁的错呢？"
    }
    {
      Id = "Eris_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我妈{#Prev}的错！没错，{#Emph}都是{#Prev}倪克斯的错！因为是她把我创造成这样的，我一辈子都无法改变。我本来可以是{#Emph}长寿化身{#Prev}，或者{#Emph}友谊化身{#Prev}！但是，她偏不！而我又没办法改变自己的本性。不管我付出{#Emph}多少{#Prev}努力。"
    }
    {
      Id = "Melinoe_3132"
      InheritFrom = "BaseNarrative"
      DisplayName = "那，你具体是付出了多少努力呢？"
    }
    {
      Id = "Eris_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个嘛，其实没多少啦，目前还没！但是我这次一定会努力的，我发誓！"
    }
    {
      Id = "Melinoe_3133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会为你加油的。"
    }
    {
      Id = "Eris_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}太{#Prev}把这场战争当回事了，就好像{#Emph}天要塌了{#Prev}似的。其实，奥林匹斯众神{#Emph}最喜欢{#Prev}在战场上杀个痛快了！在山上总有战事发生，甚至还有个神专门就是司掌战争的。知道要让他们打起来有多{#Emph}容易{#Prev}吗？"
    }
    {
      Id = "Melinoe_2688"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道呢，厄里斯，所以我洗耳恭听：要我的亲戚们丧失理智、诉诸暴力，到底有多容易？"
    }
    {
      Id = "Eris_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "有一次啊，他们居然为了那么一个金苹果大打出手。没人知道是谁献上的祭品——只说是要{#Emph}“献给最美丽的女神”{#Prev}！然后他们就为谁才是最美的女神争了起来。就这样，矛盾越闹越大，最后就——{#Emph}轰{#Prev}！"
    }
    {
      Id = "Melinoe_2689"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来像是个简单的误会，甚至还有可能是场恶作剧。但照你说的，最后这件事引发了一场战争？那后来又怎么样了？"
    }
    {
      Id = "Eris_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，说来话长……"
    }
    {
      Id = "Eris_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "身为一名经验丰富的战争煽动者，我不得不说……虽然我没有在为克洛诺斯效力，但我得承认，他干出的这番事业真让我由衷地敬佩。"
    }
    {
      Id = "Melinoe_2686"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯……我这辈子恐怕都没听过这么糟糕透顶的话。"
    }
    {
      Id = "Eris_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "你去亲眼看看他做出的成绩——客观地看，然后你就会发现根本无法反驳！"
    }
    {
      Id = "Melinoe_2687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还是算了吧，谢谢……"
    }
    {
      Id = "Eris_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "知道你的问题出在哪吗，小麻烦精？你太嫩了啦。没吃过多少苦，没受过多少挫，是没办法从他人告诉你的事情中抽丝剥茧，提炼出真相的。"
    }
    {
      Id = "Melinoe_2717"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对我的意见我收到了，厄里斯。真是非常有价值的建议。我很遗憾，我只能居住在这座战时的营地里，没法“吃到多少苦”呢。"
    }
    {
      Id = "Eris_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "（倒吸一口气） 你会说反话耶！太好了，我喜欢。宝贝，我就知道你骨子里还是有点狠劲儿的。不许{#Emph}藏着掖着{#Prev}哦！让整个世界都看看，你说起反话来有多嚣张！"
    }
    {
      Id = "Melinoe_2718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随你怎么说……"
    }
    {
      Id = "Eris_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}啧！{#Prev}不不不，是随{#Emph}你{#Prev}怎么说！"
    }
    {
      Id = "Eris_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "被人排挤的感觉，我再熟悉不过了。表面上看过去，每个人都对你{#Emph}面露微笑{#Prev}；可是一个转过身，却纷纷在你{#Emph}背后插刀{#Prev}。无论怎样，我希望你知道……他们背后对你的那些评价，我一个字都不信。"
    }
    {
      Id = "Melinoe_2719"
      InheritFrom = "BaseNarrative"
      DisplayName = "好的。所以你口中的“他们”究竟是谁？能不能举个“背后插刀”的例子，说来让我听听？"
    }
    {
      Id = "Eris_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，就是……就是奥德修斯和赫卡忒啦。真是难以置信，他们居然觉得你会{#Emph}失败{#Prev}，还说你缺少那种{#Emph}精神{#Prev}……！我不希望你成功，这不假，可是……我从来不会当面一套、背后一套！"
    }
    {
      Id = "Melinoe_2720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你这是在挑拨离间。"
    }
    {
      Id = "Eris_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我这是在帮你！"
    }
    {
      Id = "Eris_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说你去地表了！还吸了几口地表的新鲜空气。所以说哎，你是怎么突发奇想要往那里跑的？还以为你一心一意要扳倒克洛诺斯呢！"
    }
    {
      Id = "Melinoe_2721"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得是时候换换风景、换换心情了。不过，你自己怎么没有到地表去？那里如今的状况，应该会让你很兴奋才对。"
    }
    {
      Id = "Eris_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来确实很激动人心！但是，我估计去了也只会碍事啦。听说阿瑞斯已经把所有事情安排妥当了！{#Emph}想一想哎{#Prev}，在这种时候身为司管战争的神明，真是{#Emph}酷毙了{#Prev}！"
    }
    {
      Id = "Melinoe_2722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是他全家人都在危难之中……"
    }
    {
      Id = "Eris_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……那又怎样？"
    }
    {
      Id = "Eris_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想明白了！你这样一趟趟往地表跑，是要去{#Emph}奥林匹斯山{#Prev}啊！去救你的家人，去阻止那里的战事！被我说中了吧？"
    }
    {
      Id = "Melinoe_2723"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你误会了，我去地表只是采集炼金材料，真的。主要是苔藓，再加一点青铜之类的。很实用的！至于奥林匹斯众神嘛，他们最擅长照顾自己，用不着我操心啦。"
    }
    {
      Id = "Eris_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "可不是么。而且他们那么骄傲，谅他们也不会寻求你的帮助。总之，你去{#Emph}“采苔藓”{#Prev}的时候，别坏了阿瑞斯的好事就行。他最近可真是{#Emph}杀疯了{#Prev}！"
    }
    {
      Id = "Melinoe_2724"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来你和战神的关系和以前一样好嘛。他最近忙得很，是不是？"
    }
    {
      Id = "Eris_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是当然！"
    }
    {
      Id = "Eris_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，那个，宝贝？我给你搞了点东西来……就是一点点心意啦，所以也别太当回事……拿去！因为你一直像蜜露一样甜美。"
    }
    {
      Id = "Melinoe_2804"
      InheritFrom = "BaseNarrative"
      DisplayName = "一瓶蜜露……谢谢你，厄里斯。不过，我们这样做是打破传统了哎。要是我们就这样，把这一瓶蜜露送来送去，那然后呢？"
    }
    {
      Id = "Eris_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "然后就会让传统{#Emph}土崩瓦解！"
    }
    {
      Id = "Melinoe_3124"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这个叛徒！你怎么敢与我和我们的大业为敌？而且事后还有脸再出现在这里！你就等着因为你的所作所为被逐出这里吧！"
    }
    {
      Id = "Eris_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉哦，宝贝，没人能赶我走。多亏了倪克斯、赫卡忒和她们那{#Emph}牢不可破的誓言{#Prev}！还有，你真的完全误会了我的良苦用心。"
    }
    {
      Id = "Melinoe_3125"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦？难道是我看错了，实际上是{#Emph}另一个{#Prev}倪克斯的女儿拿着狮鹫坚炮对我狂轰滥炸？"
    }
    {
      Id = "Eris_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，是我没错啦，而且我玩得很开心！但我你要叫我“叛徒”，那我可有意见了。我以为我早就说清楚了，我从来就不是你这一边的。"
    }
    {
      Id = "Melinoe_3126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那你就是克洛诺斯的走狗！"
    }
    {
      Id = "Eris_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊哈哈哈，随你怎么说！"
    }
    {
      Id = "Eris_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "吼吼，宝贝，你知道吗？你在外面比我想象得还要能打！当时狮鹫坚炮热得烫手，我差点就受不了了！"
    }
    {
      Id = "Melinoe_3127"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴能为你提供消遣。所以，这一切对于你来说，只是找个乐子吗？你置我们大家的生死存亡与不顾，就为了追求这种庸俗的刺激？"
    }
    {
      Id = "Eris_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "别装啦，我不信你在那里的时候，自己心里没有感觉到一丝刺激。而现在你尝过了刺激的滋味后，你就想要{#Emph}更多{#Prev}，不是么？"
    }
    {
      Id = "Melinoe_3128"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只想要让你滚出三岔路口，而且别再挡我的路。"
    }
    {
      Id = "Eris_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵，那你就想去吧……"
    }
    {
      Id = "Melinoe_3129"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就是你想要的吗，厄里斯？一次又一次与我无谓地交手，然后又回到这里互相冷眼相看？你也太有追求了。"
    }
    {
      Id = "Eris_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么时候轮到{#Emph}你{#Prev}说别人有没有追求了？不过，你说的也没错！事到如今，我对发生的{#Emph}一切{#Prev}都挺满意的！太好玩了，真的！"
    }
    {
      Id = "Melinoe_3130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是岂有此理。"
    }
    {
      Id = "Eris_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "多谢夸奖，小麻烦精！"
    }
    {
      Id = "Eris_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，我真以为上次要被你拿下了。但是……看来你还是差了那么一点呀。也许下一次吧。你现在不能对我还以颜色，一定要气疯了吧。"
    }
    {
      Id = "Melinoe_3214"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算我能，我也不会打破这里的宁静的，厄里斯。但你真的在挑战我自制力的极限。下一次在裂谷的尽头见到你，我决不会手下留情。"
    }
    {
      Id = "Eris_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喔，她{#Emph}生气{#Prev}了！我就喜欢这样的。"
    }
    {
      Id = "Eris_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "又被你堂堂正正地打败了，小麻烦精。已经好几次了！我越发觉得有点力不从心了，你知道么？"
    }
    {
      Id = "Melinoe_3215"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，真可怜。我真应该为你加油打气，这样你之后才能振作起来，拿出十二分力气对付我。"
    }
    {
      Id = "Eris_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "趁我失意的时候取笑我，好，我记住了。等到你自己遭遇挫折、一筹莫展的时候，可别指望靠在我肩膀上哭鼻子。{#Emph}给我滚远点！"
    }
    {
      Id = "Melinoe_3216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘁。"
    }
    {
      Id = "Eris_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到你昨晚居然放我鸽子，小麻烦精！你这样太侮辱人了！害我孤身一人，半夜三更，坐在海滩边上苦苦等了你那么久……"
    }
    {
      Id = "Melinoe_4236"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？我不记得我们有约定啊，不然的话我一定不会食言。你真的以为我会弃任务于不顾，只为了跟你一天到晚打来打去吗？"
    }
    {
      Id = "Eris_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为你对我有感觉呢……还以为我们在海滩上度过的时光，在你心中会比无聊的任务更特别一点。看来，是我想错了……"
    }
    {
      Id = "Melinoe_4237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是你想错了。"
    }
    {
      Id = "Eris_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "有一段时间没在地表见到你了耶，宝贝。我本来觉得也没什么好说的，但都过了这么久了，让我感觉你好像在{#Emph}故意针对我{#Prev}哎，你懂我意思吗？"
    }
    {
      Id = "Melinoe_4238"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你有没有考虑过一种可能，当我在冥界执行任务的时候，压根就没有想过你的事情……？"
    }
    {
      Id = "Eris_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们都是这么跟我说的。但你知道{#Emph}我{#Prev}是怎么想的吗？我觉得你是{#Emph}害怕{#Prev}了。不仅仅是害怕我，而且还害怕直面你内心的情感。好嘛！想要继续逃避，你就往冥界跑吧。"
    }
    {
      Id = "Melinoe_4239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我到底为什么要来找你说话？"
    }
    {
      Id = "Eris_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "为了伤害我们两个的感情咯……"
    }
    {
      Id = "Eris_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“昨天晚上干得好呀，宝贝！”{#Prev}是不是想听这句话？算你倒霉，因为{#Emph}我{#Prev}是不会对你这么说的。除了刚才那一次啦。"
    }
    {
      Id = "Melinoe_4205"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你这样一说，我确实觉得你要是时不时能鼓励一下我的话，我会很开心，但我知道这和你为人处事的方式不太相符。我只是来看看你。"
    }
    {
      Id = "Eris_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，谢谢你哦！每当你完成一件重要的事情，我都感觉心口像是被你{#Emph}捅了一刀{#Prev}。不过，很高兴知道你还会回来确认一下我是不是{#Emph}死透了{#Prev}！"
    }
    {
      Id = "Melinoe_4206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，别给自己加戏了。"
    }
    {
      Id = "Eris_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}闭嘴！"
    }
    {
      Id = "Eris_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们说昨晚你单枪匹马就干掉了提丰。距离让一切回到正轨又近了一步，是不是？"
    }
    {
      Id = "Melinoe_4207"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是单枪匹马干掉他的，但我们确实打败了他，这点没错。不过我觉得，近期你都不用担心事情回到正轨……"
    }
    {
      Id = "Eris_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你是在安慰我啦，但我就是有这种感觉嘛！我应该趁着这一切还没有结束，好好享受才对！未来是有可能无聊透顶啦，但现在？现在一切都好。"
    }
    {
      Id = "Melinoe_4208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在才不是“一切都好”。"
    }
    {
      Id = "Melinoe_4362"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，怎么了？你……你是在哭吗？"
    }
    {
      Id = "Eris_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}才没有！{#Prev}哼……就算我在哭，那又怎么样，哈？反正你又不在乎我！这个该死的地方每个人都是这样，你也不例外。"
    }
    {
      Id = "Melinoe_4363"
      InheritFrom = "BaseNarrative"
      DisplayName = "得了吧。如果你收敛上哪怕一丁点，别在三岔路口见谁惹谁，也许你就会有更多伙伴了。只有我一直傻傻地相信你会改变。"
    }
    {
      Id = "Eris_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又不是我的伙伴。没人是！没有和我亲近的人……没有能依靠的人……能分享秘密的人……"
    }
    {
      Id = "Melinoe_4364"
      InheritFrom = "BaseNarrative"
      DisplayName = "这……如果你需要找人倾诉的话，我不会背叛你的信任。只要你倾诉的内容不会让我在意的其他人置身危险之中。"
    }
    {
      Id = "Eris_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "啧。你在意的其他人。我和他们能一样么？拜托，宝贝，我们可是一见面就大打出手哎！虽然我完全不介意啦！但是一段关系不该仅仅是这样而已。"
    }
    {
      Id = "Melinoe_4365"
      InheritFrom = "BaseNarrative"
      DisplayName = "我之前跟你说过了，有话直说就好。你动不动就给我使绊子，还指望我们之间能有哪种关系？"
    }
    {
      Id = "Eris_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有的时候真是蠢得可以！听着，我没办法控制我的感受，也读不懂别人的心思。不管我有什么毛病，都改不掉了。"
    }
    {
      Id = "Melinoe_4366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你怎么能这么笃定？"
    }
    {
      Id = "Eris_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就是能！"
    }
    {
      Id = "Melinoe_4369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "厄里斯……！"
    }
    {
      Id = "Melinoe_4502"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，说起来，之前那一夜，我们……我是想说，你还好吧？我也不知道我在说什么……"
    }
    {
      Id = "Eris_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，{#Emph}停。{#Prev}你说过你对我无怨无悔。很可能是在骗自己啦，但还是提醒你一下。我们找了点乐子，那又怎么了？"
    }
    {
      Id = "Melinoe_4503"
      InheritFrom = "BaseNarrative"
      DisplayName = "可能我只是还不适应你{#Emph}找乐子{#Prev}的方式吧。我有很多别的事情要考虑。"
    }
    {
      Id = "Eris_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "你{#Emph}以后{#Prev}也会考虑的！但如果你不给生命留出搞点乱子的空间，那事情会变得很乏味的。我保证。"
    }
    {
      Id = "Melinoe_4504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "乱子？我们不是在说乐子吗。"
    }
    {
      Id = "Eris_0288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一个意思啦。"
    }
    {
      Id = "Eris_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，停。虽然我是很喜欢逗你没错，但你这副可怜兮兮的样子我一点也受不了。怎么，你是担心伤到我的小小感情，还是说后悔自己做的决定了？"
    }
    {
      Id = "Melinoe_4505"
      InheritFrom = "BaseNarrative"
      DisplayName = "主要是前者。如果我真的赢得了你的信任，我不希望就这么把它毁掉，哪怕发生了那样的事。"
    }
    {
      Id = "Eris_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你把你的嘴闭上就好！根本不是什么大事，除非你非要翻来覆去地说，好吗？"
    }
    {
      Id = "Melinoe_4506"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好。"
    }
    {
      Id = "Eris_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在这里真是人见人爱耶，宝贝。涅涅和摩罗斯看你的眼神，我都看到了！怎么说，是不是终于该跟他们{#Emph}公布{#Prev}我们的事了？"
    }
    {
      Id = "Melinoe_4507"
      InheritFrom = "BaseNarrative"
      DisplayName = "别这样，厄里斯。我们说好的，不做认真的承诺，还记得么？只是你的家人普遍都很有魅力，况且身为神明，我们有用不完的时间。尤其是等这一切结束之后。"
    }
    {
      Id = "Eris_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个嘛，大概吧！假设这一切真的会结束，而且不会发生什么更糟的事！总之我只是逗一下你啦。我喜欢你这么好欺负的样子……！"
    }
    {
      Id = "Melinoe_4510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你是什么意思？"
    }
    {
      Id = "Eris_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你看，我就是{#Emph}这个意思！"
    }
    {
      Id = "Eris_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你和克洛诺斯到底是怎么回事？你就{#Emph}一个劲地{#Prev}打他，他就{#Emph}一个劲地{#Prev}复活！听起来毫无意义，这点我很喜欢，但是……真相肯定不止这么简单，对吧？"
    }
    {
      Id = "Melinoe_4357"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，厄里斯，我才不会把我任务的关键和盘托出呢，何况你有过那么多机会帮忙，却非要跟我们对着干。你还是管好你自己的事吧。"
    }
    {
      Id = "Eris_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "或者你给我一点小提示也行。你是打算借助他自己的力量打败他吗？还是说把我们的家人一个个救出来？有被我说中吗？"
    }
    {
      Id = "Melinoe_4358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不告诉你！"
    }
    {
      Id = "Eris_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}坏人！"
    }
    {
      Id = "Eris_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说昨晚奥林匹斯山上动静很大耶！多亏了你啊，害我没凑上热闹。所以，怎么样，有意思吗？"
    }
    {
      Id = "Melinoe_4359"
      InheritFrom = "BaseNarrative"
      DisplayName = "那可太有意思了！众魔之父要把目之所及的一切都毁掉，而我在引他分心的时候，差点被他囫囵吞下去！你错过真是太可惜了。"
    }
    {
      Id = "Eris_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，宝贝，当有人错过什么大事的时候，应该安慰对方才对！比如你可以说：“哎呀其实也就那样啦！”不然的话，人家会感到很{#Emph}难过{#Prev}的！"
    }
    {
      Id = "Melinoe_4360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你{#Emph}确实{#Prev}该感到难过。"
    }
    {
      Id = "Eris_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哼，我{#Emph}偏不！"
    }
    {
      Id = "Melinoe_2659"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对我们努力争取的事情嗤之以鼻，就好像你自己什么都没有失去一样。你难道不想再见到倪克斯吗？还有塔纳托斯？"
    }
    {
      Id = "Eris_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "我难道不想再见到我妈吗？还有我那不知道排到老几的哥哥？噗哈哈哈，当然不想。他们甚至比你都更加自命不凡。{#Emph}无意冒犯。"
    }
    {
      Id = "Melinoe_2660"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你怎么能这样说自己的家人？他们当初到底把你怎么了，让你这么冷酷无情？"
    }
    {
      Id = "Eris_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "倪克斯总想要事情按{#Emph}她{#Prev}的想法发展。凭什么我要让她的想法，或者任何人的想法，凌驾在{#Emph}我{#Prev}之上？就凭她把我{#Emph}生{#Prev}了出来？她生我又没有征得{#Emph}我{#Prev}的同意，我做事自然也不用她同意。"
    }
    {
      Id = "Melinoe_2661"
      InheritFrom = "BaseSubtitle"
      DisplayName = "抱歉……"
    }
    {
      Id = "Eris_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你对倪克斯有什么看法？你见到她了，对吧？现在你知道涅墨西斯的外表，以及{#Emph}我{#Prev}的性格，都是遗传自谁的了。"
    }
    {
      Id = "Melinoe_4924"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？我几乎没什么了解她的机会，但就算这样，倪克斯看起来也跟你完全不一样啊。她很优雅。"
    }
    {
      Id = "Eris_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，拐着弯夸我呢，谢谢你哦，宝贝。但在那冰冷的外表下，她也有狂野的一面，我发誓。要不然她怎么能自己一个人生出这么一大窝来？丧心病狂好吧！"
    }
    {
      Id = "Melinoe_4925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可能丧心病狂的只有你吧。"
    }
    {
      Id = "Melinoe_2664"
      InheritFrom = "BaseNarrative"
      DisplayName = "你都不再和老师说话了，是么？相比之下，她和涅墨西斯的关系看上去都显得健康了许多。"
    }
    {
      Id = "Eris_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "她可是说了{#Emph}一大堆{#Prev}关于我的坏话呢，宝贝。而且不只是当面说。这一切都是因为我没有成为{#Emph}她眼中{#Prev}的{#Emph}明星学徒{#Prev}！所以我就不理她咯。真的，这种人还是不要出现在我的生命里为好。"
    }
    {
      Id = "Melinoe_2665"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯，你三番五次偷窃她的东西；不知悔改地用炼金釜制作炸药、还用我的帐篷当靶子；趁修普诺斯熟睡时在他脸上乱涂乱画；故意把盐撒在花园里；还不停骚扰暗灵们，问他们到底是怎么死的……"
    }
    {
      Id = "Eris_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，大小姐，谁都像你一样完美啊！我不过是犯了几个年少无知的错嘛。那也轮不到赫卡忒来教育我，而且还是{#Emph}私下{#Prev}教育，害得我都没法当着你们的面夸耀我的事迹。一大半你听都没听过呢！"
    }
    {
      Id = "Melinoe_2666"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她给你下了沉默魔咒，是不是？"
    }
    {
      Id = "Eris_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有可能耶……"
    }
    {
      Id = "Eris_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近{#Emph}真的{#Prev}把涅涅惹毛了哎！有好几次我看她跟你说完话没多久，就气鼓鼓地冲了出去，哐啷哐啷的。你到底跟她说了什么，让她这么激动？我得记下来，以后我也这么对付她。"
    }
    {
      Id = "Melinoe_2677"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道呢。我们时不时会谈到我的任务，而她想要尽她所能帮助我。我觉得她只是非常希望我们的计划能够成功。"
    }
    {
      Id = "Eris_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我懂啦！你们这些女巫永远要留一手，是吧？那我就不多问了，不过听我一句劝，跟我姐打交道的时候当心点。她可不是那种甘于{#Emph}屈居人后{#Prev}的人！"
    }
    {
      Id = "Melinoe_2678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实不是。"
    }
    {
      Id = "Eris_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "再让我听见你和摩罗斯聊的那些东西，我非得吐一地不行。不过，那样你也会帮我打扫干净的，对吧？"
    }
    {
      Id = "Melinoe_2676"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟别人说话的时候，请你不要偷听。更何况你听得都要吐了！你那么想知道你哥要说什么的话，不如自己抽点时间去和他聊聊。"
    }
    {
      Id = "Eris_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我更想要看看，他假装看不见我，到底能假装多久。"
    }
    {
      Id = "Melinoe_4233"
      InheritFrom = "BaseNarrative"
      DisplayName = "你回来这里已经有一段时间了，但还是这么独来独往的。你哥哥则是在努力融入这里，不过他也遇到了一些困难……也许你们两个之间的共同点比你想象得要多呢。"
    }
    {
      Id = "Eris_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，真的吗？要不我现在就过去，把你说的这番话原封不动转达给他！怎么着，你觉得就因为全世界讨厌他的程度跟讨厌我的程度不相上下，我们就算是{#Emph}有共同点{#Emph}了？"
    }
    {
      Id = "Melinoe_4234"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，我完全不是这个意思……不过我确实觉得，这个世界对你们两个都有着相似的误解。"
    }
    {
      Id = "Eris_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "有什么可误解的？我是{#Emph}纷争{#Prev}，他是{#Emph}毁灭{#Prev}。都是很简单的概念嘛，宝贝！不过话又说回来，这个世界大多数人都蠢得很，这倒没错……"
    }
    {
      Id = "Melinoe_4235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你不该这样说的。"
    }
    {
      Id = "Eris_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不该实话实说吗？"
    }
    {
      Id = "Eris_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，修普诺斯{#Emph}走了{#Prev}吗？我本来对他有个大计划呢，计划包含整整一袋子的猫，以及你送给我的几瓶蜜露。"
    }
    {
      Id = "Melinoe_4939"
      InheritFrom = "BaseNarrative"
      DisplayName = "那看来我是拯救了他，帮他避免了某种可怕的命运。也许等以后有机会了他会好好谢我吧，他走的时候实在有点匆忙。"
    }
    {
      Id = "Eris_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你下次去到色萨利裂谷，不如让我杀了你，这样说不定你就会顺着冥河漂流而下，最后漂到他面前，你看怎么样？他是冥府门口的迎宾员，不是么？"
    }
    {
      Id = "Melinoe_4940"
      InheritFrom = "BaseNarrative"
      DisplayName = "他才不是什么“迎宾员”。他的职位非常光荣。"
    }
    {
      Id = "Eris_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}“欢迎来到冥王圣殿！”{#Prev}他就是个迎宾员，宝贝。"
    }
    {
      Id = "Eris_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个赫拉克勒斯看上去确实{#Emph}挺唬人的{#Prev}，是不是？真可惜他光长肌肉了，没怎么长脑子。被他剥了皮披着到处走的那只狮子，活着的时候恐怕都比他要聪明。"
    }
    {
      Id = "Melinoe_2679"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么这么说？虽然我知道你一贯喜欢在背后说人坏话。在我看来，赫拉克勒斯一点都不蠢，或许只是看清了这个世界的真实面目而已。"
    }
    {
      Id = "Eris_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "他手里的那根棒槌替他把该想的都想了，而且很多时候把该说的也都说了。哎，你们两个半斤八两啦！也许这就是你这么看得起他的原因。还是说，你就喜欢他这一款……？"
    }
    {
      Id = "Melinoe_2680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘁，才不是……！"
    }
    {
      Id = "Eris_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔呃，我还在为昨晚的事不爽呢。你什么时候变得这么强了？我在你面前一点机会都没有。嘿，你想跟我去别处呆会儿，陪我消消气吗？"
    }
    {
      Id = "Melinoe_4491"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有点不放心耶。在小酒馆的话，至少旁边有很多目击者，以防万一你对我打什么歪主意。"
    }
    {
      Id = "Eris_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，你有什么好怕的？真{#Emph}打起来{#Prev}你又不是打不过我！总之，也不是很远啦，我发誓。"
    }
    {
      Id = "Melinoe_4493"
      InheritFrom = "BaseNarrative"
      DisplayName = "……等等，就是这里吗？你说“不是很远”，居然不是在开玩笑。这里有什么特别的？"
    }
    {
      Id = "Eris_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是单纯喜欢这里啦。没有青蛙乱叫，也没有暗灵乱飘……要是我们干点坏事的话，不会有人发现呢……"
    }
    {
      Id = "Melinoe_4494"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说“干点坏事”，是指……{#Emph}哦{#Prev}，这个嘛，厄里斯，呃，我现在还没准备好做任何认真的承诺。"
    }
    {
      Id = "Eris_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "宝贝，我这{#Emph}一辈子{#Prev}都没做过什么“认真的承诺”。我只是想偶尔找点乐子嘛，毕竟昨晚忙着要把你轰成渣，累得要死要活的！你说呢？"
    }
    {
      Id = "Melinoe_4496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别这样。"
    }
    {
      Id = "Eris_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}嗷……"
    }
    {
      Id = "Melinoe_4501"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}呼唔……"
    }
    {
      Id = "Melinoe_4495"
      InheritFrom = "BaseNarrative"
      DisplayName = "你愿意开口，对我来说真的意义重大，因为我知道在这里要变得跟任何人亲近都不容易。但我现在不想做这样的事。我们之间的关系……我渐渐喜欢上现在这样了，所以还是希望能维持原状。"
    }
    {
      Id = "Eris_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我{#Prev}也是这么想的啊！以及我懂你意思啦，只要这是{#Emph}你自己{#Prev}想要的，而不是其他人想要你做的就好。不过，我还是要去跟别人说我们在这干了坏事——你不会介意的，对吧？"
    }
    {
      Id = "Melinoe_4497"
      InheritFrom = "BaseNarrative"
      DisplayName = "……虽然我们之间的关系之中，有很多事可能值得后悔，但真相是，我对此无怨无悔。更何况……我喜欢在错误中学习。"
    }
    {
      Id = "Melinoe_4498"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！总的来说，感觉我今晚学到了很多。不过，我大概该回去啦。有人问起来的话，就说我们去钓鱼栈桥了。"
    }
    {
      Id = "Eris_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们{#Emph}就是{#Prev}来钓鱼栈桥了啊，宝贝。而且，别人问什么又有什么所谓？{#Emph}谁在乎嘛！{#Prev}我们只是开心了一下而已！难道这里连开心都不许吗？"
    }
    {
      Id = "Melinoe_4499"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有啦。所以现在你又变回原样了，还是那个每晚都想把我轰成渣的你，就好像什么也没发生一样？"
    }
    {
      Id = "Eris_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错！怎么，你以为我会被你迷得七荤八素，放弃一切让我成为{#Emph}我{#Prev}的东西吗？拜托啦。我们说好的，不做认真的承诺，还记得吗？"
    }
    {
      Id = "Melinoe_4500"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……虽然这样说可能听起来有点像凡人，但是……厄里斯，有的时候我真的读不懂你。你怎么能这么……无忧无虑。"
    }
    {
      Id = "Eris_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "告诉你个小秘密哦，宝贝：越是读不懂、越是得不到，我们就越是会心生向往。反正{#Emph}我{#Prev}总是拿这句话当借口啦！回头见喔！"
    }
    {
      Id = "Eris_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "我警告你，你最好适可而止，小麻烦精。先是去惹{#Emph}克洛诺斯{#Prev}，然后又去惹{#Emph}提丰{#Prev}，弄得一切都全乱套了！这应该是{#Emph}我的活{#Prev}才对！"
    }
    {
      Id = "Melinoe_4911"
      InheritFrom = "BaseNarrative"
      DisplayName = "你该干的显然都干完了。我是在扭转你的影响。就好像我经常在这里帮你收拾垃圾一样。"
    }
    {
      Id = "Eris_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你休想得逞。就算真让你得逞了，你也肯定会追悔莫及，因为事情就再也不会像现在这样{#Emph}有趣{#Prev}了！"
    }
    {
      Id = "Melinoe_4912"
      InheritFrom = "BaseNarrative"
