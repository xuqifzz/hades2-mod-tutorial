    }
    {
      Id = "Eris_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近你好像有点不对劲欸，宝贝！但你是不会告诉我的，所以我就直接猜了。是赫卡忒的事吗？我打赌是这样，因为她最近也有点不对劲。"
