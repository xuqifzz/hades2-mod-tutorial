    }
    {
      Id = "Eris_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "小麻烦精，咱们两个闹到现在这个地步，我也不想的啦。"
    }
    {
      Id = "Eris_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到涅涅的话，帮我跟她说一声，我{#Emph}真的{#Prev}很想跟她说说话，好吗？"
    }
    {
      Id = "Eris_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算像你这样永生不朽的女神，生活的节奏也这么快呢，是不是，小麻烦精？"
