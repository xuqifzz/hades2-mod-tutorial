    }
    {
      Id = "Eris_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "我泡得超爽，宝贝。而且你看看，我的翅膀现在多干净！不会一直保持这样啦，但……还是很不错。"
    }
    {
      Id = "Melinoe_3553"
      InheritFrom = "BaseNarrative"
