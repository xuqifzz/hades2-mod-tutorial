    }
    {
      Id = "Eris_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "这可是你教我的，你知道吗，小麻烦精？虽然我其实不会真的学到什么啦，但是……如果我不对自己精益求精的话，也许到了未来某一天，一切真的会{#Emph}好起来{#Prev}……"
    }
    {
      Id = "Melinoe_4923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那{#Emph}怎么行{#Prev}呢。"
