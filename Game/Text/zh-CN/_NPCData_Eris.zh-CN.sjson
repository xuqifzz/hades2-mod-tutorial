    }
    {
      Id = "Eris_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃……我感觉我刚才喝的洗澡水可能{#Emph}太{#Prev}多了点。被净化原来就是这种感觉吗？呼！"
    }
    {
      Id = "Melinoe_3479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，厄里斯……"
