    }
    {
      Id = "Eris_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "快告诉我这不是真的，小麻烦精！克洛诺斯的事，他真的不干了？而且还把倪克斯和其他人都放了？你、你到底对他做了什么？！"
    }
    {
      Id = "Melinoe_4913"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和过去的哥哥合作，让我们祖父的脑海中涌现了许多记忆；他意识到他一直都有个家，因此性情发生了翻天覆地的变化。怎么了，你在担心什么？"
    }
    {
      Id = "Eris_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "我担心你把这一切都毁了！所以现在我们要面对和平、安宁、欢快的家族聚会、道歉，以及“永远不会再让这种事发生”的承诺？！唉！"
    }
    {
      Id = "Melinoe_4914"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有见过我们的家人吗，厄里斯？哪有你说得那么简单啦。"
    }
    {
      Id = "Eris_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最好是这样，要不我就{#Emph}再也{#Prev}不原谅你了！"
    }
    {
      Id = "Eris_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，你还呆在这个垃圾堆里干什么？既然你爸妈重新掌权了，那你应该回去跟他们住在塔耳塔罗斯才对啊。他们真的那么让人讨厌吗？"
    }
    {
      Id = "Melinoe_4915"
      InheritFrom = "BaseNarrative"
      DisplayName = "才不是！虽然我生在塔耳塔罗斯，但这里才是我的家，以及我的责任所在。而且，三岔路口才不是什么{#Emph}“垃圾堆”{#Prev}，至少你管好你自己的垃圾就不会是。"
    }
    {
      Id = "Eris_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "随你怎么说！不过至少这在这整件事里算是个好消息。我原本真的以为我要失去你了，宝贝。"
