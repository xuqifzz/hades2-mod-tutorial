    {
      Id = "Melinoe_4292"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，想再去泡一次温泉吗？你上次看起来很享受，我也感觉获益良多。"
    }
    {
      Id = "Eris_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇， {#Emph}获益良多{#Prev}耶！听着，我是不会为随便哪个人打湿翅膀的，宝贝，但你很特别。所以，咱们走吧？"
    }
    {
      Id = "Melinoe_4293"
      InheritFrom = "BaseNarrative"
      DisplayName = "……有这么多兄弟姐妹是种什么感觉？我只有一个哥哥，而且我在成长的过程中和他都不认识。不过，我还是经常会跟他说心里话，就好像他是我想象出来的朋友。"
    }
    {
      Id = "Eris_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的兄弟姐妹越多，你能给别人带来的失望也就越深！而且记不起来他们名字的时候可尴尬了。看看我们这些倪克斯的子女之间的关系你就明白了。能比我们家还乱的，也就你们家了！"
