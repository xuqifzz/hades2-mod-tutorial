      InheritFrom = "BaseSubtitle"
      DisplayName = "一点儿也没有。"
    }
    {
      Id = "Eris_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯最近兴高采烈的，至少以他的标准来说。所以你终于找着他的姐姐们了，是吗？那你也{#Emph}太幸运{#Prev}了！她们照理说也是我的姐姐，可我见都没见过。"
    }
    {
      Id = "Melinoe_4928"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许我在她们身上看到了你的影子，厄里斯。以她们过往的工作来判断的话，她们似乎很重视即兴发挥……或者说，率性而为。"
    }
    {
      Id = "Eris_0401"
