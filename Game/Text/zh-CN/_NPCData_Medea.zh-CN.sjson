  lang = "zh-CN"
  Texts = [
    {
      Id = "MelinoeField_3500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}我见你聚集死者无数，栖身于阴冷幽冥……"
    }
    {
      Id = "MelinoeField_4334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没问题。{#Emph}雪上加霜{#Prev}，是么？"
    }
    {
      Id = "MelinoeField_4339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来……很强力。"
    }
    {
      Id = "MelinoeField_3814"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您，美狄亚女士。"
    }
    {
      Id = "MelinoeField_3950"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是当然。"
    }
    {
      Id = "MelinoeField_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿明月指引您，女士。"
    }
    {
      Id = "MelinoeField_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "克洛诺斯必死无疑，女士。"
    }
    {
      Id = "Medea_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一同闪耀。"
    }
    {
      Id = "Medea_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "今夜是个诅咒弥漫之夜。"
    }
    {
      Id = "Medea_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿黑暗指引你。"
    }
    {
      Id = "Medea_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你好。"
    }
    {
      Id = "Medea_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他必将不得好死。"
    }
    {
      Id = "Medea_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也一样。"
    }
    {
      Id = "Medea_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "承蒙塞勒涅的恩泽。"
    }
    {
      Id = "Medea_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她一定会的。"
    }
    {
      Id = "Medea_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明月，或者血腥的味道。"
    }
    {
      Id = "Medea_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定会的。"
    }
    {
      Id = "Medea_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "托你的福，女术士。"
    }
    {
      Id = "Medea_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你能来是我的荣幸。"
    }
    {
      Id = "Medea_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "你好啊，女术士！欢迎来到埃费拉城。凄苦的景象在这里比比皆是，今晚更是散发着格外不祥的气息。真叫人触目惊心，不是么？"
    }
    {
      Id = "MelinoeField_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确如此，美狄亚女士。可惜我不能在这片凄苦中久留，因为奥林匹斯山在召唤我。不过说起来，您的研究进展如何？"
    }
    {
      Id = "Medea_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我{#Emph}巴不得{#Prev}让你见识见识呢！这里的空气嘛，毋庸置疑是剧毒的。至于这里的条件，那就只能用“穷凶极恶”来形容了！一睹我的成果吧……"
    }
    {
      Id = "Medea_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，女术士回来了。还没受够这里腐烂的气息么？还是说你只是还没成功突破泰坦的重围？"
    }
    {
      Id = "MelinoeField_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还没成功。克洛诺斯补充兵力的速度不在奥林匹斯山杀敌的速度之下。您有发现他手下兵卒的任何弱点吗？"
    }
    {
      Id = "Medea_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们无法被永远杀死，面对最猛的毒药都几乎不受影响，而且一心侍奉它们的泰坦王。有哪一条听起来像是弱点的么？"
    }
    {
      Id = "MelinoeField_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "您在这里住了有多久了，美狄亚女士？我以为在城市被占领之后，我们的势力就全部逃离了这里，但您看起来在这里还挺怡然自得的。"
    }
    {
      Id = "Medea_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，的确！死亡和恐惧在这里大行其道，为我腾出了栖身之所。我在城市陷落后不久循着阴影潜入了进来，然后便留在了这里，一边钻研巫术，一边观察敌人的动向……赫卡忒大人的眼线在地表可是{#Emph}无处不在{#Prev}……"
    }
    {
      Id = "Medea_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真得好好感谢你，女术士！上次你在城里大闹一顿之后，我便采集到了你的血样。哦，里面蕴藏的魔力强大得很！"
    }
    {
      Id = "MelinoeField_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，不客气，美狄亚女士。不过，下次您再要用我的鲜血做实验原料的话，可以先征得我的同意吗？"
    }
    {
      Id = "Medea_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "要不，我还是该用就用，只不过以后再也不告诉你了，你看如何？别怕，我只会用它促成我们共同的目标！"
    }
    {
      Id = "Medea_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的巫术可谓博大精深，不是么，女术士？你在赫卡忒大人的教导下学到了很多，但恐怕对于{#Emph}我{#Prev}所精通的领域，你仍然知之甚少……"
    }
    {
      Id = "MelinoeField_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "您说得对，我的经验远远不如您丰富，美狄亚女士。我没怎么接触过凡人……我是指活着的凡人。"
    }
    {
      Id = "Medea_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近，我自己也很少能接触到活着的凡人了。他们很容易就会受到旁敲侧击的煽动；再不济的话，在食物或饮料中下点药也能让他们乖乖就范。"
    }
    {
      Id = "MelinoeField_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的暗灵……他们被困在自己在阳世腐烂的躯壳中了，不是么？因此无法前往我父亲的领域。"
    }
    {
      Id = "Medea_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错！这可是死灵魔法的{#Emph}重大突破{#Prev}！这些摇摇晃晃的可怜虫，被困在将死而未死的边界……我可以月复一月不知疲倦地研究他们！"
    }
    {
      Id = "MelinoeField_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "您总是这样孜孜不倦地钻研巫术，美狄亚女士。我想问一下，您夜以继日进行学术研究的动力是从哪来的？"
    }
    {
      Id = "Medea_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一点很直截了当，女术士。我想要惩罚所有冒犯过我的人，以眼还眼，以牙还牙。不过，不用害怕，你的名字不在我的任何一份名单上！"
    }
    {
      Id = "MelinoeField_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "冒犯过您的人如此多，以至于一份名单都列不下了，需要好几份名单吗？等到他们统统被您诅咒过后，您又有什么打算？"
    }
    {
      Id = "Medea_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的名单是按冒犯的程度来分类的；从云淡风轻的不喜，到刻骨铭心的背叛。至于之后的打算……先等我把他们诅咒完再说吧。"
    }
    {
      Id = "MelinoeField_4714"
      InheritFrom = "BaseNarrative"
      DisplayName = "您有没有感觉诅咒让您空虚过，美狄亚女士？当我屈从于黑暗的想法时，最开始的冲动一过去，后续的感觉往往就会让我很不好受。"
    }
    {
      Id = "Medea_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，让自己感觉空虚，不正是这门炼药学问的意义所在吗，女术士。感受到空虚，便是感受到宁静。这是我们最接近凡人的死亡的方式。"
    }
    {
      Id = "MelinoeField_4715"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解您的意思，可是……我更希望感到满足，或者快乐，或者兴奋，而不是……什么也感受不到。感觉和直觉驱动着我们。"
    }
    {
      Id = "Medea_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "驱动着我们摆脱它们。我就时时刻刻在剥离自己的情感。感到仇恨？施展咒语。感到饥饿？摄入食物。感到欲望？……如此种种。每一种不适，都有化解之法。"
    }
    {
      Id = "Medea_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你之前说过，你对我抱以信任。我想让你知道，这对我意义非凡。近来从没有人对我这样说过……就连赫卡忒大人，也会与我保持一定的距离。"
    }
    {
      Id = "MelinoeField_4720"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，这肯定跟您总是独自一人从事研究有关。三岔路口很欢迎您，而且很安全，只要您愿意，随时都可以过来。"
    }
    {
      Id = "Medea_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我不需要人陪伴。一想到被活人和死人团团围住的感觉，我的胃里就一阵翻涌。但你和其他绝大多数人不同；有{#Emph}你{#Prev}在旁边，并不会让我介意。"
    }
    {
      Id = "MelinoeField_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "您知道么，在这片恐惧与绝望之中，见到您让我很欣喜，美狄亚女士。很高兴我现在对您了解得更多了一些。"
    }
    {
      Id = "Medea_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "在说了解我之前，你最好三思，女术士。你不过是知道我的名声，然后因为我看起来没有传言说的那样残忍而感到惊奇。但是，最毒辣的残忍，往往有着最精明的伪装……"
    }
    {
      Id = "MelinoeField_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "我无意冒犯您。我不是想说我已经很了解您了，只是想说我很期待与您碰面。至于您的名声，我不在乎其他人是怎么评价我们的。"
    }
    {
      Id = "Medea_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你或许应该多在乎一些，因为人们惧怕我们是有原因的。而且，还有些人等着背叛我们，污蔑我们的名声，甚至干出更卑鄙的事来。听我一句劝：对你的信任，要仔细斟酌。"
    }
    {
      Id = "MelinoeField_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的诅咒对我有莫大的帮助，美狄亚女士。不过，要是我能像您一样乐观就好了。您总是面带微笑，哪怕在这样的地方也一样。"
    }
    {
      Id = "Medea_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "有什么好不满意的呢？这里有源源不断的鲜血供我的研究取用，而亡者也足够明智，知道对我退避三舍。现在，来吧，让我们再施展一道诅咒，你就万事俱备了！"
    }
    {
      Id = "Medea_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "许多事物都随着时间改变了。现在我已经很少见到像你这样友善的面孔了；敌对的面孔也一样。有太多人无法理解我们的巫术之道。"
    }
    {
      Id = "MelinoeField_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "您看起来总是有办法迫使他们理解，美狄亚女士。不过，您会不会怀念与活人为伍的生活？"
    }
    {
      Id = "Medea_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那个时候，为我的研究获取活体样本会容易些，不过除此之外，我并不怀念那种生活。几个真心相交的好友远胜过千百个佯装友好的陌生人。"
    }
    {
      Id = "MelinoeField_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "您总是孤身一人，美狄亚女士。您没有亲人或爱人能够陪伴您开展这些……实验么？"
    }
    {
      Id = "Medea_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，某种意义上来说，他们正陪伴着我呢：他们的亡魂，或者他们的记忆。但你为什么觉得“孤身一人”是种有待改善的状态呢？人偶尔会希望有人陪伴，这不假；但这一类冲动总有以其他方式满足的办法。"
    }
    {
      Id = "MelinoeField_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "您一定对凡人有非常多的了解——他们的生老病死，如此种种。至少，您应该有找到一些办法缓解他们离世时的痛苦吧？"
    }
    {
      Id = "Medea_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我做那种事又是何苦？赫卡忒大人常言道：“最好的老师就是{#Emph}外面的世界{#Prev}。”痛苦的过程就是学习的过程！我只不过是想让自己变成一名优秀的老师而已。"
    }
    {
      Id = "MelinoeField_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡人那些悲痛欲绝的哭喊完全无法博得您的同情，或者至少让您发一发慈悲么？那样的声音总会让我内心不安。"
    }
    {
      Id = "Medea_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "久而久之就充耳不闻了。没有哪个凡人拥有长生不老的权利！当然，肯定有人擅长缓解他人死亡时的痛苦；但我所求的不过是了解痛苦的缘由。"
    }
    {
      Id = "MelinoeField_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的咒语为什么威力如此强大，美狄亚女士？有许多诅咒都能伤人于无形，但您的诅咒可谓是杀人不眨眼……"
    }
    {
      Id = "Medea_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "精妙的诅咒需要合适的材料，以及不折不扣的纯粹意图。哪怕是一丁点迟疑、一丁点犹豫，都会折损诅咒的效果。"
    }
    {
      Id = "MelinoeField_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点我明白……对我来说，难点在于提炼出纯粹的恶念。究竟要怎么样才能把如此邪恶的念头加诸他人，而完全不担心遭到反噬？"
    }
    {
      Id = "Medea_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然是要勤加练习了，女术士！恶念确实常常会反噬其主，威力往往还会更胜一筹。但黑暗到极致的恶念……便再无反射任何色彩的可能。"
    }
    {
      Id = "MelinoeField_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "再次感谢您的礼物，美狄亚女士。这撮羊毛很独特，不是么……而且柔软得出奇！"
    }
    {
      Id = "Medea_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "你带着我送给你的黑羊毛！它曾经闪耀着太阳般的金色光辉。但我自作主张，对它做了些手脚，让它能更好地为你我这样的女术士所用……"
    }
    {
      Id = "Medea_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "近来我这里听到一些让人{#Emph}完全无法接受{#Prev}的风声，说的是奥林匹斯山现在面对的麻烦！你一直在往那边赶……那里发生了什么？"
    }
    {
      Id = "MelinoeField_3808"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果那“风声”说的是有一个古老而庞大的魔物，和泰坦大军双管齐下，想要将奥林匹斯山碾作齑粉……那它不止是风声。"
    }
    {
      Id = "Medea_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，天哪。那我知道你所说的魔物是哪个了。而你打算挑战他，以及其他所有妖魔鬼怪？你彻底疯了，女术士……！不过整个世界恐怕都是如此。"
    }
    {
      Id = "Medea_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，要面对如此灾难性的时代，以及这一桩桩的悲剧！真是令人刻骨铭心的夜晚。而你要在这样的夜晚，前往被众神称作家园的受诅之地——告诉我，你的旅行进展如何？"
    }
    {
      Id = "MelinoeField_3935"
      InheritFrom = "BaseNarrative"
      DisplayName = "可以说是奇遇连连。您炼制的药剂在路上派上了很大用场。我原本还以为，像这样的魔法一次只能有一个目标呢。"
    }
    {
      Id = "Medea_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "等你达到了一定境界，整个世界在你的怒火面前，都可以视作同一个目标。继续练习吧，女术士！供我们练手的敌人多得是。"
    }
    {
      Id = "Medea_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人在如此黯淡无光的夜晚过得如何？她已经很久未曾大驾光临此地了……"
    }
    {
      Id = "MelinoeField_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师看起来还不错。我从未见过有什么困难能打击到她。不过，也许她之所以戴着她的面纱，就是为了从不对人展露半点迟疑。"
    }
    {
      Id = "Medea_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都有自己的面纱，不是么，女术士？赫卡忒大人只不过是毫不掩饰这一点罢了。总之，我很高兴听到她仍然是老样子。而我也会在这里继续为她尽我的绵薄之力。"
    }
    {
      Id = "Medea_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "对了，我要提醒你，最好不要跟那个披着狮鬃，时不时在街上出没的大块头有什么来往……"
    }
    {
      Id = "MelinoeField_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "您指的一定是赫拉克勒斯吧。我已经见过他了，而且看出来了我应该保持距离。他说他为众神效力……但他是个威胁吗？"
    }
    {
      Id = "Medea_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，他只是爱摆臭脸！每次我治好他身上的伤，他都会又把自己弄得伤痕累累的，而他心灵的创伤就连{#Emph}我{#Prev}都无力医治。就连死人都比他更有精神。好了，不说他了！我还有诅咒要炼制呢。"
    }
    {
      Id = "Medea_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "家庭的概念真是荒谬至极，女术士。怎么会有人觉得，只因为流淌着相同的血液，彼此之间就会有天然的连结呢？你见过我的姑妈喀耳刻；你有看出来我们哪里相像了吗？"
    }
    {
      Id = "MelinoeField_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻前辈看起来和你一样潜心于巫术的研究，只是研究的方式不同，美狄亚女士。您是真的很不愿意接受您和她有什么相同点么？"
    }
    {
      Id = "Medea_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻从来不愿意涉足禁忌的深渊，探求巫术的极限。她会把活人变成动物，而{#Emph}我{#Prev}会把活人变成死人。也许诚如你所言，只是研究的方式不同吧……"
    }
    {
      Id = "MelinoeField_3813"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，修普诺斯大人仍然在三岔路口沉睡。我试过对他用梦雾，但是没有效果。也许你能想到什么更强力的东西？"
    }
    {
      Id = "Medea_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，你可以把梦雾做得更强力啊，女术士！亡者吸上一口几乎都能复活的那种。至于对那位沉眠的倪克斯之子有没有效果，谁说得准呢？不过试一试总无妨！"
    }
    {
      Id = "MelinoeField_3948"
      InheritFrom = "BaseNarrative"
      DisplayName = "您的强效梦雾帮助我进入了修普诺斯大人更深层的梦境，但不幸的是，就算这样也还不够。他仍然在睡梦中虚度光阴。有什么别的值得一试的办法么？"
    }
    {
      Id = "Medea_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，永远都有办法的。也许需要动动手脚，调整一下他的思维结构。你有试过反复用刀捅他吗？"
    }
    {
      Id = "MelinoeField_3949"
      InheritFrom = "BaseNarrative"
      DisplayName = "我目前的思路更注重他与他的哥哥——死亡化身——之间的联系。有没有什么办法能把梦雾和死亡的精华融为一体？"
    }
    {
      Id = "Medea_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，当然，睡梦和死亡二者，向来是一体两面。我应该能为你指出一条明路！记得跟我说说进展如何……？"
    }
    {
      Id = "MelinoeField_4231"
      InheritFrom = "BaseNarrative"
      DisplayName = "我唤醒他了，美狄亚女士！我是说，我唤醒了修普诺斯大人。谢谢您在梦雾这种物质上为我提供的大量帮助。冥府欠您一大笔人情。"
    }
    {
      Id = "Medea_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是个让人心情舒畅的好消息！我别无所求，只希望冥界的大门再多敞开一段时间。我与亡者之间，还有许多事物尚待探索……"
    }
    {
      Id = "Medea_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！你身上闪耀着阿波罗本尊的光芒！不过，可别以为这里只有他才能降下一场像样的瘟疫哦。"
    }
    {
      Id = "MelinoeField_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗确实涉猎广泛。所以说，他有的时候会对凡人降下瘟疫？你知道他这样做的原因吗？"
    }
    {
      Id = "Medea_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神做事什么时候需要原因了？不都是一时兴起嘛！此外，时不时来一场瘟疫也有助于让牲口乖乖听话。"
    }
    {
      Id = "Medea_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我判断无误的话，辉煌的赫拉将她的力量赐予了你。你是她的家人，而且还为她挺身而出。也许她会格外照顾你吧！"
    }
    {
      Id = "MelinoeField_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "她迄今为止都很照顾我。我知道众神有能力自顾，但我和她现在应该可以说达成了些共识，而且也有共同的利益。"
    }
    {
      Id = "Medea_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "共同的利益。说得好，跟众神打交道就要有这样的认识！不过，对于我的帮助，你不必如此防备。毕竟，那是赫卡忒大人的旨意。"
    }
    {
      Id = "Medea_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，银白之颅勒瓦尔，显现出了我自己的形态。自从我驾驭那无羁的愤怒以来，已经过去了许多日夜。这位女士大体上能与你达成共识吧？"
    }
    {
      Id = "MelinoeField_3936"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，不过……您口中的银白之颅，仿佛是一个活生生的人，而不是一件武器或是工具。即使是现在，面对暗夜武器时，我也时常会混淆这两个概念。"
    }
    {
      Id = "Medea_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗夜武器拥有繁多的名号；依我看，她们并不在意如何被你称呼。她们所嗜好的是{#Emph}灵魂{#Prev}，而不是得体的社交礼仪。所以，替我让她满足一番口腹之欲吧。"
    }
    {
      Id = "Medea_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "你所携带的那件器物……是勒瓦尔！但她却换上了我梦中所见之人的形态。所以，是我告诉你的那道咒语起了效果……你还有什么发现？"
    }
    {
      Id = "MelinoeField_3937"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是一位名为海拉的女神所拥有的形态，她统治着某个遥远的冥界，那里漫天冰雪，寒冷无比。至于她是如何拥有勒瓦尔的，这点就无从得知了。"
    }
    {
      Id = "Medea_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来这位海拉女神很有品味嘛！或许在未来某个阴冷的夜晚，会是我将银白之颅的摄人力量揭晓给她……！又又或许，那个人会是{#Emph}你！"
    }
    {
      Id = "Medea_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "女术士，亡者被你吸引的样子，我可是亲眼所见！就连勒瓦尔的头颅，都要对你顶礼膜拜、百般顺从！实际上，我最近还梦到了她……"
    }
    {
      Id = "MelinoeField_3498"
      InheritFrom = "BaseNarrative"
      DisplayName = "在所有的暗夜武器中，勒瓦尔和亡者的连接应该是最为紧密的了。你梦到了什么？"
    }
    {
      Id = "Medea_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "我梦中所见的景象令我脊髓发凉。我身处冥界之中，但不是我们所知的那个冥界！那里寒冷无比……而且王位上坐着的，是一位狠戾的女王；显然不是你的母亲。而她对我开口说道：{#Emph}“我见你聚集死者无数，栖身于阴冷幽冥。”"
    }
    {
      Id = "MelinoeField_3499"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“我见你聚集死者无数，栖身于阴冷幽冥。”{#Prev}她一定是给了你一道唤醒咒语！她会不会以为你仍然是银白之颅的持有者？"
    }
    {
      Id = "Medea_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看未必……因为在梦中我们见到的持有者是{#Emph}你{#Prev}，而不是我。我与她的缘分目前已经告一段落，而你与她的故事，或许才刚刚开始……"
    }
    {
      Id = "Medea_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到我做的那场关于勒瓦尔的梦……你有试过念诵我给你的那道咒语么？"
    }
    {
      Id = "MelinoeField_3946"
      InheritFrom = "BaseNarrative"
      DisplayName = "还没有，美狄亚女士……还没有确定它的具体效果，所以我在银辉之池前要念诵咒语时会有些迟疑。"
    }
    {
      Id = "Medea_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "勇敢些，女术士。所谓实验精神，就是拥有接受无法预知的结果的勇气。记住了，咒语是这样的：{#Emph}“我见你聚集死者无数，栖身于阴冷幽冥。”{#Prev}放心啦，应该没事的！"
    }
    {
      Id = "MelinoeField_3811"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士，那些四处矗立的晶石是干什么用的？它们控制着通往港口的屏障，这部分我能看得出来。也许泰坦的军团是在用它们协调进攻？"
    }
    {
      Id = "Medea_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们是极为扭曲的思维的产物。把那么多暗灵关在那么狭小的地方，从中汲取他们的魂魄！你能想象么，女术士？"
    }
    {
      Id = "MelinoeField_3812"
      InheritFrom = "BaseNarrative"
      DisplayName = "太可怕了！我没意识到晶石居然是这样运作的。但到底是谁在修复它们？就连{#Emph}你这里{#Prev}都有一座！"
    }
    {
      Id = "Medea_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些骇人的东西就是{#Emph}不肯消失！{#Prev}每晚都会重新聚成实体！不过我在炼金釜旁边要做的事情太多了，几乎都顾不上管它们……"
    }
    {
      Id = "Medea_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人告诉我，你经常会穿过哀悼原野。我有一件事想拜托你，虽然提出这样的要求让我很痛苦，但有一方药剂，我非得炼成不可。"
    }
    {
      Id = "MelinoeField_4332"
      InheritFrom = "BaseNarrative"
      DisplayName = "但说无妨，美狄亚女士。您需要我找到什么，又想达成什么样的目的？"
    }
    {
      Id = "Medea_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "我需要弥留在那里的悲惨亡魂留下的泪水形成的蒸汽。如果你能以我的名义收集到一些泪珠，然后在炼金釜里提炼出精华，我会无比感激。"
    }
    {
      Id = "MelinoeField_4333"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，等您拿到这些悲伤的精华，能够制成什么样的药剂呢？"
    }
    {
      Id = "Medea_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "制成的药剂，对你和我都会大有裨益。当然，也不必为了我特地大费周章。"
    }
    {
      Id = "Medea_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，很好，你来得正是时候。你为我带来的那些泪珠，对我这段时间的研究来说，真是画龙点睛之笔。很高兴能为你提供一份样本，如果你想要的话？"
    }
    {
      Id = "Medea_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要害怕，女术士，至少在这里不用害怕我。在埃费拉城的门外，每当你念出誓言时，我都会来考验你的决心；但在这个我称之为“药房”的地方，我所做的只是测试我药剂的效用这类事情。"
    }
    {
      Id = "MelinoeField_3809"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你与我交手时一副苦大仇深的样子，美狄亚女士。如果我有哪里得罪了你，还希望你能告诉我。"
    }
    {
      Id = "Medea_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪有的事！我只是希望你不要在{#Emph}任何人{#Prev}面前疏于防备。此外，像{#Emph}我们{#Prev}这样的人都不会在意是否被人{#Emph}得罪{#Prev}。我们只会在意{#Emph}得到{#Prev}了什么——比如你的鲜血。"
    }
    {
      Id = "Medea_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "黑夜的意志再度召唤我……多么令人反胃，我在这里诅咒我们的敌人，片刻之后却要加入他们的队伍，和那个令人胆寒的独眼巨人并肩作战！"
    }
    {
      Id = "MelinoeField_3810"
      InheritFrom = "BaseNarrative"
      DisplayName = "你为我提供的这些诅咒可能会对{#Emph}他{#Prev}产生负面影响……但应该影响不到你。不过，诅咒殃及自身的事情，不应该很常见么？"
    }
    {
      Id = "Medea_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "业余之人的诅咒显然如此，但{#Emph}我的{#Prev}嘛？呵呵呵呵呵，绝无可能。啊，至少这应该很有教育意义！一会儿在城门外见。"
    }
    {
      Id = "Medea_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "女术士啊，话说回来，你和独眼巨人波吕斐摩斯非要争个高低，到底是为了什么？看你们打起来确实让我有些激动，但我还是想要知晓个中缘由。"
    }
    {
      Id = "MelinoeField_3933"
      InheritFrom = "BaseNarrative"
      DisplayName = "根本就没有缘由！我第一次想要离开城镇的时候，他就挡在那里。自那以后，他就一直想把我吃掉。他一定是在为克洛诺斯效力……或者至少在某段时间如此。"
    }
    {
      Id = "Medea_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "他不过是个牧羊人。也许是你碰巧在他饿肚子的时候遇到了他；换做是谁，饿肚子的时候都容易发脾气。不过，做你该做的就好！只有誓言所迫时，我才会出手干预。"
    }
    {
      Id = "Medea_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "决定暂时撤销敌手之誓，是么？我完全没有意见。虽然战斗的快感令我沉醉，但能在这里不受打扰也是极好的。"
    }
    {
      Id = "MelinoeField_3934"
      InheritFrom = "BaseNarrative"
      DisplayName = "波吕斐摩斯一定很想念你。您和他能相处得那么融洽，还是让我感觉很震惊……难以想象你们到底有什么共同语言。"
    }
    {
      Id = "Medea_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，恐怕你确实无法想象……不过，他没有必要那么频繁地见到我。他是个牧羊人，因此他颇具耐心。你很可能会再次立下誓言，因此我们三个早晚会有机会{#Emph}再聚一聚{#Prev}的。"
    }
    {
      Id = "Medea_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "请原谅我的凝视，女术士，但你显然在路上受了不少苦……也许你会愿意让我快速采集一些你的血样？"
    }
    {
      Id = "MelinoeField_3947"
      InheritFrom = "BaseNarrative"
      DisplayName = "还是先免了吧，美狄亚女士。我这一夜的开头已经够糟糕了。但愿我能找到补救的办法。"
    }
    {
      Id = "Medea_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，那就依你吧。总之，我们的敌人很快就会遭受更多的苦难；希望这能让你感到些许慰藉。"
    }
    {
      Id = "Medea_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "多数修习巫术之人，都会谴责我的实验，或是至少不屑与我为伍。但你不一样，女术士。你的气魄令我很是欣赏。"
    }
    {
      Id = "MelinoeField_3940"
      InheritFrom = "BaseNarrative"
      DisplayName = "您所说的的实验轮不到我来评断。倘若妄加指责，岂不是跟那群误解巫术本质的人没有区别。"
    }
    {
      Id = "Medea_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，几乎人人都因为恐惧我们的报复，而不敢接近我们，这点还让我挺享受的。或许长远来看这样弊大于利，但在现在的情况下，至少我可以不受打扰地开展实验。不过，这里的门永远会为你敞开，这点你无需担心。"
    }
    {
      Id = "Medea_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人慷慨地将你最近的战果告知了我，女术士。但凡是这世间任何其他生灵跟我说，我都一个字也不会相信。所以说，泰坦王真的被你拔掉了毒牙？"
    }
    {
      Id = "MelinoeField_4229"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来是这样的，美狄亚女士。而且盘踞在奥林匹斯山顶的那只魔物也死了。这两个威胁都还有一些残余的迹象，但我们处理起来应该不成问题。"
    }
    {
      Id = "Medea_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来你处理{#Emph}什么{#Prev}都不成问题啊。我唯一担心的是，这可能会让我们无法再像这样频繁相见，以及……我会不会很快就得撤出埃费拉城？等到凡人搬进来，这座城独特的魅力，恐怕就要化为乌有了……"
    }
    {
      Id = "MelinoeField_4230"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个暂时不需要担心。冥界还需要很长时间才能回到过去的样子；亡者只能在这里继续徘徊一段时间了。"
    }
    {
      Id = "Medea_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那真是{#Emph}糟糕透顶！{#Prev}当然了，是对亡者来说。至于我嘛，真是的……{#Emph}我{#Prev}都不知道接下来该去{#Emph}诅咒{#Prev}谁了！"
    }
    {
      Id = "Medea_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人还没有告诉过我，你是对泰坦王施了什么，才让他“幡然醒悟”的。仅凭诅咒绝对无法做到……她还有许多东西没有教给我啊。"
    }
    {
      Id = "MelinoeField_4723"
      InheritFrom = "BaseNarrative"
      DisplayName = "不过，就像她常说的那样：“最好的老师是外面的世界。”对吧？但其实我也有同感。虽然我认识老师已经这么久了，但她身上有很多地方，我还是完全无法理解。"
    }
    {
      Id = "Medea_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们身居暗影之中，因而必须如此。不过有一点让我很安心：如果我某天真的感到孤独——凡人众叛亲离时感受到的那种，令人痛苦、悲哀的孤独……到那时，我还可以向她寻求慰藉，又或者向你。"
    }
    {
      Id = "Medea_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里游荡的暗灵比上次我来的时候多了很多嘛！而且还有一股大地的馨香，和上次也大不相同。三岔路口真是改头换面了啊！"
    }
    {
      Id = "Melinoe_2510"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎回来，美狄亚女士。敢问您来这里有何贵干？您会在这里住一段时间吗？"
    }
    {
      Id = "Medea_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "不了，我可是赫卡忒在地表的耳目呢。不过夜色尚早，我跟那边的残魂商人还有事情要谈；我有大量的骨骸等着和他交换。地上或者地下再见咯，女术士。"
    }
    {
      Id = "Melinoe_1256_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见。"
    }
    {
      Id = "Medea_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是今晚有一道恐怖的诅咒降到我们敌人的头上，那该是多么不幸……"
    }
    {
      Id = "Medea_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "面对那些企图加害我们的人，绝对不要心怀怜悯，女术士。"
    }
    {
      Id = "Medea_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们无法保证所有的敌人都不得好死，但这仍然是值得追求的目标。"
    }
    {
      Id = "Medea_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "噩运有无数种降临的形式，而你需要的只是做个选择。"
    }
    {
      Id = "Medea_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这样孤独的夜晚，炼制一道穷凶极恶的诅咒再合适不过了。"
    }
    {
      Id = "Medea_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "你早晚有一天会爱上我的毒药的，女术士。"
    }
    {
      Id = "Medea_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "一起为我们的敌人降下诅咒，让他们饱受痛苦的煎熬吧。"
    }
    {
      Id = "Medea_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "要怎么样才能让敌人们乖乖就范？让我们一起找出答案吧。"
    }
    {
      Id = "Medea_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你想要让痛苦和折磨蔓延开去，那你就来对地方了。"
    }
    {
      Id = "Medea_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "抵御诅咒的不二法门：以彼之道，还施彼身。"
    }
    {
      Id = "Medea_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "该让敌人领略一下纯粹的恐惧了。"
    }
    {
      Id = "Medea_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于胆敢与我们为敌的人，我们呼出的空气便足以置之于死地。"
    }
    {
      Id = "Medea_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的意志与影响将蔓延开去，犹如爆发的瘟疫。"
    }
    {
      Id = "Medea_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "奉劝你不要在这里逗留太久，免得被副作用波及到了。"
    }
    {
      Id = "Medea_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "苦难有千万种形式，但每一种都将为我所用。"
    }
    {
      Id = "Medea_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "不拿出些残暴的手段来，都对不起今晚的夜色，不是么？"
    }
    {
      Id = "Medea_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎回到死城，愿你无需在此长留。"
    }
    {
      Id = "Medea_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一个{#Emph}格外{#Prev}骇人听闻的点子，今天非得试试不可。如果你没意见的话？"
    }
    {
      Id = "Medea_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "与我一起再去散播些病痛吧，如何？"
    }
    {
      Id = "Medea_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "为达目的，总要有所牺牲，女术士。"
    }
    {
      Id = "Medea_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿我们的敌人悉数凋零……那些我们不喜欢的人也一样。"
    }
    {
      Id = "Medea_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又为你准备了几个不堪入耳的亵渎诅咒哦。"
    }
    {
      Id = "Medea_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们对敌人越是心怀憎恨，施下的诅咒就越是强大。"
    }
    {
      Id = "Medea_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然你拥有天上众神的赐福，但我能给你的，他们可提供不了。"
    }
    {
      Id = "Medea_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒大人把你教得很好，但如果有敌人胆敢碰你一根汗毛，我就一定要他好看。"
    }
    {
      Id = "Medea_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜的空气{#Emph}如此令人窒息{#Prev}，我几乎都没有听到你的脚步声，女术士！"
    }
    {
      Id = "Medea_0564"
      InheritFrom = "BaseNarrative"
      DisplayName = "等我们降下诅咒之后，那些亡者便会渴望坟茔的安宁。"
    }
    {
      Id = "Medea_0565"
      InheritFrom = "BaseNarrative"
      DisplayName = "月光晦暗，黑夜寒冷，而亡者在大地中翻腾——无可挑剔！"
    }
    {
      Id = "Medea_0566"
      InheritFrom = "BaseNarrative"
      DisplayName = "瓢泼大雨虽说会妨碍我炼药，但也能让这里平添几分恶毒。"
    }
    {
      Id = "Medea_0567"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是无比令人恐惧的夜晚！这样的工作环境正合我意。"
    }
    {
      Id = "Medea_0568"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的小小药房中的补给有限，因为我只会用最新鲜的配方……"
    }
    {
      Id = "Medea_0569"
      InheritFrom = "BaseNarrative"
      DisplayName = "在外面要看好自己的后背，免得被人捅个透心凉啊，女术士。"
    }
    {
      Id = "MelinoeField_4338"
      InheritFrom = "BaseNarrative"
      DisplayName = "这应该就是您需要的：哀悼原野采集到的泪珠，炼制而成的一瓶蒸汽。愿您对其善加利用。"
    }
    {
      Id = "Medea_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，就是这个！这里面凝聚的悲伤，简直多得难以想象。它很快就能派上用场。真是太感谢你了！"
    }
    {
      Id = "Melinoe_3303"
      InheritFrom = "BaseNarrative"
      DisplayName = "知道有您确保冒犯我们的人夜夜悔不当初，我都几乎要可怜他们了，美狄亚女士。请收下这份礼物吧，这是我的一点心意。"
    }
    {
      Id = "Medea_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神的蜜露！啊，这将会为我的工作提供无与伦比的助力。因为最恶毒的诅咒，恰恰总是出自甜言蜜语！来吧，这个你拿去，聊表谢意。"
    }
    {
      Id = "Medea_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "又有一瓶蜜露要送给我吗？哦，用这个来与几种远更令人不快的配料互补堪称完美，它们的熏人气味一定会被掩盖得天衣无缝！"
    }
    {
      Id = "Melinoe_3300"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不敢想象您打算炼制什么样的魔药，但我相信您会将它用于我们共同的目标。"
    }
    {
      Id = "Medea_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "女术士，你的才华溢于言表，毋庸置疑；但实话实说，我曾以为你的善心只会成为你前进路上的绊脚石。现在看来，也许……我当初想错了。"
    }
    {
      Id = "Melinoe_3301"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢您对我的信任。我始终不愿置他人的声音于不顾，以免自己一意孤行，走上歧途。至少，我是这么告诫自己的……"
    }
    {
      Id = "Medea_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯众神并不以仁爱著称。但你作为他们的血亲，居然愿意对我如此慷慨，只因为我履行了对赫卡忒大人的诺言？真的不必多此一举；我除了诅咒之外，也无以为报了。"
    }
    {
      Id = "Melinoe_3302"
      InheritFrom = "BaseNarrative"
      DisplayName = "您所拥有的远不止诅咒而已，美狄亚女士。也许奥林匹斯众神和那些亡者从没有告诉过你这点，但我对此深信不疑。"
    }
    {
      Id = "Medea_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "这甜美的气息再不收敛的话，只怕会坏了我的好事……！我可不能站在炼金釜旁边施法，满脑子却想着这些愉快之事。想想看会发生什么！"
    }
    {
      Id = "MelinoeField_3938"
      InheritFrom = "BaseNarrative"
      DisplayName = "不难想呀。您是我认识的最强大的女巫之一。您的实力高深莫测；想必其所能达成的效果也不会拘于一格。"
    }
    {
      Id = "Medea_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "反复发生的善举往往会引发我最深的怀疑，抑或是愤怒。不过对你而言……我能侦测到你的心思并不复杂，而且确无害人之心。总之，我现在用于炼药的蜜露已经远超所需了，谢谢你。"
    }
    {
      Id = "MelinoeField_3939"
      InheritFrom = "BaseNarrative"
      DisplayName = "不客气。我和您一样，喜欢时时刻刻保持戒备，毕竟我们现在敌人环伺。但正是因此，当我决定信任他人时，更希望对方能明确感受到我的信任。"
    }
    {
      Id = "Medea_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我心领了。"
    }
    {
      Id = "MelinoeField_3941"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢您对我们大业的奉献，美狄亚女士！您所需的蜜露或许已经足够，但我希望您能把这份礼物也收下。哪怕它并不太适合用在您的药剂之中。"
    }
    {
      Id = "Medea_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "如此厚礼，你怕是把我当作身居高位的女神了吧。倘若你见识过我的真面目，一定会立刻收回这样的赠礼。不必如此，女术士；你也知道，我用不上它。"
    }
    {
      Id = "MelinoeField_3942"
      InheritFrom = "BaseNarrative"
      DisplayName = "但您可以品尝它……？也许可以和我分享，或者和别人也可以。单纯留作收藏也行嘛。"
    }
    {
      Id = "Medea_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许吧……好，那就多谢了。"
    }
    {
      Id = "MelinoeField_3943"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道仙酒是种让人欲罢不能的美味，所以希望您能收下这份礼物。您无疑是我在整座埃费拉城中最想见到的人；谢谢您。"
    }
    {
      Id = "Medea_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "想不到我在对那么多人降下诅咒，无论他们是否罪有应得之后，还能收获像你这样的人的祝福……我与你合作，只是尽我对赫卡忒大人的义务，女术士。你不需要付我额外的酬劳。"
    }
    {
      Id = "MelinoeField_3944"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是酬劳，只是件礼物。你的过去我并不在意；我认识的只有现在这位与我相知相交的美狄亚女士。她几乎就是我想成为的那种女术士……虽然我不会那么执着于诅咒就是了。"
    }
    {
      Id = "Medea_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们相识时，你还那么小……那时的我还以为，随着年岁的增长，你会变得更决绝、更残忍；我们这行许多人都是如此。但你证明了自己总能抵御这样的影响……而与此同时，你也在反过来影响着我。真的很感谢你。"
    }
    {
      Id = "MelinoeField_3945"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是我的荣幸。"
    }
    {
      Id = "Melinoe_3299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您，前辈。"
    }
    {
      Id = "Medea_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不合时宜。"
    }
    {
      Id = "Medea_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "住手。"
    }
    {
      Id = "Medea_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在这里动手真的不合适。"
    }
    {
      Id = "Medea_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，现在不行。"
    }
    {
      Id = "Medea_0514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你无法刺穿我的帷幕。"
    }
    {
      Id = "Medea_0515"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我的结界很牢固。"
    }
    {
      Id = "Medea_0516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "快住手！"
    }
    {
      Id = "Medea_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "淡定，淡定……"
    }
    {
      Id = "Medea_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "祝贺你取得了伟大的成就。"
    }
    {
      Id = "Medea_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "女术士！"
    }
    {
      Id = "Medea_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "向你致意，女术士。"
    }
    {
      Id = "Medea_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦……！"
    }
    {
      Id = "Medea_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，欢迎。"
    }
    {
      Id = "Medea_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎回到寒舍。"
    }
    {
      Id = "Medea_0073"
