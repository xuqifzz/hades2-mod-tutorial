      InheritFrom = "BaseSubtitle"
      DisplayName = "我自己的镰刀，果真锋利……"
    }
    {
      Id = "Chronos_1371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你，怎么可能……？"
    }
    {
      Id = "Chronos_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "来了也不打声招呼。从排水渠里游过来的么？这家人真是一点都不讲究！不过我已经在着手改进这一点了，就从这座冥府开始——因此这里到处都是{#Emph}灰尘{#Prev}，还望你见谅啊。我们正给这里{#Emph}改头换面{#Prev}呢。"
    }
    {
      Id = "MelinoeField_1311"
      InheritFrom = "BaseNarrative"
      DisplayName = "滚下来。从你篡夺的王位上滚下来！你知道我是谁，也知道我为何而来。"
    }
    {
      Id = "Chronos_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "不仅一点都不讲究，还一点都不通礼数！难道我没有清清楚楚地跟你说过，你对我的任何攻击都只会是徒劳？我乃是不朽的{#Emph}泰坦{#Prev}，而你，不过是个遭人利用的可怜小姑娘。"
    }
    {
      Id = "MelinoeField_1312"
      InheritFrom = "BaseNarrative"
      DisplayName = "（念咒）
{#Emph}黑夜死敌，听我律令！罪状千种，死路一条！
{#Emph}冥府为证，势在必行！命运使然，无处可逃！"
    }
    {
      Id = "Chronos_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}真是无礼！{#Prev}在这座府邸之中，诅咒可是明令禁止的行为。说到这个，{#Emph}打斗{#Prev}也一样。不过看在你远道而来的份上，小孙女，我就为你破个例罢。{#Emph}是时候送你上路了。"
    }
    {
      Id = "Chronos_0456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看好了！"
    }
    {
      Id = "MelinoeField_1313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}克洛诺斯必死无疑！"
    }
    {
      Id = "Chronos_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，小姑娘，敢问你是哪位？最近没什么人来看望我呢。也许等这座冥府装修妥当，就会有更多人来拜访……不过就目前而言，只怕你得忍受这四处的灰尘了。我们正给这里{#Emph}改头换面{#Prev}呢。"
    }
    {
      Id = "Chronos_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，真是个惊喜！我的小孙女！当初那条漏网之鱼，一眨眼的工夫就要长大成人了。我有好多问题迫不及待想问你呢。你最近过得怎么样？以及，你究竟是怎么在这里找到我的？"
    }
    {
      Id = "Chronos_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这么早就有客人来了！最近没什么人来看望我呢。也许等这座冥府装修妥当，就会有更多人来拜访……不过就目前而言，只怕你得忍受这四处的灰尘了。我们正给这里{#Emph}改头换面{#Prev}呢。"
    }
    {
      Id = "Chronos_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，小孙女，别这么着急嘛！你好不容易才来一趟，而我还有好多问题想问你呢。你最近过得怎么样？以及，你究竟是怎么在这里找到我的？"
    }
    {
      Id = "Chronos_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上次侥幸逃出了我的手掌心，却还要去而复返，非得再给我一次把你变成藏品的机会吗？难道这整个家族的“智慧”，全都装在雅典娜的脑子里吗？"
    }
    {
      Id = "MelinoeField_1314"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“藏品”{#Prev}……说得就好像你的子孙后代是供你放在陈列柜的器物一般。{#Emph}你{#Prev}才是应该被放在陈列柜里的那个，只可惜众神把你千刀万剐之后，当作垃圾一样处理掉了。"
    }
    {
      Id = "Chronos_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起那件事，现在我还气不打一处来。我当真以为我的孩子们会有所不同，会更懂得尊重长辈。可惜事与愿违。而我的容忍……也是有限度的。"
    }
    {
      Id = "Chronos_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有看错，我还是这么精神抖擞、神采奕奕！上次交手之后，你是不是有种不祥的预感，害怕自己无法改变任何事？现在你知道了，那种感觉并非空穴来风。"
    }
    {
      Id = "MelinoeField_1315"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就知道，仅凭一场战斗是无法将你彻底消灭的。你身为时间本尊，更应该知道，任何有价值的成果都需要时间。"
    }
    {
      Id = "Chronos_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这样说来，这个“不速之客”你是要当到底了！难道你真的以为，这一切到最后会有所不同？也罢。正好让我偶尔活动活动筋骨。"
    }
    {
      Id = "Chronos_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真该看看在我刚到的时候，这地方是副怎样的凋敝之景！啊，你好像确实看到过，只不过那时候还太小，不记事罢了。我敢说，现在的冥府比之前体面了不少。但你非要脏兮兮地闯进来，把刚收拾好的地方又弄得一团糟。"
    }
    {
      Id = "MelinoeField_1316"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你的保洁人员表示由衷的歉意。下次再来的时候，我会尽量把自己打理得更“体面”一些的。"
    }
    {
      Id = "Chronos_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "想出言讽刺，也不先看看你那副德性！一副半死不活的样子，还敢来挑战我。好罢，趁早把你赶出去，我的{#Emph}保洁人员{#Prev}就能趁早开始收拾你留下的遍地狼藉。"
    }
    {
      Id = "Chronos_0609"
      InheritFrom = "BaseNarrative"
      DisplayName = "游得开心么？冥河曾经像血液一样流经此处。这上面的哀悼原野仍有那污秽的痕迹，但如今在我的府邸周围，目光所见尽是灿灿黄金。"
    }
    {
      Id = "MelinoeField_2021"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是说你为了一己的偏好，就改变了冥河本身吗？也可能是我没听清。你那灿灿黄金恐怕有几块卡到了我的耳朵里。"
    }
    {
      Id = "Chronos_0610"
      InheritFrom = "BaseNarrative"
      DisplayName = "怪不得你总是不愿好好听我说话。无妨，我相信接下来我想要传达的信息，对你来说一定振聋发聩。"
    }
    {
      Id = "Chronos_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近没少在地表干好事，是不是？那你一定见到了我那势不可挡的舰队，驶向众神之山覆灭的必然结局。"
    }
    {
      Id = "MelinoeField_1951"
      InheritFrom = "BaseNarrative"
      DisplayName = "我见到的舰队和“势不可挡”完全不沾边。船帆歪歪斜斜、船员东倒西歪，一点战斗力都没有。你过了这么久也没能攻下奥林匹斯山，一点都不意外。"
    }
    {
      Id = "Chronos_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "孙女啊，我的舰队或许达不到你的预期，但它们有着众神所缺乏的重要特质：那就是永远对{#Emph}我{#Prev}忠诚，无论走向何种结局。而这结局，自然是由{#Emph}我{#Prev}来决定！"
    }
    {
      Id = "Chronos_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "你太年轻了，不知道在众神重塑这个世界之前，它是副怎样的面貌。那时凡人无需在痛苦中死去，然后呆在这个{#Emph}深坑{#Prev}里饱受煎熬。那是个纯粹得多的时代，一切事物也因此更加美好。"
    }
    {
      Id = "MelinoeField_1318"
      InheritFrom = "BaseNarrative"
      DisplayName = "“更加美好”，指的是你翻手为云、覆手为雨吧？你接受不了其他人与你理念相悖，因此便对自己的亲生子女宣战！而且据说还是在把他们生吞之后。"
    }
    {
      Id = "Chronos_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "“据说”的事可多了去了！是{#Emph}他们{#Prev}对{#Emph}我{#Prev}宣战的。我的子女和其他属下时不时就会闹出些乱子；而我有那么多人要照顾，就更容不得任何人在我面前撒野。就算对你，宝贝孙女，我也不会网开一面。"
    }
    {
      Id = "Chronos_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "你如今已经见过这世态炎凉。好好想想罢，众神都创造了些什么：战争、饥荒、背叛！在我的黄金时代中，这些祸事都闻所未闻。那是个平静祥和的时代……直到众神大逆不道，谋权篡位！"
    }
    {
      Id = "MelinoeField_1504"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你的统治没有你声称的那样完美。也许对你的子女和那一辈神明而言，你是个惹人生厌的君主；因此他们才别无选择，只能将你推翻。"
    }
    {
      Id = "Chronos_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼，只可惜他们{#Emph}失败{#Prev}了！如此一来，我便得到了这个黄金一般的机会，可以好好教育教育{#Emph}我的子女和那一辈神明{#Prev}，让他们明白何谓{#Emph}因果循环，报应不爽{#Prev}！"
    }
    {
      Id = "Chronos_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的大军如今已然对你了如指掌；你的一招一式它们都谙熟于心。但只有我最为精锐的仆从才有资格在我的大殿中为我浴血奋战。"
    }
    {
      Id = "MelinoeField_1500"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的那些萨提尔信众真是积极，抢着要在你的面前去死。不过他们看起来智力堪忧，不是么？"
    }
    {
      Id = "Chronos_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "智者不会沦为仆从；智者会成为{#Emph}领袖{#Prev}。这些萨提尔缺少对死亡的恐惧，而且深信他们的牺牲将会为我带来力量，而他们将在这份力量之中永垂不朽。就让他们{#Emph}如愿以偿{#Prev}罢。"
    }
    {
      Id = "Chronos_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "历史的轨迹尽是出自我手。但你却这样没完没了地来烦我，好像你要越俎代庖一般。好罢，那就说来听听，倘若历史交给你来书写，接下来会发生什么？难道我就这样起身，将本就属于我的王位拱手相让么？"
    }
    {
      Id = "MelinoeField_1403"
      InheritFrom = "BaseNarrative"
      DisplayName = "历史哪轮得到你来书写……你不过是时间而已，是历史的车轮驶过的一块块地砖。你这次与其说是报复众神，不如说是报复命运三女神，而她们深知你在历史中应当扮演的角色。"
    }
    {
      Id = "Chronos_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实对命运三女神意见颇深。但这与{#Emph}你{#Prev}无关，与其他人都无关。如今我们尽皆摆脱了命运的桎梏，可以将未来掌握在自己手中，却还有人期盼她们的回归，只为再次沦为命运的奴隶！真是可笑。"
    }
    {
      Id = "Chronos_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "未来如今无人编织、无人决定。就连命运三女神也无法预料这一切将会如何结束，抑或者会在{#Emph}何时{#Prev}结束。但你却仍然不肯罢休。"
    }
    {
      Id = "MelinoeField_1502"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为时间泰坦独爱“必然性”呢。无论这一切的结局有没有被预先安排，我都会坚持到底。就当是满足我某种奇特的求知欲吧。"
    }
    {
      Id = "Chronos_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只当你是不见棺材不落泪。你的短视让你无法预见许多种可能性——在那些可能性中，对于你努力的成果，你将无福消受……"
    }
    {
      Id = "Chronos_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "一刻时间流逝……随后是下一刻、再一刻。你可曾听闻，每种长度的时间，我都有对应的称呼？从那刹那的错愕，到万古的弥存。"
    }
    {
      Id = "MelinoeField_1503"
      InheritFrom = "BaseNarrative"
      DisplayName = "废话说完了吗？我正打算在“刹那的错愕”之间把你解决掉呢。"
    }
    {
      Id = "Chronos_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解你想要将{#Emph}时间{#Prev}切分成更小的部分的心理，真的。小时，切分成分钟；分钟，切分成秒。因为啊，小孙女……时间的整体，{#Emph}远远超出了你能理解的范畴{#Prev}。"
    }
    {
      Id = "Chronos_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "你用来造成伤害的那些{#Emph}花哨{#Prev}玩意都是什么？如果命运三女神以为我会被那样的破烂杀死，只能说是她们痴心妄想。"
    }
    {
      Id = "MelinoeField_1505"
      InheritFrom = "BaseNarrative"
      DisplayName = "是不是{#Emph}痴心妄想{#Prev}，我们拭目以待。这些武器也许和众神曾经用来杀死你的不同，但它们也一样能完成任务。看好了。"
    }
    {
      Id = "Chronos_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，我和霍德雷特斯等着领教你的高招。这柄镰刀可不是仅仅用来在赶走刻耳柏洛斯的时候，收割原野上的小麦的；世间万物都难逃它的收割。"
    }
    {
      Id = "Chronos_0901"
      InheritFrom = "BaseNarrative"
      DisplayName = "你那一身稀奇古怪的装置是怎么回事？唉，你们这些小崽子的时尚潮流实在让人摸不着头脑。看来就连我也要跟不上时代了啊。"
    }
    {
      Id = "MelinoeField_3325"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这是漆黑战衣。我穿上它不是为了赶什么时尚潮流，不过你说得对，你是跟不上我的。"
    }
    {
      Id = "Chronos_0902"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知让你如此自信的，是你自身的能力，还是命运的设计。但你要知道，像这样新发明的奇技淫巧，永远比不上经历了时间检验的经典武器。"
    }
    {
      Id = "Chronos_1384"
      InheritFrom = "BaseNarrative"
      DisplayName = "你戴的那个金光闪闪的物件是什么？啊，这不是{#Emph}我的{#Prev}么！我最好的时间腕饰之一……！你个{#Emph}小毛贼！{#Prev}你居然敢大摇大摆地戴着它回到这里？"
    }
    {
      Id = "MelinoeField_5027"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我才不是什么贼。这是一件礼物！不过还是不细说了吧。我没有一整夜的时间。你也没有。"
    }
    {
      Id = "Chronos_1385"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是自以为是。我拥有世界上所有的时间！不过，小孙女，{#Emph}你{#Prev}的时间，很快就要到头了啊。"
    }
    {
      Id = "Chronos_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得出你的武器：那是死神本尊的镰刀！真可惜，当我将他和冥府的其他臣民一并擒获时，那把镰刀居然不在他的手上。"
    }
    {
      Id = "MelinoeField_1953"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算你抓走了死神，也逃脱不了死亡。死在佐利菲特之下正合适。"
    }
    {
      Id = "Chronos_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看这种情况机会相当渺茫。那就来罢，让我们用镰刀分个高下！你的佐利菲特，对阵我的霍德雷特斯。让我们看看究竟是谁来播种，谁来收割。"
    }
    {
      Id = "MelinoeField_1506"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉来迟了，路上有几个残魂非要找我麻烦。我还以为凭你大赦冥界的度量，对我也会一视同仁，既往不咎呢。"
    }
    {
      Id = "Chronos_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是大赦了冥界不假。但你或许不知道，你口中的那些{#Emph}残魂{#Prev}并非个个都对哈迪斯感恩戴德。只要我客客气气地问，他们还是很愿意投诚于我的。至于你嘛，我就不费那个工夫了。"
    }
    {
      Id = "MelinoeField_1508"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对我父亲那一辈人一直嗤之以鼻。可是你那一辈人呢？我没见到有多少与你同辈的人集结在你的麾下，或者其他人的麾下。"
    }
    {
      Id = "Chronos_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，你看，其他的泰坦基本上都丢了性命，和我之前一样！都是你父亲和他{#Emph}那一辈人{#Prev}干的好事。或许等到这一切尘埃落定，我会着手将我的{#Emph}同辈{#Prev}带回来。至少其中某几位值得考虑。"
    }
    {
      Id = "MelinoeField_1509"
      InheritFrom = "BaseNarrative"
      DisplayName = "给我起来，老贼。泰坦。{#Emph}克洛诺斯“大人”。{#Prev}不管他们现在怎么叫你。借用你常说的一句话：{#Emph}时间{#Prev}到了。"
    }
    {
      Id = "Chronos_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，时间到了。说到这个，他们叫过我许多名字；自万古以来，我有着无数称呼。有些人认为我不过是天与地的产物，真是{#Emph}岂有此理{#Prev}。而你甚至比{#Emph}他们{#Prev}还要不通事理。"
    }
    {
      Id = "Chronos_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "你可曾为塔耳塔罗斯中轮转不息的黄金圆盘感到震撼？这是我为冥界所做的小小设计，它们可以通过传动确保事物永远稳步推进、永不停止。我称之为{#Emph}齿轮装置{#Prev}。永无止境的循环！一如四季更替，周而复始。"
    }
    {
      Id = "MelinoeField_1594"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是来观光的。早就知道那些所谓的{#Emph}“齿轮装置”{#Prev}是{#Emph}你{#Prev}的杰作了。碍眼的东西，停滞不前，吱呀作响。"
    }
    {
      Id = "Chronos_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}停滞不前{#Prev}？想不到你自诩擅用魔法，对世界的见识却如此短浅！世间万物永远不会停滞不前，因为它们在步入未来，小孙女！步入{#Emph}未来{#Prev}。"
    }
    {
      Id = "Chronos_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有非常仔细地记录时间。如此手段自然逃不出我的法眼。但你如此做的动机，却令我感到费解。难不成是想要看看你在败下阵来之前，能在我手上坚持多久？"
    }
    {
      Id = "MelinoeField_1596"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁胜谁负还不一定。所以说今夜我们的交手会用多少时间？你一副无所不知的样子，想必不会不知道这个吧。"
    }
    {
      Id = "Chronos_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，依我看，{#Emph}一眨眼{#Prev}的工夫就足够了！这还不是正式的计量单位，但或许有必要确立一下……"
    }
    {
      Id = "Chronos_0556"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不再为我们之间的争斗计时了。是太难以承受了么？毕竟，你在葬送自己的大好时光……"
    }
    {
      Id = "MelinoeField_1597"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是冥界不死不灭的女神。时间对我来说毫无意义。我可以一直这样做，直到永远。"
    }
    {
      Id = "Chronos_0557"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？{#Emph}永远{#Prev}长得很呢。不如我让接下来发生的事既缓慢又痛苦，看看能不能治好你这不撞南墙不回头的毛病……"
    }
    {
      Id = "Chronos_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对时间的控制力不容小觑，居然能把我与生俱来的力量用在{#Emph}我自己{#Prev}身上！不过，也说不定这仅仅是来自我的遗传罢了。"
    }
    {
      Id = "MelinoeField_1950"
      InheritFrom = "BaseNarrative"
      DisplayName = "别侮辱我，也别欺骗你自己。你夺走我的家人时，便在我心中埋下了复仇的种子；我一生的渴望，便是看到你灰飞烟灭。因此我做了十足的准备。"
    }
    {
      Id = "Chronos_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "一生的渴望。孙女啊，你的一生，只在我弹指一挥间！没有人能仅凭意志便展露出你这般的能力。然而话说回来，你不仅仅是个小小{#Emph}神明{#Prev}，还是个{#Emph}女巫{#Prev}啊。"
    }
    {
      Id = "Chronos_0905"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是个不同凡响的夜晚！我的大军如此勇猛地对你围追堵截，到头来却未立寸功……看来我得去跟他们说上两句了。"
    }
    {
      Id = "MelinoeField_3327"
      InheritFrom = "BaseNarrative"
      DisplayName = "比起畏惧你，他们更畏惧我。在你的步步阻拦面前，我的力量也逐渐增涨。而等到最后，你也倒在地上的时候，黑夜的意志便会得到施行。"
    }
    {
      Id = "Chronos_0906"
      InheritFrom = "BaseNarrative"
      DisplayName = "好一个盲目的追随者。孙女啊，你和我那些成事不足败事有余的随从并没有什么区别……而我也将对你们一视同仁。"
    }
    {
      Id = "Chronos_1237"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡俄斯的负面效果，居然会出现在此处……真是丧心病狂！如此说来，你说服了万物本源，让祂认定我在与祂的交易中占了便宜么？倪克斯和命运三女神，得来全不费工夫！"
    }
    {
      Id = "MelinoeField_3807"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，卡俄斯确实对你颇有微词。不过你所察觉到的效果，并不是专门在帮助我。我们所谈论的，可是一个毫不偏颇的存在。"
    }
    {
      Id = "Chronos_1238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“毫不偏颇”？{#Prev}任何有思想的生物，都做不到这一点！自从卡俄斯孕育第一个生命以来，祂便彻底抛弃了“毫不偏颇”的特质！而且祂显然不会站在{#Emph}我{#Prev}这一边。"
    }
    {
      Id = "Chronos_1386"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你{#Prev}，明明一心想向我报仇雪恨，却口口声声说自己毫不在乎那些被我抓走的家人！很好，反正他们也不值得！因为他们，对{#Emph}我们这个家{#Prev}，也毫不在乎！把我丢在深渊里{#Emph}自生自灭！{#Prev}而你，与他们{#Emph}没有任何区别！"
    }
    {
      Id = "MelinoeField_5043"
      InheritFrom = "BaseNarrative"
      DisplayName = "只有你在乎我们这个家，这就是你想说的吗？得了吧。他们让你自生自灭，是因为你给了他们无数憎恨你的理由。"
    }
    {
      Id = "Chronos_1401"
      InheritFrom = "BaseNarrative"
      DisplayName = "呸！是他们渴望权力，而我拒绝与他们分享。他们根本没有为之付出努力！或许，但凡他们好好问一问，这一切都不会发生。可惜，过往的错误，早已覆水难收。"
    }
    {
      Id = "Chronos_1436"
      InheritFrom = "BaseNarrative"
      DisplayName = "你从来都不该卷入这些事情，孙女！当初我抵达这里时，你一定只是个小小婴儿，只可惜那时我没来得及与你见上一面。但哪怕是现在，你也太年轻，理解不了这些事情。"
    }
    {
      Id = "MelinoeField_5083"
      InheritFrom = "BaseNarrative"
      DisplayName = "跟你见上一面的话，只怕我就跟其他人关在一起了。不过，你倒是说说……你觉得我太年轻而无法理解的事情，到底是什么？"
    }
    {
      Id = "Chronos_1437"
      InheritFrom = "BaseNarrative"
      DisplayName = "你太年轻，无法理解家人所能带来的失望与懊恼，世间任何事物都无可比拟。但你见过的家人越多……认识的家人越多……你就会越早领悟到这一点。"
    }
    {
      Id = "Chronos_1438"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，有家人这么频繁来探望我，还真让我不太习惯！倘若哈迪斯他们几个愿意放下身段，多来看看我的话，我们的关系又何以至此啊。"
    }
    {
      Id = "MelinoeField_5084"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我可不是来探望你的。不过我倒是没意识到，原来你只是孤独了啊！有那些萨提尔充当宾客，还不够你排解寂寞的吗？"
    }
    {
      Id = "Chronos_1439"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们是我的信众，不是家人！可怜的孙女啊，你不幸卷入了这场争端之中，连有没有家人在身旁的区别都从未亲身体会过。"
    }
    {
      Id = "MelinoeField_5085"
      InheritFrom = "BaseNarrative"
      DisplayName = "那都是因为{#Emph}你！{#Prev}这场{#Emph}争端{#Prev}也是因你而起！而现在，你将为你的所作所为受到死亡的惩罚。这样做值得么？"
    }
    {
      Id = "Chronos_1440"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要这样说，那答案当然是不值得！倘若我一生从未犯过任何错误，我们必定不会落入现在的境地，不是么？至少不会如此剑拔弩张、势不两立！然而，我们现在就在这里，各自面对着过往的苦果。"
    }
    {
      Id = "MelinoeField_5086"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前说到“过往的苦果”……说是你犯的错误，让我们落入了现在的境地。那{#Emph}这{#Prev}就是你弥补错误的方式吗？你的整个家族，现在都与你为敌……！"
    }
    {
      Id = "Chronos_1441"
      InheritFrom = "BaseNarrative"
      DisplayName = "过去又何尝不是如此！唯一的区别是，现在你们这些神明还{#Emph}越来越多{#Prev}了，一个接一个的。你们想要把我逐出我自己的家门？好啊！但{#Emph}这{#Prev}就是你们的下场！"
    }
    {
      Id = "MelinoeField_5087"
      InheritFrom = "BaseNarrative"
      DisplayName = "你甚至都不想统治冥界和地表，对么？你只想报复你的孩子们。多么狭隘……多么可悲。"
    }
    {
      Id = "Chronos_1442"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一代代的神明啊，每一代都比父辈更喜欢妄下评断！我是{#Emph}完美的父亲{#Prev}么？不是。否则的话，我的子女也理应同样完美！而现在，就连你也逃不出这样的恶性循环！"
    }
    {
      Id = "Chronos_1443"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你为什么一次次回来！你所寻求的{#Emph}不仅仅是{#Prev}与我的闲聊，还有大殿另一头那间邋遢房间中的夜之圣镜……唯一一件我无法挪动的器物！但是，没有黑夜本尊，它将{#Emph}毫无作用！"
    }
    {
      Id = "MelinoeField_5206"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来这里才不是为了找冥府的旧家具。你应该知道，如果你遭到毁灭，至少有一位家人会对此无比难过。你可以防止这种事情发生……只要你不要再让这一切继续。"
    }
    {
      Id = "Chronos_1458_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我何尝不想啊！可到了这一步，我早就顾不上你口中的“某位家人”是否难过了！如今木已成舟，再没有回头路了，哪怕懊悔也无济于事！这，便是时间的{#Emph}本质{#Prev}。"
    }
    {
      Id = "Chronos_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "我猜，你在外头肯定见过你父亲了？他可是享受着我的特别款待呢。千百年来，他在这里囚禁了无数灵魂，这其中自然也包括我。这样说来，他如今遭受如此下场，也是罪有应得。"
    }
    {
      Id = "MelinoeField_1317"
      InheritFrom = "BaseNarrative"
      DisplayName = "复仇就说复仇，为什么还非要用仁义道德当幌子？不过，既然你这么想要占据道德高地，我倒要听听，你有什么理由囚禁我父亲之外的家人？还有倪克斯，以及冥府的其他人？"
    }
    {
      Id = "Chronos_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个啊，自然是因为他们胆敢忤逆我。你能躲过一劫，只不过是因为你那恼人的把戏，能够抵御我历尽时间锤炼的秘技……或许是家族传承吧。不过，你的哥哥……他就没有这么幸运了。你也会有招架不住的时候……迟早的事。"
    }
    {
      Id = "Chronos_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "苟延残喘的哈迪斯居然还能分出些力量帮助你！哪怕被困在没有神明挣脱的枷锁之中，你爸爸仍然能给我整出些乱子来啊。"
    }
    {
      Id = "MelinoeField_1501"
      InheritFrom = "BaseNarrative"
      DisplayName = "你让他受尽了折磨和侮辱。你总是冠冕堂皇地说自己要让逝去的纪元重现，但背地里好像只对这种上不了台面的报复行为感兴趣。"
    }
    {
      Id = "Chronos_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "恕我直言，小孙女，这两者{#Emph}不冲突{#Prev}。你应该看看你父亲当年是怎么折磨那些凡人的灵魂的——残忍得惊世骇俗！因此，对{#Emph}他{#Prev}降下惩罚乃是天经地义；对{#Emph}你{#Prev}也是一样。"
    }
    {
      Id = "Chronos_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不承认，你还真有两下子。你几次三番渗透塔耳塔罗斯、闯入我的府邸；若不是你那肮脏的冥界血脉作祟，只怕是天方夜谭！而且你还有办法抵御我的魔法。能不能再容我礼貌地问一次，你究竟是怎么做到的？"
    }
    {
      Id = "MelinoeField_1592"
      InheritFrom = "BaseNarrative"
      DisplayName = "你管这个叫{#Emph}礼貌{#Prev}？连“请问”都不肯说。但既然你这么想知道……实话告诉你吧，我来自未来。你之后会意识到自己的做法有多么错误，然后教会我阻止你的办法，以免让你造成更多伤害。"
    }
    {
      Id = "Chronos_0548"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈！{#Prev}哦，你可太有想象力了。好一出喜剧，建立在最为荒诞不经的假设之上！孙女啊，你永远无法逆转时间！时间永远只会向前推进，而唯有我能决定它前进的速度。"
    }
    {
      Id = "Chronos_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还真会惹是生非，每次都非得把你父亲的那个三头魔物放出来！他为何要把那头野兽养在冥府的大殿里，实在是让我匪夷所思。"
    }
    {
      Id = "MelinoeField_1402"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你就一而再、再而三地把可怜的刻耳柏洛斯赶到哀悼原野里，任由他宣泄自己的怒火。罪加一等……"
    }
    {
      Id = "Chronos_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "不然你还要我怎样？我不需要他把守冥界的大门，因为现在冥界已经门户大开；我更不需要他到处乱跑，弄得遍地都是狗毛。相比之下，{#Emph}遍地都是血{#Prev}听起来还算可以接受……"
    }
    {
      Id = "Chronos_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "多亏了奥林匹斯众神处处树敌，我的大业才能进展得如此顺利。萨提尔、鹰身女妖、独眼巨人波吕斐摩斯，诸如此类，数不胜数！众神的殒落，并非我一人之愿。"
    }
    {
      Id = "MelinoeField_1952"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你把那些渴望权力或复仇的妖魔鬼怪全都聚集起来了！好一群乌合之众。那个波吕斐摩斯我已经很熟了……他的忠心肯定可以被收买。"
    }
    {
      Id = "Chronos_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那是自然。忠心要么是赢得的，要么便是收买来的，二者不过殊途同归罢了。波吕斐摩斯有他的软肋，这我当然清楚。但他至少不是{#Emph}不可救药{#Prev}。"
    }
    {
      Id = "Chronos_0711"
      InheritFrom = "BaseNarrative"
      DisplayName = "你为何总对我那老实本分的牧羊人波吕斐摩斯苦苦相逼？他只想专心放羊，不被人打扰！至少你这次来了{#Emph}这里{#Prev}，给了他片刻的喘息之机。"
    }
    {
      Id = "MelinoeField_2552"
      InheritFrom = "BaseNarrative"
      DisplayName = "你那老实本分的牧羊人死活不让我离开埃费拉城，所以我就只能自己想办法咯。顺便跟你一提，他总在工作的时候睡着哦……"
    }
    {
      Id = "Chronos_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "此话当真？那确实该罚！当然，我给那个独眼巨人的薪水，本来就少得可怜。所以说，孙女啊，种瓜得瓜，求仁得仁……"
    }
    {
      Id = "Chronos_0903"
      InheritFrom = "BaseNarrative"
      DisplayName = "当我最初抵达冥府时，你的父亲和他的仆从们简直是毫无还手之力。就连倪克斯本尊也不过如此！不过，说句公道话，我确实是打了他们个措手不及啊。"
    }
    {
      Id = "MelinoeField_3326"
      InheritFrom = "BaseNarrative"
      DisplayName = "你把黑夜的化身和其他人一起扣作人质，究竟是有什么意图？黑夜的影响力没那么容易被你逆转。"
    }
    {
      Id = "Chronos_0904"
      InheritFrom = "BaseNarrative"
      DisplayName = "你大可以放心，就算倪克斯暂时离开，外面的世界仍然黑暗得很。不过，我确实希望那些违抗我的人越少越好。实话说，最好是一个也没有。"
    }
    {
      Id = "MelinoeField_1590"
      InheritFrom = "BaseNarrative"
      DisplayName = "说实话，我几乎要佩服你了。你不仅洗劫了我父亲的领地，又向奥林匹斯山发动了战争，而且还有胆量欺骗原初混沌卡俄斯！真是胆大包天。"
    }
    {
      Id = "Chronos_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈哈，感谢你的肯定，小孙女！我还以为卡俄斯会和我讨价还价，于是做好了用祂的女儿倪克斯交换命运三女神的打算。但现在，她们全在我的手中！"
    }
    {
      Id = "MelinoeField_1591"
      InheritFrom = "BaseNarrative"
      DisplayName = "你胆敢像这样戏耍冥界诸神……他们可是世界上最为古老、最为强大的力量。等着瞧吧，这样做的后果早晚会找上门的。"
    }
    {
      Id = "Chronos_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，{#Emph}你{#Prev}就是那个一再登门拜访的“后果”啊。上至奥林匹斯山，下至冥界，他们居然除你之外再也找不出别人来对付我。{#Emph}哈！"
    }
    {
      Id = "MelinoeField_1507"
      InheritFrom = "BaseNarrative"
      DisplayName = "你到底对命运三女神做了什么？为了掳走他们，你不惜与冥界诸神为敌，好像与奥林匹斯诸神为敌还不够一样。"
    }
    {
      Id = "Chronos_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我把她们放逐了！至于放逐到了哪里，或者说是{#Emph}何时{#Prev}，无可奉告。无论如何，她们如今已然手无缚鸡之力，再也无法编排我们了。接下来发生的事情……完全由{#Emph}我们{#Prev}主宰。"
    }
    {
      Id = "Chronos_0552"
      InheritFrom = "BaseNarrative"
      DisplayName = "外面那个{#Emph}划船的{#Prev}真是令我匪夷所思。他居然有胆量把船径直划到我门口！萨提尔对{#Emph}他{#Prev}的畏惧，比对{#Emph}你{#Prev}的还要多上几分。"
    }
    {
      Id = "MelinoeField_1595"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也应该对他心怀畏惧。卡戎大人熟知冥界里的每一块卵石、五河中的每一滴流水。你自诩“永远不会停止”？卡戎大人也是一样。"
    }
    {
      Id = "Chronos_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "……他不过是个杂货贩子，兜售着不法之物，还对他少之又少的顾客锱铢必较！而且还要把我慷慨铸成的金币据为己有。好一个高尚的盟友！"
    }
    {
      Id = "Chronos_0707"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若我没理解错的话，你在俄刻阿诺斯的水池子里享受了好一场音乐盛宴啊！在阴间的下水道里钻了半天，费那么大工夫，也不知道图什么。"
    }
    {
      Id = "MelinoeField_2550"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没费什么工夫。那边的艺术氛围很好，演出真的大受欢迎！你应该多去看一看。"
    }
    {
      Id = "Chronos_0708"
      InheritFrom = "BaseNarrative"
      DisplayName = "说得没错，我是该多去看一看，然后把那破地方纳入囊中，因为那是我应得的！不过，就目前来说嘛，我不过是稍稍赞助了你最喜欢的夜间节目而已！"
    }
    {
      Id = "Chronos_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我还没有亲自出席过斯库拉的演出，但据我所知，她和塞壬乐队的演出是错漏百出啊。或许我应当重新考虑一下，要不要继续赞助她们……"
    }
    {
      Id = "MelinoeField_2551"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕你投资到她们身上的钱，都已经是“沉没成本”了。我每夜见到的都是那一小批忠实听众，压根看不到有什么新观众被吸引来。"
    }
    {
      Id = "Chronos_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "小孙女啊，可不要小看了“一小批忠实听众”！爷爷当年复出的时候，也只有几个忠实的萨提尔信徒，但现在不照样是万人追捧了嘛！"
    }
    {
      Id = "MelinoeField_1593"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为冥界诸神都与你为敌呢。但想不到你居然能说服堂堂{#Emph}厄里斯{#Prev}加入你的麾下！这样的联盟未免也太滑稽了，不过要想掀起更多腥风血雨，她倒确实是个合适的人选。"
    }
    {
      Id = "Chronos_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "小孙女啊，许多丰功伟业都出自我之手，但唯独和纷争化身联手这件事我闻所未闻！倪克斯最小的崽子对我有什么用？不过，如果她真的如你所说加入了我的麾下，那兴许她比我想象得还要聪明一些。"
    }
    {
      Id = "Chronos_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "你居然设法抵达了众神之山。据普罗米修斯称，还与他交上了手！无论你选择哪一条路……我们泰坦总会在尽头等着你。"
    }
    {
      Id = "MelinoeField_2548"
      InheritFrom = "BaseNarrative"
      DisplayName = "那正好，来一个我杀一个。所以说，你把奥林匹斯的那个囚徒放了，他便心甘情愿为你卖命？听说普罗米修斯曾经很有骨气呢。"
    }
    {
      Id = "Chronos_0704"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，他现在也很有骨气啊！这就是他加入我大业的原因。更何况，他可是率领军队杀上奥林匹斯山的不二人选，毕竟众神当初待他是如此不公！至于我嘛，我又不能总是事必躬亲！"
    }
    {
      Id = "Chronos_0705"
      InheritFrom = "BaseNarrative"
      DisplayName = "先见泰坦向我承认，他的怒火没能阻止你。我当时是这样回应他的：“普罗米修斯啊，你让我怎么说你！如果你早知有这一天，为何不向我发出警告？又为何不防患于未然？”"
    }
    {
      Id = "MelinoeField_2549"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你高估了先见泰坦清楚地洞悉未来的能力，同时也高估了他的力量。"
    }
    {
      Id = "Chronos_0706"
      InheritFrom = "BaseNarrative"
      DisplayName = "他自称要对未来将要发生的一切守口如瓶……以免我们自作聪明，让期望中的未来徒增变数。好一个方便的借口！就算没有他那样的脑子，也不难看出我会取得最终的胜利！"
    }
    {
      Id = "Chronos_0893"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，不知天高地厚的你，最近在为众神夺回奥林匹斯山的行动中吃到了些苦头啊。也许在你亲眼看见众魔之父那可怕的身形时，才最终明白你是多么愚蠢。"
    }
    {
      Id = "MelinoeField_3320"
      InheritFrom = "BaseNarrative"
      DisplayName = "你唤醒了那个怪物，还好意思说{#Emph}我{#Prev}不知天高地厚？提丰可不会听命于你，不会听命于{#Emph}任何人{#Prev}！倘若让他得逞，就再也不剩什么东西给你统治了！"
    }
    {
      Id = "Chronos_0894"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，倘若让他得逞，就再也不剩什么东西给你们{#Emph}众神{#Prev}统治了。而我，终将{#Emph}一统天下！{#Prev}虽然提丰不会与人协商、结盟，但是我们向着同一个目标奋斗，自然无需那些繁文缛节。"
    }
    {
      Id = "Chronos_0997"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，不知天高地厚的你，最近在为众神夺回奥林匹斯山的行动中取得了些成就啊！也许在你亲眼看见众魔之父那可怕的身形时，觉醒了某种原始的潜能。"
    }
    {
      Id = "MelinoeField_3321"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我把你变回一片黄沙之前，回答我一个问题。如果提丰如你所愿摧毁了奥林匹斯山，你指望他接下来去哪里？回去睡觉吗？"
    }
    {
      Id = "Chronos_0895"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这不在我的考虑范围之内。我们的世界很宽广，更何况还有{#Emph}纵深{#Prev}！提丰爱去哪里，但去无妨。或许他会取代波塞冬，接管海洋也说不定！"
    }
    {
      Id = "MelinoeField_3322"
      InheritFrom = "BaseNarrative"
      DisplayName = "骗子。你是想要背叛他。等他发挥完自己的作用，就让他咆哮着滚回深渊里。哪怕是{#Emph}你{#Prev}，也不会蠢到忽视他的威胁。"
    }
    {
      Id = "Chronos_0896"
      InheritFrom = "BaseNarrative"
      DisplayName = "未来将会尽在掌控之中，这点我可以向你保证，孙女。最好是专注于当下，以及当下你将要遭遇的诸多苦难。"
    }
    {
      Id = "Chronos_0897"
      InheritFrom = "BaseNarrative"
      DisplayName = "好嘛，把提丰从那座山头上撵下来了……虽说肯定不是你凭一人之力能够实现的，但仍然是件壮举！你心里一定{#Emph}骄傲无比{#Prev}。"
    }
    {
      Id = "MelinoeField_3323"
      InheritFrom = "BaseNarrative"
      DisplayName = "是有几分满足感没错。但你知道比起击败众魔之父，更令人满足的是什么，对吧？"
    }
    {
      Id = "Chronos_0898"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你的言下之意是，在战斗中击败我所带来的快感，与击败奥林匹斯山的毁灭者有得一拼，那我感到不胜荣幸，好孙女。那便来罢，试试你有没有这个本事——虽然提丰现在已经卷土重来。"
    }
    {
      Id = "Chronos_0899"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼哼哼，瞧把你气的！想不想知道我究竟是如何重新唤醒提丰的，孙女？或者，想不想知道我是如何在神不知鬼不觉中，推进我的计划的？"
    }
    {
      Id = "MelinoeField_3324"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就请你跟我讲讲吧，爷爷。毕竟我最喜欢听你讲故事了。"
    }
    {
      Id = "Chronos_0900"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算你听了，也不会相信的。因为你思想狭隘，你们神明都是一路货色！我的计谋在你们之上……接下来，我会证明我的武力也在你们之上。"
    }
    {
      Id = "Chronos_0985"
      InheritFrom = "BaseNarrative"
      DisplayName = "你做了什么……你对众魔之父{#Emph}做了什么？{#Prev}他竟然……竟然凭空消失了……！"
    }
    {
      Id = "MelinoeField_3879"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些细节无可奉告，老贼。你只需要知道，下一个就是你。愿你临终的时刻无比痛苦。"
    }
    {
      Id = "Chronos_0986"
      InheritFrom = "BaseNarrative"
      DisplayName = "你敢对我妄言痛苦……我能让你永生永世陷入其中，让你对痛苦的领悟比我还要真切！"
    }
    {
      Id = "MelinoeField_3662"
      InheritFrom = "BaseNarrative"
      DisplayName = "奇怪。这里看起来一模一样，而且你也没什么变化，泰坦。我还以为今夜会有什么新事物在等着我。"
    }
    {
      Id = "Chronos_1063"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，不必如此失望，小孙女。如果你希望我这把老骨头使出点什么新花样，为今夜的对决增添些趣味，那我乐意之至……"
    }
    {
      Id = "Chronos_1331"
      InheritFrom = "BaseNarrative"
      DisplayName = "你撑过了时间的尽头，一定以为自己很是聪明，很有能耐罢。但实际上，你却徒劳无功！因为我和原先一样就在这里，而你，仍然站在{#Emph}那里{#Prev}。"
    }
    {
      Id = "MelinoeField_4563"
      InheritFrom = "BaseNarrative"
      DisplayName = "你原本还以为我没有任何办法能打败你，更遑论在什么时间的尽头了。你比你想象得更加容易出错。"
    }
    {
      Id = "Chronos_1332"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，你才容易出错，小孙女，因为时间本质上来说无比精确，而且永远正确。但如果你想要试验一下你的假说，那么我随时欢迎。"
    }
    {
      Id = "Chronos_1333"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来时间的尽头不太如你的意啊，是不是，嗯？哎，孙女啊，你想让我对你别那么严厉，只要说一声就好了嘛……"
    }
    {
      Id = "MelinoeField_4564"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是来消灭你的，泰坦，不是来逛那些看起来象征着你本性的、空洞无趣的地点的。我觉得这样一来，事情会更有效率。"
    }
    {
      Id = "Chronos_1334"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}效率！{#Prev}这才像是我孙女该说的话嘛。那就让我们再次比个高下罢，不过同时也要注重效率啊。"
    }
    {
      Id = "Chronos_1329"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早已习惯了奥林匹斯众神的{#Emph}气息{#Prev}，以及他们施加于你的所谓{#Emph}祝福{#Prev}，所以这次终于能消停消停，还真是难得。现在这里完全没有{#Emph}他们{#Prev}的力量，只有{#Emph}你的！"
    }
    {
      Id = "MelinoeField_4562"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想，我自己的力量已经足够对付你了。不过，你越低估我，似乎对我就越有利。那么，开始吧？"
    }
    {
      Id = "Chronos_1330"
      InheritFrom = "BaseNarrative"
      DisplayName = "开始什么？开始让我和我的萨提尔信众{#Emph}一次又一次{#Prev}把你这烦人的不速之客逐出门外吗？那么，{#Emph}好啊{#Prev}，乐意之至。"
    }
    {
      Id = "Chronos_0976"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是怎么称呼那个你无比在意的老巫婆的？你的{#Emph}老师？{#Prev}告诉我她的真实身份，否则休怪我对她无情。"
    }
    {
      Id = "MelinoeField_3877"
      InheritFrom = "BaseNarrative"
      DisplayName = "……她是我母亲的侍女，仅此而已。当你袭击我父亲的冥府时，她把我带走了。在我长大之后，我立下誓言要阻止你，纵使她苦口婆心地劝告也无济于事。放了她。"
    }
    {
      Id = "Chronos_0977"
      InheritFrom = "BaseNarrative"
      DisplayName = "……孙女，起初我还以为，你可能不是哈迪斯的女儿，而是宙斯的。但你撒的谎实在是漏洞百出。现在，你将为你的行为受到惩罚……否则就让这位所谓的{#Emph}“侍女”{#Prev}替你受罚。"
    }
    {
      Id = "MelinoeField_3878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}你休想碰她！"
    }
    {
      Id = "Chronos_0978"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的老师迄今为止还真是守口如瓶。当然，有必要的话，我完全可以{#Emph}更有说服力{#Prev}一点。但首先，得解决眼前的麻烦……"
    }
    {
      Id = "Chronos_1049"
      InheritFrom = "BaseNarrative"
      DisplayName = "粗鲁无礼的女孩。我无从得知上一次你为何得以侥幸脱身，但你胆敢再来此地，给我{#Emph}第二次机会{#Prev}，真是自寻死路。"
    }
    {
      Id = "MelinoeField_4135"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是你的第二次机会，泰坦，而是最后一次。你是时空中的一处谬误，根本不该存在；不是在这里，不是以这种方式。"
    }
    {
      Id = "Chronos_1050"
      InheritFrom = "BaseNarrative"
      DisplayName = "容我打断一下？呃，你好！如果仅凭长相还不足以说明的话，{#Emph}我就是你！{#Prev}但我也是{#Emph}我自己。{#Prev}我知道这对你来说很难接受，但我的小孙女所言非虚……"
    }
    {
      Id = "MelinoeField_4136"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷，还是交给我吧。就凭你以前那副德性，他是不会听我们讲道理的。"
    }
    {
      Id = "Chronos_1051"
      InheritFrom = "BaseNarrative"
      DisplayName = "这又是哪一出，你……你竟妄想{#Emph}戏弄{#Prev}我！妄想以这种拙劣的幻术搅扰我的神智，还胆敢在我面前大谈什么应该存在、什么不该存在？收起你的把戏！"
    }
    {
      Id = "Chronos_1271"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经见识过，我是不会被杀死的。想战斗的话，就来战个痛快罢！无论结果如何，被逐出此地的，都会是{#Emph}你{#Prev}。还是说，你只是来这里翻找你家族的陈年杂物？"
    }
    {
      Id = "MelinoeField_3871"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不需要他们的东西。我只要你的项上人头。"
    }
    {
      Id = "Chronos_1272"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个可不能给你，小孙女，因为我还要用那其中远超我子女的智慧，一统天地三界。至于你，只怕你比他们还要愚钝。"
    }
    {
      Id = "Chronos_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又一次躲过了我沿途的重重把守，仿佛非要被我亲自打败才会死心。"
    }
    {
      Id = "Chronos_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你在这里的胡作非为有着无限耐心，孙女。"
    }
    {
      Id = "Chronos_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这下面的深渊之中被囚禁了千万年之久；几次粗鲁无礼的闯入根本不足为虑。"
    }
    {
      Id = "Chronos_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "很显然，与你的交手没有任何更文明的解决方式……"
    }
    {
      Id = "Chronos_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这王座上坐了这么久，是时候该活动一下身体了。"
    }
    {
      Id = "Chronos_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "真没想到，我的大军团结一致，连区区一个小姑娘也对付不来。"
    }
    {
      Id = "Chronos_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不承认，你做事很讲究方法。 但只有方法还远远不够。"
    }
    {
      Id = "Chronos_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "你无法同时身处两地。向我发起进攻，就意味着奥林匹斯山战火纷飞，无人能救……"
    }
    {
      Id = "Chronos_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "时间有时如白驹过隙，有时却长久如一。这一次，我们就速战速决罢。"
    }
    {
      Id = "Chronos_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连命运三女神都无法阻止我登上应得的王位，你又有什么希望可言？"
    }
    {
      Id = "Chronos_1485"
      InheritFrom = "BaseNarrative"
      DisplayName = "（嗤鼻）……你想要带来时间的终结……？那么，{#Emph}看好了{#Prev}……我就让你……{#Emph}一窥究竟……！"
    }
    {
      Id = "Chronos_0987"
      InheritFrom = "BaseNarrative"
      DisplayName = "……众神不能击垮我……命运不能编排我！但你竟敢让我如此蒙羞。{#Emph}岂有此理。岂有此理！！"
    }
    {
      Id = "Chronos_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "……唔呃！我看你也算是闹够了。妄想闯入我的冥府，浪费{#Emph}我{#Prev}的时间！我可是时间本尊。每分每秒，我都可以让你承受{#Emph}地狱{#Prev}般的痛苦。"
    }
    {
      Id = "Chronos_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "……唔呃，你这死丫头……！看来，是有其父必有其女啊……"
    }
    {
      Id = "Chronos_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你不属于这里……实际上，你不属于{#Emph}任何地方{#Prev}……"
    }
    {
      Id = "Chronos_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "呿……！上次六个身强力壮的神才勉强制伏我，你这个{#Emph}小屁孩{#Prev}未免太狂妄了！"
    }
    {
      Id = "Chronos_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "……呵呵……看来你身上确实继承了几分你父亲的力量。或者说，是{#Emph}我的{#Prev}力量……"
    }
    {
      Id = "Chronos_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "……啊……这地方未免太过沉闷了些……"
    }
    {
      Id = "Chronos_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "……唔呃……也许……该换换风景了……"
    }
    {
      Id = "Chronos_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "（喘息） 我以为……{#Emph}没有人{#Prev}耐得住时间的考验……更何况，区区一个{#Emph}你{#Prev}……？这怎么可能……？"
    }
    {
      Id = "MelinoeField_1404"
      InheritFrom = "BaseNarrative"
      DisplayName = "你从我这里得不到答案，也得不到怜悯。现在，给我{#Emph}去死{#Prev}。然后我要取走你的灵液。或者流淌在你体内的是其他物质，那也无所谓。"
    }
    {
      Id = "Chronos_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，哈，哈！死亡对于不朽之身来说，又有何妨？不过是个微不足道的麻烦！这座冥府为{#Emph}我{#Prev}所有。等我离去之后……你便会被逐出此地。"
    }
    {
      Id = "MelinoeField_1405"
      InheritFrom = "BaseNarrative"
      DisplayName = "我料到了。而且在我下一次回来之前，你便会重塑身躯，在王座上等着我。但我还是会回来的。如果有必要的话，我会让你死了再活、活了再死、再死、{#Emph}再死{#Prev}。"
    }
    {
      Id = "Chronos_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕这样做会搭上你家人的性命？毕竟现在他们任由我摆布，倘若你不知悔改，我随时可以收起对他们的怜悯，给他们个痛快。"
    }
    {
      Id = "MelinoeField_1406"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是{#Emph}我们{#Prev}的家人。更何况，我又有什么理由在乎？我都不认识他们。我只知道你现在马上就要去死了。有什么遗言么？"
    }
    {
      Id = "Chronos_0892"
      InheritFrom = "BaseNarrative"
      DisplayName = "……给你的遗言么，孙女……？一则提醒罢了……仅此而已……"
    }
    {
      Id = "Chronos_1402"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……你这样的家人，我真是受够了！继续啊，像他们曾经那样，把我赶出去！看看那样做会有什么好下场！"
    }
    {
      Id = "MelinoeField_5044"
      InheritFrom = "BaseNarrative"
      DisplayName = "正有此意。不过，你要是真的那么想融入这个家庭的话，也许你当初就不该对他们开战。"
    }
    {
      Id = "Chronos_1403"
      InheritFrom = "BaseNarrative"
      DisplayName = "你站在“他们”的立场上，却不想想“我们”！哈迪斯之女啊，你和我一样，在这家族中是个不受人待见的异类！过去无法改变，未来也永远如此！"
    }
    {
      Id = "Chronos_1404"
      InheritFrom = "BaseNarrative"
      DisplayName = "咳啊……你们这些神明，从来不会从过去吸取教训！你们贸然改变了一切，只为顺应自己的心意！"
    }
    {
      Id = "MelinoeField_5045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你才是不会从过去吸取教训的那个。哪怕你有那么长的时间反省自己。"
    }
    {
      Id = "Chronos_1405"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，恰恰相反……我知道在时间的作用下，改变无可避免……唯一的问题是……产生何种变化……"
    }
    {
      Id = "Chronos_1445"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……！我的家人对我做出过更出格的事情……哼，我比那时强大得多！每夜，我的力量都在增长……！"
    }
    {
      Id = "MelinoeField_5089"
      InheritFrom = "BaseNarrative"
      DisplayName = "你分明年事已高，而且疲惫不堪。你甚至都不知道自己在为何而战。为了向你的子女证明什么吗？"
    }
    {
      Id = "Chronos_1446"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们夺走了我的{#Emph}一切！{#Prev}而且还不止于此。现在他们想让你，把我{#Emph}所剩无几{#Prev}的事物一并夺走。多么畸形的家庭……"
    }
    {
      Id = "Chronos_1448"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}咳啊……！{#Prev}呵，谢谢你来看望我啊，小孙女。也许，明晚我们还能再见……？"
    }
    {
      Id = "MelinoeField_5090"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许吧。所以，告诉我，泰坦……{#Emph}这{#Prev}就是有家人在身旁的感觉么？一边苦苦相争，一边对彼此出言讥讽？"
    }
    {
      Id = "Chronos_1449"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，{#Emph}没错！{#Prev}完全就是这样！我或许致使你失去了与家人相处的机会……但这对你{#Emph}百利而无一害！{#Prev}你会明白的……"
    }
    {
      Id = "Chronos_1452"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}唔呃……！{#Prev}你当真以为……你们{#Emph}众神……{#Prev}比我更适合统治这个世界……？"
    }
    {
      Id = "MelinoeField_5091"
      InheritFrom = "BaseNarrative"
      DisplayName = "你我都知道这与之{#Emph}无关{#Prev}，泰坦。在我们对世界放任不管之时，为害世间的种种恶行只会愈发猖獗。"
    }
    {
      Id = "Chronos_1453"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果不是为了这个世界，孙女……那你觉得……这一切到底……是{#Emph}为了什么……？"
    }
    {
      Id = "MelinoeField_5092"
      InheritFrom = "BaseNarrative"
      DisplayName = "我母亲的侍女……你把她交出来。{#Emph}立刻。"
    }
    {
      Id = "Chronos_1455"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……！你居然会如此在意……{#Emph}这个女巫侍女。{#Prev}要是有任何一个家人……对我表达过一丝一毫的关心……！"
    }
    {
      Id = "MelinoeField_5093"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们又有什么理由关心你？看看你都做了什么！你企图夺取我们的{#Emph}一切！{#Prev}我们的未来！"
    }
    {
      Id = "Chronos_1456"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是{#Emph}一家人{#Prev}……我们不该夺取，而是应该{#Emph}分享！{#Prev}那就来罢，来毁灭我！倘若你真有这样的力量。到那时，你自会明白，你将亲手造就怎样的{#Emph}未来……"
    }
    {
      Id = "Chronos_1275"
      InheritFrom = "BaseNarrative"
