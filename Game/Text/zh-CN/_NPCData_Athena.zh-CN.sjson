    }
    {
      Id = "Athena_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意。"
    }
    {
      Id = "Athena_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "堂妹。"
    }
    {
      Id = "Athena_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "墨利诺厄。"
    }
    {
      Id = "Athena_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "欢迎回来。"
    }
    {
      Id = "Athena_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你在这啊。"
    }
    {
      Id = "Athena_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还好么？"
    }
    {
      Id = "Athena_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（叹气）"
    }
    {
      Id = "Athena_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Athena_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "打得漂亮。"
    }
    {
      Id = "Athena_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "干净利落。"
    }
    {
      Id = "Athena_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "借一步说话。"
    }
    {
      Id = "Athena_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "卑劣的生物。"
    }
    {
      Id = "Athena_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们需要谈谈。"
    }
    {
      Id = "Athena_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于来了。"
    }
    {
      Id = "MelinoeField_2810"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你在这！"
    }
    {
      Id = "MelinoeField_2568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "雅典娜女士……！"
    }
    {
      Id = "MelinoeField_2811"
      InheritFrom = "BaseSubtitle"
      DisplayName = "雅典娜女士！"
    }
    {
      Id = "MelinoeField_2569"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你来得太及时了。"
    }
    {
      Id = "MelinoeField_2808"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是她……"
    }
    {
      Id = "MelinoeField_2809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "抱歉又麻烦你了……"
    }
    {
      Id = "MelinoeField_2572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是我的荣幸，女士。"
    }
    {
      Id = "MelinoeField_2573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "荣誉归于奥林匹斯！"
    }
    {
      Id = "Athena_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意。"
    }
    {
      Id = "Athena_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "幸会！"
    }
    {
      Id = "Athena_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有比死亡更严酷的惩罚。"
    }
    {
      Id = "Athena_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿她引你走向正道。"
    }
    {
      Id = "Athena_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我无需他人指引。"
    }
    {
      Id = "Athena_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在这里，指引他人是我的职责。"
    }
    {
      Id = "Athena_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果你坚持的话。"
    }
    {
      Id = "Athena_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也愿她照亮我们的敌人。"
    }
    {
      Id = "Athena_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们知道这里的路。"
    }
    {
      Id = "Athena_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "指引我们走向胜利。"
    }
    {
      Id = "Athena_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "尊贵的冥界王女，终于见到你了！我是你的堂姐雅典娜，能迎接你前来奥林匹斯山是我的荣幸。只可惜现如今这里凋敝不堪，不复往日荣光。"
    }
    {
      Id = "MelinoeField_2401"
      InheritFrom = "BaseNarrative"
      DisplayName = "幸会，雅典娜女士！叫我墨利诺厄就好。请告诉我，我要向何处宣泄我的怒火，才能解放你们的要塞，让奥林匹斯山重现荣光？"
    }
    {
      Id = "Athena_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "荣幸之至，墨利诺厄。那卑鄙泰坦的军队侵入了我们最为圣洁的土地。把怒火宣泄在他们身上正合适，尤其是如此一来你便能攀上山顶，与在那里藏身的家人会合。"
    }
    {
      Id = "MelinoeField_2402"
      InheritFrom = "BaseNarrative"
      DisplayName = "宙斯圣殿。那你呢，为什么其他人没有与你并肩作战？"
    }
    {
      Id = "Athena_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为这正是我们的战略安排。你是在他们的帮助下抵达这里的，不是么？现在，我们分头行动吧。愿我的祝福能为你登上山顶提供助力。"
    }
    {
      Id = "Athena_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "前路多加小心。泰坦普罗米修斯总能避免与我照面，因为他知道我正忙于应付他的先锋部队。但倘若你步步紧逼，他便别无选择，只能应战。"
    }
    {
      Id = "MelinoeField_2403"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是先见之泰坦。他对我们的一切计划了如指掌，不是么？也因此总能施以还击。"
    }
    {
      Id = "Athena_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "他某种程度上知道未来将要发生的事情，没错。但他只能预见结果，不能读心。更何况，他知道你会来，并不意味着他有办法阻止你。"
    }
    {
      Id = "MelinoeField_2405"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前与普罗米修斯交过手吗？你说他总能避免与你照面。也许他知道你们交手的话，他完全没有胜算。"
    }
    {
      Id = "Athena_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这一切发生之前，我就和普罗米修斯相识了；或许是因为我们对“思想”有着相似的见解吧。你一定知道他为人类盗取了火种。除此之外……他还赐予了人类理智，而这理智就来自于我。至少，赐予了{#Emph}一些{#Prev}人类理智。"
    }
    {
      Id = "MelinoeField_2406"
      InheritFrom = "BaseNarrative"
      DisplayName = "不敢想象凡人在拥有理智之前都是什么样子。不过也许普罗米修斯应该留一些理智给自己用的。 "
    }
    {
      Id = "Athena_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许他以为自己留了些，或者以为自己的理智已经够用了。不幸的是，人们的理智往往是匮乏的，但很少有人勇于承认这一点。"
    }
    {
      Id = "Athena_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕你在与泰坦普罗米修斯的交锋中败下阵来，对我们的战况也会有所帮助。毕竟，他忙着对付你，就无暇在他处兴风作浪。"
    }
    {
      Id = "MelinoeField_2404"
      InheritFrom = "BaseNarrative"
      DisplayName = "这对于我来说算不上什么宽慰，雅典娜女神。这不是他首次对奥林匹斯山和我们的家族犯下罪行，因此对他的惩罚也应该更加严厉。"
    }
    {
      Id = "Athena_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事情不用你来操心。他之前受到的惩罚不仅没能让他悔改，还激发了这次更大的罪行。目前来说，我们的战略只需要他不要挡路。"
    }
    {
      Id = "Athena_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该要知道，我的父亲，也就是你的叔父宙斯，对你在这里左右大局的能力稍有怀疑。他认为凭我们自己的力量就足以自卫；而我并不反对这一点。"
    }
    {
      Id = "MelinoeField_2408"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，我们现在不应该作为一家人团结一致么？现在不是骄傲自大、拒绝帮助的时候。"
    }
    {
      Id = "Athena_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也并不反对这一点。然而，我们家族似乎总是无法长久团结一致。否则的话……这场战争根本就不该发生。"
    }
    {
      Id = "Athena_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的继母赫拉王后的青睐可非唾手可得之物。你应当要知道，她是当初第一个想要你来援助我们的。你拥有的不只是她的祝福，还有她的信任；虽然这信任并不牢固。"
    }
    {
      Id = "MelinoeField_2446"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对此十分感激，但……你知道她为什么会信任我吗？我不明白王后大人在我身上到底看到了什么样的品质，更何况我们素未谋面。"
    }
    {
      Id = "Athena_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许是因为你代表着一种不同的策略，与我们先前所决定的策略大相径庭，而那个策略出自你的叔父大人，天神宙斯之手。我们没有人喜欢承认自己判断失误，但……我们还是更渴望胜利。"
    }
    {
      Id = "Athena_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，堂妹……我有很长时间没有见过我们家人如此团结一致了。几乎每个人都齐心协力，共同对抗外敌。不过迪奥尼索司是个例外，估计他正在什么地方给自己灌得烂醉吧。"
    }
    {
      Id = "MelinoeField_2431"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果迪奥尼索司大人没有拿起武器对抗克洛诺斯的军队，那他想必有自己的理由……"
    }
    {
      Id = "Athena_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那是当然。他一定是觉得，既然可以无所事事饮酒作乐，为什么还要白费力气投身前线呢？算他走运，我还有更重要的事要处理，没有工夫把他揪出来。"
    }
    {
      Id = "Athena_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "此时此刻，我同父异母的弟弟阿瑞斯一定享受得很，不管他现在到底身处何方。这种无休无止的鏖战最合他的心意……这样一来，他就没有任何理由与我们携手结束这场战争了，不是么？"
    }
    {
      Id = "MelinoeField_2432"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说他会不会背叛了我们？如果阿瑞斯不在这里，而战事又愈演愈烈……那或许他正忙着在敌营中煽风点火呢。"
    }
    {
      Id = "Athena_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实这样考虑过，只是……倘若战事无限继续下去，我们的敌人也占不到任何便宜。而阿瑞斯只想要战争无休无止，不想要任何一方取得胜利。"
    }
    {
      Id = "MelinoeField_2433"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到这个，厄里斯对这种事情也乐见其成。她之前提到过阿瑞斯。他们该不会在合作吧？"
    }
    {
      Id = "Athena_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "按我对纷争化身的了解，她并不易于与人结盟。然而，这种可能性确实值得考虑。她一直在你的行进路线上阻拦你……也许可以从她口中打探些情报出来。"
    }
    {
      Id = "Athena_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿瑞斯终于决定加入我们的家族活动了。甚至还愿意做出妥协！既然不能让一场战争永远延续，他便退而求其次，打算接受注定会引发更多战事的结果。"
    }
    {
      Id = "MelinoeField_3173"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你对战争的看法与他不尽相同。但我不会因为信念不同就拒绝他的力量。这意味着，我也愿意做出妥协……只要最终能够迎来胜利。"
    }
    {
      Id = "Athena_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "当心这样的想法，堂妹。为了达成共识做出妥协是一回事，但在信念和原则上，在{#Emph}理想{#Prev}上妥协？这样的想法虽然有时能结束战争，但常常又会掀起另一场腥风血雨。"
    }
    {
      Id = "Athena_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许你在行进路线上遇到过大力士赫拉克勒斯。他力大无穷，而且能力出众，但倘若你注意到他有任何可疑行为，请务必向我汇报。"
    }
    {
      Id = "MelinoeField_2445"
      InheritFrom = "BaseNarrative"
      DisplayName = "我遇到过他，而且亲眼见过他摧枯拉朽一般摧毁敌军的势力，只是他不怎么与我攀谈。你所说的可疑行为，具体是指什么？"
    }
    {
      Id = "Athena_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗中通敌、违抗命令，这类的事情。我其实没有什么不信任他的理由，只是……比起他我更信任你。"
    }
    {
      Id = "Athena_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道，月神本尊正为你施以援助。这里的众神常常低估她的力量，认为她只会用黯淡的光芒照亮夜空。但我知道她的力量远不止于此。"
    }
    {
      Id = "MelinoeField_2436"
      InheritFrom = "BaseNarrative"
      DisplayName = "塞勒涅虽然身为泰坦，但她是对我们绝无二心的坚定盟友。她秉持着黑夜的意志，而我也是一样。"
    }
    {
      Id = "Athena_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "倪克斯的意志于我毫不相干，堂妹。但这似乎对你来说很重要，而倪克斯本人也一直是奥林匹斯山的盟友。只要你信任塞勒涅，这对我们来说就足够了。"
    }
    {
      Id = "Athena_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "你身上好像受了什么奇怪的魔法影响，和之前看起来不一样了。你看着……魁梧了不少。这究竟是祝福还是诅咒，我竟一时下不了判断。"
    }
    {
      Id = "MelinoeField_2442"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是个祝福，至少我是这么认为的。这道魔法出自巫术师喀耳刻女士之手，我在前来这里的海上航行中遇到了她。"
    }
    {
      Id = "Athena_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我记得她。她曾经为我想要保护的一位凡间航海家设下了好一个困局，不过估计你也不认识那个人。我会对她更提防一些。"
    }
    {
      Id = "Athena_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "你身上好像受了什么奇怪的魔法影响，和之前看起来不一样了。你是……变小了吗，堂妹？这究竟是祝福还是诅咒，我竟一时下不了判断。"
    }
    {
      Id = "Athena_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来和之前又不一样了。想必又是出自巫术师喀耳刻之手的，非同寻常的祝福吧。你确定她是在帮助你，而不是在……拿你寻开心么？"
    }
    {
      Id = "MelinoeField_2443"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻女士从不会用她的变形魔法寻开心。这是道很强大的咒语……只是有一些副作用而已。"
    }
    {
      Id = "Athena_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "从不会用魔法寻开心？我印象里的喀耳刻可不是这样的。也许她现在更懂事了些吧，但我还是持怀疑态度……"
    }
    {
      Id = "MelinoeField_2437"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，恕我唐突发问……有一个我们都认识的人，我想问一问关于她的事，因为……唔……你还记得织匠阿拉克涅么？"
    }
    {
      Id = "Athena_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "我几乎从不会遗忘任何事，堂妹。尤其是那些胆大包天，妄想与众神平起平坐的凡人。不过她严格意义上已经不再是凡人了。你要问什么？"
    }
    {
      Id = "MelinoeField_2438"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔……她现在住在厄瑞玻斯了，离我的住处很近，然后……她因为她的外表而饱受折磨。我知道这是你降下的诅咒导致的……毫无疑问，那是她罪有应得，可是……雅典娜女士，请对她仁慈一些吧……我请求你。"
    }
    {
      Id = "Athena_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡人向我苦苦求情，早已不是什么新鲜事。但堂堂一个女神，为了凡人的事情求我？而且还是因为那个凡人太过傲慢，不愿为自己求情？堂妹，这件事不要再提。"
    }
    {
      Id = "Athena_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个叫做阿拉克涅的凡间女人。你知道她都做了些什么吗？她自诩是全世界最伟大的织匠，认为哪怕是我，甚至是命运三女神，都比不上她的水平。既然事已至此，让凡人认清自己的位置，难道不是我们应尽的义务么？"
    }
    {
      Id = "MelinoeField_2440"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我见识短浅，无法回答你的问题，雅典娜女士。我也绝对不是在质疑你对她的惩罚！我只是想问，她惩罚的期限，能不能比“永远”稍短一些？她已经学会了谦卑，也从自己的过错中吸取到了教训。"
    }
    {
      Id = "Athena_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "是么？按照我的过往经验，凡人学习的过程总是{#Emph}慢得很{#Prev}。而且她的惩罚不是为了让{#Emph}她自己{#Prev}学到教训，而是为了让{#Emph}其他所有人{#Prev}得到警示。我做出决定便不会反悔，墨利诺厄。因为我的每个决定都是慎重之举。"
    }
    {
      Id = "Athena_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对于阿拉克涅的念想在让你分心，而这点现在也开始让{#Emph}我{#Prev}分心了。我愿意提出一个办法，让她的问题得到解决。"
    }
    {
      Id = "MelinoeField_4430"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？请告诉我你是怎么想的，雅典娜女士。阿拉克涅是我的朋友，如果有什么办法能帮到她的话，我愿意尽力而为。我已经知道了诅咒的来源……"
    }
    {
      Id = "Athena_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "也就是说，你需要我来令其失效。虽然你无法说服我，也许阿拉克涅可以——如果她当真如你所说，已经痛改前非的话。我的蛇发妖护符还在你那里吧？问问她是否愿意通过它与我谈话。若她同意，或许我可以去会一会她。"
    }
    {
      Id = "MelinoeField_4432"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，我……我真的不知道说什么才好，只是……你和阿拉克涅那件事，我真的很后悔。我当时很确信她找你是想求你宽恕，而不是和你再起争执。"
    }
    {
      Id = "Athena_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对这样的结果没那么惊讶；毕竟，我认识从前的阿拉克涅。也许她确实想要道歉，但她一见到我，曾经的轻狂就全都回来了。无论如何，事情都已经发生了。"
    }
    {
      Id = "MelinoeField_4433"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我明白。不过，如果我可以问的话……她到底做了什么，才让你对她降下神罚？我知道她和你比了一场，但只听过她的说法。"
    }
    {
      Id = "Athena_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "输给一介凡人，确实出乎我的意料，让我羞愧难当。然而，激起我怒火的，是阿拉克涅的傲慢，而不是我对她杰出才能的妒忌。她居然敢说我的作品{#Emph}没有灵魂。"
    }
    {
      Id = "MelinoeField_4434"
      InheritFrom = "BaseNarrative"
      DisplayName = "她对你出言不逊……确实是短视之举，而且我没理解错的话，那时的她还很年轻。要是她知道……"
    }
    {
      Id = "Athena_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "上一次，她确实知道。然而她还是那样做了。我们对凡人的期待很低，只要他们诚心悔过就好。对于阿拉克涅这样的人，以儆效尤就是最好的处理方式。自此之后，我将对她只字不提。"
    }
    {
      Id = "Athena_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "你让我最近开始思考凡人的事情。我也一直密切关注着凡人和他们所受的苦难，并因此屡次出手相助。尤其是那些展现出超凡才干的人。而且我也希望让他们对其他神明以及我的崇敬之情有所回报。"
    }
    {
      Id = "MelinoeField_2441"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你之前说过，让凡人认清自己的位置，是我们应尽的义务……你认为他们说到底，对我们毫无还手之力。"
    }
    {
      Id = "Athena_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，因为他们的数量远超我们，许多人形成了机敏而独立的性格。有些人认为他们不需要我们，但事实并非如此。生前自然不用多言；哪怕是在死后，他们也要归你父亲掌管。总之，最好不要对凡人产生{#Emph}不必要的情感依赖{#Prev}。"
    }
    {
      Id = "MelinoeField_2414"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来就好像你在一个人抵御入侵者一样，雅典娜女士。有这么大一座山需要防守，盟友却寥寥无几……"
    }
    {
      Id = "Athena_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……至少我们还有{#Emph}你{#Prev}，堂妹。至于我们{#Emph}其他的{#Prev}盟友……我们家族一向以来不屑于求助于人。对我们所有的信徒和同胞，我们释放的信号都很明确：一切尽在掌控之中。"
    }
    {
      Id = "MelinoeField_2415"
      InheritFrom = "BaseNarrative"
      DisplayName = "那请恕我直言，这是实情么，还是说只是在虚张声势？在我看来，你们显然有些招架不迭。"
    }
    {
      Id = "Athena_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "恰恰相反，我们的自动机非常高效，将许多敌人拒之门外。而且只要你我二人不要耽搁太久，也能对战局起到立竿见影的影响。"
    }
    {
      Id = "Athena_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "堂妹，你当真抵达了你父亲冥界的最深处，在那里击败了泰坦克洛诺斯吗？他的军队突然四散而逃，而我不敢贸然相信自己的直觉。"
    }
    {
      Id = "MelinoeField_2407"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，我最近确实击败了他。终有一夜我们会让他彻底毁灭，但现在，我们只能先用这些小小的胜利当作慰藉了。"
    }
    {
      Id = "Athena_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "这可不是“小小的胜利”，这是至关重要的胜利。但我完全理解你的心情：永远不能骄傲自满，否则便会丧失继续抗争的斗志。"
    }
    {
      Id = "Athena_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经见到了在山顶袭击我们的生物，是么？就是他导致的最近那些震动……仿佛山脉都在恐惧中颤抖。我们需要一个计划……"
    }
    {
      Id = "MelinoeField_3168"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神之前也与提丰交过手。最后，不是宙斯精准地降下一道天雷，将他解决掉的么？"
    }
    {
      Id = "Athena_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "英勇的传说并不总是等同于英勇的{#Emph}行为{#Prev}。总之，我们把提丰引上山顶吧，在那里你与我们联手，就是我们最大的机会……还有，务必保重，堂妹。"
    }
    {
      Id = "Athena_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢命运三女神，你逃过了提丰的怒火。而且你还为我们争取到了足够的时间，让我们巩固防线，抵挡住了那个魔物，至少暂时如此。"
    }
    {
      Id = "MelinoeField_3169"
      InheritFrom = "BaseNarrative"
      DisplayName = "但他还会回来的。你有发现他的任何弱点吗？比起单纯地分散他的注意力，我还想做到更多的事。"
    }
    {
      Id = "Athena_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "体型那样庞大的生物不会有很多弱点……不过，没有生物喜欢被捅眼睛；而提丰的眼睛数目繁多，或许这既是他的长处，也是他的弱点。此外，如果我们能团结一致，齐心协力……也许就有机会让他知难而退。"
    }
    {
      Id = "Athena_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "多亏了你的帮助，我们才得以击退提丰那个魔物！所以这是能够实现的！只可惜那个卑鄙的生物很快就恢复了过来，然后再一次开始了攀登……"
    }
    {
      Id = "MelinoeField_3170"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定有一种办法能够彻底消灭提丰，而不只是拖慢他行进的步伐。但如果就现在而言，我们能取得的最好的结果就是拖慢他……那也无妨。"
    }
    {
      Id = "Athena_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "他被称作{#Emph}众魔之父{#Prev}……当然，我对他的故事早已耳熟能详，但是{#Emph}亲眼{#Prev}见到他……我感觉我的勇气几乎都动摇了，这比起那个生物本身，还要令人恐惧……"
    }
    {
      Id = "Athena_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次我们成功抵御提丰的怒火，他都会卷土重来，唯一的区别或许只是变得更加愤怒。克洛诺斯派这个生物来攻打我们，真是个聪明的计策……让我们疲于应付，以便他谋划下一步行动。"
    }
    {
      Id = "MelinoeField_3171"
      InheritFrom = "BaseNarrative"
      DisplayName = "这究竟是聪明，还是鲁莽，恐怕犹未可知。克洛诺斯指望着提丰将满腔怒火全部倾泻在奥林匹斯山上，但在那之后呢……？哪怕是{#Emph}他{#Prev}，也无法控制这样的魔物。"
    }
    {
      Id = "Athena_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许克洛诺斯计划等我们不再构成威胁，就把那个魔物重新封印起来吧。无论如何，我们是不会想要让事态发展到那一步的。"
    }
    {
      Id = "Athena_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "堂妹，深思熟虑之后我得承认，我目前阻止提丰的最好计划……就是依靠{#Emph}你{#Prev}的力量。第二好的计划……将会引来极其可怕的后果。"
    }
    {
      Id = "MelinoeField_4425"
      InheritFrom = "BaseNarrative"
      DisplayName = "叔父宙斯大人暗示过，如果他们动用某种力量，或许能击败那个魔物，但同时会给奥林匹斯山带来毁灭性的打击……你说的第二好的计划，是指这个么？"
    }
    {
      Id = "Athena_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。如你所见，我的精力都用在了这里，在前线击退敌军。但现在看来，我还得分出精力去说服我的父亲，让他不要引发更大的灾难，哪怕只是为你争取时间。我在指望着你……我们所有人都是。"
    }
    {
      Id = "Athena_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "有许多人曾经称我为救星，我也常常乐于看到近乎绝望的形势得到逆转。但最近，我自己的希望却动摇了……直到{#Emph}你{#Prev}让其重新燃起。众魔之父真的被你消灭了。"
    }
    {
      Id = "MelinoeField_4426"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山属于众神……提丰的毁灭，实为必要之举。虽然将他送入虚空的确实是我，但实现这件事，靠的是我们所有人的力量。"
    }
    {
      Id = "Athena_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些冥府诸神真是谦逊得如出一辙。{#Emph}骄傲{#Prev}一些吧，堂妹！你取得了光荣的成就，对此我们都非常感激。我知道我当时{#Emph}只能{#Prev}相信你。但我同时还感觉，相信你是应该的。"
    }
    {
      Id = "Athena_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得向你道歉，那个名叫“塔罗斯”的自动机对你出手绝非我们的本意。那个巨大而危险的机械在你身上侦测到了冥界的气息，因此……"
    }
    {
      Id = "MelinoeField_2410"
      InheritFrom = "BaseNarrative"
      DisplayName = "那台机器相当宏伟，赫菲斯托斯大人应该为之骄傲……不过，这些自动机识别敌人的方式可能需要全方位的升级。"
    }
    {
      Id = "Athena_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一定会为你传达这则建议的。只可惜赫菲斯托斯大人为塔罗斯设计的自我修复系统的优先级高于威胁识别，因此它的麻烦恐怕一时半会儿无法解决。"
    }
    {
      Id = "Athena_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "我仍然不觉得我们用于防御的自动机达到了值得信赖的程度。我已经告诉过赫菲斯托斯，我不会容忍它们的异常行为；如果你遇到了这种情况，也不用手下留情。"
    }
    {
      Id = "MelinoeField_2409"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们的性能令人赞叹，但似乎无法完全分清敌我。也许赫菲斯托斯可以对它们的设计做些优化。"
    }
    {
      Id = "Athena_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，我们已经将这项内容加入了长长的申请列表之中。无论如何，要想让自动机换代，我们都得报废掉现有的这一批……所以如果你在这里把它们毁掉的话，其实也是一件好事。"
    }
    {
      Id = "Athena_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "能与你当面交谈，感觉真是奇特。我和你的哥哥扎格列欧斯曾经交流颇多，但只有一次是当面的，别的时候都是通过祝福。你一定知道当时他在家里遭受的那些磨难。现在看来，轮到你们那一支的家族回报我们了。"
    }
    {
      Id = "MelinoeField_2424"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果说有什么恩情要回报的话，请恕我对此一无所知，雅典娜女士。我来这里是因为家族有难，冥府和奥林匹斯山的支系都未能幸免。"
    }
    {
      Id = "Athena_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是自然，我没有什么言外之意，只是在感慨此一时，彼一时。就让我用祝福来回报你的慷慨相助吧。"
    }
    {
      Id = "Athena_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我们帮你的哥哥解决了那些家事之后，你的母亲珀尔塞福涅每年的特定时段都会在奥林匹斯山上度过。那天她没有出现；我真应该相信自己的直觉……"
    }
    {
      Id = "MelinoeField_2425"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯大概就是那时袭击的冥府。我母亲的突然失踪，没有引起一定程度的警惕么？"
    }
    {
      Id = "Athena_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "按说应当如此。然而，我们知道你的母亲当时怀有身孕，因此最终得出结论，认为你们是想要些隐私，欢迎新的家庭成员。所以我们就耐心地等待着，对克洛诺斯篡夺冥府一事浑然不觉。我真是大错特错……"
    }
    {
      Id = "MelinoeField_2426"
      InheritFrom = "BaseNarrative"
      DisplayName = "你父亲和我父亲曾经携手击败过克洛诺斯，那时我们两个都还压根没有出生。没有料到泰坦王突然会卷土重来，这也怨不得你。"
    }
    {
      Id = "Athena_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "但既然我是奥林匹斯的军师，我就该考虑到每一种潜在的隐患，哪怕概率微乎其微。无论如何，这都是个惨痛的教训……"
    }
    {
      Id = "Athena_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以阿尔忒弥斯在厄瑞玻斯的迷雾中发现了你，彼时你正接受赫卡忒的教导？真是一件奇事。能和我多讲一讲具体的情况么？"
    }
    {
      Id = "MelinoeField_2428"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒老师收到了严格的命令，不能把我的存在向任何人透露，除了她关系最紧密的同袍；我只能向你透露这么多。直到袭击克洛诺斯的机会来临，她才得以采取行动。"
    }
    {
      Id = "Athena_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧。我清楚奥林匹斯山和冥府之间一直对彼此有所保留；这样很可能是最好的安排。只不过，我的职责需要我常常刨根问底，这点还望你理解。"
    }
    {
      Id = "Athena_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯说，命运三女神被劫持了。真是这样的话，我们的形势恐怕要比预想的严峻许多。然而……我从来不愿让自身的胜利依赖于外在因素；希望这句话不要冒犯到你。"
    }
    {
      Id = "MelinoeField_2427"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我明白你的意思。克洛诺斯害怕自己又栽在某条命运预言上，就像你我的父亲推翻他的时候那样。但倘若命运三女神不再决定未来……那未来就掌握在我们手中。"
    }
    {
      Id = "Athena_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是。任何策略的最终目标，便是尽可能少地依赖运气。我们只会依靠那些证明自己可靠的人，而且最重要的是，我们要靠自己。"
    }
    {
      Id = "Athena_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "按我的理解，你的哥哥受到了某种诅咒，一旦试图涉足冥界之外的区域，便会逐渐流失生命力。但你似乎没有受到这样的限制？"
    }
    {
      Id = "MelinoeField_2430"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是找到了办法延缓诅咒对我的影响，但我的力量仍然在逐渐流失，即使是现在我也感觉得到。就算敌人没有迫使我退入阴影之中，诅咒最终也会让我打道回府。"
    }
    {
      Id = "Athena_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "居然是这样。没想到你暗自承受了这样的事情，墨利诺厄。所以你的任务，从不止一种层面上来说，都是在和时间赛跑。那我就不再耽误你的时间了。"
    }
    {
      Id = "Athena_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "你戴着我给你的护符。愿我不在你身边的时候，它可以代我护你周全，让敌人不寒而栗。"
    }
    {
      Id = "MelinoeField_2434"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你，雅典娜女士。这上面雕刻着的生物……是个蛇发妖，对么？它们是某种守卫吗？"
    }
    {
      Id = "Athena_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，不，这算是某种警示。它在提醒人们，当我们众神公然遭到侮辱时，会发生什么样的事情。出门在外，最重要的是不要失去理智，堂妹。"
    }
    {
      Id = "Athena_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必这就是厄瑞玻斯的深幽密林了，你们行动的总部就在这附近。现在我看出来阿尔忒弥斯为什么会对此地印象深刻了。"
    }
    {
      Id = "MelinoeField_4436"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎，雅典娜女士！也许凡是树林阿尔忒弥斯都喜欢吧，毕竟就连这片满是不得安宁的失落亡魂的林地，也能得到她的青睐。"
    }
    {
      Id = "Athena_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实和奥林匹斯山相比有天壤之别。但我不是来这里勘察地形的，所以请快选吧。"
    }
    {
      Id = "Athena_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "俄刻阿诺斯的深渊……我经常会从空中掠过，或是从水面上经过此地，但却不常有机会看到它里面的样子。所以，这就是你绕开至福乐土的办法。"
    }
    {
      Id = "MelinoeField_4437"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，这里可以绕道前往冥界最深处。也许有你在，那些鱼一样的可怕怪物就会被吓退一部分。"
    }
    {
      Id = "Athena_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "如此原始的生物很少能感到恐惧，但我们会尽力教会他们。"
    }
    {
      Id = "Athena_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……这片哀悼原野和地表一望无际的平原有些共性，但这里的空气却非常凝重。"
    }
    {
      Id = "MelinoeField_4438"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你在这样的地方也愿意找到我，雅典娜女士。就算你可以，我也不建议你在此久留。"
    }
    {
      Id = "Athena_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "而我也不建议他人被我的矛刺穿，然而这种事情有时无可避免。愿你无可避免闯过此地时，停留的时间尽可能短。"
    }
    {
      Id = "Athena_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么多黄金……塔耳塔罗斯怎么变成了这副样子？克洛诺斯将其改造得简直面目全非……"
    }
    {
      Id = "MelinoeField_4439"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许下次我在这里召唤你的时候，你可以去当面问问他，雅典娜女士。"
    }
    {
      Id = "Athena_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，要是我可以，而且我的护符更强力的话，我又何尝不愿意呢。但所有的策略都有其局限性。在你面对你的目标时，我只能以祝福的形式支援你，而无法亲身前来助战。"
    }
    {
      Id = "Athena_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，至少这里没有下雪。我原本以为这样的破坏会集中在奥林匹斯山，没想到就连埃费拉城也遭到了殃及。"
    }
    {
      Id = "MelinoeField_4440"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦的军团洗劫这座城市，或许是出于它的象征意义……他们想让这里改旗易帜，同时摧毁冥王和冥后的所有雕像。"
    }
    {
      Id = "Athena_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "劫掠不需要任何预先谋划，也不需要任何战略意义，而且其结果显而易见。然而，我看不出这样做对于说服凡人与我们为敌有任何好处。"
    }
    {
      Id = "Athena_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "这艘船舰的腐烂甲板……我们现在身处波塞冬叔父的裂谷里，泰坦大军的舰队之中。你每夜都用这样的手段抵达我们的神山么？"
    }
    {
      Id = "MelinoeField_4441"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……有些夜晚我会转而前往冥界，除此之外，呃，是的。我在学习飞行或是跨越界域的方面没有取得多少成功。"
    }
    {
      Id = "Athena_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的机智着实令我欣赏……你，或是规划出这条路线的人，将敌军的动向巧妙变为了自身的优势。"
    }
    {
      Id = "Athena_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们骄傲的神山遭到了如此恐怖的袭击。真是无可容忍……我常常会自我反思，思考有没有预防这一切发生的办法。"
    }
    {
      Id = "MelinoeField_4442"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想不到什么好的答案，雅典娜女士。敌人在海陆空三线同时向奥林匹斯山进军，哪怕是自动机也没有办法将他们全部拒之门外。"
    }
    {
      Id = "Athena_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我们能做的{#Emph}永远{#Prev}比那些没有心智的机器更多。我们本可以做得更多！不过，现在……我们最好还是专注于让这一切走向结局，而不是探讨这一切的起因。"
    }
    {
      Id = "Athena_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以克洛诺斯所言非虚……这些提丰未被消灭的可能性确实存在。又或许是蛇发妖护符的作用，让我也看到了你的幻觉。"
    }
    {
      Id = "MelinoeField_4443"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我眼里看起来都很真实……尤其是在我重新走过了来时的路线之后。但我们可以在这里阻止他，就像我们之前所做的那样。"
    }
    {
      Id = "Athena_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就如此吧。只要当前的战术能够取得优秀的成果，就没有必要再节外生枝。"
    }
    {
      Id = "Athena_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜的夜色比最近的其他夜晚还要凝重，而我们的敌人也来势更猛。要么是克洛诺斯有了新的手段，要么……或许是我在前线战斗得太久，以至于出现幻觉了吧。"
    }
    {
      Id = "MelinoeField_2435"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是你的幻觉，雅典娜女士，这是黑夜的意志。虽然这个效果看起来会对我们不利，但我向你保证，我们会因此变得更加强大。"
    }
    {
      Id = "Athena_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的保证通常对我来说毫无意义，堂妹。但你比我更加了解黑暗。如果这真的是黑夜的意志，而不是我们敌人的手段，那我就可以松一口气了。"
    }
    {
      Id = "Athena_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在来的路上有感受到地震吗，堂妹？我对此毫不在意。波塞冬伯父最开始装得好像那是他的手笔，但似乎就连他也不清楚真正的来源……"
    }
    {
      Id = "MelinoeField_2411"
      InheritFrom = "BaseNarrative"
      DisplayName = "在冥界，我们经常能感觉到地震，因为大地就在我们四面八方，生机勃勃地律动着。但这样的震动在这里也能感觉得到，确实让我很惊讶……"
    }
    {
      Id = "Athena_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "可能因为这不仅仅是大地生机勃勃的律动。这背后一定是敌军的阴谋，我很确定。"
    }
    {
      Id = "Athena_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "你先是在你父亲的冥界打败了克洛诺斯，然后又在我们的山巅击败了提丰。我必须得承认，我初次与你相见时，低估了你的实力。"
    }
    {
      Id = "MelinoeField_3172"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，我一生都在为此训练。若是无法取得这样的结果，那我就辜负了其他人对我的信任。更何况……我们的战斗还没有结束。"
    }
    {
      Id = "Athena_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在赫卡忒门下为击败克洛诺斯做足了训练，这点我清楚。但迎战提丰，肯定不在你训练的范畴之中。不过，我也不喜欢接受过多的赞美，尤其是诚如你所言，我们的战事还没有取得最终的胜利。"
    }
    {
      Id = "Athena_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "你持有的是暗夜的武器。初见时我对此有所怀疑，但现在我可以确定。冥界受到威胁之时，这些武器会是最后的底牌，这没问题。但这里恐怕远远超出了它们的管辖范围。"
    }
    {
      Id = "MelinoeField_2444"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥界面对的危机，显然已经波及到了奥林匹斯山。在我使用的过程中，这些武器证明了自己的能力；它们在地表和地底都不负所望。"
    }
    {
      Id = "Athena_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你要确保它们的力量不要失控，更不要屈服于杀戮的渴望。我宁愿使用没有自我意识的武器，但我也无法否认它们有巨大的潜能。"
    }
    {
      Id = "Athena_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到你让我很高兴，墨利诺厄，毕竟之前好几个夜晚，我们都没有像这样在战场上相遇。在地底的战斗进展如何？"
    }
    {
      Id = "MelinoeField_2412"
      InheritFrom = "BaseNarrative"
      DisplayName = "战斗还在继续。泰坦的大军夜复一夜地重整旗鼓，而他则反复强调自己“永远不会停止”。但我正在想办法推翻这一点。这边有什么新闻么？"
    }
    {
      Id = "Athena_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "如你所见，奥林匹斯山仍然屹立不倒；只要这点得到保证，其他一切都不在话下。也许有了你的帮助，再以此对战略加以改动，我们就能最终找到破局之法。"
    }
    {
      Id = "Athena_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的战事让我们无暇他顾。我以前很喜欢编织，你知道么。有很多宏伟的挂毯就出自我手。希望这一切结束之后，我有机会重拾这个爱好。你呢，平常你都是怎么打发时间的？"
    }
    {
      Id = "MelinoeField_2429"
      InheritFrom = "BaseNarrative"
      DisplayName = "我，呃……我喜欢跟人过招！可以锻炼我的力量和身手。还有精进我的巫术。探究魔法、生者和亡灵，以及它们之间的联系。"
    }
    {
      Id = "Athena_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我对巫术并不陌生。不过，这些听起来都像是你为当下的事情所作的准备！不过我明白，现在不是异想天开的时候；还是就此打住吧，免得耽误正事。"
    }
    {
      Id = "Athena_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "你负伤了，堂妹……虽然我或许不该惊讶。攀登到这里绝非易事，更何况你还刚穿越了色萨利裂谷。你还好么？"
    }
    {
      Id = "MelinoeField_2413"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的伤势不会阻止我继续前进，雅典娜女士。不过，至于我究竟有没有力气击败普罗米修斯，乃至之后等待我的事物……这我就无法保证了。"
    }
    {
      Id = "Athena_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争之中什么都无法保证，除了血流漂杵的场面——阿瑞斯一定会认同这一点，也不知道他跑到哪里享受去了。来吧，让我助你重整旗鼓，好继续战斗下去。"
    }
    {
      Id = "Athena_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一件东西想要送给你，堂妹。感谢你一直在我们神山的防御中起到至关重要的作用。"
    }
    {
      Id = "MelinoeField_4444"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是我的荣幸，雅典娜女士。像我们这样的家族，理应在困难时期拧成一股绳。我想要尽我自己的一份力。"
    }
    {
      Id = "Athena_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "不止是我，我们整个家族都对你的能力大为欣赏；或者我应该说其中绝大多数。因此，我将赐予你我最强大的力量。愿它很快能为你带来更大的成就。"
    }
    {
      Id = "Athena_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们取得了重大的胜利，堂妹。虽然彻底消灭敌人作为一场战争的结果而言可以接受，但战至对方缴械投降往往更好。相信其他人已经向你表达过感谢了？"
    }
    {
      Id = "MelinoeField_4445"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，当然啦。我也要向你们表达我的祝贺，雅典娜女士。我唯一的遗憾是，这场守城战不能立即宣告终止，毕竟我们之后还用得上这些敌人。"
    }
    {
      Id = "Athena_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必为此感到遗憾，奥林匹斯山上的残兵败将已经不足为虑。至于普罗米修斯，虽然我对他在新的方略中扮演的角色表示怀疑，但我还是说服了父亲同意他的提议，至少暂时如此……"
    }
    {
      Id = "Athena_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在你需要去面对我们两个大敌的残迹，上至我们的山顶，下至塔耳塔罗斯……而且需要重新走过之前的路线，来让事情的可能性保持一致……？"
    }
    {
      Id = "MelinoeField_4446"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的爷爷差不多就是这么解释的。就好像我们在规避这些因为各种原因最终宣告失败的结局。"
    }
    {
      Id = "Athena_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "那这样的结局应该数量相当稀少。因为我们不会失败；只是需要一定的时间才能成功而已。"
    }
    {
      Id = "Athena_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲的宫殿现在关门改造了，可能和你父亲的冥府正在经历的事情差不多……抱歉让你在一夜的辛苦后，连个歇脚的去处都没有。"
    }
    {
      Id = "MelinoeField_4451"
      InheritFrom = "BaseNarrative"
      DisplayName = "没关系，雅典娜女士，我不能在这里停留超过必要的时间，而且在我自己的家里恢复精力也会快得多。"
    }
    {
      Id = "Athena_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "你战斗起来显得毫无阻碍，但我知道地表仍会让你喘不过气。你能掌握抑制命运诅咒的办法，实在是令人赞叹。"
    }
    {
      Id = "Athena_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我有考虑过，倘如命运三女神永远也没有被找到，我们该如何继续前进。但我没有料到的是，她们被找到了，却仍然要离开岗位……至少我听说是这样的。"
    }
    {
      Id = "MelinoeField_4447"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们已经持续编织了千万年，可能已经很累了，甚至还可能是因为他人不懂感激而心灰意冷。又或者是她们喜欢在她们没有编织时所发生的事。她们确实给了我们一个重磅预言，某种意义上也算是分别的礼物了。"
    }
    {
      Id = "Athena_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于另一个时代的预言，说我们众神将会将权力让渡给凡人……这让我很难想象。不过，命运的预言应验时，实现的方式也从来不会与想象中的完全相同。"
    }
    {
      Id = "MelinoeField_4448"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实……而且话说回来，我一直没能分辨出命运三女神究竟是愤怒，是失望，抑或有没有类似的情绪……恰恰相反，她们看起来很热情。"
    }
    {
      Id = "Athena_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们是织匠，在布匹上织出的，乃是宏大而错综复杂的史诗。也许她们只是以此寻欢作乐，而我们只是供她们编排的角色罢了。"
    }
    {
      Id = "Athena_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们已经打了这么多场战斗，还有很多战斗在等着我们。但我们女神从来不知疲倦。只要你选择继续，就随时可以指望我。"
    }
    {
      Id = "MelinoeField_4449"
      InheritFrom = "BaseNarrative"
      DisplayName = "选择继续……有时我会感到这是我的责任，雅典娜女士。提丰和克洛诺斯的可能性……如果不是我们，还有谁能阻止他们？"
    }
    {
      Id = "Athena_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "良好的战术需要采取一切措施防止意外发生，但在需要的时候，也可以调整策略、见机行事。就让我们在合理的限度内消灭尽可能多的可能性，而不要耽误其他重要的事情。"
    }
    {
      Id = "Athena_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会留在这里，以绝后患。继续向前迈进吧！"
    }
    {
      Id = "Athena_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "继续攀登吧，我会让泰坦手下的乌合之众无暇他顾。"
    }
    {
      Id = "Athena_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们似乎一直没有长进，不是么？但他们也一直不知停止。"
    }
    {
      Id = "Athena_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望我们在这里的防御工事没有给你带去太大的麻烦。"
    }
    {
      Id = "Athena_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "只要我们一家人团结一致，就没有无法攻克的难关。"
    }
    {
      Id = "Athena_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "从这里到山顶的每个敌人，都该尝一尝我的怒火。"
    }
    {
      Id = "Athena_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "快去众神的宫殿吧，堂妹，我的祝福与你同在。"
    }
    {
      Id = "Athena_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "又一场胜利近在咫尺。去吧，我会为你提供掩护。"
    }
    {
      Id = "Athena_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争仍然在我们身边打响，墨利诺厄。我们敌人开始的事情，就让我们来结束吧。"
    }
    {
      Id = "Athena_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论泰坦如何努力，我们在这座山上的要塞都绝不会倒下。"
    }
    {
      Id = "Athena_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "继续攀登吧，堂妹，愿你的双足永不动摇。"
    }
    {
      Id = "Athena_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "快去吧，路上小心。我的父亲和其他人都在山顶等你。"
    }
    {
      Id = "Athena_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到你回来我很高兴，因为这样一来，我们的计划就可以继续推进了。"
    }
    {
      Id = "Athena_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就是能解我们燃眉之急的援军；你能来到这里，我感激不尽。"
    }
    {
      Id = "Athena_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "真希望我们可以并肩作战。然而我们分头行动，成效会更为显著。"
    }
    {
      Id = "Athena_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们敌人像蝼蚁一般朝我们用来，我们也将把他们当作蝼蚁一般消灭。"
    }
    {
      Id = "Athena_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就知道，今夜的这个时候，你会在这里出现。"
    }
    {
      Id = "Athena_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "在战争最终尘埃落定之前，我们还会取得许多场这样的胜利。"
    }
    {
      Id = "Athena_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "单是击败敌人还不够；要对他们施以惩戒，以儆效尤。"
    }
    {
      Id = "Athena_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山的山巅在等待你；去吧，我会为你在此断绝后患。"
    }
    {
      Id = "Athena_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你在冥界还有大仇未报，但还是前来帮助我们，我们很是感激。"
    }
    {
      Id = "Athena_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能走到这里，全凭你的精湛技艺，但也许我能帮上一帮。"
    }
    {
      Id = "Athena_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们胆敢与众神为敌，就该让他们悔不当初。"
    }
    {
      Id = "Athena_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜就如同明月本尊在为我指引方向一般，我轻轻松松就找到了你。"
    }
    {
      Id = "Athena_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "千万年来，我们的家族始终屹立不倒。这次的风波终会平息，一如既往。"
    }
    {
      Id = "Athena_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些胆敢反抗我们正当统治的人，必须严惩不贷。"
    }
    {
      Id = "Athena_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "立即动身前往宫殿吧，我会掩护你的，墨利诺厄。"
    }
    {
      Id = "Athena_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若缺少执行策略所必须的技能，再好的策略又能派上什么用场呢？"
    }
    {
      Id = "Athena_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦的军队不知恐惧为何物，但我相信他们早晚能学会恐惧我们。"
    }
    {
      Id = "Athena_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿我赐予你的祝福足以改变战斗的走向。"
    }
    {
      Id = "MelinoeField_2416"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，趁我们现在有片刻喘息之机，我想把这瓶蜜露作为礼物送给你，以示我的感激。要是我知道我们会在这里相遇，我一定会更快赶来这里。"
    }
    {
      Id = "Athena_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么可能，我相信你已经尽可能快了。啊，当然，我欣然接受你的礼物，只不过我会先把它收着，直到我们迎来胜利再享用。不过，我的回礼，或许能更快派上用场……"
    }
    {
      Id = "Athena_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈。就算我再怎么考虑每一种可能性，在我们如今身处的纷争之中畅饮蜜露，对我来说仍然是匪夷所思。不过，为之翘首以盼还是值得的。"
    }
    {
      Id = "MelinoeField_2418"
      InheritFrom = "BaseNarrative"
      DisplayName = "能让你翘首以盼的话，那这份礼物就比我预想得还要成功。在和平年代，啜饮一口蜜露……确实听起来很美妙。"
    }
    {
      Id = "Athena_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有必要这样向我示好。在战事之中的凡人常常会为我献礼，以求我引领他们走向胜利。但你我有共同的目的，因此我不需要你为我提供额外的动机。"
    }
    {
      Id = "MelinoeField_2419"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是为你提供动机，只是一种向你表达感谢的方式。谢谢你愿意接纳我，也谢谢你认识到我的潜力，让我在家族亟需之时能够前来援助。"
    }
    {
      Id = "Athena_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢，这是我的荣幸。这瓶蜜露跟着你去过冥界，又回到了这里。想必它的口感会更丰富几分。"
    }
    {
      Id = "MelinoeField_2420"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果这瓶蜜露真的走到了世界尽头，然后又辗转回到自己的故乡的话，那它对于像你这样博学多闻的神明来说，就更加合适了。愿你在放下武器之后，有机会好好享受它。"
    }
    {
      Id = "Athena_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "按这个阵势，用不了多久，我们就能办一场能与迪奥尼索斯相匹敌的宴会了！那就让我们全力奋战，让这样激动人心的未来成为可能吧。"
    }
    {
      Id = "MelinoeField_2421"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一瓶蜜露祝你能有足够的时间享受宴会，而不是终日排兵布阵。不过，还是不要和迪奥尼索斯为敌啦，哪怕只是在办宴会这种事上……！"
    }
    {
      Id = "Athena_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "生活在家人之中，似乎意味着周围会有很多观念相近之人，可是……奥林匹斯山上与我志同道合之人寥寥无几。甚至我敢说，一个也找不出来。然而你……唔，至少我们有一点不同；我绝不会在这种时候考虑送出蜜露。"
    }
    {
      Id = "MelinoeField_2422"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女士，能够与你并肩作战、赢得你的祝福和信任，是我的荣幸。我有时会忘记表达自己的感激之情，因此希望这份蜜露能代我表达。"
    }
    {
      Id = "Athena_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是行动的女神，而非言语的女神；感谢你这份饱含深意的礼物，纵使时机有些古怪。不过，在敌人被我们尽数歼灭之前，就让它成为你向我送出的最后一份赠礼吧。"
    }
    {
      Id = "MelinoeField_2423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "MelinoeField_4427"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有某种象征性的礼物要送给你，雅典娜女士，因为我知道仙酒很快就会再度在奥林匹斯山上流淌。愿这瓶特别的仙酒能为重建工作提供帮助，也能让你多多回想起我们共同取得的胜利。"
    }
    {
      Id = "Athena_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "不需要它的提醒，我也会牢记我们的胜利，以及你的慷慨；在重建最终完成后，这点也不会改变。如果没有你的话，真不敢想象我们会做出什么样的事情……"
    }
    {
      Id = "MelinoeField_4428"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯众神已经统治了千万年，克服了无数威胁与挫折。这一切都只是另一道阻碍罢了，你们肯定会找到解决办法的。尤其是{#Emph}你{#Prev}。"
    }
    {
      Id = "Athena_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算没有我的祝福，你也很擅长把赞美之词反弹开啊。那么，好吧！自谦总比自吹自擂要好，不过要我说，你可以再向这两者的中间地带靠拢一些。不过，也可能恰恰相反，我们都该向你学习才是。"
    }
    {
      Id = "MelinoeField_4429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就让我们都做自己吧。"
    }
    {
      Id = "MelinoeField_2417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "能收到这样的礼物是我的荣幸，女神。"
    }
    {
      Id = "Athena_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "省省力气吧。"
    }
    {
      Id = "Athena_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会在这里与你对练。"
    }
    {
      Id = "Athena_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我没有那个时间。"
    }
    {
      Id = "Athena_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "住手。"
    }
    {
      Id = "Athena_0071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是幽默。"
    }
    {
      Id = "Athena_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "冷静些，堂妹。"
    }
    {
      Id = "Athena_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯？"
    }
    {
      Id = "Athena_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等你准备好……"
    }
    {
      Id = "Athena_0075"
