    }
    {
      Id = "Dionysus_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "自便，不用客气！"
    }
    {
      Id = "Dionysus_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "又回来了！"
    }
    {
      Id = "Dionysus_0058"
