      DisplayName = "帅耶！"
    }
    {
      Id = "Dionysus_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "反正那家伙应该也没有被邀请……"
    }
    {
      Id = "Dionysus_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿，那是{#Emph}我{#Prev}的粉丝！"
    }
