      DisplayName = "哈？"
    }
    {
      Id = "Dionysus_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？{#Emph}哦！"
    }
    {
      Id = "Dionysus_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "大家快看！"
    }
    {
      Id = "Dionysus_0055"
      InheritFrom = "BaseNarrative"
