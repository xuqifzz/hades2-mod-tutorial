    }
    {
      Id = "Dionysus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "喝吧，喝吧，喝吧，喝吧！{#Emph}哈哈，好啊！"
    }
    {
      Id = "Dionysus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你知道我是怎么说的吗？我说：“老爸……”{#Emph}哈。{#Prev}我说：“老爸，那要是我就是不愿意呢？”然后他就说：{#Emph}“那就给我滚！”{#Prev}于是我就说：{#Emph}“好啊！我这就滚，保证滚得远远的！哈哈哈哈哈哈！”"
    }
    {
      Id = "Dionysus_0043"
      InheritFrom = "BaseNarrative"
