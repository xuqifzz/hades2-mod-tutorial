    }
    {
      Id = "Dionysus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，拜托，我{#Emph}压根就不想知道{#Prev}外面又出了什么动静。我们这里搞出来的，才是{#Emph}最大的动静！"
    }
    {
      Id = "Dionysus_0294"
      InheritFrom = "BaseNarrative"
