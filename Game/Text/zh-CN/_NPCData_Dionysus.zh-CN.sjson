    }
    {
      Id = "MelinoeField_2576_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "感谢你的慷慨。"
    }
    {
      Id = "MelinoeField_2577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "玩得开心，大人。"
    }
    {
      Id = "Dionysus_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿。"
    }
    {
      Id = "Dionysus_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿——！"
    }
    {
      Id = "Dionysus_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最近怎么样呀？"
    }
    {
      Id = "Dionysus_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "干杯！"
    }
    {
      Id = "Dionysus_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，我哪儿也不去。"
    }
    {
      Id = "Dionysus_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是当然。"
    }
    {
      Id = "Dionysus_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你真是与众不同。"
    }
    {
      Id = "Dionysus_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……那是什么？"
    }
    {
      Id = "Dionysus_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还挺酷的嘛。"
    }
    {
      Id = "Dionysus_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错！！"
    }
    {
      Id = "Dionysus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道这位是{#Emph}何方神圣{#Prev}，是从哪里冒出来的宁芙？不是林子里跑的，也不是水里游的，不过……等等，{#Emph}等等！{#Prev}那双{#Emph}眼睛{#Prev}！扎格，好兄弟，{#Emph}是你吗？！{#Prev}你{#Emph}变了{#Prev}哎！我喜欢！"
    }
    {
      Id = "MelinoeField_2386"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必你是迪奥尼索司大人吧？我是墨利诺厄，扎格列欧斯的妹妹。我是应家族的要求，前来奥林匹斯山支援的！不过，这场宴会是怎么回事？你们不是在打仗么？"
    }
    {
      Id = "Dionysus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，{#Emph}小墨{#Prev}，对，其他人说起过你。呃，宝贝你听着，虽然我这人{#Emph}爱好广泛{#Prev}，但战争实在不是我的菜。打来打去图个什么呢？我们神明又不会死！但我们可以{#Emph}活得精彩！"
    }
    {
      Id = "MelinoeField_2387"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这座山正在遭受围攻。克洛诺斯掳走了我的家人，你的家人也说不定很快会遭他的毒手！"
    }
    {
      Id = "Dionysus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就更应该及时行乐，一醉方休了，不是么？呵！不过我懂啦，你不好这一口。但是来都来了，还是先吃点东西再上路吧！"
    }
    {
      Id = "MelinoeField_4329"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必你是迪奥尼索司大人吧？我是墨利诺厄，扎格列欧斯的妹妹。我是应家族的要求，前来奥林匹斯山支援的。这场宴会是为什么而办的？庆祝战争结束么？"
    }
    {
      Id = "MelinoeField_4330"
      InheritFrom = "BaseNarrative"
      DisplayName = "我说的是战争的{#Emph}结束{#Prev}。不过，也许你们的神山严格来说仍然在遭受攻击。"
    }
    {
      Id = "Dionysus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，看看是谁重新考虑出席我们的小小宴会了！欢迎回来，小墨宝贝，去吧，找个杯子，融入人群之中吧！"
    }
    {
      Id = "MelinoeField_2388"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司大人，那样听起来确实很有吸引力，但我还有任务在身，恕难从命。前路还有许多凶险，而其他的奥林匹斯众神无法永远将它们拒之门外。"
    }
    {
      Id = "Dionysus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很心疼他们，真的！身为无所不能的神明，却落到自身难保的境地。还好我可以在这里借酒消愁，而且别忘了，你也可以！"
    }
    {
      Id = "Dionysus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的只是路过么？看看这些形形色色的诱惑！美酒佳酿、珍馐佳肴，嗯……！但你却一点都不为所动？"
    }
    {
      Id = "MelinoeField_2389"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我也很想留下来。品一品美酒、尝一尝佳肴，再和这边这些想必十分有趣的宾客攀谈几句。但我不能这样做。你不明白么？你们的山峰现在战火纷飞！"
    }
    {
      Id = "Dionysus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "战火纷飞？宝贝，那依我看，不如让战火烧下去！但我不想再跟你争这个了，毕竟，争吵就是另一种形式的战争，对吧？所以嘛，你接着忙你的去吧，我就在这忙我的就好！"
    }
    {
      Id = "MelinoeField_2391"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司大人，你办宴会办了多久了？我是指在这个地方办。你们夜夜笙歌，就好像没有明天了一样。"
    }
    {
      Id = "Dionysus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨宝贝，叫我迪奥尼索司就好，“大人”这称呼实在和我不相干，好么？至于我们在这里花天酒地了多久，我也不知道！应该有好一阵子了。呵。你真的不想加入吗？"
    }
    {
      Id = "MelinoeField_2393"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是你没办法继续办宴会了，那要怎么办？想象一下，假如事态严峻到你不得不放弃这种生活方式。假如你所珍视的一切都被毁灭了！"
    }
    {
      Id = "Dionysus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你的目的，宝贝，但是这招对我没用。我已经把{#Emph}每一滴{#Prev}负面情绪都排解干净了，你的也不例外！而且，我这人向来慷慨，所以我{#Emph}还是会{#Prev}给你这个。"
    }
    {
      Id = "MelinoeField_2394"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，这个宴会是为什么而办的？我看不出现在有任何值得庆祝的事情。"
    }
    {
      Id = "Dionysus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不明白么，宝贝？我们活在这世上的每时每刻都值得庆祝啊！也许是你喜欢每天垂头丧气的吧，我也不知道，可是我嘛，我喜欢每天{#Emph}兴高采烈{#Prev}的！"
    }
    {
      Id = "Dionysus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，很高兴你能来！我知道最近你忙得很，但如果连时不时享受一下都做不到，那忙来忙去又有什么意义呢，对吧？所以，放轻松点，{#Emph}既来之，则安之！"
    }
    {
      Id = "MelinoeField_2972"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是路过而已。不过，我真的很感谢你的热情。也许等到这一切终于尘埃落定的时候，我可以像你说的一样，放轻松点，好好享受一下吧。"
    }
    {
      Id = "Dionysus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我会确保你说到做到的，当然前提是我到时候还记得！至于现在嘛，就让我们为你的成功干一杯吧，愿你的那场战争尽快和平解决！"
    }
    {
      Id = "Dionysus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨宝贝，容我说一句，你看起来真是狼狈到家了。是在来的路上从山上滚下去了，还是怎么着？要洗一洗吗？"
    }
    {
      Id = "MelinoeField_2896"
      InheritFrom = "BaseNarrative"
      DisplayName = "请原谅我这副邋遢的样子。我在来到这里之前，刚刚穿过了一座亡者横行的死城，渗透了一支敌军的舰队，然后为了去到宙斯的宫殿，还爬了半座奥林匹斯山。"
    }
    {
      Id = "Dionysus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "不许找借口！要么把你那历尽世态炎凉的裙子换掉，向其他客人看齐，要么就该去哪去哪！我们这有严格的着装标准。"
    }
    {
      Id = "Dionysus_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "你带着的那个无花果叶……那可是我的{#Emph}私人收藏{#Prev}！它怎么会落到你手里？难道说我一时兴起，把它当礼物送给你了？"
    }
    {
      Id = "MelinoeField_2901"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你就是这样做的。我送了你一瓶蜜露，你就把这片叶子送给了我作为回礼。你回想一下？"
    }
    {
      Id = "Dionysus_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "回想……呃，偶尔我也会回想啦！但最近记得的事情越来越少了，我就不去想了！好吧，要是过去的我觉得应该把这么好的东西送给你，那他一定对你很有好感，你知道吧？"
    }
    {
      Id = "Dionysus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "你带着的是什么，是只青蛙么？没问题，我跟青蛙老早以前就混得可熟了！唯一的规矩是，不许让青蛙在泉水里游泳，不然客人们怕是会{#Emph}哕！"
    }
    {
      Id = "MelinoeField_2911"
      InheritFrom = "BaseNarrative"
      DisplayName = "他叫弗利诺斯。别担心啦，当然你应该从来都没担心过吧。他不会打扰这里的宁静的，何况他平常就喜欢跟其他人保持距离。谢谢你愿意接待他……也愿意接待我。"
    }
    {
      Id = "Dionysus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那是当然，我们这样的宴会，你能入得了场，就说明你差不到哪去！你的青蛙也是，只要他别突然开始唱歌就好！他不喜欢唱歌……对吧？"
    }
    {
      Id = "Dionysus_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "你好啊，小猫咪，喵呜~~~哈哈哈！也向你问好，小墨宝贝！跟大家介绍一下你的猫咪伙伴，好不好？"
    }
    {
      Id = "MelinoeField_2973"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，呃，这是图拉，我们会保护彼此的安全。别担心，我会盯紧她的，不会让她对周围的珍馐佳肴搞破坏。"
    }
    {
      Id = "Dionysus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用不用，我们这里的珍馐佳肴管够，而且{#Emph}各种口味{#Prev}一应俱全！我们在这里都是一群动物，所以很欢迎你的动物伙伴加入我们！"
    }
    {
      Id = "Dionysus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇这只小小鸟是谁啊！我指的不是{#Emph}你{#Prev}哦，小墨宝贝！那只渡鸦嗖一下飞了过来，一惊一乍的，就像刚见了鬼似的！渡鸦能喝酒吗？也许喝两口能让它放轻松点。"
    }
    {
      Id = "MelinoeField_2974"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的渡鸦拉奇见到陌生人确实会有点紧张……实话说可能见到什么东西都有点紧张啦。我觉得他应该对酒不感兴趣，不过这里的氛围可能对他会有好处。"
    }
    {
      Id = "Dionysus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的氛围可能对你也有好处哦，你知道的吧。你的宠物们这里都很欢迎，毕竟谁心底里还不是个动物呢，懂我意思吧？"
    }
    {
      Id = "Dionysus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨大美女，我{#Emph}要求{#Prev}你{#Emph}立刻{#Prev}介绍这只狗狗和我认识一下！自从上次我去西方旅行以来，还从没见过{#Emph}这么优雅{#Prev}的品种！我以前总是四处旅行，你知道的。"
    }
    {
      Id = "MelinoeField_2975"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司，这位是赫库芭，目前由我照顾。她总是这么乖巧懂事，就像现在这样。你的旅行一定很精彩……可以游览世界各地……"
    }
    {
      Id = "Dionysus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，是这样没错，但现在这里发生的事情也很精彩！事物不会一直保持原样，所以更要及时享受。没有什么是永生不朽的！除了我们！"
    }
    {
      Id = "MelinoeField_2898"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些按说在守护这座山的自动机，有给你们带来过麻烦吗？它们不分青红皂白，见了我就像见了敌人一样发起攻击。"
    }
    {
      Id = "Dionysus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许是它们觉得你太拘谨了！拜托，小墨大美女，你不用为我们担心啦！我有独门秘技傍身，就连赫菲斯托斯大人的造物，也对我毫无抵抗力。"
    }
    {
      Id = "MelinoeField_2899"
      InheritFrom = "BaseNarrative"
      DisplayName = "独门秘技……也就是说，你知道如何回避它们的侦测。能教教我吗？"
    }
    {
      Id = "Dionysus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我能教你的东西可{#Emph}多了去了{#Prev}。至于你说的那些机器人，它们就像家人一样啦，有的时候会打起来没错，但它们都是好意！绕着他们走就行了，好不？"
    }
    {
      Id = "Dionysus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确定不要跟我们一起泡一泡温泉吗？外面是很冷，但这里可不一样！赫菲斯托斯的熔炉让这里的水温{#Emph}恰到好处{#Prev}！"
    }
    {
      Id = "MelinoeField_2907"
      InheritFrom = "BaseNarrative"
      DisplayName = "我住的地方也有像这样的温泉！泡在里面真的舒服得很……只不过，我现在真的不该洗澡啦。出于……各种理由。"
    }
    {
      Id = "Dionysus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你三番五次地往这里跑哎！拜托，小墨大美女，你想加入的话，就别那么害羞嘛。这里的大家都是朋友！有些甚至还不止是朋友，哈！你早晚会加入我们的，对吧？"
    }
    {
      Id = "MelinoeField_2908"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的老师曾经和你一样浪迹天涯。她为我讲述了你旅行中的许多奇闻轶事。你周游过世界……大大小小的事情你都见识过！但你却宁愿像这样呆在这里吗？"
    }
    {
      Id = "Dionysus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈哈，没错！{#Emph}那是当然！{#Prev}看看这四周，个个都是俊男美女，天气也无可挑剔，而且我们储备管够！怎么，你以为我会放着这么好的聚会不办，跑出去溜达吗？"
    }
    {
      Id = "MelinoeField_2909"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我……我只是以为，四海为家的经历会让你的处世态度……有所不同！比如……更喜欢自省一些？或者更喜欢独处一些。"
    }
    {
      Id = "Dionysus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还年轻呢，宝贝！如果你见过我见过的一切，你就会像我一样，更喜欢享受美好的事物。没有逼你的意思！你会有那一天的；等这些事情过去，说不定就是时候了！"
    }
    {
      Id = "MelinoeField_2910"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，见到这些没打算把我开肠破肚的萨提尔，我都有点不太习惯。他们是你的老朋友吗？"
    }
    {
      Id = "Dionysus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，这些老山羊和我{#Emph}老早以前{#Prev}就认识了！他们是好萨提尔，喜欢享受好时光。至于别的事，他们都不放在心上。我也一样！"
    }
    {
      Id = "Dionysus_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不住在这里，所以我想问问，凡人最近过得怎么样？你在来的路上肯定见到过一些吧。我上一次听到他们的消息，已经是挺久之前的事了！"
    }
    {
      Id = "MelinoeField_2912"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们最近过得大不如前！大多数人大概在向我们的家人祈求平安，因为克洛诺斯打开了冥界的大门；亡者现在在地上横行。"
    }
    {
      Id = "Dionysus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就意味着凡人有机会和多年未见的亲人重新团聚了！拜托，小墨宝贝，{#Emph}乐观{#Prev}一点嘛！凡人都是这样过来的！没事的啦！"
    }
    {
      Id = "Dionysus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没把这场小小聚会告诉我老爸吧？我们可不想把这里收拾干净，再换一个秘密聚会地点。这里很完美！"
    }
    {
      Id = "MelinoeField_2390"
      InheritFrom = "BaseNarrative"
      DisplayName = "宙斯大人应该还有比这紧要得多的事情需要操心。要是没有克洛诺斯大军压境的话，想必你的宴会也会增色不少。其他的奥林匹斯神都不知道这里有场宴会吗？"
    }
    {
      Id = "Dionysus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说对了，宝贝！因为这里是个{#Emph}非请勿进{#Prev}的聚会，只有我{#Emph}放心{#Prev}的客人才会被放进来。至于你为什么总能恰好路过，我就不知道了，但是话说回来，谁管这些细节呢？对吧！"
    }
    {
      Id = "Dionysus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说扎格是怎么了，他那边一切都还好，对吧？下次你往这边来的时候，应该把他也带上，噢，他一定{#Emph}超爱{#Prev}的！"
    }
    {
      Id = "MelinoeField_2398"
      InheritFrom = "BaseNarrative"
      DisplayName = "我之前提到过克洛诺斯，也就是我们的祖父，那个不知疲倦地围攻这座山的泰坦，他把我的家人都抓做了人质，扎格列欧斯也不例外。所以他暂时没办法出席这场宴会。"
    }
    {
      Id = "Dionysus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那太可惜了，不过之后说不定还有机会，对吧？我总觉得我跟他之间有某种牵绊，某种真正的共鸣，所以如果你见到扎格老兄的话，记得跟他说一声，我这边的宴会{#Emph}永远{#Prev}欢迎他！"
    }
    {
      Id = "MelinoeField_2399"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来你和我的哥哥扎格列欧斯关系很亲近。他是什么样的人？我对他没有什么印象，因为在我很小的时候，克洛诺斯就把他掳走了。"
    }
    {
      Id = "Dionysus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道我很久都没听到他的消息了，对吧？呃，说起来，我们好像从来也没有说上过多少话，只不过我给他送去了很多祝福！所以说他最近怎么样？"
    }
    {
      Id = "Dionysus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说扎格老兄最近怎么样啊，他那边还好吗？有一阵子没给他发过祝福了……"
    }
    {
      Id = "MelinoeField_4492"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在扎格列欧斯已经从时间的囚禁中挣脱了出来，我的父亲、母亲，以及其他冥府员工也一样，所以我觉得他应该过得很好！要是你能联系一下他，他一定会很高兴的。"
    }
    {
      Id = "Dionysus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那我就放心了，我还以为我可能什么时候惹到他了呢！他本可以跟我一刀两断的，但他没有。"
    }
    {
      Id = "Dionysus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你看起来，{#Emph}啊{#Prev}，我的意思是，{#Emph}哇哦{#Prev}。你是变大了吗，当然这是完完全全的赞美啦……还是我变小了，还是……唔呃，我的头……"
    }
    {
      Id = "MelinoeField_2971"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你是指……我这异于平常的身高！这是来自于我的战友，巫术师喀耳刻的一点小魔法。这样说来，效果很明显吗？"
    }
    {
      Id = "Dionysus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，{#Emph}是啊！{#Prev}喀耳刻，嗯，我记得这个名字！听起来她有两下子嘛！下次再开宴会我会考虑邀请她过来的！"
    }
    {
      Id = "Dionysus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你看起来，{#Emph}呃……{#Prev}你是缩水了吗，还是……还是我突然变大了，还是……哦，我的头……"
    }
    {
      Id = "MelinoeField_3074"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，对……我的体型暂时变小了。这是来自我的战友，巫术师喀耳刻的一点小魔法。这样说来，效果很明显吗？"
    }
    {
      Id = "MelinoeField_2902"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有遇到普罗米修斯吗？克洛诺斯没有胆量在这座山上抛头露面，所以一定是派了自己的这条走狗，来确保整座奥林匹斯山无暇他顾。"
    }
    {
      Id = "Dionysus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}普罗米修斯{#Prev}，他{#Emph}回来了？！{#Prev}准是我最近没怎么关注新闻。我还以为他还在某座山顶上拴着，被老鹰啃食着内脏，受尽折磨呢！"
    }
    {
      Id = "MelinoeField_2903"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些事情的确都发生过。但他确确实实是回来了，还亲自率领着先锋部队，要把奥林匹斯山夷为平地。倘若他如愿以偿……那就再也没有宴会了。 "
    }
    {
      Id = "Dionysus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈哈{#Prev}，拜托，宝贝，不会糟糕到那种地步的！他能怎么做，用他从我爸那偷来的火种帮我们烤肉吃吗？不如这么着，下次你见着他，叫他过来我这坐坐！"
    }
    {
      Id = "Dionysus_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你有替我跟普罗米修斯说吗？我都想亲自去邀请他过来玩了，但我可是东道主，嘿！东道主可不能在宴会上溜走，你说是吧？"
    }
    {
      Id = "MelinoeField_2904"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么你这件事情记得这么清楚。你真的想让我把怨气最重的敌人之一{#Emph}请过来{#Prev}，来参加这场就连你最亲近的家人都不知道的宴会？"
    }
    {
      Id = "Dionysus_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……{#Emph}没错，呵！{#Prev}我们众神有的时候就是那么固执、那么爱面子，非要对彼此剑拔弩张，而实际上我们应该多伸出橄榄枝！快去跟那个爱发火的家伙说吧，我们在这给他留了个位置！"
    }
    {
      Id = "MelinoeField_2905"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感觉自己蠢得可以，但我替你跟普罗米修斯说了宴会的事。他已经预见到了我会说什么，毕竟他是先见之泰坦。他没有察觉到我有任何恶意……但恰恰因此认为这是个无比恶毒的陷阱。"
    }
    {
      Id = "Dionysus_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "而他据说还是比较理智的那种？宝贝啊，你们是杀红了眼吗，怎么都喜欢这样揣测别人！什么人也不信任，什么事都要怀疑！怪不得外面都乱成一锅粥了！"
    }
    {
      Id = "MelinoeField_2906"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你知道事态很严峻啊！我还以为你完全没留意，只想埋头做鸵鸟，把不想听到的消息全当成耳边风呢。"
    }
    {
      Id = "Dionysus_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说对了一半。是这样，我不喜欢为了自己无法掌控的事情瞎操心！{#Emph}酒{#Prev}，我可以掌控。宴会的质量，我可以掌控！但家族的内部纠纷？呵。有很多其他神擅长{#Emph}那种{#Prev}事情。"
    }
    {
      Id = "MelinoeField_2976"
      InheritFrom = "BaseNarrative"
      DisplayName = "这座山一直摇晃个不停，你知道是为什么吗？想必你尊贵的客人时不时会对此颇有微词吧。"
    }
    {
      Id = "Dionysus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，当然知道啊！有的时候宴会比较闹腾，你懂的，毕竟大家都在跳舞嘛！波塞冬伯伯可不是奥林匹斯山上{#Emph}唯一的撼地者{#Prev}！"
    }
    {
      Id = "MelinoeField_2977"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，是{#Emph}提丰{#Prev}苏醒了！众魔之父现在正在威胁你父亲的宫殿。你要忽视克洛诺斯，可以。忽视普罗米修斯，或许也没问题。但你不能忽视{#Emph}他{#Prev}。"
    }
    {
      Id = "Dionysus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哦不！提丰来了，提丰要摧毁一切！我们该怎么办？！{#Prev}哈哈哈，看到了吗，小墨宝贝？根本没人{#Emph}在意！{#Prev}该来的，就让它来吧！既然躲不掉，那就用狂欢来迎接它！不过，差一点就被你唬住了呢。"
    }
    {
      Id = "Dionysus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说，上次说的一盒好仙酒，你有点眉目了没有？我们已经喝到动用{#Emph}紧急储备{#Prev}了，毕竟谁都不希望宴会结束。我在努力劝大家淡定！"
    }
    {
      Id = "MelinoeField_4480"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还没有遇到装仙酒的盒子，也不知道怎么样区分仙酒的好坏。原来仙酒还有可能放坏吗……"
    }
    {
      Id = "Dionysus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样啊，那我就告诉你一个秘密，宝贝……！不过得先等我想起来……哈哈，最近这山晃得厉害，我脑子都不转了！呃，你要来个这个吗？"
    }
    {
      Id = "Dionysus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦嘿！这座山这会儿终于不晃了，我也想起来想告诉你什么了！{#Emph}一盒仙酒{#Prev}，指的就是四瓶放在一起。这是专业术语！"
    }
    {
      Id = "MelinoeField_4481"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你的意思是，你想要的不是{#Emph}一瓶{#Prev}仙酒，而是{#Emph}四瓶{#Prev}，而且你不想让我，呃，一瓶一瓶地给你……"
    }
    {
      Id = "Dionysus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，你自己瞧瞧我这里有多少客人……一瓶可不济事！但现在你知道我们赖以维生的关键了。一切就拜托你了，小墨宝贝！"
    }
    {
      Id = "MelinoeField_4486"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得你们现在应该可以出来了，毕竟对你们神山最大的威胁已经基本消除了。好吧，不过外面是还有恶毒的萨提尔在游荡啦。"
    }
    {
      Id = "Dionysus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，对萨提尔客气点，你这样真的很不够意思！你以为我这边的萨提尔朋友，有这样说过我们神明的坏话吗？而且，你说“最大的威胁”是什么意思？"
    }
    {
      Id = "MelinoeField_4487"
      InheritFrom = "BaseNarrative"
      DisplayName = "众魔之父——提丰，时间泰坦——克洛诺斯；前者已经彻底毁灭，后者已经无心再战。战争{#Emph}结束{#Prev}了！奥林匹斯安全了！"
    }
    {
      Id = "Dionysus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争{#Emph}结束{#Prev}了？！听到了吗各位，战争{#Emph}结束{#Prev}了！这还不足以让我们好好庆祝一场吗，再没有更合适的理由了！所以，拿上{#Emph}美酒{#Prev}，滑进{#Emph}温泉{#Prev}，扭起{#Emph}屁股{#Prev}，你们懂的，耶！"
    }
    {
      Id = "MelinoeField_4488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你是不打算离开这了，是吧。"
    }
    {
      Id = "Dionysus_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想都别想，宝贝！"
    }
    {
      Id = "MelinoeField_4489"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司，你不愿意至少跟你的家人们打声招呼，告诉他们你没事吗？一定有些家人在担心你。"
    }
    {
      Id = "Dionysus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "等到哪个良辰吉日，我肯定会的，宝贝，不过我们还在庆祝你的胜利呢，毕竟{#Emph}你打了一场胜仗！"
    }
    {
      Id = "MelinoeField_4490"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们打了场胜仗，不是我一个人的功劳。我们整家人都团结一致，最后才取得了胜利。我只是做了我该做的事。"
    }
    {
      Id = "Dionysus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我这不是在做{#Emph}我该做的事{#Prev}嘛！其他人知道我会没事的，我只是需要一点空间，毕竟外面的事情太激烈了……需要一点空间，才能跟这些{#Emph}贵宾稀客{#Prev}相处嘛！"
    }
    {
      Id = "Dionysus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，等等等等，不对啊，如果你说什么战争结束不是在开玩笑的话，那你怎么还会一次次出现在这里，然后从我这里拿走这些{#Emph}军火级{#Prev}的祝福？"
    }
    {
      Id = "MelinoeField_4491"
      InheritFrom = "BaseNarrative"
      DisplayName = "……就这么说吧，还有些战斗要赢。但细节我就不跟你说了，免得你和我的理智遭受太大的冲击。"
    }
    {
      Id = "Dionysus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，谢谢你的好心，我理智本来就没剩多少！听起来你会经常在这附近出没，你有特别通行许可，所以随时来看看哦！"
    }
    {
      Id = "Dionysus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "从外面传来了些狂野的传说，你能为我证实吗，宝贝？说是什么，{#Emph}新时代的黎明？"
    }
    {
      Id = "MelinoeField_4493"
      InheritFrom = "BaseNarrative"
      DisplayName = "是命运三女神最近的预言。她们预见了一个遥远的时代，到那时凡人不会再这么仰仗众神生活……也许那样的事情，应该办一场盛大的宴会。"
    }
    {
      Id = "Dionysus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是，也许可以把其他那些神都引过来参加宴会！那样一来，比起对凡人发号施令，我们就有更好的事情做了。而且{#Emph}预言也应验了！"
    }
    {
      Id = "Dionysus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在到处都是事，宝贝，但{#Emph}这座山{#Prev}上真正的好事只会在这里发生。 "
    }
    {
      Id = "Dionysus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "放心吧，就喝一杯，绝对不会害你！实际上还能帮上你的忙呢，看好了！"
    }
    {
      Id = "Dionysus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不能久留，你还有地方要去，还有人要见，我都懂的，宝贝！"
    }
    {
      Id = "Dionysus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来你有个很美妙的夜晚！你猜怎么着，{#Emph}我也一样！"
    }
    {
      Id = "Dionysus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "这场宴会已经开了好久了，宝贝，而且我们打算{#Emph}一直{#Prev}开到这一切结束！"
    }
    {
      Id = "Dionysus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "来啊，放轻松，喝一杯，{#Emph}厮混{#Prev}一下，别忘了这是场{#Emph}宴会{#Prev}！"
    }
    {
      Id = "Dionysus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "记住，别跟我老爸说起我们这场小小聚会，好么？"
    }
    {
      Id = "Dionysus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里永远欢迎你，但不欢迎你的烦恼，宝贝，你得把烦恼抛到身后！"
    }
    {
      Id = "Dionysus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，打起精神来，宝贝，我们才刚刚开始呢！"
    }
    {
      Id = "Dionysus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确定不想在温泉里泡一泡吗？保证让你暖融融的！"
    }
    {
      Id = "Dionysus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "这座山就这样了，我们也一样！"
    }
    {
      Id = "Dionysus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "你远道而来，却连坐一坐的工夫都没有，这像什么话，宝贝！"
    }
    {
      Id = "Dionysus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你厌倦了那些战斗，那来一杯这个{#Emph}正合适！{#Prev}"
    }
    {
      Id = "Dionysus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的温泉暖和得很，但如果你不想泡，我也不拦着你！"
    }
    {
      Id = "Dionysus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来想让你跟家人们捎句话，就说我在这里敬他们一杯，但听起来有点古怪，对吧？"
    }
    {
      Id = "Dionysus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "把你的烦恼留在大门口，选杯美酒一饮而尽吧！"
    }
    {
      Id = "Dionysus_0022"
      InheritFrom = "BaseNarrative"
