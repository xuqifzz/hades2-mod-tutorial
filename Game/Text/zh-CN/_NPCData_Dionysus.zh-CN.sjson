      DisplayName = "嘿，美女。"
    }
    {
      Id = "Dionysus_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看谁来了！"
    }
    {
      Id = "Dionysus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近怎么样？"
    }
    {
      Id = "Dionysus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈，没错！{#Prev}来吧，各位，我们再喝一轮！"
    }
    {
      Id = "Dionysus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以，我想{#Emph}再{#Prev}敬各位一杯。敬你们所有人！{#Emph}干杯！！"
    }
    {
      Id = "Dionysus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以，可以{#Emph}再{#Prev}敬各位一杯么？祝宴会永不结束！{#Emph}干杯！！"
    }
    {
      Id = "Dionysus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，朋友们，一饮而尽，今朝有酒今朝醉！"
    }
    {
      Id = "Dionysus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你说想再来一轮？有何不可！{#Emph}啊，哈哈！"
    }
    {
      Id = "Dionysus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "大家什么都不用担心，一切尽在掌控之中！"
    }
    {
      Id = "Dionysus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "喜欢那个吗？我们的储备还多着呢，想要就说！"
    }
    {
      Id = "Dionysus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来不错嘛，伙计！没错，水温正好！喝得怎么样，要再来一杯吗？"
    }
    {
      Id = "Dionysus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是知道的，朋友！这里才是奥林匹斯山上{#Emph}真正{#Prev}有意思的地方！"
    }
    {
      Id = "Dionysus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "喝吧，喝吧，喝吧，喝吧！{#Emph}哈哈，好啊！"
    }
    {
      Id = "Dionysus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你知道我是怎么说的吗？我说：“老爸……”{#Emph}哈。{#Prev}我说：“老爸，那要是我就是愿意呢？”然后他就说：{#Emph}“那就给我滚！”{#Prev}于是我就说：{#Emph}“好啊！我这就滚，保证滚得远远的！哈哈哈哈哈哈！”"
    }
    {
      Id = "Dionysus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "于是我就说，难道我们不能，就，把他邀请过来，好好喝一杯，把事情聊清楚吗？结果他们都瞪着我，就好像我是个彻头彻尾的白痴一样，哈哈哈，哈哈哈。"
    }
    {
      Id = "Dionysus_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿兄弟，咱们这里不许聊那种事，咱们{#Emph}放松{#Prev}就好！没必要因为那种事情影响自己的心情嘛！"
    }
    {
      Id = "Dionysus_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有没有跟你们说过，那次我往东去，飘洋过海的经历？那边有座岛，岛上的人都很不赖。你们不会都没去过别的地方吧？"
    }
    {
      Id = "Dionysus_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "到底要我说多少次，不许聊自己的妈妈，我们这里都是体面人！那种{#Emph}调皮{#Prev}的话题适合在另一种宴会上说，你们明白吧？"
    }
    {
      Id = "Dionysus_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "我说，{#Emph}说实话{#Prev}，泰坦到底有什么好怕的，他们是要把我大卸八块吗？可我死不了啊，兄弟，我可以把自己拼回来……然后再来一杯！"
    }
    {
      Id = "Dionysus_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈哈哈哈，真调皮{#Prev}，好了现在大家安静一下，好像是她又回来了，大家都拿出最好的一面来好吗？"
    }
    {
      Id = "Dionysus_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "于是我就说，难道我们不能……等等，我是不是已经讲过这个了？讲过的话跟我说一声？还是说你们也不记得了，那也没关系！我也不记得了，哈哈。我们说到哪了来着？"
    }
    {
      Id = "Dionysus_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你拿到了什么？"
    }
    {
      Id = "Dionysus_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "收下吧，归你了！"
    }
    {
      Id = "Dionysus_0137"
