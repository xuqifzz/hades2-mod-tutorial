    }
    {
      Id = "Nyx_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "柯辛斯……"
    }
    {
      Id = "Nyx_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "能在这里见到你，实在非同寻常。我和我的祖先有许多事需要讨论；等你离开，我们便会继续。"
    }
    {
      Id = "MelinoeField_4234"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦……请原谅我的失礼，尊敬的黑夜。您有空会再来三岔路口看我们吗？"
    }
    {
      Id = "Nyx_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "偶尔的拜访是一种可能，尤其是等到冥府彻底恢复如初之后。不过，我更希望我的子女能彻底独立，无需受到我的影响。"
    }
    {
      Id = "MelinoeField_4235"
      InheritFrom = "BaseNarrative"
      DisplayName = "许多母亲一定都是这样想的。"
    }
    {
      Id = "Nyx_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不知道他们的想法，只知道我的。"
    }
    {
      Id = "Nyx_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡俄斯通常不愿介入冥界或地表的事宜，所以此次可以说是例外。不知何时起，我与祂作为家人的关系更近了，或许是我们从你的家族中学到了一二。"
    }
    {
      Id = "MelinoeField_4669"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的家族一直以来看上去都像是处在分崩离析的边缘。这场磨难或许让我们之间的纽带更为牢固，但是……有时我会担心，这样的纽带无法永久维系。"
    }
    {
      Id = "Nyx_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "纽带变得脆弱，亦可重回稳固。我在这里与卡俄斯相处，正有此意。从我最为年长的亲人开始，自上到下，与家人重归于好……这是个相当漫长的过程，但却很有必要。"
    }
    {
      Id = "MelinoeField_4670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "祝您取得成功。"
    }
    {
      Id = "Nyx_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有许多子女，但你母亲则不然。因此，她没能见证你的孩提时代，令我有些伤感。她会将你养育得很好。"
    }
    {
      Id = "MelinoeField_4671"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，但至少我们现在重新回到了彼此的生命之中。她一定很幸运，能有整个世界上最有经验的母亲为她提供指引。"
    }
    {
      Id = "Nyx_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算如此，这对我来说也仍是学习的过程。但我仍会分享我的智慧。不过，你的母亲在这种事情上的直觉，往往比我好得多。"
    }
    {
      Id = "MelinoeField_4672"
      InheritFrom = "BaseNarrative"
      DisplayName = "很期待能够越来越了解她。您与她关系一直这样亲近么？"
    }
    {
      Id = "Nyx_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "“一直”所描述的，是很长的时间跨度。不过，珀尔塞福涅王后和我，我们自从你哥哥诞生之前，便已经走得很近了；自那之后也一直如此。"
    }
    {
      Id = "MelinoeField_4673"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您守护着她。"
    }
    {
      Id = "Nyx_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我永远都会的。"
    }
    {
      Id = "Nyx_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，也许，曾经整个冥界，都由我一人掌控。到了某个节点，这超出了我能力的限度，因此我的三位女儿——命运三女神——派了另一个人来帮我治理这个国度，此人便是你的父亲。"
    }
    {
      Id = "MelinoeField_4677"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就是他与弟弟们和养姊妹们分道扬镳的时候……那些亲戚们都成了奥林匹斯神。那一定是个动荡的时代。"
    }
    {
      Id = "Nyx_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是个变化的时代。我没有料想到哈迪斯会毫无怨言地接受这一职务，因为他的职责相当艰巨。我也没有料想到珀尔塞福涅会让这阴冷的冥界带来温暖的生机。而现在，你与你哥哥……因为有你们，冥界变得更好了。"
    }
    {
      Id = "MelinoeField_4678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您，倪克斯。"
    }
    {
      Id = "Nyx_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "你身披的漆黑战衣乃是我的形态。自我上次披上它，已经过去了非常久的时间。现在，我更多以间接的方式解决问题，但我仍然偶尔会想起柯辛斯的威力。"
    }
    {
      Id = "MelinoeField_4674"
      InheritFrom = "BaseNarrative"
      DisplayName = "您愿意将这样威力强大的武器托付给我，是我无上的荣幸，尊敬的黑夜。近来我们最近面对的大多数挑战……似乎只有直接参与其中，才有破局的希望。"
    }
    {
      Id = "Nyx_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白，有时事情就是如此，或者至少看起来如此。迄今为止，六件暗夜武器为冥界立下了汗马功劳。在我无法亲自守护冥界时，它们替我履行了职责。"
    }
    {
      Id = "Nyx_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "那柄镰刀……一定是佐利菲特，显现了我儿子塔纳托斯的形态。也许很快，他就会希望你将其归还。"
    }
    {
      Id = "MelinoeField_4675"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我还没有考虑过这点。那么，如果现在是时候让佐利菲特重新回到塔纳托斯手中了，我会很感激我与它共度的时间，并将其归还给您，尊敬的黑夜。"
    }
    {
      Id = "Nyx_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "也不必{#Emph}这么快{#Prev}。冥界还没有准备好让我儿子继续履行他的职责。你会继续作为月石之斧的使用者，直到那个时刻来临。"
    }
    {
      Id = "MelinoeField_4676"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喔……好。"
    }
    {
      Id = "Nyx_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对冥界的效力虽然匿踪遁形，但并非无人注意，尊敬的墨利诺厄王女。随着恐惧蔓延，我们的影响力也在扩张。"
    }
    {
      Id = "MelinoeField_4683"
      InheritFrom = "BaseNarrative"
      DisplayName = "尊敬的黑夜，我将效力于暗影之下，复归于暗影之中。愿您的意志得到施行。"
    }
    {
      Id = "Nyx_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果这是你自己的意志的话。"
    }
    {
      Id = "Nyx_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "匿踪者之誓中我派出的忠誓任务，至今已经全部完成。虽然你早已展现出相当的水平，但最开始我仍无法断定，你是否有这样的实力。"
    }
    {
      Id = "MelinoeField_4684"
      InheritFrom = "BaseNarrative"
      DisplayName = "尊敬的黑夜，最开始我也无法确定。如果说我的信心从未动摇，那就不再有需要我证明的事情，也无从鞭策自己了。"
    }
    {
      Id = "Nyx_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然如此，看来你现在需要设定新的目标，才好继续鞭策自己。我想，恐惧总是多多益善……"
    }
    {
      Id = "MelinoeField_4685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "总是如此。"
    }
    {
      Id = "MelinoeField_4690"
      InheritFrom = "BaseNarrative"
      DisplayName = "尊敬的黑夜，我想感谢您将帷幕之礼赐予了我。赢得您的战将这一头衔，很可能是我这一生最大的荣誉。"
    }
    {
      Id = "Nyx_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "你获得了帷幕之礼。那么，这是一件好事。你是怎么得到的，又是谁赐予了你这一头衔？"
    }
    {
      Id = "MelinoeField_4691"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……完成了您安排的试炼，就是瑟勒米乌斯指挥官以您的名义安排的那些……难道说……"
    }
    {
      Id = "Nyx_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，是的，那个骷髅。我该意识到的。他曾经在我这里，用的是另一个名号。希望我的这些“试炼”，他安排得还算妥当？"
    }
    {
      Id = "MelinoeField_4692"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔，应该算是吧，嗯……"
    }
    {
      Id = "Nyx_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就好，我的战将。"
    }
    {
      Id = "Nyx_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一些孩子，住在你们的三岔路口里……此前我与他们的互动，并非总以最有意义的方式。我曾以为，这完全是我的问题。然而，我发现这种事情的发生很有规律；仿佛是施加在我们家族身上的一道诅咒。"
    }
    {
      Id = "MelinoeField_4693"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连养育一个孩子，看起来都很有难度。我小时候肯定也不好交流，那时的我经常会有各种情绪。您还要跟涅墨西斯，或者厄里斯那样的孩子打交道，想想就……"
    }
    {
      Id = "Nyx_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们两个，确实。对于我的大多数孩子来说，我都是他们生命中的常量，然而他们每个对我来说，却都是未解的谜团。愿珀尔塞福涅王后与你的关系，不要像我与我的某些孩子那般脆弱。"
    }
    {
      Id = "MelinoeField_4694"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许您可以多去探望一下您的孩子们……试着让关系缓和一些……"
    }
    {
      Id = "Nyx_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的孩子们往往都需要自己的空间。不过，我从卡俄斯身上学到，我们有永恒的时间修复关系，只要我们想。"
    }
    {
      Id = "MelinoeField_4695"
      InheritFrom = "BaseSubtitle"
      DisplayName = "值得期待呢。"
    }
    {
      Id = "Nyx_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我的子女都栖身于黑暗之中，但我知道他们大多数人身在何处。唯独命运三女神这三个女儿，我也不知道她们在哪里。据你所知，她们是遭到了流放，是么？"
    }
    {
      Id = "MelinoeField_4679"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的……克洛诺斯想要让她们别碍事，这是他征服大业的计划之一。我觉得他现在对此很后悔，但并没有因此帮助我们寻找她们。我们有什么能做的吗？"
    }
    {
      Id = "Nyx_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要错过任何细节。如果命运清单还在对你揭示预言，那么她们至少还保有一定的与外界交流的能力。"
    }
    {
      Id = "MelinoeField_4680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不要错过细节……"
    }
    {
      Id = "Nyx_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，是你将我儿修普诺斯从沉眠中唤醒，驱使他回归冥府，为此我要向你表示感谢。他此前在工作岗位上表现得不错，然而这一切都戛然而止。"
    }
    {
      Id = "MelinoeField_4688"
      InheritFrom = "BaseNarrative"
      DisplayName = "尊敬的黑夜化身，请原谅他。他一定是在泰坦克洛诺斯袭击冥府时，不自觉地陷入了这种状态，作为防御的机制。很高兴知道他安然无恙……他现在是安然无恙的吧？"
    }
    {
      Id = "Nyx_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是本来的样子。他的哥哥塔纳托斯见到他回来了，很是高兴；你的哥哥也是。谢谢你对他的照顾。"
    }
    {
      Id = "MelinoeField_4689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不客气。"
    }
    {
      Id = "Nyx_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "我女儿厄里斯表现如何？迫使赫卡忒在我缺席时照顾她，令我很过意不去。我没有想到纷争会选择在任何一个地方长住。"
    }
    {
      Id = "MelinoeField_4696"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，纷争。虽然厄里斯时不时会很难相处，虽然我们之间有很大的差异，但我们还是能够理解彼此。再怎么说……有她在身边，事情也会变得更刺激。"
    }
    {
      Id = "Nyx_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对她过誉了。但我也从她身上学到了东西。"
    }
    {
      Id = "MelinoeField_4697"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也一样。"
    }
    {
      Id = "Nyx_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "我忠心耿耿的夜之眼为你降下了祝福。她非常可靠；这点我愈发认为难能可贵。你们两个关系很紧密，是么？"
    }
    {
      Id = "MelinoeField_4706"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从我非常小的时候开始，她就一直在为我守望。能与她结为银月姊妹，而且在这整件事中与她密切合作，是我的荣幸。"
    }
    {
      Id = "Nyx_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我所知，明月本人也深有同感。愿你们两个能永远交相辉映，让彼此的长处愈发耀眼。"
    }
    {
      Id = "MelinoeField_4707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您。"
    }
    {
      Id = "Nyx_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感知到了战神的祝福。自从我遇险之后，便再未联系过他，以及其他奥林匹斯神。"
    }
    {
      Id = "MelinoeField_4704"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们想必知道您现在有许多事务需要处理，尊敬的黑夜女神。您此前经常前往地表么？"
    }
    {
      Id = "Nyx_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的影响力能够跨越界域，亦曾与阿瑞斯大人与雅典娜女神，以及其他地表的神明有过来往，然而这并非常态。"
    }
    {
      Id = "MelinoeField_4705"
      InheritFrom = "BaseNarrative"
      DisplayName = "我相信他们一定很期待再次见到您的。"
    }
    {
      Id = "Nyx_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我想，他们之中有些神明畏惧我。但你说得对。"
    }
    {
      Id = "Nyx_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "匿踪者的威名已经传遍诸界。由于你的不懈付出，现在很少有人再敢与冥界势不两立了。"
    }
    {
      Id = "MelinoeField_4708"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们有许多忠诚的暗灵，在各个界域为我们守望；哪怕到了现在，在我们着手消灭那些曾经深深伤害我们的威胁的残迹时，他们也未曾松懈。但我们始终有更多事情要做。"
    }
    {
      Id = "Nyx_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，墨利诺厄王女。正因如此，花费片刻的时间，回头看看我们走过了多元，才显得格外重要。无论未来还有多远的路要走。"
    }
    {
      Id = "MelinoeField_4709"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢您，尊敬的黑夜。"
    }
    {
      Id = "Nyx_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来你们都在各自的岗位上，努力尽到了自己的责任。在我缺席之时，我的每个子女，都是三岔路口女巫的宝贵资源。"
    }
    {
      Id = "Nemesis_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "……她的命令，我们都严格遵守，母亲。我们都在尽力而为。"
    }
    {
      Id = "Nyx_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "还有修普诺斯，在这场磨难之中，他也一直都在这里。对待赫卡忒，务必要拿出十足的敬意，切莫怠慢。只要还有更多任务需要完成，而且你们都愿意继续合作，就可以暂时留在这里。知道了么？"
    }
    {
      Id = "Nemesis_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "……当然，母亲。合作就是这里的主旋律。"
    }
    {
      Id = "Nyx_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点我现在已经确定。然而，我无法留在这里亲眼见证，因为冥界仍有事务需要我处理。再见了，愿月光无法照亮之处，黑暗能指引你。"
    }
    {
      Id = "Nemesis_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……再见，母亲……"
    }
    {
      Id = "Nyx_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫卡忒，你所做的一切，远超我的期望。我叛逆的子女都在你的照顾下安然无恙；也多亏了你的智慧，我才能最终重获自由。"
    }
    {
      Id = "Hecate_0872"
      InheritFrom = "BaseNarrative"
      DisplayName = "您向来不吝于赞美，尊敬的倪克斯。最重要的是，你回到了我们身边，为此我无比庆幸。你的子女要怎么办，他们会跟你一起回去么？"
    }
    {
      Id = "Nyx_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们已经长大了，而我还有诸多要务在身。如果他们想要留在三岔路口，我希望你能够应允。相信他们对你来说不是累赘？"
    }
    {
      Id = "Hecate_0873"
      InheritFrom = "BaseNarrative"
      DisplayName = "……哦，不是。当然不是。"
    }
    {
      Id = "Nyx_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样就好。我下一次到访会是什么时候，目前还不确定。再见。"
    }
    {
      Id = "Hecate_0874"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，倪克斯。"
    }
    {
      Id = "Nyx_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的三位女儿回归了。以我对她们的了解，她们故意让你以为她们是自己回来的。然而，如果没有你为了达成命运清单所付出的不懈努力，她们恐怕永远也找不到回来的路。"
    }
    {
      Id = "MelinoeField_4681"
      InheritFrom = "BaseNarrative"
      DisplayName = "每一个应验的预言，都是命运三女神眼中的信号……在她们的流放之地，亮起的一个个的信标，是这种感觉么？"
    }
    {
      Id = "Nyx_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是一种合理的看待方式。你为我的家族做出了巨大的贡献，尊敬的墨利诺厄王女。我对你的感激之情，任何言语都已不足以表达。"
    }
    {
      Id = "MelinoeField_4682"
      InheritFrom = "BaseNarrative"
      DisplayName = "您太客气了，尊敬的黑夜化身。希望我们最近都不要再失去家人了。"
    }
    {
      Id = "Nyx_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "希望如此。"
    }
    {
      Id = "Nyx_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "欢迎来到静谧的深渊，墨利诺厄王女。"
    }
    {
      Id = "Nyx_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在的冥府，大有比原先更为强盛之势。"
    }
    {
      Id = "Nyx_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡俄斯设想了你前来的可能，而现在你就站在我们面前。"
    }
    {
      Id = "Nyx_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "你父亲的府邸有时会很吵闹，因此我会来到这片深渊，寻个清净。"
    }
    {
      Id = "Nyx_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "你哥哥最近过得很好；他经常会挂念你。"
    }
    {
      Id = "Nyx_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯最近又问了你的情况，就仿佛我没跟他说过似的。"
    }
    {
      Id = "Nyx_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望厄里斯最近没有给你们带去{#Emph}太多{#Prev}麻烦。"
    }
    {
      Id = "Nyx_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "不久之前我在这里遇到了涅墨西斯，我们还谈起了你。"
    }
    {
      Id = "Nyx_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运清单仍然由你保管，而且摩罗斯会帮你守护好它。"
    }
    {
      Id = "Nyx_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿暗夜武器继续彰显你的意志与愤怒。"
    }
    {
      Id = "Nyx_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡俄斯与我有千万年的历史要谈论，因此不必等待。"
    }
    {
      Id = "Nyx_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜格外恐怖，多亏了你与你的誓言。"
    }
    {
      Id = "Nyx_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿忠诚的塞勒涅的祝福助你今夜畅行无阻。"
    }
    {
      Id = "Nyx_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在你终于重回家庭，王后珀尔塞福涅总是喜笑颜开。"
    }
    {
      Id = "Nyx_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "匿踪遁形，砺刃藏锋。追求实现自己的价值；不要追求闻名于世。"
    }
    {
      Id = "MelinoeField_4710"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想为您献上一份礼物，尊敬的黑夜化身。感谢您一直遮蔽着三岔路口，感谢您赐予我暗夜武器，也感谢您送给我的许多其他礼物。"
    }
    {
      Id = "Nyx_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你，孩子。愿暗夜武器能够像来自我的信物那般，长久为你提供助益。三岔路口的女巫说，你对它们的掌控已是炉火纯青。"
    }
    {
      Id = "MelinoeField_4711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她这样说，是吗……"
    }
    {
      Id = "MelinoeField_4712"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想要再献给您一份礼物，尊敬的黑夜化身。感谢您养育了我的挚友、银月姊妹塞勒涅，以及其他那些我有幸结识的优秀子女。"
    }
    {
      Id = "Nyx_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "孩子，你的家族传统并不适用于我。我也不愿在冥界百废待兴之时，收受如此的谢礼。我非常感谢你的礼物，不过此后不必再送。"
    }
    {
      Id = "Zagreus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃……是我头发变浅了，五官也变俊俏了，还是我吃错什么东西吃出幻觉了……？"
    }
    {
      Id = "MelinoeField_3425"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯王子，请你听我说！你能听到吗？{#Emph}你能听到吗？"
    }
    {
      Id = "Zagreus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "……看来准是吃错东西了。又或者……喔原来这是场梦啊……！修普诺斯真是越来越大胆了！是{#Emph}你{#Prev}在里面吗，兄弟？"
    }
    {
      Id = "MelinoeField_3426"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，我……听着，理论上这是一场梦没错。但这是我能跨越时间联系到你的唯一方式！现在，请你听我说！我们一家人遇到了危险，我需要你的帮助！"
    }
    {
      Id = "Zagreus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧好吧，你先别急……算你走运，这种真实的梦境还挺对我胃口。你说{#Emph}我们一家人{#Prev}又是什么意思，{#Emph}你{#Prev}是哪位？也许是母亲的哪个表姐妹……但这解释不了你的瞳色。还有你衣服上父亲的纹章……"
    }
    {
      Id = "MelinoeField_3427"
      InheritFrom = "BaseNarrative"
      DisplayName = "听我说！我知道你接受起来会很困难，但……我是墨利诺厄……是你的妹妹。我来自另一个时间——来自未来，距离你并不算很远的未来！"
    }
    {
      Id = "Zagreus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "……喔，我差点就猜到了。那，来自未来的梦中妹妹，我可不想没听完来龙去脉就突然惊醒，所以说吧，现在是什么情况？你想要我做什么……？"
    }
    {
      Id = "MelinoeField_3428"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想要你找到我们的祖父，克洛诺斯，然后消灭他！因为我在这里能做的事有限。他篡夺了整座冥府……！我们的父母，你，和{#Emph}所有人{#Prev}一起，都沦为了他的阶下囚……！而现在他又对奥林匹斯山虎视眈眈，只为向众神报仇雪恨。"
    }
    {
      Id = "Zagreus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "……这样啊。你说{#Emph}“报仇雪恨”{#Prev}，是指他们彻底干掉了克洛诺斯那码事？那时候离我出生还远得很，更不用说你了。但在{#Emph}“距离我并不算很远的未来”{#Prev}，他会杀回来，全凭自己，接管一切……"
    }
    {
      Id = "MelinoeField_3429"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。请你相信我！在那个泰坦袭击的时候，我还只是个婴儿，而在那之后，我这一生都在为这一刻做准备！但我仅凭自己无法阻止克洛诺斯。你会帮助我吗？"
    }
    {
      Id = "Zagreus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "大概不会？毕竟这只是场梦，等我醒过来可能就全忘光了！以及，你的模样和声音都很符合我对妹妹的想象，所以你很有可能是我想象出来的。你说的那些事，能拿出什么{#Emph}证据{#Prev}吗？"
    }
    {
      Id = "MelinoeField_3430"
      InheritFrom = "BaseNarrative"
      DisplayName = "你醒来的时候绝不会忘记我，这点我向你保证。至于你想要找的证据……你一定认识赫卡忒，母亲的侍女！她是我的老师。找到她，告诉她我所说的一切——但不要告诉任何其他人！"
    }
    {
      Id = "Zagreus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，妹妹，恐怕我们的母亲没有这么个侍女……不过，说来也怪，从你的口中听到一个我闻所未闻的名字，反而比起别的更能证明你所说确有其事。等等，这是怎么回事……？"
    }
    {
      Id = "MelinoeField_3431"
      InheritFrom = "BaseNarrative"
      DisplayName = "是克洛诺斯！我暂时制伏了他，但他会卷土重来……就像他会在你的未来篡夺冥府那样。我得离开了……趁他还没找到我，我得赶快离开！"
    }
    {
      Id = "Zagreus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是你才刚来啊！听着……墨利诺厄，是么？我们还会再见面吗，还是说这一面就是永远？"
    }
    {
      Id = "MelinoeField_3432"
      InheritFrom = "BaseNarrative"
      DisplayName = "我穿越了梦境和时间才找到你，哥哥。无论发生什么事，都无法阻止我再次与你相见！在那之前，请答应我，一定要守住这个秘密，不要告诉任何人。"
    }
    {
      Id = "Zagreus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "……行吧，这下跟修普诺斯都不能说了。好吧，都听你的！那就改日再见了，妹妹。还是说改夜……？"
    }
    {
      Id = "MelinoeField_3433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
    {
      Id = "Zagreus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我好不容易才快把这撮毛压住！你是谁，你对我的镜中倒影做了什么……？开玩笑的。我记得你说过的一切。何况距离我们上次相见根本没过多久。上次说到哪了？"
    }
    {
      Id = "MelinoeField_3437"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正在说服你相信我，我是你来自未来的妹妹，在那个未来里泰坦克洛诺斯篡夺了冥府。我想要阻止他，而且需要你的帮助。"
    }
    {
      Id = "Zagreus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一大堆问题要问你，哪怕我知道时间有限。首先，为什么是{#Emph}我？{#Prev}虽然我确实是冥府指定的安保专家，所以也许这个问题的答案我已经知道了。"
    }
    {
      Id = "MelinoeField_3438"
      InheritFrom = "BaseNarrative"
      DisplayName = "还安保专家呢。克洛诺斯袭击的时候，整座冥府都毫无防备！但你是我的至亲，你曾经违抗过命运的意志，而且还杀死过神明，虽然可能没杀过泰坦……况且用这种办法，除了你也联系不到别人就是了。"
    }
    {
      Id = "Zagreus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，好极了！我已经能感觉到咱俩之间强烈的共性了。下一个问题：这个克洛诺斯到底要上哪找，以及等我找到他，我需要做什么？其实是问题二连啦。"
    }
    {
      Id = "MelinoeField_3439"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不知道克洛诺斯在你的时间身在何处，但我打算找到答案。我只知道他的遗骸被撒在了塔耳塔罗斯的最深处，也就意味着……他现在很可能蛰伏在离你住处很近的地方恢复力量。至于你找到他之后需要做什么……我现在也说不准。"
    }
    {
      Id = "Zagreus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃……恕我直言，墨利诺厄，这个计划实在让人有点摸不着头脑。尤其考虑到你一生都在为它做准备。我是要等你弄清楚细节再行动，还是……？"
    }
    {
      Id = "MelinoeField_3440"
      InheritFrom = "BaseNarrative"
      DisplayName = "不。你看，你不是安保专家么！展开一场调查，不过务必要在绝密中进行。在冥府或者塔耳塔罗斯里，有没有什么异样？比如说，反常的萨提尔活动？"
    }
    {
      Id = "Zagreus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们确实有萨提尔的麻烦，不过在冥府附近还没遇见过。但我可以去看看。那你呢……？等等，你是{#Emph}在我卧室里吗？"
    }
    {
      Id = "MelinoeField_3441"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，在你卧室的遗址里！只有在另一个时间与你处于相同的位置，我才可以这样联络到你。总之……我得赶在泰坦在你那边恢复全部力量之前，找到能让你消灭他的办法。只不过……该死。"
    }
    {
      Id = "Zagreus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么回事，又得走了吗？那就别因为我耽误时间了！我会看看我能做什么，等你再次诡异地在我梦中出现时跟你汇报。保重，妹妹！咱们肯定能摆平这件事。"
    }
    {
      Id = "MelinoeField_3442"
      InheritFrom = "BaseNarrative"
      DisplayName = "听你这么一说，感觉好像很容易……再见了，哥哥。下回见。"
    }
    {
      Id = "Zagreus_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，墨利诺厄！我在着手调查祖父的阴谋，但是因为不能告诉任何人实情，所以我的进展有点慢。希望你别误会，但我还是想问……你真的没有别的点子了吗？"
    }
    {
      Id = "MelinoeField_5046"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。我不觉得我能在这里阻止克洛诺斯。就连奥林匹斯现在也忙于应付他的军队，无暇他顾。而他自己满心怨恨，而且顽固得很，没有可能自己停下。"
    }
    {
      Id = "Zagreus_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "不是一家人，不进一家门啊。父亲显然对克洛诺斯毫无好感，但他从来没有说过到底发生了什么。说起来……你有什么头绪吗？他们是怎么闹得这么僵的？"
    }
    {
      Id = "MelinoeField_5047"
      InheritFrom = "BaseNarrative"
      DisplayName = "你去问父亲，应该比我现在去问更合适。克洛诺斯是个残暴的统治者，而他的子女不愿让他继续统治！就连命运三女神都认定，世界应该由众神治理！但是他显然并不甘心。"
    }
    {
      Id = "Zagreus_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以现在，你想让我为你阻止他。我是说，为{#Emph}我们{#Prev}。我是对击败特定的家庭成员挺有经验的，算是互有胜负吧，不过……那和{#Emph}把对方永远杀死{#Prev}不是一回事。而且，你也几乎没有跟我说过，我要怎么样才能做到那种事。"
    }
    {
      Id = "MelinoeField_5048"
      InheritFrom = "BaseNarrative"
      DisplayName = "是这样的……我知道一道咒语，叫做“时间消逝”。这道咒语有几个复杂的步骤，具体的到时候我再跟你解释。如果这道咒语奏效……应该就能在字面意思上，起到抽丝剥茧的效果。"
    }
    {
      Id = "Zagreus_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}抽丝剥茧的效果。{#Prev}恐怕我没太听懂，除非克洛诺斯是个什么巨大毛线球。你能说具体点吗？"
    }
    {
      Id = "MelinoeField_5049"
      InheritFrom = "BaseNarrative"
      DisplayName = "就是让他{#Emph}不复存在。{#Prev}将他征服世界的野心与他一起消灭。逆转他造成的所有伤害。这道咒语首先需要你、我和克洛诺斯之间有血脉的联系。然后，我们要选取一件特别的武器，注入能够将他彻底抹除的力量……那部分之后再细说。"
    }
    {
      Id = "Zagreus_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "……啊，太好了，你这么一说我就没什么疑惑的了。不过我得承认，只因为父亲不知道怎么跟某些家庭成员相处，就把对方杀掉，这种事情让我有点难以接受。"
    }
    {
      Id = "MelinoeField_5050"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些事怎么能怪在父亲头上？呃，该死……克洛诺斯要复活了。我得赶快走。继续寻找他的踪迹！而且，记住，这样做是为了我们所有人！"
    }
    {
      Id = "Zagreus_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会的，而且……我想，我也理解你。出生在这样的家庭中，没人征求过我们的同意。我们只能尽力而为，把事情处理妥当。"
    }
    {
      Id = "MelinoeField_5051"
      InheritFrom = "BaseNarrative"
      DisplayName = "就是这个道理。谢谢你，哥哥。照顾好自己……还有，对母亲、父亲、刻耳柏洛斯和其他人都好一点，就当是为了我。"
    }
    {
      Id = "Zagreus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "又见面了，妹妹。你想要我找到“克洛诺斯在给大家准备超级大惊喜”的蛛丝马迹，而……虽然这不算什么重大发现……但我在塔耳塔罗斯找到了一些机械部件，看起来跟周围有点格格不入。"
    }
    {
      Id = "MelinoeField_3443"
      InheritFrom = "BaseNarrative"
      DisplayName = "机械部件……你是说那些让房间结构变幻莫测的齿轮。在我的时间里，塔耳塔罗斯放眼望去，全是这样的部件。你怎么看？"
    }
    {
      Id = "Zagreus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……一般来说我不会这么轻易断言，但也许这一切跟你所说的确实有联系。我正在顺着这条线索查下去。你那边呢，对于我们接下来要做的事，有什么说法么？"
    }
    {
      Id = "MelinoeField_3444"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们需要一件武器。问题在于，克洛诺斯对于曾经用来击败他的武器都有所防备。除此之外，这件武器还要在你的时间和我的时间都存在，而且离我们家越近越好。你有想到什么合适的选择吗？"
    }
    {
      Id = "Zagreus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "……暂时还没。我的卧室里有一些凡人用的武器，但它们从来就派不上什么用场。在我的时间和你的时间都存在的武器……而且冥府兵器还都被排除在外……"
    }
    {
      Id = "MelinoeField_3445"
      InheritFrom = "BaseNarrative"
      DisplayName = "多想一想吧，不过请尽快。克洛诺斯早晚会意识到我的计划，我们之间的联系每夜都更加脆弱。现在，我该动身了。"
    }
    {
      Id = "Zagreus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等！冥府的员工……我的朋友们……他们都怎么样了？你说克洛诺斯囚禁了所有人。是字面意思上的{#Emph}所有人{#Prev}，还是……？"
    }
    {
      Id = "MelinoeField_3446"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔……不算，呃，修普诺斯现在在我们这，但他睡得不省人事。还有瑟勒米乌斯指挥官，他现在指挥着仍然忠于父亲的暗灵。可怜的刻耳柏洛斯被赶去了哀悼原野。但其他人都……"
    }
    {
      Id = "Zagreus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，至少大名鼎鼎的{#Emph}瑟勒米乌斯指挥官{#Prev}逃出去了。但倪克斯、阿喀琉斯、塔纳托斯、墨纪拉、杜莎、俄耳甫斯……都被祖父关起来了？"
    }
    {
      Id = "MelinoeField_3447"
      InheritFrom = "BaseNarrative"
      DisplayName = "他给父亲上了镣铐，锁在塔耳塔罗斯。按我的理解，他把其他人困住了……封在了时间里。但我们可以破除他对他们的控制。这点我很确定。我得先撤了，哥哥！想想有哪件武器能派上用场吧。"
    }
    {
      Id = "Zagreus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "……{#Emph}吉加罗斯{#Prev}。我父亲的矛。你说我们需要一件武器，这件武器要在我们两个的时间都存在，离我们家越近越好，而且之前没有用来杀死过克洛诺斯。那柄矛正合适。它很大……而且打人很痛。"
    }
    {
      Id = "MelinoeField_3448"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……我觉得可以。唯一的问题是，我不知道在哪里才能找到吉加罗斯。它很可能落到克洛诺斯手里了。但这是在{#Emph}我的{#Prev}时间发生的事……而在{#Emph}你的{#Prev}时间……"
    }
    {
      Id = "Zagreus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，反正父亲平常也不怎么让我用那柄矛，而且还把它锁在了他的卧室里。肯定还有别的选择。不过，至少我找到了克洛诺斯大概是在哪里把自己一块一块拼起来的！"
    }
    {
      Id = "MelinoeField_3449"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到了？在哪里，发生了什么？你是怎么知道找对了地方的？"
    }
    {
      Id = "Zagreus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，首先嘛，它好像就在冥府的正下方！把祖先埋在这种地方是有点奇怪啦，但父亲的惩罚向来很{#Emph}独到{#Prev}。总之，在塔耳塔罗斯更深层，我发现了一处被萨提尔占据的地方，顺着那里找到了一个洞穴。我暂时还没有进一步深入。"
    }
    {
      Id = "MelinoeField_3450"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好。一切准备就绪之前，不要贸然闯入那里。不过，回到父亲的矛的话题上。你有什么办法能把它拿到手么？"
    }
    {
      Id = "Zagreus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然。虽说父亲的卧室严禁他人进入，但我可是安保专家，这种小事拦不住我！父亲很可能会对我降下永生永世的惩罚，但听起来克洛诺斯在未来也会做出同样的事。所以……假设我搞到了吉加罗斯，我要怎么做？"
      DisplayNameMaxLength = 300
    }
    {
      Id = "MelinoeField_3451"
      InheritFrom = "BaseNarrative"
      DisplayName = "找一个安全的地方把它放好。你有办法说服父亲把它{#Emph}给你{#Prev}，而不向他透露具体原因吗？如果我们对时间动了太多手脚，克洛诺斯恐怕就会有所察觉。怎么把吉加罗斯通过这个虚空心灵通道传送过来，也是一个问题……"
    }
    {
      Id = "Zagreus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要这么在意细枝末节，妹妹！我喜欢这个计划，而且反正父亲现在欠我人情。所以你是某种神谕者吗，又是收集古代神器，又是跟我托梦什么的。也许算是噩梦，毕竟你口中的未来糟糕透顶。"
    }
    {
      Id = "MelinoeField_3452"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样的未来会被我们改写。至于我，我不是神谕者；按照一般的叫法，我应该是个“女巫”。我们离实现目标越来越近了，哥哥。去拿到父亲的矛，我自己也有更多事情要做。很快我会再次联系你。"
    }
    {
      Id = "MelinoeField_3861"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯，你做到了……！ 我看到放在一边的吉加罗斯了。所以，这是真的……在过去的选择和行动……"
    }
    {
      Id = "Zagreus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "……会影响未来。想不到{#Emph}你{#Prev}会对这个感到惊讶！还以为这是你预料之中的结果。如果我能在{#Emph}我的时间{#Prev}里先消灭克洛诺斯，他就没法在你的时间夺权，那一切都会迎刃而解……对吧？"
    }
    {
      Id = "MelinoeField_3862"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，按说是这样的。不管是什么结果，都比让冥界落入他的魔爪要好！他夺走了我们的家人，打开了冥界的大门，袭击了奥林匹斯山……！彻底湮灭，是他应得的下场。"
    }
    {
      Id = "Zagreus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我相信你。不过，我有个疑问，假如说我按照计划消灭了泰坦克洛诺斯……你会怎么样？正是因为他所做的一切，你才会出现在这里。但过去一旦改变，你所处的时间也会随之变化……"
    }
    {
      Id = "MelinoeField_3863"
      InheritFrom = "BaseNarrative"
      DisplayName = "不！如果克洛诺斯没有篡夺父亲的王位，我们就会像一家人那样生活在一起！他夺走了我的父亲、我的母亲、我们家的三头犬……还有{#Emph}你！{#Prev}而在某个夜晚，他也会夺走你的这些，而且还不止于此，除非你按照我说的做。"
    }
    {
      Id = "Zagreus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我明白！{#Prev}我明白。只是……只是我才知道自己有个妹妹，不想就这么失去她。不过，我想我们总有一天会再次相见的。总之，这些事情想得我有点头疼了。说来也怪，在这种噩梦之中居然也会头疼。"
    }
    {
      Id = "MelinoeField_3864"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解。像这样穿越时间交流，按理说是不可能实现的……就连克洛诺斯也没有料想到这种可能。但他年事已高，而且一向自以为是。他不知道自己能力的极限，而我们唯一的机会就在于此。"
    }
    {
      Id = "Zagreus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以现在我要等你给我们父亲的矛注入某种暂时性的梦魇诅咒，然后你会再次联系我，再然后我就杀入祖父的老巢，一矛捅穿他的心脏？差不多就是这样？"
    }
    {
      Id = "MelinoeField_3865"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，完全就是这样。要准备好吉加罗斯需要一些时间，而我……我在时机来临之前可能难以联系到你。但我一定会回来的，我向你保证。在那之前，万事小心，扎格列欧斯……亲爱的哥哥。"
    }
    {
      Id = "Zagreus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄！你回来了。你绝对想象不到，我费了多少力气才睡着，才能和你在这里再次相见。所以怎么说，那柄矛你准备好了么？"
    }
    {
      Id = "MelinoeField_3883"
      InheritFrom = "BaseNarrative"
      DisplayName = "拿稳吉加罗斯，然后我们马上就会知道了。不过，先说清楚两件事。第一，你得立即动身，前往克洛诺斯的藏身之处。第二，我们之间的联系很可能会断掉。后面的事就全靠你了。"
    }
    {
      Id = "Zagreus_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心，包在我身上。不过，在我们动手之前……你确定没有别的办法了吗？比方说好好跟祖父谈谈，问问他能不能别跟我们过不去？"
    }
    {
      Id = "MelinoeField_4974"
      InheritFrom = "BaseNarrative"
      DisplayName = "早就过了好好谈一谈就能解决问题的时候了。很难想象他在你的时间里，比在我的时间里会更容易说服。而且据我所知，你跟我们父亲好好谈过能不能放你出冥界，那次谈得也并不顺利。"
    }
    {
      Id = "Zagreus_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "无法反驳。那你确定父亲这柄矛能够消灭一个不死不灭的泰坦？"
    }
    {
      Id = "MelinoeField_4270"
      InheritFrom = "BaseNarrative"
      DisplayName = "马上就能了，所以握紧它：（念咒）\n{#Emph}大地、黑夜与黑暗，回应我的心念！\n{#Emph}不朽之物必败亡，见证我的誓言。\n{#Emph}时间，自此消逝！"
    }
    {
      Id = "Zagreus_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "……吉加罗斯……现在摸起来发烫……但握在手里比之前轻盈多了！大概得小心一点，免得戳到谁……克洛诺斯除外。"
    }
    {
      Id = "MelinoeField_3886"
      InheritFrom = "BaseNarrative"
      DisplayName = "去吧，扎格列欧斯。我已经尽我所能了。我们会再次相见的；也许是在另一个时间里，但一定会相见。后会有期。"
    }
    {
      Id = "Chronos_0967"
      InheritFrom = "BaseNarrative"
      DisplayName = "来者何人？！你的步伐没有萨提尔的蹄声，面庞更是令我感到陌生。"
    }
    {
      Id = "Zagreus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定就是爷爷了。初次见面，深感荣幸。我叫扎格列欧斯。听说这里有个非常可疑的洞穴，我非得亲眼看看不可。请问你在这里捣鼓什么呢？不介意我问的话。"
    }
    {
      Id = "Chronos_0968"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在{#Emph}养伤！{#Prev}不然我又何苦委身这种阴湿之地？至于你这个凭空冒出来的新孙子，没猜错的话，恐怕得归功于哈迪斯罢。以前从没想过，我会有机会亲眼看到那小子自己当上父亲。"
    }
    {
      Id = "Zagreus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，你非要知道的话，他可是个{#Emph}无比称职{#Prev}的父亲！多亏了他，我还有个妹妹呢！她叫{#Emph}墨利诺厄！{#Prev}她长得更像我们亲爱的母亲，冥界的王后珀尔塞福涅，但我感觉你儿子的脾气在她身上也可见一斑。你肯定会爱上她的！"
    }
    {
      Id = "Chronos_0969"
      InheritFrom = "BaseNarrative"
      DisplayName = "你跟我说这些是何居心？立即回答我，否则就等着被我的萨提尔碎尸万段罢！话说回来，那些该死的萨提尔都{#Emph}上哪去了……"
    }
    {
      Id = "Zagreus_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷啊……我跟你说这些，是因为我想在捅死你之前先跟你小聊几句。你会为我们的冥府带去苦难，而我，身为冥府绝无仅有的安保专家，决不会允许那种事情发生。"
    }
    {
      Id = "Chronos_0970"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呸！{#Prev}你岂能洞悉我的意图？又岂敢对我妄言苦难？在你问世之前，我已经在此腐烂了千千万万年！他和他的两个弟弟，都是不折不扣的叛徒、篡逆之辈！"
    }
    {
      Id = "Zagreus_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们是你的孩子。听着，我也不是说你非得时时刻刻都喜欢他们，我知道{#Emph}我{#Prev}做不到，但是……那墨利诺厄和我呢？你真要把{#Emph}我们{#Prev}也卷入这场冤冤相报之中吗？"
    }
    {
      Id = "Chronos_0971"
      InheritFrom = "BaseNarrative"
      DisplayName = "那又有何妨？你的父亲想必早已荼毒了你们的心灵，让你们将我视作敌人。无论是你，还是你的{#Emph}小妹妹！"
    }
    {
      Id = "Zagreus_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果真是那样，我还会在这里跟你废话么？总之事情是这样的：要么心疼一下你的孙子孙女，不要挑起这一切……要么就让这柄矛捅你一身窟窿。而且我保证，这次你连养伤的机会都不会再有。怎么说？"
    }
    {
      Id = "Chronos_1303"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你妄想害我性命，却从未体会过没有时间的世界。真到那一步，你会无比怀念我的影响！而我的“心疼”对你们又有什么益处……你倒是说说看，你希望我如何表现？"
    }
    {
      Id = "Zagreus_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我也不知道，也许就好好当我们的爷爷，而不是躲在冥府下面某个我早该发觉的亵渎房间里？你可是时间。要不你推演一下？"
    }
    {
      Id = "Chronos_1304"
      InheritFrom = "BaseNarrative"
      DisplayName = "推演{#Emph}什么……{#Prev}难道你要我设想自己当上时间爷爷，把孙子孙女抱在怀里唱摇篮曲，过上幸福美满的生活么？就算你不用那柄矛捅死我，我那心怀怨怼的儿子哈迪斯，在见到我的第一眼，也必然会那样做！"
    }
    {
      Id = "Zagreus_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会的，因为那样的话，我会保护你。而且，有一点你说得不对， 那不会尽然是幸福美满的生活，尤其是你继续向前推进的话。但估计比{#Emph}我手中的矛{#Prev}要好！现在，赶紧选吧。我可等不了一整天，或者一整夜。"
    }
    {
      Id = "Chronos_1305"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼，也就是说，要么接受在未来和像你这样的孙辈相处，要么便是在永恒的虚空中湮灭……这要我如何抉择……？"
    }
    {
      Id = "Zagreus_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "是你吗，墨利诺厄？我几乎都看不见你了。可恶……"
    }
    {
      Id = "MelinoeField_3909"
      InheritFrom = "BaseNarrative"
      DisplayName = "扎格列欧斯，你能听得到吗？{#Emph}回应我一下！{#Prev}扎格列欧斯！"
    }
    {
      Id = "Zagreus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我不知道你那边发生了什么事，不过一旦你准备好，我就可以立刻开始行动。"
    }
    {
      Id = "MelinoeField_3910"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有用。他听不到我了。我还有咒语要完成，不能在这里逗留。"
    }
    {
      Id = "Zagreus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是不是……？感觉好像是她。墨利诺厄？是你吗？你能听得到吗？"
    }
    {
      Id = "MelinoeField_3911"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能，但你能听得到{#Emph}我{#Prev}吗？喂，扎格列欧斯？{#Emph}喂？"
    }
    {
      Id = "Zagreus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "……可恶。跨越梦境与时间的联系方式，一定还有更可靠的才对。"
    }
    {
      Id = "MelinoeField_3912"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有用。在我完成咒语之前，恐怕都没办法再联系到他了。"
    }
    {
      Id = "Zagreus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄，你在哪？是我啊，我是你哥哥！我现在就只是……站在这里，应该是在梦里，等着你出现……{#Emph}随时欢迎？"
    }
    {
      Id = "MelinoeField_3913"
      InheritFrom = "BaseNarrative"
      DisplayName = "再多等我一会儿，哥哥……"
    }
    {
      Id = "Zagreus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是她出了意外怎么办……但那样我就不会再做这个梦了，对吧？除非这{#Emph}不是梦{#Prev}。那我就只是站在这里，盯着镜子看……"
    }
    {
      Id = "MelinoeField_3914"
      InheritFrom = "BaseNarrative"
      DisplayName = "他能感应到我，但我没法联系到他……再等我一下就好，扎格列欧斯。"
    }
    {
      Id = "Zagreus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "我真的要这么做吗？杀死我们的祖父……父亲肯定会这么希望，我这个妹妹也一样，可是……呃，话说回来，她上哪去了？墨利诺厄？妹妹？"
    }
    {
      Id = "MelinoeField_3915"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就在这里，只是……我没办法这样联系到你，除非……我得重建我们之间的联系。"
    }
    {
      Id = "Zagreus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，要怎么做才好……她怎么还不来？{#Emph}哈喽……？{#Prev}你在那边还好吗？"
    }
    {
      Id = "MelinoeField_3917"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还好，只是……只是还需要一点时间！别失去希望，以及……做好准备。"
    }
    {
      Id = "Zagreus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直在做这个古怪的梦……也许是{#Emph}噩梦{#Prev}，我也不知道。好一段时间没有听到她的消息了……"
    }
    {
      Id = "MelinoeField_3916"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会回来找你的，哥哥，我发誓……只是今夜还不行。"
    }
    {
      Id = "Melinoe_5059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重，哥哥。"
    }
    {
      Id = "Melinoe_5060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你所作的一切。"
    }
    {
      Id = "Melinoe_5061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "见到你真好！"
    }
    {
      Id = "Melinoe_5062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "扎格列欧斯王子。"
    }
    {
      Id = "Melinoe_5063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "王子殿下。"
    }
    {
      Id = "Zagreus_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢了。"
    }
    {
      Id = "Zagreus_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我没意见。"
    }
    {
      Id = "Zagreus_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好嘛！"
    }
    {
      Id = "Zagreus_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们确实需要帮助。"
    }
    {
      Id = "Zagreus_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "墨利诺厄王女。"
    }
    {
      Id = "Zagreus_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别，我的殿在你之下。"
    }
    {
      Id = "Zagreus_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也是。"
    }
    {
      Id = "Zagreus_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不用。"
    }
    {
      Id = "Zagreus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，这里剩下的维修工作，就交给我们善后吧。谢谢你帮了我们这么多。尤其是把我们从时间的牢笼里放了出来！"
    }
    {
      Id = "MelinoeField_4981"
      InheritFrom = "BaseNarrative"
      DisplayName = "相信我，我也没有更好的事可做了！总之，我们得想个办法在外面也能碰上头才行。而且在我们处理善后事宜的时候，最好都盯紧克洛诺斯。"
    }
    {
      Id = "Zagreus_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说，你不会还在生我的气吧？就，毕竟我没有在爷爷手无寸铁的时候一矛给他捅死？我真希望你能回忆起在他身边长大的点滴。你们相处得很不错！他把你逗笑的次数比我都多。"
    }
    {
      Id = "MelinoeField_4982"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个梦境一般的过去，只有你和他记得嘛！我还不知道该怎么看待这种更加快乐的生活的可能性。就目前而言，能过上更加宁静的生活，我就别无所求了。"
    }
    {
      Id = "Zagreus_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来不像那种会“别无所求”的类型。总之我知道这不是永别，我们还会再见的……不过，我还是想说……我会想你的，妹妹。以及，要是修普诺斯没办法自己醒来的话，记得把他送回来。"
    }
    {
      Id = "MelinoeField_4983"
      InheritFrom = "BaseNarrative"
      DisplayName = "他会醒来的。我也会想你的，哥哥。照顾好大家，好么？"
    }
    {
      Id = "Zagreus_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会的。你也要照顾好自己。"
    }
    {
      Id = "Zeus_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，谢谢你。"
    }
    {
      Id = "Zeus_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们不需要指引。"
    }
    {
      Id = "Zeus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "年轻的女神，欢迎你来到我们家族辉煌的宫殿！我们要向你说声谢谢；提丰没能登上这里，多亏了你的仗义相助。"
    }
    {
      Id = "Hera_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们还要向你说声抱歉，我的天神丈夫中途撤退，让你自己面对那个可怕的魔物。其他神大多都在巩固宫殿的防守；请原谅我们的失礼。"
    }
    {
      Id = "MelinoeField_3828"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉王后，您不必道歉的。能亲眼见到您和宙斯大人，一睹奥林匹斯的辉煌，是我的荣幸。这些夜晚，多亏了众神的慷慨援助，我才能取得这样的成果。"
    }
    {
      Id = "Zeus_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "毕竟我们有着共同的目标嘛，墨利诺厄！而只要克洛诺斯还坐在你父亲的王位上，这个目标就仍需我们继续努力。"
    }
    {
      Id = "Hera_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "她才刚来，就要催她走么，丈夫？虽然我们这里除了阿波罗的奏乐，也没有什么娱乐活动。不过至少敌人用不了多久就又会登门拜访！"
    }
    {
      Id = "MelinoeField_3829"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕我也没办法久留。我得回去请教三岔路口的女巫，也许她有主意，能让我们一次解决掉两个大敌。"
    }
    {
      Id = "Zeus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们一定会找到办法的，这点毋庸置疑！而在那之前，我们会巩固防线，更好地应对敌人的进犯。"
    }
    {
      Id = "Hera_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "去吧，孩子。你一定看得出来，我们并不习惯用言语表达心中的感激。你的父王母后还没有重登王位；现在庆贺依我看为时尚早。"
    }
    {
      Id = "MelinoeField_3830"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许很快就能等到那一天。"
    }
    {
      Id = "Zeus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们又打败了那个魔物，年轻的女神，这无疑是你的功劳！在灾害面前，能展现出如此的勇气实属难得。我们的宫殿安全无虞……而且防御得到了进一步巩固，以备提丰再次来犯。"
    }
    {
      Id = "Hera_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的表现太出色了，孩子！倘若事态进一步恶化，我们原本打算启动我们儿子的最后预案。但那样做的代价实在高昂。这样说来，你从多个角度让我们幸免于难啊。"
    }
    {
      Id = "MelinoeField_3840"
      InheritFrom = "BaseNarrative"
      DisplayName = "能够为家族尽自己的绵薄之力是我的荣幸，赫拉王后，能够再次亲眼见到这壮观的宫殿也是。也许我们仍有机会彻底将提丰铲除。"
    }
    {
      Id = "Zeus_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到这个，你是有了什么计划么？我们自己还没研究出消灭提丰的办法，除非我们把这整座山拿去给他陪葬！现在的他，比起很久以前和我们初次交手时，甚至还要更加凶残。"
    }
    {
      Id = "MelinoeField_3841"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从提丰的肉身中采集了样本；我们正在研究如何把它在我们的巫术中加以运用。不过，目前还没有实质性的进展值得分享……"
    }
    {
      Id = "Hera_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，把那个魔物击退一次，已经是相当有意义的进展了！我的天神丈夫原本还以为，你的初次胜利有可能是侥幸使然呢。"
    }
    {
      Id = "Zeus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，我亲爱的妻子，我当时说的是，战胜提丰一次，并不能证明一定能战胜他第二次！但现在你已经证明事实并非如此，墨利诺厄，也让我们燃起了信心：也许这个邪恶的威胁被彻底逐出此界，已是指日可待。"
    }
    {
      Id = "MelinoeField_3842"
      InheritFrom = "BaseNarrative"
      DisplayName = "宙斯大人，赫拉大人，请容我带着此次的收获先行告退，以便尽快获得新的发现，帮助我们实现您的愿景。感谢众神的一如既往的鼎力相助。"
    }
    {
      Id = "Zeus_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们也要向你致以诚挚的谢意。"
    }
    {
      Id = "Hera_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就跟我的天神丈夫说，说不定他这个{#Emph}法力高强的女巫侄女{#Prev}面对泰坦的围攻也能帮上忙，毕竟她从小就在接受训练，誓要杀死时间本尊。结果他对此嗤之以鼻！得亏我那次{#Emph}说过了他{#Prev}。"
    }
    {
      Id = "Zeus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "我亲爱的赫拉，那件事我们{#Emph}当然{#Prev}早就达成一致了，不然我的好侄女现在就不会站在这里了！不过，墨利诺厄，告诉我，关于彻底解决我们当下困境的办法，有没有什么新的消息？提丰看起来没有善罢甘休的打算。"
    }
    {
      Id = "MelinoeField_3845"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们有些眉目了。很有可能我们用来消灭一个大敌的手段，会成为消灭另一个大敌的关键。不过，这两种手段现在还没有研发完毕。"
    }
    {
      Id = "Hera_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "听到了么，宙斯？我们最大的两个的麻烦，说不定很快就能双双化解。我们最喜欢高效率的行事风格了。"
    }
    {
      Id = "Zeus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "你只需告诉我们如何促成这样的结果，墨利诺厄。奥林匹斯众神在此听从你的调遣。"
    }
    {
      Id = "MelinoeField_4268"
      InheritFrom = "BaseNarrative"
      DisplayName = "坚守阵地，越久越好，因为你们的祝福和支持对我来说无比珍贵。无论如何，我都会尽快回来的。虽然克洛诺斯唤醒了提丰，但这股力量也可以反过来将提丰彻底摧毁。"
    }
    {
      Id = "Hera_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "但愿如此。我们希望你不要仓促行事，孩子，但很难说我们到底还有多少时间。不过总之，还是小心为上，我们会等你再次归来。"
    }
    {
      Id = "MelinoeField_3847"
      InheritFrom = "BaseNarrative"
      DisplayName = "坚守阵地，越久越好，因为你们的祝福和支持对我来说无比珍贵。我有些夜晚可能需要转而去对付克洛诺斯；是他的力量唤醒了提丰，而这股力量也可以用于将提丰彻底摧毁。"
    }
    {
      Id = "MelinoeField_3846"
      InheritFrom = "BaseNarrative"
      DisplayName = "目前都还停留在理论阶段，不过我们认为，我们将要用来消灭一个大敌的手段，很有可能会成为消灭另一个大敌的关键。不过，这两种手段现在还没有研发完毕。"
    }
    {
      Id = "Zeus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰没有退却的意思，但他再敢来犯，我们就再次将他击退，夜夜如此！"
    }
    {
      Id = "Hera_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "要么这样，要么我们也许可以把他消灭掉，连同这座山和一大片邻近的郊区……只是，这样的话，我们之后要搬去哪里？"
    }
    {
      Id = "Zeus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "那种可能性我们再也不用考虑了，我亲爱的赫拉！最好是提都不要提。墨利诺厄已经向我们保证过，提丰可以用另一种方式消灭。"
    }
    {
      Id = "MelinoeField_3850"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事我很难做出保证，叔父大人，但我会竭尽所能，确保提丰被消灭，而奥林匹斯山安然无恙……我只是需要在接下来的一段时间里把注意力转移到克洛诺斯身上。"
    }
    {
      Id = "Hera_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，亲爱的，请恕我直言，你为什么不赶紧前往你们的冥界呢？我们现在靠自己也撑得住了，你一定看得出来。但我们没办法亲自去往冥界对付那个泰坦。"
    }
    {
      Id = "Zeus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "做你该做的事吧，墨利诺厄。我们会期待你在冥界大获成功的消息。祝福也少不了你的！"
    }
    {
      Id = "MelinoeField_3850_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事我很难做出保证，叔父大人，但我会竭尽所能，确保提丰被消灭，而奥林匹斯山安然无恙……"
    }
    {
      Id = "Zeus_0286_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "做你该做的事吧，墨利诺厄。我们会期待你大获成功的消息。祝福也少不了你的！"
    }
    {
      Id = "Zeus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，我的好侄女，你真是不同凡响，真的！依我们所见，那魔物一丝痕迹都没有留下！{#Emph}你做到了！你杀死了提丰！"
    }
    {
      Id = "Hera_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的天神丈夫曾经有过太早庆祝胜利的先例，所以在你亲口确认之前，他说的{#Emph}一个字{#Prev}我都不会相信；甚至就算你这样说了，我也很难立刻相信！"
    }
    {
      Id = "MelinoeField_3866"
      InheritFrom = "BaseNarrative"
      DisplayName = "众魔之父被摧毁了……不仅仅是被消灭，而是被彻底抹除，得益于时间泰坦的力量，以及我父亲的爱矛吉加罗斯的些许助力。"
    }
    {
      Id = "Zeus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "听到了没有，我亲爱的赫拉？我早就告诉过你，小墨利诺厄一定会为我们夺取胜利！只要我们家族齐心协力，就没有克服不了的困难。"
    }
    {
      Id = "Hera_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我仍然感觉无比震惊。那么，孩子，如果你{#Emph}真的{#Prev}消除了那个魔物的威胁，那就做好心理准备，听我们所有人大言不惭地说从未怀疑过你这种话吧。我的天神丈夫已经开始了。"
    }
    {
      Id = "MelinoeField_3867"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉王后，如果不是您当初的信任，现在登门拜访的恐怕就是提丰了。所以，我要感谢你们所有人……而且现在，更大的胜利对我们来说只有一步之遥。"
    }
    {
      Id = "Zeus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦克洛诺斯……你是想用与今夜相同的方式消灭他么？"
    }
    {
      Id = "MelinoeField_3868"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果有必要的话。不过，您所目睹的那股力量，是专门为提丰准备的；我们计划对克洛诺斯使用的力量，也只会作用于他一人。不死之身只有在动摇到命运三女神丝线的根基时，才有可能被彻底消灭。"
    }
    {
      Id = "Hera_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来在另一件壮举完成之前，是没有时间举办庆功宴了，是么？也好。泰坦的军队现在只怕会更加不要命，我们应当为此做足准备。在你发起最后攻击之时，我们也将鼎力相助。"
    }
    {
      Id = "Chronos_1077"
      InheritFrom = "BaseNarrative"
      DisplayName = "……现在，你明白了么，我的好儿子？虽然来攻打你们的那个提丰已经灰飞烟灭，但在某些情况下他仍有幸存的可能。当然，{#Emph}现在{#Prev}少了一个！"
    }
    {
      Id = "Zeus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，父亲，你认为这些情况总共有多少种？毕竟，我们总不能劳烦墨利诺厄一直这样打上我们的山顶，直到永远……"
    }
    {
      Id = "Hera_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到这，欢迎你，孩子！我们刚才正和你的祖父聊天呢。如你所见，我们还没有决定该如何处置他。"
    }
    {
      Id = "Chronos_1078"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你好啊，小孙女！我刚刚才跟奥林匹斯之王与王后说，你一定会再次胜利，因为你之前也取得过胜利！谢谢你证实我的理论啊。"
    }
    {
      Id = "MelinoeField_5076"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，不客气。天神宙斯、赫拉王后……我可以证实，这些提丰的残迹确实存在，因为我刚刚就在祖父的帮助下找到了一个，然后将他铲除了。"
    }
    {
      Id = "Chronos_1079"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰现在更像是他往日的阴魂。他攻占奥林匹斯山的可能性已经相当渺茫，而且随着你的每次成功，都会愈发衰微。但具体还需要{#Emph}多少次{#Prev}，很不幸，我也无从算起……"
    }
    {
      Id = "Hera_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么叫无从算起？或许我们更有{#Emph}说服力{#Prev}一点，你就会对我们如实招来吧，泰坦。"
    }
    {
      Id = "Chronos_1080"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些可能性，我也是最近才了解到。大体而言，时间已经在自由地向前流淌；我的孙女只是可以确保前路没有值得忧心的阻碍，当然，前提是不会给她带来不便。"
    }
    {
      Id = "MelinoeField_5077"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会全力以赴的，无论需要多久。当然，是在神王和王后准许的情况下。我请求您允许祖父继续做他在做的事。目前为止，他都有信守承诺。"
    }
    {
      Id = "Zeus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于你的去处，我们确实有了一些想法，父亲。但出于安全考虑，我们的宫殿至此将暂停对外开放。墨利诺厄，也许等你母亲重新开始每年来这里拜访的时候，你可以，呃，再回来看看。"
    }
    {
      Id = "Hera_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们真是有失地主之谊，孩子。这些事情都不是我们所希望发生的！但我们曾经请求过你的帮助，因此但凡你有需要，我们也一定鼎力支持。哪怕我们有时会为此争论一番。"
    }
    {
      Id = "Zeus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们暂时摆脱了提丰，但却没有彻底将其消灭。如果克洛诺斯在阻碍我们实现那样的结局，那就赶快去对付{#Emph}他{#Prev}吧。"
    }
    {
      Id = "Hera_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的天神丈夫不是想要给你施压，孩子。但如果你还有其他事情必须处理，那么大可以将神山交给我们守护。"
    }
    {
      Id = "MelinoeField_3853"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，陛下。"
    }
    {
      Id = "Zeus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "又迎来了一场胜利！我们无比感谢你持续为我们家族效力，墨利诺厄。愿你杀向克洛诺斯时，也能如此顺利。"
    }
    {
      Id = "Hera_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "也愿我们能尽快找到办法，让那个魔物提丰重归大地。有任何新的进展，一定要让我们知道！"
    }
    {
      Id = "MelinoeField_3854"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，赫拉王后。"
    }
    {
      Id = "Hera_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又一次让提丰嚎叫着从山顶跌落，不过他很可能会再度回归。但也许，未来的某一夜，他的存在会画上句号。"
    }
    {
      Id = "Zeus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们非常感谢你的帮助，年轻的女神，但不要忘记还有个克洛诺斯等着你对付！如果击败他能让我们离最终的胜利更近一步的话，那就更是如此了。"
    }
    {
      Id = "MelinoeField_3855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你们。"
    }
    {
      Id = "Hera_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的圣殿永远欢迎你，孩子，但只要提丰的威胁仍然存在，我们就始终无法真正尽到地主之谊。"
    }
    {
      Id = "Zeus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "他暂时败退了，但他还会回来。除非墨利诺厄能彻底让我们摆脱他，据她所说，这应当是可以实现的事情！"
    }
    {
      Id = "MelinoeField_3856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们越来越接近了。"
    }
    {
      Id = "Hera_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果你坚持！"
    }
    {
      Id = "Hera_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是斗志昂扬。"
    }
    {
      Id = "Hera_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "去往哪里？"
    }
    {
      Id = "Hera_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "Hera_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯哼。"
    }
    {
      Id = "Apollo_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "你做到了，明媚的女神！我本想说，我就知道你可以，但说实话，我其实有过一抹怀疑的阴云……尤其是在我亲眼见过提丰之后。"
    }
    {
      Id = "MelinoeField_3831"
      InheritFrom = "BaseNarrative"
      DisplayName = "他确实体型庞大，这点不容否认！很高兴终于和你面对面相见了，堂哥。你的演奏真动听！"
    }
    {
      Id = "Apollo_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，能让大家紧张的思绪稍微缓和一些，要我做什么都行。至少你给大家带来了好消息，让我有心情献上这样的表演。不过，提丰会回来的，不是么……？"
    }
    {
      Id = "MelinoeField_3832"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想也是。但我也会再回来。就目前来说，请巩固好这里的防线，为下一次攻击做准备吧。现在，我得先走了……我老师在等着我回去呢。"
    }
    {
      Id = "Apollo_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不能直接用祝福和她联系么？我帮你做一个，万一有用呢。以及，谢谢你所做的一切，堂妹。"
    }
    {
      Id = "Apollo_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴再次见到你，堂妹。我还正担心今夜能为大家提振士气的只有我的音乐呢！"
    }
    {
      Id = "MelinoeField_3843"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗堂哥，我也很高兴能见到你。请代我向其他人致意……我很想见一见大家，但我现在得回去了。"
    }
    {
      Id = "Apollo_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然，你一定已经精疲力尽了。其他人肯定也很想见一见你，尤其是你的外婆，可惜他们现在无法离开岗位。请容我替他们向你说声抱歉，也请允许我为你准备返程。"
    }
    {
      Id = "MelinoeField_3844"
      InheritFrom = "BaseSubtitle"
      DisplayName = "替我跟得墨忒尔女神以及其他人说一声，希望大家安好。"
    }
    {
      Id = "Apollo_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的觉得，我们很快就能彻底摆脱那该死的提丰了吗？真是那样的话就太好了。"
    }
    {
      Id = "MelinoeField_3848"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我们有办法能杀死克洛诺斯，那么就一定也有办法杀死众魔之父。而且，我一生都在为此训练，绝对不会接受自己在这里失败。"
    }
    {
      Id = "Apollo_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样啊！那记得提醒我不要惹你生气啊，明媚的女神。你准备好回家了吗？能见到你总是很高兴，不过我该接着唱歌，安抚大家的情绪了。"
    }
    {
      Id = "MelinoeField_3849"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一定可以的。"
    }
    {
      Id = "MelinoeField_3851"
      InheritFrom = "BaseNarrative"
      DisplayName = "一整夜的辛苦攀登之后，听到你的歌声真的很让人振奋，堂哥。几乎都要让我忘掉我们手头上的麻烦了。不过，如此明亮的光芒，我还不太适应……"
    }
    {
      Id = "Apollo_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们最近也不太适应这边阴沉的天色。不过，在你流失更多精力之前，让我赶紧把你送回去吧。听起来你不久后就该去找克洛诺斯了。"
    }
    {
      Id = "MelinoeField_3852"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是的。"
    }
    {
      Id = "Apollo_0186_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们最近也不太适应这边阴沉的天色。不过，在你流失更多精力之前，让我赶紧把你送回去吧。"
    }
    {
      Id = "Apollo_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个魔物，真的消失了……你把他彻底消灭了！自从你第一次取得胜利之后，我对你的信心就从未动摇过。只是……这实在是太难以置信了。所以，现在轮到克洛诺斯了，是么？"
    }
    {
      Id = "MelinoeField_3869"
      InheritFrom = "BaseNarrative"
      DisplayName = "轮到克洛诺斯了，是的。一场振奋人心的胜利，往往能引向另一场。而且现在，你们都可以稍事休息了。我相信你们很需要。"
    }
    {
      Id = "Apollo_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "有普罗米修斯和他的军队在外面惹麻烦，我们还没办法完全放松下来。更何况我们的最大的敌人还没有被消灭。去干掉他吧，明媚的女神。"
    }
    {
      Id = "MelinoeField_3870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "收到。"
    }
    {
      Id = "Apollo_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我看来，我们该为你好好办一场庆功宴才是，明媚的女神。不过迪奥尼索司还是不知所踪，而我们新来的客人吸引了大家几乎全部的精力。而且，很快我们就不对外开放了。"
    }
    {
      Id = "MelinoeField_3920"
      InheritFrom = "BaseNarrative"
      DisplayName = "没关系的，堂哥，我本来也对宴会兴趣不大。而且，我们是得给祖父找个去处。你知道宙斯大人打算怎么处置他吗？"
    }
    {
      Id = "Apollo_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "具体我也不清楚，但据我所知，他打算把克洛诺斯送回冥界，送到哈迪斯大人那里。他们好像已经谈妥了。所以，你真的觉得我们的祖父痛改前非了吗？"
    }
    {
      Id = "MelinoeField_3921"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我觉得他看待事物的角度转变了，是的。至于我，听起来我近期不会再有机会回到这里了。这个地方真的无与伦比，而且每次我来到这里，你都让我感到宾至如归。谢谢你的招待，也谢谢你所做的一切。"
    }
    {
      Id = "Apollo_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，拜托，是我们该感谢你才对，而且真的怎么感谢都不为过。总之，这也不会是永别啦。我会用祝福保持联络的，好么？"
    }
    {
      Id = "MelinoeField_3922"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好的。"
    }
    {
      Id = "Apollo_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "准备回去了吗？来吧，让我为你照亮前路。"
    }
    {
      Id = "Apollo_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的表现一如既往令人惊艳，明媚的女神。我们都很感谢你能来这一趟。"
    }
    {
      Id = "Apollo_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "到现在，你一定很想回到没这么刺眼的地方去吧。"
    }
    {
      Id = "Apollo_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能在这样的时候安心坐在这里拨弄琴弦，全都是你的功劳。"
    }
    {
      Id = "Apollo_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的很希望你能多待一会儿，毕竟你才刚来，不过我知道现在不是时候。在外面一切小心。"
    }
    {
      Id = "Apollo_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴见到你，明媚的女神，不过你最好先和父亲谈谈。"
    }
    {
      Id = "Apollo_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "尽量不要让你叔父等太久。我一直都会在这里的。"
    }
    {
      Id = "Apollo_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "我，呃，我觉得天神和王后可能会想先和你说话？"
    }
    {
      Id = "MelinoeField_4326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很高兴见到您。"
    }
    {
      Id = "MelinoeField_4327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向您致意，得墨忒尔女士！"
    }
    {
      Id = "MelinoeField_4328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "外婆。"
    }
    {
      Id = "Demeter_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也很高兴见到你。"
    }
    {
      Id = "Demeter_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "叫我外婆就好。"
    }
    {
      Id = "Demeter_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Demeter_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "放手去做吧。"
    }
    {
      Id = "Demeter_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我自己知道路。"
    }
    {
      Id = "Demeter_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但愿如此。"
    }
    {
      Id = "Demeter_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好啊。"
    }
    {
      Id = "Demeter_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，小花，真的是你啊！请原谅我，我……我们在这里不能乱了礼数，但……我真的很高兴能亲眼见到你，而不是隔着祝福，像雾里看花一样。"
    }
    {
      Id = "MelinoeField_4318"
      InheritFrom = "BaseNarrative"
      DisplayName = "得墨忒尔女士，这是我的荣幸。我知道大家都在忙于保卫神山；您能抽空来这里看我，一定很不容易。"
    }
    {
      Id = "Demeter_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "叫我外婆就好，不过也许不是在这里。 之前你来的时候，我错过了与你相见的机会，让我很是气恼，因此我绝不会允许那样的事再次发生。但你无法久留，是么……？"
