    {
      Id = "Narcissus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是看不见自己。我真的还存在吗？{#Emph}我们{#Prev}真的还存在吗？天啊……"
    }
    {
      Id = "Narcissus_0210"
