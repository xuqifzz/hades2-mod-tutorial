      DisplayName = "脚步放轻点，可以吗？我喜欢水面彻底平静的样子。"
    }
    {
      Id = "Narcissus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候，我不禁会想……比{#Emph}这{#Prev}还帅的人，恐怕整个世界上再也找不出第二个了吧？"
    }
    {
      Id = "Narcissus_0008"
      InheritFrom = "BaseNarrative"
