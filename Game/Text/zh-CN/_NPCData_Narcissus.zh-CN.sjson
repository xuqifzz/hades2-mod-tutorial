    }
    {
      Id = "Narcissus_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "我按你说的和回声谈过了。{#Emph}然后呢？{#Prev}这地方还是老样子！我还以为你能把一切问题都解决掉呢。"
    }
    {
      Id = "MelinoeField_2847"
