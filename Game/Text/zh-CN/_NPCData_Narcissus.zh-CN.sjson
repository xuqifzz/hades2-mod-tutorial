    }
    {
      Id = "Narcissus_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "洛瑞尔，你看！池水清澈了！你不知道我见到{#Emph}我自己{#Prev}有多开心。一定是拜你所赐！我真想好好给你个拥抱，只不过……我不想让你误会。"
    }
    {
      Id = "MelinoeField_1156"
