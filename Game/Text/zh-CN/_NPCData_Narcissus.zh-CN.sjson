    }
    {
      Id = "Narcissus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想说的是，我决定把我有史以来收到的最棒的礼物送给你。所以看好了，这可是我的{#Emph}私人收藏{#Prev}……！"
