    }
    {
      Id = "Narcissus_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你看起来真不错，帅哥。你……你看起来{#Emph}太美了{#Prev}。而且你还不自知！你还不自知，对吧？"
    }
