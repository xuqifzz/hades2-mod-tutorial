    }
    {
      Id = "MelinoeField_0720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意，纳西索斯。"
    }
    {
      Id = "Narcissus_0031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随便啦！"
    }
    {
      Id = "Narcissus_0024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "什么？"
    }
    {
      Id = "Narcissus_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿。"
    }
    {
      Id = "Narcissus_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意。"
    }
    {
      Id = "Narcissus_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "彼此彼此。"
    }
    {
      Id = "Narcissus_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢了。"
    }
    {
      Id = "Narcissus_0147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Narcissus_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "行吧。"
    }
    {
      Id = "Narcissus_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯？"
    }
    {
      Id = "Narcissus_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了，好了。"
    }
    {
      Id = "Narcissus_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯哼。"
    }
    {
      Id = "MelinoeField_1987"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦！呃，谢啦！"
    }
    {
      Id = "MelinoeField_2848"
      InheritFrom = "BaseSubtitle"
      DisplayName = "去跟她说一说吧。"
    }
    {
      Id = "Narcissus_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，看啊。又一个追求我的人，跑遍天涯海角，只为一睹我的容颜——这也不怪你——然后被无情拒绝！{#Emph}好吧{#Emph}，你非要看的话，就看个够吧。"
    }
    {
      Id = "Melinoe_2047"
      InheritFrom = "BaseNarrative"
      DisplayName = "你误会了。我不是来求爱的。我都不知道你是谁。"
    }
    {
      Id = "Narcissus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？真是有眼无珠，蠢货，我可是纳西索斯！{#Emph}大名鼎鼎{#Prev}的纳西索斯，你难道没听过吗？以及，倘若你不是来追求我的……那这里数不清的礼物，不如你选一份拿去吧。都是我的追求者送来的，可惜徒劳无用。{#Emph}拿了就赶紧走人。"
    }
    {
      Id = "Narcissus_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，我去，你怎么这副模样跑到这里来了？你需要的不是{#Emph}我{#Prev}，蠢货。你需要的是医生，或者找个{#Emph}治疗师{#Prev}之类的也行。"
    }
    {
      Id = "MelinoeField_1162"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我知道，可是那两类人在这个地方都实在难找。话说回来，你这里也不错啦，至少没有海底的怪物想要把我开膛破肚。"
    }
    {
      Id = "Narcissus_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "这话我不是第一次听了。听好了，这附近估计有泉水什么的，快去清洗一下伤口，然后再来跟我{#Emph}聊天{#Prev}也不迟。"
    }
    {
      Id = "Narcissus_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，你这样每天鼻青脸肿，浑身是血地跑来跑去，永远也不会有人看上你的。我这里说不定有能帮你包扎的东西，只要能让你赶紧离开就行。"
    }
    {
      Id = "Narcissus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "插队了啊！不管你是谁，至少你比那后面排着一长串追随者更有勇气。不过，就算这样，你还是{#Emph}毫无机会{#Prev}。"
    }
    {
      Id = "MelinoeField_3503"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些暗灵生前一定对你爱慕有加，死后才会在这里徘徊不去。但我不是有意插队的，我只是想来说声谢谢，感谢你之前那晚送我的礼物。"
    }
    {
      Id = "Narcissus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "得了吧，每一种开场白我都听过无数遍，何况“只是想来说声谢谢”是最经典的一种。所以你就别装了！我知道你真正想要的是什么；你是得不到的。你能得到的只有这个。"
    }
    {
      Id = "Narcissus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只有一条规矩，那就是{#Emph}“眼看手勿动”{#Prev}，好么？你能不能站远一点，然后跟我解释一下，为什么你总是像这样突然出现？"
    }
    {
      Id = "Melinoe_2048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在冥界的更深处有些事情要解决。我想着找一条风景优美的路，所以就从你的房间这里过了。"
    }
    {
      Id = "Narcissus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这不是我的房间。我只是发现这里的池水格外干净，倒影格外清晰，而且和水仙花平原比起来，追求者也要少得多。离开之前记得挑一份礼物带走！"
    }
    {
      Id = "Narcissus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "有时候我会想，要是我没有这副绝世美貌，生活会是什么样子？有些事可能会轻松很多……毕竟不像现在这样，每个人都想与我坠入爱河……说不定我还能有时间学学算术……"
    }
    {
      Id = "Melinoe_2049"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是在担心自己太惹人喜爱了，以至于会带来不便……？唔，不知道这样说会不会让你好受一点，我没觉得你特别有吸引力……"
    }
    {
      Id = "Narcissus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我知道你这是言不由衷。但是谢谢你试图安慰我。{#Emph}你是一个好人。"
    }
    {
      Id = "Narcissus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里真不错，不是么？空气潮湿，池水清澈，而且不会下雨！下雨的话，我就彻底看不见自己了。"
    }
    {
      Id = "MelinoeField_3505"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能觉得冥界未经修缮的边缘地区超出了你的预期，让我很欣慰。冥王哈迪斯大人一定也希望所有的暗灵都能在冥界住得舒心。"
    }
    {
      Id = "Narcissus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，我知道{#Emph}这么好的地方{#Prev}不是人人都能有的。冥界的好去处都是生前赢得的，不是么？这么说就不奇怪了！"
    }
    {
      Id = "Narcissus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "又来了啊，洛瑞尔还是谁来着。我正回忆我们初次见面的场景呢。我看向波光粼粼的河水……发现他就在那里。我们四目相对，仿佛他能看到我的{#Emph}灵魂{#Prev}。自那之后，我们就再也没有分开过。"
    }
    {
      Id = "MelinoeField_1160"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，我恐怕从没见过像你这样迷恋自己的人，纳西索斯。我都有点嫉妒你了。当我看向我自己的时候……我会看到许许多多的缺点。"
    }
    {
      Id = "Narcissus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，我太懂你的意思了。毕竟，不是每个人生来就有吹弹可破的肌肤……熠熠生辉的秀发……全身上下挑不出半点毛病。但每个人都有自己的美丽之处！{#Emph}哪怕是你{#Prev}也不例外。"
    }
    {
      Id = "MelinoeField_1992"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能这样全心全意爱着自己，真的很难以置信。你难道就不会……回想起自己曾经犯过的错，或者找到自己想要改进的地方吗？或者，就算你{#Emph}不想{#Prev}改进……"
    }
    {
      Id = "Narcissus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你在开玩笑吗？你倒是说说看，{#Emph}这副{#Prev}模样还有什么可以改进的？不过，我倒是完全理解你的意思。毕竟你是{#Emph}你{#Prev}。"
    }
    {
      Id = "MelinoeField_1993"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是在嘲笑我么，还是说你确实有什么关于我的建议或者反馈乐意分享？"
    }
    {
      Id = "Narcissus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你对你自己现在的样子不满意，那你为什么不，嗯，{#Emph}做出改变{#Prev}呢？或者，做不到的话……那就别老惦记着了吧，我也不知道。"
    }
    {
      Id = "Narcissus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来， 我在想个事——如果你不爱{#Emph}我{#Prev}，那就意味着，你一定正被别的人迷得神魂颠倒！所以是哪个幸运儿有这样的殊荣？"
    }
    {
      Id = "MelinoeField_2852"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事跟你没关系……但你之前曾经对我敞开心扉。这么说吧，我真的不会像你说的那样爱上别人。那些主角被人迷得神魂颠倒的故事……我读起来完全无法感同身受。"
    }
    {
      Id = "Narcissus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那也没关系！我对其他人的爱也无法感同身受。总之，只要你有让你继续下去的力量源泉就好！考虑到你反反复复在这现身，{#Emph}我猜你是有的。"
    }
    {
      Id = "Narcissus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有许多追求者说他们想要做朋友，但是……他们仍然深爱着我。我只能与他们一刀两断。为什么做朋友比恋爱还难，你有什么头绪吗？"
    }
    {
      Id = "MelinoeField_2853"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许是因为……人在动情的时候，要想顺其自然，不用付出什么精力；抑制自己的感情才需要。但是，要培养友谊……需要为之不断努力。"
    }
    {
      Id = "Narcissus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许吧。我之前总是想，我不需要朋友，毕竟我永远不会孤独，但是……朋友有的时候也挺好的！可以多个人说说话。比如回声，还有{#Emph}你！"
    }
    {
      Id = "Narcissus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我最近一直在想，为什么有那么多的朋友，不甘于“只做朋友”呢？就，做朋友{#Emph}难道不好吗{#Prev}？非得搞点浪漫出来，然后一切就全完了！"
    }
    {
      Id = "MelinoeField_2854"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许他们只是在努力避免孤单吧。我们无法时时刻刻控制自己的感受，甚至有的时候都说不清楚这些感受的源头。所以，我们会判断失误，做出错误的选择。"
    }
    {
      Id = "Narcissus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可不会！但是其他人可能都是这样吧。总之，真正的友谊也是一种爱，也应该要经受得住起起伏伏才行。"
    }
    {
      Id = "Narcissus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，等等，到现在你已经可以算是我的{#Emph}朋友{#Prev}了，不是么？除非你是在放长线……等我放松警惕，然后钓上我这条{#Emph}大鱼{#Prev}！真正的终极追求者……"
    }
    {
      Id = "MelinoeField_3508"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能理解你想要时刻保持警惕，毕竟就算你明确表示自己不感兴趣，还是有那么多人执迷不悟地追求你。不过我不是那样的人。"
    }
    {
      Id = "Narcissus_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "这世道真是，再怎么小心也不为过。所以，不要突然有什么大动作，好么？如果你来这里不是为了我……那就一定是为了{#Emph}这些{#Prev}吧。"
    }
    {
      Id = "Narcissus_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我想告诉你，我已经认定你真的不是来拉我坠入爱河的了。我意识到你其实别有所图，而且更加……{#Emph}令人烦恼。"
    }
    {
      Id = "MelinoeField_3509"
      InheritFrom = "BaseNarrative"
      DisplayName = "更加令人{#Emph}烦恼？{#Prev}好吧，我做好心理准备了。我们都认识这么久了，纳西索斯，你觉得我到底是图什么呢？"
    }
    {
      Id = "Narcissus_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "你来这里，图的正是我无数次不假思索拱手送出的免费赠礼。如果不是因为我的无私，没有人会喜欢我……没有人会看得上我的{#Emph}本性{#Prev}。"
    }
    {
      Id = "MelinoeField_3510"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不觉得我喜欢的不只是你的礼物，还有你的陪伴么？何况慷慨也是你的本性啊。话说回来，如果你无法确定的话，要不然就来做个实验，看看没有礼物我还会不会来？"
    }
    {
      Id = "Narcissus_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要！不要，或者……好像也有道理。唔，我之前从来没有想过还能这样。可是，后果不堪设想，唔！让我自己考虑一下吧。不过，首先……"
    }
    {
      Id = "Narcissus_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是我这次什么礼物都不给你了呢？你会怎么想，嗯？我警告你，我是认真的哦！"
    }
    {
      Id = "MelinoeField_3511"
      InheritFrom = "BaseNarrative"
      DisplayName = "没问题呀，如果这样做能让你感觉好受些，或者让你放下心头的顾虑的话。反正你能提供的大多数资源，我现在也不怎么需要了。"
    }
    {
      Id = "Narcissus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这是虚张声势！你{#Emph}肯定想要{#Prev}我在无数的礼物中让你挑一件。哼，你给我听好了！就这么决定了！这次，你……{#Emph}什么都得不到！{#Prev}我看你怎么想！{#Emph}哼！"
    }
    {
      Id = "MelinoeField_3649"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我没意见啦。那就下回再见！"
    }
    {
      Id = "Narcissus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "……还来这里干什么，洛瑞尔？我对追求者没兴趣，也不会再送东西出去了，而且我也清楚自己不是什么当朋友的料。别来找我了……"
    }
    {
      Id = "MelinoeField_3512"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你最近的烦恼是不知道怎么成为“当朋友的料”的话，你可以从叫对我的名字开始哦。我叫墨利诺厄。不过，我越来越习惯被叫做“洛瑞尔”了……"
    }
    {
      Id = "Narcissus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "……就凭你这句话，我就要把你{#Emph}这次{#Prev}的礼物也扣掉！哪有像我这样做朋友的，是不是？现在快走吧，让我把我的注意力倾注在我{#Emph}真正{#Prev}在乎的那个人身上。"
    }
    {
      Id = "MelinoeField_3650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随你。"
    }
    {
      Id = "Narcissus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "……帅哥，你真是个好朋友。而且远远不只是朋友。你永远都在这里陪着我，你懂么？除了水面变得浑浊不堪那次，不过那次有洛瑞尔，唔……是{#Emph}墨利诺厄{#Prev}……她真的帮了我们大忙……"
    }
    {
      Id = "MelinoeField_3513"
      InheritFrom = "BaseNarrative"
      DisplayName = "然而现在你却开始忽视我，只因为你出于某种原因，就是不愿意相信我珍视的是你的友谊，而不是你那些堆积如山的多余礼物。"
    }
    {
      Id = "Narcissus_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "不听不听！而且，既然你都说我的礼物“多余”了，这次就{#Emph}也免了{#Prev}，相信你不会有任何意见吧。"
    }
    {
      Id = "MelinoeField_3651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，我没意见。"
    }
    {
      Id = "Narcissus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "……有的时候我会想回声最近过得怎么样……以及{#Emph}你{#Prev}过得怎么样，我是在说{#Emph}你{#Prev}，不是说{#Emph}我{#Prev}……然后我就又会开始想，你会不会也在想{#Emph}我{#Prev}过得怎么样。真是一团糟。"
    }
    {
      Id = "MelinoeField_3514"
      InheritFrom = "BaseNarrative"
      DisplayName = "放心，这种事是完全正常的啦。不过你不用想我怎么想，你可以直接问的！毕竟我隔三岔五就会来看你，只要你不把我拒之门外。"
    }
    {
      Id = "Narcissus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还是时不时会来看我，就算我不送你礼物了也一样。所以你来这里，真的只是顺路过来拜访一下我吗？"
    }
    {
      Id = "MelinoeField_3515"
      InheritFrom = "BaseNarrative"
      DisplayName = "要么拜访你，要么拜访巨海蛇，你说呢。"
    }
    {
      Id = "Narcissus_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯……"
    }
    {
      Id = "Narcissus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，自从我不再让你挑一件多余的礼物带走之后，这里的礼物真的堆得好多……甚至有一些品质{#Emph}相当不错{#Prev}……"
    }
    {
      Id = "MelinoeField_3516"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些礼物是给你的，不是给别人的，纳西索斯。我相信那些追求你的人都希望你能留着它们。"
    }
    {
      Id = "Narcissus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，说到这个，那些暗灵里面，有一些好像听说过你！不过他们实在太缺乏安全感了，不敢直接把礼物送给你，所以……他们就把礼物暂存到{#Emph}我{#Prev}这了。"
    }
    {
      Id = "MelinoeField_3517"
      InheritFrom = "BaseNarrative"
