    }
    {
      Id = "Hecate_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}岁月的考验、时间的阴谋。"
    }
    {
      Id = "Melinoe_2584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}岁月的考验、时间的阴谋。"
    }
    {
      Id = "Hecate_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿吾等得偿所愿。"
    }
    {
      Id = "Melinoe_2585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿吾等得偿所愿。"
    }
    {
      Id = "Hecate_0725"
      InheritFrom = "BaseNarrative"
      DisplayName = "是时间逼迫我们采取了行动，墨利诺厄。没有人寄希望于你一夜之间就斩落我们的大敌，更何况昨夜还是一轮新月！"
    }
    {
      Id = "Melinoe_2906_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "我自己没办法像这样原谅我的失败，赫卡忒老师。时间泰坦还在为非作歹，奥林匹斯仍然战火纷飞，而我又回到了原点！"
    }
    {
      Id = "Hecate_0726"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，你不仅回来了，还恢复了健康了；虽然精神上受了些打击，但也学到了宝贵的教训。这并非一次失败，而是一个开始！一切都在计划之中。{#Emph}克洛诺斯必死无疑。"
    }
    {
      Id = "Melinoe_0014_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "克洛诺斯必死无疑。"
    }
    {
      Id = "Hecate_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "可惜，炼金釜尚未净化完成。但祭坛那有你能用的东西，而且我还为你解除了银辉之池的封印。"
    }
    {
      Id = "Hecate_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们会在这里等你安全归来。愿明月指引你。"
    }
    {
      Id = "Hecate_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的初次尝试收获颇丰，墨利诺厄。倘若我没有对你横加阻拦的话，我相信你甚至还能走得更远。而且不得不承认，我对你的阻拦并不太成功。"
    }
    {
      Id = "Melinoe_1802"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白，您需要确认我是否做足了准备。而且我也知道，我还有许多方面要接受您的检验。"
    }
    {
      Id = "Hecate_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是。你要相信你的直觉，以及你的巫术造诣。继续你的任务吧。{#Emph}克洛诺斯必死无疑。"
    }
    {
      Id = "Hecate_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么了，墨利诺厄？你的眉头紧锁，写满的不是凌厉，而是犹疑……而犹疑的代价我们负担不起。"
    }
    {
      Id = "Melinoe_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，老师，我只是……我知道我应该感到愤怒，但我却很难把握住这种情绪。我的任务是杀死一名我不认识的泰坦，为我不记得的家人复仇……"
    }
    {
      Id = "Hecate_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的感受从不会对你说谎，只是其根源有时会对你加以欺瞒。你感受不到愤怒？那就意味着你没有失控。告诉我，你有没有怀疑过我们任务的重要性？"
    }
    {
      Id = "Melinoe_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有，老师。篡夺冥府的罪行必须受到惩罚。"
    }
    {
      Id = "Hecate_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "正是。专注于此。"
    }
    {
      Id = "Hecate_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的任务进展得如何，墨利诺厄？我们的大敌的注意力仍在更为紧迫的事情上。现在正是对他发起进攻的大好时机。"
    }
    {
      Id = "Melinoe_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还有很多事情要做，老师，您一定是知道的。我还有多少时间？"
    }
    {
      Id = "Hecate_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁说得准呢？我们的敌人是时间本尊。时间的流逝现在似乎已经失去其意义了。不需要仓促行事；所谓欲速则不达，正是这个道理。"
    }
    {
      Id = "Hecate_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的肩上满是期望。你从不跟人提起你所感受到的压力，但我清楚无比。压力自始自终与你如影随形。"
    }
    {
      Id = "Melinoe_2133"
      InheritFrom = "BaseNarrative"
      DisplayName = "我已经很难分辨出压力和信心了。我的一生都在为此做准备，大家都指望着我。您真的相信我最终会取得胜利吗，老师？"
    }
    {
      Id = "Hecate_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "压力和信心总是形影不离，没错。它们始终在彼此斗争。倘若压力彻底胜出，那么结果便是绝望。只有到了那个时候，才真正算得上是动摇。"
    }
    {
      Id = "Melinoe_2134"
      InheritFrom = "BaseNarrative"
      DisplayName = "您没有回答我的问题。纵使众神联手，此前也没有办法彻底阻止克洛诺斯。而您也知道，命运三女神从来捉摸不定。我的成功不是必然……"
    }
    {
      Id = "Hecate_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的信心不在最终的结果，墨利诺厄，而在你！而且我信心十足。倘若你发觉自己对自己信心不足，我随时可以分你一些。"
    }
    {
      Id = "Melinoe_2135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……谢谢您对我的信任。"
    }
    {
      Id = "Hecate_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不用谢我。"
    }
    {
      Id = "Hecate_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少我们的炼金釜终于净化完毕了，感谢命运三女神！说到这个，你还在考虑施放咒语向她们求助的事吗？我怀疑她们并不会回应你，哪怕如今事态严峻……"
    }
    {
      Id = "Melinoe_2900"
      InheritFrom = "BaseNarrative"
      DisplayName = "任何能让命运三女神帮助我们的机会，对我来说都值得一试。感谢您为我准备好相关事宜。不过，我还缺少新鲜的炼金材料。"
    }
    {
      Id = "Hecate_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯。我会很乐意为你提供这些材料，只可惜我无法这样做。不过，在林地里前进的时候，留意路边的草木，你便能有所收获。只要命运三女神愿意……"
    }
    {
      Id = "Melinoe_0585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白了，老师。"
    }
    {
      Id = "Hecate_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神终究是回应了你的祈求。在你的帐篷外的是她们的卷轴；它和你一起从阴影中浮现。也许那上面能找到些答案。"
    }
    {
      Id = "Melinoe_0968"
      InheritFrom = "BaseNarrative"
      DisplayName = "要真是那样的话就好了。命运清单指示我去确保某些次要预言的完成，但除此之外上面没有别的内容。"
    }
    {
      Id = "Hecate_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就愿它至少会为你的努力提供奖励。但不要指望命运三女神永远青睐你；我们敌人的敌人，不见得总是我们的朋友。"
    }
    {
      Id = "Melinoe_1800"
      InheritFrom = "BaseSubtitle"
      DisplayName = "但这是个机会……"
    }
    {
      Id = "Hecate_0625"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些道路与可能性大抵属实；倘若你达成原初混沌的旨意，等待你的奖励也应该确有其事。与卡俄斯有关的事物总有不确定因素……但我相信倪克斯的亲人会是我们的盟友，而非敌人。"
    }
    {
      Id = "Melinoe_2902"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也这样觉得。"
    }
    {
      Id = "Hecate_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "找到机会翻阅暗影之书了吗，墨利诺厄？我们的任务会使你离开三岔路口，走遍天涯海角。你还有很多事物需要学习。"
    }
    {
      Id = "Melinoe_1011"
      InheritFrom = "BaseNarrative"
      DisplayName = "每当我的经验积累，产生启发时，书上就会揭示更多内容。书里记载的都是{#Emph}您的{#Prev}教导吗，老师？"
    }
    {
      Id = "Hecate_0274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不全是我的，不过，你尽管去遵循就好……"
    }
    {
      Id = "Melinoe_5287"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗影之书……我以前一直没办法完全确定作者是谁。我怀疑是您，毕竟它有的时候，在我的想法还没有成型时，就先一步把它们写下来了。"
    }
    {
      Id = "Hecate_0848"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有完全猜中，但对于作者为什么对你的想法理解得这么透彻，确实是捕捉到了些蛛丝马迹。那本书有好些年头了……替我好好保管它吧。"
    }
    {
      Id = "Melinoe_5288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会的，我保证。"
    }
    {
      Id = "Hecate_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还记得第一次掌控伊格尼姆双炬时的情景。那时候的我和现在的你年岁相仿。现在，它们的力量轮到你来掌控了。"
    }
    {
      Id = "Melinoe_1014"
      InheritFrom = "BaseNarrative"
      DisplayName = "火焰虽小，光影犹长；这不正应了这个道理么，老师？我会全力以赴，按照您的指教好好使用双炬的。"
    }
    {
      Id = "Hecate_0643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "用{#Emph}你自己{#Prev}的方式，墨利诺厄。"
    }
    {
      Id = "Melinoe_0970"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又一次梦到我的父亲了。和以往一样，是克洛诺斯杀来了冥府与他对峙，而您把我带去安全的地方。只不过这次，我在梦里留得更久。"
    }
    {
      Id = "Hecate_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "显然，那并不只是个梦。你在梦境中逗留时，还有什么发现？"
    }
    {
      Id = "Melinoe_2916"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还得知了克洛诺斯想要让我父亲告诉他，在哪里能找到命运三女神。克洛诺斯要么是恨透了她们，要么是觉得她们是个威胁。他这么久以来一直在找她们，不是么？而现在他终于得逞了。"
    }
    {
      Id = "Hecate_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "这意味着倘若逼迫她们做出选择的话，她们可能不会站在我们这边。我一直有这样的担忧，只是不想说出来，以免一语成谶。哎，至少这证明了问题的严重性，看来赫尔墨斯所言非虚！{#Emph}“糟了个大糕”{#Prev}，他原话是这么说的吧？"
    }
    {
      Id = "Melinoe_2917"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}“糟了个大糕”{#Prev}，没错……"
    }
    {
      Id = "Hecate_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "看得出，你的梦境又一次搅扰了你的心神。哪怕你勇敢地努力掩饰。"
    }
    {
      Id = "Melinoe_1021"
      InheritFrom = "BaseNarrative"
      DisplayName = "我应付得过来，老师。只不过……这是克洛诺斯干的。我现在就算是在睡梦中，也能听到他的声音。"
    }
    {
      Id = "Hecate_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就把你的噩梦化为他的噩梦。你的潜意识是你最强大的庇护所。不要让任何没有得到你允许的人擅闯其中。"
    }
    {
      Id = "Hecate_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "银月塞勒涅告诉我，她赐予了你她的光辉与力量。即使在这里，她也能听到你的呼唤吗？"
    }
    {
      Id = "Melinoe_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "我找到了一束月光，然后就用咒语呼唤了塞勒涅，让她对我降下援助。她的力量仿佛无边无际，让我难以想象其极限……"
    }
    {
      Id = "Hecate_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对她的力量非常了解。你只是此前没有过亲自驾驭这种力量的机会。我想，机会很快就会来了。"
    }
    {
      Id = "Melinoe_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个任务……为什么会落在我一个人的肩上，老师？毕竟，涅墨西斯她……"
    }
    {
      Id = "Hecate_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}她{#Prev}是个累赘。倘若我没有向倪克斯立下誓言，说我会照看她所有的孩子，我早就该因为她不服管教，将她逐出门外了。"
    }
    {
      Id = "Melinoe_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "她之所以愤愤不平，是因为您没有给过她机会。她的力量远在我之上，而且她训练得至少和我同样刻苦，这是我亲眼所见！"
    }
    {
      Id = "Hecate_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "为何要如此袒护她，墨利诺厄？她的态度比一切言语更有说服力。我是不会把重要的任务交付给她这样的人的。"
    }
    {
      Id = "Melinoe_2244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph} （嗤鼻声）"
    }
    {
      Id = "Hecate_0853"
      InheritFrom = "BaseNarrative"
      DisplayName = "修普诺斯走得还真是匆忙。他被你唤醒这件事，发生得比我预想得更晚一些，但塞翁失马，焉知非福啊。"
    }
    {
      Id = "Melinoe_5292"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，您早就{#Emph}预想到{#Prev}这件事会发生？那您为什么不在我那么多次试图唤醒他时说点什么呢？我还以为您只是忽视了他。"
    }
    {
      Id = "Hecate_0854"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，确实，在我看到你已经学到足够多东西之后，我就忽视了他。事实证明，你对梦境一类事物的相性，对任务的完成至关重要，而修普诺斯，以他自己的方式，对此提供了帮助。"
    }
    {
      Id = "Melinoe_5293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您把他带过来，就是为了让我练手……？"
    }
    {
      Id = "Hecate_0855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他也需要有个地方待着嘛。"
    }
    {
      Id = "Melinoe_2914"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，昨晚，我……我穿过了一扇门，门的另一端是混沌的深渊……而我在那里见到了卡俄斯本尊！我听您讲述了那么多关于倪克斯的故事，但却唯独没想到有一天我会见到她的生身父母。"
    }
    {
      Id = "Hecate_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "与原初混沌谋面的机会……确实出乎我的意料！不过，自从克洛诺斯篡夺冥府之后，倪克斯便杳无音讯，因此会有这样的事情也不令人惊讶。失去孩子的父母所爆发出的愤怒，在世间无可比拟。那么，卡俄斯看起来像是我们的盟友吗？"
    }
    {
      Id = "Melinoe_2915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我想是的。"
    }
    {
      Id = "Hecate_0639"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎，感谢倪克斯……"
    }
    {
      Id = "Hecate_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯回到了我们身边，相信你亲眼看到了吧？我原本盼望着，等到她脚下的垃圾堆积如山的时候，她便会忍受不住，自己动手清理，唉……可惜事与愿违。你还是不要去招惹她为好。"
    }
    {
      Id = "Melinoe_2528"
      InheritFrom = "BaseNarrative"
      DisplayName = "我原本还以为您终于做出了决定，收回了她进入三岔路口的权限呢。我宁可亲自动手为她打扫，也不愿意亲眼看着她把这个地方变成猪圈。"
    }
    {
      Id = "Hecate_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，厄里斯看到你现在这副无可奈何的表情，该是多么得意啊。我深知要想摆脱一件事物，对其置之不理通常并非明智之举，然而……对于厄里斯来说，恐怕我们别无选择……"
    }
    {
      Id = "Hecate_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "银月塞勒涅告知我，阻止你登上奥林匹斯山的不是别人，正是那厄里斯啊。当初真不该让那个{#Emph}小无赖{#Prev}再次染指狮鹫坚炮。"
    }
    {
      Id = "Melinoe_3445"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我们真的没有什么能做的吗？您对倪克斯立下的誓言，难道真的意味着厄里斯可以想来就来，想走就走，还可以在我接近目标的时候试图用狮鹫坚炮把我轰成渣？"
    }
    {
      Id = "Hecate_0646"
      InheritFrom = "BaseNarrative"
      DisplayName = "在签订契约之时，必须仔细审视其条款，墨利诺厄。哎，我当年犯下的错误，恐怕要由你来付出代价了。至少，在下次见面时，你可以好好收拾她一顿？"
    }
    {
      Id = "Melinoe_3446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来不错……"
    }
    {
      Id = "Hecate_0706"
      InheritFrom = "BaseNarrative"
      DisplayName = "你把普罗米修斯从他的藏身之处撵出来了。不知道他是怎么挣脱了枷锁！他究竟是真正的理想主义者，还是仅仅为了造反才加入克洛诺斯麾下，我还没有得出结论。"
    }
    {
      Id = "Melinoe_3895"
      InheritFrom = "BaseNarrative"
      DisplayName = "他站在克洛诺斯那边的理由，我看来很简单；首先，他想要对叔父宙斯和奥林匹斯众神复仇。其次，他自己也是个泰坦。"
    }
    {
      Id = "Hecate_0707"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我{#Prev}也是个泰坦，银月塞勒涅也一样，你可别忘了！我们的血脉并不会决定我们效忠于谁，或是持有哪些观念。不过，也许普罗米修斯不这么想。"
    }
    {
      Id = "Melinoe_3896"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他真的能看见未来所发生的一切么？"
    }
    {
      Id = "Hecate_0708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许他只是疯了吧。而且疯得不轻。"
    }
    {
      Id = "Hecate_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯告知我，普罗米修斯在将你击退之后，对奥林匹斯山的进攻可谓变本加厉。我不是教过你辟火防身的法门么？"
    }
    {
      Id = "Melinoe_3897"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是他只会用火就好了。然而，他还养了只凶狠异常的鹰，而且还有别的手段。那奥林匹斯山现在怎么样了，他都做了些什么？"
    }
    {
      Id = "Hecate_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "他让众神非常紧张。他从不让军队倾巢而出，而且不会打自己赢不了的战斗！真是个难缠的对手，哪怕他最终无法取得胜利。"
    }
    {
      Id = "Melinoe_3898"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您为什么这么认为？"
    }
    {
      Id = "Hecate_0711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "因为他只是一个泰坦，而与他为敌的却是众神。"
    }
    {
      Id = "Hecate_0760"
      InheritFrom = "BaseNarrative"
      DisplayName = "盗火的普罗米修斯仍是执意要阻拦你登上山顶啊。他最近又对你说了什么胡言乱语？"
    }
    {
      Id = "Melinoe_4048"
      InheritFrom = "BaseNarrative"
      DisplayName = "他似乎对人类负有沉重的责任感与愧疚感。我担心他是想扰乱我们的军心……我们麾下一定有些暗灵对他产生了同情。"
    }
    {
      Id = "Hecate_0761"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么听起来，倒像是你开始对他产生同情了。不要被他的夸夸其谈所欺骗；他选择了站在我们的对立面，而且态度坚决得很。"
    }
    {
      Id = "Melinoe_4049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是……我明白。"
    }
    {
      Id = "Hecate_0774"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯表示，近来你在奥林匹斯山击退提丰的战役中功不可没啊。相信你那些正在遭受进攻的亲戚，对这样的结果也有尽他们的一份力吧？"
    }
    {
      Id = "Melinoe_4355"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于阻止提丰进攻这件事而言，我可能只是在前线佯攻，但总之计划奏效了。至少宙斯大人召来了天雷，让提丰再次尝到了他闪电的厉害。其他人都忙于别处，无暇他顾……"
    }
    {
      Id = "Hecate_0775"
      InheritFrom = "BaseNarrative"
      DisplayName = "那众神一定很感激有你这样强大的“前线佯攻”，而克洛诺斯也一定很感激这个稍作休息的机会。不过，按你的想法继续开展任务便是；这一切都是泰坦计划中的一环，而同样也将为我们的计划添砖加瓦。"
    }
    {
      Id = "Melinoe_4356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也正是这么想的。"
    }
    {
      Id = "Hecate_0849"
      InheritFrom = "BaseNarrative"
      DisplayName = "塞勒涅表示，你似乎从头到尾地经受住了敌手之誓的考验。她的观测少有失误，但像这样的事情，我还是想要找你求证一下。"
    }
    {
      Id = "Melinoe_5289"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以证明她没有看错。我几乎期待着回来能有什么盛大的宴会或者仪式庆祝一下了，毕竟这个挑战实在非同小可。不过那样做或许不符合黑夜一贯践行意志的方式。"
    }
    {
      Id = "Hecate_0850"
      InheritFrom = "BaseNarrative"
      DisplayName = "换做倪克斯本尊会说：{#Emph}“追求实现自己的价值，不要追求闻名于世。”{#Prev}至少，塞勒涅和我都明白你实现了何种壮举。但如果你想追求荣誉的话，只怕是选错了出生的界域。"
    }
    {
      Id = "Melinoe_5290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这对我来说，已经是足够的荣誉了。"
    }
    {
      Id = "Hecate_0777"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山的山顶上，宙斯大人的圣殿，还算符合你的想象么？克服了一路上的那么多磨难，那里的风景最好是值得。"
    }
    {
      Id = "Melinoe_4726"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从未见过像宙斯的圣殿那样的地方。虽然一切都无比生动，但我却几乎看不清任何东西。感觉就好像我不属于那里。"
    }
    {
      Id = "Hecate_0778"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。嗯，至少你山上的亲戚在你短暂停留时招待了你一番！"
    }
    {
      Id = "Melinoe_4727"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是的，但……很高兴我回来了。"
    }
    {
      Id = "Hecate_0762"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们所面对的两个大敌，已经逐一被你斩于阵前。如此一来，形势便开始对我们有利……"
    }
    {
      Id = "Melinoe_4050"
      InheritFrom = "BaseNarrative"
      DisplayName = "我或许有能力在战斗中击败克洛诺斯和提丰，但有的时候我感觉这对阻止他们的计划起不到什么真正的作用。知道您不这么想，让我松了一口气。"
    }
    {
      Id = "Hecate_0763"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的断言不仅仅是基于想象。你已经证明了你有充足的力量和知识完成你的任务。至于你是否有充足的耐心，这点我们拭目以待。"
    }
    {
      Id = "Melinoe_4051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "耐心，是么……"
    }
    {
      Id = "Hecate_0791"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}时间消逝。魔物解离。{#Prev}这两个咒语相互联系，会取消已经发生的事情，而且是以暴力的方式。如此使用巫术，本身何尝不是一种暴行……"
    }
    {
      Id = "Melinoe_5777"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。您总是说，这样的力量永远不该动用，除非别无他法……而就算别无他法，也要三思而行。您是怎么发现这样的咒语的？您对克洛诺斯的了解，简直比他自己还要多。"
    }
    {
      Id = "Hecate_0792"
      InheritFrom = "BaseNarrative"
      DisplayName = "当我得知克洛诺斯对你和其他人的所作所为之后……我拒绝接受这一切。但我仍然对他展开了研究。在力量之中，总会暗藏消解自身的玄机。"
    }
    {
      Id = "Melinoe_4742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哪怕是他和提丰的力量……"
    }
    {
      Id = "Hecate_0793"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哪怕是他们的力量，也不例外。"
    }
    {
      Id = "Melinoe_4733"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲的矛，吉加罗斯……就在王子的房间中等着我。扎格列欧斯一定是在他的时间中拿到了它，通过这样的方式交给了我。那么，最后一步？"
    }
    {
      Id = "Hecate_0788_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "时机未到。我们只有一次机会用它袭击克洛诺斯，而且需要做足一切准备，以确保它会产生应有的效果。"
    }
    {
      Id = "Melinoe_5016"
      InheritFrom = "BaseNarrative"
      DisplayName = "“时间消逝”这道咒语需要的最后一种材料是熵，可是……我该去哪里找这种材料呢？目前我还没有找到任何它存在的痕迹…就连在提丰那里也找不到。"
    }
    {
      Id = "Hecate_0795"
      InheritFrom = "BaseNarrative"
      DisplayName = "正确的问题是，你应该去哪里{#Emph}创造{#Prev}它。若要产生熵，必须有相当强大的力量彻底归于湮灭。明白我的意思了么？"
    }
    {
      Id = "Melinoe_5017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我想我明白了。那么，该重回地表了。"
    }
    {
      Id = "Melinoe_5730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我想我明白了。首先，要施展魔物解离。"
    }
    {
      Id = "Hecate_0752"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确；在你再次面对众魔之父前，最好反复提醒自己这点。不要承担不必要的风险，也不要忘记你真正的任务。"
    }
    {
      Id = "Melinoe_4047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们会做必要之事。"
    }
    {
      Id = "Hecate_0753"
      InheritFrom = "BaseNarrative"
      DisplayName = "若非这样的结果令我太过震惊，我肯定会对你的成功大加赞赏。不过，倘若你再次面对众魔之父，别指望他会再被你打个措手不及。不要承担不必要的风险，也不要忘记你真正的任务。"
    }
    {
      Id = "Hecate_0754"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰都打到家门口去了，你在山上的那些亲戚还能抽空对你伸出援手，还真是个奇迹。据你所知，他们有任何阻止提丰的计划吗？"
    }
    {
      Id = "Melinoe_4044"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们正在齐心协力击退提丰，以及泰坦的军团。但如果他们有什么更大的计划，能够彻底化解那里的围困的话，他们一定还没告诉我。"
    }
    {
      Id = "Hecate_0755"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就先默认他们没有这样的计划吧。不过，我开始思考，也许众魔之父在我们的计划中会有一席之地。不要放过每个从他身上采集样本的机会。"
    }
    {
      Id = "Melinoe_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，老师。"
    }
    {
      Id = "Hecate_0756"
      InheritFrom = "BaseNarrative"
      DisplayName = "你战胜提丰的时候……有拿到什么战利品么？比如他肉体的标本，或是他的血样？"
    }
    {
      Id = "Melinoe_4045"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望您喜欢丑陋的眼珠，老师。您有想到能对这种邪恶之物加以利用的咒语吗？"
    }
    {
      Id = "Hecate_0757"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许吧。你先替我保管着。但等到时机成熟时，我们会将那魔物的力量还施彼身，将他彻底从这世界上抹除。"
    }
    {
      Id = "Melinoe_2519_A"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……明白了，老师。"
    }
    {
      Id = "Hecate_0756_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "你战胜提丰的时候……有拿到什么战利品么？比如他肉体的标本，或是他的血样？"
    }
    {
      Id = "Melinoe_1177"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我看到他了。我看到{#Emph}克洛诺斯{#Prev}了！他当时就藏身在厄瑞玻斯之外的小径上。我一意识到他是谁，就出手攻击了他，但却没有成效。"
    }
    {
      Id = "Hecate_0776"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个傲慢的老贼，一定以为自己很聪明吧。所以，他知道了你的存在。他说了什么？"
    }
    {
      Id = "Melinoe_1178"
      InheritFrom = "BaseNarrative"
      DisplayName = "他感谢了命运三女神让我们终于相遇，就好像他一直在寻找我一样……然后劝我不要犯下家人们曾经犯过的错误。"
    }
    {
      Id = "Hecate_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "把这段荼毒心灵的记忆从脑海中抹去，他对命运三女神的编织一无所知。我会巩固我们的魔法防护，而{#Emph}你{#Prev}：不要害怕你的敌人；{#Emph}杀死他{#Prev}！"
    }
    {
      Id = "Melinoe_2520"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯又一次在厄瑞玻斯之外等着我路过。这次我立刻认出了他，但我拿他没有任何办法……"
    }
    {
      Id = "Hecate_0033_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "好个老奸巨猾的恶棍。压根不把我们放在眼里……所以他说了什么？"
    }
    {
      Id = "Melinoe_2903"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我找到他了！{#Emph}克洛诺斯！{#Prev}您说得没错，他就栖身在塔耳塔罗斯的最深处。我用尽了我们计划过、训练过的所有办法，可是……可是他太强了。"
    }
    {
      Id = "Hecate_0591"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要惊慌，墨利诺厄，你现在很安全。而且你能逃脱他的魔爪，平安归来，就意味着你没有辜负自己的训练……不过，这样就意味着……他意识到了你是谁，对吗？"
    }
    {
      Id = "Melinoe_2904"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。我们现在失去了攻其不备的优势，对吗？可恶……我怎么会失败？"
    }
    {
      Id = "Hecate_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "一切照旧；你要继续前往他的栖身之处，你父母的冥府，与他对峙。但一路上要保持耐心，不要急于求成。他现在也许对你的力量略知一二，但还远没有意识到你的真正潜能。"
    }
    {
      Id = "Melinoe_2905"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我会拿下他的。"
    }
    {
      Id = "Melinoe_2797"
      InheritFrom = "BaseNarrative"
      DisplayName = "我抵达了冥府，老师。一切都按照计划和训练进行，可是……可是他太强了。"
    }
    {
      Id = "Hecate_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}别灰心{#Prev}，这已经是{#Emph}非常优秀{#Prev}的成果了！你仍安然无恙，掌握了找到敌人的方法，而且还了解到了{#Emph}他{#Prev}防身的招数。准备好再来一次了吗？"
    }
    {
      Id = "Melinoe_2798"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。只要我能找到他……我就一定能战胜他。"
    }
    {
      Id = "Hecate_0631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就战胜他。"
    }
    {
      Id = "Melinoe_3469"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我又一次没能摧毁泰坦。他夜复一夜地让我无功而返，寄希望于我终有一夜会放弃……"
    }
    {
      Id = "Hecate_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你并无此意，不是么？你无法阻止他，但他也未曾阻止过{#Emph}你{#Prev}。你能抵御他的力量，而且他也无法阻拦你回到{#Emph}属于你{#Prev}的冥界。"
    }
    {
      Id = "Melinoe_3470"
      InheritFrom = "BaseNarrative"
      DisplayName = "您说得就好像我已经打败了他一样。"
    }
    {
      Id = "Hecate_0669"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还没有。但我相信，指日可待。"
    }
    {
      Id = "Hecate_0632"
      InheritFrom = "BaseNarrative"
      DisplayName = "你回来了……！快告诉我发生了什么。你找到你的目标了？然后呢？"
    }
    {
      Id = "Melinoe_2799"
      InheritFrom = "BaseNarrative"
      DisplayName = "我抵达了塔耳塔罗斯的边缘，然后按照计划进入了冥府。克洛诺斯就在那里，坐在我父亲的王座上。我和他交手，最后他落败了。但我知道他不会就这样被消灭。而且我无法在那里逗留太久。"
    }
    {
      Id = "Hecate_0779"
      InheritFrom = "BaseNarrative"
      DisplayName = "我相信你没有浪费一分一秒。单靠蛮力肯定无法杀死那个泰坦，但假以时日，我们总能找到让他彻底湮灭的办法。当然，前提是你有更多好消息要汇报……？"
    }
    {
      Id = "Melinoe_4728"
      InheritFrom = "BaseNarrative"
      DisplayName = "那面镜子完好无损……就在王子的卧室里，无人看管。而且那道咒语生效了！我回到了过去，联系到了我哥哥，但我的时间完全不够用。我才刚刚勉强让他相信我的身份。"
    }
    {
      Id = "Hecate_0780"
      InheritFrom = "BaseNarrative"
      DisplayName = "那下次得到这样的机会时，就长话短说。而且和这次一样，不要逗留太久，免得任务因此失败。至于那个泰坦……好好研究他，而我则会研究你找到的物质。"
    }
    {
      Id = "Hecate_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，顺便一提……在训练场上有件东西在等着你。如今你毫无疑问已经准备好了。"
    }
    {
      Id = "Hecate_0781"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又一次击败了泰坦，在那之后发生了什么？你在过去的哥哥，有比上次更加配合么？"
    }
    {
      Id = "Melinoe_4729"
      InheritFrom = "BaseNarrative"
      DisplayName = "他不知道在哪里能找到克洛诺斯，但看起来愿意展开调查。说不定他会有所发现。我仍然很难相信，和我取得联系的真的是过去的他……"
    }
    {
      Id = "Hecate_0782"
      InheritFrom = "BaseNarrative"
      DisplayName = "他的不真实感一定比你更强烈。继续和他保持联络，但不要跟任何人透露这件事。时间永远会向前流淌，而我们不该逆流而上。"
    }
    {
      Id = "Melinoe_4730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "按说这是不可能的……"
    }
    {
      Id = "Hecate_0783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "事物可能与否由{#Emph}我们{#Prev}决定，墨利诺厄。"
    }
    {
      Id = "Hecate_0784"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们听说了，泰坦在你面前再次败下阵来。按照你的估计，一切都进展正常吗？"
    }
    {
      Id = "Melinoe_4731"
      InheritFrom = "BaseNarrative"
      DisplayName = "应该是的。我们现在只需要找到一件合适的武器，然后……发生的一切，就都可以逆转。"
    }
    {
      Id = "Hecate_0785"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许不是{#Emph}一切{#Prev}，但许多事情都能逆转。剩下的事，你早已烂熟于心，我将不再过问。但是，倘若计划意外受挫，务必让我知晓。"
    }
    {
      Id = "Melinoe_4732"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白。"
    }
    {
      Id = "Hecate_0786"
      InheritFrom = "BaseNarrative"
      DisplayName = "首先，让我们检验一下你的发现。一旦我接下来教给你的咒语实战完毕，就去找提丰……然后在他力量耗竭之时，用这柄矛刺向他。"
    }
    {
      Id = "Melinoe_4734"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我这样做之后，提丰会有什么下场？"
    }
    {
      Id = "Hecate_0787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……他会不复存在。"
    }
    {
      Id = "Melinoe_4735"
      InheritFrom = "BaseNarrative"
      DisplayName = "您希望我在接下来这段时间里专注于奥林匹斯山，这样一来就能在那里先测试一下异时之矛？"
    }
    {
      Id = "Hecate_0789"
      InheritFrom = "BaseSubtitle"
      DisplayName = "正是。你得先证明这个办法行之有效。"
    }
    {
      Id = "Hecate_0788"
      InheritFrom = "BaseNarrative"
      DisplayName = "时机未到。我们只有一次机会用它袭击克洛诺斯，而且需要做足一切准备，以确保它会产生应有的效果。也许正在侵扰你奥林匹斯亲戚的那个存在，会是个合适的目标。"
    }
    {
      Id = "Hecate_0796"
      InheritFrom = "BaseNarrative"
      DisplayName = "这残酷的行为已然完成。不要怜悯那个魔物，而应该对他心怀感激……因为他的肉身虽灭，却留下了他的力量。现在，你已经准备好进入最终阶段了。"
    }
    {
      Id = "Melinoe_5018"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我离开之前……我哥哥问了我一件事，我不知道该怎么回答。如果克洛诺斯在这一切发生之前就被消灭了……那此时此刻的我们将会何去何从？"
    }
    {
      Id = "Hecate_0797"
      InheritFrom = "BaseNarrative"
      DisplayName = "就让我们一起揭晓吧。我唯一能确定的是，这将不会是永别。你的重任就要完成了。{#Emph}去吧{#Prev}，结束这一切。"
    }
    {
      Id = "Melinoe_5019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……那么，一会儿见。"
    }
    {
      Id = "Hecate_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "又有一位倪克斯的子女需要我们来照料了。看来你的咒语成功找到了他！当然，一般来说，{#Emph}毁灭{#Prev}往往会{#Emph}不请{#Prev}自来。"
    }
    {
      Id = "Melinoe_1591"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯是我们的客人。我知道他出现在这里看起来像个不祥之兆，但如果命运三女神想要他来这里，我们又有什么资格抗拒呢。"
    }
    {
      Id = "Hecate_0422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可不是么。"
    }
    {
      Id = "Melinoe_1029"
      InheritFrom = "BaseNarrative"
      DisplayName = "我找到他了，老师！我的父亲！他被克洛诺斯锁在了塔耳塔罗斯。但是，我却没法救下他……他让我不要管他……"
    }
    {
      Id = "Hecate_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？克洛诺斯想用这样的方式一雪前耻、耀武扬威，真是不出所料。很遗憾你只能以这样的方式与哈迪斯大人重逢……但我很高兴你找到了他。他看起来状态如何？"
    }
    {
      Id = "Melinoe_1030"
      InheritFrom = "BaseNarrative"
      DisplayName = "他……呃。我真的不知道。他看起来身体和精神都没有大碍，而且很快就认出了我。他还用残存的神力为我施加了祝福。我们该怎么做？"
    }
    {
      Id = "Hecate_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "他既然让你不要管他，那就是说他想要继续保持隐匿。倘若你再次与他相见，务必要万分小心，切莫久留；而{#Emph}我{#Prev}会尽我所能，确保克洛诺斯对你们相认之事一无所知。"
    }
    {
      Id = "Melinoe_1031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……明白。"
    }
    {
      Id = "Melinoe_5474"
      InheritFrom = "BaseNarrative"
      DisplayName = "我其实早该告诉您了，老师，但我找到他了……我的父亲。他被克洛诺斯锁在了塔耳塔罗斯，像个普普通通的囚犯一样……他让我不要管他。"
    }
    {
      Id = "Melinoe_3456"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我父亲想让我给您捎个信；他要我替他转达他最诚挚的感激……"
    }
    {
      Id = "Hecate_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈迪斯大人对你这样说了？{#Emph}为什么？{#Prev}他在他自己的牢笼中{#Emph}求生不得、求死不能{#Prev}，而那泰坦正对他的界域肆意掠夺！我的职责原本是守护冥界，但我失职了。"
    }
    {
      Id = "Melinoe_3457"
      InheritFrom = "BaseNarrative"
      DisplayName = "父亲提起了当冥府遭到克洛诺斯袭击时，他把我托付给您来照顾的事情。他当时一定在担心最糟糕的情况。但现在他知道我健康安好……这一切都多亏了您。"
    }
    {
      Id = "Hecate_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，墨利诺厄，这一切都{#Emph}多亏了{#Prev}克洛诺斯。你的父亲最好还是别把感谢的话语说得太早；等到我们完成清算之后再说也不迟。不过……不要对他提起我这些……有失体统的回应。我只不过是太过诧异了而已。"
    }
    {
      Id = "Melinoe_3458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然，我明白。"
    }
    {
      Id = "Melinoe_2909"
      InheritFrom = "BaseNarrative"
      DisplayName = "在哀悼原野的边界……我遇到了某种黑暗的炼狱魔兽。它长了三个犬类生物的头颅，咆哮声中既有愤怒，又有悲伤。它是我父亲的……我{#Emph}家族{#Prev}的爱犬……不是么？"
    }
    {
      Id = "Hecate_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯确实有几份报告提及过符合你描述的生物，但是……刻耳柏洛斯的毛色{#Emph}鲜红{#Prev}，好似鲜血。不过话又说回来，在哀悼原野久留确实有可能产生变化的效果。啧，可怜的家伙，居然流离失所到了那里么。"
    }
    {
      Id = "Melinoe_2910"
      InheritFrom = "BaseNarrative"
      DisplayName = "他似乎认不出来我是谁。要么是因为过去太久，要么是因为他的脑袋……他的三个脑袋里充斥的事情太多。但我能感觉到他眼中一闪而过的熟悉感。他还有救，对么……？"
    }
    {
      Id = "Hecate_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "野兽的本性永远不会变化。但是，像我们一样，它们有时必须要与自己的心魔斗争……而你可以在这场战斗中助他一臂之力！对你的训练抱有信心，也许他就会在你的帮助下最终摆脱遭受的魔咒。"
    }
    {
      Id = "Melinoe_2911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他一定会的。"
    }
    {
      Id = "Hecate_0666"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还没有成功离开过哀悼原野。守卫着塔耳塔罗斯入口的那只野兽看起来无可匹敌。但你要知道，那只是哀悼原野的氛围作祟。"
    }
    {
      Id = "Melinoe_3468"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一踏足那里，怀揣的希望就开始逐渐泯灭。我知道那只是蒙蔽心灵的花招，但是……"
    }
    {
      Id = "Hecate_0667"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……但那些花招卓有成效，我明白。"
    }
    {
      Id = "Melinoe_0946"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，宙斯大人要求您向他“及时禀报冥界的大小事宜”……这是他的原话。而且他听起来有些不耐烦。他让我把这句话转达给您。"
    }
    {
      Id = "Hecate_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你则一如既往地任人差使，不是么？把宙斯的话原封不动地捎到我这儿来了。你当真以为他会重视这些来自冥界的报告？"
    }
    {
      Id = "Melinoe_0947"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……没有设想过其他的可能。他看起来像是那种想要掌控一切动向的人，尤其是涉及到对他有威胁的事物时。"
    }
    {
      Id = "Hecate_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错！一旦哪里断了音信，他就会焦躁起来。他会收到“及时”的汇报的；不过，你也要记住，{#Emph}他已经有一位信使了。{#Prev}"
    }
    {
      Id = "Melinoe_1592"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我在外面遇到阿尔忒弥斯了。我没有想到这么快就能遇到她，不过话又说回来，她的动作一向这么快。说起来，赫尔墨斯呢，他有什么音信么？"
    }
    {
      Id = "Hecate_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "可惜，目前还没有。不过，他和阿尔忒弥斯一样机灵、谨慎……而且奥林匹斯众神对我们长年合作的事情仍然一无所知，如果你担心的是这个的话。"
    }
    {
      Id = "Melinoe_1593"
      InheritFrom = "BaseNarrative"
      DisplayName = "我担心的是他们的安危。希望赫尔墨斯能早日发现克洛诺斯究竟有什么阴谋，然后安全归来，尽管我也明白我们没有办法再等下去了。"
    }
    {
      Id = "Hecate_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "的确，我们不能再等了。赫尔墨斯之前便让我意识到了这点。"
    }
    {
      Id = "Hecate_0747"
      InheritFrom = "BaseNarrative"
      DisplayName = "猎神认为她那一身的本领，当下最大的作用就是为我们唱一首歌！你现在还能听到她的歌声，证明我按捺住了自己加以制止的冲动。"
    }
    {
      Id = "Melinoe_4039"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴您没有加以制止。我知道阿尔忒弥斯唱歌是为了消除杂念、平复心情，但我觉得附近的暗灵也都很欣赏她的歌声。"
    }
    {
      Id = "Hecate_0748"
      InheritFrom = "BaseNarrative"
      DisplayName = "我自己身处逆境时，固然不会采用这种方式面对；但是只要切实有效，那就是好办法。"
    }
    {
      Id = "Melinoe_1173"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯回来了，老师。他借给了我些许神速，而且……还请求我前去支援奥林匹斯山。那边的情况已经如此危急了吗？"
    }
    {
      Id = "Hecate_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，否则他是不会开口的。显然，这让你的任务更复杂了。不过，依我所见，你还没有准备好迎接地表的挑战。我是不会解除拦路的屏障的。"
    }
    {
      Id = "Melinoe_1174"
      InheritFrom = "BaseNarrative"
      DisplayName = "那如果我自己找到了解除屏障的方式呢？我是见过您施法的哦。"
    }
    {
      Id = "Hecate_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就意味着，你比现在准备得更加充足了。"
    }
    {
      Id = "Hecate_0715"
      InheritFrom = "BaseNarrative"
      DisplayName = "向奥德修斯汇报的暗灵称，雅典娜在这里亲自出现在了你的面前？我指的不是三岔路口，而是冥界。这则报告属实么？"
    }
    {
      Id = "Melinoe_3902"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。雅典娜把她的蛇发妖护符送给了我，这就意味着她纵使远在神山，也能找到我的位置。我应该没有给她带来太多麻烦。"
    }
    {
      Id = "Hecate_0716"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜并不是想去哪就能去哪；不要被表象蒙蔽了。但现在，显然你与她之间的纽带更加牢固了。而她也因此拥有了对你多加{#Emph}关注{#Prev}的手段。"
    }
    {
      Id = "Melinoe_3903"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您是想说多加{#Emph}关照{#Prev}，对吧……？"
    }
    {
      Id = "Hecate_0717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她有她的任务，一如你有你的使命。"
    }
    {
      Id = "Melinoe_3134"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我们一定能为阿拉克涅做些什么。她的诅咒一直在折磨她。如果巫术不能用来缓解朋友的痛苦，那学来还有什么意义？"
    }
    {
      Id = "Hecate_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿拉克涅的命运由不得你来左右。那是她与雅典娜之间的事。我建议你不要插手。"
    }
    {
      Id = "Melinoe_3135"
      InheritFrom = "BaseNarrative"
      DisplayName = "您……您怎么知道那是她和雅典娜之间的事？"
    }
    {
      Id = "Hecate_0552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你就别在这捕风捉影了，墨利诺厄。"
    }
    {
      Id = "Melinoe_3136"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果阿拉克涅的诅咒并非出自雅典娜之手，那您能帮我调查一下，施展诅咒的究竟是谁么？"
    }
    {
      Id = "Hecate_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么不去问{#Emph}雅典娜{#Prev}，偏偏要跑来问我呢？我知道她正忙于御敌，无暇他顾……但她肯定能为你匀出来些说话的时间。"
    }
    {
      Id = "Hecate_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于你的伙伴阿拉克涅，以及她身负的诅咒：虽然我明知不该如此……但我帮你调查了一番，查出了配置那瓶毒药的人。"
    }
    {
      Id = "Melinoe_3137"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？太好了！老师，谢谢您！那您查出来应当为此负责的人是谁？"
    }
    {
      Id = "Hecate_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是我与那只蜘蛛之间的事，与你无关。讨论这种事时，绝不能泄露半点风声。如果你还想对这件事情做出什么贡献，那就跟她说一声，让她来这里找我吧。"
    }
    {
      Id = "Melinoe_3138"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师……是{#Emph}您{#Prev}诅咒了我的朋友……对她下了毒咒！您教过我不要急着下定论，所以可不可以帮帮我，让我理解这一切到底是怎么回事……"
    }
    {
      Id = "Hecate_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你需要理解的是，在众神与自傲的凡人之间，我不得不与众神站在同一战线。你对过去的阿拉克涅一无所知；她如今展现出的，是学会了谦卑之后的样子。"
    }
    {
      Id = "Melinoe_3139"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就意味着她已经学到教训了！请您帮帮我，让她恢复原貌吧。"
    }
    {
      Id = "Hecate_0594"
      InheritFrom = "BaseNarrative"
      DisplayName = "我告诉过你，这是她和雅典娜之间的事情！我唯一能做的，就是表示我很遗憾……对你，对她，都是如此。也许假以时日，雅典娜也有机会被你劝服。"
    }
    {
      Id = "Melinoe_3140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是……（嗤鼻）"
    }
    {
      Id = "Hecate_0851"
      InheritFrom = "BaseNarrative"
      DisplayName = "森林有自己的耳目，因此我已然了解到，阿拉克涅和雅典娜终于给她们之间的恩怨画上了句号。依我看，这已经是最好的结果了。"
    }
    {
      Id = "Melinoe_5291"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿拉克涅一直怀揣着她的骄傲，不过……我想她也算是找到了心中的平静。"
    }
    {
      Id = "Hecate_0852"
      InheritFrom = "BaseNarrative"
      DisplayName = "但愿如此。随着时间的推移，对他人的蔑视会渗入血肉，侵入心灵，变得难以根除。但也许她们两个都足够固执，足以做到这样的事情。"
    }
    {
      Id = "Melinoe_2513"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我没想到美狄亚女士仍然驻守在埃费拉城中。就算像她这样经验丰富的女巫，居然也无法阻止埃费拉城沦陷，真是不敢想象。"
    }
    {
      Id = "Hecate_0588"
      InheritFrom = "BaseNarrative"
      DisplayName = "阻止城市的沦陷并非她的责任。安排她去那座城中，是为了让她融入当地的居民。而如今看来，她与当地的居民相处得更融洽了，毕竟她更懂得如何与死人相处。她应该以她自己的方式向你伸出了援手，对吧？"
    }
    {
      Id = "Melinoe_2514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，是的。"
    }
    {
      Id = "Hecate_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "依你所见，美狄亚近来在地表过得怎么样？据她所说，她是相当不亦乐乎，而银月塞勒涅似乎也持同样的观点！也许我不该感到如此意外。"
    }
    {
      Id = "Melinoe_2515"
      InheritFrom = "BaseNarrative"
      DisplayName = "美狄亚女士身处那片死亡与凋敝之中，确实看起来如鱼得水，毕竟这样的环境对她的研究有益无害。她始终在忙着施展一道又一道的诅咒，这点需要在意吗？"
    }
    {
      Id = "Hecate_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在意的只是她是否安好，而听起来她现在状态不错。只要她的“研究”目前没有会让她自己陷入麻烦的迹象，那我们就没什么好担心的。"
    }
    {
      Id = "Melinoe_2516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会时不时去看看她的。"
    }
    {
      Id = "Melinoe_3464"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在去往奥林匹斯山的路上找到了巫术师喀耳刻，或者很有可能是她找到了我。她和我记忆中的简直一模一样。您是派她去监测海域上的动态了吗？"
    }
    {
      Id = "Hecate_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。塞勒涅一碰到水就像猫一样反应剧烈，而喀耳刻则恰恰是海域之民。因此这样的安排很合适，也已经持续了有一阵子了。我相信喀耳刻的巫术仍然威力不减当年吧？"
    }
    {
      Id = "Melinoe_3465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，效果很棒。"
    }
    {
      Id = "Hecate_0662"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来我们的巫术师喀耳刻在工作上遇到了些问题。她的小岛令她随时可以观测敌方舰队的动向；这些报告应该直接交于奥德修斯之手。然而她却总是把它们交到我手上。"
    }
    {
      Id = "Melinoe_3466"
      InheritFrom = "BaseNarrative"
      DisplayName = "平白无故让汇报多了一步。如果您愿意，老师，我可以在下次与她见面时提醒她正确的流程。"
    }
    {
      Id = "Hecate_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，这件事你应当对她绝口不提。我告诉你只是为了让你知道这回事。喀耳刻一直以来都是我们宝贵的盟友和助力。你经常去拜访她，也应该有助于巩固我们的关系。"
    }
    {
      Id = "Melinoe_3467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白了。 "
    }
    {
      Id = "Melinoe_3899"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我在向奥林匹斯山航行的途中，在天上见到了伊卡洛斯。他自由地飞翔着，但仍然为我们而战……尽他所能阻挠泰坦的军队。"
    }
    {
      Id = "Hecate_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以呢……？你不必{#Emph}在我面前{#Prev}说他的好话。我对人的品行自有判断，无需与你的判断相互影响。"
    }
    {
      Id = "Melinoe_3900"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是……有的时候我担心您会觉得，他在我们有需要的时候弃我们而去，而且对我有过不良的影响……"
    }
    {
      Id = "Hecate_0713"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必如此揣测我的想法。年轻的伊卡洛斯所犯下的愚行，和大多人相比，来得都要温和得多。我对他并无恶意；否则，你是不会见到他在空中翱翔的。"
    }
    {
      Id = "Melinoe_3901"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少，这里还欢迎他回来，对么？"
    }
    {
      Id = "Hecate_0714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果他想来，你也愿意的话……"
    }
    {
      Id = "Hecate_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "你以前总是让我想起你的父亲，墨利诺厄。但最近，我在你身上越来越能看到你母亲的影子了。你有时会对他人的处境展现出担忧……这可能会成为弱点，被敌人加以利用。"
    }
    {
      Id = "Melinoe_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是不会让这些担忧阻碍我的任务的，老师。"
    }
    {
      Id = "Hecate_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是必须！不过，我的本意并不是劝你抛弃这些品质。能认识你的父母是我的荣幸……尽管我只是在阴影中守护着他们。"
    }
    {
      Id = "Melinoe_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会为他们复仇的。"
    }
    {
      Id = "Hecate_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "在冥界的地底，你的亲人等着你为他们报仇雪恨。我相信他们会为你如今的样子而骄傲的。在你出击的时候，将他们铭记于心，化作你的力量。"
    }
    {
      Id = "Melinoe_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我会将他们铭记于心的，可是……我没有关于他们的记忆了。我怎么能记得住呢？一直陪伴我、守护我的……是{#Emph}您{#Prev}啊。"
    }
    {
      Id = "Hecate_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，别这么说。我{#Emph}不是{#Prev}你的母亲，墨利诺厄。有许多她能教给你的东西，我却无从教起。永远不要拿我们两个相比较。"
    }
    {
      Id = "Melinoe_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我……我知道了。"
    }
    {
      Id = "Melinoe_3459"
      InheritFrom = "BaseNarrative"
      DisplayName = "我帐篷中的全家福……我最近越来越经常对着它思考，而我……说来奇怪，我从来没问过您是从哪找到它的。"
    }
    {
      Id = "Hecate_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "你问过的话只会更奇怪，因为答案应当显而易见。不过，你想知道当时的经过么？"
    }
    {
      Id = "Melinoe_3460"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然，老师，如果您愿意分享的话。我知道那段过往你不愿忆起，但这对我很重要。"
    }
    {
      Id = "Hecate_0657"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点毋庸置疑。当克洛诺斯突袭冥府时，我只带上了三件东西逃离：修普诺斯，因为他碰巧在手边；那幅全家福，因为它令我无比心痛；还有一件就是你。"
    }
    {
      Id = "Melinoe_3461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只带了这三件吗……？"
    }
    {
      Id = "Hecate_0658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我只有一刹那做决断，而且刚好有三重分身。"
    }
    {
      Id = "Hecate_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "看你最近如此频繁地施咒，我不得不提醒你，不要急于求成，而要加以节制。我知道你想要让每道咒语在你的舌尖绽放出魔力，但咒语需要空间，也需要时间。"
    }
    {
      Id = "Melinoe_1017"
      InheritFrom = "BaseNarrative"
      DisplayName = "和以前不一样，现在使用炼金釜不会耗竭我的全部魔力了。不过我明白我不能冒失行事。"
    }
    {
      Id = "Hecate_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，否则你那{#Emph}完好的右手{#Prev}也要变得与你的{#Emph}左手{#Prev}一样了。不过，那样的话，那个叫伊卡洛斯的小暗灵说不定会更喜欢你呢。他消失了有一阵子了，是不是？"
    }
    {
      Id = "Melinoe_1018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是呢……"
    }
    {
      Id = "Hecate_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "等你今晚用完炼金釜之后，我自己也得用上一用……防护符文需要更新、守护结界需要巩固……"
    }
    {
      Id = "Melinoe_2526"
      InheritFrom = "BaseNarrative"
      DisplayName = "您要是想好了具体要施放的咒语的话，我可以帮帮您吗？{#Emph}亡者集结咒{#Prev}、{#Emph}黑夜藏身咒{#Prev}，都可以……"
    }
    {
      Id = "Hecate_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在你有自己的事情要考虑，墨利诺厄。不过，倘若你在我念咒时恰巧路过的话，欢迎你与我一同念诵，与我的声音共鸣。"
    }
    {
      Id = "Melinoe_2527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一同闪耀，老师。"
    }
    {
      Id = "Hecate_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，你有对我们的炼金釜善加利用。我能看到、能感觉到这里在发生变化。而且这些变化不只是为了你，也是为了我们大家。"
    }
    {
      Id = "Melinoe_0652"
      InheritFrom = "BaseNarrative"
      DisplayName = "真正的咒语永远不该用于自私自利的目的。不过，如果我造成了积极的影响，但自己也能从中获利的话，这会不会也是一种自私？"
    }
    {
      Id = "Hecate_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "抛开这些疑虑。你没有只为自己考虑，这便不叫自私。我可没有教过你要把自己的需求置于不顾，是不是？"
    }
    {
      Id = "Melinoe_0653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然没有。"
    }
    {
      Id = "Hecate_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，明白就好。"
    }
    {
      Id = "Hecate_0718"
      InheritFrom = "BaseNarrative"
      DisplayName = "我仍然对那口旧的炼金釜偏爱有加。你弄来的那口缀满星斗……别以为这样，你的魔法就会“魔法般”地增强。"
    }
    {
      Id = "Melinoe_3904"
      InheritFrom = "BaseNarrative"
      DisplayName = "放心，旧的炼金釜我们还收着呢。您一发话，我们就可以换回来！至于这一口嘛，新的开端往往能带来显著的成果，您说对么？"
    }
    {
      Id = "Hecate_0719"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，如果这种华丽的金属工艺能激励你完成更大的壮举的话，那就值了！我不打算叫你把它换回去。而且，就算我这样说了，你也应该听从{#Emph}你自己的{#Prev}直觉，而不是我的。"
    }
    {
      Id = "Melinoe_3905"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也相信您的直觉。"
    }
    {
      Id = "Hecate_0720"
      InheritFrom = "BaseNarrative"
      DisplayName = "那口炼金釜真是气势逼人。也许用在特定的领域会更加合适……邪魔咒语、诅咒之类的。你打算专精于这些领域么？"
    }
    {
      Id = "Melinoe_3906"
      InheritFrom = "BaseNarrative"
      DisplayName = "暂时还没有，老师。我……我仍然有很多不同的想法，有的时候一个晚上就会冒出来好几个。我的梦想是在巫术的所有领域都炉火纯青。"
    }
    {
      Id = "Hecate_0721"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的{#Emph}梦想{#Prev}。我们每个人都有自己的偏好；也许你的偏好会由时间揭晓。但我理解你不想为自己{#Emph}设下界限{#Prev}的心情，所以按你的想法练习就好——无论是用这口巨蟒炼金釜，还是用别的。"
    }
    {
      Id = "Melinoe_3907"
      InheritFrom = "BaseSubtitle"
      DisplayName = "每施展一道咒语，就换一口炼金釜！"
    }
    {
      Id = "Hecate_0722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好一个梦想家。"
    }
    {
      Id = "Hecate_0723"
      InheritFrom = "BaseNarrative"
      DisplayName = "培育了那么多品种的植物啊。墨利诺厄，你可别忘了，我们可是在亡者的界域！你却在这里打理起花园来了。"
    }
    {
      Id = "Melinoe_3908"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论是地表或是地下，都没有比这里更适合种植炼金材料的地方了。更何况，这些植物让我在返回时总有小小的盼头，能帮助我保持专注。"
    }
    {
      Id = "Hecate_0724"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必向我解释。大地愿意回应你的请求；这样的好运值得善加利用。"
    }
    {
      Id = "Melinoe_3909"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我只是借用而已。"
    }
    {
      Id = "Hecate_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "返回阴影之中可以复原你的肉身，而在祭坛冥想可以巩固你的斗志。往日的尘灰之中暗藏着无数智慧。"
    }
    {
      Id = "Melinoe_0658"
      InheritFrom = "BaseNarrative"
      DisplayName = "我将阿卡那内化的效果仍然不太理想，老师。如果我和前辈们有着同样的潜力，那为什么我无法感到更强大的连结呢？"
    }
    {
      Id = "Hecate_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的连结受限于你的理解。要么从历史中吸取教训，要么就只能重蹈历史的覆辙。我建议你选择前者。"
    }
    {
      Id = "Melinoe_0659"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我会继续学习的。"
    }
    {
      Id = "Hecate_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近花在祭坛上的时间比往常更多。阿卡那中有揭示什么值得一提的内容吗？"
    }
    {
      Id = "Melinoe_1169"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些牌在我眼中产生了新的意义……每张牌上都描绘着过往的一个重要抉择。这样的知识说不定能帮助我在以后做出更好的选择。"
    }
    {
      Id = "Hecate_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。在每个岔路口，我们都会基于现有的智慧，做出尽可能周全的选择。所以，你现在可以更清楚地洞悉那些……“牌”，你是这么称呼它们的……"
    }
    {
      Id = "Melinoe_0596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是的。"
    }
    {
      Id = "Hecate_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "我原本还在好奇你是否会自己完成对尘灰祭坛的圣化呢。这样一来，你与阿卡那之间的共鸣就会更加强烈；阿卡那的奥义，你也会掌握得愈发牢固。"
    }
    {
      Id = "Melinoe_3453"
      InheritFrom = "BaseNarrative"
      DisplayName = "尘灰祭坛是我们每个人进出三岔路口都要踏过的门槛。它是通往过去、现世与未来的道路。我知道它并不单单属于我，而是属于我们。"
    }
    {
      Id = "Hecate_0650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你说的三句话全部正确。"
    }
    {
      Id = "Hecate_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，在你的征程中，沿途有没有发现能派上用场的东西？没必要两手空空地回来。不过，你手边不一定刚好有对应的工具来采集资源。"
    }
    {
      Id = "Melinoe_0660"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄瑞玻斯仍然暗藏生机。我在外面有找到各种各样能派上用场的东西。感谢您的次元袋！它从来不会拖慢我的行动。"
    }
    {
      Id = "Hecate_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "身为女巫，轻装上阵是必须的。你的亲戚赐予你的祝福是暂时的，但你装在次元袋里的东西却不会消失。当然，直到你把它们用掉为止。"
    }
    {
      Id = "Melinoe_1022"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想问您一件事，老师。我收集到的这些炼金材料，都是直接从土壤中采集的。从大地母亲盖亚手中。我要怎么样才能补偿她？"
    }
    {
      Id = "Hecate_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，首先你该学会摒弃这些凭空出现的愧疚感。若不是盖亚相信你能妥善使用，难道她会向你揭示她的珍宝么……？"
    }
    {
      Id = "Melinoe_1023"
      InheritFrom = "BaseNarrative"
      DisplayName = "但您教过我，需要多少才拿多少，不得滥用。可是现在我却找到什么就拿什么。"
    }
    {
      Id = "Hecate_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "而盖亚知道，你需要你所找到的一切，以及更多。别担心，被你巫术消耗过的原料都会物归原主。也说不定会出现在你的花园里就是了。"
    }
    {
      Id = "Hecate_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来心烦意乱，墨利诺厄。“为什么老师不能直接为我提供所有我需要的炼金材料呢？这样一来，有许多咒语我都可以更早施放……”"
    }
    {
      Id = "Melinoe_1024"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很清楚这个问题的答案，老师。您自己的炼金材料会为您自己的咒语赋能，而我的咒语只能用我的材料。只有付诸努力，才能对这些材料的魔法特质加以利用。"
    }
    {
      Id = "Hecate_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是。不可否认，这种事情有时确实很折磨，但我们的巫术不就是将意志化为现实的过程么？而这样的过程没有捷径可言。"
    }
    {
      Id = "Melinoe_1025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没有捷径可言。"
    }
    {
      Id = "Hecate_0858"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的战术家送了你一些宝贵的材料。然而，我为什么不这么做呢？那样的话，有许多咒语你都可以更早施放。"
    }
    {
      Id = "Hecate_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "你养的那只懒洋洋的两栖动物……是我看错了么，还是说他真的精神抖擞地跟着你蹦蹦跳跳的往出口去了？"
    }
    {
      Id = "Melinoe_1019"
      InheritFrom = "BaseNarrative"
      DisplayName = "您没看错！在我的驱使下，弗利诺斯可以和我一起执行任务了。您教给我的结界和符文，用来保护魔宠的安全应该绰绰有余吧？"
    }
    {
      Id = "Hecate_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望吧！也希望你的魔宠同样可以保护{#Emph}你{#Prev}。或许还能顺便为我们多挖一些草药之类的。"
    }
    {
      Id = "Hecate_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近有一只猫迈着闲庭信步走了进来，就好像我的保护结界失效了一般！但愿它只是你的新魔宠？"
    }
    {
      Id = "Melinoe_1020"
      InheritFrom = "BaseNarrative"
      DisplayName = "她叫图拉，老师，而且您猜得没错！我想找一个自信而独立的同伴，所以就把她带来了。"
    }
    {
      Id = "Hecate_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的同伴每个人都不嫌多。但凡是得到了你信任的动物，这里都欢迎。要是我们认识的人都这样惹人喜欢就好了……"
    }
    {
      Id = "Melinoe_2523"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫库巴和加莉近况如何，老师？最近这里这么热闹，来了这么多陌生人，她们一定有点紧张吧。"
    }
    {
      Id = "Hecate_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，她们好着呢。猎犬和虎鼬确实是对奇怪的搭档，但她们有彼此作伴，忍受这些不适不成问题。更何况我还给了她们额外的照顾！"
    }
    {
      Id = "Melinoe_2524_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在未来的某个夜晚，我一定会赢得她们的信任的！"
    }
    {
      Id = "Hecate_0535"
      InheritFrom = "BaseNarrative"
      DisplayName = "多亏了你的这个{#Emph}“翻新计划”{#Prev}，三岔路口现在越来越繁荣了。哪怕是在这种时候，你也找到了开展这个计划的机会么？"
    }
    {
      Id = "Melinoe_2162"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里是我们的家园，就应该打扫得干干净净，收拾得漂漂亮亮。我招募了朵拉来帮助我，所以翻新工作就不用再一直拖下去了。"
    }
    {
      Id = "Hecate_0536"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}朵拉？{#Prev}我从来没听过{#Emph}她的名字{#Prev}和{#Emph}“工作”{#Prev}二字出现在一句话里。你居然能够说服{#Emph}她{#Prev}为你干活，真是难以置信。"
    }
    {
      Id = "Melinoe_2163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她很乐意帮忙。"
    }
    {
      Id = "Hecate_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里聚集的暗灵对你支持有加，你知道么。你总能给他们留下深刻的印象，而且似乎总有办法说服更多暗灵加入我们。"
    }
    {
      Id = "Melinoe_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们曾经都是凡人，或者其他活物。和活在世间时一样，他们所需要的不过是一个信仰，一个无关生死的信念。以及一条离开厄瑞玻斯的出路。"
    }
    {
      Id = "Hecate_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，这倒不假。他们宣誓效忠于你，这点显而易见。倘若我有任何疑虑的话，他们早就被我抹除了！兴许他们是觉得，在这一切解决之后，他们能在至福乐土寻得一席之地吧。"
    }
    {
      Id = "Melinoe_0662"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我觉得不止如此。"
    }
    {
      Id = "Melinoe_5046"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您和奥德修斯最近在谋划什么呢？他总是在围着他的地图和表格忙个不停。"
    }
    {
      Id = "Hecate_0859"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的战术家总会提前做出规划，现在他在从最近的冥界入口拟定一条穿过敌军、通往奥林匹斯山的路线……以防万一。"
    }
    {
      Id = "Melinoe_5047"
      InheritFrom = "BaseNarrative"
      DisplayName = "以防万一什么……？我没办法前往地表，而且克洛诺斯也在相反的方向。奥林匹斯山上的事态变得更严峻了吗？"
    }
    {
      Id = "Hecate_0860"
      InheritFrom = "BaseNarrative"
      DisplayName = "此事尚待确认。目前来说，仅仅是存在发生变故的可能；甚至有可能是让我们分心的诱饵。保持专注即可。"
    }
    {
      Id = "Melinoe_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是……唔。"
    }
    {
      Id = "Melinoe_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，既然奥林匹斯山遭到了围攻，那您为什么不准许我前往地表？如果我能帮助众神解围，他们也就能为我们提供更多帮助啊！"
    }
    {
      Id = "Hecate_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄，你如何完成任务是你的选择；我没有禁止你前往地表。但我必须要提醒你，如果你要去的话，你的力量将会很快流失殆尽。这不是你的过错，而是你的冥界血脉所致。"
    }
    {
      Id = "Melinoe_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "生于冥界，就要留在冥界，这是命运女神的旨意。但我又不打算在地表长住，我只是……您知道我能在地表坚持多久吗？"
    }
    {
      Id = "Hecate_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你的兄长和父亲最多停留一天，便无法再忍受。也许你会有所不同，但最好别抱太大期望。"
    }
    {
      Id = "Melinoe_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "最多停留一天……？"
    }
    {
      Id = "Hecate_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "你去了地表一趟。我就知道不会有什么好下场。至少你平安回来了。"
    }
    {
      Id = "Melinoe_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "我能感觉到力量的流逝……就算在夜晚，在群星下的那种感觉，我……我不知道夜空中居然会有那么多的星星。您说得对，这超过了我能承受的范畴。"
    }
    {
      Id = "Hecate_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "你学到了教训，也增长了经验。命运三女神不想让你前往地表。你要怎么做呢？"
    }
    {
      Id = "Melinoe_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要去完成一道咒语。我不打算在地表久留……我只需要撑到抵达奥林匹斯山就行……"
    }
    {
      Id = "Hecate_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，所以你打算将自己的这一面予以精进，而非直接将其弃如敝屣。确实有可能行得通……"
    }
    {
      Id = "Melinoe_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定行得通……"
    }
    {
      Id = "Melinoe_2947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "专注于我的任务。"
    }
    {
      Id = "Melinoe_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师……奥林匹斯众神似乎不愿直说，但我能看得出来，他们需要我的帮助。我始终没办法甩掉这种想法——我总觉得我得先帮助他们，才有机会完成任务。"
    }
    {
      Id = "Hecate_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不需要甩掉这种想法，因为它不见得是错误的。你仍然在考虑用一道咒语来帮助你挺过地表之旅吗？"
    }
    {
      Id = "Melinoe_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。在上面，我就像是离了水的鱼一样，对吧？无法呼吸。但我在想，只要施展合适的咒语，说不定我就能屏息闭气。直到我们化解奥林匹斯山上的危机为止。"
    }
    {
      Id = "Hecate_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的咒语一定不会简单。不过，倘若你能够证明自己已经能到达足够远的地方，那么……也许那样的咒语就能帮你走得更远。"
    }
    {
      Id = "Melinoe_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就是这么想的。"
    }
    {
      Id = "Hecate_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于你最近的地表之行。你是怎么在那里存活下来的？你离开的时间比我预期的要久得多。"
    }
    {
      Id = "Melinoe_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的那道令我在地表呼吸的咒语起到效果了，老师。我在那里仍然能体会到压迫感……但不会再像以前那样直接被压垮了。"
    }
    {
      Id = "Hecate_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "从你的决心中诞生的魔法。我很欣慰，尽管并不完全意外。愿你的巫术能如此保护你，直到奥林匹斯山的危机解除。"
    }
    {
      Id = "Hecate_0749"
      InheritFrom = "BaseNarrative"
      DisplayName = "地表之行对你来说一定非常艰难。我训练你的目标，是要让你对冥界的危险做足准备；至于地表的危险，我本以为奥林匹斯众神自己应付得来。"
    }
    {
      Id = "Melinoe_4040"
      InheritFrom = "BaseNarrative"
      DisplayName = "在地表的每一次失误，都会让我学到更惨痛的教训。现在的我已经比之前更适应那里的挑战了，但我还是常常会意识到，那里原本不是我该去的地方。"
    }
    {
      Id = "Hecate_0750"
      InheritFrom = "BaseNarrative"
      DisplayName = "即便如此，你也仍然在坚持！想必你也注意到了，我完全没有打算治好你的固执；毕竟，这种执着的精神，很可能是你家族之中最为明显的特征。好吧，如果你想进一步挑战自己，至少你也知道该怎么做。"
    }
    {
      Id = "Melinoe_4041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有选择的感觉很不错。"
    }
    {
      Id = "Hecate_0659"
      InheritFrom = "BaseNarrative"
      DisplayName = "色萨利裂谷中那些浮浮沉沉的舰队近况如何啊？克洛诺斯造出的船舰如此破烂不堪，能够吸引到这么多追随者也着实是个奇迹了。"
    }
    {
      Id = "Melinoe_3462"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些舰队还没有任何要慢下来的迹象。幸运的是，那道似乎是将那些舰船连接在一起的魔法也可以为我所用，允许我快速穿行其间。地表的船看起来都那么奇怪么？"
    }
    {
      Id = "Hecate_0660"
      InheritFrom = "BaseNarrative"
      DisplayName = "依我看肯定不是。那些只是象征着克洛诺斯对新纪元的虚假承诺。他们不仅在攻打奥林匹斯山，同时也在攻击我们的感官。"
    }
    {
      Id = "Melinoe_3463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一定会将他们击退的。"
    }
    {
      Id = "Hecate_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯和我……我们之中，有一个人一直笃定，你一定能找到去往奥林匹斯山的路，在那里为他们战斗。另一个人则确信你绝不会那样做。"
    }
    {
      Id = "Melinoe_3893"
      InheritFrom = "BaseNarrative"
      DisplayName = "先请您打住一下，老师，您要是想让我猜测在这场分歧之中谁是谁的话，我是绝对不会回答的。"
    }
    {
      Id = "Hecate_0704"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直说，你想要如何完成任务，全看你自己。指引你的每一步，可不是我该做的事！那么，说说吧，往山顶爬的感觉怎样？值得么？"
    }
    {
      Id = "Melinoe_3894"
      InheritFrom = "BaseSubtitle"
      DisplayName = "完全值得。我计划再去一次。"
    }
    {
      Id = "Hecate_0705"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿你的计划得以施行。"
    }
    {
      Id = "Hecate_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "你父亲的领域如此广袤，对我们来说是一件幸事，毕竟这样一来你才能从俄刻阿诺斯的边界绕行，避实击虚。"
    }
    {
      Id = "Melinoe_1027"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然无法直接穿过至福乐土，那就将计就计，另寻出路。不过，盘踞在海洋边境的魔物似乎并不欢迎我。"
    }
    {
      Id = "Hecate_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些不过是憎恨神明的怪物，他们的血脉中都流淌着苦涩的咸水。看来地表的汪洋还不够他们祸害。不过，至少他们身处的那些沉没回廊还没有落入克洛诺斯之手。"
    }
    {
      Id = "Melinoe_2517"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我看到他了。我看到克洛诺斯了！他先是出现在厄瑞玻斯之外的小径上，伪装成一名老者。然后他试图将我困在另一条时间线的某个幻象中……我看到火焰之河，四周燃着熊熊烈火……"
    }
    {
      Id = "Melinoe_2518"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，他是这么说的。我按我们训练过无数次的方法挣脱了他的魔咒，但……我没有任何能伤到他的办法。我现在该怎么做？"
    }
    {
      Id = "Melinoe_2519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白了，老师。"
    }
    {
      Id = "Melinoe_2164"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯在俄刻阿诺斯的影响力比在这里强得多。他试图将我困在另一条时间线的幻象之中……那里是一片火海。"
    }
    {
      Id = "Hecate_0537"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你得以挣脱他的魔爪。我们确实料想过，随着你向敌人推进，你与生俱来的某些特质可能会发挥作用。然而，你还是要多加小心……"
    }
    {
      Id = "Hecate_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "你从我们大敌的身上取回的玄象砂，其中的每一粒都暗含他的一部分本质。某种意义上说，这将是我们瓦解时间的关键。你说是不是？"
    }
    {
      Id = "Melinoe_2912"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。我想起了那道咒语……在您的教导下，我得以一语道破他的全部弱点。这样一来，我们就能解离他的实质……最终将他彻底消灭。他似乎没有意识到这种可能……他还以为我不过是奉奥林匹斯众神之命，前去讨伐他而已。"
    }
    {
      Id = "Hecate_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "不出所料；这说明我们共同的努力没有白费。你像飓风一样席卷冥界，而我在暗处匿踪遁形。但是，当泰坦死到临头之时，我{#Emph}非常希望{#Prev}能亲自到场，亲眼看看他脸上的表情。"
    }
    {
      Id = "Melinoe_2913"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定会有那一夜的，老师……"
    }
    {
      Id = "Hecate_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "暗夜武器逐一苏醒。愿我们能见到它们再次沉睡的时代。在那几姐妹之中，你有最喜欢的么？"
    }
    {
      Id = "Melinoe_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很感激暗夜武器愿意接纳我，成为我的助力，老师。我想要平等地对待其中的每一件。"
    }
    {
      Id = "Hecate_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "值得赞许的处理方式，但并非必须之举。暗夜武器与我们意图一致：它们并不在意谁得到了使用，只想要最终完成使命。"
    }
    {
      Id = "Melinoe_0657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定会的。"
    }
    {
      Id = "Hecate_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，暗夜武器为你揭示了它们过往的面貌，又或者是未来的面貌。很少有人可以得到使用这些武器的权力。能够对它们的不同形态加以利用的人就更少了！"
    }
    {
      Id = "Melinoe_2521"
      InheritFrom = "BaseNarrative"
      DisplayName = "我所发现的暗夜武器的各种形态……有一些使用者我很熟悉。美狄亚、阿尔忒弥斯……她们都与{#Emph}您{#Prev}有关联，不是么？"
    }
    {
      Id = "Hecate_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有你想得那么简单……你所持有的是一套神器，为了守护冥界而生的神器。每一种形态的主人，要么是曾经为了冥界的安危出过自己的一份力，要么便是在未来将会这样做。"
    }
    {
      Id = "Melinoe_2522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来我并不是孤身一人……"
    }
    {
      Id = "Hecate_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨利诺厄。在外面我已经对你手下留情了。即使如此，你仍然没能战胜我。你知道这是为什么吗？"
    }
    {
      Id = "Melinoe_1032"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我知道我可以变得更强，但是……我最终败下阵来的原因，是知识的匮乏。您有许多招式，我还没有记牢。"
    }
    {
      Id = "Hecate_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错！力量。知识。耐心。当你面对看似无法战胜的敌人时，这三者缺一不可。当然，倘若命运施以推手……"
    }
    {
      Id = "Melinoe_1033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会把一切都交给命运的。"
    }
    {
      Id = "Hecate_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又一次令你的行动夭折了。这不公平，我明白。我抵达时精力十足，而且对战斗准备充分，而你已经经历过了许多战斗，精疲力尽。"
    }
    {
      Id = "Melinoe_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "公平是种奢侈，老师。不过，我有的时候确实很羡慕您瞬间长距离移动的能力。"
    }
    {
      Id = "Hecate_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要急于羡慕你所不理解的事物。在你的道路上有我们所需要的资源和材料。而且，倘若你没有办法战胜我，你面对之后的敌人就更没有胜算了。"
    }
    {
      Id = "Hecate_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "你闯了很远，墨利诺厄，而且还战胜了我。甚至让我尝到了点苦头呢！还有很多事情要做；但是，你学得很快。"
    }
    {
      Id = "Melinoe_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，老师。不过我知道，倘若不是您手下留情的话，我一定没有战胜您的机会。"
    }
    {
      Id = "Hecate_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又{#Emph}知道{#Prev}了？为什么你总想着对自己的能力平白无故地添加这些限制？{#Emph}改变你的想法。{#Prev}我会等着下一次与你交手的。"
    }
    {
      Id = "Hecate_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这一次取得了成功！但我们的敌人是时间本尊，看起来那泰坦还不打算将他篡夺来的王位拱手让回。"
    }
    {
      Id = "Melinoe_5685"
      InheritFrom = "BaseNarrative"
      DisplayName = "我常常要抑制自己的负面想法，免得自己认为任务不可能完成。但我们确实取得了进展，不是么？"
    }
    {
      Id = "Hecate_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "事物的可能性往往会在瞬息发生改变。时间想要磨灭我们的心志；但只要加以耐心，我们就可以经受住时间的磨炼，直到属于我们的夜晚来临。"
    }
    {
      Id = "Melinoe_1799"
      InheritFrom = "BaseSubtitle"
      DisplayName = "耐心……"
    }
    {
      Id = "Melinoe_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您一直这么喜欢野兽吗？感觉您和您的野兽愿意为彼此做任何事。"
    }
    {
      Id = "Hecate_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "野兽……这些动物背负着如此残酷的名字。野兽比起我见过的任何凡人或神明，都远更值得信赖。"
    }
    {
      Id = "Melinoe_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们让这一切看起来无比简单，不是么？毫无保留的信任。"
    }
    {
      Id = "Hecate_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。我们从来都不会误会野兽的态度：是喜爱我们，还是想把我变成盘中餐。要是众神都能像它们一样，那该多好。"
    }
    {
      Id = "Hecate_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来状态不太好。回到这里总是会有挫败感，我明白。有什么需要的就跟我说。"
    }
    {
      Id = "Melinoe_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得我还好，老师，谢谢您的关心。您在情绪低落的时候都是怎么应对的？"
    }
    {
      Id = "Hecate_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我品尝过每种情绪的滋味。悲伤、痛苦、焦虑、痴情、冷漠、愤怒、恐惧、恶心、怯懦……这些负面情绪都可以通过坚韧的意志克服。或者，倘若意志不够坚韧时，一场豪饮也能达成同样的效果。"
    }
    {
      Id = "Melinoe_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "豪饮还是先算了吧。"
    }
    {
      Id = "Hecate_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "你走过来的时候，我分明看到你脸红了一下！不必告诉我这种情愫的来源，如果你更希望把那个人藏在心里的话。"
    }
    {
      Id = "Melinoe_3472"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么叫{#Emph}把那个人藏在心里{#Prev}，老师？我的脸红就不能是光线的渲染，或者是返程前的紧张所导致的吗？"
    }
    {
      Id = "Hecate_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看不像。听着，墨利诺厄，我也有过像你这样的时候。我曾经对你说过，自己的情感是万万不能忽视的。听从那些鞭策自己前进的情感，那些是有益的！至于有害的情感，则要与之对抗。"
    }
    {
      Id = "Melinoe_3473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这两种情感我都有不少……"
    }
    {
      Id = "Hecate_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要太过眷恋此地；你父亲那金碧辉煌的冥府才是你的归宿。"
    }
    {
      Id = "Melinoe_1667"
      InheritFrom = "BaseSubtitle"
      DisplayName = "遵命，老师……"
    }
    {
      Id = "Hecate_0694"
      InheritFrom = "BaseNarrative"
      DisplayName = "你持有的暗夜武器非常强大，但同时也让你背负了无比沉重的责任。直到现在，你才开始逐渐理解这份责任的真正意义。"
    }
    {
      Id = "Melinoe_3830"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“持有者将秉持黑夜的意志，为冥界效力。”{#Prev}有的时候感觉好像是我在受它们驱使，而不是我驱使它们……"
    }
    {
      Id = "Hecate_0695"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是如此。另外，我打算教你一道咒语，可以让它们与你的联系更加紧密。"
    }
    {
      Id = "Hecate_0794"
      InheritFrom = "BaseNarrative"
      DisplayName = "我将向你揭示匿踪者之誓的另一个秘密。当你感觉自己做足准备时，不妨立下这一则誓言。那时，或许我们每夜的对决，会有新的变数……"
    }
    {
      Id = "Melinoe_4600"
      InheritFrom = "BaseSubtitle"
      DisplayName = "敌手之誓的秘密……"
    }
    {
      Id = "Hecate_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一直都把自己的魔宠保护得很好。当然，我从未怀疑过你这一点。我们要保护好自己的魔宠，而不是等着魔宠来保护我们。"
    }
    {
      Id = "Melinoe_2511"
      InheritFrom = "BaseNarrative"
      DisplayName = "魔宠就是家人，老师。也许经历过这些考验之后，我与我魔宠之间的纽带，能像您的那样强大。"
    }
    {
      Id = "Hecate_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是肯定的。我与赫库芭和加莉探讨了这件事，她们都愿意与你并肩作战。当然，你得先礼貌地问一问。"
    }
    {
      Id = "Melinoe_2512"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，真的吗？但她们是{#Emph}您{#Prev}的魔宠呀！等等，我要礼貌地问谁……问您，还是问她们？"
    }
    {
      Id = "Hecate_0587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会先问她们！"
    }
    {
      Id = "Hecate_0861"
      InheritFrom = "BaseNarrative"
      DisplayName = "随着你取得一项项成就，我们匿踪者的地位也在增长。希望我们不要成为太多故事的主角；只有那些令人恐惧的就好。"
    }
    {
      Id = "Melinoe_5295"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的暗灵似乎都能理解保持隐秘行事的意义。他们看起来很兴奋，因为现在倪克斯回来了，守护着我们。"
    }
    {
      Id = "Hecate_0862"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们将会发现，要让黑夜的化身欣赏，并非易事。"
    }
    {
      Id = "Melinoe_5567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}匿踪扬名……"
    }
    {
      Id = "Hecate_0863"
      InheritFrom = "BaseNarrative"
      DisplayName = "终于，我们晋升至了匿踪者 I；三界都惧怕我等的威名。我原本以为，这要花上一整个时代……"
    }
    {
      Id = "Melinoe_5296"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实花了不少时间，但我们做到了。因为匿踪者绝不会善罢甘休。"
    }
    {
      Id = "Hecate_0864"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来的确如此。接下来你打算做什么？追求其他近乎不可能的目标么？"
    }
    {
      Id = "Melinoe_5297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拭目以待吧！"
    }
    {
      Id = "Hecate_0758"
      InheritFrom = "BaseNarrative"
      DisplayName = "有众魔之父夜复一夜对奥林匹斯山发难，克洛诺斯一定认为自己占尽了优势。但他犯下了一个致命的错误……"
    }
    {
      Id = "Melinoe_4046"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰无法被控制……如果他不再与奥林匹斯山为敌，那就很可能会转而去找克洛诺斯的麻烦。一定有办法转移他的怒火。"
    }
    {
      Id = "Hecate_0759"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果不能利用他的怒火，那就利用他的本质……我一直教导你，巫术绝不能仅仅用于毁灭的行径。但是，没有哪条规则是一成不变的。就让我们借助敌人的力量回击他们自身，以此永远摆脱他们吧。"
    }
    {
      Id = "Melinoe_4737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}魔物解离……"
    }
    {
      Id = "Melinoe_4736"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我们是不是终于准备好了？用超越时间之矛消灭提丰……然后消灭克洛诺斯。"
    }
    {
      Id = "Hecate_0790"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，我想我们终于准备好了，墨利诺厄。一旦我接下来教给你的咒语施展完毕，就去找到那个魔物，在他的力量消磨殆尽之时，用矛的灵体取走他的性命。"
    }
    {
      Id = "Hecate_0945"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在，魔物解离这道咒语已经到了你的嘴边，然而你仍在迟疑。有什么需要我担心的事么？"
    }
    {
      Id = "Melinoe_5734"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于最近的事而言，不需要额外担心什么，老师。我希望做一些额外的准备，再去面对任务的最后阶段。还是说，您宁愿我仓促行事？"
    }
    {
      Id = "Hecate_0946"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必和我开这种玩笑。我深知你这一路的艰辛，但现在还不是放松的时候。那么，就去做好准备吧。再怎么耐心都不为过。"
    }
    {
      Id = "Melinoe_5735"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我在努力了。"
    }
    {
      Id = "Melinoe_4942"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您最近过得怎么样？冥府那些事情之后，您……唔，比我预想得还要沉默寡言。您当时说，以后再跟我聊这些。"
    }
    {
      Id = "Hecate_0813"
      InheritFrom = "BaseNarrative"
      DisplayName = "一转眼的功夫，“以后”就变成了“现在”啊。是这样，墨利诺厄，我知道我本该更加欢欣雀跃，毕竟你做出了那样的壮举。我为你感到无比骄傲，这点确凿无比。不过，回到冥府唤起了我的一些回忆；这些回忆本该永久沉睡。"
    }
    {
      Id = "Melinoe_5683"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是……您终于又见到了我的父母，还有倪克斯！他们都非常感激您，我都看得出来！{#Emph}我{#Prev}也非常感激您。虽然事情可能没有完全按照计划进行，但最终和我们追求的结果殊途同归，不是么？"
    }
    {
      Id = "Hecate_0814"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你指的是克洛诺斯。我曾多么渴望看到那个卑鄙老贼彻底湮灭。就连现在，我的心绪也仍在被这样的想法所荼毒。我仍在努力将这毒害排出体外……多给我一些时间吧。"
    }
    {
      Id = "Melinoe_4944"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还记得您曾经跟我说过，就算消灭了克洛诺斯，也无法改变过往，而痛苦也无法消除。"
    }
    {
      Id = "Hecate_0815"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕我说得没错。但我们别无他法，只能反复审视自己生命中的转折，无论是我们的选择所致，还是外力驱使。话说回来，你准备好再次出发了吗？"
    }
    {
      Id = "Melinoe_4945"
      InheritFrom = "BaseNarrative"
      DisplayName = "差不多了。重新走过我之前的路线，应该会很有意思……"
    }
    {
      Id = "Hecate_0816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这点毋庸置疑。"
    }
    {
      Id = "Hecate_0818"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，目前为止一切进展顺利吗？用我们战略家的话说，这算是{#Emph}将计就计{#Prev}之举。如果你发现克洛诺斯有任何故态复萌的苗头，都要立即让我知道。"
    }
    {
      Id = "Melinoe_5020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我爷爷在我们约定的地点如期出现。他描述的这些时间之外残余的可能性，目前看来是准确的。我们要继续么？"
    }
    {
      Id = "Hecate_0819"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就看看这一切会通向何方吧。此外，我还想要感谢你。谢谢你之前对我的关心，也谢谢你做出了和我们一起留在这里的决定。之前，你的这一决定让我……{#Emph}很气愤{#Prev}。但现在我看开了。"
    }
    {
      Id = "Melinoe_5021"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，这对我来说不是什么困难的决定。早知道您会为此动怒的话，可能会更难以抉择一些。我去过宙斯的圣殿，也去过哈迪斯的冥府……这两个地方都没有炼金釜，也不能让我的双脚踩到松软的土地。"
    }
    {
      Id = "Hecate_0820"
      InheritFrom = "BaseNarrative"
      DisplayName = "我太理解你了，墨利诺厄，而且换做是我也会这样选，只不过……我本以为，你会比我更明智些。现在你困在了这里；天界与地狱之间的三岔路口，又多了一个迷途的灵魂……"
    }
    {
      Id = "Melinoe_5022"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我没有“迷途”。我就在我想在的地方。"
    }
    {
      Id = "Hecate_0821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真的么……"
    }
    {
      Id = "Melinoe_5742"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师……我想说，我很遗憾您没能和我们一起，看到冥府的那些记忆……倘若克洛诺斯做出不同的选择，我长大时的那些记忆。"
    }
    {
      Id = "Hecate_0947"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必安慰我，不过还是谢谢你。对你体会到的那段过往而言，我没有出手干预的必要。这样再好不过。我很高兴你能体会到那样的情景。"
    }
    {
      Id = "Melinoe_5743"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是不明白，您为什么不在那里。说起来很奇怪，但是……我觉得某种意义上，我始终能感受到您的缺位。我从没有机会学到巫术……而我所珍视的许多事物，都与之密不可分。"
    }
    {
      Id = "Hecate_0948"
      InheritFrom = "BaseNarrative"
      DisplayName = "但{#Emph}此世的你{#Prev}学到了。至于那一种可能性……听起来那个泰坦在冥府似乎意外地很有用。因此，我没有出现在那里，因为你的母亲从没有需要过我。"
    }
    {
      Id = "Melinoe_5744"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是{#Emph}我{#Prev}需要您。现在也需要。"
    }
    {
      Id = "Hecate_0949"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵。或许吧。"
    }
    {
      Id = "Hecate_0950"
      InheritFrom = "BaseNarrative"
      DisplayName = "先跟你说好，免得你走漏风声；在冥府发生的那些事情，其细节务必严加保密……你现在的那些记忆，也是一样。你对于梦境和时间的掌控，可能会产生传言；但真相绝不能让外人知晓。"
    }
    {
      Id = "Melinoe_5745"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为我们实现了不可能之事……然而，我获得的这些记忆……也许至少哪天我可以跟{#Emph}您{#Prev}说一说？以及其他和我亲近的人。"
    }
    {
      Id = "Hecate_0951"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许，有朝一日吧……然而现在，我们需要严格保密，这是黑夜本尊的意志。况且，这样一来，你就不用大费周章地向人解释前因后果了。"
    }
    {
      Id = "Melinoe_5746"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这倒确实。"
    }
    {
      Id = "Hecate_0798"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神会见了你！你在无数个夜晚前施展的咒语，一定是最终起了效用。赫尔墨斯说她们状态很好，但暂时没有回归的打算。无论怎么说，把她们引出来，都是大功一件啊。"
    }
    {
      Id = "Melinoe_4884"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，老师。按我的理解，可能说是{#Emph}她们找到了我{#Prev}更合适，但至少现在我们知道她们是安全的。对了，她们还……提到了{#Emph}您{#Prev}。"
    }
    {
      Id = "Hecate_0799"
      InheritFrom = "BaseNarrative"
      DisplayName = "此话当真……？她们都说了些什么？"
    }
    {
      Id = "Melinoe_4885"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们说您……唔……也许我们该找个更私密的地方谈这件事，您觉得呢？"
    }
    {
      Id = "Hecate_0800"
      InheritFrom = "BaseNarrative"
      DisplayName = "（叹气）我们去温泉吧，正好让你好好休息一下。在那里，我们可以好好谈谈你的想法……以及她们的。"
    }
    {
      Id = "Hecate_0802"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，那三位织匠都对我知道多少，嗯？刚才你欲言又止……"
    }
    {
      Id = "Melinoe_4886"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们告诉我说……我记得她们的原话是，您{#Emph}“在幕后没少穿针引线”{#Prev}。 她们没有进一步解释，但是建议我来问问您。"
    }
    {
      Id = "Hecate_0803"
      InheritFrom = "BaseNarrative"
      DisplayName = "……{#Emph}穿针引线。{#Prev}她们所指之事，我心中了然。但在此刻之前，我都不确定这些事情{#Emph}她们{#Prev}是否知晓。容我将你的问题还给你：{#Emph}你认为{#Prev}她们是什么意思？"
    }
    {
      Id = "Melinoe_4887"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有种感觉，她们好像认为您以某种方式改变了她们的设计。牵动丝线……意味着改变她们编织的未来。而且，应该不是小幅度的改变，不过……这仅仅是我的猜测而已。"
    }
    {
      Id = "Hecate_0804"
      InheritFrom = "BaseNarrative"
      DisplayName = "不必用“仅仅”二字妄自菲薄，墨利诺厄。好吧，既然那三位已经知晓我的过去，那我也不该再对你隐瞒了。我想，比起用言语解释，不如让你看看我的{#Emph}本来面貌{#Prev}。"
    }
    {
      Id = "Melinoe_4888"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您这是……我……您，您真美……但这是什么意思，我、我不理解……这是什么幻术或者易容的伎俩么，还是……？"
    }
    {
      Id = "Hecate_0805"
      InheritFrom = "BaseNarrative"
      DisplayName = "不。{#Emph}戴上{#Prev}面纱时，才是幻术。看着我，不要回避你的目光。你的那双眼睛，我比你更加熟悉。"
    }
    {
      Id = "Melinoe_4889"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是……您是……这怎么可能……？您{#Emph}到底{#Prev}是谁？"
    }
    {
      Id = "Hecate_0806"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是个婴儿的时候，恸哭之河将我冲刷到了河岸上，孑然一身，唯有月光作为指引。塞勒涅照顾了我，告诉我泰坦克洛诺斯夺走了我的家人，只有我一人得以幸免。就这样，我开始了训练。"
    }
    {
      Id = "Melinoe_4890"
      InheritFrom = "BaseNarrative"
      DisplayName = "训练……您是为了完成那个任务。{#Emph}杀死克洛诺斯。{#Prev}在我之前……这一切您都已经尝试过了？"
    }
    {
      Id = "Hecate_0807"
      InheritFrom = "BaseNarrative"
      DisplayName = "说是“之前”，并不完全准确。我是个有天赋的学生，但却毫无章法；我唯一的老师，便是“复仇”。某一夜，我找到了那个卑鄙的泰坦。我将自己知道的所有诅咒倾泻而出……随后，便遁入了他潜意识的深渊。"
    }
    {
      Id = "Melinoe_4891"
      InheritFrom = "BaseNarrative"
      DisplayName = "但教会我遁入潜意识的深渊的人是{#Emph}您{#Prev}……您是说，这是您{#Emph}自己{#Prev}从零开始研究出来的？这怎么可能！"
    }
    {
      Id = "Hecate_0808"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以亲身经历证明，这是可能的。但话说回来，事情确实出了差错。时间与噩梦交织，而我突然发现，自己到了另一个地方。我本想找到时间的{#Emph}尽头{#Prev}……却抵达了更接近时间{#Emph}开始{#Prev}的地方。"
    }
    {
      Id = "Melinoe_4892"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后，您从那时起……活了千万年……一直在等待命运的编织，以及我的诞生？等待第二次机会。老师，我……天哪……"
    }
    {
      Id = "Hecate_0809"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不敢对命运的设计妄加干涉，除非绝对必要。在这一形态下，我找到了你的父亲和母亲，与他们交好，最终成为了冥后的侍女。因此，当克洛诺斯命中注定袭击冥府时……他们没有将刚刚问世的女儿托付给恸哭之河，而是托付给了我。"
    }
    {
      Id = "Melinoe_4893"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后……您倾尽一切养育我，这样我才有机会在您失败的地方成功……"
    }
    {
      Id = "Hecate_0810"
      InheritFrom = "BaseNarrative"
      DisplayName = "正是如此。我一直都对你说，我不是你的母亲，墨利诺厄。我的生命中，也不曾有过母亲的位置。然而，我有充分的理由相信你的能力……总之，这就是你走到今天这步的前因后果！让你经受这一切，想必你会对我恨之入骨……"
    }
    {
      Id = "Melinoe_4894"
      InheritFrom = "BaseNarrative"
      DisplayName = "不……老师，您为什么还会这么想？我{#Emph}爱{#Prev}您……而且您{#Emph}就是{#Prev}我的母亲，无论您愿不愿意承认。也无论我们……会不会过于相像。"
    }
    {
      Id = "Hecate_0811"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我也爱你，墨利诺厄。全心全意地爱你，远胜于爱我自己。以及，我很抱歉……为你经受的这一切，也为你此前未曾拥有的那个家。"
    }
    {
      Id = "Hecate_0812"
      InheritFrom = "BaseNarrative"
      DisplayName = "……此事绝不能让任何人知道，相信你应该明白。命运三女神知道，就随她们去吧；然后还有你和我，除此之外，任何人都不能告诉。那么……我们就假装这一切都没有发生吧？"
    }
    {
      Id = "Melinoe_4896"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我肯定会保密的，但是……我不会假装这一切没有发生。"
    }
    {
      Id = "Hecate_0840"
      InheritFrom = "BaseNarrative"
      DisplayName = "近况如何啊，墨利诺厄？你总不可能永远向我隐瞒你遇到的麻烦，所以有机会的话，还是希望你能对我袒露心声。"
    }
    {
      Id = "Melinoe_5040"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是……还在想我们在温泉的那场谈话，仅此而已。我知道我们不该提起这件事，但是……现在我理解您为什么在冥府时会有那样的表现了。"
    }
    {
      Id = "Hecate_0841"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好。那就收起你对我的同情吧。我已经无比幸运了。我们绝大多数人都不会有第二次机会，弥补自己的失败。"
    }
    {
      Id = "Melinoe_5041"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有过无数次的机会。夜复一夜，试图达成相同的结果。"
    }
    {
      Id = "Hecate_0842"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你没有失败过哪怕一次。只是在通往胜利的道路上，遇到过一些暂时的阻碍而已。"
    }
    {
      Id = "Melinoe_5042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我也可以对您这样说。"
    }
    {
      Id = "Hecate_0843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵！也许吧。"
    }
    {
      Id = "Hecate_0844"
      InheritFrom = "BaseNarrative"
      DisplayName = "纵使任务本质上已然完成，你仍有压力在身。我原本希望，到了此时此刻，你能将肩上的担子卸下。为什么不呢？"
    }
    {
      Id = "Melinoe_5043"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，每夜我都要去面对旧的克洛诺斯或是提丰的残余。这些可能性看起来都是真实存在的，而且无穷无尽，代表着无数种我因为各种原因而失败的情形……"
    }
    {
      Id = "Hecate_0845"
      InheritFrom = "BaseNarrative"
      DisplayName = "抑或只是尚未成功。在实现目标的道路上，你并非孤身一人；譬如我，就是这一事实活生生的证明。"
    }
    {
      Id = "Melinoe_5044"
      InheritFrom = "BaseNarrative"
      DisplayName = "您在说什么，难道还有像您这样……以及像我这样的人吗？我们都在努力实现同样的结果？"
    }
    {
      Id = "Hecate_0846"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是希望你考虑到，你所倾注的心血，花费的时间，有可能会产生回响。我们投入在这个世界上的精力，亦会反作用于我们自身。简而言之，此时此刻的我，正是因为此时此刻的{#Emph}你{#Prev}才存在。"
    }
    {
      Id = "Melinoe_5045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是明明是反过来……"
    }
    {
      Id = "Hecate_0847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你确定么……？"
    }
    {
      Id = "Hecate_0865"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一切都进入了令人舒适的循环之中。每一夜，你回归时都重振精神，毫无倦意。然而我，再怎么说，也该歇一歇了。"
    }
    {
      Id = "Melinoe_5298"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近的一切应该都在掌控之中，所以请您好好休息一段时间吧。您打算去什么地方吗？"
    }
    {
      Id = "Hecate_0866"
      InheritFrom = "BaseNarrative"
      DisplayName = "暂时还没有打算。但我会变得更加寡言；那样才是我的本性。"
    }
    {
      Id = "Hecate_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿明月指引你，为你照亮前路，也为你灼烧敌人的双眼。"
    }
    {
      Id = "Hecate_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "……艾草芯、菊芋、蛛丝、蜡块……"
    }
    {
      Id = "Hecate_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "……桑葚、蛇牙、鼠尾草、蝎尾……"
    }
    {
      Id = "Hecate_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "继续你的任务。我们的敌人还在其他事情上分心。"
    }
    {
      Id = "Hecate_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你在明月的照耀下，拖下长长的阴影。"
    }
    {
      Id = "Hecate_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会为我们的敌人降下诅咒，令他们步履维艰。愿吾等得偿所愿。"
    }
    {
      Id = "Hecate_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "你安然无恙地回来了；你的力量也恢复如初。好好使用吧。"
    }
    {
      Id = "Hecate_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "努力向前推进，墨利诺厄，但不要置自身于不顾。"
    }
    {
      Id = "Hecate_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "趁我们的大敌分神之际，找到他，然后消灭他。"
    }
    {
      Id = "Hecate_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次出发，你都能有所学习、有所成长。继续前进吧。"
    }
    {
      Id = "Hecate_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "不积跬步，无以至千里。继续按你的步调前进吧。"
    }
    {
      Id = "Hecate_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "在地表和冥界都有未竟之事需要处理……"
    }
    {
      Id = "Hecate_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们女巫的力量常常被人低估。但我很清楚你的能力不容小觑。"
    }
    {
      Id = "Hecate_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯太过老迈，以为自己已经无所不知。愚昧。"
    }
    {
      Id = "Hecate_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的力量需要信心作为依靠。切莫动摇。"
    }
    {
      Id = "Hecate_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "进行必要的休整吧，墨利诺厄。如此折返并不是退步的表现。"
    }
    {
      Id = "Hecate_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要对敌人心慈手软，墨利诺厄。我们的敌人绝不会对你留情。"
    }
    {
      Id = "Hecate_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "……摩吕花瓣、柏树叶、曼德拉草、石英粉、大蒜……"
    }
    {
      Id = "Hecate_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "……月水、荨麻、甲虫壳、颠茄……"
    }
    {
      Id = "Hecate_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "……柳树皮、硫磺、蝙蝠翼、洋葱皮……"
    }
    {
      Id = "Melinoe_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，如果这样做不会不合适的话，我给您准备了一份礼物。毕竟您自己的储备前一阵子就用完了，对吧？"
    }
    {
      Id = "Hecate_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，猎犬们一定会三下五除二把这东西消灭掉的。我就先替他们保管着了。既然如此，我也有份回礼相送。收下吧？"
    }
    {
      Id = "Hecate_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，拜托，墨利诺厄，你不必用这些礼物来讨好我。我们有任务在身，还是专注于任务上吧，好么？"
    }
    {
      Id = "Melinoe_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "您教会了我如何同时投身于多项事务，老师。为什么我不能一边专注于任务，一边记得向您表达我的心意呢？"
    }
    {
      Id = "Hecate_0538"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，这……我大概确实还蛮喜欢这东西的。以前，我四处旅行远比现在频繁，还经常行经容易获取这种东西的地方。或许你是感觉到了我对那段过往的怅然吧。"
    }
    {
      Id = "Melinoe_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从您身上学到了很多，老师。这份礼物只是我的一点心意，还望您笑纳。"
    }
    {
      Id = "Hecate_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我很感谢你惦记着我，也感谢你送我这份蜜露，但是你真的不必这样做。我难道没有教导过你，面对像这样的不成文的合约，要学会抵御诱惑吗？"
    }
    {
      Id = "Melinoe_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不求得到任何回报，老师。赠人玫瑰，手有余香，本来就应当足以为报，更何况收到礼物的是恩师您。"
    }
    {
      Id = "Hecate_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该知道，我对众神的传统没什么兴趣。别忘了，我可是个泰坦。比起和宙斯那一族，恐怕我和我们的大敌之间的共同之处反倒要多些。"
    }
    {
      Id = "Melinoe_2166"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，无论您有什么样的出身，您都是我这一生中坚定而可靠的监护人。我之所以借用传统，只是因为这样能帮助我表达我对您的感激之情。"
    }
    {
      Id = "Hecate_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "传统本身并没有问题，直到有人盲从；或者说，不理智地遵从，毕竟盲目者往往更能明察秋毫。不过，还是不要让我糟蹋了你的一片好心；我很感谢，真的。"
    }
    {
      Id = "Hecate_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以为我说得已经够清楚了，你不用这样巴结我。我仍然会收下这瓶蜜露，哪怕只是为了惩罚你，让你无法将它送给更值得你喜爱的人。"
    }
    {
      Id = "Melinoe_2167"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想不出还有任何人比起您更适合这份礼物，老师。是您将我抚养成人，让我无愧于女神的名号。没有一个晚上我不对此心怀感激。"
    }
    {
      Id = "Hecate_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "我到底要说多少遍——我不是你的母亲，墨利诺厄。你不需要这样肆无忌惮地赞美我。我将你养大，是为了消灭我们共同的敌人。这没有什么值得你感激的地方。"
    }
    {
      Id = "Melinoe_2168"
      InheritFrom = "BaseNarrative"
      DisplayName = "您总是说，我们的意图和我们的行为不能混为一谈。我知道您不是我的生母，那又如何？您养育了我，这就够了。"
    }
    {
      Id = "Hecate_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "我利用了你，而且现在还在利用你。难道你看不出来吗？我早就试图向你挑明这一点了。但你却总是执迷不悟。"
    }
    {
      Id = "Melinoe_2169"
      InheritFrom = "BaseNarrative"
      DisplayName = "您履行了对我父亲的诺言，将我抚养成人。他从来没有要您溺爱我，不是么？他一定也希望您让我自力更生。"
    }
    {
      Id = "Hecate_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "你以为你现在这就叫自力更生了么？你不仅在我的羽翼下，还接受着奥林匹斯的援助！你远不如我计划得那样独立。而且，我居然还不经意地让你以为我把你养得很好！"
    }
    {
      Id = "Melinoe_2170"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实是这么觉得的，我不知道倘若没有您，我会怎么样。您总觉得自己配不上我对您的爱，让我感到很悲伤。"
    }
    {
      Id = "Hecate_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "……先把你的悲伤搁置一旁吧。我会喝掉这瓶蜜露，好好享受的，如果你没意见的话。"
    }
    {
      Id = "Melinoe_2171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "Melinoe_5029"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们一起再去一趟小酒馆怎么样？您之前敬过我一杯，我也想有机会能回敬您。"
    }
    {
      Id = "Hecate_0830"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就当你已经敬过了吧。我无意被奉若神明；暗灵们可以把他们的献礼留给猎犬。"
    }
    {
      Id = "Melinoe_5030"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我们聚在这里，都是因为您。暗灵们仰慕您，如今您亲手策划的任务大功告成，他们都想和您一起庆祝！"
    }
    {
      Id = "Hecate_0831"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们只是做了该做的事，而且上次去小酒馆的时候已经庆祝过了。现在，把那瓶仙酒交出来吧，我会留到下次庆祝的时候的。"
    }
    {
      Id = "Melinoe_5686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "给……"
    }
    {
      Id = "Melinoe_5032"
      InheritFrom = "BaseNarrative"
      DisplayName = "您之前说要把仙酒留到下次庆祝的时候，所以我想多捐一些。祝匿踪者尽快赢来下一场大捷！"
    }
    {
      Id = "Hecate_0832"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}适可而止吧{#Prev}，墨利诺厄！看来你我二人都不知道自己该何去何从了啊，以至于这些毫无必要的礼物，都值得你如此坚持！就别折腾我了。"
    }
    {
      Id = "Melinoe_5687"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是有意要惹您生气的……难道说，您真的那么希望我留在冥府？留在父母身边……您总是说，我属于那里。"
    }
    {
      Id = "Hecate_0833"
      InheritFrom = "BaseNarrative"
      DisplayName = "立即把那道思绪逐出心头。我在某些方面教授了你许多事情，但也令你付出了代价，让你在生活的其他方面经验匮乏。"
    }
    {
      Id = "Melinoe_5688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我学得很快。"
    }
    {
      Id = "Melinoe_3886"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我这里有一瓶仙酒，然后……我想着我们也许可以在小酒馆里分享一下，如果您愿意抽身片刻的话！我知道现在时机不太对……"
    }
    {
      Id = "Hecate_0696"
      InheritFrom = "BaseNarrative"
      DisplayName = "……墨利诺厄，我打算克制住严词拒绝你的冲动，因为我也想回味一下，看看这奥林匹斯山上最好的酒是否名副其实！动身吧。"
    }
    {
      Id = "Hecate_0697"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我一直都没有认真考虑过修复这个小酒馆的事情。在这种聚会场所里，人们可以放下戒备……甚至可以说是变得松懈？这点弊大于利。我们务必时刻保持警惕。"
    }
    {
      Id = "Melinoe_3887"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是现在您到了这里，您一定能意识到，有这样一个地方让我们和暗灵打成一团，也有不少益处？我修复小酒馆的举动，应该不算是越俎代庖吧？"
    }
    {
      Id = "Hecate_0698"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，我意识到了；你做得很好。三岔路口的气氛日益紧张，超出了我能接受的范围，因为如此紧绷的能量对我们的大业毫无帮助。不过，我跑题了。在这里应该禁止谈论我们的大业才是。"
    }
    {
      Id = "Melinoe_3888"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，没错，多立一些规矩吧！毕竟这间小酒馆要让忠于我们的那些暗灵放松心情，最需要的就是规矩。老师啊，您真是用心良苦！"
    }
    {
      Id = "Hecate_0699"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我明白你的意思了。怎么，尝了两口仙酒，你的克制就荡然无存了？真是立竿见影的效果！看来这仙酒不在小酒馆里品尝的话，拿去炼金釜里也大有可为啊。"
    }
    {
      Id = "Melinoe_3889"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我们还是在聊大业，以及我们的巫术。您要不……跟我说说您小时候，跟我一样大的时候的事吧，如果您不介意的话？"
    }
    {
      Id = "Hecate_0700"
      InheritFrom = "BaseNarrative"
      DisplayName = "我介意。不过或许，我们再多喝两杯，我就没那么介意了！要不要来试试看呢？来吧，这一杯祝我们发现真相！"
    }
    {
      Id = "Hecate_0701"
      InheritFrom = "BaseNarrative"
      DisplayName = "……请原谅我刚才突然表现出的阴郁，墨利诺厄。近来，比起过去，我更关注未来。希望我没有过于破坏气氛。"
    }
    {
      Id = "Melinoe_3891"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您说什么呢，老师。您愿意和我们一起，我们都很开心。"
    }
    {
      Id = "Melinoe_5023"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，您愿意与我分享这一瓶仙酒吗？我们在这里还没有真正为冥王和冥后恢复正统庆祝过呢。"
    }
    {
      Id = "Hecate_0824"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕拿你山上亲戚的特制饮料来庆祝不太合适，不过这次就依你吧。你说得对，暗灵们肯定对庆功宴有所期待。"
    }
    {
      Id = "Hecate_0825"
      InheritFrom = "BaseNarrative"
      DisplayName = "……因此，请各位为冥界王女喝彩，因为她面对强敌从未退缩，无论这强敌是时间本身，是众魔之父，还是任务路上的其他险阻！"
    }
    {
      Id = "Melinoe_5024"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，老师。{#Emph}各位！{#Prev}没有你们，没有三岔路口，我永远不可能将这一切化为现实。每到紧要关头，想到我随时可以撤回这里、撤回你们身边，都会让我感到无比心安。"
    }
    {
      Id = "Hecate_0826"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里很欢迎你，而且很安全，墨利诺厄。而且，虽然我们对你有着十足的信心，但你最终的成就，还是超出了任何人的想象。"
    }
    {
      Id = "Melinoe_5025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是做了您训练我去做的事。我很感激您的耐心，纵使我遭遇了那么多的挫折，您都没有着急，而是等待着我将其一一克服。"
    }
    {
      Id = "Hecate_0827"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有耐心，怎能经受住时间的考验？我一直都知道，你是个潜力无限的学生。若非如此，我是不会把你逼得那么狠的。"
    }
    {
      Id = "Melinoe_5026"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，现在匿踪者会何去何从呢？我们的每位暗灵，都在至福乐土赢得了一席之地，只待他们动身前往……"
    }
    {
      Id = "Hecate_0828"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果他们如此打算的话。不过，我怀疑他们和你一样，不打算这么快离开这里。我们在这里始终有机会取得新的成就；如果我们团结一致，势必会比独自前行走得更远。"
    }
    {
      Id = "Hecate_0829"
      InheritFrom = "BaseNarrative"
      DisplayName = "……嗯，这或许不算多么正式的聚会，但我感觉很值得？这些暗灵……他们来到这里，是因为不知道该去向何方。而现在，这里成了他们永远的家园。"
    }
    {
      Id = "Melinoe_5028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不仅仅是个去处……而且还是家园。"
    }
    {
      Id = "Melinoe_3892"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我有没有机会劝说您和我一起去小酒馆，一起享用一瓶仙酒？"
    }
    {
      Id = "Hecate_0702"
      InheritFrom = "BaseNarrative"
      DisplayName = "不太有，至少现在不行。我不该去那里败坏暗灵们的心情；他们需要休息。"
    }
    {
      Id = "Melinoe_2095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们一定会觉得很可惜的。"
    }
    {
      Id = "Melinoe_0669"
      InheritFrom = "BaseNarrative"
      DisplayName = "恸哭之河又一次焕发了生机，老师。您愿意和我一起去看一看么？"
    }
    {
      Id = "Hecate_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，好啊，为什么不呢！我正好可以去散散步，而且钓上来的鱼对我们也有用。"
    }
    {
      Id = "Hecate_0651"
      InheritFrom = "BaseNarrative"
      DisplayName = "……换做是前不久，你绝不会允许自己有如此放松的行为，也不会有勇气请求我与你同行。"
    }
    {
      Id = "Melinoe_3454"
      InheritFrom = "BaseNarrative"
      DisplayName = "您批评得对，老师。我这一刻本来已经可以动身启程，杀向我们的大敌，而您……您有那么多的责任，我却还要这样浪费您的时间。我不该这样的。"
    }
    {
      Id = "Hecate_0652"
      InheritFrom = "BaseNarrative"
      DisplayName = "别再说了，免得你惊到了河里的鱼虾；倘若那样，你才算是在{#Emph}浪费我的时间{#Prev}，墨利诺厄！你误解了我言语的含义。平复心情、养精蓄锐的能力并不是对完成任务的阻碍；相反，这是一项日渐增长的长处！"
    }
    {
      Id = "Melinoe_3455"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我没想到您会这样想。有的时候，我感觉自己不像以前那样专心致志了。要不然的话，我为什么还会邀请您一起来这里呢？"
    }
    {
      Id = "Hecate_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你思考后意识到，你和我都需要换换脑子，想些别的事情。而我们继续这样你一言、我一语地，只会事倍功半！让我们静下来，专注于面前的河水吧。"
    }
    {
      Id = "Hecate_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "河流之中自有收获；捕鱼这种看似微不足道的事情也自有其意义。"
    }
    {
      Id = "Melinoe_5035"
      InheritFrom = "BaseNarrative"
      DisplayName = "您会愿意和我一起去钓鱼栈桥么？那是个好地方，可以让我们把现有的思绪放下，稍稍换一换脑子。"
    }
    {
      Id = "Hecate_0834"
      InheritFrom = "BaseNarrative"
      DisplayName = "可以。那就这样吧，此外，我正好还有事想与你谈谈。"
    }
    {
      Id = "Hecate_0835"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你当真以为我是想把你赶走？要么是那样，要么就是你觉得用暗夜武器还不够，还要拿言语来伤害我。"
    }
    {
      Id = "Melinoe_5036"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很抱歉，老师，只是……在冥府，我意识到我不仅想要找回我的家人……我还想要您幸福。可是我却觉得，您想要推开我。"
    }
    {
      Id = "Hecate_0836"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的幸福与否，既不是你的责任，也不在你的掌控之中。而且，该道歉的是我才对。是我逼迫你经受了这一切。请你原谅我。"
    }
    {
      Id = "Melinoe_5037"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“没有犯错的时候，永远不要道歉。”{#Prev}您以前是这么跟我说的。您对我的要求一直很严格，但却从没有到冷酷无情的地步。您教给了我许多，其中也包括甄别这两者的方法。"
    }
    {
      Id = "Hecate_0837"
      InheritFrom = "BaseNarrative"
      DisplayName = "“没有到冷酷无情的地步”，听起来也没好到哪去啊。总之，事实足以证明，我教给你的已经更多了。我还是会在厄瑞玻斯挑战你，免得武艺和巫术日久生疏，但长此以往，也许你不该再叫我老师，而是改口叫我的名字……"
    }
    {
      Id = "Melinoe_5038"
      InheritFrom = "BaseNarrative"
      DisplayName = "不再叫您老师，而是叫您赫卡忒么……恐怕我得花些时间适应。真是难以相信，我小的时候居然会那么随便地直呼您的大名。看来，许多事情随着时间的推进，最终都会形成循环啊。"
    }
    {
      Id = "Hecate_0838"
      InheritFrom = "BaseNarrative"
      DisplayName = "可不是么。不过现在，我们该把注意力转移到这些胆大包天，敢偷听我们谈话的河流居民身上了……"
    }
    {
      Id = "Hecate_0839"
      InheritFrom = "BaseNarrative"
      DisplayName = "这次旅行还算令人愉快，但以后别再与我提及“幸福”二字了。只有蠢人才会为这种事情白费心思，因为它不过是实现目标时的副产物，仅此而已。"
    }
    {
      Id = "Melinoe_5039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白了。谢谢您， 老师……赫卡忒。"
    }
    {
      Id = "Melinoe_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我在想，您愿不愿意跟我一起在温泉里放松片刻？如果您没有特别忙的话？"
    }
    {
      Id = "Hecate_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，既然你这么说了，去泡一泡应该也无妨。我后背的肌肉是该好好放松一下，不然脊椎都要比那棵老树还弯了！那我们就快去快回吧。"
    }
    {
      Id = "Hecate_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，感觉还真不错。多亏有你为这里换水！我一直惦记着这件事，只可惜……唉。"
    }
    {
      Id = "Melinoe_0670"
      InheritFrom = "BaseNarrative"
      DisplayName = "不客气，老师。您这样说让我很欣慰，因为我之前还不知道，把魔力和资源耗费在这种事情上，会不会惹您生气呢。"
    }
    {
      Id = "Hecate_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "魔法本来最主要的作用就是自我提升，墨利诺厄，虽然说它算不上什么捷径。而如果在温泉里偶尔泡一泡澡，放松一下身心算不上“自我提升”的话，只怕我这么多年都用错这个词了。"
    }
    {
      Id = "Melinoe_0671"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是我能让自己放松下来就好了。在这里呆着的时候，总感觉我是在浪费宝贵的时间。"
    }
    {
      Id = "Hecate_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "善待自己的时间从来不是浪费；太过计较得失，恰恰会适得其反！{#Emph}既来之则安之。{#Prev}好好珍惜当下的时光吧。"
    }
    {
      Id = "Hecate_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "真可惜时间不允许我们一直在温泉里泡着，不过……浅泡一下也舒服了很多。"
    }
    {
      Id = "Melinoe_0667"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师，我正打算把这些浴盐拿去用用。就当是某种净化仪式吧。您愿意和我一起来吗？"
    }
    {
      Id = "Hecate_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "去泡一泡温泉，应该能让心神更加澄澈一段时间。那就让我们一起去“净化”吧。"
    }
    {
      Id = "Hecate_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯。我们就像在炼金釜里炖着的两株草药，你说是不是？"
    }
    {
      Id = "Melinoe_0673"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还记得很小的时候在这里洗澡的事。那时候您总是对我说，不许往您的头发上泼水，但我就是要泼。那时您对我真是宽容。"
    }
    {
      Id = "Hecate_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，所以现在你终于意识到，为什么我对你的训练那么严酷了！谁让你屡教不改地往我头发上泼水，将我几乎无限的耐心消磨殆尽。"
    }
    {
      Id = "Melinoe_0674"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等……所以您让我那么拼命训练，成为学有所成的女巫，只是因为我把您头发弄湿，惹您生气了？"
    }
    {
      Id = "Hecate_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，不用训练折磨你的话，我就只能把你变成一只蝾螈，否则只怕难解我心头之恨！……好啦，墨利诺厄，我是说笑的。你有的时候实在是太过严肃了。"
    }
    {
      Id = "Melinoe_3471"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵。我总是记不住这点，老师。可能是因为我们好久没有这样说过话了吧。"
    }
    {
      Id = "Hecate_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，是呀，毕竟你长大了嘛。而且现在的形势之下，我们也很难有这个心情。这个成事不足败事有余的温泉，老早之前就罢了工，留着滩死水养苔藓去了。现在又一次泡在这里……让我不禁追忆起往昔啊。"
    }
    {
      Id = "Melinoe_0676"
      InheritFrom = "BaseNarrative"
      DisplayName = "您觉得今后我们能让这里免受苔藓的侵扰吗？"
    }
    {
      Id = "Hecate_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来负责搞定苔藓，你来负责别让水溅到我头发上。一言为定？"
    }
    {
      Id = "Hecate_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！舒服多了。有的时候我怀疑，就算是死人在温泉里泡一下也能复活。"
    }
    {
      Id = "Melinoe_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道现在形势严峻，老师，但我还是想问一下，您愿不愿意跟我一起去温泉里稍微泡一泡？"
    }
    {
      Id = "Hecate_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "换做平日，我肯定很乐意泡温泉，但我有咒语要完成，有结界要加固……不行，还是以后再说吧。"
    }
    {
      Id = "Melinoe_5306"
      InheritFrom = "BaseNarrative"
      DisplayName = "您有没有兴趣跟我一起稍微歇一歇，去河边的钓鱼栈桥待会儿?"
    }
    {
      Id = "Hecate_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实有意检验你的钓鱼技术是否有进步，只可惜我现在还有其他的事情要处理。"
    }
    {
      Id = "Melinoe_1725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "老师不在。"
    }
    {
      Id = "Melinoe_1726"
      InheritFrom = "BaseSubtitle"
      DisplayName = "老师不见了。"
    }
    {
      Id = "Melinoe_1148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "您的银轮？我真的可以收下吗？"
    }
    {
      Id = "Melinoe_2120"
      InheritFrom = "BaseNarrative"
      DisplayName = "抓住你啦，赫卡忒！！你死啦！！"
    }
    {
      Id = "Hecate_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈{#Prev}，墨利诺厄，你是抓住了我没错。不过别得意得太早，我还有金蝉脱壳之法！"
    }
    {
      Id = "Melinoe_2121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喂……！"
    }
    {
      Id = "Hecate_0522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}嗷呜……"
    }
    {
      Id = "Melinoe_2112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你躲不过我的……！"
    }
    {
      Id = "Melinoe_2122"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在这！又抓住你啦！"
    }
    {
      Id = "Hecate_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}啊！{#Prev}真是执着！我劝你还是放弃吧，女巫！因为我是个泰坦！你是无法消灭我的！"
    }
    {
      Id = "Melinoe_2123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我可以，你等着瞧吧！"
    }
    {
      Id = "Melinoe_2124"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈哈{#Prev}，我{#Emph}抓住{#Prev}你啦！！……赫卡忒……？怎么了？"
    }
    {
      Id = "Hecate_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "……啊，只是……{#Emph}啧{#Prev}，我之前从来没有听过你的笑声。让我想起了你妈妈！比起悲伤的呜咽，笑声果然悦耳很多啊。"
    }
    {
      Id = "Melinoe_2343"
      InheritFrom = "BaseNarrative"
      DisplayName = "我保证以后不会再哭了！我有的时候还是会伤心，但是比以前已经好多了……"
    }
    {
      Id = "Hecate_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "不要做出你无法兑现的承诺。有眼泪，就哭出来；眼泪不是什么珍贵的东西，不需要被珍藏。"
    }
    {
      Id = "Melinoe_2126"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你从来都不哭，赫卡忒！而我想变得强大，像你一样强大！这样我就能找到克洛诺斯，然后干掉他，让他付出代价。然后你就能再次听到我妈妈的笑声了！"
    }
    {
      Id = "Hecate_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "而我将竭尽所能为你做好准备，让你得以在我失败之处成功。既为了你的家人，也为了你身为冥界王女与生俱来的神权。"
    }
    {
      Id = "Melinoe_2344"
      InheritFrom = "BaseNarrative"
      DisplayName = "你……失败之处？你是说你跟克洛诺斯打过一架吗？他打疼你了？"
    }
    {
      Id = "Hecate_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "关心你自己的痛苦就好，我的痛苦与你无关。消灭了克洛诺斯，也无法改变过往；痛苦也不会消除，只会随着年岁的增长，发作得越来越不频繁……还是不说这个了！等到明天，我就教你如何对付更强大的猎物。"
    }
    {
      Id = "Melinoe_2128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "（吸气）真的吗！"
    }
  ]
}
