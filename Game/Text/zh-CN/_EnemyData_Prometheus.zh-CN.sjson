    }
    {
      Id = "Prometheus_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……艾托斯，我们走！"
    }
    {
      Id = "Prometheus_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……飞吧，艾托斯！"
    }
    {
      Id = "Prometheus_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……带我走吧，艾托斯！"
    }
    {
      Id = "MelinoeField_2518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……他走了……"
    }
    {
      Id = "MelinoeField_2519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他预料到他会输了么……？"
    }
    {
      Id = "MelinoeField_2520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回去舔舐伤口去吧。"
    }
    {
      Id = "MelinoeField_2521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "预料到了。"
    }
    {
      Id = "MelinoeField_2522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "受够他的“先见之明”了。"
    }
    {
      Id = "MelinoeField_2523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
    {
      Id = "Prometheus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，吾主大业中的“节外生枝”，如期而至。我知道你是什么人，冥王失踪的女儿。我也知道你很清楚我是谁。我对这一刻早有预感。"
    }
    {
      Id = "MelinoeField_2381"
      InheritFrom = "BaseNarrative"
      DisplayName = "没猜错的话，您就是普罗米修斯大人吧。您一定每时每刻都对未来有所预感。我还没听说过您重获自由了，也没听说过您把克洛诺斯认作了主人。这样说来，是泰坦之间的联手吗？"
    }
    {
      Id = "Prometheus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "称之为回心转意吧。我曾经是个懦夫，是个蠢货；我居然和众神站在一起，对抗我的同族。那种事不会再发生了。这便是我为赎罪所做出的努力。"
    }
    {
      Id = "MelinoeField_2382"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是指引领这场鲁莽的进攻？我从来没有把你当作懦夫看待，但恐怕你真的是个蠢货。"
    }
    {
      Id = "Prometheus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你说得没错，但至少我会是胜利的蠢货。因为我预见得到，你毫无胜算。"
    }
    {
      Id = "Prometheus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "你明知前路是什么在等待，却仍执意要回来。当然，我料到你会如此，但我想不通背后的缘由。因为你不肯告诉我……"
    }
    {
      Id = "MelinoeField_2384"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。比起你本身，或者你养的那只该死的鹰，你那些让人摸不着头脑的谜语对我的身心健康威胁更大。"
    }
    {
      Id = "Prometheus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你面对的威胁超出了你的理解；这是你如此锲而不舍的唯一缘由。你的无知真是一种{#Emph}福分{#Prev}！正如同我赐予人类的火种一样。不过，恐怕我的火焰你是无福消受了。"
    }
    {
      Id = "Prometheus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你有多少能耐；你的一招一式都在我的意料之中。然而……我的思维有时也会引我误入歧途。预料到并没有发生的各种可能性……让我犯下了太多失误。"
    }
    {
      Id = "MelinoeField_2553"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确实有很多失误，比如把这件事说给我听，还有出现在这里与我为敌。你在之前被禁锢的过程中，真的什么也没学到吗？"
    }
    {
      Id = "Prometheus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "遭受禁锢，便是被剥夺了学习的机会。这本身是一种残忍的折磨，但我的确从中学到了一件事：我的意志坚不可摧。
"
    }
    {
      Id = "Prometheus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你认为只要不断尝试、尝试、再尝试，就一定有能冲破我阻拦的那一天。事实上，你想得没错！也许不会是今夜，但终有一夜会如此，这是定数。"
    }
    {
      Id = "MelinoeField_2385"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你为我提前揭晓这一点。如果我像恶名昭著的“先见泰坦”一般知晓所有结局，也许我也会向你一样，沦为心怀怨怼的卑鄙叛徒吧。"
    }
    {
      Id = "Prometheus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又如何懂得我的痛苦？！你这个在时间之中苦苦挣扎的可怜虫！你那匹夫之勇，全是来自心中的自傲。来吧，变革的使者，让我见证一下你的能力，是否都不出所料！"
    }
    {
      Id = "Prometheus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "艾托斯视力卓绝，这点毋庸置疑。自从你第一次踏上奥林匹斯山的山脚，它便看见了你。也许它拖慢了你，然而……我早就知道你会在这一刻抵达这里。"
    }
    {
      Id = "MelinoeField_2722"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？你要是真的什么都知道，那你倒是说说，这次我们交手会有什么样的结果？和上次一样么？"
    }
    {
      Id = "Prometheus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你事先知道了结果，那么事情的发展便注定会与预测的未来大相径庭。不过，给你一些提示，或许也无妨……"
    }
    {
      Id = "Prometheus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你的伤势早就有所预料，但恐怕你没有。当然，只要给予一些{#Emph}时间{#Prev}，这些伤口都会痊愈。"
    }
    {
      Id = "MelinoeField_2733"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢你的关心，不过你最好还是多当心{#Emph}你自己{#Prev}的伤势吧。那些绷带……你的状态早已不在巅峰。不过也许这意味着，我们之间的对决会更加公平。"
    }
    {
      Id = "Prometheus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从很久之前，我的伤口对我便不再是阻碍了。我不会让伤口彻底痊愈，这样我才能牢记我是为何而战。而且艾托斯对此也很高兴。"
    }
    {
      Id = "Prometheus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的大军差点就拦住了你，可惜还差那么一点。但就算现在，你面对我和艾托斯，也是寡不敌众。"
    }
    {
      Id = "MelinoeField_2883"
      InheritFrom = "BaseNarrative"
      DisplayName = "一想到不止能向你复仇，还能跟你的老鹰算账，我就有了前进的动力。我们开始吧？"
    }
    {
      Id = "Prometheus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "好。我就不耽搁你了。因为我知道这里是谁将大仇得报，而且很想看到{#Emph}你{#Prev}揭晓答案时会是什么表情。"
    }
    {
      Id = "Prometheus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "你如此狼狈，还妄想战胜我？也许我被捆在山上，肝脏被啄掉一半的时候，跟你较量才会公平一些。"
    }
    {
      Id = "MelinoeField_2884"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看你也不是来参加体育竞技的，普罗米修斯，所以公平与否就无所谓了。废话少说，动手吧。"
    }
    {
      Id = "Prometheus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "体育竞技！在战斗开始之前，不知道会有何种结果，一定让人心情激动。哪怕是像这样少有悬念的战斗。"
    }
    {
      Id = "Prometheus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜的你还真是个不速之客！你扭曲了自然的法则，来实现自己的目标……和毫不在意你的存在结下联盟。"
    }
    {
      Id = "MelinoeField_2890"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实走了条捷径，但其他的你全都说错了。我知道你所说的存在是指谁，而祂绝不是你所想象的样子。"
    }
    {
      Id = "Prometheus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "不是么？难道不是卡俄斯让你如此接近你的目标，却又让你无法再前进半步……哪怕你在这里胜利也无济于事？我知道这一切会是何种结果。那就来吧！"
    }
    {
      Id = "Prometheus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们众神迫使所有凡人对你们顶礼膜拜，究竟意义何在？将他们肆意宰杀，对你们来说到底有何好处？放过他们吧！"
    }
    {
      Id = "MelinoeField_2724"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一定会把这件事加入我对叔父宙斯的请求中的，但现在的问题是，你非要拦在这里，不让我去拜访他。"
    }
    {
      Id = "Prometheus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的叔父曾经把我捆在一座山上长达千万年之久，让艾托斯肆意啃食我的血肉。艾托斯最终幡然醒悟，但宙斯……？他永远没有幡然醒悟的那天。"
    }
    {
      Id = "MelinoeField_2725"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说回来，你为什么如此在意凡人？他们的生命短暂、身躯孱弱，很多人直到死后才稍微明白些事理。"
    }
    {
      Id = "Prometheus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "但凡是有才能的匠人，都会在意自己的作品。“凡人”！按照众神的形象塑成，却又被迫屈居众神之下，碌碌终生，多么可悲可叹！我的主人和我正意欲改变这点。"
    }
    {
      Id = "MelinoeField_2726"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是，人类是由{#Emph}你{#Prev}造出来的？然后你又从这座山上为{#Emph}他们{#Prev}盗走了火种？荒唐。"
    }
    {
      Id = "Prometheus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "真相有时就是这样令人费解。凡人的生存只是为了受苦，而我对此负有责任，因此我便想要为他们减轻一些苦难。然后将这些苦难分配到你们身上。"
    }
    {
      Id = "Prometheus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，众神有件事情可以向凡人学习。虽然凡人有种种不足之处，但他们总能紧紧抓住一丝希望，这一点值得钦佩。我们这些不朽者，往往欠缺这样的精神。"
    }
    {
      Id = "MelinoeField_2737"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望是天真之人的灵药。有那么多凡人希望自己长生不死；这种感受的根源，是妄想与恐惧。"
    }
    {
      Id = "Prometheus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确！凡人的生命短暂而痛苦。但尽管如此，他们仍然向着绝大多数人毕生无法企及的高峰勇敢攀登。我便是为{#Emph}他们{#Prev}而战！而你们众神，只为{#Emph}自己{#Prev}而战。"
    }
    {
      Id = "Prometheus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "你尽管反抗吧，众神的时代已经走到头了！{#Emph}时间{#Prev}将会为这一切画上句号。而在这之后，启迪的黄金时代将会揭开帷幕，到那时，你们众神绝不会再有如此权力。"
    }
    {
      Id = "MelinoeField_2735"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我之前给你留下过印象，让你以为我对这些末日论调和虚假预言感兴趣的话，那你一定是误会了。"
    }
    {
      Id = "Prometheus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "刚愎自用、闭目塞听，正是你们应当失势的原因所在。既不愿放弃这座山，那便葬在这座山上吧！"
    }
    {
      Id = "Prometheus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "显然，吾主的大业需要时间。我在此地的目的并非一劳永逸地阻止你，而是拖慢你的步伐。"
    }
    {
      Id = "MelinoeField_2723"
      InheritFrom = "BaseNarrative"
      DisplayName = "除非你有某种非得向敌人泄露军事机密的恶习，否则我只能假设你是在胡言乱语，以期干扰我的判断了。无论如何，我自己的目标都不会改变。"
    }
    {
      Id = "Prometheus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，顽固不化是你家族的招牌特征之一。也罢，那我们就执行各自的计划吧。说不定在这里，我的计划能取得前所未有的成功。"
    }
    {
      Id = "MelinoeField_2728"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦，你这样夜夜与我说话又是何苦？毕竟理论上我会说什么都在你的意料之中。你的生活一定无聊透顶。"
    }
    {
      Id = "Prometheus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "此前还要无聊得多！但是，至于你的问题，我不愿让先见的诅咒落到任何人都头上……或许，除了我最深恶痛绝的敌人。而你目前还不在他们的行列之中。"
    }
    {
      Id = "MelinoeField_2729"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦？那看来我得再加把劲，才能赢得那份殊荣了。而当只要我执着于一件事时，通常都会取得成功。"
    }
    {
      Id = "Prometheus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点我知道。但我也知道，傲慢，作为你们众神的招牌特质，往往是失败的先兆。拭目以待吧，这副胸有成竹的气势迟早会令你付出代价。"
    }
    {
      Id = "Prometheus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有许许多多的问题想要问我……而我不会作出回答，目前不会。至少，你得先把问题问出口才行。"
    }
    {
      Id = "MelinoeField_2730"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看不如让我省点工夫吧？只要我永远不说出口，你就永远不会知道我到底要说什么了。"
    }
    {
      Id = "Prometheus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "但哪怕你的眼力和听力无法发觉，你的心也会告诉你，我并非如你所想那般是个骗子。然而，我们仍是势不两立。"
    }
    {
      Id = "Prometheus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "你将要说出口的不过是些轻佻的嘲讽，意图则是掩饰困扰你已久的重要问题。开口吧！倘若你有所保留，我势必无法回答。"
    }
    {
      Id = "MelinoeField_2738"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，你对我和我的未来毫无控制力。以及，别担心，我是{#Emph}不会{#Prev}有所保留的。"
    }
    {
      Id = "Prometheus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早知你会作此回应，但又别无他法，只能这样开启这个话题。又一次，我促成了自己竭力避免的结果……"
    }
    {
      Id = "MelinoeField_2739"
      InheritFrom = "BaseNarrative"
      DisplayName = "回答我一个问题，泰坦。如果你知道未来的一切，为什么还要做出导致你遭受酷刑的那些选择？为什么要让你自己落入他人手中？"
    }
    {
      Id = "Prometheus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们所做的的选择，会在时间的长河之中回响，创造出比原本深远得多的影响。倘若我没有受到囚禁，我便不会出现在这里——在我应在之地。"
    }
    {
      Id = "MelinoeField_2740"
      InheritFrom = "BaseNarrative"
      DisplayName = "你受了那么多的苦难，只为了今晚在这里被我再揍一顿？真是个骗子……说着那些似是而非的预言，只是为了佯装正义而明智。"
    }
    {
      Id = "Prometheus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神之中，就数你最该懂得“牺牲”的意义……但至少目前，这并不重要。我不需要与你证什么是非，也不需要和你说什么秘密；我留给你的，只有满腔怒火。"
    }
    {
      Id = "MelinoeField_2880"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要么是在用你所谓的先见招摇撞骗，要么就是在故意让我赢。毕竟，谁不喜欢时不时被一个女巫揍上一顿呢？"
    }
    {
      Id = "Prometheus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和我之间最大的区别，就是你只能怀疑、推断，而我则知道既定的事实。但是，有些真相，就连我也无法透露。"
    }
    {
      Id = "MelinoeField_2881"
      InheritFrom = "BaseNarrative"
      DisplayName = "这倒是没什么，我本来也没指望你透露。无论我知不知道未来会发生什么，我都可以用行动改变未来。"
    }
    {
      Id = "Prometheus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "听我一句劝吧，变革的使者：你对未来知道得越多，就越难以将其塑造成自己想要的模样。"
    }
    {
      Id = "Prometheus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你打算说什么，变革的使者。因此我要提醒你：{#Emph}不要说出口。{#Prev}倘若你的想法化作言语，所带来的结果对你我二人都将毫无益处。"
    }
    {
      Id = "MelinoeField_2727"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧……我就姑且信你一次。不过还望你见谅，我对这种小事是否会改变历史的轨迹还是持怀疑态度。"
    }
    {
      Id = "Prometheus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还是不明白。你我就如黏土；众生皆是如此。黏土可以塑形，亦可以被重塑。我们避免了一场灾难，但对下一场来说，你我都是在劫难逃。"
    }
    {
      Id = "Prometheus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你认定我是戴罪之人，那我要问问你：你知道我{#Emph}为什么{#Prev}要为了凡人，将火焰从这座山上解放开来吗？"
    }
    {
      Id = "MelinoeField_2882"
      InheritFrom = "BaseNarrative"
      DisplayName = "借助我愈发强大的先见之明，我感觉不管我怎么回答，你都会告诉我答案。"
    }
    {
      Id = "Prometheus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "那时我给予了人类食物……也就是他们原本打算献给你们的肉……他们那时便需要火焰，而且不只需要火焰。{#Emph}但你们把所有东西都私藏着！{#Prev}于是我便出手拯救了他们；而现如今，我会让那一幕再度上演。"
    }
    {
      Id = "Prometheus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……所以今晚，你我二人将会用借来的火焰对抗。倘若我没有事先知道结局的话，应该会很有趣……"
    }
    {
      Id = "MelinoeField_2891"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是来供你消遣的，泰坦。你盗来的火种不会让你免疫火焰。"
    }
    {
      Id = "Prometheus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然不会。而且，我知道你手中的武器名叫伊格尼姆，也能预想到其火焰会令我灼痛难忍。但我经受过更大的痛苦。"
    }
    {
      Id = "MelinoeField_2886"
      InheritFrom = "BaseNarrative"
      DisplayName = "告诉我，泰坦：你还记不记得一个名叫朵拉的凡间女子？当我提到你的名字时，她的暗灵反应很奇怪，但似乎想不起来你究竟做了什么。"
    }
    {
      Id = "Prometheus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者，这件事我建议你最好不要深挖。那个古老的暗灵之所以将记忆尘封，与我的所作所为关系不大，与众神的欺瞒行径却关系匪浅。"
    }
    {
      Id = "MelinoeField_2887"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就解释清楚！告诉我朵拉究竟经历了什么。你总是把一切都怪罪到众神头上，就好像这些事情全都是他们的责任似的。"
    }
    {
      Id = "Prometheus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，恰恰相反，我会为凡人承担责任。但凡人的各种缺陷、各种恶念、各种自取灭亡的行径，都不该怪罪于我。也不该怪罪于这个{#Emph}“朵拉”{#Prev}。这句话你转达给她吧。"
    }
    {
      Id = "Prometheus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的伙伴，朵拉……她不记得我，至少目前如此。但她会记起来的！而且，等到她记起来的时候，她也会同时想起她当初为何选择忘掉我……以及忘掉那么多其他事情。"
    }
    {
      Id = "MelinoeField_2888"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前说过，人类的各种缺陷不该怪罪于她，就好像她身上能背负这么大的责任似的。到底发生了什么？你是怎么认识她的？"
    }
    {
      Id = "Prometheus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "她经历了不堪回首的过往，相信你也看得出来。然而，轮不到我向你透露这些事情，除了我已经告诉你的这些，否则只怕她会太快想起太多事情。借吾主一言，“万事万物都有属于自己的时间”。"
    }
    {
      Id = "MelinoeField_2731"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你所谓的主人克洛诺斯，其实想要看到你失败……想看到你遭受比从前还要痛苦的折磨。毕竟，他是要向推翻他的众神复仇——而他被推翻时，你是众神的盟友！"
    }
    {
      Id = "Prometheus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有寻求我主人的原谅，也没有默认他与我是一条心。联盟源自共同的目标，又或许是理念；而众神的理念与我正背道而驰。"
    }
    {
      Id = "MelinoeField_2732"
      InheritFrom = "BaseNarrative"
      DisplayName = "就因为他们为你的明知故犯做出了惩罚？在你犯下欺瞒和偷盗的罪行之后，难道他们还有选择的余地么？"
    }
    {
      Id = "Prometheus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从未{#Emph}偷盗{#Prev}！火焰会自然蔓延，会将沿途的一切烧成灰烬。众神意欲将其囚禁，但我得以将其解放。现在，火焰终于自由了，而我亦是如此——燃烧着熊熊战意。"
    }
    {
      Id = "Prometheus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "“伟大的宙斯”将我禁锢、折磨，可不是因为从神山盗取圣火这件莫须有的罪名。不，他想要的是信息……他想知道他最终将如何陨落。"
    }
    {
      Id = "MelinoeField_2736"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你用虚假的预言威胁了奥林匹斯之王，因此招来了他的愤恨。也许不是我叔父最骄傲的时刻，但我能理解他这样做的原因。你告诉了他什么？"
    }
    {
      Id = "Prometheus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "我{#Emph}什么{#Prev}也没告诉他！我只是说，他的统治终有结束之时。随着每一夜的流逝，这样的结局的可能性愈来愈高。你不过是这计划中生出的枝节，仅此而已。"
    }
    {
      Id = "MelinoeField_2893"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神——至少是众神中的一位——想要与你和平共处，普罗米修斯！迪奥尼索司大人想邀请你，作为他最新举办的宴会的荣誉嘉宾。你拥有先见的天赋，因此一定知道我所言非虚。"
    }
    {
      Id = "Prometheus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的先见看不到毫无可能出现的情况。无论你想设下什么骗局，仅凭{#Emph}这样{#Prev}的伎俩是无法让我上当的。"
    }
    {
      Id = "MelinoeField_2894"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和你的主人不一样；难道你也看不出来，众神的思想并不尽然相同么？迪奥尼索司对你们之间的纷争不感兴趣！"
    }
    {
      Id = "Prometheus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司感兴趣的，只有借助酒精，浇灭他为数不多的复杂想法，追求简单纯粹的肉体享受。如此没有自制力，与其说是神明，还不如说是野兽。"
    }
    {
      Id = "MelinoeField_2895"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有接受迪奥尼索司大人的邀请，让他相当失望！你在未来真的没有回心转意的可能吗？"
    }
    {
      Id = "Prometheus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}绝对没有！{#Prev}千万年来，我的肝脏早已被好艾托斯啃食得千疮百孔；我是不会容许酒神进一步伤害我的肝脏的！"
    }
    {
      Id = "Prometheus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得众神的记号，但你身上的有所不同。更加古老的存在……卡俄斯的印记。最为古老，最为淡漠的力量，居然受到教唆，采取了行动！"
    }
    {
      Id = "MelinoeField_2889"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连卡俄斯都不希望看到克洛诺斯胜利，然而你却选择了与克洛诺斯为伍。好好想想这说明了什么吧！"
    }
    {
      Id = "Prometheus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "这说明所有的存在都可能犯错，就连卡俄斯也不意外。我们{#Emph}全都是{#Prev}粗制滥造的意外，你看不出来么？但我们仍然努力追求完美，而完美可望不可即。"
    }
    {
      Id = "Prometheus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "你与巫术师合作，想要藉此占据上风……但这样的把戏不会对我奏效。对手的体型是无关紧要的变数罢了。"
    }
    {
      Id = "MelinoeField_2892"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能认出喀耳刻女士的巫术，却还是低估了它的效力。看来你的先见并非无所不能啊，泰坦。"
    }
    {
      Id = "Prometheus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。但你们的巫术也同样并非无所不能。我劝你最好不要过于依赖它们。"
    }
    {
      Id = "Prometheus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "未来是一系列固定的点。就连吾主也不相信这个事实，但我已经亲眼见过了各种可能。唯一的问题是……哪一个点，才是我们的终点？"
    }
    {
      Id = "MelinoeField_2734"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在用这些胡言乱语荼毒我的心灵。就连命运三女神也无法彻底确定未来将要发生的事情，因为她们一直在继续编织。"
    }
    {
      Id = "Prometheus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们{#Emph}曾经{#Prev}一直在编织，是的。我知道你已经知道，她们已经不再编织了。但每分每秒，未来仍会在我们面前成为现实。让我们亲手塑造自己的未来吧！"
    }
    {
      Id = "Prometheus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有一个哥哥，但你与他素未谋面。我有三个兄弟，一个傲慢，一个愚钝，还有一个可怜虫肩上扛着整个世界。你觉得你的哥哥和哪个最为相像？"
    }
    {
      Id = "MelinoeField_2885"
      InheritFrom = "BaseNarrative"
      DisplayName = "怪不得你恨我的家人，你连自己的家人都恨。我们是不是该快点杀个你死我活？我不打算在这待一整晚。"
    }
    {
      Id = "Prometheus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和我的兄弟以前也常常正常。我原本以为我已经有所成长，变得更加文明了。但事实证明并非如此。"
    }
    {
      Id = "Prometheus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不会死，但你可以被击退。先让你尝尝火焰的滋味。"
    }
    {
      Id = "Prometheus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道我们每次交手的结果，但不知为何，你仍然能给我带来惊喜。"
    }
    {
      Id = "Prometheus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的力量再也无法重回巅峰，但应付你还是绰绰有余。"
    }
    {
      Id = "Prometheus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "艾托斯仍然对肝脏的味道念念不忘，我们又有什么理由不满足他的愿望？"
    }
    {
      Id = "Prometheus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者去而复返，历史的轨迹就此改写。"
    }
    {
      Id = "Prometheus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕你在此拼尽全力，众神的时代也迟早会迎来终结。"
    }
    {
      Id = "Prometheus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神为了惩罚我莫须有的罪名对我做出的种种，仍然让我无法忘怀。"
    }
    {
      Id = "Prometheus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些爱慕虚荣的众神想要信徒；我们泰坦则只想要拿回属于我们的东西。"
    }
    {
      Id = "Prometheus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "我忍受了肝脏被啄食千万年的痛苦，和你的小打小闹不算什么。"
    }
    {
      Id = "Prometheus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "当初赠予人类的火种，我特地为你留了一些。"
    }
    {
      Id = "Prometheus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看到了么？我每拖慢你一刻，时间的计划就更进一步。"
    }
    {
      Id = "Prometheus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能否再次将我击倒，我早已心中有数，但答案还要你亲自揭晓。"
    }
    {
      Id = "Prometheus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我见过你的每一招、每一式，你所能做到的一切！而今夜的你还差些火候。"
    }
    {
      Id = "Prometheus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "这座山不会由我来攻克，也不会由你来拯救。"
    }
    {
      Id = "Prometheus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对这个世界一无所知，但却要捍卫它；而我见过这世界的所有，因而只把它付之一炬。"
    }
    {
      Id = "Prometheus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对家族毫无亏欠，却要为他们付出一切。你们全都一样，无可救药。"
    }
    {
      Id = "Prometheus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的冲突终有结束之时，但不必对此抱什么期待。"
    }
    {
      Id = "Prometheus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神与泰坦彼此的所作所为永远不会被原谅……最多只会被遗忘。"
    }
    {
      Id = "Prometheus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "我体内流淌的火焰，使我五内俱焚……我要让你尝尝这滋味。"
    }
    {
      Id = "Prometheus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若真如奥林匹斯众神所言，我已经犯下了十恶不赦的罪行，那今天之事便已然无足轻重。"
    }
    {
      Id = "Prometheus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "我再也不会被锁链束缚；这既是我的誓言，亦是我的预见。"
    }
    {
      Id = "Prometheus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "事到如今，你应该已经有些先见之明了，不是么？你知道这场决斗将会如何结束。"
    }
    {
      Id = "Prometheus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔呃……我就知道会这样。但我无法阻止这一切，你看不出来么？我只能……尽我自己的……一份力……"
    }
    {
      Id = "MelinoeField_2383"
      InheritFrom = "BaseNarrative"
