      Id = "MelinoeField_2519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他预料到他会输了么……？"
    }
    {
      Id = "MelinoeField_2520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回去舔舐伤口去吧。"
    }
    {
      Id = "MelinoeField_2521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "预料到了。"
    }
    {
      Id = "MelinoeField_2522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "受够他的“先见之明”了。"
    }
    {
      Id = "MelinoeField_3742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们是一伙的……"
    }
    {
      Id = "MelinoeField_5202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们真难对付……"
    }
    {
      Id = "MelinoeField_5203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们到底密谋了多久……？"
    }
    {
      Id = "MelinoeField_5204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见了，二位……！"
    }
    {
      Id = "MelinoeField_2523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
    {
      Id = "Prometheus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，吾主大业中的“节外生枝”，如期而至。我知道你是什么人，哈迪斯失踪的女儿。我也知道你很清楚我是谁。我对这一刻早有预感。"
    }
    {
      Id = "MelinoeField_2381"
      InheritFrom = "BaseNarrative"
      DisplayName = "没猜错的话，您就是普罗米修斯大人吧。您一定每时每刻都对未来有所预感。我还没听说过您重获自由了，也没听说过您把克洛诺斯认作了主人。这样说来，是泰坦之间的联手吗？"
    }
    {
      Id = "Prometheus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "称之为回心转意吧。我曾经是个懦夫，是个蠢货；我居然和众神站在一起，对抗我的同族。那种事不会再发生了。这便是我为赎罪所做出的努力。"
    }
    {
      Id = "MelinoeField_2382"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是指引领这场鲁莽的进攻？我从来没有把你当作懦夫看待，但恐怕你真的是个蠢货。"
    }
    {
      Id = "Prometheus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你说得没错，但至少我会是胜利的蠢货。因为我预见得到，你毫无胜算。"
    }
    {
      Id = "Prometheus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "你明知前路是什么在等待，却仍执意要回来。当然，我料到你会如此，但我想不通背后的缘由。因为你不肯告诉我……"
    }
    {
      Id = "MelinoeField_2384"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。比起你本身，或者你养的那只该死的鹰，你那些让人摸不着头脑的谜语对我的身心健康威胁更大。"
    }
    {
      Id = "Prometheus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "你面对的威胁超出了你的理解；这是你如此锲而不舍的唯一缘由。你的无知真是一种{#Emph}福分{#Prev}！正如同我赐予人类的火种一样。不过，恐怕我的火焰你是无福消受了。"
    }
    {
      Id = "Prometheus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你有多少能耐；你的一招一式都在我的意料之中。然而……我的思维有时也会引我误入歧途。预料到并没有发生的各种可能性……让我犯下了太多失误。"
    }
    {
      Id = "MelinoeField_2553"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确实有很多失误，比如把这件事说给我听，还有出现在这里与我为敌。你在之前被禁锢的过程中，真的什么也没学到吗？"
    }
    {
      Id = "Prometheus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "遭受禁锢，便是被剥夺了学习的机会。这本身是一种残忍的折磨，但我的确从中学到了一件事：我的意志坚不可摧。
"
    }
    {
      Id = "Prometheus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你认为只要不断尝试、尝试、再尝试，就一定有能冲破我阻拦的那一天。事实上，你想得没错！也许不会是今夜，但终有一夜会如此，这是定数。"
    }
    {
      Id = "MelinoeField_2385"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你为我提前揭晓这一点。如果我像恶名昭著的“先见泰坦”一般知晓所有结局，也许我也会向你一样，沦为心怀怨怼的卑鄙叛徒吧。"
    }
    {
      Id = "Prometheus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又如何懂得我的痛苦？！你这个在时间之中苦苦挣扎的可怜虫！你那匹夫之勇，全是来自心中的自傲。来吧，变革的使者，让我见证一下你的能力，是否都不出所料！"
    }
    {
      Id = "Prometheus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "艾托斯视力卓绝，这点毋庸置疑。自从你第一次踏上奥林匹斯山的山脚，它便看见了你。也许它拖慢了你，然而……我早就知道你会在这一刻抵达这里。"
    }
    {
      Id = "MelinoeField_2722"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？你要是真的什么都知道，那你倒是说说，这次我们交手会有什么样的结果？和上次一样么？"
    }
    {
      Id = "Prometheus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你事先知道了结果，那么事情的发展便注定会与预测的未来大相径庭。不过，给你一些提示，或许也无妨……"
    }
    {
      Id = "MelinoeField_3551"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯！你在干什么，跟我们的敌人勾结吗？"
    }
    {
      Id = "Heracles_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我们的{#Prev}敌人？呵。又被你言中了，普罗米修斯。所以，现在又要如何？终于被她抓了个现行啊。"
    }
    {
      Id = "Prometheus_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在唯有一战，大块头。至少也要拖慢她。她不会告诉任何人你在这里。如果她那样做，会给她的家族带来过于灾难性的打击。"
    }
    {
      Id = "MelinoeField_3552"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你们两个{#Emph}都是{#Prev}叛徒。而且你们还以为，我不会跟宙斯大人与其他人说这件事？赫拉克勒斯，他可是你的{#Emph}父亲{#Prev}！但你却要与他为敌？"
    }
    {
      Id = "Heracles_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不正是家族传统么？而且，先见泰坦早已预见此事，我又岂能辩得过他？现在，就容我用手中的巨槌，确保你忘记今夜所见。"
    }
    {
      Id = "Heracles_0214_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "先见泰坦早已预见此事，我又岂能辩得过他？现在，就容我用手中的巨槌，确保你忘记今夜所见。"
    }
    {
      Id = "MelinoeField_3999"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}赫拉克勒斯！{#Prev}你跟{#Emph}他{#Prev}勾结在一起做什么？你应该要像以前一样，保卫这座山才对！"
    }
    {
      Id = "Heracles_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}勾结！{#Prev}呵。又被你言中了，普罗米修斯。所以，现在又要如何？终于被她抓了个现行啊。"
    }
    {
      Id = "Prometheus_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在唯有一战，大块头。至少也要拖慢她。她不会告诉任何人你在这里。她的家族无力承担这样的真相，至少目前来说，以及不久的未来都是如此。"
    }
    {
      Id = "MelinoeField_4000"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可不好说，听起来这像是背叛。而且你们真的以为，我不会跟宙斯大人与其他人说这件事？赫拉克勒斯，他可是你的{#Emph}父亲{#Prev}！其他神明暂且不提，你真的要辜负他的信任吗？"
    }
    {
      Id = "Prometheus_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者！我对自己的败绩自然早有预料。但当你同时面对赫拉克勒斯和我时，你会发现通往胜利的道路对你来说少了许多。"
    }
    {
      Id = "Heracles_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "非得对这女巫说这些话么，窃火者？我看不如直接让她领教领教。"
    }
    {
      Id = "Prometheus_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早已料到你会这样说，兄弟。当然，你也大可以这样做；毕竟我们不是来这里逞口舌之快的。{#Emph}她也一样。"
    }
    {
      Id = "Prometheus_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若说拥有赫拉克勒斯的凶暴力量作为支援有什么弊端，那便一定是过度自信。当时我想：“我们怎么可能会输”。嗯……事实证明，确有可能。"
    }
    {
      Id = "Heracles_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "你该告诉我这些可能的，窃火者。我不习惯失败的滋味。还好这里浓烟滚滚，没有旁人见证……"
    }
    {
      Id = "MelinoeField_3750"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们两个想要继续这场温馨对话的话，我也不忍心打断你们。不过，我猜你们又要逼我出手了。"
    }
    {
      Id = "Prometheus_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "说到底这是我们来这里的目的，所以，没错。无论你走到何处，都有变革相随。而变革向来与冲突作伴。"
    }
    {
      Id = "MelinoeField_3751"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯！你对自己的这些所作所为，有什么要辩解的吗？解开普罗米修斯束缚的，是不是{#Emph}就是你？"
    }
    {
      Id = "Heracles_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹子，无论你问我什么，我都只会用手中的巨槌回答。不如去问问站在我旁边的泰坦，他倒是很乐意分享他的真知灼见。"
    }
    {
      Id = "Prometheus_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "只有被人相信的真知灼见才会成真。而无论我告诉我们的对手什么，她都不会相信；至少不会尽信……就现在来说，还是让你的巨槌说话吧。"
    }
    {
      Id = "MelinoeField_3752"
      InheritFrom = "BaseNarrative"
      DisplayName = "你那位魁梧的朋友不见踪影了啊。看来你只能独自和我战斗了，毕竟你那只鸟不太顶事。"
    }
    {
      Id = "Prometheus_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "我那位“魁梧的朋友”听从更高力量的召唤，而且我知道你对此心知肚明。你想要再次同时面对我们两个的话……你知道需要怎么做。"
    }
    {
      Id = "MelinoeField_3928"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么我要再经历一次{#Emph}那种事{#Prev}？你一个人就够强了，要我再多应付一根有我两倍大的巨槌，我看大可不必。"
    }
    {
      Id = "Prometheus_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "多谢夸奖！为了回应你受到的召唤，做你该做的事。这就是你来这里的目的，也是过不了多久赫拉克勒斯就会再次现身的原因。"
    }
    {
      Id = "MelinoeField_3929"
      InheritFrom = "BaseNarrative"
      DisplayName = "和艾托斯相伴的，又只剩你一个人了！据说赫拉克勒斯曾经杀死过一整群贪食的飞鸟……艾托斯在他身边一定会感到不安。"
    }
    {
      Id = "Prometheus_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "收起你那假惺惺的担忧吧。你们众神都有着共同的目的，那便是重新确立自己的统御地位。我们也有共同的目的，但却与你们的背道而驰。"
    }
    {
      Id = "Prometheus_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到了吗，大块头？她没让你等多久。不过我知道你有多厌恶自己的工作被众神肆意安排。"
    }
    {
      Id = "Heracles_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "我已经越来越习惯了。有他们在，我就不需要做困难的选择；只需要做简单的，比如先打断哪根骨头。"
    }
    {
      Id = "Prometheus_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "而我很期待看到你做出选择，不过，我当然已经知道了……"
    }
    {
      Id = "MelinoeField_3753"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有些事想和你谈谈，普罗米修斯！所以为什么不让你魁梧的朋友回避一下呢？他这样偷听我们的私人谈话，会显得很没礼貌的。"
    }
    {
      Id = "Prometheus_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者，你一段时间内都不会相信这点，但赫拉克勒斯是{#Emph}可以{#Prev}信任的……当然在当下并非如此，但你明白我的意思。"
    }
    {
      Id = "Heracles_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "我几乎毫不在意你接下来打算说什么，妹子。你想要我“回避”一下，那就逼我。要么在这里用武器把我请走，要么就去逆转你令我现身的方式。"
    }
    {
      Id = "MelinoeField_3754"
      InheritFrom = "BaseNarrative"
      DisplayName = "那既然你们两个都在这里，我有句话想对你们说：其实你们都不如看起来那么强壮。"
    }
    {
      Id = "Prometheus_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "你低估了我们联手的力量，但很快你就会追悔莫及。让他见识见识吧，赫拉克勒斯！"
    }
    {
      Id = "Prometheus_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿意听我一言么，赫拉克勒斯？跟她说话并非必要之举。我们可以毫无预警，直接动手。"
    }
    {
      Id = "Heracles_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这里说话只是因为{#Emph}{#Emph}你{#Prev}。攻其不备的道理我懂，没必要为此多费口舌。"
    }
    {
      Id = "Prometheus_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就这么定了！就让她猜去吧。不过，到头来我们还是会按习惯行事，由我来进行大部分对话。"
    }
    {
      Id = "MelinoeField_3755"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯！我们在别处遇见时，你就假装一切如常，但来了这里，你还是要与我交手？我以为你是个杰出的战士，但你不过是个杰出的演员！"
    }
    {
      Id = "Heracles_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "来这世上走过一遭的，哪个不是从头演到尾，妹子。以及，你再敢与我多说一句试试。这是窃火者的战斗，我不过是在其中扮演一个配角。"
    }
    {
      Id = "Prometheus_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "而且将这里作为舞台，向众神献上一场演出，不是正合适么？你自己也祈求了某位黑暗神明，强迫向来唯命是从的赫拉克勒斯回应其召唤。那就让他们看个尽兴吧！"
    }
    {
      Id = "Heracles_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "不如让我来打一次头阵，窃火者？有的时候，你一开口就没完没了。"
    }
    {
      Id = "Prometheus_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本打算说“还以为你开不了口呢”，但我们都知道真相，大块头。我可以预见你们不会说多少话。"
    }
    {
      Id = "Heracles_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "太久没有输掉过战斗，我都忘记是什么滋味了。羞愧……愤怒……体内燃烧的鲜血。"
    }
    {
      Id = "MelinoeField_3756"
      InheritFrom = "BaseNarrative"
      DisplayName = "而且，普罗米修斯早就知道你注定会输，想必也让你不好受吧。"
    }
    {
      Id = "Heracles_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。但我还意识到了另一件事：我发现自己渴望再次战斗。将我的敌人撕成碎片。我仍然可以抑制住最坏的那一面，但我原本以为，这些冲动早已荡然无存……"
    }
    {
      Id = "MelinoeField_3757"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯，我们初次见面时，你说你工作时一向单干。但在这里你却在跟这个泰坦合作，甚至还能算上那只老鹰。难道那不过是你撒的另一个谎么？"
    }
    {
      Id = "Heracles_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁说我在工作了，妹子？难道这不能是我工作后放松身心的方式么。我的工作和兴趣爱好有共同之处。"
    }
    {
      Id = "MelinoeField_3758"
      InheritFrom = "BaseNarrative"
      DisplayName = "你指望我相信你来这里是出于自愿，而不是出于黑夜的意志么？我知道你来到这里不是巧合。"
    }
    {
      Id = "Heracles_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "爱{#Emph}相信{#Prev}什么，随你。现在，{#Emph}我{#Prev}相信是时候用巨槌砸入你的头颅了，不是为了工作，而是为了{#Emph}娱乐{#Prev}。"
    }
    {
      Id = "Heracles_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "外面很黑，妹子。但你好像总能找到路，像只{#Emph}猫{#Prev}一样无声无息地逼近。知道我遇到猫科动物会怎么做么？"
    }
    {
      Id = "MelinoeField_3759"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来是会把它们做成时尚的兽皮！嗯，你对{#Emph}我{#Prev}是不会有这个机会的。也根本做不到吧？毕竟我太小了。"
    }
    {
      Id = "Heracles_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "你太{#Emph}聪明{#Prev}了。爱说话就多说点吧，不爱说话的我，就只能用手中的巨槌奉陪了。"
    }
    {
      Id = "Heracles_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管你是做了什么让我现身，今夜你一定加了量，妹子。仿佛暗影在地上爬行……"
    }
    {
      Id = "MelinoeField_3760"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是在强大的赫拉克勒斯口中听出了一丝恐惧么？不过该恐惧的是我才对，毕竟要在这样的条件下同时面对你和普罗米修斯。他一定知道，接下来会有一场恶战等着我。"
    }
    {
      Id = "Heracles_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪场战斗不是恶战？不过这不算什么。你想见识真正的恐惧，就去半人马喀戎手下练练吧……"
    }
    {
      Id = "Heracles_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "我之前从没有打输过。和窃火者的感受大概差不多，每场战斗的结果在开始前就都知道了。但现在，事情不一样了……"
    }
    {
      Id = "MelinoeField_3761"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必多一些意外，会让事情对你来说更刺激、更有趣吧。"
    }
    {
      Id = "Heracles_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "不。我从没有打输过，但也从来不喜欢意外的事物。所以，总的来说，我的职业生涯最近发展堪忧啊……"
    }
    {
      Id = "Prometheus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你的伤势早就有所预料，但恐怕你没有。当然，只要给予一些{#Emph}时间{#Prev}，这些伤口都会痊愈。"
    }
    {
      Id = "MelinoeField_2733"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢你的关心，不过你最好还是多当心{#Emph}你自己{#Prev}的伤势吧。那些绷带……你的状态早已不在巅峰。不过也许这意味着，我们之间的对决会更加公平。"
    }
    {
      Id = "Prometheus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从很久之前，我的伤口对我便不再是阻碍了。我不会让伤口彻底痊愈，这样我才能牢记我是为何而战。而且艾托斯对此也很高兴。"
    }
    {
      Id = "Prometheus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的大军差点就拦住了你，可惜还差那么一点。但就算现在，你面对我和艾托斯，也是寡不敌众。"
    }
    {
      Id = "MelinoeField_2883"
      InheritFrom = "BaseNarrative"
      DisplayName = "一想到不止能向你复仇，还能跟你的老鹰算账，我就有了前进的动力。我们开始吧？"
    }
    {
      Id = "Prometheus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "好。我就不耽搁你了。因为我知道这里是谁将大仇得报，而且很想看到{#Emph}你{#Prev}揭晓答案时会是什么表情。"
    }
    {
      Id = "Prometheus_0128_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的大军差点就拦住了你，可惜还差那么一点。现在，该我和艾托斯出手了。"
    }
    {
      Id = "Prometheus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "你如此狼狈，还妄想战胜我？也许我被捆在山上，肝脏被啄掉一半的时候，跟你较量才会公平一些。"
    }
    {
      Id = "MelinoeField_2884"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看你也不是来参加体育竞技的，普罗米修斯，所以公平与否就无所谓了。废话少说，动手吧。"
    }
    {
      Id = "Prometheus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "体育竞技！在战斗开始之前，不知道会有何种结果，一定让人心情激动。哪怕是像这样少有悬念的战斗。"
    }
    {
      Id = "Prometheus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜的你还真是个不速之客！你扭曲了自然的法则，来实现自己的目标……和毫不在意你的存在结下联盟。"
    }
    {
      Id = "MelinoeField_2890"
      InheritFrom = "BaseNarrative"
      DisplayName = "我确实走了条捷径，但其他的你全都说错了。我知道你所说的存在是指谁，而祂绝不是你所想象的样子。"
    }
    {
      Id = "Prometheus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "不是么……？难道不是{#Emph}卡俄斯{#Prev}让你如此接近你的目标，却又让你无法再前进半步……哪怕你在这里胜利也无济于事？我知道这一切会是何种结果。那就来吧！"
    }
    {
      Id = "Prometheus_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡俄斯的旨意究竟铸成了什么，致使我们的生命于此交汇，无休无止地与彼此为敌？"
    }
    {
      Id = "MelinoeField_3979"
      InheritFrom = "BaseNarrative"
      DisplayName = "随时欢迎你向我缴械投降，泰坦。相信你那样做的话，卡俄斯会感到格外有趣。"
    }
    {
      Id = "Prometheus_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "换成是你，大概也一样。但这样的结局永远不会发生，这点你大可以放心。不过，也许我们仍然可以让卡俄斯收获一些乐趣。"
    }
    {
      Id = "Prometheus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们众神迫使所有凡人对你们顶礼膜拜，究竟意义何在？将他们肆意宰杀，对你们来说到底有何好处？放过他们吧！"
    }
    {
      Id = "MelinoeField_2724"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一定会把这件事加入我对叔父宙斯的请求中的，但现在的问题是，你非要拦在这里，不让我去拜访他。"
    }
    {
      Id = "Prometheus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的叔父曾经把我捆在一座山上长达千万年之久，让艾托斯肆意啃食我的血肉。艾托斯最终幡然醒悟，但宙斯……？他永远没有幡然醒悟的那天。"
    }
    {
      Id = "MelinoeField_2725"
      InheritFrom = "BaseNarrative"
      DisplayName = "话说回来，你为什么如此在意凡人？他们的生命短暂、身躯孱弱，很多人直到死后才稍微明白些事理。"
    }
    {
      Id = "Prometheus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "但凡是有才能的匠人，都会在意自己的作品。“凡人”！按照众神的形象塑成，却又被迫屈居众神之下，碌碌终生，多么可悲可叹！我的主人和我意欲改变这点。"
    }
    {
      Id = "MelinoeField_2726"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是，人类是由{#Emph}你{#Prev}造出来的？然后你又从这座山上为{#Emph}他们{#Prev}盗走了火种？荒唐。"
    }
    {
      Id = "Prometheus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "真相有时就是这样令人费解。凡人的生存只是为了受苦，而我对此负有责任，因此我便想要为他们减轻一些苦难。然后将这些苦难分配到你们身上。"
    }
    {
      Id = "Prometheus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，众神有件事情可以向凡人学习。虽然凡人有种种不足之处，但他们总能紧紧抓住一丝希望，这一点值得钦佩。我们这些不朽者，往往欠缺这样的精神。"
    }
    {
      Id = "MelinoeField_2737"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望是天真之人的灵药。有那么多凡人希望自己长生不死；这种感受的根源，是妄想与恐惧。"
    }
    {
      Id = "Prometheus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确！凡人的生命短暂而痛苦。但尽管如此，他们仍然向着绝大多数人毕生无法企及的高峰勇敢攀登。我便是为{#Emph}他们{#Prev}而战！而你们众神，只为{#Emph}自己{#Prev}而战。"
    }
    {
      Id = "MelinoeField_3972"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来你深爱着的那些凡人并不总是领情啊，普罗米修斯。你总说自己为他们做了许多事，但就算这样，他们还是不会信仰你。"
    }
    {
      Id = "Prometheus_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们永远不会信仰我，这点我心知肚明。也许会基于我的事迹编一些警示性的传说，但仅此而已。幸运的是，我不需要人们的拥戴；他们可以把蜜露和仙酒都留给你们。"
    }
    {
      Id = "Prometheus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "你尽管反抗吧，众神的时代已经走到头了！{#Emph}时间{#Prev}将会为这一切画上句号。而在这之后，启迪的黄金时代将会揭开帷幕，到那时，你们众神绝不会再有如此权力。"
    }
    {
      Id = "MelinoeField_2735"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我之前给你留下过印象，让你以为我对这些末日论调和虚假预言感兴趣的话，那你一定是误会了。"
    }
    {
      Id = "Prometheus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "刚愎自用、闭目塞听，正是你们应当失势的原因所在。既不愿放弃这座山，那便葬在这座山上吧！"
    }
    {
      Id = "Prometheus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "显然，吾主的大业需要时间。我在此地的目的并非一劳永逸地阻止你，而是拖慢你的步伐。"
    }
    {
      Id = "MelinoeField_2723"
      InheritFrom = "BaseNarrative"
      DisplayName = "除非你有某种非得向敌人泄露军事机密的恶习，否则我只能假设你是在胡言乱语，以期干扰我的判断了。无论如何，我自己的目标都不会改变。"
    }
    {
      Id = "Prometheus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确，顽固不化是你家族的招牌特征之一。也罢，那我们就执行各自的计划吧。说不定在这里，我的计划能取得前所未有的成功。"
    }
    {
      Id = "MelinoeField_2728"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦，你这样夜夜与我说话又是何苦？毕竟理论上我会说什么都在你的意料之中。你的生活一定无聊透顶。"
    }
    {
      Id = "Prometheus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "此前还要无聊得多！但是，至于你的问题，我不愿让先见的诅咒落到任何人都头上……或许，除了我最深恶痛绝的敌人。而你目前还不在他们的行列之中。"
    }
    {
      Id = "MelinoeField_2729"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦？那看来我得再加把劲，才能赢得那份殊荣了。而当只要我执着于一件事时，通常都会取得成功。"
    }
    {
      Id = "Prometheus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "这点我知道。但我也知道，傲慢，作为你们众神的招牌特质，往往是失败的先兆。拭目以待吧，这副胸有成竹的气势迟早会令你付出代价。"
    }
    {
      Id = "Prometheus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有许许多多的问题想要问我……而我不会作出回答，目前不会。至少，你得先把问题问出口才行。"
    }
    {
      Id = "MelinoeField_2730"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看不如让我省点工夫吧？只要我永远不说出口，你就永远不会知道我到底要说什么了。"
    }
    {
      Id = "Prometheus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "但哪怕你的眼力和听力无法发觉，你的心也会告诉你，我并非如你所想那般是个骗子。然而，我们仍是势不两立。"
    }
    {
      Id = "Prometheus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "你将要说出口的不过是些轻佻的嘲讽，意图则是掩饰困扰你已久的重要问题。开口吧！倘若你有所保留，我势必无法回答。"
    }
    {
      Id = "MelinoeField_2738"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，你对我和我的未来毫无控制力。以及，别担心，我是{#Emph}不会{#Prev}有所保留的。"
    }
    {
      Id = "Prometheus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早知你会作此回应，但又别无他法，只能这样开启这个话题。又一次，我促成了自己竭力避免的结果……"
    }
    {
      Id = "MelinoeField_2739"
      InheritFrom = "BaseNarrative"
      DisplayName = "回答我一个问题，泰坦。如果你知道未来的一切，为什么还要做出导致你遭受酷刑的那些选择？为什么要让你自己落入他人手中？"
    }
    {
      Id = "Prometheus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们所做的的选择，会在时间的长河之中回响，创造出比原本深远得多的影响。倘若我没有受到囚禁，我便不会出现在这里——在我应在之地。"
    }
    {
      Id = "MelinoeField_2740"
      InheritFrom = "BaseNarrative"
      DisplayName = "你受了那么多的苦难，只为了今晚在这里被我再揍一顿？真是个骗子……说着那些似是而非的预言，只是为了佯装正义而明智。"
    }
    {
      Id = "Prometheus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神之中，就数你最该懂得“牺牲”的意义……但至少目前，这并不重要。我不需要与你证什么是非，也不需要和你说什么秘密；我留给你的，只有满腔怒火。"
    }
    {
      Id = "MelinoeField_2880"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要么是在用你所谓的先见招摇撞骗，要么就是在故意让我赢。毕竟，谁不喜欢时不时被一个女巫揍上一顿呢？"
    }
    {
      Id = "Prometheus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和我之间最大的区别，就是你只能怀疑、推断，而我则知道既定的事实。但是，有些真相，就连我也无法透露。"
    }
    {
      Id = "MelinoeField_2881"
      InheritFrom = "BaseNarrative"
      DisplayName = "这倒是没什么，我本来也没指望你透露。无论我知不知道未来会发生什么，我都可以用行动改变未来。"
    }
    {
      Id = "Prometheus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "听我一句劝吧，变革的使者：你对未来知道得越多，就越难以将其塑造成自己想要的模样。"
    }
    {
      Id = "Prometheus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你打算说什么，变革的使者。因此我要提醒你：{#Emph}不要说出口。{#Prev}倘若你的想法化作言语，所带来的结果对你我二人都将毫无益处。"
    }
    {
      Id = "MelinoeField_2727"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧……我就姑且信你一次。不过还望你见谅，我对这种小事是否会改变历史的轨迹还是持怀疑态度。"
    }
    {
      Id = "Prometheus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还是不明白。你我就如黏土；众生皆是如此。黏土可以塑形，亦可以被重塑。我们避免了一场灾难，但对下一场来说，你我都是在劫难逃。"
    }
    {
      Id = "Prometheus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你认定我是戴罪之人，那我要问问你：你知道我{#Emph}为什么{#Prev}要为了凡人，将火焰从这座山上解放开来吗？"
    }
    {
      Id = "MelinoeField_2882"
      InheritFrom = "BaseNarrative"
      DisplayName = "借助我愈发强大的先见之明，我感觉不管我怎么回答，你都会告诉我答案。"
    }
    {
      Id = "Prometheus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "那时我给予了人类食物……也就是他们原本打算献给你们的肉……他们那时便需要火焰，而且不只需要火焰。{#Emph}但你们把所有东西都私藏着！{#Prev}于是我便出手拯救了他们；而现如今，我会让那一幕再度上演。"
    }
    {
      Id = "Prometheus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……所以今晚，你我二人将会用借来的火焰对抗。倘若我没有事先知道结局的话，应该会很有趣……"
    }
    {
      Id = "MelinoeField_2891"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是来供你消遣的，泰坦。你盗来的火种不会让你免疫火焰。"
    }
    {
      Id = "Prometheus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然不会。而且，我知道你手中的武器名叫伊格尼姆，也能预想到其火焰会令我灼痛难忍。但我经受过更大的痛苦。"
    }
    {
      Id = "MelinoeField_2886"
      InheritFrom = "BaseNarrative"
      DisplayName = "告诉我，泰坦：你还记不记得一个名叫朵拉的凡间女子？当我提到你的名字时，她的暗灵反应很奇怪，但似乎想不起来你究竟做了什么。"
    }
    {
      Id = "Prometheus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者，这件事我建议你最好不要深挖。那个古老的暗灵之所以将记忆尘封，与我的所作所为关系不大，与众神的欺瞒行径却关系匪浅。"
    }
    {
      Id = "MelinoeField_2887"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就解释清楚！告诉我朵拉究竟经历了什么。你总是把一切都怪罪到众神头上，就好像这些事情全都是他们的责任似的。"
    }
    {
      Id = "Prometheus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，恰恰相反，我会为凡人承担责任。但凡人的各种缺陷、各种恶念、各种自取灭亡的行径，都不该怪罪于我。也不该怪罪于这个{#Emph}“朵拉”{#Prev}。这句话你转达给她吧。"
    }
    {
      Id = "Prometheus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的伙伴，朵拉……她不记得我，至少目前如此。但她会记起来的！而且，等到她记起来的时候，她也会同时想起她当初为何选择忘掉我……以及忘掉那么多其他事情。"
    }
    {
      Id = "MelinoeField_2888"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前说过，人类的各种缺陷不该怪罪于她，就好像她身上能背负这么大的责任似的。到底发生了什么？你是怎么认识她的？"
    }
    {
      Id = "Prometheus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "她经历了不堪回首的过往，相信你也看得出来。然而，轮不到我向你透露这些事情，除了我已经告诉你的这些，否则只怕她会太快想起太多事情。借吾主一言，“万事万物都有属于自己的时间”。"
    }
    {
      Id = "MelinoeField_3951"
      InheritFrom = "BaseNarrative"
      DisplayName = "你确实认识朵拉，不是么？她和你的某个弟弟……他们{#Emph}结过婚？{#Prev}而这件事又成为了她把各种邪魔释放到凡间的导火索？"
    }
    {
      Id = "Prometheus_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是故事的一种版本，差不多吧……所以她终于回想起来了？或许她现在悔不当初。过了这么久，对于世间的苦难是该怪他们自己还是怪众神这个问题，凡人还是莫衷一是……"
    }
    {
      Id = "MelinoeField_3952"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你觉得他们应该只怪{#Emph}众神{#Prev}么？对于他们自己的落魄，自己概不负责？就连朵拉都不会这么认为，而她是我认识的最随遇而安的存在了！"
    }
    {
      Id = "Prometheus_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的伙伴朵拉记起了过往的一些事，但这并不意味着她理解这些事的意义。她的行动让凡人始终会与自己为敌，永生永世不得超脱！"
    }
    {
      Id = "MelinoeField_3953"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉的丈夫后来怎么样了？按照朵拉的回忆，他是你的弟弟。在那件事发生之后，他就把朵拉抛弃了吗？"
    }
    {
      Id = "Prometheus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "更为准确的说法是，你的伙伴朵拉终于看清了他的真实面目——心神散漫，蠢笨无比。和许多凡人一样，他们的婚姻没有持续多久。"
    }
    {
      Id = "MelinoeField_3954"
      InheritFrom = "BaseNarrative"
      DisplayName = "而你当时袖手旁观、毫无作为，现在却心生悔意，决定扛起正义的大旗？或许是在追求某种从未在她那里得到过的救赎感吧。"
    }
    {
      Id = "Prometheus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的言辞犀利，但总体算得上中肯。朵拉现在知道你的家族曾对她做出了什么。如果她这样都还能原谅你们……那她的心灵比我更加强大。"
    }
    {
      Id = "Prometheus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "看看我们吧，变革的使者！你的伙伴朵拉无意间释放出的邪魔……凡人可能承受的{#Emph}种种病害{#Prev}……其中许多种就连众神也未能幸免。"
    }
    {
      Id = "MelinoeField_3955"
      InheritFrom = "BaseNarrative"
      DisplayName = "存在于世间，总要面对各种困难。这些邪魔之中有许多我都很熟悉，他们确实是麻烦，但他们的力量也有限度，而且并非不能克服。"
    }
    {
      Id = "Prometheus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许……但凡人克服起来往往比你要困难得多。你不明白么？只要他们还在受苦，我们便也在劫难逃。"
    }
    {
      Id = "MelinoeField_2731"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你所谓的主人克洛诺斯，其实想要看到你失败……想看到你遭受比从前还要痛苦的折磨。毕竟，他是要向推翻他的众神复仇——而他被推翻时，你是众神的盟友！"
    }
    {
      Id = "Prometheus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有寻求我主人的原谅，也没有默认他与我是一条心。联盟源自共同的目标，又或许是理念；而众神的理念与我背道而驰。"
    }
    {
      Id = "MelinoeField_2732"
      InheritFrom = "BaseNarrative"
      DisplayName = "就因为他们对你的明知故犯做出了惩罚？在你犯下欺瞒和偷盗的罪行之后，难道他们还有选择的余地么？"
    }
    {
      Id = "Prometheus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从未{#Emph}偷盗{#Prev}！火焰会自然蔓延，会将沿途的一切烧成灰烬。众神意欲将其囚禁，而我则将其解放。现在，火焰终于自由了，而我亦是如此——燃烧着熊熊战意。"
    }
    {
      Id = "Prometheus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是个泰坦，而且手无寸铁。但是，如果你闯过了我这关……我知道你面对前面的挑战毫无胜算。"
    }
    {
      Id = "MelinoeField_2969"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许你知道的不如你想得那么多。我猜接下来你要用“傲慢”之类的词来批评我了，对吧？"
    }
    {
      Id = "Prometheus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来正有此意，但既然你预见到了那个未来，那它便不会发生。好了，如果你真的认为你能敌过那个魔物的话……那就先来试试你能不能敌得过{#Emph}我{#Prev}吧。"
    }
    {
      Id = "Prometheus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要知道，那个名为提丰的魔物不会善罢甘休。他让你的家族节节败退，躲进了你叔父的宫殿之中。正合我军之意。"
    }
    {
      Id = "MelinoeField_2970"
      InheritFrom = "BaseNarrative"
      DisplayName = "有他们分散他的注意力，我就可以趁虚而入……只要我先把挡在面前的你，还有你那只鸟解决掉。"
    }
    {
      Id = "Prometheus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "你把计划都告诉我了！现在我们真的越来越了解彼此了。接下来要发生的事，简直令我痛心啊。"
    }
    {
      Id = "Prometheus_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "你听到了吗？哪怕是在现在，提丰也在这座山的暗面攀爬。你之前能将他击落山崖，确实厉害……但他不会休息，直到宙斯宫殿被夷为平地。"
    }
    {
      Id = "MelinoeField_3781"
      InheritFrom = "BaseNarrative"
      DisplayName = "他会被消灭的。你也一样，如果别无他法的话。倘若他真的无法被阻止，你就不会前来阻拦我的攀登了。你只是在为他争取时间。"
    }
    {
      Id = "Prometheus_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实。想来也怪，对于你我这样不死不灭的存在，时间居然仍会有其限度。但现在，不能再耽误时间了。"
    }
    {
      Id = "Prometheus_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许是你的神明亲戚齐心协力，虽然你失手了，但是他们最终仍然抵挡住了提丰的怒火。然而现在，你又一次匆匆赶来。"
    }
    {
      Id = "MelinoeField_3782"
      InheritFrom = "BaseNarrative"
      DisplayName = "我意识到这对你来说一定很复杂，毕竟你的忠心基本上都花在了那只老鹰身上，但我不会让那个魔物将我家族所建造的一切毁于一旦。"
    }
    {
      Id = "Prometheus_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该更谨慎地选择效忠的对象，而不是让你的身世决定一切。好吧，那就放马过来吧！你还有一座山峰和一家亲戚要保护呢。"
    }
    {
      Id = "Prometheus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "“伟大的宙斯”将我禁锢、折磨，可不是因为从神山盗取圣火这件莫须有的罪名。不，他想要的是信息……他想知道他最终将如何陨落。"
    }
    {
      Id = "MelinoeField_2736"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你用虚假的预言威胁了奥林匹斯之王，因此招来了他的愤恨。也许不是我叔父最骄傲的时刻，但我能理解他这样做的原因。你告诉了他什么？"
    }
    {
      Id = "Prometheus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "我{#Emph}什么{#Prev}也没告诉他！我只是说，他的统治终有结束之时。随着每一夜的流逝，这样的结局的可能性愈来愈高。你不过是这计划中生出的枝节，仅此而已。"
    }
    {
      Id = "Prometheus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这座该死的山峰上，你所有的亲戚之中，最值得尊敬的对手非雅典娜女士莫属。吾主的大军一定让她无暇他顾，只能将一部分力量交付与你，代她出战。"
    }
    {
      Id = "MelinoeField_3780"
      InheritFrom = "BaseNarrative"
      DisplayName = "你将她称作对手，却不肯与她正面交战，只是用杂兵拖住她。你知道跟她光明正大对决的话，你是没有胜算的。"
    }
    {
      Id = "Prometheus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实如此。我缺少她的战斗训练，以及她的神性。然而，虽然她的智慧广为人知，但是她和你的其他亲戚一样——用凡人的话说，有着“致命缺陷”。而你知道我说的是什么。"
    }
    {
      Id = "MelinoeField_2893"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神——至少是众神中的一位——想要与你和平共处，普罗米修斯！迪奥尼索司大人想邀请你，作为他最新举办的宴会的荣誉嘉宾。你拥有先见的天赋，因此一定知道我所言非虚。"
    }
    {
      Id = "Prometheus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的先见看不到毫无可能出现的情况。无论你想设下什么骗局，仅凭{#Emph}这样{#Prev}的伎俩是无法让我上当的。"
    }
    {
      Id = "MelinoeField_2894"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和你的主人不一样；难道你也看不出来，众神的思想并不尽然相同么？迪奥尼索司对你们之间的纷争不感兴趣！"
    }
    {
      Id = "Prometheus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "迪奥尼索司感兴趣的，只有借助酒精，浇灭他为数不多的复杂想法，追求简单纯粹的肉体享受。如此没有自制力，与其说是神明，还不如说是野兽。"
    }
    {
      Id = "MelinoeField_2895"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有接受迪奥尼索司大人的邀请，让他相当失望！你在未来真的没有回心转意的可能吗？"
    }
    {
      Id = "Prometheus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}绝对没有！{#Prev}千万年来，我的肝脏早已被好艾托斯啃食得千疮百孔；我是不会容许酒神进一步伤害我的肝脏的！"
    }
    {
      Id = "Prometheus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得众神的记号，但你身上的有所不同。更加古老的存在……卡俄斯的印记。最为古老，最为淡漠的力量，居然受到教唆，采取了行动！"
    }
    {
      Id = "MelinoeField_2889"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连卡俄斯都不希望看到克洛诺斯胜利，然而你却选择了与克洛诺斯为伍。好好想想这说明了什么吧！"
    }
    {
      Id = "Prometheus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "这说明所有的存在都可能犯错，就连卡俄斯也不意外。我们{#Emph}全都是{#Prev}粗制滥造的意外，你看不出来么？但我们仍然努力追求完美，而完美可望不可即。"
    }
    {
      Id = "Prometheus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "你与巫术师合作，想要藉此占据上风……但这样的把戏不会对我奏效。对手的体型是无关紧要的变数罢了。"
    }
    {
      Id = "MelinoeField_2892"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能认出喀耳刻女士的巫术，却还是低估了它的效力。看来你的先见并非无所不能啊，泰坦。"
    }
    {
      Id = "Prometheus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确。但你们的巫术也同样并非无所不能。我劝你最好不要过于依赖它们。"
    }
    {
      Id = "Prometheus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "未来是一系列固定的点。就连吾主也不相信这个事实，但我已经亲眼见过了各种可能。唯一的问题是……哪一个点，才是我们的终点？"
    }
    {
      Id = "MelinoeField_2734"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在用这些胡言乱语荼毒我的心灵。就连命运三女神也无法彻底确定未来将要发生的事情，因为她们一直在继续编织。"
    }
    {
      Id = "Prometheus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们{#Emph}曾经{#Prev}一直在编织，是的。我知道你已经知道，她们已经不再编织了。但每分每秒，未来仍会在我们面前成为现实。让我们亲手塑造自己的未来吧！"
    }
    {
      Id = "Prometheus_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的化身，依你看，她们在哪？命运三女神。很久很久以前，让泰坦与众神大动干戈的幕后主使。"
    }
    {
      Id = "MelinoeField_3964"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论她们在哪，你最好祈祷她们没听到你说她们坏话。不过，为什么问我？你才是那个无所不知的人，就连她们究竟会不会被找到，你也应该心知肚明吧。"
    }
    {
      Id = "Prometheus_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "的确如此。我只是借这番对话暗示你这种可能性，以及你在她们密谋中的位置；或许，还有你在我密谋中的位置。"
    }
    {
      Id = "Prometheus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有一个哥哥，但你与他素未谋面。我有三个兄弟，一个傲慢，一个愚钝，还有一个可怜虫肩上扛着整个世界。你觉得{#Emph}你的{#Prev}哥哥和哪个最为相像？"
    }
    {
      Id = "MelinoeField_2885"
      InheritFrom = "BaseNarrative"
      DisplayName = "怪不得你恨我的家人，你连自己的家人都恨。我们是不是该快点杀个你死我活？我不打算在这待一整晚。"
    }
    {
      Id = "Prometheus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "我和我的兄弟以前也常常争吵。我原本以为我已经有所成长，变得更加文明了。但事实证明并非如此。"
    }
    {
      Id = "Prometheus_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "你自己也有一只飞鸟作为伙伴。一只瘦弱苍白的渡鸦，翼展中等，和艾托斯相比，在猎杀本能上有所欠缺。但仍然是只忠诚的鸟儿。"
    }
    {
      Id = "MelinoeField_3982"
      InheritFrom = "BaseNarrative"
      DisplayName = "拉奇可从来没有想过要把我的肝脏啄出来。用那种方式和动物建立纽带实在是太低效了，不过事到如今，你肯定也已经知道了。"
    }
    {
      Id = "Prometheus_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我与艾托斯初次相遇时，我没有任何与它交涉的资本。但现在它愿意听命于我，至少大多数时候如此……不过，当他锁定猎物的时候，便会变得{#Emph}心无旁骛{#Prev}。"
    }
    {
      Id = "Prometheus_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "你身上带着的一件器物，曾属于我的某位旧识，我能够感应得到。它是怎么落到你手中的……？啊，无需多言，想必只不过是奥林匹斯山互换礼物的传统而已。"
    }
    {
      Id = "MelinoeField_3980"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}互换礼物的传统？{#Prev}那你指的一定是赫拉克勒斯送我的这颗狮牙了。怎么，你本来以为宙斯之子会把他那来之不易的狩猎纪念品送给你这样的人么？"
    }
    {
      Id = "Prometheus_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的固执和野蛮都好不逊色于曾经长着这颗牙齿的野兽。但就算如此，你也配不上它。"
    }
    {
      Id = "MelinoeField_3981"
      InheritFrom = "BaseNarrative"
      DisplayName = "你指的一定是你的朋友赫拉克勒斯送我的这颗狮牙了。怎么，你本来以为宙斯之子会把他那来之不易的狩猎纪念品送给{#Emph}你{#Prev}么？"
    }
    {
      Id = "Prometheus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近没怎么见到你……想必你是去了冥界惹是生非。除非你是力不从心，越来越难以登临这里了？"
    }
    {
      Id = "MelinoeField_3974"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不是先见泰坦吗，怎么不自己说出答案呢？这可是证明你的天赋并非自吹自擂的大好机会啊。"
    }
    {
      Id = "Prometheus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "我早就料到你会这么说，所以我现在可以借此机会向你说明，先见与读心并不能画上等号。"
    }
    {
      Id = "Prometheus_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从你上次抵达这里之后，有什么东西悄然发生了变化。我知道那是什么……也知道当你最终对其加以利用时会发生什么；说不定就是今夜。"
    }
    {
      Id = "MelinoeField_3956"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定指的是魔物解离咒。没错，我为提丰准备了件礼物。没有先在你身上试试，你就庆幸去吧。"
    }
    {
      Id = "Prometheus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "收起你的威胁吧！我知道你不会将这样的力量用在我身上；倘若众神和泰坦能够把对方像凡人一样置于死地，我们的历史早就画上句号了。"
    }
    {
      Id = "Prometheus_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "吾主还没有意识到，等到一切尘埃落定，他会变成什么样子。你呢，你知道么？试图盗走他人不死不灭的特质，多么令人恐怖的想法。"
    }
    {
      Id = "MelinoeField_3983"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是叫人大开眼界。你身为一个盗贼，还有脸说我盗走别人的东西！克洛诺斯夺走了我的家人，而且他的罪行远不止于此……他应该知道，自己会落得什么样的下场。"
    }
    {
      Id = "Prometheus_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是你父亲的父亲……你身上流淌着他古老的血脉，也和他一样痴迷于无可避免的宿命。那就来吧，向着你的心之所欲进发吧！但这条路走下去，只会有唯一的结局。"
    }
    {
      Id = "Prometheus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，变革的使者……魔物提丰已经被消灭，吾主也显然已经改头换面；又或者说，他是{#Emph}做回了自己{#Prev}。有许多人会说他们知道你会成功，但真正能这样说的， 只有我一个。然而你和我都明白，我们之间的恩怨仍未了结。"
    }
    {
      Id = "MelinoeField_3957"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯已经投降，但你仍然在这里，对他的残兵败将发号施令。看来是你贼心不死，想要自己接管大局，是么？"
    }
    {
      Id = "Prometheus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从我任凭你的叔父将我锁在山上时，便已经下定了这一决心。不错，我仍然是你的敌人。无论你在这之后要寻找什么，都必须先经过战火的洗礼！"
    }
    {
      Id = "MelinoeField_3958"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦，众神难道对你的这种行径，甘愿忍气吞声么？破坏奥林匹斯山……攻击他们的防线……乃至与我在这里交手？"
    }
    {
      Id = "Prometheus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的主人，又或许现在应该说是我的{#Emph}前主人{#Prev}，想要弥补他犯下的某些所谓的罪行，想必你对此已经了然。我只不过在这之中需要尽自己的一份力而已。"
    }
    {
      Id = "MelinoeField_3959"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么说来，你是准备好永远与我在这里战斗了？为了让我的祖父消除过往所犯下的错误，也为了让众神享有安然无恙的未来？"
    }
    {
      Id = "Prometheus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "我准备好永远为我的信念战斗，以确保{#Emph}时间自由向前流淌{#Prev}，如果这就是必需的代价的话。"
    }
    {
      Id = "MelinoeField_3961"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争已经结束了，泰坦！别再装了。你仍然管克洛诺斯叫做主人，而且对众神的态度看起来也没有好转，但我知道你现在做的事情不仅仅是为了自己，也是为了他们。"
    }
    {
      Id = "Prometheus_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你也该知道，你若要取得成功，攀登路线上的遭遇要与之前大致相仿。而我也得承认，若非如此，我所追求的结果便不会有可能发生。所以，我们注定会在这里交手。"
    }
    {
      Id = "MelinoeField_3962"
      InheritFrom = "BaseNarrative"
      DisplayName = "你所追求的结果，里面不会包括了被我反复地暴打吧？也许在那副救世主的伪装之下，你真正想要的只不过是被我好好揍一顿。"
    }
    {
      Id = "Prometheus_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对痛苦有着格外高的忍耐力。不过对你这样的嘲讽，就不一定了。劝你不要忘记，{#Emph}谁被谁{#Prev}好好揍一顿还说不定呢。"
    }
    {
      Id = "Prometheus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "吾主令你跨越此境之界，像过去一样直面魔物提丰，这件事的结局我无法预见……上一次你的战果如何？"
    }
    {
      Id = "MelinoeField_3960"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许我该留给你自己想象。无法预料这种事情的结果，对你来说一定很新奇吧。"
    }
    {
      Id = "Prometheus_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，的确。既然如此，那就不要告诉我了；我真正在意的是最终的结果，至于过程如何，与之相比无足轻重。"
    }
    {
      Id = "Prometheus_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "据吾主所言，你的功绩与夜俱增。他就在前面等着你，倘若你能再次战胜我的话。"
    }
    {
      Id = "MelinoeField_3963"
      InheritFrom = "BaseNarrative"
      DisplayName = "先是你，然后是提丰，就和以前一样。不过知道我有达到祖父的期望，让我很开心。就是不知道需要取悦的家族成员会不会太多了点。"
    }
    {
      Id = "Prometheus_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "对此我深表同情。无论如何，只要我们的道路有所交汇，我便会在这里等你；无需提前让我知晓你的到来。"
    }
    {
      Id = "Prometheus_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "结束了……！终于结束了，只不过……我需要听你亲口说出。确保我的预见准确无误。请告诉我……"
    }
    {
      Id = "MelinoeField_3965"
      InheritFrom = "BaseNarrative"
      DisplayName = "你可能得说得更具体点，但是……我猜你是指我找到了命运三女神的事？或者说命运三女神找到了我，反正没什么区别。我还以为你不怎么在乎她们呢。"
    }
    {
      Id = "Prometheus_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在乎她们的言语……在乎她们决定如何对待我们这个世界。在流放之中，她们做出了什么样的决定？想必她们不会再犯同样的错误。"
    }
    {
      Id = "MelinoeField_3966"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们受够了我们的争吵，这点我完全可以理解。所以她们决定，一个新的纪元将会到来，到那时，据说众神不会再拥有这么大的话语权。我们会卸下背负的许多责任，这样一来，也就能放下令人面红耳赤的争端。"
    }
    {
      Id = "Prometheus_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "……一个黄金时代的来临……也许与吾主的设想有所出入，但仍是如此。历尽磨难，终成正果……而在那之前……我想我们应该继续战斗。"
    }
    {
      Id = "MelinoeField_3967"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你真的预见了这一切？我指的是命运三女神，以及她们对新时代的预言。那你为什么要那么拼命地阻止我？万一你真的得逞了，又要怎么办？"
    }
    {
      Id = "Prometheus_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道我对你一切的阻拦都只会是徒劳，但我仍然不得不这样做。简而言之，要通往那样的未来，我看不到任何其他道路。"
    }
    {
      Id = "MelinoeField_3968"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们说不定本来可以并肩作战。显然，比起派艾托斯来啄我，那样做肯定会更快导向你想要的结果。"
    }
    {
      Id = "Prometheus_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "合乎情理的假说，但那样的话，事情决不会向你所期待的方向发展。对你来说，这从来都与凡人的苦难无关。"
    }
    {
      Id = "MelinoeField_3969"
      InheritFrom = "BaseNarrative"
      DisplayName = "……你说得对。在试图帮凡人解决他们的问题之前，我有自己的问题要解决。"
    }
    {
      Id = "Prometheus_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "但现在，你可谓一举两得。放心，虽然亡者崇拜你，但生者对你毫不关心。不过，我们仍然做了该做的事。"
    }
    {
      Id = "MelinoeField_3970"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你的战友，赫拉克勒斯呢？他应当也是你密谋中的一部分吧。表面上看他在和你一起反抗众神，实则暗中还是在为他们效力。"
    }
    {
      Id = "Prometheus_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "想从我这里知道答案，不会比直接问他来得更容易。你见过他；他行事从来都有自己的理由。"
    }
    {
      Id = "MelinoeField_3971"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你们才串通在一起吗？你们都对这座山，以及它所象征的一切不屑一顾；一定是这点让你们觉得志同道合。是他把你救出来的吗？"
    }
    {
      Id = "Prometheus_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "我说了，{#Emph}别想从我这里知道答案{#Prev}。关于{#Emph}他{#Prev}的事，一概不行。但至少你现在知道了，在你家族的后裔中，还有像他这样性情刚直的人。"
    }
    {
      Id = "MelinoeField_3973"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然你对即将来临的时代无所不知……有什么有趣的细节想分享一下，让我可以有所期待吗？"
    }
    {
      Id = "Prometheus_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "整个世界将以你完全无法设想的方式变革，变成一个与之前完全不同的地方。而从其他方面来说，一切又都没有改变，甚至还会有所倒退。我们都将会被遗忘，然后再被忆起，再被遗忘，如此反复，周而复始……"
    }
    {
      Id = "Prometheus_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "在如此晦暗的夜晚，这种呛人的黑雾……在我体内唤起了更为古老的力量；我原本以为那份力量已经失落。现在却只觉得生龙活虎……！"
    }
    {
      Id = "MelinoeField_3978"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴听到你活出了新高度，泰坦。一个恐怖的夜晚，显然可以激发出更敏锐的感官，以及更强烈的求生意志。"
    }
    {
      Id = "Prometheus_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说得仿佛你是这恐怖的来源；这不可能。或者，准确来说，可能性微乎其微，但是……啊，你们这些黑暗的神明。那就来吧，看看这一夜究竟属于你还是我！"
    }
    {
      Id = "Prometheus_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "你今夜是专程为我而来，不是么？或许是某种野蛮的任务吧，来自更加古老、更加强大的黑暗神明。那就来吧。"
    }
    {
      Id = "MelinoeField_3975"
      InheritFrom = "BaseNarrative"
      DisplayName = "你又是怎么知道的？我从来没有说起过这些事情，泰坦。以后也绝不会说。"
    }
    {
      Id = "Prometheus_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜你确实不会，但之后的某个夜晚，你会忘记我们进行过这次对话，然后告诉我更多。至于现在，为了你们这种人所谓的荣誉，来与我决一死战吧。"
    }
    {
      Id = "MelinoeField_3976"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不是我的目标，泰坦。所以我们不如速战速决吧？免得你阻碍了黑夜的意志。"
    }
    {
      Id = "Prometheus_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "黑夜的意志……要求将提丰作为祭品。这就是你夜复一夜登上这座山的目的么？"
    }
    {
      Id = "MelinoeField_3977"
      InheritFrom = "BaseNarrative"
      DisplayName = "要作为祭品的不仅仅是提丰。所有冥界的敌人都会得到惩戒。就连你也不例外，如果你还敢继续这样下去的话。"
    }
    {
      Id = "Prometheus_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "来自神明的惩戒，我早就不陌生了。当时我没有因此停下，现在也不会。永远都不会！"
    }
    {
      Id = "Prometheus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来我们之后一段时间里，可能都会在这样的僵持中争战不休。显然，这是你所做所为的结果。"
    }
    {
      Id = "MelinoeField_3984"
      InheritFrom = "BaseNarrative"
      DisplayName = "我救回了我的家人。如果代价是时不时就要被{#Emph}你{#Prev}教训一顿，那我完全不介意。"
    }
    {
      Id = "Prometheus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "我并非此意。事实上，知道我们这样的会面将会成为常态，也许你我之间已无需再多言。自此往后，我将不会说得太多。"
    }
    {
      Id = "Prometheus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不会死，但你可以被击退。先让你尝尝火焰的滋味。"
    }
    {
      Id = "Prometheus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道我们每次交手的结果，但不知为何，你仍然能给我带来惊喜。"
    }
    {
      Id = "Prometheus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的力量再也无法重回巅峰，但应付你还是绰绰有余。"
    }
    {
      Id = "Prometheus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "艾托斯仍然对肝脏的味道念念不忘，我们又有什么理由不满足他的愿望？"
    }
    {
      Id = "Prometheus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者去而复返，历史的轨迹就此改写。"
    }
    {
      Id = "Prometheus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪怕你在此拼尽全力，众神的时代也迟早会迎来终结。"
    }
    {
      Id = "Prometheus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神为了惩罚我莫须有的罪名对我做出的种种，仍然让我无法忘怀。"
    }
    {
      Id = "Prometheus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "你们这些爱慕虚荣的众神想要信徒；我们泰坦则只想要拿回属于我们的东西。"
    }
    {
      Id = "Prometheus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "我忍受了肝脏被啄食千万年的痛苦，和你的小打小闹不算什么。"
    }
    {
      Id = "Prometheus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "当初赠予人类的火种，我特地为你留了一些。"
    }
    {
      Id = "Prometheus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看到了么？我每拖慢你一刻，时间的计划就更进一步。"
    }
    {
      Id = "Prometheus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能否再次将我击倒，我早已心中有数，但答案还要你亲自揭晓。"
    }
    {
      Id = "Prometheus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我见过你的每一招、每一式，你所能做到的一切！而今夜的你还差些火候。"
    }
    {
      Id = "Prometheus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "这座山不会由我来攻克，也不会由你来拯救。"
    }
    {
      Id = "Prometheus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对这个世界一无所知，但却要捍卫它；而我见过这世界的所有，因而只把它付之一炬。"
    }
    {
      Id = "Prometheus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对家族毫无亏欠，却要为他们付出一切。你们全都一样，无可救药。"
    }
    {
      Id = "Prometheus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的冲突终有结束之时，但不必对此抱什么期待。"
    }
    {
      Id = "Prometheus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "众神与泰坦彼此的所作所为永远不会被原谅……最多只会被遗忘。"
    }
    {
      Id = "Prometheus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "我体内流淌的火焰，使我五内俱焚……我要让你尝尝这滋味。"
    }
    {
      Id = "Prometheus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若真如奥林匹斯众神所言，我已经犯下了十恶不赦的罪行，那今天之事便已然无足轻重。"
    }
    {
      Id = "Prometheus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "我再也不会被锁链束缚；这既是我的誓言，亦是我的预见。"
    }
    {
      Id = "Prometheus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "事到如今，你应该已经有些先见之明了，不是么？你知道这场决斗将会如何结束。"
    }
    {
      Id = "Prometheus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "你响应了众神的召唤，我则有义务阻拦你。"
    }
    {
      Id = "Prometheus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "我无意告知你这一切的结局……因为说了你也不会相信。"
    }
    {
      Id = "Prometheus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没有武器可以将你击退……除非你算上我手中的烈焰。"
    }
    {
      Id = "Prometheus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "你让赫拉克勒斯等了好久，只为了将他那根巨槌派上用武之地。"
    }
    {
      Id = "Prometheus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯的怒火是我们，不是你；而且我们永远不会退却。"
    }
    {
      Id = "Prometheus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫拉克勒斯注定要为众神效力，而你也是一样。然而{#Emph}这{#Prev}就是你们的下场。"
    }
    {
      Id = "Prometheus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "你无法击垮我们，变革的使者；但也许你可以再次闯过我们的把守。"
    }
    {
      Id = "Prometheus_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对这一刻有种精确的预感。"
    }
    {
      Id = "Prometheus_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道这场对决会有什么样的结果。一起来揭晓吧！"
    }
    {
      Id = "Prometheus_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于即将发生的事，我几乎要感到遗憾了。"
    }
    {
      Id = "Prometheus_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，看看这个夜晚究竟是属于你，还是属于我！"
    }
    {
      Id = "Prometheus_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "你我之间，已无需再多言。"
    }
    {
      Id = "Prometheus_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有冲突，何来变革。"
    }
    {
      Id = "Prometheus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来我现在将再次向众神赎罪，尽管他们永远也无法束缚我。"
    }
    {
      Id = "Heracles_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "你夜复一夜在这里现身，妹子。你在享受这一切么？"
    }
    {
      Id = "Heracles_0690"
      InheritFrom = "BaseNarrative"
      DisplayName = "你今夜来得很快啊，不是么，女巫。有什么黑暗的神明在助你攀登么？"
    }
    {
      Id = "Heracles_0691"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么快就到了。有什么怪事在发生……但我现在无心细想。"
    }
    {
      Id = "Heracles_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们究竟是并肩作战，还是彼此为敌，并不重要；重要的唯有战斗本身。"
    }
    {
      Id = "Heracles_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "即将来临的杀戮，对我们两个来说都远超所需。"
    }
    {
      Id = "Heracles_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "回家吧，女巫。你敌不过我的巨槌。"
    }
    {
      Id = "Heracles_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里对你来说不会太冷么，妹子？还是说你和我一样，能在战斗中感受到温暖？"
    }
    {
      Id = "Heracles_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "感觉到这里更难呼吸了么，妹子？仿佛这座山受了诅咒一般。"
    }
    {
      Id = "Heracles_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "继续任由奥林匹斯山使唤，早晚你也会落得和我一样的下场。"
    }
    {
      Id = "Heracles_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要么是好兆头，要么是坏兆头，我还没拿定主意。"
    }
    {
      Id = "Prometheus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔呃……我就知道会这样。但我无法阻止这一切，你看不出来么？我只能……尽我自己的……一份力……"
    }
    {
      Id = "MelinoeField_2383"
      InheritFrom = "BaseNarrative"
      DisplayName = "住口。我劝你还是省省口舌，直接回去禀告你的主子吧。"
    }
    {
      Id = "Prometheus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "变革的使者啊……你不理解……我的一片苦心……"
    }
    {
      Id = "Prometheus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我尽了我该尽的义务，你也一样……因为这一幕注定会发生。"
    }
    {
      Id = "Prometheus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "……若不是这些旧伤……我岂会如此孱弱……！"
    }
    {
      Id = "Prometheus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我早就料到这会是场苦战……我只是希望自己预料出错……"
    }
    {
      Id = "Prometheus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我败了。但你无暇追击，而我终会恢复如初。"
    }
    {
      Id = "Prometheus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "……奥林匹斯那举世皆知的怒火……一旦燃起，再难熄灭，你明白了么？"
    }
    {
