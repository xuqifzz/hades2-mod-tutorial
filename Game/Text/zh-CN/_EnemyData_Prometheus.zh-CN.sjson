    }
    {
      Id = "Prometheus_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "什么也……不会改变……"
    }
    {
      Id = "Prometheus_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵……呵呵呵……唔呃……"
    }
    {
      Id = "Prometheus_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我早该……料到的……"
    }
    {
      Id = "Prometheus_0265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "更苦的……我也受过……唔呃……"
    }
    {
      Id = "Prometheus_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "无关……紧要……"
    }
    {
      Id = "Prometheus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我做了我……该做的事……"
    }
    {
      Id = "Prometheus_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一切都按……计划进行……"
    }
    {
      Id = "Prometheus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我恨你们……你们众神……"
    }
    {
      Id = "Prometheus_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "难道我真的……什么都做不了么……？"
    }
    {
      Id = "Prometheus_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我早就料到……事情会这样发生……只是……"
    }
    {
      Id = "Prometheus_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……后会有期……！"
    }
    {
      Id = "Prometheus_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我早晚会和你们众神算账……！"
    }
    {
      Id = "Prometheus_0255"
      InheritFrom = "BaseSubtitle"
