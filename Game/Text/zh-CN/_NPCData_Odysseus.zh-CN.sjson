  Texts = [
    {
      Id = "Melinoe_1707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "克洛诺斯必死无疑，先生。"
    }
    {
      Id = "Odysseus_0214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你好啊！"
    }
    {
      Id = "Odysseus_0215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意！"
    }
    {
      Id = "Odysseus_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意，女神。"
    }
    {
      Id = "Odysseus_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你一定会干掉他的。"
    }
    {
      Id = "Odysseus_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他会付出代价的。"
    }
    {
      Id = "Odysseus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，我也希望。"
    }
    {
      Id = "Odysseus_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也向你致意。"
    }
    {
      Id = "Odysseus_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿暗影遮蔽你。"
    }
    {
      Id = "Odysseus_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也一样。"
    }
    {
      Id = "Odysseus_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿你取得胜利。"
    }
    {
      Id = "Odysseus_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们会找到破局之法的。"
    }
    {
      Id = "Odysseus_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Odysseus_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一定能攻克难关。"
    }
    {
      Id = "Odysseus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "干掉那个混账了吗？一杖砸碎他的脑壳，一刀刺穿他的内脏？啊，不是说他这么轻易就能被杀死啦。不过这些手段对凡人倒是很管用！"
    }
    {
      Id = "Melinoe_0016_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，时间泰坦克洛诺斯已经被我一举消灭了。我把他的头提回来了！……要是真的就好了。"
    }
    {
      Id = "Odysseus_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没事，下次你肯定能拿下他的。"
    }
    {
      Id = "Odysseus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神啊，你这场旅程山高路远，咱们的女巫大人是知道的。你听说过地表的“山”吧？就是那种又高又大的石头块儿？"
    }
    {
      Id = "Melinoe_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你是说像奥林匹斯山、俄特律斯山之类的山脉？我当然听说过了！据说它们能直入云霄……真是难以想象。"
    }
    {
      Id = "Odysseus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "从山脚向上看时，你会觉得山顶遥不可及……{#Emph}但是！{#Prev}只要你一步一个脚印地向前走……就总有一天能登上顶峰。"
    }
    {
      Id = "Melinoe_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "登上顶峰……"
    }
    {
      Id = "Odysseus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近面对的那些带刺的家伙……我接到的每一份报告里，它们的数目都有所增多。不知道有没有什么我们可以准备的应对措施，能帮助你更好地解决它们……"
    }
    {
      Id = "Melinoe_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "等我有具体的想法会跟你说的，奥德修斯。现在我还没想清楚。"
    }
    {
      Id = "Odysseus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，没错，在想清楚之前，还是不要信口雌黄的好。我太清楚“祸从口出”的意思了。不过，等你想到了什么，就随时跟我说哦？"
    }
    {
      Id = "Melinoe_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会的。"
    }
    {
      Id = "Odysseus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在外面遇到任何棘手的东西，都记得要来跟我谈一谈哦。说不定我之前跟它们照过面，交过手，或者用计谋解决过它们，可以给你提供一些建议。"
    }
    {
      Id = "Melinoe_0450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白。"
    }
    {
      Id = "Odysseus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "面对外面那些家伙一定要保持警惕，好么？如果哪个家伙给你带来很大的麻烦的话，就努力寻找它的弱点，然后避实击虚。"
    }
    {
      Id = "Melinoe_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我一定会的。"
    }
    {
      Id = "Melinoe_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "你认识我老师很久了，对吧？我一直好奇，你们是怎么样认识的？"
    }
    {
      Id = "Odysseus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊哈，这个嘛。我只能说我当时……孤身一人。一条生命之路走到尽头，另一条生命之路将要开始；不知何去何从。就在这时，她出现在我面前，神采奕奕，然后……她向我揭示了另一条路，一条我从未见过的路。"
    }
    {
      Id = "Melinoe_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些听起来都很抽象。你当时已经死了么？"
    }
    {
      Id = "Odysseus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。她告诉我她可以赐予我新的生命。她需要一个熟悉地表的人为她出谋划策。我一想，我有什么资格拒绝一位女神的邀请呢？于是便加入了她的麾下。这已经是好一段时间之前的事了。"
    }
    {
      Id = "Melinoe_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是得有段时间了。"
    }
    {
      Id = "Odysseus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "咱们的女巫大人总是在外面对你进行考验，是吗？我一直都觉得，她的授课理念确实有些激进。她对你的期望很高，但要知道这是因为你潜力十足。"
    }
    {
      Id = "Melinoe_2185"
      InheritFrom = "BaseNarrative"
      DisplayName = "那她一定对我现在的表现很失望，尽管她一直在忍耐，没有表现出来。你也一样吧，奥德修斯。"
    }
    {
      Id = "Odysseus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "别这样想。我知道，规划好了路线，却在中途迷失方向，是件无比令人沮丧的事。但说真的，世事无常，很少有人总能一帆风顺地抵达目的地。"
    }
    {
      Id = "Melinoe_2186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "只要能抵达目的地，再苦再累也没什么。"
    }
    {
      Id = "Odysseus_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听说你和女神阿尔忒弥斯在外面联手作战，打得敌人节节败退。你们一起唱歌也很好听……！所以，是奥林匹斯派她来监督我们的，是吗？"
    }
    {
      Id = "Melinoe_4102"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我想是的。但我对她有十足的信任，如果你在担心这个的话。她只会跟奥林匹斯众神透露必要的信息，好让他们对我们的合作放心。"
    }
    {
      Id = "Odysseus_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "她生性谨慎，不是么？好啦，就我个人而言，很高兴你不仅能把她当作同盟……还能把她当作朋友。"
    }
    {
      Id = "Melinoe_4103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就我个人而言也是这样。"
    }
    {
      Id = "Melinoe_3333"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你知道赫库芭和加莉跑到哪去了吗？我很想去问问老师，可是她不喜欢我为她的魔宠担忧，哪怕一点也不行。{#Emph}“她们好得很，墨利诺厄。”"
    }
    {
      Id = "Odysseus_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，确实可能不需要担忧！她们俩都在我的请求下外出侦察了，当然是得到了女巫老大首肯的啦。猎犬去了一边，虎鼬去了另一边。"
    }
    {
      Id = "Melinoe_3334"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些侦察任务好像总会持续一段时间呢。那我在外面的时候，就顺便留意一下她们吧。"
    }
    {
      Id = "Odysseus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果她们在外面遇见熟悉的面孔，一定会很开心的。"
    }
    {
      Id = "Odysseus_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "据称有人在你向下行进的道路上遇到了厄里斯……这条情报可能在她为你的旅程添麻烦{#Emph}之前{#Prev}会更有用。抱歉，女神……"
    }
    {
      Id = "Melinoe_3096"
      InheritFrom = "BaseNarrative"
      DisplayName = "她试图要阻止我，或者至少拖慢我，而且……她对我们的意图知道得实在是太多了。我们该怎么办？倪克斯的儿女本应该站在{#Emph}我们{#Prev}这边的……"
    }
    {
      Id = "Odysseus_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "她对我们的具体计划其实知之甚少。此外，真正驱使她的，主要是她的{#Emph}百无聊赖{#Prev}。你再遇上她几次，很快她就会感到无聊，去找别的事情干了。"
    }
    {
      Id = "Melinoe_3097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "大战术家拿她也没有别的办法么……？"
    }
    {
      Id = "Odysseus_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是啊，女神。"
    }
    {
      Id = "Melinoe_3335"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有抓到过厄里斯偷看我们的计划之类的吗？有她在附近，我们得格外小心才行……"
    }
    {
      Id = "Odysseus_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "她大多数时候都呆在那个角落里，女神，但我有对她严加防范，以防万一。不过，只要她一味搞破坏，没有偷听我们计划的打算……"
    }
    {
      Id = "Melinoe_3336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我们就能想办法绕过她的阻挠。"
    }
    {
      Id = "Odysseus_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Odysseus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好，你回来了。根据我的报告，厄里斯向色萨利裂谷飞了过去，仿佛要拦下克洛诺斯的舰队似的。只不过我不觉得她是去帮忙的。至少，不是去帮{#Emph}你{#Prev}。"
    }
    {
      Id = "Melinoe_3311"
      InheritFrom = "BaseNarrative"
      DisplayName = "这份报告对我没什么帮助，因为我已经亲身体会到她的厉害了。但至少我可以确认，这些报告是准确的。我们居然没办法摆脱她，真是荒谬。"
    }
    {
      Id = "Odysseus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "改变不了的，就只能接受了。抱歉没能提前向你发出预警。我们会继续调查她的动机和同党的。"
    }
    {
      Id = "Melinoe_3312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我怀疑她这两样都没有。"
    }
    {
      Id = "Odysseus_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "厄里斯总在地表给你惹麻烦，是不是……每次你离你的目标只有咫尺之遥，她就会杀出来。唔，如果这样说会让你感到安慰的话，我们对她武器的构造比她自己还要了解。她一定会经常用光弹药……"
    }
    {
      Id = "Melinoe_4213"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。有的时候她的武器还会卡膛，让她因此分心。我应该利用这些机会出击。毕竟，那里也没有多少障碍物能让我做掩护。"
    }
    {
      Id = "Odysseus_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "她想通过这点让你感到畏惧。有狮鹫坚炮在手，她在远距离作战要危险得多。也许你可以多从侧翼发动进攻，或者凭借身手躲过她的攻击……"
    }
    {
      Id = "Melinoe_4214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "值得一试。"
    }
    {
      Id = "Odysseus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯最近的心情格外差。你知道原因的话，能告诉我吗？"
    }
    {
      Id = "Melinoe_2212"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也正要问你同样的问题呢。她想要接过我的任务，但这也不是一天两天的事了。不过，她最近似乎和老师的冲突越来越频繁了……"
    }
    {
      Id = "Odysseus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，那真是非常遗憾。要我说，我更希望“报应”降临在敌人头上，而不是跟自己人纠缠。既然你这么说，那恐怕你们之间的关系暂时没法缓和了？"
    }
    {
      Id = "Melinoe_2213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也不好说……"
    }
    {
      Id = "Odysseus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以涅墨西斯在外面表现如何？看起来自视{#Emph}甚{#Prev}高的她打算亲自出马了。没有给你带来{#Emph}太多{#Prev}麻烦吧？"
    }
    {
      Id = "Melinoe_2214"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你已经知道了？那老师一定也知道了。涅墨西斯一直都是这样的啦！她得亲自尝尝苦头，才会明白我们的任务没有她想象得那么简单。"
    }
    {
      Id = "Odysseus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，那我懂了！不过，如果她在外面过于执着于阻拦你的进展，而不是实现她自己的目标，那我们就会出手干预的。"
    }
    {
      Id = "Melinoe_2215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不会走到那一步的。"
    }
    {
      Id = "Odysseus_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在安静得要死……最开始我都不知道是哪里发生了变化，直到我意识到修普诺斯不见了。我都习惯把他当作背景音了……"
    }
    {
      Id = "Melinoe_5244"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你居然会想念他无休无止的呼噜声？三岔路口数你离他最近，所以现在他回家去了，我还以为你会是最高兴的呢。"
    }
    {
      Id = "Odysseus_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是{#Emph}为他{#Prev}高兴啦，而且变得更安静了肯定{#Emph}不是坏事{#Prev}，只不过……就算是事情在往好的方向变化，也有可能需要时间适应。"
    }
    {
      Id = "Melinoe_5245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，我也经常很想念他……"
    }
    {
      Id = "Melinoe_2218"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和瑟勒米乌斯指挥官一样，都是鼎鼎大名的航海家，对吗？你们俩在凡间生活的时候互相认识吗？"
    }
    {
      Id = "Odysseus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，“鼎鼎大名的航海家”这种称呼甚至都显得有些掉价了！据说他在海上的收获和我不相上下呢！唉，只可惜我从未亲眼目睹过他的英姿。啊，他那时一定威风得很！"
    }
    {
      Id = "Melinoe_2219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "能有你们这样的左膀右臂，是我们的幸运。"
    }
    {
      Id = "Melinoe_2209"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，你有见过修普诺斯在睡梦中动弹过吗？我知道他经历的那些事很不好受，但……"
    }
    {
      Id = "Odysseus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "好像还真没有。自从女巫老大把他救出来之后，他就一直是那副样子。甚至连他打呼噜的声音我都逐渐习惯了……"
    }
    {
      Id = "Melinoe_2210"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得他会有醒过来的一天吗？我们的每个咒语对他都没有一点效果。"
    }
    {
      Id = "Odysseus_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他毕竟是睡神本尊，对吧？"
    }
    {
      Id = "Odysseus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，{#Emph}“毁灭”{#Prev}决定要暂住在我们这里了？我跟他只有一面之缘，而且上次碰面实在不是{#Emph}特别愉快{#Prev}，所以……不介意的话，我还是保持距离好了。"
    }
    {
      Id = "Melinoe_2211"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡是倪克斯的子女，三岔路口都欢迎。不过，我觉得摩罗斯大人也想保持{#Emph}他的{#Prev}距离。"
    }
    {
      Id = "Odysseus_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我没意见！"
    }
    {
      Id = "Odysseus_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "我猜让伊卡洛斯回来的人{#Emph}非你莫属{#Prev}吧。我看他一直都是个好小伙子！之前他离开的时候，虽然我没有出言挽留，但内心里还挺不是滋味的。"
    }
    {
      Id = "Melinoe_4508"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是他自己的决定。而且我觉得，他也一直很珍视你的经验。在他活着的时候，可没有经历过像你这样的冒险。"
    }
    {
      Id = "Odysseus_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神啊，除了我，谁还会有那样的经历？不过很明显，他在外面的时候也没少长本事嘛。甚至还做了双{#Emph}翅膀{#Prev}出来！你说他会不会还有双多的？"
    }
    {
      Id = "Melinoe_4509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢，我不好说……"
    }
    {
      Id = "Odysseus_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们远赴奥林匹斯前线的暗灵并不多，只有几位勇敢的灵魂在那里。他们说你在那里遇到了雅典娜女神，她最近还好吗？"
    }
    {
      Id = "Melinoe_4185"
      InheritFrom = "BaseNarrative"
      DisplayName = "考虑到她正在凭借一己之力抵挡声势浩大的泰坦大军，她看上去相当镇定。"
    }
    {
      Id = "Odysseus_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本想请你替我向她道谢，感谢她数次救我于水火，不过……还是谨言慎行为好。"
    }
    {
      Id = "Melinoe_4186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确定不用我替你说什么吗？"
    }
    {
      Id = "Odysseus_0395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Melinoe_3313"
      InheritFrom = "BaseNarrative"
      DisplayName = "在最近的一次航行中，我在巫术师喀耳刻的小岛上找到了她本人，看起来海上的那些纷争并没有波及到她。你们两个好像对彼此还挺了解？"
    }
    {
      Id = "Odysseus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论在阳世还是阴间，我们都无法真正了解他人，只能为此不断努力，女神。不过，我确实认识喀耳刻……算是认识吧，泛泛之交。怎么突然提起这个了？"
    }
    {
      Id = "Melinoe_3314"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是提一句啦，万一你正好想让我给她捎个话什么的。我和她以后还会见面，因为她会为我在色萨利裂谷的航程提供助益。"
    }
    {
      Id = "Odysseus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，不必了。最好还是专注于你手头上的任务吧。"
    }
    {
      Id = "Melinoe_3315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "明白了。"
    }
    {
      Id = "Melinoe_3330"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，你跟喀耳刻之间发生了什么事？她提起了你，没说什么特别的，只不过……我感觉到了某种痛楚。在那里，以及在{#Emph}你{#Prev}这里。"
    }
    {
      Id = "Odysseus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "不能说完全是痛楚，女神。那时我还活在世上，在大战之后返回故乡的途中，我在喀耳刻的小岛上偶遇了她，然后……我在那里住了大约一年。她招待了我和我的船员；我和她变得愈发亲近。我从她身上学到了许多东西，而后来……后来我离开了。"
    }
    {
      Id = "Melinoe_3331"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的返乡之旅。你在那里停留了一年，然后便再次启程，再也未曾与她相见……"
    }
    {
      Id = "Odysseus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，是的，直到我在这里再次见到她。只是……这些都是过去了，而且我觉得对我和对她都是这样。不是每一段萍水相逢都需要成为永恒的感情。"
    }
    {
      Id = "Melinoe_3332"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我想，我能理解……"
    }
    {
      Id = "Odysseus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里收到了几份报告，说克洛诺斯正在地表屯军，而且他对你的动向还一无所知。至少你还没和{#Emph}他们{#Prev}正面交锋，对吧？"
    }
    {
      Id = "Melinoe_2172"
      InheritFrom = "BaseNarrative"
      DisplayName = "穿过冥界的道路也有很多挑战，不过你说的没错，知道那支叛军对我的行动浑然不知，至少能让我松一口气。"
    }
    {
      Id = "Odysseus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "向下的路线，就数那条最为隐秘了。至少，树林里的那些带刺的家伙，和克洛诺斯不是一丘之貉。"
    }
    {
      Id = "Melinoe_2173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们拦不住我。"
    }
    {
      Id = "Odysseus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，你看起来就像见鬼了一样——请原谅我用凡间这句过时的俗语，意思是你看起来相当慌乱。你还好么？"
    }
    {
      Id = "Melinoe_3304"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还好，但又不太好；我在外面见到了克洛诺斯。我还以为逃不出他的魔爪了，但我最终挣脱了他的咒语。这是在俄刻阿诺斯发生的事情，不过我也发现他有在厄瑞玻斯的边沿四处窥探。"
    }
    {
      Id = "Odysseus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "该死……我们的报告完全没有提及这些事情，不过……我们有些暗灵线人还没有回来。我们原本以为克洛诺斯会蛰伏在地底最深处闭门不出。你一定是带来了不小的影响，才招来了他的注意。"
    }
    {
      Id = "Melinoe_3305"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的行动确实谈不上隐秘。我们真的没有别的办法了吗？"
    }
    {
      Id = "Odysseus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "应该没有了。我们在赌他认为你太弱小，对他的计划无足轻重。至于我们自己，我会把这件事情上报给女巫老大的。保重，女神。以及，谢谢你的汇报。"
    }
    {
      Id = "Melinoe_3306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Odysseus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "我收到了一份令人极为担忧的报告。在厄瑞玻斯外沿的小径上，有人目击到了某个身影。我们眼线的报告属实吗？"
    }
    {
      Id = "Melinoe_2216"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果眼线见到的是克洛诺斯的话，报告真实无误。至少现在我知晓他的样貌了，但与此同时，他也知晓了{#Emph}我{#Prev}的存在。你觉得他为什么会放我离开？我们会不会要有麻烦了？"
    }
    {
      Id = "Odysseus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有我们的允许，任何人都无法来到三岔路口，甚至根本无法知道我们身在何处。就连他也做不到。既然他想四处窥探，那就随他去吧！他只不过是在浪费时间而已，而你则每个夜晚都离你的目标更近一步。"
    }
    {
      Id = "Melinoe_2217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他真的会“浪费时间”吗……？"
    }
    {
      Id = "Odysseus_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "你干掉了他，是吗？杀掉了那个混账，至少……至少让他消失了一夜。我听到第一条报告的时候，还几乎不敢相信，但是听到三四次之后，我就意识到这是真的了。{#Emph}做得好{#Prev}，女神！"
    }
    {
      Id = "Melinoe_2967"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算有报告称他已经死而复生了，我也不会太诧异。但我现在拿到了我需要的东西。以及，也算是报了点仇。"
    }
    {
      Id = "Odysseus_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，而且我预感他一定会为此羞愤难当，但我想说的是……就算我们的目的还没有真正达成，这场胜利对我们来说仍然弥足珍贵。对{#Emph}你{#Prev}来说更是如此。那么，接下来要进入下一阶段了？"
    }
    {
      Id = "Melinoe_2968"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Odysseus_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到他了，女神……你脸上的神情就足以说明一切，而且我收到的报告也证实了这点。虽然最终败下阵来，但是你也一定给他留下了深刻的印象……"
    }
    {
      Id = "Melinoe_3094"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯就在我们预想的地方……但我没办法预料到他的每招每式。何况，面对他的魔力，就算是我的防护魔法也有些招架不迭。"
    }
    {
      Id = "Odysseus_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "幸运的是，越老的家伙往往学习能力越差。你再这样和他战斗几次，很快就能对他的所有把戏了如指掌了。不过……在外面还是要多加小心，好么？"
    }
    {
      Id = "Melinoe_3095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好……"
    }
    {
      Id = "Odysseus_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的暗灵无法靠近冥府，所以他们没有办法向我汇报时间泰坦的战斗方式。恐怕女神你这次只能靠自己了……"
    }
    {
      Id = "Melinoe_4211"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我可以自己说给你听。他看起来瘦骨嶙峋的样子，但动作却很快。他的镰刀攻击范围很大，而且可以将我定在原地，虽然只能维持片刻。而且他还有卫兵守在左右，确保他能以多欺少。"
    }
    {
      Id = "Odysseus_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}把你定在原地……{#Prev}这意味着他想要阻止{#Emph}你的时间{#Prev}行进，但没办法控制你很久。这样说来，就跟女巫老大想得一样，对吧？这意味着他的能力对你效果有限；永远不会停止的不是他，而是{#Emph}你{#Prev}。"
    }
    {
      Id = "Melinoe_4212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我目前还没有这种感觉。"
    }
    {
      Id = "Odysseus_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，你在那座山顶要对付的，居然是{#Emph}提丰{#Prev}么……？我们的暗灵说，他的身躯像山一样庞大……请告诉我这只是他们在夸大其词，对吧？"
    }
    {
      Id = "Melinoe_4109"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，客观来说……根据我的估计，他至少比波吕斐摩斯大一百倍。不过我还没有机会弄清楚他到底有多少斤两。"
    }
    {
      Id = "Odysseus_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想，一定会有这样的机会的。你遇到的每个敌人，最终都败在了你的手上！虽然我们的暗灵和女巫老大都觉得，亲自面对这样的威胁不是明智之举，但是……你没有退缩的打算，对吧。"
    }
    {
      Id = "Melinoe_4110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "对。"
    }
    {
      Id = "Odysseus_0386"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就好。"
    }
    {
      Id = "Melinoe_4230"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，客观来说……根据我的估计，他至少得比一个独眼巨人大上一百倍。不过我还没有机会弄清楚他到底有多少斤两。"
    }
    {
      Id = "Odysseus_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫老大她很担心你在和提丰对决的时候，会不会有什么三长两短。毕竟，你从来没有练习过怎么跟{#Emph}那么大{#Prev}的敌人战斗。"
    }
    {
      Id = "Melinoe_4111"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，昨晚我就练了练。提丰力大无穷，而且体型庞大得能遮蔽月光，但事实证明他{#Emph}并不是刀枪不入{#Prev}。据说宙斯大人之前就打败过他。"
    }
    {
      Id = "Odysseus_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}据说{#Prev}的事情多了去了，女神；我对你的{#Emph}亲身体会{#Prev}更感兴趣。如果你的直觉告诉你这个魔物可以被阻止，那对我来说就已经足够了。不过，我也……也希望能见到些{#Emph}证据{#Prev}，这是自然的嘛。"
    }
    {
      Id = "Melinoe_4112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是啦。"
    }
    {
      Id = "Odysseus_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "你把那个山一样大的怪物打败了，女神……！如果我说我{#Emph}从未{#Prev}怀疑过你，那就是在撒谎了，但是……我发誓，我真的只是有过一点疑虑而已。所以，你是怎么智取他的？"
    }
    {
      Id = "Melinoe_4113"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}智取{#Prev}他？我能做的就只有使出浑身解数狠狠打他。宙斯大人也用闪电狠狠劈了他，帮了我大忙。最后，这个办法奏效了，提丰就倒下了。"
    }
    {
      Id = "Odysseus_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧！你的战斗水平可能无人能及，但你讲故事的水平……还差点火候。下次你打败众魔之父的时候，讲个更让人热血沸腾的故事，好么？"
    }
    {
      Id = "Melinoe_4114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……这可不好保证。"
    }
    {
      Id = "Odysseus_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，让我们回忆一下当时的情景！你孤身一人，站在暴雨滂沱的山顶……而从那黑暗之中，爆发出一声震耳欲聋的咆哮，让整座奥林匹斯山为之颤抖。吼声未落，提丰便已经现身，怒意比上一次更盛……！然后呢，女神？"
    }
    {
      Id = "Melinoe_4115"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后我们打了一场，我赢了。啊，糟了……我是该讲个好故事的。呃，他一直在用他的{#Emph}下巴{#Prev}砸我……但我躲过了他的攻击，然后爬到了他头顶上，把姊妹双刃利姆欧罗狠狠捅进了他的头颅之中！"
    }
    {
      Id = "Odysseus_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，好血腥的结尾，我{#Emph}喜欢{#Prev}！唯一一点可以改进的地方，如果我可以提的话，就是……对于身形庞大的怪物，有太多故事都是这样收尾的了。嗯，如果……如果说他把你活吞了下去呢？然后你从他的肚子里杀了出来？"
    }
    {
      Id = "Melinoe_4116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我正要讲到那里呢！"
    }
    {
      Id = "Odysseus_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "你还好么，女神……？我下意识想要{#Emph}庆祝{#Prev}提丰的死亡，但是……我永远也忘不了我杀死的第一个人。光芒从他的瞳孔中逝去的样子……"
    }
    {
      Id = "Melinoe_5050"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰渴望毁灭；他这是自作自受。我不会因这样的结果而庆祝，但也不会为之哀悼。何况我们现在还有更多事情要做。"
    }
    {
      Id = "Odysseus_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "这种心态再好不过了。等到一切尘埃落定，你会有时间回顾每一个选择，以及它带来的影响，但现在……最好是继续前进，给这一切画上句号。"
    }
    {
      Id = "Melinoe_5051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "正有此意。"
    }
    {
      Id = "Odysseus_0588"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的目标近在咫尺，女神，这点我从女巫老大最近紧绷的状态就能看得出来……我不是有意打探，但对于你需要做的事，你已经清楚了么？"
    }
    {
      Id = "Melinoe_5048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想是的。我很想把整个计划向你和盘托出，但你知道这种事情老师向来希望绝对保密。这么说吧，计划的最终阶段已经在进行中了。"
    }
    {
      Id = "Odysseus_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我就放心了。这个阶段全靠你和她了。至于我的工作嘛，看起来现在抵达目的地对你来说已经不是什么难事了。"
    }
    {
      Id = "Melinoe_5049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。谢谢你为我规划路线。"
    }
    {
      Id = "Odysseus_0590"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随时乐意效劳。"
    }
    {
      Id = "Odysseus_0594"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近你也没见到女巫老大，是么，女神？要是出了什么事，你会告诉我的吧……？"
    }
    {
      Id = "Melinoe_5052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没什么需要担心的。"
    }
    {
      Id = "Odysseus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近在海底的体验怎么样？那里潜伏着各种各样叫人头疼的怪物，我手里的报告都是这么说的。我敢说你肯定见过其中一些了吧。"
    }
    {
      Id = "Melinoe_2181"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说得没错。最让人头疼的非那个海怪莫属，她名叫斯库拉，身边跟着两个塞壬。她们搞的那一出实在是太荒唐了……"
    }
    {
      Id = "Odysseus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，斯库拉还在兴风作浪呢？甚至还在跟那些塞壬狼狈为奸，{#Emph}哈！{#Prev}你能平安回来真是个奇迹。但愿她们唱歌的时候你捂住了耳朵？"
    }
    {
      Id = "Melinoe_2182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呦，我全听见了。"
    }
    {
      Id = "Odysseus_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哎呦……"
    }
    {
      Id = "Odysseus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前有一次，塞壬的歌声让我无比渴望……我差点就没有抵抗住她们的诱惑；当然，那时候我还只是……一介凡人。也许身为女神的你没那么容易受到她们的蛊惑。"
    }
    {
      Id = "Melinoe_2183"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许吧。至少我现在还没觉得那些歌有什么好听的。不过，这也可能是因为有斯库拉在，或许塞壬们离了她会更好过。她好霸道啊……"
    }
    {
      Id = "Odysseus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，她可是个狠角色。当时她抓了我六个船员，就好像她有六张血盆大口，每张都要吞掉一个似的。我们当时别无选择，只能向众神祈祷，然后继续航行。替我跟她打个招呼！"
    }
    {
      Id = "Melinoe_2184"
      InheritFrom = "BaseNarrative"
      DisplayName = "那众神有回应你的呼唤吗？"
    }
    {
      Id = "Odysseus_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，大概算是有吧！"
    }
    {
      Id = "Melinoe_2202_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近经常见到你一个人呆在这里，奥德修斯。你在想你的家人，对么？一定是过去的种种让你无法释怀。"
    }
    {
      Id = "Odysseus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，女神，你常常能一眼看穿我们这些暗灵的心思，但是这次你对我的同情……恐怕稍稍有些误会。佩涅洛佩、特勒马科斯和我……我们三个关系还好，但是……唔，怎么说才能不像个薄情寡义的人……"
    }
    {
      Id = "Melinoe_2203"
      InheritFrom = "BaseNarrative"
      DisplayName = "你直说就好，不用顾忌。我相信你不是什么薄情寡义的人。"
    }
    {
      Id = "Odysseus_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我所想的不是家里的事，而是……而是该死的塞壬之歌。我只堪堪听过那么一次，就是乘船驶过她们海域的时候。当时我好想{#Emph}不顾一切地{#Prev}跳入海中，只为听得更清楚……"
    }
    {
      Id = "Melinoe_2204"
      InheritFrom = "BaseNarrative"
      DisplayName = "塞壬的歌声？你该不会是想让我相信，大战术家奥德修斯近来惦记的是斯库拉的那些鬼哭狼嚎吧？"
    }
    {
      Id = "Odysseus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啦，好啦，别拿我打趣了，我是认真的。你没有在船上亲眼见过当时的场面，是不会理解的……"
    }
    {
      Id = "Melinoe_2205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "恐怕是的……"
    }
    {
      Id = "Melinoe_2206"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次我们在小酒馆聊天的时候，我不是有意批判你的音乐品味的。我只是没有意识到真的会有人把斯库拉唱的东西当回事……更何况是你。"
    }
    {
      Id = "Odysseus_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，没事，不用放在心上。聆听塞壬的歌谣本来就是{#Emph}需要培养的癖好{#Prev}……在我还在世时，所有驶过她们海域的船员都被{#Emph}培养{#Prev}出来了。不过，你之前说“鬼哭狼嚎”……真的有这么差么？"
    }
    {
      Id = "Melinoe_2207"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，可能我之前的评价有点不太客气，只是……我在欣赏作品时，没办法把我对创作者的蔑视完全搁置一旁。"
    }
    {
      Id = "Odysseus_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少一定很琅琅上口，对吧？"
    }
    {
      Id = "Melinoe_2208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实……"
    }
    {
      Id = "Melinoe_5248"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道斯库拉和卡律布狄斯联手了吗？"
    }
    {
      Id = "Odysseus_0626"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，确实可以这么说。怎么突然说起这个了？"
    }
    {
      Id = "Melinoe_5249"
      InheritFrom = "BaseNarrative"
      DisplayName = "我碰巧赶上了他们最近一场演出。怎么说呢，很有{#Emph}舞台效果{#Prev}。你知道他们在合作办演唱会，怎么不提前告诉我一声！"
    }
    {
      Id = "Odysseus_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，请原谅我，我只是以为斯库拉和卡律布狄斯之间的合作，可以算是某种常识……这完全不是什么新鲜事了。"
    }
    {
      Id = "Melinoe_5250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许我只是错过了新闻。"
    }
    {
      Id = "Odysseus_0628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "难以置信……"
    }
    {
      Id = "Melinoe_5246"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，斯库拉提到，她们的观众席上可能坐着一位潜在的赞助商。这个人是什么来头，你有任何头绪吗？我本来觉得可能会是克洛诺斯，但是很难想象他会听她们的音乐。"
    }
    {
      Id = "Odysseus_0624"
      InheritFrom = "BaseNarrative"
      DisplayName = "潜在的赞助商……我们的报告中没有提到过这么个人，不过我会再去筛查一边，如果有什么发现就第一时间告诉你。也许只是哪个老水手，听过她们的音乐之后无法自拔了吧。你知道这种赞助意味着什么吗？"
    }
    {
      Id = "Melinoe_5247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "大概是更多的夜场演出吧。"
    }
    {
      Id = "Odysseus_0625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她最近还真是大红大紫……"
    }
    {
      Id = "Odysseus_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "塞壬们给你带来了不少麻烦，是不是。我们的暗灵混入了他们周围的观众之中，观察到了一些情况想和你分享。"
    }
    {
      Id = "Melinoe_4209"
      InheritFrom = "BaseNarrative"
      DisplayName = "观察到了一些情况？是指我一生都在刻苦训练魔法和武艺，到头来却连一个神经病乐团都打不过的这个“情况”吗？"
    }
    {
      Id = "Odysseus_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "没必要这样妄自菲薄，女神。面对斯库拉和塞壬的时候，你要同时对付三个敌人。她们的架子鼓手没办法移动，但却是很大的威胁。我们的暗灵建议你先从她下手。"
    }
    {
      Id = "Melinoe_4210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会试试的。"
    }
    {
      Id = "Odysseus_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "那音乐……我在哪里都认得出来！就算没有歌词也一样。我还以为三岔路口欣赏塞壬的音乐的，只有我自己呢。"
    }
    {
      Id = "Melinoe_4187"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我只是想看看我们的乐师会不会这一首曲子。也许应该禁止在这里放这首歌。尤其是考虑到它可能有蛊惑人心的力量。"
    }
    {
      Id = "Odysseus_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我觉得我们这些死人已经对这种效果免疫了。不过，我最好还是再听几遍，确认一下。"
    }
    {
      Id = "Melinoe_4188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果会影响到你的话，就跟我说哦。"
    }
    {
      Id = "Odysseus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得提醒你小心一点，女神，因为等你到达哀悼原野的尽头时，将会遭遇一道阻碍。报告称这是某种来自渊狱的魔兽……一个大块头。我们汇报的暗灵不得不与它保持很远的距离。"
    }
    {
      Id = "Melinoe_3324"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们知道过了那里，就能找到通往塔耳塔罗斯的秘密通道……这个魔兽一定是那条通道保持“秘密”的原因。有什么更具体的消息吗？"
    }
    {
      Id = "Odysseus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，据称它有好几个会喷火的头。令人不安的是，这与你父亲当年在家里养的宠物的特征不谋而合。不过，如果真的是这样的话……那就希望他会放你通过吧！"
    }
    {
      Id = "Melinoe_3325"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你的意思是刻耳柏洛斯现在在把守通往塔耳塔罗斯的入口？它为什么会听命于克洛诺斯？绝对不可能。"
    }
    {
      Id = "Odysseus_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这些报告确实无法得出确切的结论，但我还是想先跟你说一声。"
    }
    {
      Id = "Melinoe_3326"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以证实我们暗灵的报告。另外，这只渊狱魔兽不是别的东西，而是刻耳柏洛斯，我父亲养的宠物……只是它现在完全依赖直觉行事，四处宣泄怒火。"
    }
    {
      Id = "Odysseus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊……我之前就是担心这个，因为报告称那个魔兽有好几个会喷火的头。过了这么久，恐怕他没有认出你……然后……直接让你通过吧？"
    }
    {
      Id = "Melinoe_3327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没有。我必须得想办法帮帮他。"
    }
    {
      Id = "Odysseus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "考虑到你奥林匹斯山上的亲戚都在援助你，我本想让你告诉他们，我也在为你出谋划策，不过……呃，奥林匹斯众神也不全都喜欢我。"
    }
    {
      Id = "Melinoe_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}什么？{#Prev}但你可是“足智多谋的奥德修斯”啊！你的辉煌事迹就连众神都赞不绝口呢。"
    }
    {
      Id = "Odysseus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜女神和其他神明都很欣赏我，这不假，但你的叔叔波塞冬，怎么说呢……我之前大概是惹到他了。说不定过了这么久，他早就没放在心上了，但冒这样的风险对我来说太不值得，所以……别跟他提起我，好么？"
    }
    {
      Id = "Melinoe_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没问题。"
    }
    {
      Id = "Odysseus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，看来我们的计划中多了个变数。我们确认了赫尔墨斯大师所言非虚，地表上确实……有一场危机正在酝酿。"
    }
    {
      Id = "Melinoe_2223"
      InheritFrom = "BaseNarrative"
      DisplayName = "请把你所希望我知道的一切都告诉我……以及，如果你认为我应该暂时搁置现有的任务，回应地表的求助，也请务必让我知道。"
    }
    {
      Id = "Odysseus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯的军队正在集结，准备通过一条横贯大陆的海峡乘船驶向奥林匹斯山。我们为你安排了一条路线，可以让你从内部出击，搅乱敌人的军队。援助奥林匹斯山，你面对克洛诺斯的胜算就很可能会提升几分。"
    }
    {
      Id = "Melinoe_2224"
      InheritFrom = "BaseNarrative"
      DisplayName = "那条被封印的通往地表的路，会直接让我进入敌人前哨的心脏地带。听起来好鲁莽……"
    }
    {
      Id = "Odysseus_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "风险确实不小，但是值得一搏。"
    }
    {
      Id = "Melinoe_2189"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次有人报告在林中见到过尾随者是什么时候？"
    }
    {
      Id = "Odysseus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……我感觉这个问题只有刚刚在林中撞见尾随者的人才会问。所以说厄瑞玻斯还潜伏着那种腐烂之物？"
    }
    {
      Id = "Melinoe_2190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很遗憾地告诉你……是的。"
    }
    {
      Id = "Odysseus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是遭了什么罪，回来的时候这副眉头紧锁的样子？是哀嚎者？还是送葬者？哦，我知道了……是{#Emph}泼影者{#Prev}。"
    }
    {
      Id = "Melinoe_2187"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，是个泼影者。我被它打得找不着北。它一现身，我就几乎什么也看不见了！我的力量还是不够强……"
    }
    {
      Id = "Odysseus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的力量应付它不成问题。它考验的只是你的胆量。面对这种敌人，必须毫不犹豫地与它短兵相接。准备好再试一次了吗？"
    }
    {
      Id = "Melinoe_2188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "准备好了。"
    }
    {
      Id = "Odysseus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "报告说你在俄刻阿诺斯的进展很顺利，但既然你站在这里，恐怕这条报告已经过时了。女神，这次是什么怪物把你“送”回来了？"
    }
    {
      Id = "Melinoe_2191"
      InheritFrom = "BaseNarrative"
      DisplayName = "说来惭愧，是只海蛇。一只格外庞大的海蛇，抓住了我的破绽。你在凡间历险时见过这种生物吗？"
    }
    {
      Id = "Odysseus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实见过。但我可没有独自面对过它们！哪怕算上我的全体船员，都是身经百战的水手，我们也还是被那些从海里窜出来的湿滑怪物弄得招架不迭。呃，恐怕这个情报对你来说不算什么安慰？"
    }
    {
      Id = "Melinoe_2192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "恐怕不算。"
    }
    {
      Id = "Odysseus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，最新的报告称你遇到了鼠兽之王！哪怕按说你是个不死不灭的神明，见到你四肢健全地回来，还是让我松了一口气……"
    }
    {
      Id = "Melinoe_2193"
      InheritFrom = "BaseNarrative"
      DisplayName = "不会吧。我确实和一只格外凶残的鼠兽交了手，但它是个小不点儿啊！我以为鼠兽之王得是好大一只呢。"
    }
    {
      Id = "Odysseus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "都是被人夸大的。鼠兽之王的愤怒和它的体型之间有着强烈的反差。而它的体型，据我所知，确实小得很……"
    }
    {
      Id = "Melinoe_2194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这……"
    }
    {
      Id = "Odysseus_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "你可能已经见到了，现在的俄刻阿诺斯正是地狱水母涌动的季节。遇到它们的话，建议不要在小的上面花费太多精力，专心对付{#Emph}最大的{#Prev}那只。"
    }
    {
      Id = "Melinoe_4191"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是希望别遇上它们，这样就一点精力都不用花费了，还不用被它们蜇。这种涌动的季节一般会持续多久？"
    }
    {
      Id = "Odysseus_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，说是“季节”可能有些不恰当，因为现在的这个“季节”自从我还是个孩子的时候就开始了。好消息是，再过一段时间，你就会习惯被蜇的感觉了！"
    }
    {
      Id = "Melinoe_4192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是好极了。"
    }
    {
      Id = "Odysseus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说你在哀悼原野发现了个魅影的巢穴啊，如果我派往那里的暗灵做出的报告仍然可信的话。那些该死的吸血鬼……啊，我是说{#Emph}魅影{#Prev}，不是说我派过去的暗灵。"
    }
    {
      Id = "Melinoe_3347"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些生物通常不是会潜伏在地表，寻找{#Emph}活着{#Prev}的猎物吗？它们在冥界肯定饿得够呛。"
    }
    {
      Id = "Odysseus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "宁可挨饿，也比挨阳光直射、灰飞烟灭要强，我猜它们大概是这么想的吧。唔，至少你下次遇到它们的时候，知道它们所渴求的是什么了。"
    }
    {
      Id = "Melinoe_3348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会让它们得逞的。"
    }
    {
      Id = "Odysseus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能为这则目击了拉米亚女王的报告作证吗，女神？我本来要提醒你当心爬行的踪迹，只不过恐怕已经太迟了……"
    }
    {
      Id = "Melinoe_3346"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我一定是吸引她离开了她的巢穴。要不然就是我一头闯了进去。总之，不管怎样，昨夜的经验表明，她的魔力在我之上……"
    }
    {
      Id = "Odysseus_0287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "在{#Emph}你{#Prev}之上？{#Prev}不见得吧。"
    }
    {
      Id = "Odysseus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们是派{#Emph}御鼠大师{#Prev}来对付你了吗，女神？那个萨提尔别无它名，也很少有萨提尔能长得像他一样巨大。他是泰坦王的大祭司之一！"
    }
    {
      Id = "Melinoe_3349"
      InheritFrom = "BaseNarrative"
      DisplayName = "那泰坦王很快就会{#Emph}少一个{#Prev}大祭司。"
    }
    {
      Id = "Odysseus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的报告称，就算你能消灭他，他也不会{#Emph}真的{#Prev}死亡。这是克洛诺斯赐予他的力量，作为他们复活克洛诺斯的回礼……"
    }
    {
      Id = "Melinoe_3350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那样的话，至少我也可以验证我们报告的真实性。"
    }
    {
      Id = "Melinoe_3351"
      InheritFrom = "BaseNarrative"
      DisplayName = "我并不想做出这则报告，但是我大概知道克洛诺斯在用那些花不完的金币干什么了……昨晚我被一大袋子金币狠狠揍了一顿。"
    }
    {
      Id = "Odysseus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "那想必是一个{#Emph}暴怒财奴{#Prev}了！从克洛诺斯的角度，考虑到他亮闪闪的金币几乎花不完，拿些出来做点渎神的研究大概也在情理之中吧。啊，真可惜，你离目标只有一步之遥……"
    }
    {
      Id = "Melinoe_3352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是啊……"
    }
    {
      Id = "Odysseus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "还没有在地表见到克洛诺斯的踪影。说来也是，他有嗜血的萨提尔作为耳目，为什么还要冒风险亲自现身呢，对吧？他的军队比起最开始看起来，恐怕要有组织得多。"
    }
    {
      Id = "Melinoe_3320"
      InheritFrom = "BaseNarrative"
      DisplayName = "我刚刚不幸和某个“嗜血的萨提尔”打了个照面。装备精良、训练良好……而且这样的家伙，在克洛诺斯手下有整整一支军队之多。"
    }
    {
      Id = "Odysseus_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，自从众神将克洛诺斯扳倒以来，他们就渴望着这样的一场战争。泰坦的回归，以及允诺给他们的不朽生命和无数财宝……"
    }
    {
      Id = "Melinoe_3321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……统统都是谎言。"
    }
    {
      Id = "Odysseus_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，极有可能。"
    }
    {
      Id = "Melinoe_3316"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不承认，以前我总觉得你讲的那些关于海怪卡律布狄斯的故事实在是太夸张了。现在，在亲身面对那个该死的怪物之后，我反而觉得你当时还可以讲得更夸张一点。"
    }
    {
      Id = "Odysseus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么，你遇上卡律布狄斯了？啊，女神。我收到了一些报告，说波塞冬的裂谷之中出现了某种漩涡，现在我担心的情况被证实了。至少她没有一口把你吞掉……！"
    }
    {
      Id = "Melinoe_4199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有什么对付她的实用建议吗？"
    }
    {
      Id = "Odysseus_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯……能躲就躲？"
    }
    {
      Id = "Odysseus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许在我们上次谈到卡律布狄斯的时候，我应该给你一些更有建设性的建议。我意识到，你可能没办法绕开她航行……"
    }
    {
      Id = "Melinoe_4200"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实。我原本以为主要的威胁是落入她的血盆大口……但我发现她那些拍来拍去的触手才是更大的问题。"
    }
    {
      Id = "Odysseus_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就多留意它们。也许你可以集中对付一两只“落单”的触手，并利用周围的空间保持移动。狠狠打她的触手，她尝到苦头应该就会撤退了。"
    }
    {
      Id = "Melinoe_4201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "想想就疼。"
    }
    {
      Id = "Odysseus_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在波塞冬的裂谷中航行的时候见到的那些淹死的水手，有一些我可能曾经认识……虽然现在我肯定已经认不出来了。"
    }
    {
      Id = "Melinoe_4193"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些水手里至少有一个能够对其他水手发号施令，至少从更华丽的装束和武器来看是这样。我前一夜刚刚在他那艘大船上和他交过手。"
    }
    {
      Id = "Odysseus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果报告属实的话，那个大概就是阿尔戈海盗了。以前有过一整队名字相近的冒险者，也许他就是其中的一员。但他们是比我更早一个时代的人了。也许他们还想着重温昔日的辉煌吧……"
    }
    {
      Id = "Melinoe_4194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "以及挡我的路。"
    }
    {
      Id = "Melinoe_4195"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在凡间的时候，有对付过巨龙么，奥德修斯？就是那种长了蝙蝠一样翅膀到处飞的野兽，只是比蝙蝠要大得多。它们最近在奥林匹斯山上可以说是泛滥成灾。"
    }
    {
      Id = "Odysseus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的家乡的确是在山上，但我们基本上没有受到过飞行野兽的侵扰。不过，根据我的经验，它们有一个共同的弱点：很容易被从天上射下来。"
    }
    {
      Id = "Melinoe_4196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有道理。"
    }
    {
      Id = "Melinoe_3610"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道奥林匹斯山的守护者塔罗斯么？赫菲斯托斯最精巧的发明之一，往那一站就是件艺术品……然而却完全无法分辨敌我。"
    }
    {
      Id = "Odysseus_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "它敌我不分是很令人失望，但据说这不是疏忽所致。奥林匹斯众神总会将塔罗斯部署在{#Emph}任何人{#Prev}都不得擅闯的地方；而近来，奥林匹斯山就符合这一描述。"
    }
    {
      Id = "Melinoe_3611"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候，我总觉得奥林匹斯山的防御计划并不协调。这些不都应该归雅典娜女士负责么？"
    }
    {
      Id = "Odysseus_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "按说是这样没错。你的家人是什么样子，你也知道啦，女神！在重要的事情上，他们每个人都想露一手。"
    }
    {
      Id = "Melinoe_3612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "从他们的角度想，只能希望塔罗斯的维修费用不要太昂贵了。"
    }
    {
      Id = "Odysseus_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯众神最近在对付哪些邪恶的怪物？泰坦大军本来就够难缠的了，现在还要面对提丰的子孙……"
    }
    {
      Id = "Melinoe_4197"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……想象一下各种大小、各种外形的恐怖生物，每个都有肌肉、眼睛、尖牙，比例不等。他们会从地下钻出来……有些甚至是从墙壁里渗出来！昨天夜里打败我的那只体型格外庞大。"
    }
    {
      Id = "Odysseus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "而且如果我没理解错的话，提丰的孩子数量众多，就连你的叔父宙斯相比之下都差得远。更何况它们每个都是一等一的歹毒。一场家族争端！我所了解过的大多数战事，都是以此而起。"
    }
    {
      Id = "Melinoe_4198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我从来没有从这个角度想过……"
    }
    {
      Id = "Melinoe_4197_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……想象一下各种大小、各种外形的恐怖生物，每个都有肌肉、眼睛、尖牙，比例不等。他们会从地下钻出来……有些甚至是从墙壁里渗出来！"
    }
    {
      Id = "Odysseus_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "是什么把你送回来了，让你如此愁眉不展，女神？我们听说你抵达了山顶，但在那之后的汇报就莫衷一是……或者说，莫名其妙了起来。"
    }
    {
      Id = "Melinoe_5079"
      InheritFrom = "BaseNarrative"
      DisplayName = "山顶受到了某种侵蚀……那里现在怪物遍布。它们不可能是克洛诺斯的仆从，但是……一定是他计划的一环。"
    }
    {
      Id = "Odysseus_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，在获知所有必要的真相之前，没必要过早下定论。你对抗了那些怪物，而且得以全身而退。你的家人一定知道更多，只要他们……还能联系到你。"
    }
    {
      Id = "Melinoe_5080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我得确保一直如此。"
    }
    {
      Id = "Odysseus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，你真的在用那把双刃斧吗？我指的是那柄月石之斧。无意冒犯，但……这个是不是有点太夸张了？这样的武器，恐怕就连埃阿斯都驾驭不来。"
    }
    {
      Id = "Melinoe_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "当初可是你教我见机行事的啊，奥德修斯？任何能为我所用的手段我都不会放过。埃阿斯是什么人？"
    }
    {
      Id = "Odysseus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "埃阿斯是{#Emph}什么人{#Prev}？他是我见过块头最大的人，他可是埃阿斯啊。不过我差点忘了，{#Emph}他{#Prev}身上可没有冥王的血脉。"
    }
    {
      Id = "Odysseus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一句话，不知当讲不当讲，女神。在远程战斗中，你们这些女巫总是依赖于你们的魔法。你有没有考虑过重新拿起弓箭试试？我可以为你指点一二……"
    }
    {
      Id = "Melinoe_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "不许再跟我说弓箭的事，奥德修斯。上次得了你的“指点”之后，我直到现在都还没能从受到的打击里走出来呢。"
    }
    {
      Id = "Odysseus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，好吧。我们都有各自的优点和缺点。或许这可以算是你唯一一个缺点了。"
    }
    {
      Id = "Melinoe_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "才不算呢。"
    }
    {
      Id = "Odysseus_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的地图用起来感觉怎么样？你是抵达了俄刻阿诺斯没错，但根据我们目前了解到的情况，前面的道路还要错综复杂得多。"
    }
    {
      Id = "Melinoe_4089"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥界的道路，简直多得像夜空中的繁星……但你的地图总能准确地为我指明道路。你的方向感一定很好。"
    }
    {
      Id = "Odysseus_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那可不见得，但如果我们的地图能弥补我那糟糕的方向感，那我就心满意足了。不过，等你抵达哀悼原野，就要多加小心了。在那里，地图也帮不到你。"
    }
    {
      Id = "Melinoe_4090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那些金色花瓣呢？"
    }
    {
      Id = "Odysseus_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，多留意它们。"
    }
    {
      Id = "Odysseus_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们最终放弃了在至福乐土寻找一条可行的路线，所以你进入塔耳塔罗斯的方式有些不同寻常。旧时的员工走廊仍然是无人维护的状态么？"
    }
    {
      Id = "Melinoe_4091"
      InheritFrom = "BaseNarrative"
      DisplayName = "那里彻底被弃用了，以至于有种宁静的感觉。那里直通维修通道，就和地图上画得一样。"
    }
    {
      Id = "Odysseus_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，这点主要是我们暗灵的功劳，不过如果你坚持的话，我就沾沾他们的光吧。你的任务已经够艰巨的了，不能再让你冒迷路的风险。"
    }
    {
      Id = "Melinoe_4092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我同意。"
    }
    {
      Id = "Odysseus_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "你通往冥界的道路可能看起来有些迂回，但通过避开冥界主要的区域，你就有很大的机会躲开克洛诺斯的注意，直到你做足准备，{#Emph}按自己的步调{#Prev}最终与他对峙。"
    }
    {
      Id = "Melinoe_4088"
      InheritFrom = "BaseNarrative"
      DisplayName = "那条路线我早已牢记于心。如果说有一条路能直通塔耳塔罗斯的话，只会让我觉得过于理想，以至于像个圈套。有这么一条非常规路线，我已经很是知足了。"
    }
    {
      Id = "Odysseus_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "主要还是因为你父亲的界域确实辽阔，这样我们才能沿着边界拟出一条路线，把你一路送到你最终的目的地。"
    }
    {
      Id = "Odysseus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫老大说，你上次在正面对决中击败了她。厉害！你后面是不是走得更远了？"
    }
    {
      Id = "Melinoe_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错。我下到了海底的一座宫殿中，那个地方四处都回荡着怪异的音乐声。我没做好准备。"
    }
    {
      Id = "Odysseus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说怪异的音乐声，是么……不禁让我想起……哦，我还是下次再跟你讲故事吧，看得出来你要想的事已经够多了。"
    }
    {
      Id = "Odysseus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，很好，你已经去到哀悼原野了！塔耳塔罗斯就在那后面不远……其实是在正下方，不过入口离你降落的地点还有一小段路……"
    }
    {
      Id = "Melinoe_3318"
      InheritFrom = "BaseNarrative"
      DisplayName = "那一小段路上全是吞噬灵魂的邪魔，以及其他憎恨生者的妖魔鬼怪。是不是它们太强大了，关不住，所以才被放到那里游荡？"
    }
    {
      Id = "Odysseus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们凡人可是很喜欢哀悼原野的，女神！在那里可以抛下俗世的愁苦……或者在愁苦中沉沦。因此那里非常适合邪魔。它们之中只有{#Emph}一部分{#Prev}会与你相安无事。"
    }
    {
      Id = "Melinoe_3319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我已经体会过了。"
    }
    {
      Id = "Odysseus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听说你想要让刻耳柏洛斯恢复神智的尝试成功了……至少是暂时成功了，女神。他跑进了塔耳塔罗斯，结果过不了多久，又被赶回了哀悼原野？"
    }
    {
      Id = "Melinoe_3328"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我收集到的信息也能证实这一点。它跑进塔耳塔罗斯，是为了找他的主人……也就是我的父亲。我偶然遇到了他，他全身都绑着锁链！克洛诺斯在折磨他们……在嘲弄他们。"
    }
    {
      Id = "Odysseus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯是在利用{#Emph}他们{#Prev}来激怒{#Emph}你{#Prev}，让你陷于情绪之中，将自己的安危抛到九霄云外。记住，女神，战争是心灵与智谋的博弈。"
    }
    {
      Id = "Melinoe_3329"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在阳世的时候，不也是依自己的情绪行事的吗？"
    }
    {
      Id = "Odysseus_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "所以才落得如此下场嘛！"
    }
    {
      Id = "Melinoe_2225"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么不让涅墨西斯替我去地表呢？就算我解除掉封印着那条路的屏障，也说不好我能在上面待上多久。"
    }
    {
      Id = "Odysseus_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山上的事情对涅墨西斯来说算不上私人恩怨，这点和你不一样。更何况她最近也不太听得进去别人的建议。"
    }
    {
      Id = "Melinoe_2226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，确实。"
    }
    {
      Id = "Odysseus_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "咱们的女巫大人一直都认为，只要等到你准备妥当，等到时机成熟，你就会主动启程前往地表。做得好。"
    }
    {
      Id = "Melinoe_2227"
      InheritFrom = "BaseNarrative"
      DisplayName = "她把向上的路封住了，直到我自己找出解除封印的办法。但地表的气候则是另一道难题……"
    }
    {
      Id = "Odysseus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "是你的冥界血脉在作祟吗？看来身为冥王之女不仅是种祝福，也是种诅咒啊。不过，你已经用巫术破除了这么多道障碍，一定也能找到解决这个……这个困境的办法。"
    }
    {
      Id = "Melinoe_2228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "正有此意。"
    }
    {
      Id = "Odysseus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "在色萨利裂谷的航行如何，女神？有的时候我很怀念我过去在海上度过的日日夜夜。也许我只是忘了那时过得有多狼狈……"
    }
    {
      Id = "Melinoe_3307"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感觉现在我都能提醒你这一点了。整片海域都是克洛诺斯的舰队，它们从海底深渊中升起，上面满载着淹死的船员。我只能见机行事，坐上哪艘船，就驾驶哪艘船向前航行。"
    }
    {
      Id = "Odysseus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来确实是当之无愧的海上冒险了，一路上都是{#Emph}危险和未知{#Prev}……！啊，感觉我都要嫉妒那些淹死的水手了！在我死后，我一直以为我在海上航行的日子要画上句号了。"
    }
    {
      Id = "Melinoe_3308"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，克洛诺斯估计正招水手呢，毕竟那些淹死的水手被我干掉了不少。"
    }
    {
      Id = "Odysseus_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那你可得帮我美言几句，好吗？"
    }
    {
      Id = "Odysseus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "这也许不是最适合告知你的时机，但我们有理由相信，在奥林匹斯山上酝酿的麻烦比表面上要严重得多。就连众神都没有完全意识到这一点。不幸的是，我们也一样……"
    }
    {
      Id = "Melinoe_3608"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯的大军进攻不断，而众神和他们的防御工事却仍然坚挺……你的意思是说，这不过是佯攻，用来掩饰泰坦的某个惊天大阴谋？"
    }
    {
      Id = "Odysseus_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就是这么想的。不过，不要恐惧，女神！我曾经与一位伟大的战士并肩作战，他常说：{#Emph}“恐惧是弱者的专利。”{#Prev}我现在愈发觉得，恐惧是{#Emph}生者{#Prev}的专利，但和大部分事物一样，宜少不宜多。"
    }
    {
      Id = "Melinoe_3609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "恐惧是我们敌人的专利。"
    }
    {
      Id = "Odysseus_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "了解。"
    }
    {
      Id = "Odysseus_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "地表怎么样，还是一如既往地温暖宜人么？你能找到踏足地表的办法，本身已经是一件壮举了。"
    }
    {
      Id = "Melinoe_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "上面简直是惨绝人寰。埃费拉城整个沦陷了，而且还有个瞎了眼的独眼巨人守在城门口，确保没人出得了城。"
    }
    {
      Id = "Odysseus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，听起来真是太糟糕了。那个瞎了眼的独眼巨人，一定是波吕斐摩斯。我和我的船员曾经跟他起过冲突。他还是钟情于吃人吗？"
    }
    {
      Id = "Melinoe_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是的。"
    }
    {
      Id = "Odysseus_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哎呦……"
    }
    {
      Id = "Melinoe_3337"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的老仇家波吕斐摩斯想让我给你捎个信。不过，说起来，我不确定他到底是想要我说什么。也许就只是……狠狠踹你一脚？"
    }
    {
      Id = "Odysseus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，听起来是我认识的那个独眼巨人没错了。我和我的船员当时被他逮住，关了一阵子……成了他的储备粮。我找到了带领其他人脱身的办法，但是说实话很是狼狈……"
    }
    {
      Id = "Melinoe_3338"
      InheritFrom = "BaseNarrative"
      DisplayName = "他管你叫“没有人”。他怎么会那样称呼你？"
    }
    {
      Id = "Odysseus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "“{#Emph}没有人{#Prev}刺瞎了他的眼睛”，女神……我告诉他我叫那个名字，是为了让他在向朋友们求援的时候，听起来像是胡言乱语。我们当时只有这一个办法了。"
    }
    {
      Id = "Melinoe_3339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他还有{#Emph}朋友{#Prev}？"
    }
    {
      Id = "Odysseus_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许那之后就没有了吧。"
    }
    {
      Id = "Odysseus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，老波吕斐摩斯看起来怎么样？也许比他年轻的时候动作慢了一些吧……？要正面交锋的话，我完全不是他的对手，但我只不过是一介凡人，而女神你可是……{#Emph}女神{#Prev}。"
    }
    {
      Id = "Melinoe_3340"
      InheritFrom = "BaseNarrative"
      DisplayName = "他很有领地意识，不过现在好像最在意的是食欲和睡眠质量，除此之外都满不在乎的样子。所以，你是真的刺瞎了他……？"
    }
    {
      Id = "Odysseus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的……只可惜他没有{#Emph}第二只{#Prev}眼睛，不然我还想{#Emph}再{#Prev}刺瞎一只。因为显而易见，{#Emph}他{#Prev}对他的所作所为没有丝毫悔过，而我……如你所见，我也没有懊悔之意。"
    }
    {
      Id = "Melinoe_3341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我会为你报仇的。"
    }
    {
      Id = "Odysseus_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很好。"
    }
    {
      Id = "Melinoe_2220"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在地表遇到了大力士赫拉克勒斯。绝对没认错！我以前还以为他死掉了呢。但看起来还蛮生龙活虎的，至少外表看起来是这样。而且还在为众神效力……"
    }
    {
      Id = "Odysseus_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "大力士{#Emph}赫拉克勒斯……{#Prev}他确实是个复杂的家伙。一部分是{#Emph}人{#Prev}，一部分是{#Emph}神{#Prev}……或许还有一部分是个怪物。生老病死的概念对他来说不太适用。所以他想干什么？他有找你的麻烦吗？"
    }
    {
      Id = "Melinoe_2221"
      InheritFrom = "BaseNarrative"
      DisplayName = "他对我态度不怎么样，叫我别挡他的路。听起来他好像有自己的任务要完成。也许奥林匹斯山并没有把希望寄托在我身上……"
    }
    {
      Id = "Odysseus_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，别往心里去。你的亲戚有些英明睿智，有些则狠辣无情。他们可能只是不想把所有筹码都押在某一个人身上。还有……跟赫拉克勒斯打交道，务必要慎之又慎，好么？"
    }
    {
      Id = "Melinoe_2222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好……"
    }
    {
      Id = "Odysseus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "普罗米修斯成了我们的敌人……这可真是{#Emph}不妙{#Prev}，女神。在我们凡人之中，他曾一度广受欢迎。甚至可以说是广受爱戴！是他赐予了我们火种，造就了现在的我们。"
    }
    {
      Id = "Melinoe_3606"
      InheritFrom = "BaseNarrative"
      DisplayName = "而他那样做，恰恰违背了奥林匹斯的意志。据说他有先见的天赋……他该预料到忤逆众神，会为他招致什么样的后果。"
    }
    {
      Id = "Odysseus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "为什么认为他没有预料到呢？正是这点让我们对他更加佩服。他深知帮助我们的代价，却还是心甘情愿地接受了，又或者……至少我是这样想的。但这都已经是过去的事了。他现在既然站在了克洛诺斯那边，就说明他已经误入歧途。"
    }
    {
      Id = "Melinoe_3607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错。"
    }
    {
      Id = "Odysseus_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想多问你一些关于普罗米修斯的事。在你看来，他是真的疯掉了么……？以及，如果他与你的整个家族作对，那么又是谁把他放出来的呢……？"
    }
    {
      Id = "Melinoe_4104"
      InheritFrom = "BaseNarrative"
      DisplayName = "这两件事我都说不准。他有的时候会把话说得很玄乎，但听起来也不像是发了疯。我怀疑是克洛诺斯的军队放了他，以此换来他的投诚，但是……"
    }
    {
      Id = "Odysseus_0380"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……但他不像是个雇佣打手，对吧。"
    }
    {
      Id = "Melinoe_4105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，我觉得不是。"
    }
    {
      Id = "Melinoe_4106"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里最了解凡人的就是你了。普罗米修斯指责众神残忍无道，自称不是为泰坦王效力，而是为凡人而战。你对此有什么看法吗？"
    }
    {
      Id = "Odysseus_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我认识那种觉得众神冷酷无情的人。有些人即使是死后，也在与众神作对。其他凡人则能够理解，众神其实……{#Emph}就是这个世界的一切{#Prev}。我们只有这一个世界，而它的美好远胜于它的残缺。"
    }
    {
      Id = "Melinoe_4107"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说得很抽象。我是想知道你个人的看法，奥德修斯。是众神做错了吗？这一切都是我们咎由自取吗……？"
    }
    {
      Id = "Odysseus_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "我个人的看法是，神明和凡人都很{#Emph}复杂{#Prev}；以及，你不需要怀疑自己，免得自己信念动摇。如果我感觉到你或者女巫老大做错了事的话，我会直言不讳的。"
    }
    {
      Id = "Melinoe_4108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你发誓？"
    }
    {
      Id = "Odysseus_0383"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我发誓，女神。"
    }
    {
      Id = "Melinoe_5223"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，有件事情我需要你的参谋，也希望你能保密。我发现普罗米修斯有个盟友，那个盟友我原本以为是我们家族那边的。我在接近山顶的地方，在浓烟之中与他们两个同时交了手。但是，我不能告诉你到底是谁……"
    }
    {
      Id = "Odysseus_0614"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，确实是个重磅消息，至于你所说的是谁，我心中已经有了猜测。众神一定知道了，至少赫尔墨斯大人知道，还是说……你觉得他们完全没有意识到？"
    }
    {
      Id = "Melinoe_5224"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得他们没有意识到，不过也许赫尔墨斯已经知道了，只是按下不表而已。普罗米修斯说我不会把这个盟友的身份告诉任何人，因为这样做会对我的家族造成巨大的伤害。你觉得他说的是实话么？"
    }
    {
      Id = "Odysseus_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不会赌他在说谎。我们最好暂时当他在说实话，除非你认为这个盟友对你的家族造成了迫在眉睫的威胁。你有机会进一步调查么？"
    }
    {
      Id = "Melinoe_5225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "应该算是有吧……"
    }
    {
      Id = "Odysseus_0616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有新发现记得跟我说。"
    }
    {
      Id = "Odysseus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神啊，我刚刚正在想你这一路旅行，上天入地都不在话下，甚至还要走遍天涯海角！这可不是简简单单的“旅程”二字所能概括的……{#Prev}一定有更合适的词汇……"
    }
    {
      Id = "Melinoe_2195"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么了，叫“任务”听起来不够夸张吗？也许也可以叫“奇旅”？或者“远航”？反正“差事”听起来不像那么回事……"
    }
    {
      Id = "Odysseus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "不太行，听起来太轻松了，而且“远航”更像是在说航海……呃，我们早晚会想到合适的词的。"
    }
    {
      Id = "Melinoe_2196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}……苦旅……远足……"
    }
    {
      Id = "Melinoe_2174"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，你以前是怎么处理压力的？当初你身上背负着一场大战的成败，然后又踏上了一场凶险无比的海上航行，全程都只有一条命……至少你那时候是这么觉得的吧？"
    }
    {
      Id = "Odysseus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "“只有一条命”这点自然为我注入了求生的意志。大多数凡人都渴望活下去，但我和普通人的差别在于我能摒除疑虑，果断行事。至于计划没有奏效的时候嘛……那就只能见机行事了！"
    }
    {
      Id = "Melinoe_2175"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的计划也有没奏效的时候？那你是怎么避免被挫折击垮的？面对失败的时候，怎么才能摒除疑虑？"
    }
    {
      Id = "Odysseus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "我总是享受寻找出路，逃出生天的感觉，不管我给自己惹上了什么样的麻烦。我会把身处的困境看成一座需要探索的迷宫，一场等待破解的棋局……"
    }
    {
      Id = "Melinoe_2176"
      InheritFrom = "BaseNarrative"
      DisplayName = "但是迷宫总有死路，棋局总有死局，有些事就是无法实现……"
    }
    {
      Id = "Odysseus_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，女神。依我看并非如此。"
    }
    {
      Id = "Odysseus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前问我是怎么处理压力的……怎么在无数次{#Emph}过于激动人心{#Prev}的遭遇中，背负着我自己和无数其他人的期盼，顶住只能成功不能失败的压力。"
    }
    {
      Id = "Melinoe_2177"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说你始终相信凡事都有破局的方法，都有好的结果可以争取……我一直在思考你话语中的深意。"
    }
    {
      Id = "Odysseus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "很好。不过，我后来又想到了些别的东西。女神啊，是爱推动着我继续前进。那场让我在至福乐土赢得了一席之地的战争……我是真的不想参加。我只想和我的妻子，以及当时刚刚出生的儿子待在一起。"
    }
    {
      Id = "Melinoe_2178"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你别无选择，只能去战斗。所以你一直怀揣着重见家人的希望……"
    }
    {
      Id = "Odysseus_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "听起来很耳熟，是不是？"
    }
    {
      Id = "Odysseus_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到了一条通往胜利的道路，然后带领大家抵达了终点。要是没有随机应变的空间，那就算不上什么好计划了嘛！当然了，这个随机应变的副作用之一，就是我们的计划现在又有了新的阶段……"
    }
    {
      Id = "Melinoe_5738"
      InheritFrom = "BaseNarrative"
      DisplayName = "收拾克洛诺斯的烂摊子……我知道你原本希望我能将他彻底根除。但是，我找到了另一条路……我想，这条路最终应该能让我的家族变得更为融洽；说不定长此以往，整个世界也会因此受益。"
    }
    {
      Id = "Odysseus_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "我完全理解，女神，而且我认为你做出了明智的选择。至于下一步，一切都已经准备好了，只要你做好准备，我们随时可以继续。"
    }
    {
      Id = "Melinoe_5739"
      InheritFrom = "BaseNarrative"
      DisplayName = "消灭那些真实存在的、我们面临失败的可能性……或者用克洛诺斯的话说，确保{#Emph}时间自由向前流淌{#Prev}。我还不知道会面对什么，但我们所追求的变化，不会在一夜之间来临。你对此有什么看法？"
    }
    {
      Id = "Odysseus_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，我自己的看法是，{#Emph}试试总无妨！{#Prev}如果你还有别的事需要处理，这也是个机会。以及，我们永远会在这里等你回来。"
    }
    {
      Id = "Melinoe_5055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我们就试试吧。"
    }
    {
      Id = "Odysseus_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的任务的新阶段里，一切都在按计划开展么，女神？也许说“按计划”有点不够贴切，毕竟……这种情况不在我们任何人的计划之中。"
    }
    {
      Id = "Melinoe_5111"
      InheritFrom = "BaseNarrative"
      DisplayName = "确保时间自由流淌确实是个不同寻常的任务。如果做得没错，一切都会看起来没有异常；而就算出了什么差池……也未必会招致不幸的后果。"
    }
    {
      Id = "Odysseus_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这听起来比我想象得熟悉多了。人生就是如此无常！总之，我们在密切监视克洛诺斯，而且也在确保你的路线仍然可行。"
    }
    {
      Id = "Melinoe_5112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不会辜负大家的努力的。谢谢你。"
    }
    {
      Id = "Odysseus_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来你父亲的冥府恢复了一定的秩序。我一直想找机会去那里看看，哪怕就让我见一见曾经的一两位战友也好。"
    }
    {
      Id = "Melinoe_5213"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也很想回去看看，但只要我们还是匿踪者的一员，恐怕就很难说什么时候才会有那样的机会。官方角度来说，他们根本就不该知道我们的存在。"
    }
    {
      Id = "Odysseus_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白，但还是没法打消这样的念头嘛！总之，只要冥府的员工都安然无恙就好。说不定什么时候我们会有机会再次相遇，谁知道呢。"
    }
    {
      Id = "Melinoe_5214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许命运三女神知道？"
    }
    {
      Id = "Odysseus_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，还有普罗米修斯。"
    }
    {
      Id = "Odysseus_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰真的还在那座山顶上吗？唔，我们没有收到任何和他有关的报告，但如果克洛诺斯……呃，应该说你的祖父……如果他用了某种时空魔法来传送你……"
    }
    {
      Id = "Melinoe_5215"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，就是这样。然后我就能像以前一样面对提丰了。看起来，他把我传送到的地方，是时间长河中我尚未取胜的种种可能性……至少是在我胜利之前。"
    }
    {
      Id = "Odysseus_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想不通这是怎么实现的。难道说在那条长河里还有其他的你，有的在输，有的在赢，这些都同时发生？太荒唐了……但是话又说回来，像这样天马行空的计划，我当年也做过不少啊。"
    }
    {
      Id = "Melinoe_5216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "管用就行，对吧？"
    }
    {
      Id = "Melinoe_5217"
      InheritFrom = "BaseNarrative"
      DisplayName = "关于命运三女神的事，你应该听说了吧？看起来所有人都知道了，我想着你肯定是最先知道的人之一。不过话说回来，我一直没怎么听你提到过她们……"
    }
    {
      Id = "Odysseus_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "……这是因为打心底，我一直觉得，我们所有的选择都是自己做出的。诚然，这个观点相当有争议，因为我们有相当确凿的证据表明，这三位女神经常会替我们做出选择，但是……在这件事上，我只能相信自己的直觉。"
    }
    {
      Id = "Melinoe_5218"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你不相信她们？她们的各种预言，以及新的时代……一概不信？"
    }
    {
      Id = "Odysseus_0609"
      InheritFrom = "BaseNarrative"
      DisplayName = "也不至于到那种地步，只是……我{#Emph}选择{#Prev}只相信我认识的、信任的人，哪怕在你的家族成员之间也是如此。如果这让我显得像个傻瓜，那我也认了。"
    }
    {
      Id = "Melinoe_5219"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“那我也认了？”{#Prev}听起来像是在“认命”哦。"
    }
    {
      Id = "Odysseus_0610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，你知道我是什么意思啦！"
    }
    {
      Id = "Melinoe_5220"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神预言中的新时代，据她们所说要{#Emph}“交给凡人做主”{#Prev}，我想她们指的是那些重大的决定……我们的暗灵对此有什么样的看法？"
    }
    {
      Id = "Odysseus_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听到过许多不同的视角，不过总体来说他们很有热情。真是不知好歹，对吧？我们能有今天，都是承蒙众神的恩泽。"
    }
    {
      Id = "Melinoe_5221"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许也不尽然是恩泽吧。这些暗灵中许多人早逝，都是因为众神的行为。他们不想再活在压迫之下了。"
    }
    {
      Id = "Odysseus_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "像这样的凡人，在哪里都会受到压迫；这压迫是否来自于众神，其实无关紧要。我知道，众神的脾气阴晴不定。但没有他们，我的旅程恐怕早就结束了。多亏他们，我才能站在这里。"
    }
    {
      Id = "Melinoe_5222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你愿意这样说真好。"
    }
    {
      Id = "Odysseus_0613"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是我的真实想法。我发誓。"
    }
    {
      Id = "Melinoe_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，我想跟你说，我一直很感谢有你为我解惑。你在我心中就像是我的哥哥。或者叔叔？我也分不清楚。“家人”这方面的感觉，你肯定比我更了解。"
    }
    {
      Id = "Odysseus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，家人不在身边的滋味，我也再熟悉不过了。我在凡间的日子里，很长一段时间都是在远离家乡的地方度过的。我不得不参加一场战争，然后又发生了一些插曲。"
    }
    {
      Id = "Melinoe_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}插曲？{#Prev}老师说过，你在海上度过了许多岁月。其中有些日子还有女神作伴。"
    }
    {
      Id = "Odysseus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，是的。等我终于返回家乡时，我连自己的妻儿都快要认不出了……不过我们之后安稳地度过了余生，这就足够了。他们现在应该在冥界某处过着舒适的生活吧。"
    }
    {
      Id = "Melinoe_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "你后来就再也没见过他们了吗？怎么回事？"
    }
    {
      Id = "Odysseus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "佩涅洛佩和我渐行渐远了。有的时候，凡人就是这样，而冥界的亡灵也不外如是。至于我的儿子，特勒马科斯，他有他自己的生活。人生就是如此，死后的生活也没有什么不同。"
    }
    {
      Id = "Melinoe_0455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实……"
    }
    {
      Id = "Odysseus_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "先跟你说一声，我在这里自怨自艾，女神。以前我还以为，我的一生算是圆满了！但你的那些旅程让我意识到，有很多东西我还没有机会讲述。太多了。"
    }
    {
      Id = "Melinoe_4219"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？为什么这会和我的旅程有关？以及，快停下你的自怨自艾……或者告诉我，怎么才能帮你停下。"
    }
    {
      Id = "Odysseus_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，你遇到了斯库拉和塞壬，遇到了独眼巨人波吕斐摩斯，遇到了巫术师喀耳刻……他们每一个，都以他们自己的方式给我留下了无法磨灭的印记；这还不算我的妻儿，也不知道他们现在身在何方。我觉得……我得去……"
    }
    {
      Id = "Melinoe_4220"
      InheritFrom = "BaseNarrative"
      DisplayName = "去{#Emph}哪？{#Prev}奥德修斯，你不能在这时候离开，我们需要你！一定有什么我们可以为你做的。"
    }
    {
      Id = "Odysseus_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔呃。可能有吧，但我——我不想给你负担。你承受得已经太多了。"
    }
    {
      Id = "Melinoe_4221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就跟我说说看吧。"
    }
    {
      Id = "Odysseus_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许……下次吧……"
    }
    {
      Id = "Odysseus_0563"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，我……又让自己的悲痛流露出来了。这些脆弱的时刻，比我预想得来的更频繁。我在想自己该做什么……在制定一个{#Emph}计划{#Prev}。"
    }
    {
      Id = "Melinoe_5101"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么了？你提到过斯库拉、波吕斐摩斯、喀耳刻……我还挺经常见到他们的，需要的话可以替你跟他们说点什么？"
    }
    {
      Id = "Odysseus_0564"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我无意让你那样做。不过，你跟我的羊拐骨袋联系足够深，也许我可以借此自己向他们传递信息。把我的信物带过去就好，剩下的就交给我，好么？"
    }
    {
      Id = "Melinoe_5102"
      InheritFrom = "BaseNarrative"
      DisplayName = "灵魂投射……我应该可以维持住一小会儿。你想去跟你那些旧识面对面么？"
    }
    {
      Id = "Odysseus_0565"
      InheritFrom = "BaseNarrative"
      DisplayName = "暂时就这样就好，女神。前提是这样帮助我不会让你偏离原本的目标。"
    }
    {
      Id = "Melinoe_5103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然不会。等我的好消息吧。"
    }
    {
      Id = "Odysseus_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "感谢你允许我去见那几位老熟人，女神。说实话，这样做什么也没有改变，但是……我感觉让我放下了一些事情。至于现在……我可能会离开一段时间……"
    }
    {
      Id = "Melinoe_5104"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里最近没什么大事……你尽管放心去就好，我们会永远欢迎你的归来。愿意告诉我你打算去哪里吗？"
    }
    {
      Id = "Odysseus_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "……去找我在凡间时的家人……我的妻子和儿子。我之前也去过。不过，这次可能不会去{#Emph}那么久{#Prev}。"
    }
    {
      Id = "Melinoe_5105"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想也是。到现在为止，冥界之中大大小小的道路，恐怕都已经画在你的地图上了！不过找到他们之后，你打算做什么呢？"
    }
    {
      Id = "Odysseus_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "我打算边走边想。与此同时，我安排了几位暗灵打理这里的事情，也已经私下跟女巫老大告别过了。愿我不在的时候一切顺利。"
    }
    {
      Id = "Melinoe_5106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一路顺风，奥德修斯……"
    }
    {
      Id = "Melinoe_5108"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都想你了，看到你回来真是太好了！你的旅途怎么样？找到你的家人了吗？"
    }
    {
      Id = "Odysseus_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，女神，我找到他们了。我到了至福乐土，顺着一些线索查了下去，遇到了两位曾经的战友，最后抵达了目的地。佩涅洛佩和特勒马科斯……呃，他们一眼就认出了我。"
    }
    {
      Id = "Melinoe_5109"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们都还好么？抱歉，我不是想逼你把这些细节都说出来，只是……这是你最新的冒险故事嘛！"
    }
    {
      Id = "Odysseus_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，这有什么好说的呢？就只是……好吧，其实让我很宽慰。我意识到，我们没有在一起度过的时间，某种意义上治愈了我们。聊到最后，他们还邀请我以后再去拜访。"
    }
    {
      Id = "Melinoe_5110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也觉得你该多去。很高兴事情进展得这么顺利。"
    }
    {
      Id = "Odysseus_0587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "本来有可能会很灾难的。"
    }
    {
      Id = "Odysseus_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可以向你倾诉些事情么，女神？我作为凡人的一生，从来都不想依靠任何人。但是，始终都有人帮助我……伟大的战士、水手，甚至神明！但就算这样……想为自己的私事向人求助，还是很难开口。"
    }
    {
      Id = "Melinoe_5081"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很能感同身受。这种时候往往会感觉自己很弱小……感觉自己无法做到该做的事。我们每个人都在努力完成自己的事，不想给战友增加负担。"
    }
    {
      Id = "Odysseus_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，我们其实知道自己并不弱小，但是……总得跟自己内心斗争一番，不是么？不过言归正传，我真正想说的是，谢谢你。谢谢你帮我的忙。你本来不用特意这样做的。"
    }
    {
      Id = "Melinoe_5082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是应该的。我们都一起走了这么远了。"
    }
    {
      Id = "Odysseus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，有的时候我会怀念雨水落在身上的感觉。然后我就会想起我在海上航行的日子，每天都浑身湿透，再然后便会感谢众神，现在狂风暴雨再也奈何不了我了。"
    }
    {
      Id = "Melinoe_2179"
      InheritFrom = "BaseNarrative"
      DisplayName = "雨水带来生命，也带来死亡……在像现在这样的夜晚中，带来的死亡更多。外面那些失落亡魂似乎也和你差不多，对这些雨水深恶痛绝。"
    }
    {
      Id = "Odysseus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，就好像他们被泡软了一样，对不对？等雨水好好“滋润”他们一番，我们再去“丰收”。帮我多消灭几个，好么？"
    }
    {
      Id = "Melinoe_2180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我觉得没问题。"
    }
    {
      Id = "Odysseus_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的羊拐骨袋有派上用场吗，女神？看起来肯定有点旧了，但是……它给我带来了不知道多少次好运，不管是在赌运气的游戏中，还是在我有性命之忧的时候。"
    }
    {
      Id = "Melinoe_4189"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，如果它在你的生命中这么重要，为什么现在要送给我呢？这和它现在有多少用处没有关系，不过话说回来，它确实很好用！"
    }
    {
      Id = "Odysseus_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "因为我最希望见到的事情，就是你的成功啊。既然来自我过往的小玩意对你有用，那肯定该让你拿去用才对。更何况，我还换来了一瓶蜜露呢！"
    }
    {
      Id = "Melinoe_4190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这不是一场交易啦。"
    }
    {
      Id = "Odysseus_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呀，你就把那袋羊拐骨收着吧。"
    }
    {
      Id = "Odysseus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到卡戎最新的那批货物了吗，女神？河边那一批，全是你的。我们会密切监视河边的一举一动，确保供应不会被切断。"
    }
    {
      Id = "Melinoe_2335"
      InheritFrom = "BaseNarrative"
      DisplayName = "卡戎大人这样直接地援助我，一定冒了很大的风险。我们有没有什么补偿他的办法？"
    }
    {
      Id = "Odysseus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "有，那就是把最近收集到的金币都交给他。他真的想要把克洛诺斯的金币统统熔掉，一枚不留。"
    }
    {
      Id = "Melinoe_2336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是这样的。"
    }
    {
      Id = "Odysseus_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定是卡戎最好的顾客。最近能这么频繁地造访冥界，想必他也会很享受吧。至少现在他主要是送货，而不是送那些搞不清状况、满腹牢骚的新暗灵上路……"
    }
    {
      Id = "Melinoe_4217"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你寿终正寝的时候，你有安然接受么，奥德修斯？感觉你像是会拼尽全力抓住最后一线生机的那种人。"
    }
    {
      Id = "Odysseus_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那时候我已经有些年纪了。不是说我很愿意去死啦，没有人愿意嘛！不过，最终有机会能和令人畏惧的冥界摆渡人相见，以{#Emph}正统{#Prev}的方式驶入冥界，还是不错的。"
    }
    {
      Id = "Melinoe_4218"
      InheritFrom = "BaseNarrative"
      DisplayName = "你之前提到过，在你活着的时候曾经进入过冥界。那次不是卡戎大人送你进来的么？"
    }
    {
      Id = "Odysseus_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然不是！以后哪天晚上有机会，再跟你讲这个故事吧。"
    }
    {
      Id = "Odysseus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，你那片小小的花园让这个古老的地方焕发了不少生机！在艰难的时代下，这种简单的慰藉往往最先不见踪影，而恰恰是这种时候它们最为珍贵。"
    }
    {
      Id = "Melinoe_3309"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你，大战术家，听到你这样想我很开心。不过，我没想到区区一片花圃也能给像你这样的人留下这么深刻的印象。"
    }
    {
      Id = "Odysseus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，见微知著可是我的第一特长。胜利总是属于那些做足了心理准备的人。看看我们，最不缺的就是斗志——而现在，就连用来庆祝胜利的花卉都准备好了！"
    }
    {
      Id = "Melinoe_3310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "替我照料好它们，好吗？"
    }
    {
      Id = "Odysseus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "Odysseus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在我们有几个扩建三岔路口的计划，女神，等你有机会的话可以看看有没有想要推进的。当然，一切按你的想法来，而且这也不是急迫的事情。"
    }
    {
      Id = "Melinoe_4222"
      InheritFrom = "BaseNarrative"
      DisplayName = "全部推进的话，需要净化温泉和钓鱼栈桥的水质，还需要修缮小酒馆。这三个计划里，你有希望能优先完成的吗？"
    }
    {
      Id = "Odysseus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，你是了解暗灵们的，他们喜欢聚集在小酒馆里，所以是我的话，就会从那里开始……但选择对你来说最方便的也没有问题！"
    }
    {
      Id = "Melinoe_4223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会去看看的。"
    }
    {
      Id = "Odysseus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们以前经常聊的那个翻新计划，你还记得么？我现在仍然常常会想象，三岔路口遍布凡人会享受的东西，该是多么美好的景象……！"
    }
    {
      Id = "Melinoe_3800"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有时也会想起那些，而且最近我还做了些初步计划。这里每个暗灵的身心健康，都对我们的目标举足轻重。"
    }
    {
      Id = "Odysseus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "不过，我们当下好像有更紧要的事务。你该不会打算专门和克洛诺斯休战，只为了改善一下这里的环境吧？"
    }
    {
      Id = "Melinoe_3801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然不是。我已经想好这件事要委托给谁去做了。"
    }
    {
      Id = "Odysseus_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有意思……"
    }
    {
      Id = "Odysseus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "你招募了那个飘忽不定的暗灵，让她来掌管翻新计划啊！虽然开始得磕磕绊绊的，但总比没有强。嗯……我很开心看到项目开工！"
    }
    {
      Id = "Melinoe_3802"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想着你就会这么说！这样一来，朵拉就可以有点事做了。而且这也意味着，翻新计划不再是个遥不可及的梦。"
    }
    {
      Id = "Odysseus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很棒的计划，女神。"
    }
    {
      Id = "Odysseus_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "这张新桌子真是太棒了！大到能放得下我们在监控的每个区域的地图，而且还有很多抽屉用来放报告，还有这精致细腻的做工……！"
    }
    {
      Id = "Melinoe_4215"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，没想到你会因为一件家具这么兴奋，更何况这是你履行职责的必需品。"
    }
    {
      Id = "Odysseus_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，这话说得我像个工作狂……但你对你工作的热爱，怎么看也不亚于我嘛。还是说，你只是名下从来没有过这么精美的工作桌？"
    }
    {
      Id = "Melinoe_4216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这么一说，我平常好像还真的不怎么用桌子。"
    }
    {
      Id = "Odysseus_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是你的损失！"
    }
    {
      Id = "Odysseus_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "乐师加入之后，三岔路口的气氛比以前活跃了很多！这位暗灵招募得好啊，女神。我一直对鼓舞人心的战歌情有独钟，但多听听各种风格的音乐也很不错。"
    }
    {
      Id = "Melinoe_4224"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就知道乐师用不了多久就会大受欢迎的。有什么你想点的歌吗？"
    }
    {
      Id = "Odysseus_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你不会想知道的。我还是把这种困难的抉择交给{#Emph}你{#Prev}吧！"
    }
    {
      Id = "Melinoe_4225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "后果也是我来承担咯。"
    }
    {
      Id = "Odysseus_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的卷宗管理员曾经在你父亲的冥府戒备森严的行政厅中任职，你能相信么，女神。一定是段相当独特的经历！"
    }
    {
      Id = "Melinoe_4226"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲一定很珍视像他一样擅长分析的人才。也许等这一切结束之后，卷宗管理员可以回到我父亲的冥府，继续他的工作。"
    }
    {
      Id = "Odysseus_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟卷宗管理员提起过这个，结果他不知道为什么，一下子就缩在原地瑟瑟发抖，之后就再也不搭理我了！那家伙有点古怪，对吧？"
    }
    {
      Id = "Melinoe_4227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定是经历的事情太多了。"
    }
    {
      Id = "Odysseus_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经连续外出执行任务五十个晚上了，女神。是不是可以找个机会让自己稍事休息一下？我只是有点担心你把自己逼得太狠了。"
    }
    {
      Id = "Melinoe_4202"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一路上有在休息，谢谢关心。温泉、花园、小酒馆……就连这样的对话都是放松！我又没有每时每刻都在逼自己达到极限啦。"
    }
    {
      Id = "Odysseus_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，如果一直把自己逼到极限，长此以往肯定会出事。不过，你已经取得了很大的进展，如果你自己没有意识到的话，我都帮你记着呢！"
    }
    {
      Id = "Melinoe_4203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "太好了。而且我还会走得更远。"
    }
    {
      Id = "Odysseus_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "这差不多是你执行任务的第一百个夜晚了，女神……按凡间的说法，已经过去几个月了。感觉是有段时间了，但又好像只是一瞬间的事。这就是克洛诺斯的阴险之处吧！"
    }
    {
      Id = "Melinoe_4204"
      InheritFrom = "BaseNarrative"
      DisplayName = "听你这么一说，我感觉很有道理！时间的流逝总是会让我感觉有些不对劲，自从这一切开始之后更是如此。你在凡间的时候也有过同样的感觉吗？"
    }
    {
      Id = "Odysseus_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊，你完全无法想象。对你们众神来说一定更加奇怪……一眨眼的功夫，就过去了那么长的时间！我们能做的，只有尽可能将其妥善利用。"
    }
    {
      Id = "Odysseus_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "根据我们的统计，你已经在超过50个夜晚中取得胜利了，女神。祝贺你取得了如此伟大的成就。"
    }
    {
      Id = "Melinoe_5447"
      InheritFrom = "BaseNarrative"
      DisplayName = "已经过去这么久了吗？时间运作的方式真是奇特。"
    }
    {
      Id = "Odysseus_0711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，这点到现在已经没有争议了。"
    }
    {
      Id = "Odysseus_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "自从这一切开始以来，已经过去了500个夜晚，女神。以凡人的角度而言，这是相当长的一段时间了。可能对你来说也不例外。"
    }
    {
      Id = "Melinoe_5448"
      InheritFrom = "BaseNarrative"
      DisplayName = "自某一刻开始，我就没有再数了，而且对于时间的流逝，我也早已不再刻意观察。你觉得到什么时候，我们该让这一切渐渐进入尾声？"
    }
    {
      Id = "Odysseus_0713"
      InheritFrom = "BaseSubtitle"
      DisplayName = "等到你想听下的时候；在那之前，不必有任何顾虑。"
    }
    {
      Id = "Odysseus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "来呀，女神！我正跟暗灵们讲我第一次来到冥界时的经历呢。你敢相信吗，那时候的我还活得好好的！而且我离开的时候也仍然是个活人。"
    }
    {
      Id = "Melinoe_2197"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，奥德修斯，在我父亲统治冥界的时候，这里可是无路可逃呢。这些暗灵真的这么好骗吗？"
    }
    {
      Id = "Odysseus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我可是{#Emph}认真的{#Prev}！只不过我的故事可能……没有听上去那么惊心动魄！不过现在，冥界已经门户大开了，不是么……？"
    }
    {
      Id = "Melinoe_2198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们会把冥界的门户重新封死的。"
    }
    {
      Id = "Melinoe_2197_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，奥德修斯。这些暗灵真的这么好骗吗？"
    }
    {
      Id = "Melinoe_5243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很快就要关上了！"
    }
    {
      Id = "Odysseus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！向你致意，女神，我……呃，我没注意到你过来了。我本来想说是上了年纪所致，但转念一想，我都已经是暗灵了，这样的借口未免太过牵强。"
    }
    {
      Id = "Melinoe_2199"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是故意惊到你的。这边氛围怎么样？一切都还好么？"
    }
    {
      Id = "Odysseus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "氛围很好，一切都好。听到冥界王女重现世间，誓要报仇雪恨的消息，有越来越多的暗灵受到鼓舞，加入了我们。"
    }
    {
      Id = "Melinoe_2200"
      InheritFrom = "BaseNarrative"
      DisplayName = "报仇雪恨的誓言最能鼓舞人心了。不过，你自己近况如何？"
    }
    {
      Id = "Odysseus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的状态好得很，尤其是在这里稍事休息之后。保重，女神。"
    }
    {
      Id = "Melinoe_2201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也是。"
    }
    {
      Id = "Melinoe_2118"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，你有见到赫卡忒吗？"
    }
    {
      Id = "Odysseus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}唔{#Prev}，有一阵子没见到她了耶，小小女神。不过，依我看，她那顶尖尖的帽子一定会暴露她的位置！"
    }
    {
      Id = "Melinoe_2119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会留意的！谢谢你！"
    }
    {
      Id = "Odysseus_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她肯定就在这附近，小小女神！"
    }
    {
      Id = "Odysseus_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在外面的暗灵……收集到了一些材料，虽然不多，但是我们觉得能在你那派上用场。来！只是一点点心意啦。"
    }
    {
      Id = "Melinoe_4093"
      InheritFrom = "BaseNarrative"
      DisplayName = "逝者之灰……奥德修斯，这些该不会是……？我们的暗灵情愿捐献出自己凡间的骨灰。只为了成就我们的志业。"
    }
    {
      Id = "Odysseus_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谁能怪他们呢？"
    }
    {
      Id = "Odysseus_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我还是个凡人的时候，青铜是我所知的最珍贵的金属，因为它能让凡人顷刻毙命。但我越来越理解你对银器的喜爱了！来吧，这个你收下！暗灵们不希望你推辞，我也一样。"
    }
    {
      Id = "Melinoe_4094"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的么？这么纯的银矿是很难获得的，即使有上好的工具也不例外。我会妥善利用的，为了我们所有人。"
    }
    {
      Id = "Odysseus_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们别无所求。"
    }
    {
      Id = "Odysseus_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一直在寻找能用在那口大锅里的材料，对么，女神？来，也许这些你用得上。有人告诉过我，这些可不是普通的花花草草。"
    }
    {
      Id = "Melinoe_4095"
      InheritFrom = "BaseNarrative"
      DisplayName = "新鲜的摩吕草！他们的根部还是黑的，完美。我正在构思的好几道咒语都能因此受益。你是怎么知道的？"
    }
    {
      Id = "Odysseus_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，我自有办法。"
    }
    {
      Id = "Odysseus_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "按你现在的速度，很快你就能超过女巫老大了，女神！至少我们的一些暗灵是这么说的，而且他们很有说服力。这个你收下！这代表了他们对你的信任。"
    }
    {
      Id = "Melinoe_4096"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们甘愿献出自己一部分魂魄，只为了帮助我完成一项我永远无法独自完成的任务……"
    }
    {
      Id = "Odysseus_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "幸运的是，你不需要独自完成！"
    }
    {
      Id = "Odysseus_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里有些东西要给你，女神。在我的家乡，人们一般不会喜欢把骸骨当作礼物，不过……你比一般的凡人更尊重亡者。"
    }
    {
      Id = "Melinoe_4097"
      InheritFrom = "BaseNarrative"
      DisplayName = "这么多骨骸！我一时半会儿都数不过来，自己找更是不知道要找多久。我这就把它们去送给残魂商人！"
    }
    {
      Id = "Odysseus_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要换点好东西来啊。"
    }
    {
      Id = "Odysseus_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是那种时刻纠结于命运三女神的编织的人，女神，不过……我碰巧有一块布匹，据说是她们的手笔。现在是你的了。"
    }
    {
      Id = "Melinoe_4098"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运丝线！要确保炼金釜能产生期望的魔法效果，没有比这个更管用的了。我一定会妥善使用的，谢谢你的好心。"
    }
    {
      Id = "Odysseus_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦，我不算是{#Emph}好心{#Prev}，我只是……不想输。"
    }
    {
      Id = "Odysseus_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "多美丽的夜晚啊，不是么？仰望夜空时，我们能瞥见月神乘车驶过夜空的身影。说到这个，她还给你留下了点东西呢。"
    }
    {
      Id = "Melinoe_4099"
      InheritFrom = "BaseNarrative"
      DisplayName = "是月尘。你肯定想不到我最近在冥想的时候有多需要这种东西……！不过，也可能你早就想到了，毕竟你料事如神，对么？"
    }
    {
      Id = "Odysseus_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少这一次，我是想到了啦。"
    }
    {
      Id = "Odysseus_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这里有些东西想送给你，女神。以备不时之需，比如那边的小花园需要一些点缀的时候……或者是你拿不定主意种什么的时候。"
    }
    {
      Id = "Melinoe_4100"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢了，奥德修斯！不过，这些是什么种子？我习惯把找到的种子都分类收好。"
    }
    {
      Id = "Odysseus_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "神秘种子！给你一点小惊喜。"
    }
    {
      Id = "Odysseus_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我们暗灵对你的魔宠可谓是赞誉有加。并不是所有动物都能和暗灵友善相处，所以……他们想用这份礼物来表达谢意！"
    }
    {
      Id = "Melinoe_4101"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫之宝，烹调的火候刚刚好。一定是老师亲手做的……她知道你们要把这个当作礼物送给我吗？"
    }
    {
      Id = "Odysseus_0376"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你收下就是了，女神，暗灵们都坚持！"
    }
    {
      Id = "Odysseus_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有一份礼物要献给你，女神！我谨代表这里所有的暗灵表示，能为你效力是我们的无上荣幸；为了胜利，我们甘愿付出任何代价！请收下这些佳酿，转赠给谁都没问题。"
    }
    {
      Id = "Melinoe_5230"
      InheritFrom = "BaseNarrative"
      DisplayName = "是蜜露，谢谢你们！感觉我简直像是个奥林匹斯神了。你们真的不介意我把这些礼物转赠出去吗？"
    }
    {
      Id = "Odysseus_0630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你要是囤着不用，暗灵们和我才会介意呢。"
    }
    {
      Id = "Hecate_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这个战术家，给我报告坏消息的时候，总要加上些乐观的修饰。好吧。那岛上的人们有什么消息吗，如果还有幸存者的话？"
    }
    {
      Id = "Odysseus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "据我的线人所说，很遗憾，他们都已经沦为了克洛诺斯的爪牙。这些凡人……他们总是对自己没有的东西耿耿于怀。这次，他们想要再经历一个“黄金时代”，哪怕只是个空口无凭的{#Emph}承诺{#Prev}也足够了。"
    }
    {
      Id = "Hecate_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不是什么承诺，而是个促使他们背叛的{#Emph}谎言{#Prev}。既然如此，等待他们的只有众神的怒火……真是自取灭亡。"
    }
    {
      Id = "Odysseus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "然后呢，他们扭曲的灵魂就会带着新仇旧怨卷土重来。我见过无休无止的战争，女士。你们这些神明也见过。我们该如何阻止这一切？"
    }
    {
      Id = "Hecate_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“我们”{#Prev}无法阻止。不过，{#Emph}墨利诺厄{#Prev}，你呢？你肯定可以，对不对？"
    }
    {
      Id = "Melinoe_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我可以的，一定可以。"
    }
    {
      Id = "Odysseus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "……呃，以上就是我本次汇报的全部内容了，女士。如果您有任何疑问，请不要犹豫，随时召我过来就好。"
    }
    {
      Id = "Hecate_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是自然，奥德修斯。不过，我还有另一件事想要与你探讨，而且最好避人耳目……"
    }
    {
      Id = "Odysseus_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然，女士。"
    }
    {
      Id = "Odysseus_0708"
      InheritFrom = "BaseNarrative"
      DisplayName = "……简而言之，修复工作正在进行中，不过不算快；地表受到的破坏也控制住了。这些伤口会慢慢愈合的，等到之后我们再来看哪里还留有疤痕吧。"
    }
    {
      Id = "Hecate_0881"
      InheritFrom = "BaseNarrative"
      DisplayName = "银月塞勒涅也作出了接近的判断。嗯，既然如此……你之后有什么打算，奥德修斯？趁着冥界还没有修复完成，你可以去地表走一走。"
    }
    {
      Id = "Odysseus_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我是有可能去逛逛，女士，但是……如果您愿意的话，我希望继续将三岔路口作为我目前的基地。我们之间的合作还挺愉快的，对吧？"
    }
    {
      Id = "Hecate_0882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我敢说，这点毋庸置疑。"
    }
    {
      Id = "Odysseus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我是说这不无可能。要永远保持高度警惕，基本上是天方夜谭。敌人总会在你放松警惕的那一刹那出手……我有没有跟你讲过那个经典的木马妙计？"
    }
    {
      Id = "Nemesis_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "木马妙计，耳朵都听烂了。你这位声名远扬的大战术家，总不会就这么一桩光辉事迹吧？"
    }
    {
      Id = "Odysseus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，但是经典就应该反复传唱嘛！不过，如果你想听别的故事，我还有好多与机智和勇气相关的事迹呢。比如说独眼巨人洞窟！"
    }
    {
      Id = "Nemesis_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别再讲独眼巨人洞窟了……"
    }
    {
      Id = "Odysseus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "在外面要小心，好么？"
    }
    {
      Id = "Odysseus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "准备好再战一回了吗，女神？"
    }
    {
      Id = "Odysseus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我要是克洛诺斯的话，一定会怕你怕得要死。"
    }
    {
      Id = "Odysseus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "这儿的一切都在掌控之中！"
    }
    {
      Id = "Odysseus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "保持勇气，女神。还有，对敌人绝对不能手下留情，好么？"
    }
    {
      Id = "Odysseus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "如你们女巫所言，“愿明月指引你”。"
    }
    {
      Id = "Odysseus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是一摊子麻烦事，是吧？"
    }
    {
      Id = "Odysseus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道事态看起来很严重，但不要失去希望。我们一定能找到出路。"
    }
    {
      Id = "Odysseus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么样，搞到克洛诺斯的项上人头了吗？"
    }
    {
      Id = "Odysseus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "替我好好戳一戳敌人的痛处，好么？"
    }
    {
      Id = "Odysseus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里没什么状况。我们等你回来。"
    }
    {
      Id = "Odysseus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "“克洛诺斯必死无疑”什么的，你懂的啦，对吧？"
    }
    {
      Id = "Odysseus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉失陪了，女神，我得立马把这份情报送到地表。"
    }
    {
      Id = "Odysseus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "你出去的时候，新的一批货物抵达了。"
    }
    {
      Id = "Odysseus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用管我，女神，我只是在忙着起草下一条计策。"
    }
    {
      Id = "Odysseus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "无论在地表还是冥界，都仍有许多人支持我们，愿意为你的父亲效力。"
    }
    {
      Id = "Odysseus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "出去替我杀几个背叛冥府的卑鄙小人，好么，女神？"
    }
    {
      Id = "Odysseus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "每次见到你都是我的荣幸，女神。"
    }
    {
      Id = "Odysseus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "欸，要是我们时不时可以像这样闲聊一阵子就好了，可惜我现在手上有事情要处理。"
    }
    {
      Id = "Odysseus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "梦魇女神就这样站在我面前，光彩照人……"
    }
    {
      Id = "Odysseus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "有什么需要都记得来找我哦，女神。"
    }
    {
      Id = "Odysseus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "一定要平安归来喔，不然我就得亲自出马把你扛回来了。"
    }
    {
      Id = "Odysseus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定会报仇雪恨的，女神。我深信不疑。"
    }
    {
      Id = "Odysseus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们早晚能从这个困境中脱身的，女神，放心吧。"
    }
    {
      Id = "Odysseus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你的巫术和银刃永远得心应手。"
    }
    {
      Id = "Odysseus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "谁知道命运三女神对我们有什么样的安排呢，对吧？"
    }
    {
      Id = "Odysseus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在身边时我总是很荣幸，女神。"
    }
    {
      Id = "Odysseus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这样的艰难时代，我们之间的情谊愈发坚定。"
    }
    {
      Id = "Odysseus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫老大对你很是骄傲，你知道的吧？"
    }
    {
      Id = "Odysseus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的暗灵会及时汇报你的进度的。"
    }
    {
      Id = "Odysseus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "再没有什么比被迫与家人分离更令人痛苦的了，是吧……？"
    }
    {
      Id = "Odysseus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的任务每一步都有我们的绝对支持，女神，无论我们需要多少个夜晚。"
    }
    {
      Id = "Odysseus_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连我也会时不时休息一下，你也应该这样！"
    }
    {
      Id = "Odysseus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是跟我们的暗灵在这里小酌几杯啦。"
    }
    {
      Id = "Odysseus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，我刚刚才意识到，我在小酒馆里也可以听报告！"
    }
    {
      Id = "Odysseus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "对一群死人来说，这里的气氛还挺活跃的，对吧？"
    }
    {
      Id = "Odysseus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到了吧，伙计们，我就说过她会来的！"
    }
    {
      Id = "Odysseus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里待一会儿吧，女神！这是你应得的休息。"
    }
    {
      Id = "Melinoe_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，奥德修斯，这个东西我想送给你。谢谢你一直以来对我的照顾！"
    }
    {
      Id = "Odysseus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神啊，能沐浴在你的荣光中，已经是我莫大的荣幸了。不过，既然你有礼物相送，那么或许你也愿意收下我这份微薄的回礼？"
    }
    {
      Id = "Odysseus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "感激不尽，女神。等我闲下来，就去酒馆把它消灭掉。"
    }
    {
      Id = "Melinoe_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用着急！什么时候喝都可以的，只要你能好好享受就行！"
    }
    {
      Id = "Odysseus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，看看这是什么！我怎么可能拒绝呢？看来你摸清我的软肋了啊，女神。"
    }
    {
      Id = "Melinoe_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "足智多谋的奥德修斯是没有软肋的，这点毋庸置疑！他只是多了一瓶蜜露而已。"
    }
    {
      Id = "Odysseus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "我应该向你献礼才对，女神。这些东西我一般会留到胜利之后再享用，不过有些存货也好，以备不时之需，你懂的。"
    }
    {
      Id = "Melinoe_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "我懂。而且你的友谊已经是无比珍贵的礼物了，奥德修斯……更何况你还有杀人不眨眼的聪明才智！"
    }
    {
      Id = "Odysseus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我算看出来你打的是什么算盘了，女神！你是想要针对我的弱点不断加以训练，直到我把它变成强项为止。好计策！"
    }
    {
      Id = "Melinoe_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "都是从你那学来的啦。愿你的弱点越来越少，强项越来越多。"
    }
    {
      Id = "Odysseus_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，我这一生四处漂泊，见过伟大的凡人，也见过比凡人更伟大的神明。但……就连我当时也没有想到，我有朝一日会站在这里，从女神你的手中接过如此珍贵的礼物。"
    }
    {
      Id = "Melinoe_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "人们常说，人生在世，运势无常；现在看来死后也一样嘛，奥德修斯。无论命运三女神给我们安排了什么样的挑战，我都希望能有你在身边，为我出谋划策。"
    }
    {
      Id = "Odysseus_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个嘛，我确实喜欢旅行，不过……我觉得，你永远会知道该怎么找到我的。谢谢你的蜜露……应该足以让我在未来的挑战中振作起来了。"
    }
    {
      Id = "Melinoe_5083"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你现在没有特别忙的话，要不要去一趟小酒馆？这里有瓶仙酒等着你开呢！"
    }
    {
      Id = "Odysseus_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你的好意，可是，纵使千不甘万不愿我也得承认，现在有太多报告等待我审阅了。最近发生了很多事。所以……晚点再说？"
    }
    {
      Id = "Melinoe_5084"
      InheritFrom = "BaseNarrative"
      DisplayName = "要不你先留着这瓶仙酒？等到晚点你有空，就把它消灭掉。愿意的话，还可以把你的暗灵线人们都带上！"
    }
    {
      Id = "Odysseus_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，这是个好主意！只怕他们喝上一口就会沉醉其中，再也不肯帮我做事了。不过那也就意味着，我会有更多的时间泡在小酒馆里……"
    }
    {
      Id = "Melinoe_5085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "完美的计划……！"
    }
    {
      Id = "Melinoe_5092"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿意一起去小酒馆度过一个高效的夜晚，激发人们的忠心吗？我很喜欢我们在那里的对话呢。"
    }
    {
      Id = "Odysseus_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很想说“那我们立刻动身吧”，但我只能说，我在等一个探子的报告，应该很快就回到了，所以我暂时走不开……而且，我也打算……减少一些去小酒馆的频率。"
    }
    {
      Id = "Melinoe_5093"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢！抱歉。反复这样诱导你离开你的岗位，真的不是我的本意。"
    }
    {
      Id = "Odysseus_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "和你做的事没关系，只是……我见过那种没日没夜饮酒作乐，抛弃理智的人。我发过誓，永远不能那样放纵自己。永远要留有一些尚未满足的愿望。"
    }
    {
      Id = "Melinoe_5094"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白这种感受。渴望是一种驱动人前进的力量。不过，把这瓶仙酒留给你的探子如何？作为出色完成任务的奖励。"
    }
    {
      Id = "Odysseus_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "高明的战术。我会跟他说，这是冥界王女亲自奖励的！"
    }
    {
      Id = "Melinoe_5095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不如说是我们一起送的。"
    }
    {
      Id = "Odysseus_0556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈。那就听你的。"
    }
    {
      Id = "Melinoe_3342"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你现在没有特别忙着处理报告的话，我们一起去好好享用这瓶仙酒如何？"
    }
    {
      Id = "Odysseus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神，我确实在忙着处理报告呢！正在专注于最重要的部分……在酒馆稍等我一下吧。"
    }
    {
      Id = "Odysseus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我们凡人有一种叫做{#Emph}葡萄酒{#Prev}的东西，是一种由{#Emph}碾碎的葡萄{#Prev}制成的酸苦饮料。我们有时会夸口称，那种饮料能与仙酒媲美，可是……其实是天壤之别。"
    }
    {
      Id = "Melinoe_3343"
      InheritFrom = "BaseNarrative"
      DisplayName = "你常常提起在凡间生活的种种艰辛，但是我总能感受到，你的话语之中又有种向往……你想念那时候的生活，不是么？"
    }
    {
      Id = "Odysseus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "……确实偶尔会有这样的时候。我现在知道的比那时候多多了，而……而有的时候，我会想念那种感觉……那种知之甚少的感觉。又或者是怀念我和我的水手之间的情谊了。"
    }
    {
      Id = "Melinoe_3344"
      InheritFrom = "BaseNarrative"
      DisplayName = "但是你当年的水手现在也有很多在继续为你效力啊，不是么？就连你那只老狗的暗灵都在呢。既然他们在你身边，你还有什么要想念的呢？"
    }
    {
      Id = "Odysseus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是暗灵，女神，而且……他们并非都像我这样“完整”。况且，就算现在仍然认识对方，也可以怀念过去啊！还记得你小的时候跟女巫老大玩躲猫猫的情景吗？那时候你才那么小一点！"
    }
    {
      Id = "Melinoe_3345"
      InheritFrom = "BaseNarrative"
      DisplayName = "我那时候从来没觉得自己是在玩；她是在教我狩猎看不见的敌人呢。不过，我理解你的意思啦。"
    }
    {
      Id = "Odysseus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我最初想说的其实只是，这瓶仙酒真是{#Emph}美妙绝伦{#Prev}！让我们确保不要把它浪费掉吧。"
    }
    {
      Id = "Odysseus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "我都没有意识到，我真的很需要这样放松一下。传说没有说错，有好友作伴，仙酒的味道确实更加甜美啊。"
    }
    {
      Id = "Melinoe_0769"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是当然啦。"
    }
    {
      Id = "Melinoe_5086"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜的报告处理得怎么样了，或者我换种问法，你有空去小酒馆休息一会儿么？"
    }
    {
      Id = "Odysseus_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实刚好有这么个机会，既然女神你提出来了，那我就恭敬不如从命啦。我们现在出发？"
    }
    {
      Id = "Odysseus_0548"
      InheritFrom = "BaseNarrative"
      DisplayName = "……这些暗灵有许多都曾与我并肩作战，你知道么。他们生前忠心耿耿，死后也一样……你觉得这是从哪来的呢？我是指忠诚。"
    }
    {
      Id = "Melinoe_5087"
      InheritFrom = "BaseNarrative"
      DisplayName = "拥有某种目标，或者是使命感。再加上最基本的对稳定性和真相的追求。忠诚就意味着始终如一。"
    }
    {
      Id = "Odysseus_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说得都对，但对我来说更简单！忠诚来自于个人。就好像是爱的一种；有人付出爱，有人获得爱，有时是双向的，有时则不是。"
    }
    {
      Id = "Melinoe_5088"
      InheritFrom = "BaseNarrative"
      DisplayName = "老师一直教导我，永远不要要求别人忠诚。“若是不能基于信任，忠诚便会摇摇欲坠。”她是这么说的。你的暗灵追随你，是出于忠诚还是出于义务？"
    }
    {
      Id = "Odysseus_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯！两者皆有吧。女巫老大说得对，最好的忠诚往往是自愿的。我想你所激发的，就是那种忠诚，女神；你和你老师都是。不然的话，我也不会在这里呆这么久。"
    }
    {
      Id = "Melinoe_5089"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯肯定也能用得到你的聪明才智和丰富阅历。他立下了那么多对于黄金时代的诺言，一定也博取到了许多忠诚吧。"
    }
    {
      Id = "Odysseus_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "我试过为暴君效力；那样的生活不适合我。现在，不如我们就借此机会，多激发一些忠心吧？让暗灵们都过来，和我们一起喝上一轮。"
    }
    {
      Id = "Odysseus_0552"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们怎么在休息时，也能完成这么多事？总之，暗灵们都很感激！我也一样。"
    }
    {
      Id = "Melinoe_5091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有机会应该再来一次！"
    }
    {
      Id = "Melinoe_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，我搞到了双份的鱼饵，而且一个人用不完。你知道该怎么做吧！"
    }
    {
      Id = "Odysseus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "钓鱼！这可是我的一大弱点，女神！我和所有沾水的东西都不太对付，不过也许现在会好一点。况且，我也是时候稍微休息一下了。走吧！"
    }
    {
      Id = "Odysseus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "曾经的我钓鱼只是为了能吃上饭。大地往往非常吝惜她的恩赐，而大海则愿意为凡人送上许多收获，只要我们知道该去何处寻找。"
    }
    {
      Id = "Melinoe_3322"
      InheritFrom = "BaseNarrative"
      DisplayName = "那现在和那个时候相比，对你来说最大的区别是什么呢？不用再为了维生进食？不用再看着自己的身体随着时间日益衰老？"
    }
    {
      Id = "Odysseus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，可不是么！如果我们要列个清单的话，你已经帮我列出其中的好几条了。不过……如果一定要我选一个的话，最大的区别……是我终于自由了吧。"
    }
    {
      Id = "Melinoe_3323"
      InheritFrom = "BaseNarrative"
      DisplayName = "你终于自由了？可是你在凡间的时候，不是国王么？一位强大的战士、人类的领袖……而且还是妻子的丈夫、儿子的父亲！在这里你也有受人景仰的地位，只不过……我们潜伏在阴影之中。我们的事迹永远不会被人传诵。"
    }
    {
      Id = "Odysseus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，最后一点恐怕现在还不好说，不过至于其他的嘛！也许我在活着的时候就已经把我的漫游欲宣泄一空了。至少宣泄掉了大部分！"
    }
    {
      Id = "Odysseus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "我非常享受这次休息时光，但我还是非常讨厌鱼。"
    }
    {
      Id = "Melinoe_5096"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我们再去一次钓鱼栈桥怎么样？距离上次去已经有段时间了，而且耐心地站着总不像啜饮仙酒那么放纵，对吧？"
    }
    {
      Id = "Odysseus_0557"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的论点很有说服力，女神！而且，我也该去努力克服一下我对水的恐惧了。你先过去吧，我随后就到。"
    }
    {
      Id = "Odysseus_0558"
      InheritFrom = "BaseNarrative"
      DisplayName = "……顺便一提，我有件事想告诉你。我们一起度过的这些时光，我都很享受，只是……我不希望其他的暗灵产生误会。"
    }
    {
      Id = "Melinoe_5097"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是指哪方面的误会呢？喔，你是指他们身为凡人的刻板印象。一个男人和一个女神待在一起，只能意味着一件事。只会有一种结果。"
    }
    {
      Id = "Odysseus_0559"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，确实，但这种刻板印象根植于历史事件之中……也包括我的那些故事。而且，虽然我们的暗灵很忠诚，但他们确实喜欢八卦，这点我们是知道的。"
    }
    {
      Id = "Melinoe_5098"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许吧。但就算真的八卦，他们也该八卦你和老师，而不是和我。"
    }
    {
      Id = "Odysseus_0560"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}什么？{#Prev}哦，拜托，女巫老大和我……我们就像……啊，可恶，一定有什么合适的比喻才对……"
    }
    {
      Id = "Melinoe_5099"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不是故意说到这份上的啦，只是……就，像你这样的人愿意效忠我老师，背后的原因可能有很多嘛。而你让我老师如此信任，也是同样的道理。"
    }
    {
      Id = "Odysseus_0561"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，你就和那些暗灵一样八卦，唯一的区别是我还没法把你赶走。好啦，咱们现在是不是该钓点鱼了，你说呢？"
    }
    {
      Id = "Odysseus_0562"
      InheritFrom = "BaseNarrative"
      DisplayName = "……啊。能像这样谈天说地，而不是时时刻刻都要给出建议，感觉真舒服，所以谢谢你的邀请，女神。不过，你跟我说的话就别跟女巫老大说了，好么……？"
    }
    {
      Id = "Melinoe_5100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不会的啦，不会的啦……"
    }
    {
      Id = "Melinoe_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "我刚才在想，没什么比在热腾腾的泉水里泡上一泡更令人心旷神怡的了。有兴趣一起来吗？"
    }
    {
      Id = "Odysseus_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个嘛，我确实喜欢洗热水澡，哪怕是在死后也一样，而且我又怎么能拒绝一位女神呢……？所以，有何不可！"
    }
    {
      Id = "Odysseus_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白你们的习俗和我们的不太一样，不过我还是会看向别处，如果你不介意的话。"
    }
    {
      Id = "Melinoe_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡人会经常{#Emph}洗澡{#Prev}么，奥德修斯？"
    }
    {
      Id = "Odysseus_0657"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，呃，这个嘛……也许有机会的时候，隔一段时间会洗一次吧。不过他们很少会像这样男女共浴啦。在他们眼里会有点……不成体统。"
    }
    {
      Id = "Melinoe_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "原来如此。我们这些神好像没有这样的顾忌。这样会不会让你有点不太舒服？"
    }
    {
      Id = "Odysseus_0658"
      InheritFrom = "BaseNarrative"
      DisplayName = "我吗？不，不，当然没有啦！事实上，我以前也和别的女神洗过澡，只不过……是很久之前的事了。"
    }
    {
      Id = "Melinoe_5242"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没关系，你肯定能想得起来其中美好的部分的。只要试着放手，别让自己背负那么多东西就好了。"
    }
    {
      Id = "Odysseus_0659"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个应该不难，因为我背负的东西可太多了！事实上，不管我怎么放手，有些东西就是撒不开。不过，在这里泡一泡，确实很有帮助。"
    }
    {
      Id = "Melinoe_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……只要你泡得开心就好啦。"
    }
    {
      Id = "Odysseus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！不知道你感觉怎么样，反正我是泡爽了！"
    }
    {
      Id = "Melinoe_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我在想，是时候去温泉里好好泡一泡了。你愿意跟我一起吗？"
    }
    {
      Id = "Odysseus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "去泡澡？和你一起？现在？{#Emph}哈！{#Prev}没问题！能与你同行是我的荣幸，女神。"
    }
    {
      Id = "Odysseus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "这温度还可以吧？"
    }
    {
      Id = "Melinoe_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在凡间的时候见过许多女神，对吧……？"
    }
    {
      Id = "Odysseus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这方面，我确实非常幸运。雅典娜女神常常对我格外关照。要不是她的话，我恐怕活不过那场大战。然后，在归家的旅途中，我又遇到了卡吕普索……还有喀耳刻……"
    }
    {
      Id = "Melinoe_3217"
      InheritFrom = "BaseNarrative"
      DisplayName = "喀耳刻曾经在老师手下学习过，去哪里都带着她的水晶。至于卡吕普索……她是个宁芙，对么？应该算是个弱小一些的女神吧。"
    }
    {
      Id = "Odysseus_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "容我指正一下，她身上可没有任何“弱小”的地方。这些女神，她们……每一位都以自己的方式令我流连。我几乎忘记了自己，忘记了自己的家人。"
    }
    {
      Id = "Melinoe_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "但你没有忘记。你最后回到了家里。这个故事就连我都知道。"
    }
    {
      Id = "Odysseus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "那只是个故事，女神。总而言之，生活就是这么反复无常。经验之谈。"
    }
    {
      Id = "Odysseus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，真是美好的时光，我太需要像这样放松一下了。非常感谢你的邀请。"
    }
    {
      Id = "Melinoe_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥德修斯，要不要一起去温泉，缓解一下制定战略计划的疲劳？"
    }
    {
      Id = "Odysseus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，真的很感谢你的邀请，女神，只不过……我觉得你老师可能更希望我留在这里。你能理解的，对不对？"
    }
    {
      Id = "Melinoe_0461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "也许下次吧。"
    }
    {
      Id = "Melinoe_1156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "奥德修斯不在……"
    }
    {
      Id = "Melinoe_2412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看来奥德修斯查看报告去了……"
    }
    {
      Id = "Melinoe_2413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一定是别的地方需要奥德修斯……"
    }
    {
      Id = "Melinoe_1157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "奥德修斯外出了……？"
    }
    {
      Id = "Melinoe_2899"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你最信赖的羊拐骨？谢谢你！"
    }
    {
      Id = "Odysseus_0566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "斯库拉与塞壬……"
    }
    {
      Id = "Odysseus_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "该死……"
    }
    {
      Id = "Odysseus_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这场我们势在必得！"
    }
    {
      Id = "Odysseus_0440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不惜一切代价。"
    }
    {
      Id = "Odysseus_0441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "为我们添几分胜算。"
    }
    {
      Id = "Odysseus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "为生存而战！"
    }
    {
      Id = "Odysseus_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "夺取胜利！"
    }
    {
      Id = "Odysseus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们永不迟疑！"
    }
    {
      Id = "Odysseus_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊嚯，又见面了，斯库拉！"
    }
    {
      Id = "Odysseus_0446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还记得我吗，独眼巨人？"
    }
    {
      Id = "Odysseus_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "女神，干掉他！"
    }
    {
      Id = "Odysseus_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "上吧，你能行！"
    }
  ]
