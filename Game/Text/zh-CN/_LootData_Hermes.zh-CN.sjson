    }
    {
      Id = "MelinoeField_2002"
      InheritFrom = "BaseSubtitle"
      DisplayName = "赫尔墨斯……！"
    }
    {
      Id = "Melinoe_1161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "奥林匹斯众神……需要我前往地表？"
    }
    {
      Id = "Hermes_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦！"
    }
    {
      Id = "Hermes_0159"
      InheritFrom = "BaseSubtitle"
