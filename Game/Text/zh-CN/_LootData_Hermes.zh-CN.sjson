    }
    {
      Id = "Hermes_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……嗯，就是这样。"
    }
    {
      Id = "Hermes_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈！"
    }
    {
      Id = "Hermes_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃！"
    }
    {
      Id = "Hermes_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯！"
    }
    {
      Id = "Hermes_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦！"
    }
    {
      Id = "Hermes_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这次好像一路磕碰，伤得不轻啊，墨！走路要看脚下啦，虽然我知道赶时间的时候，确实没那么容易做到！"
    }
    {
      Id = "Hermes_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚不太顺利，是不是，墨？坚持住哦，以及，说不定这个能帮你走得更快更远！"
    }
    {
      Id = "Hermes_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，不！你受伤了！发生什么事了，墨？爷爷一定是比我动作还快！这怎么可能……？"
    }
    {
      Id = "Hermes_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里真不适合旅行，对吧，墨？不过，挂了点彩而已，也没什么的嘛！现在，让我为你加加速吧！"
    }
    {
      Id = "Hermes_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，墨！听说你又要出门了，我就想过来打个招呼，祝你一路顺风，之类的！"
    }
    {
      Id = "Hermes_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "任重道远啊，对不对，墨？看看这个能不能为你省点时间，让你更快抵达！"
    }
    {
      Id = "Hermes_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "正想在你出门的时候遇上你呢！旅程中是会很有收获，没错，但有的时候，更重要的还是尽快抵达需要你的地方！"
    }
    {
      Id = "Hermes_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "又踏上起跑线了，对吗，墨？那么，要做好准备了哦，因为你很快就会抵达终点的！当然前提是你得活下来啦……"
    }
    {
      Id = "Hermes_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨，我永远不想拖慢你的脚步，尤其是在你刚刚启程的时候！所以快选，选好了就上路吧！"
    }
    {
      Id = "Hermes_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是你以为不拿我的祝福就能溜掉，那你就大错特错了，墨！准备好了吗，要加速了哦！"
    }
    {
      Id = "Hermes_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "受够地表的空气了，我懂的，墨。更熟悉的路往往走得更顺！不管怎么说，按照自己的步调来啦。别让任何人催你加速！除了我哦。"
    }
    {
      Id = "Hermes_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "你让爷爷认清谁才是老大啦！{#Emph}做得好，墨！{#Prev}这次应该让他栽了个跟头。所以现在正是前来地表，把他的军队从我们这轰出去的大好时机。你说呢？"
    }
    {
      Id = "Hermes_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷不好对付，这点并不意外，但昨晚你输在他手上，还是很可惜。谢谢你这次愿意来{#Emph}我们{#Prev}这边！时间一时半会儿不会怎么样，但我们这座山可就不好说了！"
    }
    {
      Id = "Hermes_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦太好了，你往这边来了，而且还没走远！我可以让你大步流星，一转眼就赶到我们身边，不过选择权在你！"
    }
    {
      Id = "Hermes_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你没办法一直呼吸我们地表的空气，墨，所以在出发时找到你真是太好了！一转眼的功夫，你就能登上我们的山顶了。"
    }
    {
      Id = "Hermes_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨，我知道来一趟很不容易，甚至对你来说还不太现实。但是想象一下，咱们的家人愿意放下面子，寻求帮助，这是多么稀奇的事！现在事态真的很严重！"
    }
    {
      Id = "Hermes_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在事态紧急，墨，我们既需要你杀入冥界最深处，也需要你来支援奥林匹斯山！我很同情你啦，必须同时出现在两个地方。告诉你个{#Emph}秘诀{#Prev}：只要跑得非常快就可以！"
    }
    {
      Id = "Hermes_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次你在下面走了很远！做得好，墨，我就知道你行！但爷爷还是不肯罢休，是吗？也许至少可以让他再好好想想吧！"
    }
    {
      Id = "Hermes_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真的帮我们扭转了局面耶！你为我们解了围，让家人们都喘了口气。当然，这一切还没结束啦，但我觉得应该就快了！"
    }
    {
      Id = "Hermes_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们真的打败他了，墨！提丰耶！我看他从山上背光那面滚了下去，一直滚到山底，然后，{#Emph}轰！{#Prev}后来我还看到他慢慢站起来，咆哮的声音也更愤怒了，但那又如何！"
    }
    {
      Id = "Hermes_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山之前也被围攻过！一般来说，不是什么大事啦。但这次爷爷另有打算。这里有些人现在害怕得很呢！"
    }
    {
      Id = "Hermes_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看到我们在山顶为你留的物资了，对吧，墨？对我的同事来说，那里是远了点，但我们还是会保证你补给充足！"
    }
    {
      Id = "Hermes_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认识你老师好一阵子了，你们两个都够可怜的啦。她总不能不等你准备好，就派你去跟爷爷交手！而你又肯定很{#Emph}讨厌{#Prev}等待。我最讨厌等待了！"
    }
    {
      Id = "Hermes_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "你老师总跟我说，你学得很快，你知道吗？而且每次我路过的时候，都看到你趴在炼金釜前，学着某个新的咒语。那么，这就是你的{#Emph}机会{#Prev}了！学以致用、帮助我们的机会！"
    }
    {
      Id = "Hermes_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "时间泰坦，真是个难伺候的主！我没见过爷爷，但是能想象他是什么样的人。以前我总是好奇，为什么老爸和伯伯们有的时候那么捉摸不定。现在我知道他们的臭脾气是从谁那来的了！"
    }
    {
      Id = "Hermes_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还以为时间泰坦不会这么执着于过去，想要重现什么{#Emph}“黄金时代”{#Prev}呢！据说那时候在他统治下，凡人们都过着无忧无虑的生活？可是有点忧患意识也不坏嘛！"
    }
    {
      Id = "Hermes_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你没可能立刻阻止爷爷，但你这样夜复一夜去找他，恰恰为我们提供了些时间，让我们可以打乱他的计划。谢谢你哦！"
    }
    {
      Id = "Hermes_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "有些神明居然觉得，厄里斯在我们那座山附近再次现身搞破坏都是因为你！他们不知道我几乎是{#Emph}求着你{#Prev}过来搭救我们的，还以为是你老师下的命令！这下好了……"
    }
    {
      Id = "Hermes_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨，我们的泰坦问题比预想的严重。如果连普罗米修斯爷爷都能拉拢，那谁知道下一个是谁。我们真是惹毛了不少人哦！"
    }
    {
      Id = "Hermes_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "事实表明，普罗米修斯和赫拉克勒斯关系不错，是吗？你和他们过招的时候周围黑不溜秋的，但我还是看到了一点。我需要知道这些事情，但不意味着我会告密！"
    }
    {
      Id = "Hermes_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "上次你差点就登上最高处了。虽然我不想破坏你的惊喜，但你{#Emph}得知道{#Prev}，我们要对付的是众魔之父提丰！是不是棒极了……？我们需要你尽快赶回来，墨。"
    }
    {
      Id = "Hermes_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "好消息是，现在我们都知道爷爷打的是什么算盘了。坏消息是，这算盘就是提丰，而且他超级大。但我爸爸阻止过他一次，所以应该也不会很难……？"
    }
    {
      Id = "Hermes_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得谁会先爬到奥林匹斯山的山顶，墨？是你，还是老提丰？和他相比你要走的路长得多，但你的速度绝对比他快！至少，马上就要比他快了！"
    }
    {
      Id = "Hermes_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰彻底被干掉了？！我爸还是不太相信，但自从你上次打败那个魔物之后，这里就再没有他的踪迹了！不过{#Emph}我{#Prev}有什么好惊讶的呢？我一直都觉得，要是有人能做到这种事，那一定得是{#Emph}你！"
    }
    {
      Id = "Hermes_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "你老师告诉我，倪克斯之子摩罗斯现在在你们那暂住？我还以为他永远不会离开命运三女神呢。一定有什么事情发生了，墨，而且我感觉很不妙。"
    }
    {
      Id = "Hermes_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在下面找到你爸啦，墨！我自己始终没办法靠近那里，希望他没什么大碍啦。希望{#Emph}大家{#Prev}都没什么大碍！我们一定会把他们救回来的，不达目的，决不罢休。"
    }
    {
      Id = "Hermes_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "昨夜你在路上偶遇了喀耳刻女士，是吗，墨？她用起来魔法很有天赋呢。比如她很喜欢把凡人变成各种各样的东西！要我说的话，有点{#Emph}不友好{#Prev}呢！"
    }
    {
      Id = "Hermes_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "名义上来说，我是在监视你哦，你不该知道的，所以你先知道一下。我会向奥林匹斯山汇报{#Emph}所有{#Prev}新进展，当然，太隐私的内容我是不讲的啦。然后我转头就会告诉你更多！这样说来，我大概算是在监视所有人吧！"
    }
    {
      Id = "Hermes_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "你任务开始之后的这几个晚上，我打探到的唯一的消息就是，爷爷抓住了些人，而他相信这些人能让他占尽上风。现在他正在准备计划的下一部分，就是把这座山夷为平地！我得赶紧走了。"
    }
    {
      Id = "Hermes_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "你妈妈常常在奥林匹斯山和冥府间来往，而{#Emph}我{#Prev}很荣幸，负责接送她！有一天，她突然没出现。那时候我就知道，事情不太对劲……"
    }
    {
      Id = "Hermes_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些事情让我想起我帮你哥找你妈妈的那段日子！虽然我是会从结果中获利啦，但是还没等我反应过来，就突然发现自己发自内心地关心他们了！我们会找到办法解救他们的，对吧，墨？"
    }
    {
      Id = "Hermes_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯以前跟我不算太熟，我们基本上是各走各的路。但是后来跟你和你老师共事，让我们更亲近了！我们最近都忙着躲别人，知道我们至少不用躲彼此，还是很让人宽心的！"
    }
    {
      Id = "Hermes_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经跟阿尔忒弥斯联系上了，很好！我和她不总是有工夫聊天，因为我们都要四处跑，还要保持隐匿之类的。但我们时不时就会交换个互相理解的眼神！"
    }
    {
      Id = "Hermes_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "你遇到某个冥河摆渡人划船经过的话，帮我跟他说一声“嘿”，好吗？我们好久没一起合作了，都是最近这些事害的。真想念往日啊！"
    }
    {
      Id = "Hermes_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以摆渡人过得不错，是吗？那就好！我知道他帮你老师照顾你们很久了，不过你们也要照顾好他哦，好吗？"
    }
    {
      Id = "Hermes_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "遇到大块头赫拉克勒斯了，是吗？我的继母又派他去忙什么差事了。总感觉他一副心不在焉的样子。但至少他很壮！而且我们也刚好需要帮忙。"
    }
    {
      Id = "Hermes_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以爷爷不知道用了什么办法，把命运三女神给抓住了！真是糟糕，不知道我们能做些什么，墨。至少现在整座奥林匹斯山都听说了，我觉得也是时候告诉大家了！搞得我们都有点紧张，但是我们都掩饰得蛮好！"
    }
    {
      Id = "Hermes_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "至少现在全家人都知道你的存在啦！我一直都想跟大家伙说，{#Emph}给奥林匹斯山的消息！珀尔塞福涅和哈迪斯还有个孩子！而且她活得好好的！{#Prev}但你老师知道，我们得等待时机，而且她知道的可多了！所以我一直守口如瓶。"
    }
    {
      Id = "Hermes_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "真难以想象，我曾经每天的生活就是把刚死掉的凡人丢到你爸的领地里！说实话，我很快就喜欢上那活了，以至于在爷爷接管之后，我还是会忙里偷闲，时不时去冥界看一看！"
    }
    {
      Id = "Hermes_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上来地表啦，墨！我本来想为你加个速的，但这里的环境会让你{#Emph}很难受{#Prev}。冥界的人，地表的空气，两不相容！我们一定有什么能做的，对吧……？"
    }
    {
      Id = "Hermes_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，我知道上地表对你很困难，墨，但是别这么快抛下我们。当然我知道你{#Emph}永远{#Prev}做不出这种事啦。也许你只是在寻找你需要的魔法材料之类的？"
    }
    {
      Id = "Hermes_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，墨，不知道你到底干了什么，或者也许是你老师干的，但你现在看起来比上次正常多了。太好了！因为要一路杀到这边，肯定需要你使出{#Emph}全力{#Prev}。以及{#Emph}全速！"
    }
    {
      Id = "Hermes_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，墨，你来了！太好了！你老师说你甚至找到办法搞定了你的冥脉诅咒，所以你已经准备好来一场长跑啦。注意路边的绊脚石就好，不过可以的话，先让我为你加个速吧！"
    }
    {
      Id = "Hermes_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "埃费拉城的亡灵本来该在你爸的地盘安息，但爷爷害得一切都关停了，还让冥界敞开大门，然后就成这样子啦。如果我死掉的话，看到这个场面，我也会气得活过来的。"
    }
    {
      Id = "Hermes_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "你终于见到这里的景象啦！其他神基本都在奥林匹斯山顶坚守呢，而{#Emph}你{#Prev}就是我们的援军。所以，有空就多往这边来哦，好吗？"
    }
    {
      Id = "Hermes_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "你前往冥府选的这条路风景真好！爷爷把冥界的重要区域都封锁了，所以……嗯，好像这样做还挺有道理的！"
    }
    {
      Id = "Hermes_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是我可以带着你飞越波塞冬劈开的大裂谷就好了。可是我们{#Emph}绝对不能{#Prev}被他们发现合作得这么紧密。再说了，你扫荡的每一艘船，都是在帮我们的忙！所以{#Emph}谢啦！"
    }
    {
      Id = "Hermes_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "爷爷把军队派来奥林匹斯山，我们可以把它们再送回去，这没问题。但是他好像还有别的计划，不管这计划是什么，都好像很大阵仗的样子。有什么发现的话，要立刻报告给你老师哦。"
    }
    {
      Id = "Hermes_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜已经跟我爸联系上了，是吗，墨？他一直是个大忙神，但他从来不会累。现在你有了他闪电的力量，不如再来一些闪电般的速度吧！"
    }
    {
      Id = "Hermes_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，我觉得我继母好像很喜欢你！这很难得的，别不当回事！虽然生育这方面归她管，但我一直感觉我们的王后大人不怎么待见小孩子。"
    }
    {
      Id = "Hermes_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "波塞冬伯伯的祝福今晚有帮到你什么忙吗？他总喜欢夸口说，得了他的祝福简直天下无敌，但以免万一，还是给你上个旅途意外保险吧！"
    }
    {
      Id = "Hermes_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗在为你发光发热？他最不喜欢亲自下场干活了，但是现在这个事态，大概他也没有什么选择吧！"
    }
    {
      Id = "Hermes_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然发生了这么多事，但我还是很高兴终于认识了得墨忒尔，虽然只是通过祝福说上了话。她真的一直都很爱你的妈妈，尽管她爱的方式有时有些一言难尽。她一定会为了救回你妈妈而战斗，哪怕是背水一战。"
    }
    {
      Id = "Hermes_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "带着阿弗洛狄忒的祝福，是吗，墨？厉害哦，她的恩泽可是{#Emph}相当{#Prev}供不应求！虽然她平常更喜欢干预别人的私事，但你的情况确实很特殊！"
    }
    {
      Id = "Hermes_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "你把赫菲斯托斯从他的洞里引出来啦！我从他那只能要得到工作订单，{#Emph}“再来点青铜”{#Prev}，之类的！很高兴你可以好好利用他的劳动成果！"
    }
    {
      Id = "Hermes_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫菲斯托斯做的盔甲很酷，但你知道吗？他做的鞋子也很酷！我穿的鞋就是他做的！足部装备耶，墨！我真的觉得这个会成为未来的潮流！"
    }
    {
      Id = "Hermes_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以赫斯提亚已经找到你了？她虽然上了年纪，但还是活泼得很，而且还很喜欢玩火！打心底里还是个小孩……不过我得提醒你，是有点可怕的那种小孩！"
    }
    {
      Id = "Hermes_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到阿瑞斯了，是吧，墨？哪里有人发怒、有人流血，他就会不惜一切代价，让冲突彻底爆发！当然，现在的他肯定是左右为难。"
    }
    {
      Id = "Hermes_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "雅典娜忙着在前线制定防御策略之类的。我们各忙各的，彼此没什么交集。不过我得承认，她在这样的时候还能保持绝对冷静，真的很厉害！"
    }
    {
      Id = "Hermes_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们有些亲戚不喜欢搅入这些事情。比如迪奥尼索司，聚会他一次不落，战斗他一场不打！他总是说：“为什么大家不能相亲相爱呢？”不过，话说回来……其实这个主意也不错嘛！"
    }
    {
      Id = "Hermes_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "好呀，墨，看来塞勒涅已经找到你了！夜之眼的视野确实没得说！她总是照看着你，也照看着我们所有人。而且她的座驾也很迅捷！"
    }
    {
      Id = "Hermes_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "需要{#Emph}尊享级特快专递{#Prev}服务吗，墨？这是我{#Emph}最好的{#Prev}祝福了，一定能助你长驱直入！我向你{#Emph}保证！"
    }
    {
      Id = "Hermes_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}尊享级特快专递{#Prev}，从奥林匹斯山直发！最杰出、最迅捷的祝福，只献给最有眼光的顾客！说的就是{#Emph}你{#Prev}哦！"
    }
    {
      Id = "Hermes_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，听到了吗，墨？没错，这是{#Emph}尊享级特快专递{#Prev}的声音！每次都会把最好的祝福带给你哦。要物尽其用，好吗？"
    }
    {
      Id = "Hermes_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "这次我把最最上乘的祝福拿出来给你选啦，墨！不过别误会，我的祝福{#Emph}一向{#Prev}品质优良！只是这次比平常还要好！"
    }
    {
      Id = "Hermes_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚真的很让人害怕，一定跟你有什么关系，对吧，墨？我的心脏怦怦跳个不停！不知道你在三岔路口干了什么，但是希望有用！"
    }
    {
      Id = "Hermes_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "记录下最佳的时间，我喜欢这个选择！找一件值得做的事情，然后每次都做得{#Emph}更快一点、再快一点{#Prev}，很快，你就会变得像{#Emph}我{#Prev}一样！至少也会跟我很接近啦！"
    }
    {
      Id = "Hermes_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "注意到你没再给自己计时了吗，墨？我的心都要碎了。当然，我是开玩笑的啦，按自己的速度进行就好，不过！想要知道自己有多快的话，只有一个办法哦。"
    }
    {
      Id = "Hermes_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "总感觉我在某个夜晚会在这里找到你，你知道吗？就像是空气中的某种预兆。我现在都准备好了，只希望能{#Emph}超快{#Prev}地把事情办好！"
    }
    {
      Id = "Hermes_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "看起来你进展很顺利嘛，墨！随身带着我的金属液滴肯定有帮助。至少在当夜失效之前都很有用！虽然没办法一直全速前进，但是总可以为之努力嘛！"
    }
    {
      Id = "Hermes_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "真巧，是你，而且你已经很快了！但你始终可以再快一点！当然，我已经快得不能再快啦。"
    }
    {
      Id = "Hermes_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你想见的是阿波罗，墨。他速度是很快啦！但我更快，而且得亏我心肠好，要不然{#Emph}每次{#Prev}我都可以赶在他前面，让他羞愧难当！好啦，他一会儿就到哦。"
    }
    {
      Id = "Hermes_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这根蛇杖真不错，墨，一定是最新的流行款吧！我的这些蛇是阿波罗送的，它们总能让我想起这一家人，你知道么？谁也甩不开谁，脸皮不是很厚，动不动就互相发出嘶嘶声……但我还是很爱他们。"
    }
    {
      Id = "Hermes_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到我的特殊神龛啦，很好！有些凡人会向我祈祷，求我保佑他们旅途平安，或者求我送给他们一些免费的东西。{#Emph}几乎{#Prev}是免费的啦。但还是要收一点费用哦！毕竟我的供货人也要分些利润。"
    }
    {
      Id = "Hermes_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "带上动物伙伴是个明智的决定！我最喜欢那些不吵不闹，自给自足的小动物了。无论我跑到哪里，我的小乌龟谢伦都像在家里一样自在！"
    }
    {
      Id = "Hermes_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "你老师说你就快要取得突破了，关于爷爷和提丰那档子事。不是我想催你啦，墨，但我可是{#Emph}我！{#Prev}有时候我就是控制不住啦。"
    }
    {
      Id = "Hermes_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想说“真不敢相信”，墨，但这就意味着我原本不相信你，但我一直很相信，所以我就{#Emph}不那么说了！{#Prev}但我要说：谢谢你所做的一切！我知道我们的事还没彻底结束，但没那么大压力了，总归是好事。"
    }
    {
      Id = "Hermes_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "目前为止在我看来，这个新的爷爷比以前那个刻薄老头克洛诺斯好多了。有机会你一定得跟我说说，你是怎么让他的态度一百八十度大转弯的。你老师一个字都不肯跟我说！"
    }
    {
      Id = "Hermes_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "你爸回到了他该在的地方，你妈也是，他们都没事真是太好了，墨。你肯定得弥补之前缺失的时光；现在就可以开始了！"
    }
    {
      Id = "Hermes_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "还有命运三女神的事等着我们解决。所以爷爷把她们流放了，然后就完全不知道她们去哪了？连他都找不到她们，我们还有什么办法……？"
    }
    {
      Id = "Hermes_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到她们了，墨！她们亲口跟我说的，让我把消息传开，毕竟我是信使什么的，而且你猜怎么着？她们{#Emph}说对了！{#Prev}听起来她们在离开的这段时间里改变了想法……"
    }
    {
      Id = "Hermes_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说命运从现在开始不再决定未来了？除了重大事项，比如新的时代什么的？事情是由她们安排，还是由我们决定，不知道我们要怎么分辨出区别……"
    }
    {
      Id = "Hermes_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来新的时代要来临了，我想你肯定听到第一手消息了，墨。估计说到就到，这种事情向来都是这样！我们会做好准备的，就算没有，也会快速采取行动。"
    }
    {
      Id = "Hermes_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "有件事让我很害怕，墨，那就是时间有可能比{#Emph}我{#Prev}还快。你还记得你超小只的时候吗！结果，砰！你就{#Emph}老了{#Prev}，就一转眼的工夫！"
    }
    {
      Id = "Hermes_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有很多常客，但偷偷跟你说，我最喜欢的就是你，墨。你们冥界诸神一般都比较干净利落，而你每次都把自己的需求讲得很清楚。我很喜欢你这一点！"
    }
    {
      Id = "Hermes_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "我偶尔会喜欢聊天，但我{#Emph}总是{#Prev}喜欢快去快回——所以要不以后就先不聊那么多了？不过，也不是绝对啦！"
    }
    {
      Id = "Hermes_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "咱们都有急事要办，所以就赶快咯！"
    }
    {
      Id = "Hermes_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "想来看看你，你好吗？那就好！"
    }
    {
      Id = "Hermes_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "事情看起来不太妙，但说不定很快就又有变数！"
    }
    {
      Id = "Hermes_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "是，时间很快！但我觉得只要够快，就能赶上时间！"
    }
    {
      Id = "Hermes_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是碰巧经过，而且刚好有几个祝福给你选！"
    }
    {
      Id = "Hermes_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "脚步要轻要快，墨！你没问题的，对吧！"
    }
    {
      Id = "Hermes_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有点急，墨，这个你拿去，然后就上路吧？"
    }
    {
      Id = "Hermes_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}给冥界王女的特快专递！"
    }
    {
      Id = "Hermes_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，墨，要祝福吗？我碰巧有哦，而且还有三个给你选！"
    }
    {
      Id = "Hermes_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还凑合！你也还凑合？那就在这些祝福里凑合选一个，好吗？"
    }
    {
      Id = "Hermes_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "总有人说什么“欲速则不达”，但他们又懂什么，对吧？"
    }
    {
      Id = "Hermes_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "要么快意生活，要么不如快快赴死，对吧，墨？快选吧！"
    }
    {
      Id = "Hermes_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "马上就给你搞定，然后你就赶快上路吧！"
    }
    {
      Id = "Hermes_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "我上一秒还在想，你是不是快该到了！"
    }
    {
      Id = "Hermes_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "别想太多，摸到哪个算哪个，然后就上路吧！"
    }
    {
      Id = "Hermes_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来我们今晚又有得忙了！"
    }
    {
      Id = "Hermes_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}快点，墨，不然就晚了！{#Prev}我喜欢这么说。"
    }
    {
      Id = "Hermes_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我这边有个好东西，能让你健步如飞！"
    }
    {
      Id = "Hermes_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，墨，让我给你加加速吧！"
    }
    {
      Id = "Hermes_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿！我想过来打个招呼，还给你捎了个东西！"
    }
    {
      Id = "Hermes_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在和时间赛跑呢，而且相信我，我们会赢的！"
    }
    {
      Id = "Hermes_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "今晚很适合出来跑一跑，你说呢，墨？"
    }
    {
      Id = "Hermes_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿！又有一份特快专递要给你哦，墨！"
    }
    {
      Id = "Hermes_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最爱的客户，理应享受最快最好的服务！"
    }
    {
      Id = "Hermes_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "你要从这边上去吗？那说不定一会儿会再见面哦！"
    }
    {
      Id = "Hermes_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要加速吗？我正好有能帮到你的！"
    }
    {
      Id = "Hermes_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "好多事等着我去忙！我今晚就没停过！"
    }
    {
      Id = "Hermes_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管家族遭到什么样的灾难，我们都不会放慢脚步！"
    }
    {
      Id = "Hermes_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得去检查几个东西，不过首先，这个你拿去！"
    }
    {
      Id = "Hermes_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿！嘿！墨！其中一个“嘿”是帮阿尔忒弥斯说的哦。"
    }
    {
      Id = "Hermes_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿！嘿！墨！其中一个“嘿”是帮塞勒涅说的哦。"
    }
    {
      Id = "Hermes_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，最近要溜进冥界越来越困难了！还好我在这方面认识一位专家。看来你跟他也认识嘛！"
    }
    {
      Id = "Hermes_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "我代表我的同事感谢你的惠顾！又能和他共事的感觉真好。帮我给他捎句话哦，就说{#Emph}“哼嗯嗯嗯嗯嗯！”"
    }
    {
      Id = "Hermes_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "摆渡人总要收取费用，这是没办法的啦！不过这个祝福绝对{#Emph}物超所值{#Prev}，我向你保证！"
    }
    {
      Id = "Hermes_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "欸你说，我的同事拿那些金币到底都去做什么了？他还是一个字都不肯说。我猜他大概只是用来掩蔽自己的行踪，让爷爷没办法抓到他吧！"
    }
    {
      Id = "Hermes_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得克洛诺斯的那些金币要多久才能全部熔掉，再过一两个{#Emph}时代？{#Prev}不是说你很慢啦，主要是他一下铸了一大堆！"
    }
    {
      Id = "Melinoe_0957"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴有你在，赫尔墨斯，而且终于能与你共事也是我的荣幸。祝我们能捷足先登，斩获胜利！"
    }
    {
      Id = "Hermes_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，嘿！上次收礼物还是好一会儿之前呢！谢了，墨，虽然其实你不用这么破费的。不过，我正好有合适的回礼！"
    }
    {
      Id = "Melinoe_0958"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯，如果说有谁能帮我和时间赛跑的话，那非你莫属了。请收下这份礼物，作为我对你神速驰援的答谢。"
    }
    {
      Id = "Hermes_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真是慷慨，墨，只不过我现在{#Emph}真的{#Prev}得走了，所以咱们快进到选祝福的环节吧，好么？"
    }
    {
      Id = "MelinoeField_2005"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果没有你的神速和勇气，赫尔墨斯，我们面对大敌一定毫无胜算。我知道我们短期内很难好好报答你，但至少我可以尝试！"
    }
    {
      Id = "Hermes_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "太暖心了，墨，不过我对小费不太感兴趣，而且我们都有重要的事要做，你说对吧？不过我还是很感谢哦，真的。"
    }
    {
      Id = "MelinoeField_2006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你最近忙得不可开交，不过我可以稍稍打断一下我们的常规流程，为你献上这份小小的赠礼吗？只是一点小心意啦，不过这已经是我们这里能找到的最好的了。"
    }
    {
      Id = "Hermes_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "真不知道你最近怎么能找到{#Emph}时间{#Prev}做这个，但我很感谢你这样惦记我！那现在，我们赶紧做正事吧？我还有好多事要忙！"
    }
    {
      Id = "MelinoeField_3722"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是没有你的话，我们将会何去何从，赫尔墨斯大人？你身先士卒、四处奔波，为了让我们准备好应对前路的艰险，付出了那么多的努力。我知道你的贡献很容易被人忽视，但我们匿踪者都看在眼里。"
    }
    {
      Id = "Hermes_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "跟你合作真的很愉快，墨。实际上是这整件事里为数不多的亮点！不过我总要保持昂首挺胸，毕竟要看路嘛，对吧？多亏有你，这样做轻松多了！"
    }
    {
      Id = "MelinoeField_3723"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一杯敬最为迅捷的神明，也是我最亲切、最熟悉的战友。赫尔墨斯大人，你同时为奥林匹斯山和冥界竭智尽忠，其间种种你都看在眼里。我们家族的其他成员有许多能向你学习的地方；包括我自己。"
    }
    {
      Id = "Hermes_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "我就只是到处跑而已啦。去过很多地方，见过很多人，但你知道吗？这么多人里数你最棒，墨，我是真心的。当然，你不是最{#Emph}快{#Prev}的！总得有取舍嘛。不过偷偷跟你说，你的速度差不多追得上我了哦。"
    }
    {
      Id = "MelinoeField_4212"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是给你的特快专递，赫尔墨斯大人！你对我的帮助不胜枚举，而且这一路上，我每一步都有你的鼓励。要不是有你，我永远也没办法走得这么快、这么远。"
    }
    {
      Id = "Hermes_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿！仙酒！我一直都想要这个！最近都没怎么见过，跟它绑定的那些宴会也一样。不过按现在的形势，估计要不了多久就有更多了！我指的是{#Emph}宴会{#Prev}啦，而且庆祝的是你的功绩哦。"
    }
    {
      Id = "MelinoeField_4213"
      InheritFrom = "BaseNarrative"
      DisplayName = "致我们敬爱的信使、我亲爱的朋友！你以一己之力保证了冥界和奥林匹斯山的连结没有断裂，而且还做得这么隐秘、这么迅速。你都可以算是位冥界的神明了！"
    }
    {
      Id = "Hermes_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "这真的对我意义重大，谢啦，墨。你知道我做事喜欢讲究效率，但要说有什么比快更重要，那就是把事办好。我们这些神明并不总会认真对待工作，但你爸从不松懈，你也一样。很高兴我在这方面并不孤单。"
    }
    {
      Id = "MelinoeField_0643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没什么比光速交换礼物更让人激动了！"
