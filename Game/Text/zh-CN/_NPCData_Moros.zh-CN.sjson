    }
    {
      Id = "Moros_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里见到我的弟弟真是意料之外。所以说，他当真动都没动过一下？"
    }
    {
      Id = "Melinoe_0907"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，一下都没动过。赫卡忒老师说，她在我父亲的府上发现修普诺斯时，他已经沉沉睡去了。您之前都没有去冥府看过他吗？"
    }
    {
      Id = "Moros_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样太唐突了。我们都来自非常庞大的家族，不是么？古怪的家族。你明白这种感觉的。"
    }
    {
      Id = "Melinoe_0908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，我逐渐开始明白了。"
    }
    {
      Id = "Moros_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "清醒一些吧，厄里斯。阻挠命运三女神的意志，对你自己断然不会有任何益处。你有听过哪怕一次，这种事情最后落得好下场的么？"
