    }
    {
      Id = "Moros_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很少有机会说{#Emph}“我们又见面了”{#Prev}，王女，但现在机会就来了。"
    }
    {
      Id = "Moros_0030"
      InheritFrom = "BaseNarrative"
