    }
    {
      Id = "Moros_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "我相信比起在这里与我作伴，你一定有更重要的事情要做。"
    }
    {
      Id = "Moros_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "……抱歉失陪了，王女殿下。我……我需要些时间思考。"
    }
    {
      Id = "Moros_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴告诉你，我现在没有新的坏消息要报告，王女殿下。"
    }
    {
      Id = "Melinoe_0909"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯大人，您作为我们的贵客，呃……我谨代表大家向您送上这份礼物。希望这个能让您在这里待得更愉快些。"
    }
    {
      Id = "Moros_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "是众神的蜜露！谢谢你，王女殿下。我……我还从没有收到过献礼。不过我喜欢为各种情况做好准备。所以，请收下这份回礼！"
    }
    {
      Id = "Moros_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！我必须得承认，这样的恭维令我有些不习惯。抱歉，我……我不太清楚该说什么，除了……谢谢你。"
    }
    {
      Id = "Melinoe_0910"
      InheritFrom = "BaseNarrative"
      DisplayName = "不客气！不过，这不是{#Emph}恭维{#Prev}啦，只是……反正别多想，好么？"
    }
    {
      Id = "Moros_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "你对我实在是照顾有加，王女殿下。我抵达三岔路口时心灰意冷……没想到会在这里得到如此的款待。"
    }
    {
      Id = "Melinoe_0911"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也没想到我会有机会与毁灭化身相遇，更没想到和他还这么处得来。世事就是这么奇妙！"
    }
    {
      Id = "Moros_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，真的很感谢你，王女殿下，但你不用刻意为我找来这些东西的。你对我真是太慷慨了。恕我多问一句，但……你这样做应该不是为了实现命运清单中的某个预言，对吧？"
    }
    {
      Id = "Melinoe_0912"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不！{#Prev}当然不是，摩罗斯大人！不过，假如真是那么回事的话，我也有义务保密，没办法告诉您，不是么？"
    }
    {
      Id = "Moros_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈！这倒不假。"
    }
    {
      Id = "Moros_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "能收到这份礼物是我的荣幸，王女殿下。当命运三女神初次告诉我，我们会相遇时，我问她们我该做什么样的准备；我想知道你是什么样的人。当时克洛托笑了笑，神秘地说道：“等着瞧吧。”我还以为她们在捉弄我呢！"
    }
    {
      Id = "Melinoe_0913"
      InheritFrom = "BaseNarrative"
      DisplayName = "说得我都要庆幸自己没有姐姐了，摩罗斯大人。那如果把克洛托换成您，您会怎么说？"
    }
    {
      Id = "Moros_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！我也许会说……她是位法力高强的巫术师，是冥界的王女，冥王与春季女神的女儿。但无论你把她想象得多么优秀……她都会超出你的预期。"
    }
    {
      Id = "Melinoe_0914"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……听着不错耶。"
    }
    {
      Id = "Moros_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "这众神的蜜露，真是种……奢侈的享受。我与姐姐们住在一起时，过着相对简朴的生活。现在能来到这样的地方，甚至还能与殿下相知相交……没有哪种预言能让我对此做足准备。"
    }
    {
      Id = "Melinoe_4601"
      InheritFrom = "BaseNarrative"
      DisplayName = "您似乎真的很喜欢这里。我觉得这里确实吃穿不愁，但我还没怎么听过有人用“奢侈”来形容这里的任何事物。您的故乡真的与这里有那么大的不同吗？"
    }
    {
      Id = "Moros_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……那里对于织匠来说非常完美。但却没有多少娱乐活动，也没有其他人与我相伴。我有些担心，突然置身于现在这样的环境中，我会沉迷放纵、不思进取……"
    }
    {
      Id = "Melinoe_4602"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我觉得您目前还没有这个风险。"
    }
    {
      Id = "Melinoe_4603"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望您能收下这个，摩罗斯大人，因为上次它似乎很对您的胃口。虽说仙酒在奥林匹斯山源源不绝，但我们这些冥界的神明也该分得一份，您说呢？"
    }
    {
      Id = "Moros_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢！我觉得这个问题去问涅墨西斯更为妥当。这是不是我们{#Emph}应得的{#Prev}，实在由不得我来定夺。而命运三女神也没有告诉我是否应当收下这样的礼物。我也没有想过问问她们……"
    }
    {
      Id = "Melinoe_4604"
      InheritFrom = "BaseNarrative"
      DisplayName = "很难相信我会说出这样的话……但您真的不用想得太多。既然命运三女神现在无法回答您的问题，您始终可以听从自己内心的声音……？"
    }
    {
      Id = "Moros_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的内心……现在没有发出任何“声音”，王女殿下。但它……搏动得比平时更快，尽管我现在在休息，而且大体上并无不适。应该说{#Emph}相当舒适{#Prev}！啊，如此无礼绝非我的本意，所以……非常感谢你的礼物。"
    }
    {
      Id = "Melinoe_4605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不客气哦。"
    }
    {
      Id = "Melinoe_4606"
      InheritFrom = "BaseNarrative"
      DisplayName = "不断练习才能至臻完美，或者至少接近完美，这是我最早领悟到的道理之一。所以，我们一起练习一下，多多倾听自己内心的声音，您说如何？来吧，这瓶是给您的。"
    }
    {
      Id = "Moros_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……我在努力倾听自己内心的声音，王女殿下。但如果它真的能开口说话的话，恐怕它现在语速有些太快了，因此我没法完全理解它想要我做什么……就仿佛我中了你的缚身咒语一般。"
    }
    {
      Id = "Melinoe_4607"
      InheritFrom = "BaseNarrative"
      DisplayName = "那不如这次我先来，这样我下一次送您仙酒的时候，您就可以做好准备了。现在，我的内心是这样说的……我觉得在您身旁很舒服，哪怕您对我以王族之礼相待。说起来，这点我也完全不在意呢。"
    }
    {
      Id = "Moros_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "我……非常感谢你的这一席话，殿下。很高兴你能对我有这样的感觉。下一次，如你所说……我会做出更充分的准备，来表达我内心的感受。"
    }
    {
      Id = "Melinoe_4759"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很期待呢。"
    }
    {
      Id = "Melinoe_4608"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，摩罗斯大人，准备好向我吐露心声了吗？因为我正打算把这个送给您。三岔路口能有您这样镇定自若，而又善解人意的人，对我意义非凡，因此我想对您说一声谢谢。"
    }
    {
      Id = "Moros_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "王女殿下，是我该感谢你才对。不止是感谢这份礼物，当然，这份礼物本身也非常美好……但我还要感谢你，让我在我所熟知的命运呼唤之外，获得了新的值得追寻的目标。"
    }
    {
      Id = "Melinoe_4609"
      InheritFrom = "BaseNarrative"
      DisplayName = "新的值得追寻的目标？您是指蜜露和仙酒么？确实很可口，对吧？我应该还能弄到更多！"
    }
    {
      Id = "Moros_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就太好了，不过这并非我的本意。我是想说……既然你可以选择和任何人共度时光，我便应当努力让你与我相处时尽可能感到充实。和我一样充实。"
    }
    {
      Id = "Melinoe_4610"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我已经感觉和您相处的时光非常充实了。我不希望您对此有任何怀疑，也不希望您改变与我相处的方式。我喜欢和您共度时光的感觉。"
    }
    {
      Id = "Moros_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不知道听到这一席话时，我有多么欢欣雀跃。那么，仔细聆听一番后，我觉得这便是我目前的全部心声了。或许我本应有所保留……"
    }
    {
      Id = "Melinoe_4611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不，当然不用。我很高兴。"
    }
    {
      Id = "Melinoe_0915"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯大人？无论如何我都希望您能收下这个，但倘若您现在不算太忙的话，是否愿意和我一起去酒馆小酌片刻？我知道这个邀约有些唐突，只不过……我好久没有好好放松过了……"
    }
    {
      Id = "Moros_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "王女殿下，我荣幸之至。那便请你带路吧。"
    }
    {
      Id = "Melinoe_0916"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以说，有的时候压力{#Emph}确实{#Prev}会很大。我不知道把谁当作动力的来源更为合适，是那些确信我会成功的人，还是那些断定我会失败的人。"
    }
    {
      Id = "Moros_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈！我最近也总是在琢磨相似的问题。命运三女神总是可以预料到我行为的后果，因而会对一些我尚未犯下的细微过错施以惩戒。这样的举动意在鞭策我，但有时却会适得其反。"
    }
    {
      Id = "Melinoe_0917"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的话，您是从哪里汲取动力的呢？您的职责所带来的压力也一定很大吧。"
    }
    {
      Id = "Moros_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "到最后，一切都成了习惯之举。越是日日磨练一门技艺，越是害怕放手……害怕离了它，便再也无法在其他事情上达到同样的水平……"
    }
    {
      Id = "Melinoe_0918"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到毁灭本尊也会有这样的疑虑啊。"
    }
    {
      Id = "Moros_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵！也许我生来应该是{#Emph}害怕化身{#Prev}才对！所以话说回来，{#Emph}你觉得{#Prev}你的动力来自何方呢？"
    }
    {
      Id = "Melinoe_3353"
      InheritFrom = "BaseNarrative"
      DisplayName = "我现在觉得……应该是找到更多仙馔密酒的念头吧。因为它实在是{#Emph}太好喝了！"
    }
    {
      Id = "Moros_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "非常感谢你的陪伴，王女殿下，而且还要感谢你赠予我的佳酿。我们今后还会有这样交谈的机会吧？"
    }
    {
      Id = "Melinoe_0920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我相信会有的。"
    }
    {
      Id = "Melinoe_4612"
      InheritFrom = "BaseNarrative"
      DisplayName = "恕我冒昧，摩罗斯大人，不过您最近看起来有些紧张。您愿意和我去小酒馆一起小酌一杯么？有一段时间没和您一起去了呢。"
    }
    {
      Id = "Moros_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "再没有什么事能让我更开心了，王女殿下……只是，我不愿成为你的负担，而且我很后悔把我不足为虑的些许忧愁挂在了脸上。所以，还望你不要专门为我劳心伤神。"
    }
    {
      Id = "Melinoe_4613"
      InheritFrom = "BaseNarrative"
      DisplayName = "这怎么会是劳心伤神啦。而且，如果您真的希望我们一起度过充实的时光，那最起码也不该错过这种送上门来的机会呀。"
    }
    {
      Id = "Moros_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "言之有理。那么，能与你同行是我的荣幸。我们出发吧？"
    }
    {
      Id = "Moros_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "……是的，我也偶尔会对别人动心。但我知道不该纵容自己产生依恋之情。以前，我的心想对我说话的时候，我总能找到办法让它安静下来。"
    }
    {
      Id = "Melinoe_4614"
      InheritFrom = "BaseNarrative"
      DisplayName = "那么，至少这一方面我们很像……都很擅长让自己躁动的内心安静下来。不过，阿弗洛狄忒女神教会了我一件事，那便是我们无需时时刻刻压抑自己内心的热情。"
    }
    {
      Id = "Moros_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "殿下何出此言？你实现了如此多的丰功伟绩，难道还有压在心头未能实现的热情么？"
    }
    {
      Id = "Melinoe_4615"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，举例来说，就连和您在这里共度时光……换做以前，我想我大概都没办法下定决心，对您发出邀请。我的大脑会劝我的心放弃这个念头。"
    }
    {
      Id = "Moros_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我很庆幸，你的心现在能在这样的分歧中占据上风。我认为这只会让你更加坚强，而且……也许是仙酒所致，但我还是想说……我真的很喜欢这一点。我真的很喜欢……你的每一点。"
    }
    {
      Id = "Melinoe_4616"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢……！既然到了酒后吐真言的环节，那么……我也很喜欢您……但是，如果您已经另有所属，那我还是不要横插一手为好。"
    }
    {
      Id = "Moros_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "我与这位被安排了婚事的女神素昧平生，而且我也无意与她结识。更何况，我早已违背了命运的意志；你我皆是如此。无论这一切会将我们引向何方，我都希望能有{#Emph}你{#Prev}相伴左右。"
    }
    {
      Id = "Moros_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "我非常享受今晚的时光，殿下，而且已经在翘首以盼下一次与你相处的机会了。我相信不会间隔太久。"
    }
    {
      Id = "Melinoe_4618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我也有同感。"
    }
    {
      Id = "Melinoe_3555"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯大人，我在考虑去泡一次温泉，想到您可能也会感兴趣，就来问问您。"
    }
    {
      Id = "Moros_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "恕难从命，王女殿下。我有些过往的事项需要记录，恐怕暂时走不开。或许改夜吧？"
    }
    {
      Id = "Melinoe_0921"
      InheritFrom = "BaseNarrative"
      DisplayName = "您有体验过我们的温泉吗，摩罗斯大人？这里的泉水可以洗涤身体、净化心灵。我正准备去泡一泡，您愿意和我一起吗？"
    }
    {
      Id = "Moros_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我……恭敬不如从命！我亲眼见过，也听人说过这样的温泉，但自己还未曾体验过。"
    }
    {
      Id = "Moros_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "……真是别有洞天……"
    }
    {
      Id = "Melinoe_0923"
      InheritFrom = "BaseNarrative"
      DisplayName = "欸，说起来，在您那边，您和命运三女神平常都是怎么放松身心的呢？"
    }
    {
      Id = "Moros_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有向你提过她们喜欢编织吗？这对她们来说既是职业，也是{#Emph}爱好{#Prev}。我自己倒是一向不太擅长，而且她们织布只需要三个人，所以……"
    }
    {
      Id = "Melinoe_0924"
      InheritFrom = "BaseNarrative"
      DisplayName = "我倒是认识一位才华卓绝的织匠，说不定可以帮您提升一下编织的水平。不过话说回来，她们忙着编织的时候，您又在做什么呢？"
    }
    {
      Id = "Moros_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，我会周游世界！我会去亲眼见证凡人临终时的场面。在他们死亡时，直视他们的双眼……我看到的常常是恐惧……"
    }
    {
      Id = "Melinoe_0925"
      InheritFrom = "BaseNarrative"
      DisplayName = "……您把这个作为娱乐？"
    }
    {
      Id = "Moros_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的工作性质意味着我没有多少娱乐的时间。而且，这是我向临终的凡人表达敬意的唯一方式……不过恐怕不是每个人都能理解我的用意。"
    }
    {
      Id = "Moros_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "好久没有这么神清气爽了，上一次还是……唔，真的很久之前了。再次感谢。"
    }
    {
      Id = "Melinoe_0922"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯大人，您有空的时候愿意再陪我去一趟温泉吗？唔，如果您现在有空的话……要不就现在？"
    }
    {
      Id = "Moros_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还担心王女殿下不会再邀请我了呢！自从上次造访温泉之后，那股暖意一直让我难以忘怀。"
    }
    {
      Id = "Moros_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "……不知不觉都要习惯这样的生活了……"
    }
    {
      Id = "Melinoe_0927"
      InheritFrom = "BaseNarrative"
      DisplayName = "您和命运三女神之间的关系听起来有些复杂。您之前从来没有独自生活过，是吗？"
    }
    {
      Id = "Moros_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。她们虽然是我的姐姐，但实际上又像我的长辈。我在她们的注视下长大，而我也不止是她们的弟弟；我是她们的守护者。但最后，我却没能保护好她们。也许她们一直都知道我会害她们落得这样的下场，但却仍然爱着我。"
    }
    {
      Id = "Melinoe_0928"
      InheritFrom = "BaseNarrative"
      DisplayName = "您不能这么想。您当时身上肩负的，是世界上最重要的责任之一。命运三女神知晓一切，不是么？那就意味着她们知道，这个世界上再没有比您更能胜任的人。"
    }
    {
      Id = "Moros_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "……王女殿下，不如你还是留我一个人在这里黯然神伤吧？啊……不，等等，当我没说过。那种感觉已经荡然无存了。多亏了你刚刚那番有魔力的话语。"
    }
    {
      Id = "Melinoe_0929"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈，好啦。我知道您深爱着您的三位姐姐，但是……考虑到当下的形势，也许暂时远离她们对您也有益处。"
    }
    {
      Id = "Moros_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许……至少这座温泉对我很有益处，这点毋庸置疑。"
    }
    {
      Id = "Moros_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样的休憩来得太及时了。感谢王女殿下邀请我共度这段美好的时光。"
    }
    {
      Id = "Melinoe_4814"
      InheritFrom = "BaseNarrative"
      DisplayName = "想再去泡一泡温泉么，摩罗斯？我现在没什么要紧的事，不知道您方不方便。"
    }
    {
      Id = "Moros_0682"
      InheritFrom = "BaseNarrative"
      DisplayName = "乐意之至。那里非常宁静……几乎就和我们在你返程时相遇的地方一样。"
    }
    {
      Id = "Melinoe_4815"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我觉得，有可能这一切都是命运女神的安排。我们俩之间的事。而且我指的是{#Emph}所有事{#Prev}。您有考虑过吗？"
    }
    {
      Id = "Moros_0684"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许算是考虑过一点吧，但我拒绝相信。如果命运三女神希望我和你在一起，她们为什么要为我定下与他人的婚约？这毫无道理。"
    }
    {
      Id = "Melinoe_4816"
      InheritFrom = "BaseNarrative"
      DisplayName = "我明白，只不过……有的时候要让人做一件事，最好的办法就是强迫他去做某件他{#Emph}不愿{#Prev}做的、相反的事。接着，出于反抗的心理，他们就会转而去做你真正想让他们做的事。算是简单的操纵人心的方式吧。"
    }
    {
      Id = "Moros_0685"
      InheritFrom = "BaseNarrative"
      DisplayName = "但我一直都对她们言听计从。她们没有理由认为我会违抗她们……不，我断然无法接受这种可能性，无法相信这一切都是命运在背后施以推手。我们的相逢或许不是偶然，但我的姐姐们不会无聊到这种地步。"
    }
    {
      Id = "Melinoe_4817"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这一切都不重要吧。不过如果她们真的安排了我们的相遇，那我也很感激。她们本可以选一个远远不像您这般与我契合的人。"
    }
    {
      Id = "Moros_0686"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们确实向来眼光独到。而我也从未如此心怀感激，无论是对她们，还是对你。"
    }
    {
      Id = "Moros_0687"
      InheritFrom = "BaseNarrative"
      DisplayName = "……呼！我想，无论命运接下来有什么安排，我都准备好面对了。回见，墨利诺厄。"
    }
    {
      Id = "Melinoe_4819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回见，摩罗斯。"
    }
    {
      Id = "Melinoe_3501"
      InheritFrom = "BaseNarrative"
      DisplayName = "摩罗斯大人，不知道您有没有和我一起在钓鱼栈桥呆一会儿的愿望？我想着我们正好能让这个双份鱼饵派上用场。"
    }
    {
      Id = "Moros_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！恐怕我今夜与你同行的话，河流的居民不会靠上前来，因为它们常常能察觉到我的存在。抱歉了。"
    }
    {
      Id = "Melinoe_0937"
      InheritFrom = "BaseNarrative"
      DisplayName = "欸，摩罗斯大人，您愿意和我一起去钓鱼吗？我感觉哪怕您仅仅是站在旁边，今晚的收获也会增加不少。"
    }
    {
      Id = "Moros_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡间的所有生物都难逃我的影响，因此，嗯，我愿意与你同去。"
    }
    {
      Id = "Moros_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "恕我直言，我从未理解为何人们常常会有将水生生物从自然环境中提取出来的这种冲动。我明白对于凡人来说，鱼肉有时是必要的养料，但其他人这样做只为娱乐。这是为什么？"
    }
    {
      Id = "Melinoe_3239"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于凡人来说，看起来像是他们证明自己凌驾于自然世界之上的机会。不过我要是他们的话，应该不会因为自己的智力胜过河里的鱼而感到骄傲。对于我们来说……我们是在保护这些生物所处的自然环境。"
    }
    {
      Id = "Moros_0322"
      InheritFrom = "BaseNarrative"
