      DisplayName = "不知道命运三女神接下来会想要我做什么……"
    }
    {
      Id = "Moros_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "王女殿下，感谢你让我在这里感到宾至如归。"
    }
    {
