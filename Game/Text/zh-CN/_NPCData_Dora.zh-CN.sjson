      DisplayName = "嘿，看着点！"
    }
    {
      Id = "Dora_0563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "私人空间，小墨。"
    }
    {
      Id = "Dora_0564"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哇，悠着点。"
    }
    {
      Id = "Dora_0565"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呦。"
    }
    {
      Id = "Dora_0566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿，退后一点。"
    }
    {
      Id = "Dora_0567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不许碰我。"
    }
    {
      Id = "Dora_0568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "往后退一点？"
    }
    {
      Id = "Dora_0570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你怎么回事。"
    }
    {
      Id = "Dora_0573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "几乎感觉到了。"
    }
    {
      Id = "Dora_0571"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要被诅咒了喔！"
    }
    {
      Id = "Dora_0572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要被诅咒了喔。"
    }
    {
      Id = "Dora_0574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}你胆敢冒犯我？"
    }
    {
      Id = "Dora_0575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}诅咒你！"
    }
    {
      Id = "Melinoe_1885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意，亡灵。"
    }
    {
      Id = "Dora_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}是你唤了我的名讳？"
    }
    {
      Id = "Dora_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}是谁在召唤我？"
    }
    {
      Id = "Dora_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}在我面前拜服罢，女巫！"
    }
    {
      Id = "Dora_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}你们都不得好死！"
    }
    {
      Id = "Dora_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}承受千百次的折磨罢！"
    }
    {
      Id = "Dora_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}愿阳炎烧灼你的骸骨！"
    }
    {
      Id = "Dora_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}愿恐惧将你我吞没！"
    }
    {
      Id = "Dora_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "随便啦。"
    }
    {
      Id = "Dora_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就呆在这里哦。"
    }
    {
      Id = "Dora_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，小墨。"
    }
    {
      Id = "Dora_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呀，别那么正经啦……"
    }
    {
      Id = "Dora_0004_01_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}何人胆敢扰我长眠？你冒犯到了远超你理解的存在，女巫！"
    }
    {
      Id = "Dora_0646"
      InheritFrom = "BaseNarrative"
      DisplayName = " {#Prev}还不错吧，小墨？也许像那样叫你女巫，会稍微显得有点生硬。"
    }
    {
      Id = "Melinoe_5191"
      InheritFrom = "BaseNarrative"
      DisplayName = "总的来说已经很吓人啦，朵拉，而且我感觉女巫那部分效果还挺好的。不过，我得先撤了。我还有事要忙。"
    }
    {
      Id = "Dora_0005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}那便去罢！"
    }
    {
      Id = "Melinoe_1302"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我想请你帮个忙，如果你有空的话。我有任务在身，所以没办法继续监督这里的翻新工作。你可以接手吗？"
    }
    {
      Id = "Dora_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你要让{#Emph}我{#Prev}监管整座营地的彻底翻新，直到这里变成亡灵和放逐者的避难所为止……？"
    }
    {
      Id = "Melinoe_1303"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道我可以信任你。我会为你提供资源的，你负责联络人手安排工作就行。"
    }
    {
      Id = "Dora_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}唔……………………{#Prev}行吧行吧。"
    }
    {
      Id = "Melinoe_1304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "太好了！"
    }
    {
      Id = "Melinoe_2021"
      InheritFrom = "BaseNarrative"
      DisplayName = "翻新计划顺利开始了呢！怎么样，突然多了这么些责任，你还适应吗？"
    }
    {
      Id = "Dora_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，还可以吧！有的时候我宁愿自己什么也不干……不过，我懂的啦，这种事情总得有人做的，而{#Emph}外面{#Prev}那些懒鬼你是指望不上的啦。"
    }
    {
      Id = "Melinoe_2022"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些暗灵也有他们自己的职责。工作不见得是件辛苦的事；工作也可以让人很充实！帮助他人的成就感，以及有责任在身的使命感……"
    }
    {
      Id = "Dora_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "小墨，我的{#Emph}使命{#Prev}，就是成天无所事事。"
    }
    {
      Id = "Dora_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道你让我折腾这些装修的事情是有什么动机啦，小墨。怎么，你以为叫我换几个破灯罩，我就能找到死后存在的意义了吗？"
    }
    {
      Id = "Melinoe_3697"
      InheritFrom = "BaseNarrative"
      DisplayName = "你已经找到你存在的意义了，你是整个三岔路口——说不定是整个世界最会装神弄鬼的人。这个翻新计划只是你回馈三岔路口的某种方式啦。"
    }
    {
      Id = "Dora_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许吧……但我的存在如果不是完全没有意义的话，那我装神弄鬼的效果会大打折扣的。所以，别让我发现你偷偷想给我找到什么存在的意义哦……那种东西我才不想要呢。"
    }
    {
      Id = "Melinoe_3698"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你就放心吧。"
    }
    {
      Id = "Dora_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候我几乎都要认不出这里了……我是指这个帐篷啦。看看这里面都装了多少好东西！简直就是座宫殿啦。"
    }
    {
      Id = "Melinoe_3695"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没有想过自己会想住在一座宫殿里。但你这么一说，我突然觉得这样好像也不错。最近新添的这些装饰品合你的心意吗？"
    }
    {
      Id = "Dora_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "东西更多，就意味着装神弄鬼的机会也更多，所以很合我的心意啦。我反倒有点担心{#Emph}你{#Prev}……这里可不像以前那样{#Emph}干干净净{#Prev}、{#Emph}空空荡荡{#Prev}的了哦……"
    }
    {
      Id = "Melinoe_3696"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我随时都可以让它变回干净的样子。"
    }
    {
      Id = "Dora_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，别……"
    }
    {
      Id = "Dora_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，之前你让我帮你搞那个{#Emph}翻新计划{#Prev}的时候……我知道你是什么居心，小墨。拿一大堆琐事折腾我，我就没空琢磨存在为什么没有意义了，对不对？"
    }
    {
      Id = "Melinoe_4681"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来都没觉得那是“一大堆琐事”。看看我们在这里取得了多大的进展！整个三岔路口越来越繁荣了，其他的暗灵都充满干劲……这都是你的功劳！"
    }
    {
      Id = "Dora_0613"
      InheritFrom = "BaseNarrative"
      DisplayName = "你真这么觉得……？总之我想说的是，不知道从什么时候起，我好像开始接受这些“杂事”了。这一切好像都没有那种没意义的感觉了，虽然还是没什么意义吧。"
    }
    {
      Id = "Melinoe_4682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如果你{#Emph}不觉得{#Prev}它没意义，那它就有意义。"
    }
    {
      Id = "Dora_0614"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我不好说，可能吧。"
    }
    {
      Id = "Dora_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "所有冥界玩偶都被你集齐了，哈？从来没想过你是那种会收藏一堆没用的小玩意儿的家伙。"
    }
    {
      Id = "Melinoe_5470"
      InheritFrom = "BaseNarrative"
      DisplayName = "哪里没用了！我很享受收集它们的过程，而且把它们都整整齐齐地收纳在了一起。而且说不定随着时间的推移，它们会越来越珍贵呢！"
    }
    {
      Id = "Dora_0650"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你打算把它们拿去{#Emph}卖钱{#Prev}吗？想不到有谁会愿意接手欸！不过……我不是有意扫你的兴啦。我觉得你收集一堆儿童玩具的样子很可爱欸。"
    }
    {
      Id = "Melinoe_5471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这些不是给小孩子玩的！"
    }
    {
      Id = "Dora_0652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯哼。"
    }
    {
      Id = "Dora_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，那颗幽灵洋葱效果如何？我当时就觉得，这种帮助人活下去的东西，在你身上比在我身上有用多了……而且它也有一点点恶心啦。"
    }
    {
      Id = "Melinoe_3694"
      InheritFrom = "BaseNarrative"
      DisplayName = "它很好用呢，谢谢你，朵拉。不过，带着你的洋葱，就意味着我通常会在外面呆更久，而你却在这里孤身一人……"
    }
    {
      Id = "Dora_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一切尽在计划之中……"
    }
    {
      Id = "Dora_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨！我还以为我终于能独享这么大块地方了呢，结果下一秒你就回来了。差点把我吓活了！今晚又遇上倒霉事了吗？"
    }
    {
      Id = "Melinoe_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "倒霉到家了，朵拉。别担心，很快你就又可以独享这个帐篷了！我走啦。"
    }
    {
      Id = "Dora_0003"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好，再见咯。"
    }
    {
      Id = "Dora_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道吗，现在你再也不从帐篷口进来了，导致你每次出现都会吓我一跳。你有没有考虑过跟我一样试试装神弄鬼？"
    }
    {
      Id = "Melinoe_1827"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，当然啦！我之前还想，要是这档子麻烦事我处理不了的话，咱们可以一起去地表游历，把胆敢直视我们的凡人全都吓个屁滚尿流。"
    }
    {
      Id = "Dora_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}（吸气）{#Prev}我喜欢这个主意……"
    }
    {
      Id = "Dora_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！还以为你醒不过来了呢。你还好吗？"
    }
    {
      Id = "Melinoe_2018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还好，谢谢关心，朵拉。希望没有让你太过担心。你一直守在我身边吗？"
    }
    {
      Id = "Dora_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你说我吗？开什么玩笑，我只是碰巧来透透气啦。"
    }
    {
      Id = "Melinoe_2819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可是你都不用呼吸呀……"
    }
    {
      Id = "Dora_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "闭嘴……！"
    }
    {
      Id = "Dora_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道的，小墨，你什么话都可以对我说。我是不会评判你的！好吧……也许和每晚听你倾诉的那只绿油油软塌塌的小东西比起来，是会稍微多评判你一点，但你懂我意思啦。"
    }
    {
      Id = "Melinoe_3692"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从来没有想过，你和弗利诺斯身上还会有这种共同点欸。我向他倾诉的，都是我的失败和失误……不过如果你愿意的话，我也可以分一些说给你听！"
    }
    {
      Id = "Dora_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，都一股脑说给我听吧！而且你掉链子掉得越狠，我就越想听你娓娓道来哦。"
    }
    {
      Id = "Melinoe_3693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你愿意听喔。"
    }
    {
      Id = "Melinoe_3375"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我发现我的那些瓶瓶罐罐摆放的位置好像变了耶。你总不会是想偷偷把我逼疯吧？"
    }
    {
      Id = "Dora_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "才没有啦……不过，把你逼疯听起来还挺有意思的，说不定以后我会试试呢。我当时正在练习附身到小物件上的能力，结果你那个装真菌的瓶子不小心被碰了一下。所以我就把它放回原位了！"
    }
    {
      Id = "Melinoe_0964"
      InheritFrom = "BaseNarrative"
      DisplayName = "你放回的不是{#Emph}原位{#Prev}。我……{#Emph}哎{#Prev}。下回发生这种事，至少跟我说一声，好吗？"
    }
    {
      Id = "Dora_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我考虑一下喔。"
    }
    {
      Id = "Dora_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "我说呀，小墨，你有的时候也太正经啦。真不知道是谁教你的，就连女巫老大都比你放松多了。"
    }
    {
      Id = "Melinoe_1820"
      InheritFrom = "BaseNarrative"
      DisplayName = "听着，我现在压力真的很大，好么？每个人都指望着我{#Emph}杀掉时间本尊{#Prev}……所以我只是希望这里能保持井井有条的样子！毕竟我时不时就得回来一趟……"
    }
    {
      Id = "Dora_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘁，那又怎么啦？我成天在这里杀时间，也没见我像你那么紧张。"
    }
    {
      Id = "Melinoe_1821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}唉……"
    }
    {
      Id = "Melinoe_1822"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我在想……要是我保证以后不像之前那样，用你的话说，{#Emph}那么正经{#Prev}的话……你可以保证以后不要在我出去的时候动我的东西吗？"
    }
    {
      Id = "Dora_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你这小小女巫，胆敢对我发号施令？{#Prev}嗯……不行，我不同意。你爱多正经就多正经，我说你两句而已，别太当回事。"
    }
    {
      Id = "Melinoe_1823"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就是想继续乱动我的东西！"
    }
    {
      Id = "Dora_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯哼，没错。"
    }
    {
      Id = "Dora_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，女巫老大没把你骂得太惨吧？毕竟看你每次过不了多久就会回来，好像不太顺利的样子……"
    }
    {
      Id = "Melinoe_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道老师对我的要求很高。我觉得，她肯定内心希望我比现在的进展更快，但……她对我一直很有耐心。"
    }
    {
      Id = "Dora_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真的假的？{#Emph}但愿{#Prev}她能保持下去！"
    }
    {
      Id = "Melinoe_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，你是不是从来都没跟瑟勒米乌斯指挥官说过话？奥德修斯呢？这两位大师与我们阵线相同，是我们的幸事。他们熟知历史，有许多可以教给我们的东西。"
    }
    {
      Id = "Dora_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "“历史”？现在人们都用这个词称呼往事了吗？我暂时没有对谁发动战争的计划啦，不过如果我改变主意的话，我会去找这两位聊聊的。"
    }
    {
      Id = "Melinoe_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们都是好人……！"
    }
    {
      Id = "Melinoe_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有别的暗灵朋友吗，朵拉？你可以去参加一下他们的活动之类的。最近有很多事情在发生呢。"
    }
    {
      Id = "Dora_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}愚蠢的女巫！{#Prev}在这顶帐篷里装神弄鬼的爱好需要我全部的精力。我们这些弱一些的暗灵有时有点一根筋！大概跟凡人有些相像吧。"
    }
    {
      Id = "Melinoe_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不只是凡人……"
    }
    {
      Id = "Dora_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以话说回来，你是怎么让其他这些暗灵任你差遣的？他们简直是对你顶礼膜拜耶。"
    }
    {
      Id = "Melinoe_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "是老师收留的他们。我帮忙训练他们，以及与他们交流。这些暗灵有许多曾经被困在阳世与阴间之间无处可去，有些甚至没有得到体面的埋葬。其他则是抱憾而死，或者死于非命。他们从没有得到去往冥界的机会。"
    }
    {
      Id = "Dora_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哎呦{#Prev}……听起来好惨哦。欸，你说我不会就是以上某类人吧？我可不希望自己“没有得到{#Emph}体~面~的~埋~葬~{#Prev}”。"
    }
    {
      Id = "Melinoe_0434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这种事就不要拿来开玩笑了，朵拉。"
    }
    {
      Id = "Dora_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "外面越来越拥挤了！更多的暗灵，还有那个长角的家伙。小墨，我不喜欢这样！一点都不喜欢。"
    }
    {
      Id = "Melinoe_1824"
      InheritFrom = "BaseNarrative"
      DisplayName = "俗话说，人多力量大。是什么地方让你不喜欢？"
    }
    {
      Id = "Dora_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不喜欢分享。除了这座帐篷，我不介意与你共享！大多数时候吧。"
    }
    {
      Id = "Melinoe_1825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我很荣幸。"
    }
    {
      Id = "Melinoe_2034"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，朵拉！你真的出了趟远门耶！真没想到能在小酒馆见到你。"
    }
    {
      Id = "Dora_0196_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，你这样一说，我立马就浑身不自在了，真是谢谢你哦，小墨！不过你说得没错啦，我大概是在试着多出来转悠转悠吧……！"
    }
    {
      Id = "Melinoe_2035"
      InheritFrom = "BaseNarrative"
      DisplayName = "好极了。不过，我也知道这样做并不容易。以前我总是很难鼓起勇气跟别人开口说话，但我一直在努力尝试……现在感觉轻松一些了。"
    }
    {
      Id = "Dora_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "会轻松一些，但是……永远不会真的{#Emph}轻松{#Prev}，对吗？哎，也不知道我为什么要这么折腾自己……这里的暗灵大多都挺无聊的。"
    }
    {
      Id = "Melinoe_2036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是因为他们还没遇到{#Emph}你{#Prev}！"
    }
    {
      Id = "Dora_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，你这样一说，我立马就浑身不自在了，真是谢谢你哦，小墨！不过你说得没错啦，我大概是在尝试多出来转悠转悠吧……！毕竟你可是把那个超级重要的任务丢给我了耶。"
    }
    {
      Id = "Melinoe_2032"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴看到你最近时不时会出来转转，不会一直缩在营帐里了。你感觉还好吗？"
    }
    {
      Id = "Dora_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，还好吧。其他的暗灵对装神弄鬼一无所知，而且谁能想到他们居然知道这里{#Emph}所有人{#Prev}的八卦……{#Emph}你的{#Prev}也不例外哦。"
    }
    {
      Id = "Melinoe_2033"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴知道我们军团的中坚力量在用八卦放松身心呢。"
    }
    {
      Id = "Dora_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯，是啦。"
    }
    {
      Id = "Melinoe_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一定还记得你在阳世生活的某些细节，对吧，朵拉？至少能想起来一些片段吧？我好奇生而为人是什么样的感受。"
    }
    {
      Id = "Dora_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不记得了，也懒得去想！谁在乎呢？我们在{#Emph}这里{#Prev}过的才叫生活。"
    }
    {
      Id = "Dora_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你昨晚睡觉的时候说梦话了耶。不是说我有特意观察啦，但是……说起来，你昨晚到底上哪去了？你看起来有点心不在焉耶。"
    }
    {
      Id = "Melinoe_3724"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我只是……我只是上到了地表。我从来没有想到自己会亲眼见到地表，而现在我却夜复一夜地赶赴那里。那里很冷，很湿……而且遍地都是亡者。"
    }
    {
      Id = "Dora_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来还真是诱人。如果那里真那么糟的话，你为什么还要反复往那边跑呢？如果我是你的话，我就留在这里……当然我本来也留在这里了啦。"
    }
    {
      Id = "Melinoe_3725"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不明白。我必须往那边去。这是我任务的一部分。好吧，严格来说不是，但……好了，我就不拿这些细节来烦你了。我得走了。"
    }
    {
      Id = "Dora_0344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "祝你在又冷又湿的地表玩得开心。"
    }
    {
      Id = "Dora_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你醒啦。你出去了好一阵子。有看到什么有趣的东西吗？"
    }
    {
      Id = "Melinoe_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "我杀出了厄瑞玻斯，下到了俄刻阿诺斯。在大海深处，感觉很奇妙。你还记得大海吗，朵拉？"
    }
    {
      Id = "Dora_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "大海……大海，大海，大海，就是那个{#Emph}全是水的地方{#Prev}，是不是？听说那里有时还不错啦！不过也听说那里害死了很多人，淹死之类的，所以……大概算是褒贬不一吧。"
    }
    {
      Id = "Melinoe_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那是个很大的地方……"
    }
    {
      Id = "Dora_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，小墨，说真的，你怎么看起来这么惨兮兮的。想跟我说说吗？或者至少把最劲爆的部分说来听听？因为我要无聊透啦。"
    }
    {
      Id = "Melinoe_3380"
      InheritFrom = "BaseNarrative"
      DisplayName = "昨晚我去到了哀悼原野，然后……那里周围溢满了绝望的气息……一定有一些沾到了我身上，被我带回来了。"
    }
    {
      Id = "Dora_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，既然这样的话，不如就让我{#Emph}吓得你气数散尽罢，可悲的蛆虫！"
    }
    {
      Id = "Melinoe_3381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿，管用耶！"
    }
    {
      Id = "Dora_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就知道！"
    }
    {
      Id = "Dora_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你去哪啦？你身上的{#Emph}味道{#Prev}好重耶！不是说你真的很难闻啦，而且我也不知道我是怎么能闻到东西的，甚至我不该记得起任何味道才对……所以说来很奇怪哦。"
    }
    {
      Id = "Melinoe_3382"
      InheritFrom = "BaseNarrative"
      DisplayName = "我去了地表一趟。一定是因为那里腥咸的海风，和地底的俄刻阿诺斯完全不同。我在海上航行，乘着船向着奥林匹斯山进发呢！"
    }
    {
      Id = "Dora_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "太令人兴奋了！而我哪都没去呢。"
    }
    {
      Id = "Dora_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很努力不去听外面那些暗灵的闲言碎语了，但是他们好像在说，你最近遇上了好多麻烦哦？"
    }
    {
      Id = "Melinoe_3703"
      InheritFrom = "BaseNarrative"
      DisplayName = "很难说他们具体指的是什么，但是……举个例子吧，我最近登上了奥林匹斯山。我从来没想过我会亲眼见到那里。那里的仗打得非常激烈……"
    }
    {
      Id = "Dora_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}奥林匹斯山……{#Prev}就是你家庭的其他成员呆着的那个地方嘛！他们这次又是为什么打起来啦？"
    }
    {
      Id = "Melinoe_3704"
      InheritFrom = "BaseNarrative"
      DisplayName = "对天界和大地的统治，以及他们自古以来的家园。"
    }
    {
      Id = "Dora_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦！这倒是新奇。"
    }
    {
      Id = "Dora_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，奥林匹斯山最近怎么样？你昨晚是去的那里吧，搞不太清楚。除了那里的冰天雪地，还有看到什么好东西吗？不知道我为什么会记得那里的冰天雪地……"
    }
    {
      Id = "Melinoe_4419"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一路登上了山顶，在那里和名为{#Emph}提丰{#Prev}的古老魔物交了手。据说他是所有魔物的祖先……但是说实话，我压根就没见过他那么庞大，那么凶猛的魔物。"
    }
    {
      Id = "Dora_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨，平常都是{#Emph}我{#Prev}吓{#Emph}你{#Prev}，怎么这次你还吓起我来了。所以，你把这家伙打败了吗？"
    }
    {
      Id = "Melinoe_4421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃……差一点。但我有这个打算。"
    }
    {
      Id = "Dora_0499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好喔，我能帮到什么的话，尽管跟我说！"
    }
    {
      Id = "Melinoe_4420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没错，被你说中了！"
    }
    {
      Id = "Dora_0498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那看来他也没那么吓人嘛。"
    }
    {
      Id = "Dora_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}喝！胆敢再次召唤我，就等着我对你的子孙后代降下诅咒罢，女巫！{#Prev}嘿，小墨，那个，一切都好吗？"
    }
    {
      Id = "Melinoe_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，都还好啦，朵拉，只不过……我刚才明明可以前进得更远的。等我之后闲下来，再来给你的装神弄鬼提反馈，好吗？"
    }
    {
      Id = "Dora_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦。好啦……"
    }
    {
      Id = "Melinoe_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，你对外面发生的一切真的完全不关心吗？时间泰坦的崛起？奥林匹斯山的围困？"
    }
    {
      Id = "Dora_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "不关心。你说的这些我听都没听过。奥林匹斯山，就是你{#Emph}七大姑八大姨{#Prev}住的地方，是吧？至于那个时间泰坦嘛，我{#Emph}知道{#Prev}他是坏人啦，但他也没招惹过我，所以……"
    }
    {
      Id = "Melinoe_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是这个营地之所以存在，就是为了不让他推翻众神、统治世界的阴谋得逞呀！"
    }
    {
      Id = "Dora_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样啊！那也许我该感谢他呢，毕竟我还挺喜欢这个营地的。"
    }
    {
      Id = "Melinoe_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这叫什么话！"
    }
    {
      Id = "Dora_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，等一下，你这是怎么了？我活到现在都没见过你这么兴奋耶。我是说死到现在啦。你懂的。怎么啦，你是挖出了一棵从没见过的菜，还是……？"
    }
    {
      Id = "Melinoe_3378"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我找到了他……克洛诺斯……而且{#Emph}打败{#Prev}了他！我化解了他的每一招、每一式，直到他投降受死。"
    }
    {
      Id = "Dora_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，{#Emph}好耶{#Prev}！那这一切都{#Emph}结束{#Prev}了，是吗？还是怎么着……？"
    }
    {
      Id = "Melinoe_3379"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，不，他不是真的{#Emph}死了{#Prev}……我的意思是，他没有真正{#Emph}消亡{#Prev}。暂时还没有。晚点再聊……好么？"
    }
    {
      Id = "Dora_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。好啦。"
    }
    {
      Id = "Dora_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你自以为取得了胜利，女巫？你不过是在延缓死期罢了！要知道你刚刚击败的泰坦，他的力量在我面前简直不值一提！"
    }
    {
      Id = "Melinoe_3722"
      InheritFrom = "BaseNarrative"
      DisplayName = "原来您听说了啊！伟大的亡灵啊，您甘愿屈尊了解我这些微不足道的成就，实在是让我受宠若惊。您是怎么知道的？"
    }
    {
      Id = "Dora_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我无所不知，无所不晓！{#Prev}以及，外面那些暗灵一直说个不停啦。他们有一些就在帐篷外面，我都跟他们说了不许进来，但他们好像还是守在帐篷门口……"
    }
    {
      Id = "Melinoe_3723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "谢谢你帮我拦住他们哦。"
    }
    {
      Id = "Dora_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "欸，等等，所以到底为什么你每晚都去下面对付时间泰坦，可他同时又在上面进攻奥林匹斯山？是有两个不同的时间泰坦，还是说就那一个？"
    }
    {
      Id = "Melinoe_3705"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯没有亲自率军攻打奥林匹斯山，朵拉。他是把他的军团派了过去。统领他的军团的，是个非常危险的将领……是另一个泰坦，名叫普罗米修斯。"
    }
    {
      Id = "Dora_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "另一个泰坦……名叫……普罗米修斯？{#Emph}普罗米修斯……{#Prev}唔……"
    }
    {
      Id = "Melinoe_3706"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，他是先见之泰坦。就算是你，应该也听过他从众神手中盗走圣火，因此受到严厉惩罚的故事吧。"
    }
    {
      Id = "Dora_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，只是……我觉得……啊，别想这个啦。回头见，小墨！"
    }
    {
      Id = "Melinoe_3707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你还好么……？"
    }
    {
      Id = "Dora_0323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}普罗米修斯……唔嗯……"
    }
    {
      Id = "Melinoe_5192"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我真正要对付的已经不是他了。不过，总而言之，克洛诺斯指派了另一个泰坦统领他的军团……那个泰坦名叫普罗米修斯。"
    }
    {
      Id = "Dora_0324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……普罗米修斯……先见……泰坦……？{#Emph}啧……是吧……"
    }
    {
      Id = "Melinoe_3708"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，一切都还好吗，朵拉？上次聊天的时候，我不是故意提起那些泰坦，影响你心情的。"
    }
    {
      Id = "Dora_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊我没事，小墨。真的，我现在已经不怎么会生气，也不怎么会感到尴尬了，只是……那个名字，{#Emph}普罗米修斯{#Prev}？我总感觉，好像这个名字……对我有某种特别的意义……？"
    }
    {
      Id = "Melinoe_3709"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是，普罗米修斯在此之前，已经被囚禁了千万年。如果你记得他……那得是很久之前的事情了。"
    }
    {
      Id = "Dora_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样的话，我就成老古董啦！不过，我连昨天发生的事情都记不清楚，也不知道那么久以前的事情我怎么还记得。也不是说我{#Emph}真的{#Prev}记得啦……除了……"
    }
    {
      Id = "Melinoe_3710"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……除了什么？"
    }
    {
      Id = "Dora_0327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，只是一种感觉……但是，总之不太妙。"
    }
    {
      Id = "Melinoe_3711"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，希望你不介意。关于你感受到的那种古老联系，我去问了普罗米修斯本人。他说话遮遮掩掩，语焉不详，但看起来他也记得你。"
    }
    {
      Id = "Dora_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！你替我去问这个说实话有些奇怪欸，毕竟他好像想杀光你全家，不过还是谢啦！他具体说了什么？"
    }
    {
      Id = "Melinoe_3712"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，他说……凡人的各种缺陷之类的，都不该怪罪于他，而且……而且也不该怪罪于你。然后他让我把这句话转达给你。当然，在那之后他跟我就打起来了，和往常一样。"
    }
    {
      Id = "Dora_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼，那我就放心了！这段时间来，我一直觉得全世界如果有两个人该为凡人所经受的所有糟糕的事情负责，那就准是{#Emph}普罗米修斯和我{#Prev}了！像什么肚子痛啦，心口痛啦，收税啦，撒谎啦，出轨啦……统统都要算进去哦。"
    }
    {
      Id = "Melinoe_3713"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一点都摸不着头脑，不过……你对他说的事情有任何头绪吗？"
    }
    {
      Id = "Dora_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有！不过既然你现在经常能跟他说上话，也许你可以再问一问，毕竟我们现在都很好奇。"
    }
    {
      Id = "Melinoe_3714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我们会搞清楚的。"
    }
    {
      Id = "Melinoe_3715"
      InheritFrom = "BaseNarrative"
      DisplayName = "普罗米修斯拒绝解释你和他的过往，朵拉。但他相信你用不了多久就会想起来了。可我担心……我担心你不知道反而更好。"
    }
    {
      Id = "Dora_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，你为什么会这么想？除了我跟你说过，我听到他的名字就有种不妙的感觉，还有什么别的理由吗？{#Emph}普罗米修斯……哕！{#Prev}没错！一念出口，就直犯恶心！"
    }
    {
      Id = "Melinoe_3716"
      InheritFrom = "BaseNarrative"
      DisplayName = "按照他的说法，你好像是主动选择忘掉了他，而且一并忘掉了很多很多东西。如果这是真的，那也许这样还更好——哪怕只是对过往的你更好。"
    }
    {
      Id = "Dora_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "别管{#Emph}过往{#Prev}的我了，小墨，{#Emph}现在{#Prev}的我可来劲了，不把这事弄清楚誓不罢休！你没有什么{#Emph}巫咒{#Prev}可以帮助我唤醒一下记忆，之类的嘛？"
    }
    {
      Id = "Melinoe_3717"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……既然现在我知道你的这条关系，那就算是有个出发点了。不过，你真的确定你想要这样吗？"
    }
    {
      Id = "Dora_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那当然！肯定会{#Emph}很有趣的……"
    }
    {
      Id = "Melinoe_2093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就信你一次……"
    }
    {
      Id = "Dora_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "弄出来那个帮我唤醒记忆的魔法没有？也不用有压力啦，我不记得，只是……就想问你一下！"
    }
    {
      Id = "Melinoe_3718"
      InheritFrom = "BaseNarrative"
      DisplayName = "和记忆与过往相关的咒语需要格外谨慎，所以这种事情我们急不来啦。而且，如果你改变主意了的话，一定要立刻告诉我哦。"
    }
    {
      Id = "Dora_0335"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别老这么担心啦，小墨！"
    }
    {
      Id = "Dora_0577"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我想起了一切……想起了我当初{#Emph}忘记{#Prev}一切的理由……我做了很坏很坏的事，小墨。"
    }
    {
      Id = "Melinoe_4654"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管你做了什么事，你都不用逼自己向我坦白。当然，除非你想要倾诉；那样的话我随时愿意倾听。"
    }
    {
      Id = "Dora_0578"
      InheritFrom = "BaseNarrative"
      DisplayName = "……嗯，长话短说的话，我大概算是毁了所有东西，害了所有人。至少是所有凡人。"
    }
    {
      Id = "Melinoe_4655"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在说什么？这怎么可能！"
    }
    {
      Id = "Dora_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……想象一下曾经有一个巨大的罐子，好么？就是腌黄瓜的那种，但众神没有拿它来腌黄瓜，而是把天底下的坏事都装在了里面。憎恨啦，心碎啦，脱发啦，口臭啦……要什么有什么。"
    }
    {
      Id = "Melinoe_4656"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没太听明白。为什么众神要把凡人的所有恶习和缺点都装在这个罐子里？听起来你好像是在说什么比喻。"
    }
    {
      Id = "Dora_0580"
      InheritFrom = "BaseNarrative"
      DisplayName = "不，是真的有个罐子，而我……唔，细节我还记不太清楚。咱们晚点再说吧，我这会儿累得不行了。"
    }
    {
      Id = "Melinoe_4657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我随时都可以……"
    }
    {
      Id = "Dora_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "……还记得上次我提到的那个罐子，就是装满坏事的那个吗？{#Emph}我{#Prev}把它打开了。我就想看看里面有什么！然后“嗖”地一声……{#Emph}几乎{#Prev}所有的东西都飞出来了，飞入了整个世界。飞入了我们的生活。"
    }
    {
      Id = "Melinoe_4658"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么？你为什么会做这种事？这个罐子又是怎么落到你手里的？"
    }
    {
      Id = "Dora_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是件结婚礼物，出自奥林匹斯众神之手。那个普罗米修斯，我现在想起来他了，{#Emph}很有意思{#Prev}的家伙。他还有个身材结实的弟弟；我跟他弟弟擦出了点火花……"
    }
    {
      Id = "Melinoe_4659"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以众神想送你一个装满了坏事的罐子。听起来真是件奇怪的礼物，怎么会把这种礼物送给……话说回来，你生前到底是什么人？"
    }
    {
      Id = "Dora_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呀，我就是个普普通通的女人而已！但那个时候我这种人不多，而且我觉得众神好像不怎么喜欢普罗米修斯？所以总之，下一次凡人踢到脚趾啦，缴纳税款啦，累得满头大汗啦，所有这些坏事……全都是我的错。"
    }
    {
      Id = "Melinoe_4660"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算你说的都是真的，听起来你也不是有意为之。所以不能怪你。"
    }
    {
      Id = "Dora_0584"
      InheritFrom = "BaseNarrative"
      DisplayName = "重点是{#Emph}确实{#Prev}是我做的，所以这{#Emph}就是{#Prev}我的错……我得走了。"
    }
    {
      Id = "Melinoe_4661_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "朵拉……！"
    }
    {
      Id = "Dora_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以，嗯，我之前大概是让所有凡人受了诅咒。就算我{#Emph}不是故意的{#Prev}，那又能怎么样？意图又不重要。"
    }
    {
      Id = "Melinoe_4662"
      InheritFrom = "BaseNarrative"
      DisplayName = "意图当然重要。所以在那之后，你就喝下了遗忘之河的河水，好摆脱这些记忆，洗刷自己的负罪感？"
    }
    {
      Id = "Dora_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "……差不多吧。但你知道唯一一件我没有放出来的事物是什么吗？是希望。我当时慌得要死，啪一下就把它关在里面了。就那么一件我该放出来的东西，我却偏偏没放。"
    }
    {
      Id = "Melinoe_4663"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得不好说欸。我们经常会感受到希望，众神和凡人都一样。如果你当时把它放出来了的话……说不定它会立刻被那些坏事浇灭呢。那样的话，谁知道世界会变成什么样子？"
    }
    {
      Id = "Dora_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样的话，也许凡人就不会有这么多不切实际的幻想？总之……感觉我现在想一个人静静。谢谢你听我把这件事完整讲了一遍，小墨。也谢谢你让我记起这一切。"
    }
    {
      Id = "Melinoe_4664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你会好起来的，对吗？"
    }
    {
      Id = "Dora_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯……大概吧。"
    }
    {
      Id = "Melinoe_4665"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我还是无法相信众神会做这样的局，让你诅咒所有凡人……有没有可能你的记忆出了什么问题？"
    }
    {
      Id = "Dora_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "……大概吧？但我现在记得很清楚了，哪怕这一切是很久以前的事。不过还有一个疑点是，这些坏事里有一大部分，你们众神也会经历吧？我的意思是，你们虽然不会像凡人一样挂掉，但是……别的坏事你们都会遇到……"
    }
    {
      Id = "Melinoe_4666"
      InheritFrom = "BaseNarrative"
      DisplayName = "也不算是都会，不过大部分是会的。所以……也许这个罐子只是某种拉近凡人与众神距离的工具……？是它塑造了我们所知的现实。"
    }
    {
      Id = "Dora_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来像是我留在罐子里的希望在说话啊，小墨。你不觉得众神有可能只是……想报复普罗米修斯、他的弟弟，还有他弟弟的美丽妻子吗？"
    }
    {
      Id = "Melinoe_4667"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许吧，可是……做出这种伤天害理的事，对他们又有什么好处？"
    }
    {
      Id = "Dora_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "众神也可以很混蛋啊。和凡人一样，但比凡人厉害得多。"
    }
    {
      Id = "Dora_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跟{#Emph}那个罐子{#Prev}的事情，你没跟别人说过，对吧？我希望这件事只有我们知道啦。还好我现在记起来了，但是……我可不想走漏风声之后，成为人们关注的焦点……"
    }
    {
      Id = "Melinoe_4668"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只跟普罗米修斯提起过，因为他本来就知道当时的事。但我绝对不会告诉其他人。"
    }
    {
      Id = "Dora_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "好。也许等到很久以后，我真的很想气气大家的话，我会亲口告诉他们？就算不会，这也给了我{#Emph}一大堆{#Prev}新素材，可以用来装神弄鬼了！超可怕的好吧。"
    }
    {
      Id = "Melinoe_4669"
      InheritFrom = "BaseNarrative"
      DisplayName = "还是别把这件事当玩笑了吧，朵拉。不过我想，坦然面对过去肯定比试图忘却过去更好。从这个角度来说，你真的勇气可嘉。"
    }
    {
      Id = "Dora_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}而你则愚不可及！给我退下。"
    }
    {
      Id = "Dora_0620"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，想跟你说，谢谢你把我费尽心思想要抹去的那些可怕回忆全都找回来了……我是认真的！我宁可被这些回忆在我心里憋死，也不想把它们忘得一干二净。"
    }
    {
      Id = "Melinoe_4687"
      InheritFrom = "BaseNarrative"
      DisplayName = "对我而言，这是你的选择，不是我的啦。作为朋友，我想要支持你。我们都知道你找回的记忆有可能会让你很痛苦。"
    }
    {
      Id = "Dora_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}痛苦{#Prev}，我看未必。这可是身为暗灵为数不多的好处之一！再也不会痛苦啦！虽然想到世界{#Emph}曾经{#Prev}的样子……还是会有些沮丧啦，大概吧。"
    }
    {
      Id = "Melinoe_4688"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个我觉得也算是痛苦。跟被涅墨西斯使出全力打了一拳不一样，但伤得可能更深，而愈合的过程也可能缓慢得多。不过，你想起来的应该不会只有这些痛苦的回忆吧？"
    }
    {
      Id = "Dora_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "大概不止吧，但其他的事情都没这么劲爆，你懂吗？总之都是些前尘往事啦。现在的我是另一个人了。"
    }
    {
      Id = "Melinoe_4689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我很高兴。"
    }
    {
      Id = "Dora_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，发生什么事啦，你看起来好奇怪，搞不懂耶。你才出去没一会儿吧。该不会是带人去小树林里了吧……？"
    }
    {
      Id = "Melinoe_3373"
      InheritFrom = "BaseNarrative"
      DisplayName = "不是，朵拉，不过恐怕我三言两语解释不清楚。你知道漆黑之石吗？事实上它……有某些特殊的作用。"
    }
    {
      Id = "Dora_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说那块{#Emph}紫不啦叽的石头{#Prev}有特殊的作用。你猜怎么着？我一点都不想知道细节，你还是省省功夫吧，我沉浸在自己的想象中就好。谢啦。"
    }
    {
      Id = "Melinoe_3374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，不客气？"
    }
    {
      Id = "Dora_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近越来越喜欢盯着那张画出神了。{#Emph}幸福美满的家庭！{#Prev}这样有点影响到我了，因为我觉得它有点影响到{#Emph}你{#Prev}了。别在我面前哭得泪眼汪汪的哦，小墨。"
    }
    {
      Id = "Melinoe_3376"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你的关心，朵拉，但你不用担心啦。我不会沉溺于回忆之中的，因为那时候的事我实在记不起多少。我只是好奇我的哥哥，还有我的生身父母都是什么样子。"
    }
    {
      Id = "Dora_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊哈！听起来分明就是在沉溺于过往嘛。别想啦，当时你也没什么能做的嘛！嘿……{#Emph}现在{#Prev}你也可以什么都不做哦。"
    }
    {
      Id = "Melinoe_3377"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我会考虑的。"
    }
    {
      Id = "Dora_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "考不考虑随你！"
    }
    {
      Id = "Dora_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，嘿，小墨，我刚才正忙着……忙着飘呢！忙着四处飘，大概吧。以及忙着发呆！最近我经常发呆。你呢？"
    }
    {
      Id = "Melinoe_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正忙着受挫呢。也许也有些进展吧，我不好说。说起来，朵拉，你不应该继续练习你的装神弄鬼吗？"
    }
    {
      Id = "Dora_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！那个啊，暂时不了啦。我想先歇一歇。能以后再做的事，为什么要现在做呢，你说对吧？"
    }
    {
      Id = "Melinoe_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "为了获得成就感？"
    }
    {
      Id = "Dora_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}嘁！"
    }
    {
      Id = "Dora_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿……"
    }
    {
      Id = "Dora_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "说实话，小墨，有的时候我真希望{#Emph}我{#Prev}也有个重要的任务。虽然四处飘也不能说不算重要任务啦。"
    }
    {
      Id = "Melinoe_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道我对这件事的态度的，朵拉。你得走出这个帐篷。你很有天赋的！我从来没见过像你一样会说话的暗灵呢！"
    }
    {
      Id = "Dora_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，我{#Emph}会说话{#Prev}耶，我{#Emph}好独特{#Prev}耶。啧！我相信不管多低贱的暗灵，只要被困在这里够久，听你们这些人每天聊个不停，早晚也能学会说话的。"
    }
    {
      Id = "Melinoe_4272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "或者你也可以教教他们？"
    }
    {
      Id = "Dora_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……不要！"
    }
    {
      Id = "Dora_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿，小墨。"
    }
    {
      Id = "Melinoe_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "一切都还好吗，朵拉？有什么新的装神弄鬼的方式，想让我评估一下之类的吗？"
    }
    {
      Id = "Dora_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "没，我、我挺好的，只是……感觉我遇到了瓶颈。这种事谁都会遇上的，对吧？我会调整过来的。"
    }
    {
      Id = "Melinoe_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就好。"
    }
    {
      Id = "Dora_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，如果我是你的话，我会……唔，说到这个，我……我会做很多事。我会去跑跑步！能跑步该多好。你有腿耶！可以感受到心率的升高耶，心！我要是有颗心该多好！"
    }
    {
      Id = "Melinoe_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，别这样。你知道我不喜欢你这样的。"
    }
    {
      Id = "Dora_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "……用我的双手做点什么！我不知道耶，做个杯子？做个碗。毕竟还得吃饭呢！我要是能吃饭该多好。哪怕记得吃饭是什么感觉也好……"
    }
    {
      Id = "Melinoe_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重，朵拉……"
    }
    {
      Id = "Dora_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有没有想过，小墨，说不定我们压根就不是这块料？我可能不适合装神弄鬼，你也不适合……那个，你最近在做什么来着？"
    }
    {
      Id = "Melinoe_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}找到时间泰坦，惩罚他对我的家族犯下的罪行。救出冥界之王，让他重回王位……{#Prev}嘿，你装神弄鬼没问题的，朵拉！"
    }
    {
      Id = "Dora_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，谢啦！我也相信你搞定你那一箩筐的事也没问题的。"
    }
    {
      Id = "Dora_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你在外面都做些什么啊，就摘些花花草草之类的吗？你以前可从来都不出门呢。"
    }
    {
      Id = "Melinoe_3699"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，我之前一直都在暗中训练啊！现在，我每晚出去，基本上都是在杀出一条血路，去找克洛诺斯……路上有各种各样的东西想要我的命。"
    }
    {
      Id = "Dora_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道是为什么呢。而你就这么一直坚持做同样的事，是嘛。换做是我早就放弃了！你应该试一试。试试放弃是什么感觉。"
    }
    {
      Id = "Melinoe_3700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不了，谢谢。"
    }
    {
      Id = "Melinoe_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，要是你一个人独享这顶帐篷的话，你会做什么呢，朵拉？大概可以把所有其他暗灵都邀请过来，然后想怎么折腾就怎么折腾吧……"
    }
    {
      Id = "Dora_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "什、什么，你以为我要{#Emph}分享{#Prev}吗？小墨啊，{#Emph}“独享”{#Prev}的意思就是不分享啊。正式的装神弄鬼需要{#Emph}吓人者{#Prev}与{#Emph}被吓者{#Prev}严格遵循1：1的比例。我可没忘记这些最基础的东西。"
    }
    {
      Id = "Melinoe_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是难以想象，你想要的居然只是在这里四处飘，再减去跟我聊天的部分。"
    }
    {
      Id = "Dora_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "那说明你缺乏想象力，朋友！"
    }
    {
      Id = "Melinoe_0413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呵。"
    }
    {
      Id = "Dora_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}愿你堕入苦海，永世不得超生，女巫！你竟敢踏足我的圣地。我要扼住你的咽喉，令你的求饶声化为可悲的呜咽！"
    }
    {
      Id = "Melinoe_2019"
      InheritFrom = "BaseNarrative"
      DisplayName = "大人饶命！小的是一时疏忽，求求您放我一马吧！打扰到您的安眠，真不是我的本意……"
    }
    {
      Id = "Dora_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}哇！{#Prev}你真的很吃这一套耶，是吗？"
    }
    {
      Id = "Melinoe_2020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "可不是嘛！"
    }
    {
      Id = "Dora_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨，跟我说说，你最近在外面遇到的最可怕的东西是什么？对我这个位置上的人来说，在这方面掌握第一手资讯相当重要。"
    }
    {
      Id = "Melinoe_3701"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……那肯定要数那只暴怒的渊狱魔兽了，他把守着通往塔耳塔罗斯的唯一道路。那是个庞然大物，长着尖锐的牙齿，以及三张喷火的血盆大口……不过他也是我们家里养的狗狗。"
    }
    {
      Id = "Dora_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，差点就被你唬住了！好吧，既然你说没有什么东西比一只宠物狗更可怕……那就意味着根本没有人能和我竞争了！是时候继续享受鹤立鸡群的感觉咯。"
    }
    {
      Id = "Melinoe_3702"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好好享受吧。"
    }
    {
      Id = "Dora_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}你目光所及，尽是我的领地。"
    }
    {
      Id = "Dora_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你胆敢闯入我的栖身之地！我要你受尽折磨，永世不得超脱！当然，除非你愿意满足我的遗愿……"
    }
    {
      Id = "Melinoe_3719"
      InheritFrom = "BaseNarrative"
      DisplayName = "请原谅我的冒犯，亡魂。说出你的要求吧，什么事我都愿意为你做！至少合理的事情肯定可以啦。"
    }
    {
      Id = "Dora_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}那就立刻对我起誓，保证不负我的嘱托！至于具体内容……{#Prev}我还没编好遗愿那部分啦。要你去找回我爱人的遗骨，之类的？"
    }
    {
      Id = "Melinoe_3720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有什么进展就跟我说哦。"
    }
    {
      Id = "Dora_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}上前来，女巫！在这遍布诅咒之地，只有死亡在等待你。你准备好献出你的生命之液，换取你所渴求之物了吗？还是说，你会就此回头，无功而返？"
    }
    {
      Id = "Melinoe_3721"
      InheritFrom = "BaseNarrative"
      DisplayName = "我回头的话，就只有“死路”一条了，亡魂。听起来我横竖都是一死啦！我得去看看其他人，所以我就先……"
    }
    {
      Id = "Dora_0339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊！那就去吧。"
    }
    {
      Id = "Dora_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，小墨，你是怎么了？你看起来像是刚刚看到了……呃……我也说不准，但是……你看到的东西一定很可怕，你都起鸡皮疙瘩了。{#Emph}（吸气）噢！{#Prev}我要是能起鸡皮疙瘩就好了！"
    }
    {
      Id = "Melinoe_2015"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没事，只不过受了些惊吓。任务开始以来第一次做噩梦。"
    }
    {
      Id = "Dora_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "那也该是时候了，都这么久了。欸，所以说，刚才那个噩梦的恐怖程度，呃，{#Emph}与你面前骇人的鬼影相比，孰优孰劣？"
    }
    {
      Id = "Melinoe_2016"
      InheritFrom = "BaseSubtitle"
      DisplayName = "比你差远了呢。"
    }
    {
      Id = "Dora_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道我以前有没有做过噩梦……所以，做噩梦就是……就是{#Emph}想象{#Prev}自己身处一个{#Emph}截然不同{#Prev}的{#Emph}可怕{#Prev}环境里……？"
    }
    {
      Id = "Melinoe_2017"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的。而且有的时候我什么都做不了，只能眼睁睁地看着一切发生，这就更恐怖了。不过最近我已经不像以前那样害怕了……"
    }
    {
      Id = "Dora_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯……至少你还有我呢。"
    }
    {
      Id = "Dora_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你要是早点回来的话，就又能听到涅墨西斯抱怨这抱怨那了耶！"
    }
    {
      Id = "Melinoe_1602"
      InheritFrom = "BaseNarrative"
      DisplayName = "最好不要这样嘲笑报应化身，不然只怕你也会遭报应。她和老师已经针锋相对很久了……"
    }
    {
      Id = "Dora_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道，我可以，就，帮你{#Emph}附身{#Prev}她，对吧？只要嗖地一下冲过去，在她的脑海里旁敲侧击一下，让她干出些{#Emph}坏事{#Prev}……{#Emph}（吸气）{#Prev}干出些{#Emph}糗事{#Prev}！当然，就只是一小会儿啦。要是我被抓到的话……"
    }
    {
      Id = "Melinoe_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "朵拉，别……"
    }
    {
      Id = "Dora_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "你在那边不省人事的时候，有没有至少睡上一会儿？呵，我实在没法想象那到底是种什么样的感觉。睡觉……人们说就像死了一样，对吧？但我已经死了，可是却一直都醒着。"
    }
    {
      Id = "Melinoe_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得最近唯一一个有睡好觉的恐怕就是修普诺斯本尊了。他直到现在连动都没有动过一下，不管老师想出什么办法都没有效果。"
    }
    {
      Id = "Dora_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "算他走运。"
    }
    {
      Id = "Dora_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，那个长角的家伙到底是怎么回事？我看他跟涅墨西斯聊天的样子怪得很耶，就跟他俩有一腿似的。"
    }
    {
      Id = "Melinoe_1826"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们是兄妹啦，朵拉。“那个长角的家伙”是摩罗斯大人，命运三女神的使者。他是我们的贵客，也是一位非常重要的盟友。"
    }
    {
      Id = "Dora_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "噢！怪不得我们把他伺候得那么好……"
    }
    {
      Id = "Dora_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，所以那边那个长角的……{#Emph}他{#Prev}就是普普通通的凡人将要{#Emph}死于非命{#Prev}时会见到的神明，是吗？"
    }
    {
      Id = "Melinoe_2029"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，对的。他会确保命运三女神的旨意得以实现。不过别因此怪罪于他，也没有必要在他身边感到害怕啦。"
    }
    {
      Id = "Dora_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "开什么玩笑啦？我觉得他酷毙了哎！我……我想知道他有没有见到我是怎么死的！说不定是被一块大石头砸死！被闪电劈死！{#Emph}（吸气）{#Prev}或者被我的情人谋杀……！你可以介绍我们认识一下吗？"
    }
    {
      Id = "Melinoe_2030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃……没问题？"
    }
    {
      Id = "Dora_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前看到你又跟长角的聊天啦！他是有点呆啦，但人大概还不错。我总觉得他似曾相识，一定是在我死的时候见到过他……"
    }
    {
      Id = "Melinoe_2023"
      InheritFrom = "BaseNarrative"
      DisplayName = "我看未必。像他这样的人，见过一次，你就肯定忘不了了。而且他也应该记得你才对！不过话说回来，你是很久之前死掉的了……"
    }
    {
      Id = "Dora_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啊。说不定我是他最早的目标之一呢，那时候的我一定正值花季，懵懵懂懂，却难逃在绽放之前便凋谢的凄楚命运……"
    }
    {
      Id = "Melinoe_2024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "行啦，朵拉。"
    }
    {
      Id = "Dora_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，小墨！那边那位{#Emph}指挥官{#Prev}邀请我成为他的{#Emph}学徒{#Prev}接受训练欸。这可是个重大的决定，所以我还在考虑……"
    }
    {
      Id = "Melinoe_2025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我从他那里学到了很多东西，朵拉。老师教会了我巫术，但瑟勒米乌斯指挥官，他教会了我……{#Emph}呃……"
    }
    {
      Id = "Dora_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如何殴打老年人……？"
    }
    {
      Id = "Melinoe_2026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "才不是！"
    }
    {
      Id = "Dora_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，话说我想问下，训练场的那些雕像是{#Emph}怎么回事{#Prev}？雕像里的人是你吗？{#Emph}毕竟……{#Prev}呃……她们看起来比你块头{#Emph}大很多{#Prev}……"
    }
    {
      Id = "Melinoe_4685"
      InheritFrom = "BaseNarrative"
      DisplayName = "……雕像有时会对被雕刻的对象进行明显的美化，又或者戏剧性的刻画！总之，我赢得了“黑夜战将”的称号，而那些……就是我的奖励。"
    }
    {
      Id = "Dora_0619"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我对你真是刮目相看耶！我真的很喜欢举着巨斧那个。"
    }
    {
      Id = "Melinoe_4686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喔，真的吗？"
    }
    {
      Id = "Melinoe_2027"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有听过一个叫{#Emph}“赫拉克勒斯”{#Prev}的吗？地表最伟大的半神英雄，杀死尼米亚猛狮的人……？"
    }
    {
      Id = "Dora_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有耶。不过时不时就会有别的暗灵{#Emph}喋喋不休{#Prev}地说他的事迹。怎么问起这个来了？"
    }
    {
      Id = "Melinoe_2028"
      InheritFrom = "BaseNarrative"
      DisplayName = "我遇见他了。他和人们口中说的一样高大威猛，这点毋庸置疑。他过去的英雄事迹那么多，我想着你说不定能回想起来一两个呢。"
    }
    {
      Id = "Dora_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那看来你想错了，朋友。"
    }
    {
      Id = "Dora_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，呃，你和那家伙，那个带翅膀的，叫什么来着？我还以为他早{#Emph}死了{#Prev}呢，但上次我看到他和你在这里的时候，他看起来，怎么说，活蹦乱跳的？他是怎么做到的？"
    }
    {
      Id = "Melinoe_4683"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是在说伊卡洛斯，那你……那你是不是在偷听我和他聊天？那很明显是两个老朋友在度过一段私人时间好嘛？我还以为你不在呢！"
    }
    {
      Id = "Dora_0616"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，没啊，我就在{#Emph}那边{#Prev}。想着还是不要打扰你们的好。所以你是用死灵仪式把他复活了，还是怎么着？"
    }
    {
      Id = "Melinoe_4684"
      InheritFrom = "BaseNarrative"
      DisplayName = "这完全是我的私事，谢谢关心……！"
    }
    {
      Id = "Dora_0617"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真没什么好害羞的啦，相信我。"
    }
    {
      Id = "Dora_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，所以这边到底是什么情况？你完成那个超级重要的大任务了吗？我听别的暗灵好像都这么说欸。"
    }
    {
      Id = "Melinoe_4873"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，总体来说，是的！我的家人都回来了！我爸妈都回到了冥府的王座上，哥哥也回来了！但我们还有很多细枝末节的事需要处理，而且……泰坦克洛诺斯会在这个过程中帮助我们。"
    }
    {
      Id = "Dora_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说了那么多次“必死无疑”的泰坦……{#Emph}帮助我们。{#Prev}恕我直言啊，小墨，听起来你彻底搞砸了。至少泰坦那部分是这样。"
    }
    {
      Id = "Melinoe_4874"
      InheritFrom = "BaseNarrative"
      DisplayName = "他已经不再是他自己了，或者我应该说……不再是原来的他了。而且我们会密切监视他的。"
    }
    {
      Id = "Dora_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "行啊。所以……总的来说，应该祝贺你咯？"
    }
    {
      Id = "Melinoe_4875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唔，如果你想的话……"
    }
    {
      Id = "Dora_0609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那当然。祝贺你啊，小墨。"
    }
    {
      Id = "Dora_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "在那边搞了幅新的画像嘛。你爸妈送的？看起来比原来那幅新多了。你们都长大了！"
    }
    {
      Id = "Melinoe_4876"
      InheritFrom = "BaseNarrative"
      DisplayName = "算是一件临别礼物吧，毕竟我不会待在冥府，和他们住在一起。但我应该能时不时和他们相见啦。"
    }
    {
      Id = "Dora_0624"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哇，太缺德了吧！{#Prev}他们怎么会不让你搬进那个地底要塞，和{#Emph}他们{#Prev}住在一起？你是他们的{#Emph}女儿{#Prev}欸！"
    }
    {
      Id = "Melinoe_4877"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们是想让我留下来，只是……这里才是我的家。他们是我的家人，但这里的人也是。"
    }
    {
      Id = "Dora_0625"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你疯了吗？等等，那我也是你的家人咯，你是这个意思吗？"
    }
    {
      Id = "Melinoe_4878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是呀，只要你没意见。"
    }
    {
      Id = "Dora_0626"
      InheritFrom = "BaseSubtitle"
      DisplayName = "喔，那好啊，为什么不呢？"
    }
    {
      Id = "Melinoe_4879"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，朵拉，假设在未来某个时间会有一个新的时代来临，然后到那时候众神真的不再干涉凡人的事情，至少比之前干涉得更少一点，你会怎么看？"
    }
    {
      Id = "Dora_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你这是要给我什么{#Emph}好处{#Prev}吗？我知道你最近很有面子，但就算是你也没能力搞定这种事吧，小墨。众神难道会心甘情愿撒手不干吗？"
    }
    {
      Id = "Melinoe_4880"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算是众神，也要受制于命运三女神的意志。我们没有人能完全控制未来会发生什么，而且有些预言无论怎么做都无法违背。"
    }
    {
      Id = "Dora_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "你做了这一切之后，还信那个啊？就，难道{#Emph}真的{#Prev}有某种提到克洛诺斯的预言，上面说什么一旦{#Emph}我{#Prev}让你觉醒了真正的潜能，你就能最终击败他，有这种事吗？"
    }
    {
      Id = "Melinoe_4881"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，没有，主要是命运三女神在这整场动荡之中基本都缺席了，不过……她们的预言，往往都很准。"
    }
    {
      Id = "Dora_0629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "得了吧。发生了我才信。"
    }
    {
      Id = "Dora_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "……于是我就对她说：{#Emph}“从我面前消失，你这该死的女巫！这片林地乃是我栖身之处，已有千万年之久，远非你那破败的营帐所能比！”{#Prev}喔，你好呀，小墨。"
    }
    {
      Id = "Melinoe_2031"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来两位见过面了呀！摩罗斯大人，朵拉说的都是实话。她在这里的时间比我还要久，如果您能相信的话！"
    }
    {
      Id = "Moros_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "我自然是相信的。因为我一眼便能认出亡魂的年岁。很荣幸认识您，朵拉。倘若有任何我能效劳之处，还望您不必客气。"
    }
    {
      Id = "Dora_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哈哈。{#Prev}那我以后就不客气了，长角的！现在，{#Emph}你可以退下了。再会！"
    }
    {
      Id = "Moros_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再会！"
    }
    {
      Id = "Dora_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "……他的{#Emph}亲哥哥{#Prev}？噫，你开玩笑的吧，这也太扯了！你的姐姐们好变态喔！"
    }
    {
      Id = "Moros_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……她们毕竟要编织无数凡人的命运，日复一日这样下去，难免会丧失热情。因此她们时不时就会找些新鲜感。"
    }
    {
      Id = "Dora_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那、那是当然，换做是我也会这么做啦。不知道她们当初是怎么编排{#Emph}我{#Prev}的……你能不能，就，呃，帮我查一下之类的……？"
    }
    {
      Id = "Moros_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈！这种事恐怕我也爱莫能助。"
    }
    {
      Id = "Dora_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哎呀，拜托啦……"
    }
    {
      Id = "Dora_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}拜倒在我面前罢，犄角之王，休想有半分僭越，否则我便将你与你那飘逸的银发一同化为飞灰！"
    }
    {
      Id = "Moros_0697"
      InheritFrom = "BaseNarrative"
      DisplayName = "……啊，着实是精彩的表现，朵拉。不过，“犄角之王”？恐怕这样的称呼会让我听起来有某种显赫的地位，然而我想你追求的，应当是彻底凌驾于我之上才是。"
    }
    {
      Id = "Dora_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "对吼，是这么回事。只是这个称呼突然就在我脑海里出现了，你懂吗？你的角……实在是酷毙了！是真的吗？"
    }
    {
      Id = "Moros_0698"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不可以摸。"
    }
    {
      Id = "Dora_0657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我偏要摸。"
    }
    {
      Id = "Moros_0699"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不可以。"
    }
    {
      Id = "Dora_0658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我偏要！"
    }
    {
      Id = "Moros_0700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "求你了……？"
    }
    {
      Id = "Dora_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "……所以，你就这么站在这里，想到什么就说什么，然后{#Emph}其他的{#Prev}暗灵，还有小墨……他们就这么照单全收了？"
    }
    {
      Id = "Skelly_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然，他们照单全收，学徒，因为这是我赐予他们的宝贵智慧，这些智慧全都基于我无比丰富的人生经验！好了，现在，你问够了没有……？"
    }
    {
      Id = "Dora_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好啦，我知道了。{#Emph}指挥官。"
    }
    {
      Id = "Skelly_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "刚刚到哪里了？"
    }
    {
      Id = "Dora_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你出去的时候，我会替你看好你的东西的。"
    }
    {
      Id = "Dora_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴与你聊天，不过我得继续去装神弄鬼了。"
    }
    {
      Id = "Dora_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里有很多稀奇古怪的东西，你知道吧？"
    }
    {
      Id = "Dora_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近就在装神弄鬼而已。别担心我喔……"
    }
    {
      Id = "Dora_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，小墨。我是说，{#Emph}愿乌鸦啄瞎你的眼睛！"
    }
    {
      Id = "Dora_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，小墨。我是说，{#Emph}胆敢寻找我，你只会找到死亡！"
    }
    {
      Id = "Dora_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}再敢扰我清静，我便让你三生三世不得安宁！"
    }
    {
      Id = "Dora_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}愿你的白日皆是恐惧，黑夜皆是惊悚！"
    }
    {
      Id = "Dora_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}胆敢呼唤我的名讳，我要为你降下一千道诅咒！"
    }
    {
      Id = "Dora_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}我的营帐不是让你逗留的地方，女巫！"
    }
    {
      Id = "Dora_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "去做你该做的事吧，当我不在这就好。"
    }
    {
      Id = "Dora_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我只是在飘来飘去而已，别在意我哦。"
    }
    {
      Id = "Dora_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "毕竟这是你的帐篷，你爱呆多久呆多久。"
    }
    {
      Id = "Dora_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "要是想让我帮你折磨谁的话，一定要跟我说哦，好吗？"
    }
    {
      Id = "Dora_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望你那个大任务进展得还不错！"
    }
    {
      Id = "Dora_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你出去的时候，我会尽量不把所有东西糟蹋掉的。"
    }
    {
      Id = "Dora_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，能给我一点私人空间吗，小墨？"
    }
    {
      Id = "Dora_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "你赶紧出去吧，这样我才能赶紧翻乱你的东西呀。"
    }
    {
      Id = "Dora_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你{#Prev}存在，{#Emph}我{#Prev}也存在，有什么大不了的……对吧？"
    }
    {
      Id = "Dora_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管你在折腾什么，祝你折腾得开心！"
    }
    {
      Id = "Dora_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "替我把他们统统打死！或者打活！也不知道哪个更糟。"
    }
    {
      Id = "Dora_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "等你出去之后，我要把这个帐篷吓得{#Emph}魂飞魄散{#Prev}……"
    }
    {
      Id = "Dora_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "在外面就随遇而安吧！我一直都是这样过来的！"
    }
    {
      Id = "Dora_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "哇，小墨！好狠的眼神，你是要把克洛诺斯瞪死吗？"
    }
    {
      Id = "Dora_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "希望你在外面不要被打得太惨哦！"
    }
    {
      Id = "Dora_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨，是你激发了我的热情……让我想就这样浮在这里。"
    }
    {
      Id = "Dora_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，小墨！我是说，{#Emph}我岂是你能呼来喝去的存在，女巫！"
    }
    {
      Id = "Dora_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你如此锲而不舍地反复现身，令我完全没有不可以忍受，女巫！"
    }
    {
      Id = "Dora_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "这里的布置之类的有没有什么需要改动的地方？"
    }
    {
      Id = "Dora_0631"
      InheritFrom = "BaseNarrative"
      DisplayName = "有的时候我真的很想，就，找个人{#Emph}附身{#Prev}一下，你懂吗？就一下下。"
    }
    {
      Id = "Dora_0632"
      InheritFrom = "BaseNarrative"
      DisplayName = "别在意我！我只是在忙自己的啦，小墨。"
    }
    {
      Id = "Dora_0633"
      InheritFrom = "BaseNarrative"
      DisplayName = "外面那些暗灵好像在说你今晚又表现不错欸？"
    }
    {
      Id = "Dora_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "想要谁体验一下鬼魂缠身的感觉，就跟我说一声喔。"
    }
    {
      Id = "Dora_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你胆敢直视我，女巫？我要让你此生再无安宁！"
    }
    {
      Id = "Dora_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}胆敢直视我双眼者，尽要受我生前所受之苦！"
    }
    {
      Id = "Dora_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}见过我面容之人，皆永世不得超生，受尽蚊虫叮咬！"
    }
    {
      Id = "Dora_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不在的时候，我有帮你看东西哦，而且还把{#Emph}胆敢靠近的人吓得夺路而逃！"
    }
    {
      Id = "Dora_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "你整晚在外面闯荡的时候，我会替你守着帐篷的，小墨。"
    }
    {
      Id = "Dora_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "需要我做什么，我就在这里喔。也可能出现在外面哪里啦。"
    }
    {
      Id = "Dora_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "刚刚有个暗灵跟我打了个招呼，{#Emph}那是第一次，也是最后一次！"
    }
    {
      Id = "Dora_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "这边最近一切都还不错，只要你也过得不错就好。"
    }
    {
      Id = "Melinoe_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想把这个送给你，朵拉。敬整个三岔路口最会装神弄鬼的暗灵！"
    }
    {
      Id = "Dora_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "哼，我就{#Emph}知道{#Prev}你早晚有一天会跟我来互换礼物这一套的，所以我早有准备。接着！"
    }
    {
      Id = "Dora_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，你不用专门给我这种东西的！反正我可以趁你不在的时候自己伸手拿啦！"
    }
    {
      Id = "Melinoe_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你可拿不到{#Emph}这个{#Prev}！这些我一直都带在身边，就是专门为这种场合所准备的。"
    }
    {
      Id = "Dora_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}蠢货！休想用这种稀奇古怪的玩意收买我！{#Prev}啊，开玩笑的啦。拿这个收买我{#Emph}正合适{#Prev}。快给我！"
    }
    {
      Id = "Melinoe_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "终于找到你的弱点啦。"
    }
    {
      Id = "Dora_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "我现在感觉，说不定在我还有眼球什么的时候，我还挺喜欢这玩意的。"
    }
    {
      Id = "Melinoe_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "你曾经喜不喜欢不重要，重要的是你现在喜欢啦。"
    }
    {
      Id = "Dora_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "呃，一方面来说啦，我真不知道我做了什么，值得你这样对我。但另一方面，我一点都不在意！归我啦。"
    }
    {
      Id = "Melinoe_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "当然！而且只要你继续在这间帐篷里装神弄鬼，就有更多这样的礼物等着你哦！"
    }
    {
      Id = "Dora_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}如此卑微的贡品根本不值得我浪费时间，女巫！{#Prev}逗你的啦，不过，说真的，谢谢你。从来没人送过我东西！除了你啦。我真的很开心，你知道吗？"
    }
    {
      Id = "Melinoe_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也很开心！你的陪伴对我来说意义非凡，所以这点心意真的不足挂齿啦。"
    }
    {
      Id = "Dora_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，蜜露的事稍微悠着点啦，好不好，小墨？自从我们试过仙酒之后，我的口味都变刁了好多，至少对于暗灵来说是这样啦。别再拿这些便宜货糊弄我了。"
    }
    {
      Id = "Melinoe_4670"
      InheritFrom = "BaseNarrative"
      DisplayName = "朵拉，众神的蜜露很难说是什么{#Emph}便宜货{#Prev}啦！大多数的凡人究其一生都尝不到{#Emph}一口{#Prev}呢！而你不喜欢吗？"
    }
    {
      Id = "Dora_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "喜欢是喜欢，不过就是口感对我来说偏甜了点？不过，我很感谢你把我像王族一样对待啦，或者说……{#Emph}像魔力无边的恶灵一样对待……！"
    }
    {
      Id = "Melinoe_4671"
      InheritFrom = "BaseNarrative"
      DisplayName = "我见过很多伟大而高贵的暗灵，朵拉，但我可以很自信地说，像{#Emph}你{#Prev}这样的暗灵世上绝无仅有。这瓶仙酒送给你；想去小酒馆一起喝一杯么？"
    }
    {
      Id = "Dora_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你的献祭我这次就收下了，女巫。{#Prev}不过我想先放着欸。除非你想在这里跟我喝？我只是这会儿哪都不想去啦。"
    }
    {
      Id = "Melinoe_4672"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！当然。请吧，光是酒香应该就很有氛围感了。祝你阴魂不散！"
    }
    {
      Id = "Dora_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢啦。这玩意确实很不错诶。说起来，怎么会{#Emph}同时{#Prev}存在蜜露和仙酒这两样东西？真奇怪。属于众神的两种不同的饮料，只是其中一种更煞有介事一点。"
    }
    {
      Id = "Melinoe_4673"
      InheritFrom = "BaseNarrative"
      DisplayName = "它们用于不同的场合。举例来说，把仙酒送给刚认识的人是绝对不可以的。仙酒主要是用于亲密的朋友或者恋人之间享用。"
    }
    {
      Id = "Dora_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，听起来说的就是{#Emph}我们{#Prev}耶！不过，感觉我有可能连这个也要喝腻了……"
    }
    {
      Id = "Melinoe_4674"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哦……"
    }
    {
      Id = "Melinoe_3814"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想跟我一起去泡一泡温泉吗，朵拉？暖融融的温泉可以放松身心哦。"
    }
    {
      Id = "Dora_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "不啦，我现在正忙着无所事事呢，不过改天说不定我会答应哦。"
    }
    {
      Id = "Melinoe_3815"
      InheritFrom = "BaseNarrative"
      DisplayName = "你愿意跟我去钓鱼栈桥小坐一会儿吗？那里环境很好，而且很安静！"
    }
    {
      Id = "Dora_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我这会儿真的懒得出门啦。而且我装神弄鬼的本领那么高超，那些鱼怕是一下就全跑了。"
    }
    {
      Id = "Melinoe_3816"
      InheritFrom = "BaseNarrative"
      DisplayName = "想和我去小酒馆共享一瓶仙酒吗？上次我们聊得很开心呢。"
    }
    {
      Id = "Dora_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实很开心，不过呆在人群里，对我来说压力好大……上一次之后，我好像还有点没缓过劲来。"
    }
    {
      Id = "Melinoe_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，要是你不忙的话，想跟我一起去河边待会儿么？我有双份的鱼饵，用在这种地方正合适。"
    }
    {
      Id = "Dora_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕有我在只会帮倒忙，毕竟我既没办法用钓鱼竿，又没办法保持安静，不过嘛！既然是你主动提出的，那我就恭敬不如从命咯。"
    }
    {
      Id = "Dora_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "恸哭之河。河里面漂着的全是些悲惨的家伙。你真的想要这样惊扰它们吗？"
    }
    {
      Id = "Melinoe_3690"
      InheritFrom = "BaseNarrative"
      DisplayName = "沉溺其中的亡魂是不会上钩的，除非它们自己受够了想要出来。对这样的亡魂来说，我觉得我们是在帮忙。"
    }
    {
      Id = "Dora_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们又不欠它们的，而且它们又没可能报答我们。更何况，如果它们现在只会呆在泥泞的河底自怨自艾的话，把它们钓出来恐怕也无济于事。"
    }
    {
      Id = "Melinoe_3691"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们不只是把它们钓出来而已，我们是给它们一个脱离当下环境的机会。从这个角度来说，我们和凡人钓鱼的方式有些不同啦。"
    }
    {
      Id = "Dora_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果它们发现外面的环境也没什么两样，那也不能怪我们咯……"
    }
    {
      Id = "Dora_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "好嘛，原来就是这么回事儿啊。谢谢啦！"
    }
    {
      Id = "Melinoe_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见。"
    }
    {
      Id = "Dora_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜拜。"
    }
    {
      Id = "Melinoe_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，朵拉，想不想跟我一起去泡个澡？好好的一座温泉没有闹鬼的话，那就太可惜了。"
    }
    {
      Id = "Dora_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "你问我想不想在快要烧开的水里乱飘？当然想啦！咱们还在等什么？"
    }
    {
      Id = "Dora_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道我以前做这种事会不会害羞……"
    }
    {
      Id = "Melinoe_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "你仍然能感觉到水的温暖，对吗，朵拉？"
    }
    {
      Id = "Dora_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……我能看见蒸汽腾腾的样子，能让我联想到温暖，所以……我也开始有些温暖的念头了，算是糊弄过去了吧。"
    }
    {
      Id = "Melinoe_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来还不错。不过，这样说来，你还记得温暖是什么感觉……还拥有凡间的温暖记忆吗？"
    }
    {
      Id = "Dora_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没有啦。我、我大概只是总听别人念叨这些，就好像我自己也经历过一样了。"
    }
    {
      Id = "Dora_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}呼！{#Prev}跟在你的帐篷里飘着没什么两样嘛，不过还是多谢你拉上我一起喔！"
    }
    {
      Id = "Melinoe_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我这里有些浴盐，一个人用不完，所以要是你不忙的话……？"
    }
    {
      Id = "Dora_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "小墨，你知道我最喜欢什么都不干。至于跟你一起泡温泉嘛……那算得上是我第二喜欢的事了，所以，走吧？"
    }
    {
      Id = "Dora_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "就像下锅了一样，是不是？"
    }
    {
      Id = "Melinoe_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不好奇你以前的生活吗，朵拉？在阳世的生活？我敢打赌，你一定是个大美人。"
    }
    {
      Id = "Dora_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈！{#Emph}什么鬼啦{#Prev}，你认真的吗？是我的声音太优美，还是我的曲线太曼妙？得了吧，别逗我了。"
    }
    {
      Id = "Melinoe_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "才不是逗你呢！真要说的话，一定是因为你的自信吧。你的一举一动都流露着自信！有的暗灵一见到我就瑟瑟发抖，但咱俩总是很合得来。"
    }
    {
      Id = "Dora_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗐，有的暗灵就是脑子有问题。话说回来，我过去怎么样并不重要啦。要是我过得开心的话，我就不会忘得一干二净了吧。"
    }
    {
      Id = "Melinoe_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "你觉得你是刻意忘掉了你的过去？"
    }
    {
      Id = "Dora_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "是吧。要不然我为什么全都记不起来了呢？大概是在遗忘之河里猛灌了几口，然后就把过往全抛掉了！抛到九霄云外去咯。"
    }
    {
      Id = "Melinoe_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "遗忘之河……这么说你是觉得，你以前住在至福乐土？"
    }
    {
      Id = "Dora_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "有一说一，刚才还蛮开心的。谢啦，小墨！"
    }
    {
      Id = "Melinoe_4675"
      InheritFrom = "BaseNarrative"
      DisplayName = "别管蜜露和仙酒的事了，我们再一起去泡一泡温泉怎么样？那里很安静。感觉更符合你的风格……说到这个，我也更喜欢安静呢。"
    }
    {
      Id = "Dora_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "我本来打算不管你说什么都说“不要”，捉弄一下你，但温泉听起来{#Emph}确实{#Prev}还可以欸。那我们走吧。"
    }
    {
      Id = "Melinoe_4676"
      InheritFrom = "BaseNarrative"
      DisplayName = "你不生众神的气么……？毕竟他们好像对你、对所有凡人，都做出了无法饶恕的事。就算那是很久之前，那又怎么样！我越想就越生气……"
    }
    {
      Id = "Dora_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个嘛，{#Emph}说实话{#Prev}，作为恶作剧来说其实还不错啦！但也很恶毒，嗯。我不知道你们众神之中哪个人要为此负责，但说实话我不在乎。我对生气这种事兴趣不大。"
    }
    {
      Id = "Melinoe_4677"
      InheritFrom = "BaseNarrative"
      DisplayName = "你人太好了……至少比我的家人要好。我觉得发生过的事恐怕已经覆水难收了，但是……虽然可能于事无补，但等到这一切结束之后，我会尽我所能，让我们这些神明之后能更好地对待凡人。"
    }
    {
      Id = "Dora_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "容我代表所有已经死掉，仍然活着，以及还没出生的凡人说一句，我觉得我们大多数人还是希望你们别干涉我们的事。这世间也许有很多邪恶，但是……我们能找到自己的手段来对抗它们。"
    }
    {
      Id = "Melinoe_4678"
      InheritFrom = "BaseNarrative"
      DisplayName = "……那，至少我们还可以做朋友，对么？"
    }
    {
      Id = "Dora_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，这得让我好好想想，一会儿再给你答复，好么？"
    }
    {
      Id = "Dora_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我想了好多东西，最后感觉跟你继续做朋友这个主意蛮好的，小墨。不过我要是改变主意了，我会告诉你的！"
    }
    {
      Id = "Melinoe_4680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "没问题，朵拉。"
    }
    {
      Id = "Melinoe_3726"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，既然小酒馆重建了，要不我来请你喝一杯众神的仙酒？我向你保证，绝对好喝！"
    }
    {
      Id = "Dora_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，碰巧这会儿我什么都没做，况且你还向我保证……好啊，我同意。"
    }
    {
      Id = "Dora_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "……说它值得一品，这我能理解啦。可是你没觉得这个“品”字有点莫名其妙吗，这到底用来{#Emph}喝{#Prev}的，还是用来{#Emph}吃{#Prev}的？"
    }
    {
      Id = "Melinoe_3727"
      InheritFrom = "BaseNarrative"
      DisplayName = "主要是用来和朋友们一起享用的。我承认这有点不同寻常，但话又说回来，这确实是为特殊场合准备的。"
    }
    {
      Id = "Dora_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "是吗？这算是什么特殊场合？我们只是……在这边闲扯淡而已。没在帐篷里，所以对我是有一点特殊，但是……你懂我意思啦。"
    }
    {
      Id = "Melinoe_3728"
      InheritFrom = "BaseNarrative"
      DisplayName = "算不算特殊，是由我们决定的，你不觉得吗？没错，我们夜复一夜总能见到彼此。但我们从来没有像这样，两个人坐在一起，分享这么奢侈的美酒呢。"
    }
    {
      Id = "Dora_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "我大概懂你意思了，不过……你不觉得这有点自相矛盾吗？仙酒是为特别场合而准备的，但这个场合特别的原因……恰恰是仙酒本身，为这里增添了不自然的节庆气氛。"
    }
    {
      Id = "Melinoe_3729"
      InheritFrom = "BaseNarrative"
      DisplayName = "甚至可以说是{#Emph}超自然{#Prev}的气氛。我怎么开始起鸡皮疙瘩了，就好像……就好像这里闹鬼了一样！哦，众神在上……"
    }
    {
      Id = "Dora_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你口中的众神将颤栗不止；而你们这些脆弱的心灵，甚至无法理解他们的恐惧！"
    }
    {
      Id = "Dora_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "……好啦，这仙酒确实还不错嘛。我得去缓一缓，不过……真的很开心啦。"
    }
    {
      Id = "Melinoe_3731"
      InheritFrom = "BaseSubtitle"
      DisplayName = "去吧，朵拉。"
    }
    {
      Id = "Melinoe_1154"
