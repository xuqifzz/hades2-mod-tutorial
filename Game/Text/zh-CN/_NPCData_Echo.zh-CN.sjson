    }
    {
      Id = "Narcissus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，呃，回声和我，我们俩在聊近况呢，大概吧。上次来这里有一阵子了，我都忘了我有多爱这片原野！这一切都好棒！"
    }
    {
