    }
    {
      Id = "MelinoeField_4646"
      InheritFrom = "BaseNarrative"
      DisplayName = "冥府重回了秩序！冥王和冥后不会再让这里像这样凋敝下去了……！假以时日，我相信这里的大家都会过得更好。"
    }
    {
      Id = "Echo_0133"
