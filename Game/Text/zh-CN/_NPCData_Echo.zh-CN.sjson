    }
    {
      Id = "Echo_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "好久不见！{#Echo1}好久不见！{#Prev}{#Echo2}好久不见！"
    }
    {
      Id = "MelinoeField_4624"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的……因为我的事情不仅需要我前往塔耳塔罗斯深渊，还需要我登上天界……去到被围攻的奥林匹斯山。宙斯大人和赫拉王后的家园。"
    }
    {
      Id = "Echo_0112"
