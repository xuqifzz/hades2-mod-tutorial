      InheritFrom = "BaseNarrative"
      DisplayName = "她在那……{#Echo1}她在那……{#Prev}{#Echo2}她在那……！"
    }
    {
      Id = "MelinoeField_1193"
      InheritFrom = "BaseNarrative"
      DisplayName = "涅墨西斯路过的时候，你一定是躲起来了吧。就是那个身材魁梧，一头黑发的倪克斯之女，总是风风火火的那个？不过你不用害怕她。"
    }
    {
      Id = "Echo_0076"
