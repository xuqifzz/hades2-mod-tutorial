      InheritFrom = "BaseNarrative"
      DisplayName = "你看起来很不错吗……！{#Echo1}很不错嘛……！{#Prev}{#Echo2}很不错嘛……！"
    }
    {
      Id = "Echo_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿明月指引你……{#Echo1}指引你……{#Prev}{#Echo2}指引你……"
    }
    {
      Id = "Echo_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是路过……{#Echo1}只是路过……{#Prev}{#Echo2}只是路过……"
    }
    {
      Id = "MelinoeField_0758"
      InheritFrom = "BaseNarrative"
      DisplayName = "就算在如此伤感的地方，也有美丽……与温柔。我还不知道该如何帮你减轻负担，但也许这个能帮上忙。"
    }
    {
      Id = "Echo_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这个能帮上忙……{#Echo1}这个能帮上忙……{#Prev}{#Echo2}这个能帮上忙……"
    }
    {
      Id = "MelinoeField_1196"
      InheritFrom = "BaseNarrative"
      DisplayName = "能见到你友善的面容真是太好了！愿这份蜜露能让你在这里的时光更美好一些。看看这原野，多么广袤呀！除了悲伤之外，一定还能容下许多不一样的情绪。"
    }
    {
      Id = "Echo_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "不一样的情绪……{#Echo1}一样的情绪……{#Prev}{#Echo2}一样的情绪……"
    }
    {
      Id = "MelinoeField_1197"
      InheritFrom = "BaseNarrative"
      DisplayName = "回声，我又有一份蜜露要送给你，请收下吧！在我的故乡，这样的礼物寄托了我们彼此的关切之情。不知道你喜不喜欢，但单单是想到可以把它送给你，我就感觉开心了一点呢。"
    }
    {
      Id = "Echo_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "感觉开心了一点呢……{#Echo1}开心了一点呢……{#Prev}{#Echo2}开心了一点呢……"
    }
    {
      Id = "MelinoeField_4625"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐怕就连蜜露也不足以缓解这里阴郁的氛围。不过至少，你的周围都是巨石。如果你真的来自山岳之间，也许在这里会有家的感觉。"
    }
    {
      Id = "Echo_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "会有家的感觉……{#Echo1}有家的感觉……{#Prev}{#Echo2}有家的感觉……"
    }
    {
      Id = "MelinoeField_4626"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果哪天晚上你需要什么，或者需要我做什么，请一定要想办法告诉我。至少这里看起来很安全。至于现在，只希望这瓶蜜露足以为你提供些慰藉。"
    }
    {
      Id = "Echo_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "这瓶蜜露，足矣……{#Echo1}足矣……{#Prev}{#Echo2}足矣……"
    }
    {
      Id = "MelinoeField_4627"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你让我知道，仅凭几个字，或者一个字都不说，就能够传递那么多的信息。在你回应我的时候，虽然用的是我说的话，但我却能懂得你的意思。而且我也知道，你能理解我。"
    }
    {
      Id = "Echo_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能理解我……{#Echo1}你能理解我……{#Prev}{#Echo2}你能理解我……"
    }
    {
      Id = "MelinoeField_4628"
      InheritFrom = "BaseNarrative"
      DisplayName = "随着我们愈发了解彼此，回声，我希望你能收下这份特别的礼物，如果你愿意的话。这是仙馔密酒，来自奥林匹斯山最高耸的山峰。"
    }
    {
      Id = "Echo_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山，最高耸的山峰……{#Echo1}奥林匹斯山，最高耸的山峰……{#Prev}{#Echo2}奥林匹斯山……{#Prev}我……{#Emph}呜呃……"
    }
    {
      Id = "MelinoeField_4629"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}回声！{#Prev}你刚刚是不是……你{#Emph}说话{#Prev}了！你说了“我”，用的是你自己的言语！我听到你说了，千真万确！"
    }
    {
      Id = "Echo_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我听到你说了……我……千真万确，我听到你说了，我……我很感激。这瓶仙馔密酒……我觉得，应该是它的影响，可是我……{#Echo1}可是我……{#Prev}{#Echo2}可是我……{#Prev}恐怕维持不了多久……{#Echo1}多久……"
    }
    {
      Id = "MelinoeField_4630"
      InheritFrom = "BaseNarrative"
      DisplayName = "那我再给你带一些过来！回声，这太棒了！我知道仙酒很美妙，但不知道它有这么妙！"
    }
    {
      Id = "Echo_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "不……不这么妙……{#Echo1}这……不妙……{#Prev}{#Echo1Italic}呃……{#Prev}好难解释，可是，我不需要……{#Echo1}我不需要……{#Prev}{#Echo2}我不需要……"
    }
    {
      Id = "MelinoeField_4631"
      InheritFrom = "BaseNarrative"
      DisplayName = "回声，怎么了……？你是说仙酒。你不需要更多仙酒了……？一定是喝得太多了……"
    }
    {
      Id = "Echo_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "喝得太多了……{#Echo1}喝得太多了……{#Prev}{#Echo2}喝得太多了……"
    }
    {
      Id = "MelinoeField_4632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……好的。我会回来的。"
    }
    {
      Id = "MelinoeField_4634"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啦，回声，我们得把这件事搞清楚。上次一定是仙酒让你重新获得了自己的声音，所以说不定它这次也会管用。有什么效果了吗……？"
    }
    {
      Id = "Echo_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "有什么效果了吗……？{#Echo1}有什么效果……{#Prev}{#Echo2}有效果……{#Prev}了吗……我……{#Echo1}我{#Prev}，墨利诺厄，你看。{#Echo1}你看{#Prev}，我留在这里，不是因为我需要帮助……{#Echo1}需要帮助……{#Prev}{#Echo2}需要帮助……"
    }
    {
      Id = "MelinoeField_4635"
      InheritFrom = "BaseNarrative"
      DisplayName = "回声，是你自己的声音！那么，你需要什么？我不明白。有谁愿意在这样的地方自怨自艾呢？"
    }
    {
      Id = "Echo_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "像这样的地方……我能帮上忙……{#Echo1}我能帮上忙……{#Prev}{#Echo2}我能帮上忙……{#Prev}帮上其他人。他们。没有别的人可以说话。可以倾诉。因为我发现……我可以反映他们的感受，以及他们的思绪……{#Echo1}以及他们的思绪……{#Prev}{#Echo2}以及他们的思绪……"
    }
    {
      Id = "MelinoeField_4636"
      InheritFrom = "BaseNarrative"
      DisplayName = "就像你反映我的那样。可是，我们得找到办法，让你重获自己的声音才行。我们就快要取得突破了！"
    }
    {
