      DisplayName = "宙斯大人和赫拉王后……{#Echo1}赫拉王后……{#Prev}{#Echo2}赫拉王后……"
    }
    {
      Id = "Echo_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "晚上好！{#Echo1}晚上好！{#Prev}{#Echo2}晚上好！"
    }
    {
      Id = "MelinoeField_1178"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，从来没在摆渡人卡戎附近见到过你哎。不用害怕他，他是我的朋友。不过，跟他不太容易聊得起来。"
    }
    {
      Id = "Echo_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "容易聊得起来……{#Echo1}聊得起来……{#Prev}{#Echo2}聊得起来……"
    }
    {
