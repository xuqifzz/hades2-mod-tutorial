{
  /*
  This file was autogenerated on 9/30/2025 at 4:13 AM
  by the BuildText tool.
  */
  lang = "zh-CN"
  Texts = [
    {
      Id = "CodexData_Melinoe_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你。我知道关于你的一切；尤其是你的脆弱。 \n  \n         {#CodexItalicFormat}…… \n  \n         {#CodexItalicFormat}你为何而战？你要证明什么？倘若在命运的编排下你侥幸得胜，又待如何？在外面闯荡的时候，自己好好想想吧。"
    }
    {
      Id = "CodexData_Melinoe_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你。我知道关于你的一切；尤其是你的脆弱。 \n  \n         {#CodexItalicFormat}我是怎么知道的？因为你总是会想：“倘若我没有生下来，也许这一切都不会发生吧？”但你的责任是活下去，并且摆脱过往的拖累。 \n  \n         {#CodexItalicFormat}你为何而战？你要证明什么？倘若在命运的编排下你侥幸得胜，又待如何？在外面闯荡的时候，自己好好想想吧。"
    }
    {
      Id = "CodexData_Hades_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是你的父亲；但你了解他的方式仅限于他在你出生之前积累的威望，因为你出生后不多久，他便被泰坦从我们身边夺走了。但他的威名仍令人不寒而栗。 \n  \n         {#CodexItalicFormat}…… \n  \n         {#CodexItalicFormat}他毕竟是不死不灭的神明；就连时间也无法将他磨灭。但你最好不要给予时间无限的机会，以免出现什么意外。"
    }
    {
      Id = "CodexData_Hades_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是你的父亲；但你了解他的方式仅限于他在你出生之前积累的威望，因为你出生后不多久，他便被泰坦从我们身边夺走了。但他的威名仍令人不寒而栗。 \n  \n         {#CodexItalicFormat}你令他得以归返。你与他的联系，可能比你想象得更加强大。毕竟，他是个不死不灭的神明；就连时间都无法将它磨灭。现在，如果说有什么能拉近你们的距离，那也非时间莫属了。"
    }
    {
      Id = "CodexData_Persephone_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界的王后，常青女神，四季女神的女儿，以及你的生身母亲。\n  \n         {#CodexItalicFormat}你要尊敬她，也要知道，碍于时间与形势，她见证自己两个孩子成长的机会都遭到了剥夺。至于她是如何在冥界定居的，就是另一个又长又复杂的故事，不如改日再讲。"
    }
    {
      Id = "CodexData_Zagreus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "你在画像里见过他，在传闻里听过他。这足以让你感受到与他之间的联系。这份联系看似薄弱，但却至关重要，而在你的不懈努力下，它变得愈发强大。 \n  \n         {#CodexItalicFormat}起初，你以为他与你一点都不相像；在许多方面，你的判断并没有错。但是，你仍能感受到与他之间的那份亲情的牵绊……比其他的牵绊更加强力，或者至少，与其他的牵绊不甚相同。"
    }
    {
      Id = "CodexData_Nyx_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}黑夜母亲。从地表最高耸的山峰，到地底最黑暗的深渊，都能感受到她的影响力。 \n  \n         {#CodexItalicFormat}没有她和她的众多子女，这世间的生活根本无从想象。匿踪者宣誓为冥界效力，便是依托她意志的延伸。"
    }
    {
      Id = "CodexData_Hecate_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你渴望成为她。可以理解。 \n  \n         {#CodexItalicFormat}但她到底要向你明确多少次，她不是你的母亲？除了你已经牢记于心的那些事情，其他一切几乎都是她教授给你的。 \n  \n         {#CodexItalicFormat}……"
    }
    {
      Id = "CodexData_Hecate_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你渴望成为她。可以理解。 \n  \n         {#CodexItalicFormat}但她到底要向你明确多少次，她不是你的母亲？除了你已经牢记于心的那些事情，其他一切几乎都是她教授给你的。 \n  \n         {#CodexItalicFormat}你需要牢记一点：她对你的教导和训练，全部都只服务于一个目的。倘若那个目的终有一夜得以实现，那时你才有机会去学习一切她无法教给你的事物。"
    }
    {
      Id = "CodexData_Selene_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}人们都夸赞她的美貌，但少有人知晓她的魔力，因为她远在天边，而且从不张扬。她是黑夜之眼，也是你的榜样。 \n  \n         {#CodexItalicFormat}她是一名泰坦神，由倪克斯收养；她是匿踪者在地表的眼线，与身处地下的我们遥相呼应。"
    }
    {
      Id = "CodexData_Odysseus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}人们口中“神通广大的奥德修斯”绝不是个简单的人物。在凡间，他结交了许多朋友，也惹来了许多敌人。你不似他们那般了解他，但以你的了解，他不会辜负你的信任。\n  \n         {#CodexItalicFormat}他熟知凡人的心性，也熟知地表的世界。他知道得很多，而且足智多谋。不过，他偏爱女巫这一点，恐怕已经病入膏肓，无可救药了。"
    }
    {
      Id = "CodexData_Nemesis_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}黑夜的女儿之一，报应的化身。那些投机取巧、德不配位之人，尽会遭到她的惩戒。她的存在令凡人安于贫困，知足常乐。 \n  \n         {#CodexItalicFormat}她比你更高大，也更壮实。你总是好奇：被选中完成这一重任的，为什么不是她？"
    }
    {
      Id = "CodexData_Eris_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}黑夜诞下了无数原始的力量；倘若没有这些黑夜的儿女，世界究竟会如何运转，恐怕会很难想象。 \n  \n         {#CodexItalicFormat}纷争化身就是这样一股力量，无论我们如何看待她，都对她无可奈何。任何秩序她都不放在眼里，无论是自然的法则还是社会的规定。你被她深深吸引，犹如飞蛾渴望投身火焰。"
    }
    {
      Id = "CodexData_Charon_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是黑夜较为年长的儿子之一，长久以来一直为地下世界兢兢业业效力，且不拘于形式。曾经，他的职责是撑船将死者带去最终的归宿，但现在肩负着另一些责任。 \n  \n         {#CodexItalicFormat}就连他的家人都很难与他交流，总觉得他性情怪异，故弄玄虚，或是冷漠无情。然而你认识的他却并非如此，这令你很欣慰。"
    }
    {
      Id = "CodexData_Skelly_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他身上有着永不屈服的品质，至少这点可以确定。你敬佩他的智慧和坚毅。你只到他的大腿骨那么高时，就在与他对练了。 \n  \n         {#CodexItalicFormat}他的举手投足仍如凡人一般，这让他轻而易举地赢得了三岔路口许多暗灵的信任。至少，这是你对他的印象。"
    }
    {
      Id = "CodexData_Medea_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这名女巫的名号令人闻风丧胆，但你们应当无缘相见。凡是冒犯过她的人，都会被她记在名单上；然后他们便会遭到灾祸，而名单上的名字也随之被她划去。 \n  \n         {#CodexItalicFormat}她是我们的盟友。不要在意凡人对她的看法、对我们女巫的成见。"
    }
    {
      Id = "CodexData_Circe_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}变化无可避免；对凡人如此，对神明亦然。但有些人抗拒改变，在变革来临时仍做着困兽之斗。有些人则欣然接受改变。还有些人试图掌控改变，精益求精。 \n  \n         {#CodexItalicFormat}我们的能力与我们变化的余地，二者之间有着千丝万缕的联系。她深知这点，而且因此远离尘世。但她待你相当友善。"
    }
    {
      Id = "CodexData_Zeus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是你父亲的弟弟；他推翻了自己的父亲，克洛诺斯，然后接管了奥林匹斯山。 \n  \n         {#CodexItalicFormat}他的力量强大，世间少有制约；但我们便是他的制约之一。"
    }
    {
      Id = "CodexData_Poseidon_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你那吵吵嚷嚷的二叔，有时被人称为“撼地者”，不过他最响亮的名号还是“海神”；地表世界有大半都被他的海洋所覆盖。 \n  \n         {#CodexItalicFormat}他在动荡的时局中如鱼得水，而且性情有如大海一般，很少能保持镇静。"
    }
    {
      Id = "CodexData_Hera_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}奥林匹斯受人敬仰的王后。她与我们的共同点可能比你预想得多。 \n  \n         {#CodexItalicFormat}她确保奥林匹斯山上存有像样的秩序，但她也有鞭长莫及之处。你常常会思考有没有能帮得到她的地方。"
    }
    {
      Id = "CodexData_Apollo_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这位神明披着年轻俊美的面容。你暂且断定他对你的友善是真诚的。 \n  \n         {#CodexItalicFormat}他并不习惯冲突，因此虽然他近来表现出一副得心应手的样子，实际上却常常力不从心。"
    }
    {
      Id = "CodexData_Demeter_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}她是伟大的四季女神，也是你的外婆。你的母亲曾经从她的身侧逃离；她无微不至的溺爱由此可见一斑。 \n  \n         {#CodexItalicFormat}她历尽漫长岁月，阅遍万千春秋，因而她的愤怒显得格外冷酷，哪怕是奥林匹斯山上的其他神明也会不寒而栗。还好她喜欢你。"
    }
    {
      Id = "CodexData_Hestia_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}炉灶女神有大智慧，因为绝大多数的家事她都避而远之。但像这样的大危机，就算她也无法置身事外。 \n  \n         {#CodexItalicFormat}她喜欢你，你也喜欢她。她我行我素，从不拘于繁文缛节。这点值得你学习。"
    }
    {
      Id = "CodexData_Aphrodite_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}假以时日，你会从她身上学到很多东西的。 \n  \n         {#CodexItalicFormat}她远不止看上去那么简单。举个例子吧：她比奥林匹斯山上的大多数神明岁数都大得多，但却始终保有那份无忧无虑的神情，外表如此，内心亦然。"
    }
    {
      Id = "CodexData_Artemis_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}迫于当下的时局，以及刻苦的训练，你牺牲了很多；其中一项便是挚友相伴的温暖。这样说来，你与阿尔忒弥斯相识，真是一件幸事。 \n  \n         {#CodexItalicFormat}在奥林匹斯众神眼中，她是个任性的女儿；在我们眼中，她和我们是一家人。银月姊妹注视万物，静待时机。"
    }
    {
      Id = "CodexData_Hephaestus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}奥林匹斯的心脏是一座巨大的熔炉，亦是他的骄傲。他排斥我们的巫术，只愿意信任自己的双手能握得住的东西。 \n  \n         {#CodexItalicFormat}但他也是个隐居避世之人。这点或许是你们的共同之处。"
    }
    {
      Id = "CodexData_Hermes_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在奥林匹斯众神之中，他是你相当了解的一位神明。他的职责常常让他涉足冥界的边界，有的时候甚至会深入冥界之中。 \n  \n         {#CodexItalicFormat}他的捷足享誉四海，但其他种种则少有人知；人们还以为，他只是个信使而已！就连他在奥林匹斯山上的家人，都低估了他的实力。长久以来，你一直因此而受益，整个冥界亦是如此。"
    }
    {
      Id = "CodexData_Athena_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}近来，司掌智慧与谋略的女神忙得不可开交。哪怕是她，也未曾料想到泰坦对众神之山的攻势会如此猖獗。 \n  \n         {#CodexItalicFormat}然而，最能激发神明愤怒的，正是耻辱。倘若你能透过她那沉着冷静、平易近人的外表，看到她的内心的话，一定会发现那里正燃着满腔怒火。"
    }
    {
      Id = "CodexData_Dionysus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}通常来说，酒神或许是奥林匹斯众神中最为和蔼可亲的一位；多亏了他的影响力，众神之间的关系才没有那么紧张。 \n  \n         {#CodexItalicFormat}然而，有些冲突，就连他也无法化解。他是绝不会诉诸暴力的；因此，面对当下的形势，他又有什么选择呢？"
    }
    {
      Id = "CodexData_Ares_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些奥林匹斯神掌管着世界的自然秩序，以及驱动世界运行的基础元素。另一些则与我们心中最为原始的冲动紧密相连。 \n  \n         {#CodexItalicFormat}战神大概就属于后者，但你真的能确定吗？也许高等意识渴望毁灭，就如同花朵渴望雨水。"
    }
    {
      Id = "CodexData_Cerberus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界如今门户大开，那恐怖的看门犬便也失去了用武之地，更何况他忠于冥界之王，而非那个篡位之徒。 \n  \n         {#CodexItalicFormat}他如同寻常的野兽一般被逐出了冥府，如今在哀悼原野肆虐，满腔怒火难以平息。你们上一次相见时，你还不过是个襁褓中的婴儿；他又如何能记得你呢？"
    }
    {
      Id = "CodexData_Cerberus_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界既已门户大开，那恐怖的看门犬便也失去了用武之地，至少直到冥界完全恢复秩序为止，而那是多久以后的事，没人说得清楚。 \n  \n         {#CodexItalicFormat}在他如同寻常的野兽一般被逐出冥府之后，便在哀悼原野肆虐，满腔怒火难以平息。而现在，他则来去自如，全凭心意；更重要的是，他终于认出了你。"
    }
    {
      Id = "CodexData_Typhon_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}“怪物”也许可以被定义为攻击我们感官的生物，而且往往是同时攻击好几种感官。诚然，它们并非一直存在，但已经存续了很长很长的时间。 \n  \n         {#CodexItalicFormat}它们那心怀怨怼的祖先从大地中升起，有如一场沸腾的瘟疫。在众魔之父的身上，你能看到你渴望的一切美好的反面。"
    }
    {
      Id = "CodexData_Fates_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这三位对我们的生活带来了最为深远的影响；或许从最重大的转折，到最细微的变动，都逃不出她们织就的罗网。不知道她们徒增了多少是非。\n  \n         {#CodexItalicFormat}我们付出的努力，往往不能如愿。这其中，有多少是因为我们，多少又是因为她们？正如她们必须为我们所有人分出命运的丝线，我们也必须分清楚，有哪些事在我们掌控之内，又有哪些在我们掌控之外。"
    }
    {
      Id = "CodexData_Chaos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}上古之时，从无边的混沌中滋生出了黑夜与黑暗，以及这个世界中最深不可测的境域。此后万物接踵而至：欲望、海洋，如此种种。 \n  \n         {#CodexItalicFormat}那万物的起源仍存于世，自始至终注视着一切。倘若追本溯源，世间的所有活物都是一家人，拥有同一个怪诞的祖先。"
    }
    {
      Id = "CodexData_Chronos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这一切麻烦事的根源。克洛诺斯必死无疑！\n  \n         {#CodexItalicFormat}你对他的憎恨基本都来自于其他人转述的故事。但不用担心，在这一切结束之前，你们有的是机会深入了解彼此。"
    }
    {
      Id = "CodexData_Chronos_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}时间能够治愈一切？彻头彻尾的谎言。有些伤口永远不会愈合；有些虽然可以，但仍会留下疤痕。甚至有些痛苦会根植于扭曲的记忆之中，永远无法散去。 \n  \n         {#CodexItalicFormat}我们通常不会有机会回到过去，重新做出选择。时间不允许这样的事情发生。但时间自己，又有什么理由不能成为例外呢？"
    }
    {
      Id = "CodexData_Heracles_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}当心这个名叫赫拉克勒斯——“赫拉的荣耀”之人。他是个人面兽心的怪物；有他在的地方，所有人都身处危险之中，包括他自己。 \n  \n         {#CodexItalicFormat}他的种种英雄事迹在时间中逐渐褪色；过往的真相就连他也无从忆起。他对女巫和巫术全无敬意。"
    }
    {
      Id = "CodexData_Moros_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是倪克斯之子，亦是毁灭的使者。你对巫术之外的事物知之甚少，还不足以让你明白他为何如此遭人厌恶。 \n  \n         {#CodexItalicFormat}命运三女神依靠他来确保她们的意志得到施行，而他则依靠三女神来获取自己存在的意义。没了她们，他将何去何从？"
    }
    {
      Id = "CodexData_Arachne_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}一位天赋卓绝、性格独立的织匠，被神明降下了诅咒。你不害怕她，正因如此，她从一开始就很喜欢你。 \n  \n         {#CodexItalicFormat}她在厄瑞玻斯安了家，在那里，生灵不会再对她造成威胁；她可以日益精进，至臻完美。"
    }
    {
      Id = "CodexData_Icarus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}飞行不知为何被人当作是自由的象征：无拘无束，来去自如！当然，这都是一派胡言。飞行有时会令人精疲力尽；有时甚至还会付出更大的代价。 \n  \n         {#CodexItalicFormat}和许多其他人一样，他活在他父亲的阴影之中。这样的命运对他来说，恐怕是“插翅难逃”了。"
    }
    {
      Id = "CodexData_Narcissus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他如此迷恋着自己的美貌，以至于神明的惩罚降在了他身上，他却仍不自知。时至今日，他仍整日凝望着自己水中的倒影出神。 \n  \n         {#CodexItalicFormat}有的人会说，爱自己是种美德；有的人会说，爱自己是种罪孽。你对这一问题有自己的立场么？"
    }
    {
      Id = "CodexData_Echo_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些宁芙说得太多，以至于祸从口出。这名宁芙惹怒了某位位高权重的女神，此后便再也无法吐露自己的心声，只能一味重复他人的话语。 \n  \n         {#CodexItalicFormat}虽说心碎而死这种桥段多少有些老套，但是她确实落得了这样的下场。不过，她的魂灵仍弥留于世；她的声音朦胧飘渺，有如周遭环境的余响。"
    }
    {
      Id = "CodexData_Hypnos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}他是倪克斯之子，是睡梦的化身。以前，你总会望着他出神，好奇他做着什么样的酣梦。 \n  \n         {#CodexItalicFormat}他曾为你父亲的冥府效力；在你出生不久、冥府遇袭时，他侥幸逃过了一劫。"
    }
    {
      Id = "CodexData_Dora_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}她漫无目的地漂泊到了你的营帐之中；你试图超度她，但却以失败告终。从此，你们便成为了长久的伙伴。 \n  \n         {#CodexItalicFormat}值得注意的是，她的沟通能力远超其他像她一样的次等暗灵，而个中缘由对你仍是个谜。\n  \n         {#CodexItalicFormat}……"
    }
    {
      Id = "CodexData_Dora_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}她漫无目的地漂泊到了你的营帐之中；你试图超度她，但却以失败告终。从此，你们便成为了长久的伙伴。 \n  \n         {#CodexItalicFormat}值得注意的是，她的沟通能力远超其他像她一样的次等暗灵，因为她早已历尽沧桑。 \n  \n         {#CodexItalicFormat}为凡人降下诅咒，令他们遭受无数苦难的，究竟是她，还是众神，抑或是命运三女神？然而，事已至此，又何必计较。"
    }
    {
      Id = "CodexData_Frinos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你很久之前便与这只两栖动物建立了情感纽带。它总能保护你的小小营帐免受害虫侵扰，而且乐此不疲。 \n  \n         {#CodexItalicFormat}你自身的秘密，告诉了它多少？或许比告诉其他生灵的，都多得多吧。"
    }
    {
      Id = "CodexData_Toula_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你对它的身世有些猜想；毕竟，猫很少会在埃费拉城的海岸出没。 \n  \n         {#CodexItalicFormat}它是个忠诚的伙伴，如果猫科动物真的有“忠诚”这一概念的话。"
    }
    {
      Id = "CodexData_Raki_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这只乌鸦对你有莫名的好感，兴许是把你当作月神了吧。又或许，它认为你和它一样，都与尘世格格不入。 \n  \n         {#CodexItalicFormat}它的喙坚硬无比，可以凿开磐石。"
    }
    {
      Id = "CodexData_Hecuba_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这只猎犬你已经认识很久了；她格外乖巧，因为她对当下所拥有的一切无比感激。 \n  \n         {#CodexItalicFormat}初见之时，你便看到了她双目中闪烁的智慧光芒。而现如今，她伴你左右，仿佛你是她的主人。"
    }
    {
      Id = "CodexData_Gale_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}永远好奇的虎鼬向来喜欢以身犯禁，而且总能全身而退。 \n  \n         {#CodexItalicFormat}在这方面，这只虎鼬的天赋尤为突出，就仿佛她的这一形态是由后天选择，而非先天注定。想必如果有机会的话，许多女巫都会做出同样的选择。 "
    }
    {
      Id = "CodexData_WeaponStaff_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在暗夜武器中，戴斯奇拉是在你接近时最先醒转的。她属于你。\n  \n         {#CodexItalicFormat}挥舞这一柄从不应该被使用的武器是什么感觉？她在混沌之中铸造而成，原本是作为最后的预防措施，在迫不得已之时将她同为武器的兄弟们折服。"
    }
    {
      Id = "CodexData_WeaponDagger_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}姊妹双刃利姆欧罗是为你，或者说为我们银月姊妹所打造的。双刃翻飞的乐章，是你许多敌人听到的最后的声音。 \n  \n         {#CodexItalicFormat}播种自有收割时；昨夜之因，便是今夜之果。挥舞双刃时谨记。"
    }
    {
      Id = "CodexData_WeaponAxe_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}不。不要擅自动用月石之斧佐利菲特。她适合涅墨西斯这样的人；像你这样身材并不过人的女神是驾驭不来的。 \n  \n         {#CodexItalicFormat}……这样的想法多么令人恼火，不是么？事实上，佐利菲特并不在意是谁在使用她，只要能让她啜饮到鲜血就行。"
    }
    {
      Id = "CodexData_WeaponTorch_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你已经准备好驾驭暗影之炬伊格尼姆了。不过，你可能会问，为什么要选用一对象征着光芒的武器呢？ \n  \n         {#CodexItalicFormat}有光才有影；光彩盛放之夜，就是暗影起舞之夜。这就是选用它们的理由。如此看来，这样的光源自然是多多益善，同时挥舞两个也就顺理成章了。"
    }
    {
      Id = "CodexData_WeaponLob_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}银白之颅原本属于裁决者勒瓦尔，而勒瓦尔如今属于你。 \n  \n         {#CodexItalicFormat}这是勒瓦尔咎由自取，而且恕我直言，你对待她比起她原先对待其他人要负责得多——算她走运。"
    }
    {
      Id = "CodexData_WeaponSuit_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}暗夜武器诞生于暗影之中，但孕育它们的暗影未曾消散，而是凝聚成了这一最终形态。 \n  \n         {#CodexItalicFormat}所谓武器，便是我们的躯体与意志的延伸。柯辛斯则是这一点的具象体现。"
    }
    {
      Id = "CodexData_Guard_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}微风拂过树枝发出的寂寥之音，你再熟悉不过了。 \n  \n         {#CodexItalicFormat}这些暗灵早已逝去，唯有飘渺的情感仍然弥留于世。"
    }
    {
      Id = "CodexData_Guard2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有一些灵魂消失在海浪之中，然后选择永远留在了海底。这里的黑暗和压力对他们来说有种独特的吸引力。 \n  \n         {#CodexItalicFormat}久居此地之后，他们便对阳光和阳世的生物避之不及。"
    }
    {
      Id = "CodexData_Radiator_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}凡物终有一死；这点你自然清楚。但有些死亡来得太早，太令人猝不及防。\n  \n         {#CodexItalicFormat}或许在还不清楚生死为何物时便迎来死亡，本身也是一种恩赐吧。"
    }
    {
      Id = "CodexData_Radiator2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}溺亡是一种常见的死因。水真是一种神奇的物质，既能孕育生命，又能带来死亡。 \n  \n         {#CodexItalicFormat}有些灵魂在水中挣扎至死，死后也仍然没有停下那无谓的回旋。"
    }
    {
      Id = "CodexData_Brawler_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}厄瑞玻斯是个有去无回之处。你见过许多暗灵在古树的空心中辗转，苦苦寻觅那并不存在的离开之路。 \n  \n         {#CodexItalicFormat}至少，要想离开此境的边界，得付出相应的代价才行。"
    }
    {
      Id = "CodexData_Screamer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}苦楚会渐渐淡去。但总有人执着于过去，放不了手。 \n  \n         {#CodexItalicFormat}至少，你可以为他们带去某种意义上的安宁。"
    }
    {
      Id = "CodexData_Screamer2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}每个生灵都有可能陷入手足无措的地步。有些生灵会被情绪压垮，因为有些情绪本身便有千钧之重。\n  \n         {#CodexItalicFormat}有的时候，崩溃后的哭泣一旦开始，便再也没有休止。这样的情绪不仅会把生灵压垮，还会把生命吞噬殆尽。"
    }
    {
      Id = "CodexData_Mage_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些暗灵被困在厄瑞玻斯之中如此之久，以至于原本无形的枷锁在他们身上化成了实体。 \n  \n         {#CodexItalicFormat}他们的憎恨漫无边际，也漫无目的。"
    }
    {
      Id = "CodexData_Mage2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}死于大海之人为了表示对大海的蔑视，竟然化作亡魂弥留于大海上，实在是蠢得无可救药；然而世上从不缺少蠢人。 \n  \n         {#CodexItalicFormat}这种亡魂有的会栖身在航船的甲板上，仿佛拉几个人下水就大仇得报了似的。"
    }
    {
      Id = "CodexData_SiegeVine_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}长须渴望深入沃土，亡魂渴望重获新生。这两者组合在一起，便成了这种讨厌的怪物。 \n  \n         {#CodexItalicFormat}那些尖刺扎在脚上痛得要命。"
    }
    {
      Id = "CodexData_FogEmitter_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}黑暗是万物的自然形态。然而这世上有一种非自然的黑暗，诞生于欺瞒与凄苦。 \n  \n         {#CodexItalicFormat}最好对这种黑暗敬而远之。"
    }
    {
      Id = "CodexData_FogEmitter2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}没有人能摆脱自己的影子。但这句话用来形容某些生物格外贴切。\n  \n         {#CodexItalicFormat}见识短浅的他们拼命想要逃离自己心中的黑暗和恐惧；殊不知越是逃窜，那黑暗便越是深邃。"
    }
    {
      Id = "CodexData_Treant_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}树根是生命之源，能生长出顽强坚毅的参天大树。但你要知道，就连树根也有被腐化的可能。 \n  \n         {#CodexItalicFormat}从这样的树根中长出的生命断然无药可救。"
    }
    {
      Id = "CodexData_Treant2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}凡人口中所谓的文明，不过是将大自然拒之门外的一种手段。他们或是不知道，或是不愿接受世间万物都与大地母亲盖亚息息相关这一事实。 \n  \n         {#CodexItalicFormat}大自然的一草一木可能会被砍伐、会被焚烧，会被以其他方式毁灭，但它们总会再生——有时是携着仇恨卷土重来。"
    }
    {
      Id = "CodexData_Wisp_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些由恸哭之河中漂浮的琐物与悲伤的回忆聚拢而成的蜡状结构，乃是凡间灵魂最为微弱的一抹将逝之光。\n  \n         {#CodexItalicFormat}倘若受到惊扰，它们便会激起单一的原始冲动，试图摆脱自己最后一丝实体，在痛苦中化作一道炫光。"
    }
    {
      Id = "CodexData_ZombieAssassinMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}最为败坏的亡灵曾经都被关押在塔耳塔罗斯，但其中有些侥幸脱逃，甚至学会了对他们如今半虚半实的躯体加以利用。而这之中最最败坏之人，则总是供不应求。 \n  \n         {#CodexItalicFormat}他们可以在地表或冥界避人耳目地行进，无论在光线下还是在阴影中，对他们锁定的目标展开旷日持久的追猎……或是为了金钱，或是为了宿仇。"
    }
    {
      Id = "CodexData_Wringer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些偷窃癖作祟的扒手实在无可救药，声称行窃并非其本意，乃是双手兀自为之。此等亡者，死后皆堕入了塔耳塔罗斯。\n  \n         {#CodexItalicFormat}他们的手总会无礼地伸向一切看似有些许价值之物——不仅仅是金银珠宝，务必当心。"
    }
    {
      Id = "CodexData_Boar_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在它活着的时候，这头庞大的野兽便早已声名狼藉，在它成为一场不可能的狩猎的目标之前便是如此。除了赫拉克勒斯本人之外，还有谁能活捉这样的怪物？\n  \n         {#CodexItalicFormat}然而，身为凡物，它无法存活太久。而比它的生命延续更久的是它的愤怒；受人禁锢的经历激发出了这头野兽真正狰狞的面目。"
    }
    {
      Id = "CodexData_FishSwarmer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}很难说在这黑暗的深渊里到底孳生了多少海洋异兽。 \n  \n         {#CodexItalicFormat}你也很难解释为什么有些异兽如此愚蠢，会冲出水面，扑到令它们窒息的空气中。"
    }
    {
      Id = "CodexData_FishmanMelee_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在现存于世的事物中，最能体现混沌滋生万物这一概念的，大概就要数大海了。\n  \n         {#CodexItalicFormat}追本溯源，世间万物无论好坏，都是混沌的造物；而坏的那些，自然还是远离为妙。"
    }
    {
      Id = "CodexData_FishmanRanged_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}地表的骏马是那样威风凛凛……但它们在海底对应的生物就是另一码事了。 \n  \n         {#CodexItalicFormat}波塞冬对马匹的痴迷一定与之脱不了干系。"
    }
    {
      Id = "CodexData_Turtle_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这种海底的怪物举着钳子，吐着泡泡，全身硬壳，刀枪不入。究竟是谁把它们造成了这副模样？ \n  \n         {#CodexItalicFormat}你知道它们属于波塞冬的领域——地下世界不是它们该出现的地方。"
    }
    {
      Id = "CodexData_WaterUnit_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}海蛇是所有水手和航海家的噩梦。那些故事你都耳熟能详。 \n  \n         {#CodexItalicFormat}和世间许多事一样，真相往往还要丑陋得多。所以，还是小心为妙。"
    }
    {
      Id = "CodexData_WaterUnitMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}倘若凡间的水手们知道在海底蛰伏着何种怪物的话，恐怕他们都会打消出海的念头。 \n  \n         {#CodexItalicFormat}他们对这些能让他们顷刻葬身鱼腹的怪物一无所知。"
    }
    {
      Id = "CodexData_ThiefMineLayer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有许多凡人莫名其妙地迷恋大海，哪怕大海只会将他们吞没。哪怕在他们的生命终结之时，他们也不愿被埋在地下，而是想要葬身海底。\n  \n         {#CodexItalicFormat}在特定的情况下，他们的骨灰会与盐水与海风产生反应，阴差阳错地化作某种不幸的产物。"
    }
    {
      Id = "CodexData_CrawlerMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}以前有过长得异常高大的野兽，但他们活不了多久就死了。反而是那些身形小巧、行踪诡秘的个体才能生存下来。 \n  \n         {#CodexItalicFormat}由此可想而知，有的时候，敌人越小，威胁反而越大。"
    }
    {
      Id = "CodexData_CorruptedShadeSmall_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}所有亡者都会来到冥界，无论早晚，无论以何种方式。至少曾经如此。 \n  \n         {#CodexItalicFormat}他们对往日记忆已经所剩无几；在最为空洞的环境下，假以时日，有些暗灵便会厌倦自己的命运，聚集在哀悼原野，漫无目的地徘徊。"
    }
    {
      Id = "CodexData_CorruptedShadeMedium_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}常常会有凡人感到不解：自己究竟做了什么，才会落得这样的下场，不止惨淡地过完了一生，死后生活也不如人意。大多数人最终都会接受自己的命运。 \n  \n         {#CodexItalicFormat}那些不认命的往往下场更为残酷：在屈辱和愤怒的驱使下，他们麻木不仁的内心最终会变为外在的表征。"
    }
    {
      Id = "CodexData_CorruptedShadeLarge_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}凡人在世间形貌各异，亡灵的大小也各有不同。但灵魂的大小并不能反映其生前或死后的品质。 \n  \n         {#CodexItalicFormat}你有见过那些蹒跚而行的卑劣暗灵吗？他们现在唯一的目的便是掐灭生命。"
    }
    {
      Id = "CodexData_DespairElemental_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}绝望的形式多种多样；比方说，有一种绝望叫做“从天而降的巨石”。这种绝望也暗中解释了为什么哀悼原野的受诅小麦长得并不茂密。 \n  \n         {#CodexItalicFormat}在绝望面前放弃很容易；摆脱绝望很困难，但也不无可能。至少，一般来说不无可能……"
    }
    {
      Id = "CodexData_BrokenHearted_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}情绪这东西说来就来，谁能说得准呢？有的时候是因为邪魔的蛊惑，这自然不假，而且邪魔带来的也不见得总是负面情绪；但更多时候，这与邪魔并无关系。 \n  \n         {#CodexItalicFormat}塔耳塔罗斯外的哀悼原野如今失控地疯长着，负面情绪高涨，而邪魔在此肆意妄为。"
    }
    {
      Id = "CodexData_Lovesick_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}神明有一点与凡人无异，那便是我们常常在头脑的理智与心灵的欲望之间左右为难。 \n  \n         {#CodexItalicFormat}当凡人彻底心灰意冷之时，就会沦为一具空壳——死后也难逃这样的宿命。"
    }
    {
      Id = "CodexData_Mourner_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}流泪真是种怪异的行为。想想吧！被情感压倒的时候，我们的眼睛居然会分泌出水分，模糊我们的视线、刺痛我们的神经；然而正是这样的眼泪，有时却也能带来些许安慰。\n  \n         {#CodexItalicFormat}但对于那些度过了可悲的一生，却憋住了每一滴眼泪的人，死后便再无安慰可言——无论他们如今流出多少眼泪也无济于事。"
    }
    {
      Id = "CodexData_LycanSwarmer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}众魔之父有无数恐怖的后代，不仅凡人闻风丧胆，就连众神都要望而却步；恐怕这些怪物的数量与黑夜的儿女有得一拼。 \n  \n         {#CodexItalicFormat}这些怪物之中有些几乎无法算作活物，而更像是刹那间的歹念化做实体……说来也怪，这样的实体有些危害并不大，甚至像个摆设。"
    }
    {
      Id = "CodexData_Lycanthrope_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}野兽感官敏锐、动机纯粹，有许多值得我们学习和羡慕的地方。 \n  \n         {#CodexItalicFormat}当然，如果你正与哀悼原野里潜匿的兽化怪物交手，上面这话可能多少有点不合时宜。有人说这些怪物来自于被神明诅咒过的血脉；这种观点不仅对狼群有些冒犯——毕竟他们压根就没有那么相像，而且只怕众神听了也会连连摇头。"
    }
    {
      Id = "CodexData_Vampire_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}血乃是生命的精华，是一种效力较为强劲的液体，可以用于延年益寿或是其他一系列巫术。对于特定品类的邪魔来说，血也是相当美味的饮品。 \n  \n         {#CodexItalicFormat}这些恶灵有时会蛰伏在地表，在那里鲜血的供给较为充足。但哪怕强大如他们，也畏惧黎明的曙光，因此当心生怯懦时，他们便会瑟缩在冥界，任由自己对鲜血的渴望愈发强烈。"
    }
    {
      Id = "CodexData_Lamia_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}巫术，和所有的工具一样，并不仅仅会被用在正道上。有些生物掌握着基础的毁灭魔法，而他们的巫术造诣也就到此为止了。 \n  \n         {#CodexItalicFormat}蛇发拉米亚女王的子嗣便是这样一类生物，她们恶毒的魔法固然粗劣，但烈度却不容小觑。"
    }
    {
      Id = "CodexData_LamiaMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}哀悼原野中的生物要么已经彻底绝望，要么以绝望者的颓丧情绪为食。早已不屑维持人形的拉米亚女王既属于前者，也属于后者。 \n  \n         {#CodexItalicFormat}身为拉米亚女王，她统治自己子嗣的手段却只有恐惧。她的憎恨无边无际，且对神明和凡人一视同仁；事到如今，恐怕已经没人知道她还记不记得这种憎恨究竟为何而来。"
    }
    {
      Id = "CodexData_SwarmerClockwork_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些没有心智的恶灵自死亡的痛苦中诞生；它们以受诅者的灵魂为食，然而近期食物来源愈发稀少。 \n  \n         {#CodexItalicFormat}它们没有主人，但对克洛诺斯和他的信徒也不构成威胁。因此，它们没有被赶走，而是沦为了萨提尔信众平日比拼蹄力的消遣之物。"
    }
    {
      Id = "CodexData_ClockworkHeavyMelee_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界之主职责繁多，然而其中最主要的一条便是为死去的生命宣判。对于最为卑劣的生命来说，死后得到的判罚相当简单直接。\n  \n         {#CodexItalicFormat}这些怀恨在心的卑劣之徒被泰坦王释放后，便一心为他效命，想必是臭味相投。"
    }
    {
      Id = "CodexData_Swarmer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些邪魔的外形酷似凡人的颅骨；或许神明的颅骨也与此别无二致。在冥界深处，它们曾经无处不在。 \n  \n         {#CodexItalicFormat}倘若能在它们燃烧的双眼后看到一丝闪光，那边意味着它们杀意正盛，抑或是惧意正浓。"
    }
    {
      Id = "CodexData_LightRanged_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}我们所学习和研究的事物，可能需要永恒的时间才能掌握。因此，有些凡人在短暂的一生中能够学有所成，就格外值得钦佩。\n  \n         {#CodexItalicFormat}现在，她们是你基于誓言的姐妹。她们在寂静中如鱼得水，一丝不苟地执行着命令。"
    }
    {
      Id = "CodexData_SpreadShotUnit_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}她们常年受人排挤、受人惧怕，久而久之，这些特质便对她们产生了影响。有机会见到她们的话，别把这些事情放在心上。 \n  \n         {#CodexItalicFormat}她们之中有一些人已经加入了我们麾下，但还有太多人太难以驾驭。也许一切自有其时吧。"
    }
    {
      Id = "CodexData_BloodlessNaked_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}哪怕没有了皮肤和筋腱，没有了盔甲和武器，他们仍然要战争到底；这些人对战争病态的渴望就是如此。 \n  \n         {#CodexItalicFormat}在你父亲的冥界遍布岩浆的角落中，他们的冲动往往能得到满足。"
    }
    {
      Id = "CodexData_BloodlessWaveFist_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}哪怕有些人崇拜早已殒命的怪物，而且为此愤世嫉俗、心怀怨怼，他们在死后也能在冥界找到属于自己的家。 \n  \n         {#CodexItalicFormat}愿你永远不会遇上他们，或者更准确地说，永远不会遇上他们那如波浪般袭来的怒火。"
    }
    {
      Id = "CodexData_BloodlessBerserker_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}按理来说，他们应该在塔耳塔罗斯的深坑里打滚才对。但是，出于某些原因，他们获得了特赦。 \n  \n         {#CodexItalicFormat}毕竟，你的父亲想要为冥界树立起某种形象，而这些残魂对此有所帮助。"
    }
    {
      Id = "CodexData_BloodlessGrenadier_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}凡人总是无可避免地会被死亡吸引，下意识想要接触能招致死亡的器物。有些时候，甚至是不惜一切代价。 \n  \n         {#CodexItalicFormat}哪怕是在地底的炼狱之中，他们也要想方设法把汹涌的火焰装入瓶中，而非避开火焰的炙烤。"
    }
    {
      Id = "CodexData_BloodlessSelfDestruct_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些灵魂在遭受了格外惨烈的死亡后，会被困在那个情境之中无法自拔；不过，这也可能是他们自己的选择。 \n  \n         {#CodexItalicFormat}他们无法从你父亲的冥界中挣脱，但他们仍要在其中挣扎。"
    }
    {
      Id = "CodexData_BloodlessPitcher_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}大地母亲守护着无数的秘密，有时还会为之设下致命的陷阱。通常来说，就只需要加一点这个，再加一点那个…… \n  \n         {#CodexItalicFormat}有些凡人就是无法抵御诱惑，想要揭开这些秘密。我们又怎么能怪罪他们呢？"
    }
    {
      Id = "CodexData_SatyrCrossbow2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}对于效忠泰坦王的人来说，还有什么能比登上奥林匹斯山，死在众神和他们的机械守卫手上更为讽刺的呢？ \n  \n         {#CodexItalicFormat}他们看待死亡的方式相比于正常的凡人来说，实在是大相径庭。"
    }
    {
      Id = "CodexData_SatyrLancer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}泰坦的先锋部队夜以继日地训练，只为助他完成一统天地的霸业。倘若不是它们心存歹念，倒也算是精神可嘉。\n  \n         {#CodexItalicFormat}它们从战死沙场的暗灵身上学到了些战术。按说它们是要重现黄金时代；但它们如此痴迷于暴力，恐怕暗地里另有所图。"
    }
    {
      Id = "CodexData_SatyrLancer2_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}那些性情暴戾的萨提尔大多都会选择尖利的武器，大抵是因为这些武器和他们头上的犄角有诸多相似之处吧。 \n  \n         {#CodexItalicFormat}只有拥有最精湛的战斗技术，而且最为抗冻的那一批萨提尔，才能入选泰坦王的地表突击队。"
    }
    {
      Id = "CodexData_Crawler_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}那些身形娇小，步履飞快的生物究竟有什么可怕之处，让凡人一见到就大惊失色？\n  \n         {#CodexItalicFormat}萨提尔在这件事上也许要理智得多，因为它们对鼠兽没有这种恐惧。恰恰相反，它们会利用这种恐惧对付它们的敌人，而它们手下无数的啮齿爪牙对此也是乐意之至。"
    }
    {
      Id = "CodexData_SatyrRatCatcher_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些偶蹄生物很容易被误认为衣衫褴褛的人类乞丐。当然，前提是你没有听到那蓬松的衣物下传来的刺耳叫声。\n  \n         {#CodexItalicFormat}这些萨提尔与簇拥在脚边的鼠兽互利共生；但他们之间并没有什么情谊，一旦失去了共同的敌人，便很容易反目成仇。"
    }
    {
      Id = "CodexData_SatyrRatCatcherMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}迪奥尼索司本人可以证实，萨提尔虽然千奇百怪，但在毫无节制这一点上相当一致。 \n  \n         {#CodexItalicFormat}因此，只要略加想象，我们便能意识到，倘若拥有足量的食物，这些可怖的生物偶尔便能长得相当庞大。其他萨提尔自然会把这种个体视作榜样，但同时也会非常识趣地对其敬而远之。"
    }
    {
      Id = "CodexData_SatyrCultist_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些人愿意为克洛诺斯杀人；有些人愿意为他杀身成仁。两样都沾的人很容易成为他的心腹，只不过很难在这个位置上呆得长久。 \n  \n         {#CodexItalicFormat}按泰坦自己的旨意，时间永远不会停止，因此就连他也没有办法逆转这些生物的死亡。但是，哪怕它们肉体灰飞烟灭，要不了多久也会卷土重来……一定是泰坦神将死而复生的力量分给了它们。"
    }
    {
      Id = "CodexData_TimeElemental_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}和人们普遍认为的不同，时间的流逝并非完全均衡：千万年可以转瞬即逝，一瞬间也可以无限长久。更复杂地说，每个身陷时间长河中的个体，对时间的主观感受都有所不同。 \n  \n         {#CodexItalicFormat}考虑到那么多无限长久的瞬间，以及它们无穷种显现的方式，泰坦能将其化为己用，也便不足为奇了。"
    }
    {
      Id = "CodexData_GoldElemental_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}众所周知，时间泰坦对黄金情有独钟。事实上，他篡夺冥府后所颁布的最初几道法令之一，便是将他的头像铸成闪闪发光的金币，然后派发到冥界的各个角落，以此彰显他的存在感。 \n  \n         {#CodexItalicFormat}当然，黄金也有许多用处。它们比大多数金属都要更加柔软可塑，几乎像是有自己的生命一般……不过那些四处活动的钱袋，实际上则是泰坦的杰作。"
    }
    {
      Id = "CodexData_GoldElementalMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在无数种腐蚀心灵的恶念之中，贪婪独占了一席之地。渴望得到更多！多么不起眼的一个念头。但很快它便会图穷匕见，成为各种破坏行径的罪魁祸首。\n  \n          {#CodexItalicFormat}没错，破坏性最强的行为往往出自贪婪；对凡人如此，对神明也不例外。而这些行为日后则会化作具象，成为贪得无厌的生物。"
    }
    {
      Id = "CodexData_Carrion_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}它们向北一路飞去，夜夜如此，愈发远离它们的故乡斯廷法罗斯湖，仿佛知道前方有血肉的盛宴等待它们一般。\n  \n         {#CodexItalicFormat}它们啃食了太多亡者的血肉，以至于自己也愈发远离生者的行列。"
    }
    {
      Id = "CodexData_Zombie_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}现如今冥界门户大开，冥王的王位也遭到了窃取，以至于地表的亡者再无去处。 \n  \n         {#CodexItalicFormat}因此，他们中的大多数就留在倒下的地方。但也有一些亡者更为躁动，且残存的意志力还能让他们挪动双脚，于是他们便开始蹒跚而行。"
    }
    {
      Id = "CodexData_ZombieOlympus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}越是明令禁止的事情，就越有人想要以身犯险。众神之山不是凡人该去的地方，但总有凡人想要攀上去一探究竟。 \n  \n         {#CodexItalicFormat}当然，要想登上奥林匹斯山，实在是困难重重。但现在，得益于泰坦王的影响，那些蠢货又多了一次尝试的机会。"
    }
    {
      Id = "CodexData_ZombieCrewman_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}克洛诺斯唤起了一整支沉没的舰队；给每支舰队配备船员，相比之下理应是轻而易举的事。 \n  \n         {#CodexItalicFormat}然而，那些溺死的船员的能力却令人大失所望，就好像他们并不是来动真格的，而是用来吸引火力一样。"
    }
    {
      Id = "CodexData_ZombieAssassin_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在人类社会中，劫匪与盗匪这两个职业可谓源远流长，古而有之。对于某些人来说，偷盗并非是迫于生计的蝇营狗苟，而是一种召唤。\n  \n         {#CodexItalicFormat}现在他们丢了性命，因此迫切想要夺取他人的生命为己所用。"
    }
    {
      Id = "CodexData_ZombieHeavyRanged_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}当波塞冬撕裂大陆之时，许多人都认为，只有强壮之人才能幸存。但事实证明，就连强壮之人也无法躲过那一劫。 \n  \n         {#CodexItalicFormat}他们当初落水时紧紧抱住的救命木桶，如今也再无作用，便当做了随手抛掷的武器。"
    }
    {
      Id = "CodexData_ZombieSpawner_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}再怎么不愿意，人们也必须承认，一座浅浅的坟墓总比没有坟墓要强。 \n  \n         {#CodexItalicFormat}但太浅的坟墓终究无法给亡者带来多少安宁。就连最轻微的脚步声，也足以惊扰起附近一带的长眠之人。"
    }
    {
      Id = "CodexData_Mudman_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}大地母亲有时也会恶心反胃。 \n  \n         {#CodexItalicFormat}那么大一滩泥巴凭空现了人形，究竟是大自然的意外，还是对造物者的存心挑衅，谁又说得准呢？"
    }
    {
      Id = "CodexData_SatyrCrossbow_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些长羊角的生物忠于他们的泰坦王。倘若不是他们的“无私”奉献，克洛诺斯现在恐怕还被关在塔耳塔罗斯呢。 \n  \n         {#CodexItalicFormat}他们在冥河神庙中苦心经营了好久，终于完成了长年累月的梦想：重回地表。而他们上一次在地表现身，还是克洛诺斯所统治的“黄金时代”。其中最为强壮、最为残忍者自然身先士卒，成为了无数苦难与混乱的源头。"
    }
    {
      Id = "CodexData_SatyrSapper_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}对于那些为泰坦王效命，献身于其大业之人来说，没有什么比亲自登上奥林匹斯山烧杀掳掠更为光荣的了。 \n  \n         {#CodexItalicFormat}突破奥林匹斯山那固若金汤的防线绝非易事，但有些身材健硕、性情凶残的萨提尔愿意一而再、再而三地尝试，而且乐此不疲。"
    }
    {
      Id = "CodexData_WaterElemental_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}生活在江河湖海中的仙女也并非无忧无虑；比如这些恶灵，就让她们头疼不已。 \n  \n         {#CodexItalicFormat}当凡人的颅骨溺于水中时，有的时候某种水中邪魔便会附身其上；然后，一旦它适应了新的身体，便很快能让其他人遭受同样的命运。"
    }
    {
      Id = "CodexData_Scimiterror_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}从遥远的大陆送来的异域武器，注入了邪恶的意图，然后批量装到了箱子里。能出什么岔子呢？ \n  \n         {#CodexItalicFormat}这些兵刃从何而来，是否侍奉克洛诺斯，都仍是未解之谜。然而，至于它们是否锋利，能否见血，则早已没有任何争议。"
    }
    {
      Id = "CodexData_Stickler_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}标枪是一种简单实用的发明；凡人为此似乎甚是骄傲。\n  \n         {#CodexItalicFormat}因此，总有一些自以为能成为标枪投掷大师的人，哪怕在死后也没有放弃训练……而且愿意为了金币献出自己的忠诚。"
    }
    {
      Id = "CodexData_Drunk_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}凡人居然开始使用由木板制成的圆柱形容器，真是令人费解。陶土明明完全足以胜任各种用途，而且还无需砍伐树木。 \n  \n         {#CodexItalicFormat}然而，我这样说，肯定有些无赖要反对。他们沦陷在这新时代的容器之中，溺死在其中不知什么液体里，落得个荒唐可笑的结局；而他们的荒唐在死后仍然延续。"
    }
    {
      Id = "CodexData_Swab_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}是什么吸引凡人驶入汪洋之中？追求维生的食物至少是个可以理解的理由；相比之下，追求完美这个理由就有些令人费解了。 \n  \n         {#CodexItalicFormat}这些追求往往会因为溺亡结束；但有些人对于海洋的忠诚在溺亡时才刚刚开始。这样的人身上背负的，往往不仅是他们的热爱。"
    }
    {
      Id = "CodexData_HarpyCutter_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}曾经，鹰身女妖居住在峭壁之上，或者洞穴之中，以鼠兽和迷途之人为食。但在傲慢的加持下，她们愈发好高骛远，以至于盯上了远胜于她们的猎物。 \n  \n         {#CodexItalicFormat}在众神之山上筑巢似乎是这一代鹰身女妖的共同梦想。因此，她们树立了许多强大的敌人，但也得到了克洛诺斯这一强有力的幕后推手。"
    }
    {
      Id = "CodexData_HarpyDropper_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}有些鹰身女妖早已习惯了高处的寒冷，但她们对此并不满足。她们越飞越高，渴望将自己的利爪插在月亮身上。 \n  \n         {#CodexItalicFormat}你知道月亮有办法保护自己，但她为你做了那么多事，因此如果你恰好碰上这些鹰身女妖，不如帮她省点麻烦吧？"
    }
    {
      Id = "CodexData_Charybdis_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在凡间的水手无数种死因之中，这是最灾难性的一种。 \n  \n         {#CodexItalicFormat}迎头驶向这样的怪物显然并非明智之举。但是，有它出没的地方总是祸不单行；各种各样的危险环绕其周围，总会让凡人在选择自己的死亡方式时犯难。顺带一提，事实证明，关于它扎根于某处的传言只是谣言而已。"
    }
    {
      Id = "CodexData_SentryBot_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}奥林匹斯山上的自动机安保力量需要满足一系列需求，而不幸的是，有很多需求和消灭山上的入侵者毫无干系。 \n  \n         {#CodexItalicFormat}这个型号的自动机需要拥有优雅的装饰性外观，这样一来在奥林匹斯山的自然风光中才不会显得突兀。这是仍在使用的自动机中最古早的型号了。"
    }
    {
      Id = "CodexData_AutomatonBeamer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}奥林匹斯众神都同意，部署自动机对奥林匹斯山的防御工事益处良多；然而，确保机器运作的责任，落到了赫菲斯托斯一个人的肩上。 \n  \n         {#CodexItalicFormat}有一个格外棘手的问题便是如何快速、准确地辨识敌人。看起来自动机，和我们所有人一样，分辨不出到底应该信任谁。"
    }
    {
      Id = "CodexData_AutomatonEnforcer_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些自动机最初是研发出来在赫菲斯托斯大人的熔炉旁边帮忙的，但它们过人的力量用在其他方面也是一把好手。 \n  \n         {#CodexItalicFormat}它们执行复杂的任务有些吃力，而且不会对口头指令作出反应。你对它们来说，和一堆煤球没有区别。"
    }
    {
      Id = "CodexData_Dragon_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}泰坦王的大军为了攻克众神之山，可谓不择手段。飞天的野兽可以越过山上的诸多防线，甚至还可以运输其他兵力和物资。 \n  \n         {#CodexItalicFormat}按理来说，这些野兽应该对这场纷争的赢家毫不关心才是。但它们身上有着泰坦的烙印，这就意味着它们要么是为此目的专门繁育的，要么则是受到了非常强烈的驱使。"
    }
    {
      Id = "CodexData_DragonMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}要想洗劫众神之山，必须要有足够的装备，还要有办法绕开基础的防御措施。泰坦王派出了一只巨大的飞龙，将这两个条件一并满足了。 \n  \n         {#CodexItalicFormat}这些生物的血液是寒冷的；它们会被热源所吸引，而奥林匹斯山上从不缺少热源，尤其是现在整座山上战火纷飞。"
    }
    {
      Id = "CodexData_Talos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}只有才华最为卓绝的人，才能为雕像赋予生命。对于自己的这一壮举，赫菲斯托斯大人本应无比骄傲——在他所有的自动机造物之中，这一台在各个方面都无可匹敌。\n  \n         {#CodexItalicFormat}更早期的型号曾在一座偏远的小岛上进行过测试，在那里它表现出色，但最后遭到了摧毁。但赫菲斯托斯大人设法取回了零件；而现在这个型号，已经拥有了自我重组的功能。"
    }
    {
      Id = "CodexData_Mati_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些怪异的眼睛自无可名状的恐怖之中涌现；最好避免和它们产生任何形式的接触。 \n  \n         {#CodexItalicFormat}据称，它们只能看见事物最丑恶的一面，并且会将其激发，让其在世间展露无遗。"
    }
    {
      Id = "CodexData_EarthElemental_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在奥林匹斯山冰冷的外表下，燃烧着炽热的核心；赫菲斯托斯的锻炉和赫斯提亚的火炉，都是由其点燃。 \n  \n         {#CodexItalicFormat}如此的酷热与高压之下，就连坚固的岩石都能被塑造成痛苦的形状——与那些擅闯禁地的盗匪有几分相像。"
    }
    {
      Id = "CodexData_DragonBurrower_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这些像蛇一样的寄生生物从提丰那不停翻涌、蜿蜒如蛇的身体上洒落，随后便会钻入土壤之中，将其误认为是它们父亲的血肉。 \n  \n         {#CodexItalicFormat}不知是缺乏养料还是缺乏娱乐，它们总会埋伏在土地中，只等有人接近时一跃而起，攻其不备。"
    }
    {
      Id = "CodexData_SimpleSquad_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}虽然这些东西外形酷似眼睛，而众魔之父的眼睛数目众多，但它们实际上似乎是某种更恶心的东西的幼体形态。 \n  \n         {#CodexItalicFormat}它们聚集在一起，只为形成更大的群落。很少有幼体能够成活，而死掉的躯壳则会成为其他幼体的养料。这一切都是为了什么？"
    }
    {
      Id = "CodexData_Stalker_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}怪物常常生活在暗影之中，这点与你相仿。除此之外，你与怪物再没有共通之处，真是谢天谢地。 \n  \n         {#CodexItalicFormat}提丰的这一支后裔对空气和光明格外憎恨，因此终日潜伏于土壤之下虚度光阴——除了进食的时候。"
    }
    {
      Id = "CodexData_StalkerMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你能想象出的每一种怪物，都有着共同的祖先；哪怕是你想象不出来的，也同样如此。他们似乎都被同一条原则驱使着……那便是弱肉强食。\n  \n         {#CodexItalicFormat}有些怪物看起来学会了成对狩猎，并非出于血脉的联系，单单只是出于便利。如果他们找不到猎物，注定会转而自相残杀，这点确凿无疑。"
    }
    {
      Id = "CodexData_Brute_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}提丰那庞大的身躯不只是单一的生物，而是万千不可名状的异物的聚群。他的这些子孙就是这一点极好的例证。 \n  \n         {#CodexItalicFormat}他们头顶骨质的突起，大抵曾经是他们父亲的牙齿，而他们父亲的牙齿数不胜数。至于他们自己的牙齿又是什么样子，还是不要深究为好。"
    }
    {
      Id = "CodexData_BruteMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}与其他许多生物一样，提丰似乎对他的子孙后代毫不在意，尽管他的后代数量令人震惊。哪怕是身形最大，性情最凶残的孩子，众魔之父对其也全无感情；就连魔法手段也无法发现哪怕一分一毫的正面情绪。 \n  \n         {#CodexItalicFormat}你对这种生物同样没有什么正面情绪，但或许你对他们有几分羡慕；因为他们在他们想做的事情上效率如此之高，恐怕你穷尽毕生也无法企及。"
    }
    {
      Id = "CodexData_Captain_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你认识一些凡人的暗灵，自称曾横穿过波塞冬掌管的整片海洋。如此的傲慢，很可能就是他们未曾寿终正寝，便已命丧黄泉的原因。 \n  \n         {#CodexItalicFormat}但是世上也有声名远扬的水手，这点不假。同样的，还有恶名昭著的水手，将前者视为他们的猎物。死后，他们的血管中已经不再有血液流淌，只剩下海洋的腥咸。"
    }
    {
      Id = "CodexData_OctofishMiniboss_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}卡俄斯究竟是如何创造出你眼前这一切的？或许，为了弥补这个世界的空缺，身为原初混沌的祂从遥远的异世界中借鉴了一二。 \n  \n         {#CodexItalicFormat}除此之外，再没有更好的理论能解释这一种海洋怪物为何存在，又为何成群地漂浮。你甚至无法辨别它们有没有最简单的思想，但它们蛰起人来倒是疼得很。"
    }
    {
      Id = "CodexData_Scylla_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你知道的吧，她这副模样是受了女巫的诅咒；不过那个诅咒只能决定她的外表，她的性情与之毫无关系。但总而言之，她不喜欢女巫，这点值得注意。  \n  \n         {#CodexItalicFormat}她与其他来自深海的可憎女妖组建了个乐队；但你必须得承认，她们唱歌确实有两下子。"
    }
    {
      Id = "CodexData_Polyphemus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这个盲眼的独眼巨人吃了一辈子人肉，终于有一天厌倦了这样的生活，决定归隐山林，做个普普通通的牧羊人。  \n  \n         {#CodexItalicFormat}但是切记，他从未忘记人肉的鲜美。因为他将反反复复提醒你这点。"
    }
    {
      Id = "CodexData_Prometheus_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这个具有反叛精神的泰坦曾经与奥林匹斯众神并肩作战，但后来又从他们手中盗取了火种，一切都是为了凡人的利益。而因为这件事，他受到了人尽皆知的惩罚。 \n  \n         {#CodexItalicFormat}如果他真的知道将要发生的一切，那实在是个无比沉重的负担。但也许，在他所预见的未来之中，他终会甩开担子，挣脱羁绊。"
    }
    {
      Id = "CodexData_Hub_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你属于冥府，但你现在暂居于此，匿踪遁形，少有同伴。三岔路口四通八达，可以让你去到任何想去的地方。\n  \n         {#CodexItalicFormat}接下来何去何从，可要谨慎选择。"
    }
    {
      Id = "CodexData_BiomeF_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}与其说厄瑞玻斯成为了一片废墟，倒不如说它回归了更加亲近自然的状态。 \n  \n         {#CodexItalicFormat}居住在那里的失落亡魂已经没有别的去处了；再怎么哀悼也对他们无益。"
    }
    {
      Id = "CodexData_BiomeG_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}俄刻阿诺斯大体上算是波塞冬的领域，但它的边境与冥界相交汇。这是你的幸事。 \n  \n         {#CodexItalicFormat}但不幸的是，在那里安家落户的怪物才不管你是何方神圣；冥界王女、克洛诺斯，抑或别的神明，在他们眼里没有什么两样。"
    }
    {
      Id = "CodexData_BiomeH_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}哀悼原野在冥界的外沿延展开去，与那里的居民一同陷入了互相应和的颓丧之态。 \n  \n         {#CodexItalicFormat}说来真是奇特，那里的居民密度日渐增长，但孤独感却始终挥之不去、如影随形，仿佛随时要将人压倒。没有任何事物阻止在那里蹉跎时光的暗灵离开——除了他们自己。"
    }
    {
      Id = "CodexData_BiomeI_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界变幻莫测的深渊早已不似从前。现在，克洛诺斯栖身于彼，身边簇拥着他的萨提尔信众。 \n  \n         {#CodexItalicFormat}那泰坦究竟是如何从不可能逃离的牢狱中逃离，恐怕只有他自己说得清楚。但自从他重现世间起，此处的齿轮和机械声便愈发振聋发聩，象征着无数年前的谋篇布局如今终于得逞。"
    }
    {
      Id = "CodexData_BiomeI_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}冥界变幻莫测的深渊早已不似从前。时间泰坦虽已失势，他的影响力却久未散去。 \n  \n         {#CodexItalicFormat}你会有机会见到传说中那戒备森严，令人闻风丧胆的塔耳塔罗斯吗？不会。因为那已经是过去，更何况还只是传说。要知道，我们的心灵，想象力可谓天马行空。"
    }
    {
      Id = "CodexData_BiomeHouse_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这里本应是你的家；你的父亲、母亲和哥哥本应都在这里，而那个泰坦则本应深埋地底。但“本应”之事有时并非现实。\n  \n         {#CodexItalicFormat}如今的冥府被泰坦的狰狞面貌和怪异审美打造得面目全非，成为了他的大本营，表面上看固若金汤。但你知道进去的路，也有进入其中的权力，这点就连泰坦也无法剥夺。"
    }
    {
      Id = "CodexData_BiomeHouseRestored_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}这里本应是你的家；你的父亲、母亲和哥哥都在这里。它过往的样子与现在相差无几，但并不完全相同，因为过往无法复原；至少，无法复原彻底。 \n  \n         {#CodexItalicFormat}哪怕真正的冥府如你父亲所言，正在开展翻修工作，但冥府过往在泰坦手中的景象，仍然在你心头挥之不去。一方面，你仍为其所扰；但另一方面，这也驱使着你。"
    }
    {
      Id = "CodexData_BiomePalace_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你山上的亲戚所住的堡垒；坐落在最高耸、最壮丽的山峰之上，受到物理和魔法手段的双重保护。它仿佛一座宝库，其中所承载之物，绝对无可替代。 \n  \n         {#CodexItalicFormat}你能想象自己身居其中，举手投足不得大意，言辞谈吐亦要处处收敛么？那里固然美丽，但也规矩繁多，而你更喜欢简单的生活。"
    }
    {
      Id = "CodexData_BiomeChaos_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}那诞生万物的无底深渊，大体上来说，与一时兴起创造这深渊的意志无法区分。 \n  \n         {#CodexItalicFormat}这里按说不该算是个“地方”，因为人们无法用俗世的手段抵达。要想去到那个最为古老之处，唯一切实可行的方式便是想方设法引起虚空的注意，然后听从祂的呼唤。"
    }
    {
      Id = "CodexData_BiomeN_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}埃费拉城是为了供奉你的父母而建造的，而如今它惨遭劫掠。\n  \n         {#CodexItalicFormat}反正你也无法在那里生活，毕竟你生于冥界。当然，除非你那理论性的咒语确实有效，能让你摆脱冥界血脉的束缚。"
    }
    {
      Id = "CodexData_BiomeO_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}考虑到波塞冬对色萨利的所作所为，居住在那里的女巫恐怕得去学游泳了。 \n  \n         {#CodexItalicFormat}这条海峡从埃费拉城直通奥林匹斯山的山脚。我们的敌人可以借此调动海军，但你也可以借此直达目的地。"
    }
    {
      Id = "CodexData_BiomeP_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}你从未曾设想过，自己有朝一日会亲眼见到奥林匹斯山；真是世事难料啊。依你看，它最光辉的时刻是在过去，还是在未来？至少不是在现在。 \n  \n         {#CodexItalicFormat}众神此时此刻正在山顶避难，而守护那些空荡大厅和冰冷小径的重任则落在了他们的自动机上。"
    }
    {
      Id = "CodexData_BiomeQ_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在奥林匹斯山的最高峰，矗立着一座辉煌的要塞；奥林匹斯众神的权力中心就暗藏在其中。这一条防线很可能是在众神第一次险些遭到推翻时所设计的，那是很久很久之前的事了。 \n  \n         {#CodexItalicFormat}现在，这座要塞已经摇摇欲坠；或许它早晚有一天会轰然倒塌。而你家人们心中的骄傲之情，想必也和这座要塞一样，已是千疮百孔。"
    }
    {
      Id = "CodexData_BiomeQ_02"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}在奥林匹斯山的最高峰，矗立着一座辉煌的要塞；奥林匹斯众神的权力中心就暗藏在其中。这一条防线很可能是在众神第一次险些遭到推翻时所设计的，那是很久很久之前的事了。 \n  \n         {#CodexItalicFormat}自那之后，这座要塞便屹立不倒。但你家人心中的骄傲之情，想必已然千疮百孔、不复当年。"
    }
    {
      Id = "CodexData_BiomeB_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}从前，大部分亡者都会聚集在水仙花平原中。但某一天，火焰之河突然势如溃堤，让整片原野燃起了熊熊大火。在那之后，就连亡者也只能另寻去处了。 \n  \n         {#CodexItalicFormat}谁知道水仙花平原现在怎么样了呢？对你我来说，那不过是来自另一段时光的梦幻泡影罢了。"
    }
    {
      Id = "CodexData_BiomeC_01"
      InheritFrom = "BaseCodexEntry"
      DisplayName = "{#CodexItalicFormat}那些为荣耀而生，抑或只是为荣耀而死之人，可能会在冥界得到嘉奖，获得这片乐土的永久居住权。 \n  \n         {#CodexItalicFormat}在至福乐土，荣耀便是最重要的事；暗灵平日的嗜好，便是围观精彩赛事，抑或亲身参与其中，以求力拔头筹、至臻完美。"
    }
  ]
}
