  lang = "zh-CN"
  Texts = [
    {
      Id = "Melinoe_1711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "姐姐，我们一同闪耀。"
    }
    {
      Id = "Melinoe_1697"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一同闪耀。"
    }
    {
      Id = "Artemis_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿明月指引你。"
    }
    {
      Id = "Artemis_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重，妹妹。"
    }
    {
      Id = "Artemis_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呃，嗨？"
    }
    {
      Id = "Artemis_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们一同闪耀！"
    }
    {
      Id = "Artemis_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又见面了。"
    }
    {
      Id = "Artemis_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿。"
    }
    {
      Id = "Artemis_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他逃不掉的。"
    }
    {
      Id = "Artemis_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也是。"
    }
    {
      Id = "Artemis_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也一样。"
    }
    {
      Id = "Artemis_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "愿我们永不失手。"
    }
    {
      Id = "Artemis_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "来吧，妹妹！"
    }
    {
      Id = "Artemis_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "唱起来！"
    }
    {
      Id = "Artemis_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就是这样！"
    }
    {
      Id = "Artemis_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一起！"
    }
    {
      Id = "Artemis_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "墨利诺厄！"
    }
    {
      Id = "Artemis_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "就是这样！"
    }
    {
      Id = "Artemis_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，墨利诺厄，我刚刚和赫卡忒汇报完。自从我上次过来之后，这地方变化{#Emph}好大{#Prev}！"
    }
    {
      Id = "Melinoe_1187"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗨，阿尔忒弥斯，欢迎！我们前一阵子手忙脚乱地收拾了一番，可算把这里弄得像模像样的了。不如我带你四处转转？你跟涅墨西斯打过招呼了吗？"
    }
    {
      Id = "Artemis_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，不行，我得走了。奥林匹斯山需要我，至少我得回去一段时间。下次再说啦，好么？"
    }
    {
      Id = "Melinoe_1188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我理解。那就回头见啦。"
    }
    {
      Id = "Artemis_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啊，可算等到你了！我在这待得已经有点晚了，但还是不忍心在你醒来之前就离开。你感觉怎么样？"
    }
    {
      Id = "Melinoe_3598"
      InheritFrom = "BaseNarrative"
      DisplayName = "考虑到前一夜时间泰坦差点用两个我那么大的镰刀把我砍成两半，我已经很知足了。谢谢你等我醒来哦。"
    }
    {
      Id = "Artemis_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "应该的！我喜欢你给这个地方带来的变化。现在这里真的有个营地的样子了！有小酒馆，有温泉……我应该多来看看才是。我不在的时候，也要独自闪耀哦！"
    }
    {
      Id = "Melinoe_3497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也是！"
    }
    {
      Id = "Melinoe_4028"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我不是有意要打断你的。我没想到会在这种时候听到你的歌声，不过我完全没有意见啦。"
    }
    {
      Id = "Artemis_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是应该的！嘿，既然你来了，要不要和我一起唱一会儿？就像以前那样。把你肩上的负担先放一放，毕竟也不差这一会儿嘛。"
    }
    {
      Id = "Artemis_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到你那副表情，我就知道你一定经历了很多糟心事，墨利诺厄。不过别忘了我们在这里的约定哦。"
    }
    {
      Id = "Melinoe_4029"
      InheritFrom = "BaseNarrative"
      DisplayName = "要把烦恼都留在林中空地的入口处，我记得……不过，你不会时不时分神，然后突然发现自己又陷入忧虑之中么？"
    }
    {
      Id = "Artemis_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就是这首歌的意义呀！放声歌唱并不能让我们的烦恼消失，但能让我们以最好的状态去面对它们。"
    }
    {
      Id = "Melinoe_4030"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯姐姐。我有件无比重要的事情，需要立刻跟你谈一谈。"
    }
    {
      Id = "Artemis_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样骗不过我哦，墨利诺厄妹妹，要想打断我的专注没那么容易。在{#Emph}这里{#Prev}不行！现在，你要跟我一起唱一会儿吗？"
    }
    {
      Id = "Artemis_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听说最近发生的事情了，妹妹，不过我们在外出狩猎的时候再聊吧。在这里的时候就别想那些啦。"
    }
    {
      Id = "Artemis_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "河对面那个暗灵是谁呀，旁边摞着一叠叠羊皮纸那个？他从来没有直视过我，但却一直在往这边瞥，好像我注意不到似的。"
    }
    {
      Id = "Melinoe_4941"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，你说的一定是卷宗管理员，他大概只是被你优美的歌声吸引了。而且很可能你每次唱起歌，他都会一丝不苟地在什么地方记上一笔。"
    }
    {
      Id = "Artemis_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "好吧，幸好我对这种事向来不介意。"
    }
    {
      Id = "Artemis_0432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嘿，卷宗管理员！这首歌为你而唱！"
    }
    {
      Id = "Artemis_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，阿波罗为这首歌做了很多贡献。但我还是很喜欢……而且它会让我想起我们一起飞越夜空的时刻。跟我一起唱一会儿吗？"
    }
    {
      Id = "Artemis_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "我在这稍微休息一下，妹妹。想跟我一起唱两句吗？"
    }
    {
      Id = "Artemis_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯山上总是阿波罗在唱歌，但在这里我可以尽情歌唱。"
    }
    {
      Id = "Artemis_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "每个人都有自己平复心情的小小仪式。"
    }
    {
      Id = "Artemis_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "我一直都很喜欢这里，周围的暗灵们看起来也毫不介意。"
    }
    {
      Id = "Artemis_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "我现在没有一点烦恼，你也应该这样。在这里就别想那些事情啦。"
    }
    {
      Id = "Artemis_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的身体已经恢复了，这点看得出来。但你的心灵休息好了么？"
    }
    {
      Id = "Artemis_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是我们的胜利之歌；不过其实在任何场合都可以唱啦。要一起吗？"
    }
    {
      Id = "Artemis_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "事情不如愿的时候，我们便会歌唱……哪怕只是唱上几句。"
    }
    {
      Id = "Artemis_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "昨夜事情进展不太顺利，但那都已经是过去了。"
    }
    {
      Id = "Artemis_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很快就得再次出发，重新开始狩猎，不过……我还有一点时间。"
    }
    {
      Id = "Artemis_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我在奥林匹斯山上的时候可没有这样的练习机会，你知道么！"
    }
    {
      Id = "Artemis_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "别想太多啦，妹妹，跟我一起唱一会儿吧。"
    }
    {
      Id = "Artemis_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这里没必要像平常那样寒暄，妹妹。"
    }
    {
      Id = "Artemis_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "在奥林匹斯山上唱歌的时候，我总会在意其他人的目光，但在这里不一样。"
    }
    {
      Id = "Artemis_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "这首歌献给所有的暗灵！"
    }
    {
      Id = "Artemis_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "每个夜晚都会带给我们新的可能，多么值得歌唱啊！"
    }
    {
      Id = "Artemis_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "已经唱够了么……？反正我已经聊够了！"
    }
    {
      Id = "Artemis_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗不在这里，唱不了另一部分，但你可以！"
    }
    {
      Id = "Melinoe_1194"
      InheritFrom = "BaseNarrative"
      DisplayName = "能与你更加密切地合作是我的荣幸，阿尔忒弥斯姐姐。这个肯定配不上你赐予我的神准天赋，但我还是希望你能收下它。"
    }
    {
      Id = "Artemis_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "你也要来跟我走一遍传统流程，是吗？没问题，那我接受你的赠礼，墨利诺厄妹妹。而且我这里也有一份回礼要送给你！"
    }
    {
      Id = "Artemis_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们在奥林匹斯山上有成桶的这东西，你是知道的，对吧？至少以前是这样啦。不过说起来，我都快忘了它是什么味道了……"
    }
    {
      Id = "Melinoe_1195"
      InheritFrom = "BaseNarrative"
      DisplayName = "那愿它能唤起你美好的回忆！当然，等你有空了再享用哦。"
    }
    {
      Id = "Artemis_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近你怎么总是这么慷慨？都让我有点紧张了。你可不许把每一次告别当成永别……！"
    }
    {
      Id = "Melinoe_2341"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心，只是敌人被箭矢贯穿的时候，我会多一些时间思考而已！我总是告诉自己，不能把友谊当作理所应当。"
    }
    {
      Id = "Artemis_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是不能在狩猎的时候喝这些的，你知道吧！不过收起来以备不时之需，倒是没问题啦。也许等这一切都解决了，我们可以好好喝一杯，聊一聊近况什么的。"
    }
    {
      Id = "Melinoe_2342"
      InheritFrom = "BaseNarrative"
      DisplayName = "或者，在那之前，我们可以一直像这样结伴对付那些复仇心切的恶灵，以及其他的敌人！不过，怀揣着那样的念想也很好啦。"
    }
    {
      Id = "Artemis_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，谢谢啦！奥林匹斯山上这东西的存量最近有些告急了。我会把它施舍给其他人的，当然前提是你不介意我用你的美意做个顺水人情啦。"
    }
    {
      Id = "Melinoe_3502"
      InheritFrom = "BaseNarrative"
      DisplayName = "我不记得银月姊妹的规章制度里有禁止做顺水人情这一项，所以应该没事！无论你用它做什么，都希望你能享受哦。"
    }
    {
      Id = "Artemis_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "……像我们这样的女神不常交朋友，但我也有自己的需求。我们可以独立生活，而不会感到孤独，你知道么？我希望你知道。至少对我来说是这样。"
    }
    {
      Id = "Melinoe_3503"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道，而且深有同感。就算在我们没有相互照应的时候，也有塞勒涅和老师在为我们守望。不过，每次和你面对面时，还是感觉很开心。"
    }
    {
      Id = "Artemis_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "和你也一样。大多数时候，我的大多数家人都给我一种可以割舍的感觉。但你是例外！虽然我们不是亲姐妹，但是……墨利诺厄，你永远是我的好妹妹。"
    }
    {
      Id = "Melinoe_3504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也永远是我的好姐姐，阿尔忒弥斯。"
    }
    {
      Id = "MelinoeField_4093"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，给你弄来了点好东西。我感觉事到如今，比起在你家那边，说不定在这里还真的更容易弄到这些。"
    }
    {
      Id = "Artemis_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，是仙酒！卡利斯托以前一直喜欢这个。也许等事情平息之后，我会再去看看她。"
    }
    {
      Id = "MelinoeField_4094"
      InheritFrom = "BaseNarrative"
      DisplayName = "你有任务在身之后，一定很难抽出时间陪伴她……抱歉，我之前都没有想到过这点。她没有因为这个生气吧……？"
    }
    {
      Id = "Artemis_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯……她变成熊的时候一般就意味着她生气了，而最近她经常变成熊。所以最近没空去找她，也不算是坏事！这样一来，我被她追着打的概率也大大降低了。"
    }
    {
      Id = "MelinoeField_4095"
      InheritFrom = "BaseNarrative"
      DisplayName = "我给你弄来了点东西，也许可以和卡利斯托分享，如果你愿意鼓起勇气再次冒险接近她的话。"
    }
    {
      Id = "Artemis_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，非常感谢！我还没考虑好要不要把它跟我的宁芙朋友们分享，毕竟，我也可以全都给{#Emph}自己{#Prev}囤着……"
    }
    {
      Id = "MelinoeField_4096"
      InheritFrom = "BaseNarrative"
      DisplayName = "那样的话口感就不会变得更好了，所以分享一下也无妨，或者至少把它送给愿意分享的人。最近跟宁芙们相处得不太愉快么？"
    }
    {
      Id = "Artemis_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "她们对我投身战争的事情意见很大。就好像我在她们眼中不是狩猎女神一样，不过实话说，本来我还挺喜欢这样的。但是，你我都有重任在身。"
    }
    {
      Id = "MelinoeField_4097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "确实。"
    }
    {
      Id = "MelinoeField_4098"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一瓶是专门送给你的，阿尔忒弥斯，所以别想着送给宁芙朋友们，就连卡利斯托都不行，不管她变成熊的样子有多吓人。"
    }
    {
      Id = "Artemis_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "好啦，好啦，你这么坚持的话！不过我拿它做什么好呢？我一向轻装上阵，而且最近都没怎么回过家。"
    }
    {
      Id = "MelinoeField_4099"
      InheritFrom = "BaseNarrative"
      DisplayName = "不如你把它藏起来，藏到一棵树下，或者空心的树桩之类的地方？等到某个恬静的夜晚，我们就可以自己享用了。"
    }
    {
      Id = "Artemis_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实是个好计划，墨利诺厄妹妹。我会记得的，你也别忘了哦。不过，也许我们该等到新月的时候……免得银月塞勒涅以为我们故意不带她。"
    }
    {
      Id = "MelinoeField_4100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "哈哈哈，好喔。"
    }
    {
      Id = "MelinoeField_4101"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我想送你最后一瓶仙酒，当然指的是在一切尘埃落定前的最后一瓶啦。不过{#Emph}这一瓶{#Prev}是送给你的宁芙朋友们，而不是送给你的。"
    }
    {
      Id = "Artemis_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦！是我讲的关于卡利斯托的那些故事引起了你的兴趣吗，墨利诺厄？我一向乐于分享啦，而且我知道她也一样。"
    }
    {
      Id = "MelinoeField_4102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}不是！{#Prev}我是想说，我不是那个意思，只是……如果她们跟你关系亲近，有帮助你振作起来，那我对她们也很感激。她们现在一定很担心你。"
    }
    {
      Id = "Artemis_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "可不是么，也不知道担心个什么劲，我跟她们说过不知道多少遍别担心了。不过，谢谢你哦，真的。下次有机会我就去把这件礼物送给她们，连带着你的赞美一起。但是，你得先答应我一件事。"
    }
    {
      Id = "MelinoeField_4103"
      InheritFrom = "BaseNarrative"
      DisplayName = "我送了你好几瓶仙酒你还不知足，还要我再答应你一件事？好啦，你说吧，是什么事？"
    }
    {
      Id = "Artemis_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "你能在地表待得住一段时间，所以……有机会的话，来林中和我们聚一聚吧。也不用很急，等这一切都过去再说。我只是觉得，你应该会很享受的。"
    }
    {
      Id = "MelinoeField_4104"
      InheritFrom = "BaseNarrative"
      DisplayName = "……好啊。我答应你，等这一切都过去，我会去跟你的宁芙朋友们在林中聚一聚，而且会很享受这个过程。"
    }
    {
      Id = "Artemis_0398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一言为定。"
    }
    {
