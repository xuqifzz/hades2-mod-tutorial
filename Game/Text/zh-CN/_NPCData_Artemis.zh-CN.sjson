    }
    {
      Id = "Artemis_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这个给你。"
    }
    {
      Id = "Artemis_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "好久不见呀，妹妹。看看你神气十足的样子，已经开始你的大狩猎了啊！虽然条件不算理想，但是总算是有所行动了。记住，全家人都会支持你的，虽然他们现在对此还很震惊。"
    }
    {
      Id = "Melinoe_1179"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近奥林匹斯山上和冥界都意外连连呢，他们大概也习惯了。很高兴见到你，阿尔忒弥斯。不过，我得继续赶路了。毕竟，时间是我们的敌人。"
    }
    {
      Id = "Artemis_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "要我说{#Emph}时间{#Prev}就是个老糊涂，忙着围攻我们的山头，没有意识到现在他自己成了猎物。去吧，消灭他。"
    }
    {
      Id = "Artemis_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎呦，你看起来糟透了，妹妹。我没有能为你包扎的东西，但我可以帮你向那些卑劣之徒报仇！"
    }
    {
      Id = "Artemis_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "你几乎都要站不稳了，妹妹。咱们就省点说话的力气，专心应对接下来的挑战吧。至少，走一步算一步。"
    }
    {
      Id = "Artemis_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "抱歉，我没能把他们全拦下来。要不是必须轻装上阵，我真想多带一些医疗补给。"
    }
    {
      Id = "Artemis_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，今夜真的事事不顺。但还是得全力以赴，迎接下一个夜晚！或者将{#Emph}今夜{#Prev}的形势逆转。"
    }
    {
      Id = "Artemis_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "也不知道我弟弟迄今为止的表现，配不配得上他光芒万丈的名号？至少他做好了他该做的事。我把你的事情一跟他说，果不其然，他就急匆匆地去告诉其他人啦。"
    }
    {
      Id = "Melinoe_1180"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗人很好。不过，你对他肯定更了解，毕竟你俩才是亲姐弟嘛。话说回来，你跟他具体都说了什么？"
    }
    {
      Id = "Artemis_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "只是告诉了他真相而已！我就说我在侦察敌情的时候，撞见了深居简出的岔路女巫……然后她就把她暗中训练的某位{#Emph}泰坦杀手{#Prev}介绍给我了。"
    }
    {
      Id = "Melinoe_1181"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你没跟他们说，这其实是很久之前的事啦。那现在他们真的觉得这个失散多年的亲戚能找到克洛诺斯，然后把他除掉么？"
    }
    {
      Id = "Artemis_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，他们觉得你一点机会都没有啦！但他们也没辙了，所以就只能支持你咯，更何况你还是家人呢。当然，你也知道，{#Emph}我{#Prev}也会一如既往支持你的。"
    }
    {
      Id = "Artemis_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，你是怎么在{#Emph}这里{#Prev}拿到雅典娜的祝福的？她可以说在世界的另一头呢，而且她忙得要死，也没空用祝福传递消息……"
    }
    {
      Id = "MelinoeField_4119"
      InheritFrom = "BaseNarrative"
      DisplayName = "我戴着她的蛇发妖护符。也许总是这样麻烦她有点没礼貌，但只要戴着这枚护符，她就可以从天而降，把当时正在和我交战的那些倒霉的敌人杀个片甲不留。"
    }
    {
      Id = "Artemis_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，没错。她确实很喜欢戏剧性登场，而且估计她也不介意时不时提醒你一下，她的力量有多么强大。说到这个，让我也提醒一下你，{#Emph}我的力量{#Prev}也毫不逊色。"
    }
    {
      Id = "Artemis_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "你打败了赫卡忒耶！她亲口跟我承认的，而且我敢说她眼里满是骄傲呢！不过，她还是执意要继续考验你吗？"
    }
    {
      Id = "Melinoe_1192"
      InheritFrom = "BaseNarrative"
      DisplayName = "她总是说，我连她都打不过的话，就更不可能打败克洛诺斯了。所以我们每次都会切磋。我觉得她一定是有意让着我，为我加油打气而已。"
    }
    {
      Id = "Artemis_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "照你这么说，她一定是给你打的气还不够多。{#Emph}让着你{#Prev}？别多想了，岔路女巫可从来没有让过任何人。"
    }
    {
      Id = "Artemis_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "在狩猎时，我常常可以仰仗银月塞勒涅的光芒作为指引。但你要去的地方，她不能跟你去，对么？我也不能。"
    }
    {
      Id = "Melinoe_1184"
      InheritFrom = "BaseNarrative"
      DisplayName = "而赫卡忒老师得留在三岔路口。银月姊妹之中，只有我有权进入冥府……如果我到得了那里的话。"
    }
    {
      Id = "Artemis_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "喂，什么叫“如果你到得了”啦？在我眼里你一定会成功的，只是快慢的问题啦。事实上，我觉得，说不定就{#Emph}快了{#Prev}呢。"
    }
    {
      Id = "Artemis_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "在狩猎时，我常常可以仰仗银月塞勒涅的光芒作为指引。但你要去的地方，她很难跟你去，对么？我也不能。"
    }
    {
      Id = "MelinoeField_2138"
      InheritFrom = "BaseNarrative"
      DisplayName = "塞勒涅有她自己的办法，但我知道那对她来说很困难。至于老师，她得留在三岔路口。只有我有权进入冥府。但没有你们的话，我一定永远到不了哪里。"
    }
    {
      Id = "Artemis_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "这种事情{#Emph}真的{#Prev}该组个狩猎团队才好！还好我们银月姊妹早就习惯这样了，毕竟我们一直都尽量避免在同一时间出现在同一地点。"
    }
    {
      Id = "Artemis_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯终于联系到你了，是吧？听起来奥林匹斯山的近况真的不容乐观。还好我不在那边！"
    }
    {
      Id = "Melinoe_1185"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯，别这样说嘛！那里可是你家呀。我得看看我有没有办法上去支援他们。"
    }
    {
      Id = "Artemis_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "你身上带着冥界的血脉，真的能前往地表吗？不过话又说回来，你是个{#Emph}女巫{#Prev}嘛！没什么是你们的魔法解决不了的！"
    }
    {
      Id = "MelinoeField_2141"
      InheritFrom = "BaseNarrative"
      DisplayName = "你今夜没有见到涅墨西斯吧？不是说她应该出现在这里啦，她应该在三岔路口的出入口站岗才对。"
    }
    {
      Id = "Artemis_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "是啦，我没见到她。不过我在追踪她呢！她那些脚印那么深，几乎跟她{#Emph}本人{#Prev}一样好认。她不该出来外面的，是吧……"
    }
    {
      Id = "MelinoeField_2142"
      InheritFrom = "BaseNarrative"
      DisplayName = "……确实。不过我也理解她，她只是想尽自己的一份力而已。而且命运三女神也知道，我大概需要她的帮助。不过，说起来，你们俩最近还好么？"
    }
    {
      Id = "Artemis_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们两个都需要彼此的陪伴，也都需要独处的空间，和以前一样啦。她最近心烦意乱的，所以很难说每次见到她会是什么情况。总之，她是个大女孩啦！"
    }
    {
      Id = "MelinoeField_3371"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，阿尔忒弥斯，如果我和涅墨西斯……变得更亲近一些的话，会不会不太好？我是指{#Emph}对你来说{#Prev}。要是你介意的话，跟我说一声就好。反正估计也不会有什么结果啦……"
    }
    {
      Id = "Artemis_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "怎么啦，你以为我和赫卡忒一样吗？不用事事都征求我同意的。何况涅墨西斯又不属于我，虽然我不是没有考虑过{#Emph}俘获{#Prev}她啦。认真说的话，祝你“狩猎”愉快哦。"
    }
    {
      Id = "Artemis_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以涅墨西斯最近怎么样，她还好么？看起来她那些固执的行动，终于是有些进展了。"
    }
    {
      Id = "MelinoeField_4116"
      InheritFrom = "BaseNarrative"
      DisplayName = "噢，她挺好的，比之前好啦。我和她见得更加频繁了，就……总之是好事。比这再好的话，恐怕就要遭报应了。"
    }
    {
      Id = "Artemis_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "真好！她确实看起来脚步轻快了些，不过当然也没有{#Emph}过于{#Prev}轻快啦。改天你一定得跟我讲讲，你是怎么让她卸下心防的。"
    }
    {
      Id = "Artemis_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，摩罗斯本尊出现在三岔路口，真的是因为你主动{#Emph}召唤{#Prev}了他吗？就是说，你真的字面意思上{#Emph}招来了毁灭{#Prev}……？"
    }
    {
      Id = "MelinoeField_2019"
      InheritFrom = "BaseNarrative"
      DisplayName = "你这么形容的话，听起来好像确实不是什么明智之举。克洛诺斯曾经因为命运三女神的预言而落败；我觉得她们也许会愿意再次伸出援手。"
    }
    {
      Id = "Artemis_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "而她们伸出援手的方式，则是派代表着不幸和意外恶果的化身去到你们那里。好吧，如果这真是命运三女神的安排的话，那你肯定需要{#Emph}这个{#Prev}。"
    }
    {
      Id = "Artemis_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你是{#Emph}真的{#Prev}能听懂卡戎在咕哝什么，还是说你都是装的……就像野兽有时候出于自卫会虚张声势，让自己看起来块头更大一样？"
    }
    {
      Id = "MelinoeField_3370"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}阿尔忒弥斯！{#Prev}我没办法精确地解释每个音节，但卡戎大人跟亡魂相处了很长时间，他们的交流方式真的没有很大的区别。{#Emph}你{#Prev}还能跟{#Emph}野兽{#Prev}交谈呢！"
    }
    {
      Id = "Artemis_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "也是啦，只不过……野兽本来就没有多少要说的嘛！除了猫。总之，跟摆渡人聊天估计比跟我认识的某些神明聊天还要愉快一些。"
    }
    {
      Id = "Artemis_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我很不愿意这样开口，但是……你在你父亲的冥府里，有找到扎格列欧斯的任何踪迹么？"
    }
    {
      Id = "MelinoeField_3369"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯，我……很难说。我的哥哥不在那里，但是……我能感受到他的存在，感受到我们之间的牵绊。他没有离开这个世界。"
    }
    {
      Id = "Artemis_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "我想，就目前而言，这个消息对我来说已经足够好了。不过，情况比我想象得还要{#Emph}费解{#Prev}得多！好吧，不管他现在在哪……但愿他好好的，而且不是孤身一人。"
    }
    {
      Id = "Artemis_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以关于命运三女神的消息是真的，克洛诺斯抓住她们了？他一定是受够那些所谓的“机运”了。也不知道命运三女神有没有预言过自己会被抓……？"
    }
    {
      Id = "MelinoeField_2139"
      InheritFrom = "BaseNarrative"
      DisplayName = "这件事情很严肃啦！如果命运三女神都没办法阻止克洛诺斯的话，就意味着我们的任务只会更加艰巨！更何况我们自己也要受到“机运”的影响。"
    }
    {
      Id = "Artemis_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "那又怎么了！你知道的，就连{#Emph}我{#Prev}也没办法百发百中。失手了怎么办？{#Emph}那就再来一次。{#Prev}况且，技艺越精熟，留给“机运”发挥的空间就越小。"
    }
    {
      Id = "Artemis_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "很奇怪，不是么？他是我们的爷爷……啊，我是在说克洛诺斯。但我对他完全没有任何感情！我只想要他快点消失。"
    }
    {
      Id = "Melinoe_1191"
      InheritFrom = "BaseNarrative"
      DisplayName = "不管他是我们的什么人，他都是个威胁。我们是银月姊妹。我们会{#Emph}使他{#Prev}消失的。为了整个世界。"
    }
    {
      Id = "Artemis_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "也就是说在你眼里，这只是公事公办咯？但就算这样，非得由{#Emph}我们{#Prev}来收拾上一代人的烂摊子，也真是可笑。"
    }
    {
      Id = "Artemis_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "听说你一路杀到了冥府啊。拥有命运注定的通往冥界最深处的神权，一定很方便……当然，克洛诺斯肯定不这么认为。"
    }
    {
      Id = "MelinoeField_2136"
      InheritFrom = "BaseNarrative"
      DisplayName = "看得出他烦死我了。他抡着有两个我那么高的镰刀就朝我杀过来，还召唤来许多狂暴的萨提尔信众做替死鬼。当初你的父亲、我的父亲和其他几位神明联手才把他消灭，一点都不令人惊讶。"
    }
    {
      Id = "Artemis_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "没必要拿你自己和他们做对比啦。他们是天界和冥界至高无上的领主没错，但他们是受于形势所迫才与克洛诺斯战斗的。而你这一生都在为此做准备。"
    }
    {
      Id = "Artemis_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "你找到了克洛诺斯……刺穿了他的咽喉。赫卡忒跟我大致说过啦。所以你是怎么做到的……？找到了他的要害，然后加以利用，是这样么？"
    }
    {
      Id = "MelinoeField_2137"
      InheritFrom = "BaseNarrative"
      DisplayName = "我主要只是靠闪来闪去啦。他非常强大，但一定是低估了我抵挡他招式的能力。"
    }
    {
      Id = "Artemis_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "不过，他不会一直这样低估你。他一定有他的弱点。{#Emph}“年老不代表更睿智，而且还往往代表更衰弱。”{#Prev}对吧？现在他已经在流血了……乘胜追击，将他一举消灭。"
    }
    {
      Id = "Artemis_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "你很接近了，是么？距离彻底消灭克洛诺斯这一目标。我知道就算是和我，你也不能透露细节，不过……要是我说错了的话，你会跟我说的。"
    }
    {
      Id = "MelinoeField_4111"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，要是那样的话，我会跟你说的。现在，我真的不想这么快就告别，但我还有事情亟需解决。"
    }
    {
      Id = "Artemis_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就快去解决吧，妹妹。祝你脚步轻盈、箭无虚发。"
    }
    {
      Id = "Artemis_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "见到赫拉克勒斯在这边横冲直撞了么？虽然我一般来说不会轻易怀疑别人，但他……我真的不好说。我看他不顺眼已经有段时间了。面对野兽，他从不手下留情。"
    }
    {
      Id = "MelinoeField_4110"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯，你可是{#Emph}狩猎{#Prev}女神。野兽比起怕他，肯定更怕你吧。"
    }
    {
      Id = "Artemis_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "说什么呢，妹妹。野兽们{#Emph}最喜欢{#Prev}我了，除了它们该寿终正寝的时候。但赫拉克勒斯会为了一己之私而杀害它们。总之在他身边当心点，好么？"
    }
    {
      Id = "Artemis_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "你看到了，我们面对的是普罗米修斯。他的标志性能力就是知道未来会发生什么……大概会让狩猎他的过程变得有些困难吧。"
    }
    {
      Id = "MelinoeField_2449"
      InheritFrom = "BaseNarrative"
      DisplayName = "先见泰坦，为时间泰坦而战……也许只是想报复曾经惩罚过他的众神吧。他或许有自己的理由，但他挡了我的路。"
    }
    {
      Id = "Artemis_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思我再明白不过了。可是，如果他真的知道未来的话，难道他不该站在赢的那一边吗……？妹妹，对待那个家伙还是小心为妙……"
    }
    {
      Id = "Artemis_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "我来这里也有些不好的地方，比如没办法隔着这么远一箭射穿普罗米修斯的胸膛。阿波罗说他相当不好对付。"
    }
    {
      Id = "MelinoeField_3365"
      InheritFrom = "BaseNarrative"
      DisplayName = "他是个麻烦，也是个威胁……哪怕他现在手无寸铁，而且似乎不在巅峰状态，因为他身上还有旧伤未愈。他的怒火弥补了所有这些缺点。"
    }
    {
      Id = "Artemis_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "好极了，又来了个愤怒的泰坦。嗯，如果他一直{#Emph}怒火中烧{#Prev}的话，一定会更容易犯错。毕竟，这也不是他第一次犯下错误了。"
    }
    {
      Id = "MelinoeField_3366"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该不相信普罗米修斯的能预见未来吧？他很可能只是像你一样有着敏锐的直觉。"
    }
    {
      Id = "Artemis_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}你说什么？{#Prev}没人的直觉能像{#Emph}我{#Prev}一样敏锐，妹妹！不过我也没有说过自己能{#Emph}精准地{#Prev}预测未来。就算我真有那个本事，估计也会更希望事物能留有悬念吧。"
    }
    {
      Id = "Artemis_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "我听说，我们在奥林匹斯山遇到的困难比预想得还大。“最大的恐惧成为现实”啦，之类的。真没想到，提丰的体型那么庞大，我都没有追踪到他……"
    }
    {
      Id = "MelinoeField_3367"
      InheritFrom = "BaseNarrative"
      DisplayName = "你忙着追踪克洛诺斯呢……以及可能还要分出精力来追踪我。但是，如果这样说能宽慰到你的话，现在要想找到提丰应该很容易了！不过要想把他打倒……没那么容易。"
    }
    {
      Id = "Artemis_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "我相信你。我爸爸太爱面子了，根本不愿意把我叫回去巩固防御。说什么这里更需要我。要是他真的这么想亲自对付提丰的话，那就如他所愿吧。"
    }
    {
      Id = "Artemis_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯打败了提丰……？一定是得到了{#Emph}你{#Prev}的援助，可能还有银月塞勒涅的。这样看来，也许那里真的不需要我嘛。"
    }
    {
      Id = "MelinoeField_3368"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们把那个魔物击退了，但我感觉还没有把他打到放弃。至少，暂时还没有。不过，我有几个想法……"
    }
    {
      Id = "Artemis_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你的想法和{#Emph}一箭{#Prev}射穿他的眼睛有关，记得跟我说一声。听说他有{#Emph}好多{#Prev}眼睛……今夜，愿月光引你回家。"
    }
    {
      Id = "Artemis_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "我是来向你道谢的；多亏了你，我们的森林和山岳现在脱离了被怪物踩扁或是被触手侵蚀的风险，真是太好了。"
    }
    {
      Id = "MelinoeField_4114"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，随时乐意效劳。换做是我，也不会喜欢被怪物一脚踩扁的。当时宙斯大人和赫拉大人好像还有个应急预案，但是听起来很不妙。"
    }
    {
      Id = "Artemis_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "真到那一步，我们的森林和山岳还{#Emph}不如{#Prev}被踩扁呢。你的处理方式让我爸和我后妈受了点惊吓……毕竟现在不死之身也能被消灭了，对吧？不过他们对你心存敬畏也是好事。这样他们才会给你好脸色！"
    }
    {
      Id = "MelinoeField_2131"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，为什么奥林匹斯众神会派你来到这么远的地方？我还以为你早已经回去了呢。随时欢迎你来三岔路口做客哦！"
    }
    {
      Id = "Artemis_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢啦，妹妹，我确实一会儿就得回去报告了。至于我在这么遥远的地方的原因嘛，主要是窥探你的进展呀！奥林匹斯众神总想知道得越多越好。"
    }
    {
      Id = "MelinoeField_2132"
      InheritFrom = "BaseNarrative"
      DisplayName = "想必是这样没错。你有没有跟他们说漏嘴过？到现在其他的神一定对你和赫尔墨斯有所怀疑了吧。"
    }
    {
      Id = "Artemis_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "我觉得，得看你具体问的是谁了，不过他们大多数都只是认为我和赫尔墨斯年轻浮躁，没什么责任心而已。但是我们已经是最好的人选了。"
    }
    {
      Id = "Artemis_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "当我成为银月姊妹的一员时，我还以为我们只不过是要在暗处潜伏，偶尔汇报而已……现在嘛，简直是我能设想的{#Emph}最差情况{#Prev}！"
    }
    {
      Id = "MelinoeField_2133"
      InheritFrom = "BaseNarrative"
      DisplayName = "你听起来并没有失望，反而还很兴奋呢。你一定知道最终会走到这一步才对。老师又不会平白无故地把我们召集起来，只为了隔三岔五举行什么仪式。"
    }
    {
      Id = "Artemis_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，你说得对。不过，我们已经在一起等待了这么久……以至于我都以为，我们不会等来出手的时机了呢。没想到一转眼时机就来了！"
    }
    {
      Id = "Artemis_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，你现在有动物伙伴了！本来你也有机会见到我的伙伴，只可惜它们都不想在活着的时候进入冥界……除了这些鸟儿，它们好像不怎么在意。"
    }
    {
      Id = "MelinoeField_3328"
      InheritFrom = "BaseNarrative"
      DisplayName = "那它们不想去埃费拉城，想必是还有别的借口了？你这些伙伴也真是的，任由你一个人在外面闯荡。"
    }
    {
      Id = "Artemis_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "哈！它们基本上跟我们都差不多啦，只不过通常更安静一些。替我好好照顾你的伙伴们哦，好么？"
    }
    {
      Id = "Artemis_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "之前在三岔路口待了一会儿，很有帮助。我的手更稳了，心情也平复了。在家里，我找不到真正的宁静……但在林中，我能找到。"
    }
    {
      Id = "MelinoeField_3362"
      InheritFrom = "BaseNarrative"
      DisplayName = "估计在家里也找不到练习唱歌的地方吧。你真的那么担心被阿波罗听到么？他总不会唱得比你好{#Emph}很多{#Prev}吧！而且他很可能会为你骄傲呢。"
    }
    {
      Id = "Artemis_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "要我说，他只会一个劲地戏弄我……很可能会烦得我受不了，朝他射一箭，然后惹出一大堆麻烦来。我可没打算冒那样的风险，妹妹。"
    }
    {
      Id = "Artemis_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "到现在你已经尝试过我所有新的祝福啦。我还在构思其他的祝福，不过最近怎么想都定不下来具体的效果！不过，估计你也更喜欢亲自体验过、觉得比较好用的那些啦。"
    }
    {
      Id = "MelinoeField_3329"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯姐姐，你的祝福，哪一个我都很乐意接受！为我的招式多加一些精准度，往往就会有天壤之别。"
    }
    {
      Id = "Artemis_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我也不是只有{#Emph}精准度{#Prev}能拿得出手啦，是吧？我们这些神明，总是被简化成只有一个长处的形象。宙斯父王和他的闪电，波塞冬伯伯和他的海浪，阿波罗和他的……{#Emph}头发{#Prev}。"
    }
    {
      Id = "Melinoe_1186"
      InheritFrom = "BaseNarrative"
      DisplayName = "你离开家这么远，已经待了这么久了。你不会想念奥林匹斯山么？如果说现在的奥林匹斯山不值得怀念的话，那……在泰坦的围攻之前呢？"
    }
    {
      Id = "Artemis_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "什么，你是问我怀不怀念跟我爸、我后妈，还有我那个完美无瑕的双胞胎弟弟一起生活的日子？我愿意向他们伸出援手，可不意味着我愿意再回去跟他们住在一起啊。"
    }
    {
      Id = "Artemis_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以你怎么看我们那些家人？话说回来，他们大多都被困在奥林匹斯山上，不过……你也见识过他们的样子了。"
    }
    {
      Id = "Melinoe_2340"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，他们也没有那么糟糕啦！尤其是考虑到现在的情况。不过你好像受不了他们中的任何一个……"
    }
    {
      Id = "Artemis_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，没有{#Emph}那么{#Prev}夸张啦！不过，你说得没错，他们有的时候是会烦到我。等这一切都结束之后，他们可是欠我们一大笔人情呢。"
    }
    {
      Id = "Melinoe_1189"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以说，你不在帮助一次又一次失败的我的时候，最近都在做些什么呢，阿尔忒弥斯？是有什么特殊的猎物吗？"
    }
    {
      Id = "Artemis_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许可以说有。奥林匹斯山在震颤，但没人知道原因。银月塞勒涅委托我调查这件事。一定不会是什么大事，对吧？"
    }
    {
      Id = "Artemis_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些暗灵真是可怜，弥留在这里，哪都去不了。他们本来可以在至福乐土享受闲暇时光，或者再不济，在水仙花平原呆着也比在这里强。他们这么大怨气，也算情有可原。"
    }
    {
      Id = "MelinoeField_2134"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯还声称，把冥界的大门打开，让亡者四处游荡，是他“大发慈悲”呢。现在这副景象，怎么可能比我父亲统治时更好。"
    }
    {
      Id = "Artemis_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，至少这意味着我涉足那些地方的时候，不会引发什么巨大的领地争端了！不过话又说回来，这整件事好像就是场“巨大的领地争端”。"
    }
    {
      Id = "Artemis_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "总算是全解决了！和厄瑞玻斯相比，这里能藏身的地方少多了。恐怕再往深处走我就帮不到你了……毕竟，我是个猎手，不是渔民。"
    }
    {
      Id = "MelinoeField_2140"
      InheritFrom = "BaseNarrative"
      DisplayName = "捕鱼也是狩猎的一种，不是么？话说回来，我很感谢你的支援，也理解你没办法跟我一起前往更深处啦。奥林匹斯大概还等着你回去汇报呢。"
    }
    {
      Id = "Artemis_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，那是当然！不仅要汇报整体的情况，还要汇报关于你的事。你知道吗，他们还把我和赫尔墨斯当作他们派来窥视你们的眼线呢！不过，我们确实会跟他们说很多事啦……"
    }
    {
      Id = "Artemis_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "银月塞勒涅说，你最近在地表走了一遭啊。怎么样，地表有像你梦中一样美好吗？"
    }
    {
      Id = "Melinoe_2339"
      InheritFrom = "BaseNarrative"
      DisplayName = "我经常做噩梦，所以也许确实可以说是像我梦中一样“美好”吧。那里的亡者都在苦苦徘徊，无处可去。他们本来应该在冥界安居才对！"
    }
    {
      Id = "Artemis_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，克洛诺斯显然是对冥界的统治方式有着不一样的见解。我知道你主要的目标潜伏在地底，不过……谢谢你能为地表提供的一切援助。"
    }
    {
      Id = "Artemis_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "地表旅行就这样告一段落了，是吗？完全没有在上面见到你的踪迹呢！也别太难过啦。你们这里也有很不错的树林！"
    }
    {
      Id = "MelinoeField_2135"
      InheritFrom = "BaseNarrative"
      DisplayName = "我被禁止前往那里……在那里几乎喘不上气来。但也许我可以找到什么办法。如果不是事态严重，赫尔墨斯也不会请求我动身的。"
    }
    {
      Id = "Artemis_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我想也是。如果可以的话，我真想护送你前往奥林匹斯山，但众神希望我不要被你们发现。至于别太勉强自己这种话，大概我说了你也不会听啦……"
    }
    {
      Id = "Artemis_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "多让人意想不到啊，妹妹！你哥曾经说服了我们所有人，让我们以为他一路过关斩将，是要到我们奥林匹斯山上来。现在一想到你真的要这样做，我们反而都觉得难以置信了。"
    }
    {
      Id = "MelinoeField_2020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认识赫尔墨斯的时间几乎和认识你的时间差不多，而他求我帮忙的次数屈指可数。何况偶尔换换风景也不错嘛。"
    }
    {
      Id = "Artemis_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就请自便咯！说来真的很奇怪，现在你一个劲往我们山上跑，我却一个劲儿往你们冥界里钻。至少这样我们经常能打上照面！"
    }
    {
      Id = "MelinoeField_2020_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "要不是事态严重的话，赫尔墨斯一定不会请求我来帮忙。何况偶尔换换风景也不错嘛。"
    }
    {
      Id = "Artemis_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "那个壮硕的独眼巨人波吕斐摩斯……上一次我看到他躺在地上，正呼呼大睡呢！你可以趁那种时候悄无声息地摸过去，把他解决掉嘛！我自己总是会呆在下风口，避免和他交手。"
    }
    {
      Id = "MelinoeField_2145"
      InheritFrom = "BaseNarrative"
      DisplayName = "我很想故作轻松地笑一笑，阿尔忒弥斯，但是我得承认，我面对那个独眼巨人的情形跟“悄无声息”没什么关系。不过，至少现在我可以越过他的阻拦了。"
    }
    {
      Id = "Artemis_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "那你又打算怎么在港口之后通过那条裂谷呢，难道要{#Emph}游过去{#Prev}吗？你还是和以前一样，喜欢怎么困难怎么来。不过也许困难的办法就是{#Emph}唯一{#Prev}的办法吧！"
    }
    {
      Id = "Artemis_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该已经知道{#Emph}厄里斯{#Prev}最近在奥林匹斯山附近到处乱飞的事情了吧？一般来说，父王宙斯召来一道天雷，就能解决这种麻烦，但是……他最近忙得不可开交。"
    }
    {
      Id = "MelinoeField_2143"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有天雷的话，也许一支箭也可以？要是某个夜晚厄里斯在天上被人射下来的话，那会为我们省很多麻烦。"
    }
    {
      Id = "Artemis_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "我又何尝不想呢，可惜父王总是坚持说，局面{#Emph}完全在他掌控之中{#Prev}。他说别处更需要我，离这里很远的地方。但如果真让我看见纷争化身的那双翅膀……我一定会把她从空中击落。"
    }
    {
      Id = "Artemis_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的双刃用起来怎么样？需不需要我给你一些……呃……{#Emph}“箭”{#Prev}议？"
    }
    {
      Id = "Melinoe_1190"
      InheritFrom = "BaseNarrative"
      DisplayName = "姊妹双刃招式成双成对，就像是每场战斗都有你陪伴左右一样。不过，飞刃肯定没有你的箭射程远……"
    }
    {
      Id = "Artemis_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哦{#Prev}，别对自己这么苛刻啦，没人比我更善射了！尤其是阿波罗，他跟我比差远啦。嗯，瞄准敌人的要害就好，你一定没问题的。"
    }
    {
      Id = "Artemis_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，我认得这对利刃！之前我还不太情愿把她们让出来呢，但是……现在你大概也知道为什么啦。你一定要善待她们哦！"
    }
    {
      Id = "MelinoeField_2144"
      InheritFrom = "BaseNarrative"
      DisplayName = "别担心，我一定会的，我发誓！所以，你之前亲自使用过姊妹双刃？你是因为我才被迫让出她们的吗……？"
    }
    {
      Id = "Artemis_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "我让出她们，是因为我完成了需要我做的事情。赫卡忒真的很喜欢她的小小试炼。总之，我很高兴看到利姆欧罗的使用者后继有人啦。"
    }
    {
      Id = "Artemis_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "说来奇怪……我跟银月塞勒涅合作那么密切，但从来没能熟练掌握她的巫咒。不像{#Emph}你{#Prev}。"
    }
    {
      Id = "MelinoeField_4117"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也不像你，我对弓箭一窍不通。肯定是涅墨西斯干的，确保我们没人能占到所有好处。"
    }
    {
      Id = "Artemis_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "呵，马上你就又要多占点好处了呢。来，给你点额外的月亮魔法，感谢你一直以来的付出，以及未来将要做出的的努力。以备不时之需啦。"
    }
    {
      Id = "Artemis_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们银月姊妹是暗夜武器的守护者。姊妹双刃利姆欧罗在你手中效力于黑夜的意志，但她们的能力还不止于此。"
    }
    {
      Id = "MelinoeField_3401"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的吗？我在听。我要怎么做？"
    }
    {
      Id = "Artemis_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "在银辉之池，用这道咒语唤醒双刃：{#Emph}“我见你映出三重暗影，伴魅影女王左右。”{#Prev}我觉得现在的你已经准备好了。应该会很好用的！"
    }
    {
      Id = "MelinoeField_3402"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}“我见你映出三重暗影，伴魅影女王左右。”{#Prev}一道唤醒咒语……谢了，阿尔忒弥斯，这是我的荣幸。你知道这是谁的形态吗？"
    }
    {
      Id = "Artemis_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，没什么特别的啦，只是另一个三相合一的暗影女神，就像赫卡忒，但是来自别的时空。我还是不多说了，很快你就能亲眼见到了。"
    }
    {
      Id = "Artemis_0255_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "这是姊妹双刃……那这一定就是摩莉甘形态了。看起来跟你很搭嘛！也许我们这些跟黑夜啦、月亮呀能扯上关系的女神，真的都大同小异呢。"
    }
    {
      Id = "MelinoeField_3497"
      InheritFrom = "BaseNarrative"
      DisplayName = "你是说你自己从来没有机会用过这个形态吗？那你是怎么知道这道唤醒咒语的？"
    }
    {
      Id = "Artemis_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "第二个问题无可奉告哦，墨利诺厄。不过，你说得没错，那个形态并不是供我使用的。也许未来某个夜晚，你也会有机会教给我什么隐秘的知识呢！"
    }
    {
      Id = "Artemis_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，曾经我给过扎格列欧斯一道属于他的唤醒咒语，用来揭示继母曾经用过的一把弓的隐藏形态，那把弓名叫科罗纳赫特。他的箭术很了得呢！"
    }
    {
      Id = "MelinoeField_4120"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，真的么？那你觉得他还有哪些方面比我强，阿尔忒弥斯？更有魅力这点是肯定的。他的冲刺有我快吗？"
    }
    {
      Id = "Artemis_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "那当然了，比你{#Emph}快得多{#Prev}。总之，我是想说，很高兴亲眼目睹了你们俩变得越来越强的过程，也很高兴能帮忙唤醒冥府兵器和暗夜武器啦。"
    }
    {
      Id = "Artemis_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "看来你带上了雪白鹿角，以防万一是吧！给出这根角的牡鹿当时已经要寿终正寝了。而且我对他发誓，我不会让他感受到一丝痛苦的。现在他的暗灵和我还经常会交流呢！"
    }
    {
      Id = "MelinoeField_2146"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿尔忒弥斯，你的故事真的很能让人的心灵感到温暖，同时思绪感到不安。万一你哪天想要放弃狩猎、干点别的，可以考虑一下往这方面发展呢。"
    }
    {
      Id = "Artemis_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果这一切都成不了的话，我是想着去{#Emph}唱唱歌{#Prev}、{#Prev}搞搞音乐{#Emph}之类的啦。阿波罗都可以，我也肯定没问题。不过目前我还没有厌倦猎手的生活哦。"
    }
    {
      Id = "Artemis_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴那根鹿角派上了用场。继续培养和它的感情，说不定贡献出那根鹿角的鹿都要被你复活了！又或者你能接我的班，成为新的猎神呢。"
    }
    {
      Id = "MelinoeField_4109"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，我没有那样的打算啦……我只是沉迷于反复击打敌人的脆弱部位，无法自拔而已。而且不知道为什么，你的鹿角很有帮助！"
    }
    {
      Id = "Artemis_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "不知道为什么？因为我们之间的纽带啊，而那根鹿角就是联系所在。也别太得意忘形啦，我的大多数攻击都是在敌人看不见的地方发起的，而你就没那么害羞了。"
    }
    {
      Id = "Artemis_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜空气中有股独特的{#Emph}寒意{#Prev}。刚才我几乎都要{#Emph}累出汗{#Prev}了！虽然主要是那些敌人的原因啦。我觉得我知道是怎么回事，墨利诺厄，但我还是想问：到底是{#Emph}怎么回事？"
    }
    {
      Id = "MelinoeField_3363"
      InheritFrom = "BaseNarrative"
      DisplayName = "是黑夜的誓言。恐惧和黑暗将会蔓延……虽然看起来不会对我们有直接的好处，但暗夜武器会因此变得更强；整个冥界也是如此。"
    }
    {
      Id = "Artemis_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样呀！{#Emph}效力于暗影之下，复归于暗影之中。{#Prev}奥林匹斯还以为这是克洛诺斯的阴谋呢。我有我的猜测，但是……还是想确认一下为好。"
    }
    {
      Id = "Artemis_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "我今晚赶来的路上遇到的麻烦比平时多。又是黑夜的誓言么？倪克斯本尊一定会很欣赏你的行为，散播{#Emph}恐惧{#Prev}，制造{#Emph}梦魇{#Prev}……"
    }
    {
      Id = "MelinoeField_3364"
      InheritFrom = "BaseNarrative"
      DisplayName = "恐惧会带来尊敬和服从。等这一切结束，也许未来想要篡夺任何一个界域的人，都会因此心生迟疑。"
    }
    {
      Id = "Artemis_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹妹，你刚才那番话都有你爸爸的风格了。好啦，那我们就去给敌人带去更多的恐惧吧，怎么样？"
    }
    {
      Id = "Artemis_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "一轮满月……银月塞勒涅的力量达到了顶峰。在这样的夜晚，我真的能感受到自己不死不灭的神性。希望我们合力足以度过难关。"
    }
    {
      Id = "Melinoe_1193"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，阿尔忒弥斯，一切都好吗？"
    }
    {
      Id = "Artemis_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有好多想对你说的话，但实在没有时间了，妹妹。有别的地方需要我，我只是想确保自己能送你出发。"
    }
    {
      Id = "Melinoe_1182"
      InheritFrom = "BaseNarrative"
      DisplayName = "你应该已经听说了，我没能抵达目的地，阿尔忒弥斯。差得远呢。"
    }
    {
      Id = "Artemis_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹妹，我对你有{#Emph}十足{#Prev}的信心，但就算是{#Emph}我{#Prev}也不觉得你第一次就能得手，杀死克洛诺斯。咱们把期望放实际一点，好吗？"
    }
    {
      Id = "Melinoe_1055"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的调查有什么进展吗？"
    }
    {
      Id = "Artemis_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "进展很少，比我期望的差远了。来吧，让我为你加把劲。也许这样你就不会像我一样一筹莫展啦。"
    }
    {
      Id = "Artemis_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "妹妹，我们有多少夜没见了？唉，我知道现实就是这样啦，你也忙，我也忙，大家都忙着，然后……就这样了。"
    }
    {
      Id = "MelinoeField_2450"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们行动的路线肯定交错过许多次，只是没有碰上面。我感觉自从我们上次像这样见面之后，又发生了好多事。该从哪里说起呢？"
    }
    {
      Id = "Artemis_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，不用跟我说啦，我虽然没见到你，但我仍然有跟进你的进展哦。你最近的成果，奥林匹斯山全都知道了！我的意思是，你不介意分享的那些，他们都知道啦。"
    }
    {
      Id = "Artemis_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们真是个好团队，不是么？就算{#Emph}没有{#Prev}赫卡忒和塞勒涅的支持也一样。真可惜我们绝大多数时间都得分头行动。"
    }
    {
      Id = "MelinoeField_4092"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们确实有不止一个界域需要守护。不过你说得对，真的很高兴最近能跟你合作。以及跟你一起唱歌。以及跟你建立友谊。"
    }
    {
      Id = "Artemis_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，别来多愁善感这一套啦，妹妹。这是我们的工作。虽然我们身处的这个世界最近惨兮兮的，但是至少工作上很愉快。"
    }
    {
      Id = "Artemis_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "嘿，看看我从某个空心的树桩底下掏出什么来了！这层厚厚的积灰下，就是你当初让我藏起来的那瓶仙酒，我们现在就来把它消灭掉吧。"
    }
    {
      Id = "MelinoeField_4105"
      InheritFrom = "BaseNarrative"
      DisplayName = "等等，{#Emph}现在{#Prev}吗？为什么不留到三岔路口呢？至少在那里，我们身上不会沾着敌人的尸骸……"
    }
    {
      Id = "Artemis_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "那是你，我用的是弓，我{#Emph}干净{#Prev}着呢！不过，没错，就现在。因为如果我们一直等待最完美的时机，只怕永远也等不到。更重要的是，你完成了任务，而我们都还没怎么庆祝呢！"
    }
    {
      Id = "MelinoeField_4106"
      InheritFrom = "BaseNarrative"
      DisplayName = "而且现在{#Emph}确实{#Prev}是新月。你说服我了，那好，咱们就来小酌一杯吧。我们敬什么呢？"
    }
    {
      Id = "Artemis_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "敬银月姊妹……要我和其他几名女神一起藏身黑暗之中的话，我可选不出更好的伙伴。"
    }
    {
      Id = "Artemis_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "呼！真不错，而且居然没人趁机偷偷把我们的工作做了。那我们就只好回去继续工作咯？"
    }
    {
      Id = "Artemis_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "你做到了，或者我该说，{#Emph}任务{#Prev}终于完成了。但是，你又马不停蹄地开始工作了！"
    }
    {
      Id = "MelinoeField_4112"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，嗯……就当是我的习惯吧，而且我也想借此机会看看外面现在是什么情况。以及，谢谢你，阿尔忒弥斯。银月姊妹飞越天际的旅程，我是不会忘记的。"
    }
    {
      Id = "Artemis_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿波罗就{#Emph}非得{#Prev}跟着，不过我也不会很快忘记的啦。好久没有感受过那样一场大胜的喜悦了。等等，我们为什么还要继续战斗来着？"
    }
    {
      Id = "MelinoeField_4113"
      InheritFrom = "BaseNarrative"
      DisplayName = "据说我们面对的威胁还有残迹，要把它们统统消灭。所以，我和以前一样，还需要你的帮助。"
    }
    {
      Id = "Artemis_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的意思是我们可以接着做{#Emph}这种{#Prev}事，而且还有数不清的活靶子给我练手？{#Emph}好嘛！"
    }
    {
      Id = "Artemis_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "家里的情况比我想象得要好。看到我们还得对付泰坦军队的残部，多少有点奇怪，但我爸终于不像之前那样，动不动就发脾气了。"
    }
    {
      Id = "MelinoeField_4115"
      InheritFrom = "BaseNarrative"
      DisplayName = "那就太好了，而且我也很高兴你有机会亲眼回去看一看。所以，这是不是意味着，我在这里不会那么频繁见到你了？他们肯定想让你回去。"
    }
    {
      Id = "Artemis_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "唔，偷偷跟你说，他们还是想让我来盯着你，毕竟你是个强大的女巫。不过，我是得时不时回去汇报啦，但也不是什么大事。他们见到我很开心，听到你的消息也很开心，而且……我还能跟宁芙们打个招呼！"
    }
    {
      Id = "Artemis_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "山上所有人都在说命运三女神终于现身了的事。要不是她们，我爸都不会掌权，所以她们消失的这段时间里，我爸肯定急得够呛……"
    }
    {
      Id = "MelinoeField_4118"
      InheritFrom = "BaseNarrative"
      DisplayName = "但现在命运三女神说，众神的影响力将会一定程度上衰退。恐怕叔父宙斯听到这个，也不会太开心吧。"
    }
    {
      Id = "Artemis_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "确实，但就主要预言来说，这个其实还不错啦。而且，听起来她们口中这个新时代，一时半会儿还不会来临，所以……到时候再说也无妨！"
    }
    {
      Id = "Artemis_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "干净利落，妹妹，我就喜欢这样。我这边没什么好汇报的，看起来你那边进展也很顺利。那就，继续行动吧？"
    }
    {
      Id = "Artemis_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "拿上这个，妹妹，然后去找到你的猎物。"
    }
    {
      Id = "Artemis_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你脚步永远轻盈，攻击永远精准，妹妹。"
    }
    {
      Id = "Artemis_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "我正好路过，所以就来看看你。"
    }
    {
      Id = "Artemis_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿明月引你找到猎物，然后暴露他所有的弱点。"
    }
    {
      Id = "Artemis_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "又一个夜晚，又一次履行银月姊妹的职责。"
    }
    {
      Id = "Artemis_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，这片林地不是我的最爱……"
    }
    {
      Id = "Artemis_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "我没办法陪你继续向下深入，但我可以给你这个。"
    }
    {
      Id = "Artemis_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "聪明的猎手都懂得“技多不压身”的道理。"
    }
    {
      Id = "Artemis_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "稳住，妹妹。你有我的支持，而且远不止我的支持。"
    }
    {
      Id = "Artemis_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你百发百中。像我一样！"
    }
    {
      Id = "Artemis_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还是觉得你哪天应该再试试弓箭……"
    }
    {
      Id = "Artemis_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都是独行的猎手。但偶尔撞见彼此也不错嘛！"
    }
    {
      Id = "Artemis_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "和你合作总是很愉快，妹妹。"
    }
    {
      Id = "Artemis_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "替我把那个卑鄙的泰坦大卸八块，好么？"
    }
    {
      Id = "Artemis_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你追寻猎物的路上畅通无阻。"
    }
    {
      Id = "Artemis_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜很适合狩猎泰坦，不觉得么？"
    }
    {
      Id = "Artemis_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "我嗅到了几条漏网之鱼，一会儿我去把他们收拾了……"
    }
    {
      Id = "Artemis_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "你会找到你的猎物的。我相信你。"
    }
    {
      Id = "Artemis_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "你狩猎的是最为危险的猎物。我都有点嫉妒你了！"
    }
    {
      Id = "Artemis_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个配合你的女巫技艺一定好用。"
    }
    {
      Id = "Artemis_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会为你守好身后，妹妹，所以你就放心地前进吧。"
    }
    {
      Id = "Artemis_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是银月姊妹；我们势在必得。"
    }
    {
      Id = "Artemis_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是银月姊妹，这是我们闪耀的时刻。"
    }
    {
      Id = "Artemis_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，这样逃离世俗的纷扰还蛮惬意的。"
    }
    {
      Id = "Artemis_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "没想到又见到你了，而且是在这种地方！"
    }
    {
      Id = "Artemis_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "实话说，这次是你追踪到了我！"
    }
    {
      Id = "Artemis_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "你就是为此而生的，妹妹。你一定会成功。"
    }
    {
      Id = "Artemis_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "就这么说吧，这样的生活比起在山顶上呆着好太多了。"
    }
    {
      Id = "Artemis_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "又是一个月圆之夜。愿我们的力量相结合，能帮你走得更远。"
    }
    {
      Id = "Artemis_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "新月昭示着新的开端，妹妹。鼓起勇气。"
    }
    {
      Id = "Artemis_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "月亮的光辉再一次衰弱，但你的力量不会因此动摇。"
    }
    {
      Id = "Artemis_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "弦月渐满，我们的潜力也愈发高涨，妹妹。"
    }
    {
      Id = "Artemis_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "祝你上山的过程中狩猎愉快，妹妹。"
    }
    {
      Id = "Artemis_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "你为我们做了那么多，我爸最好是有对你表达感谢。"
    }
    {
      Id = "Artemis_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢你帮我们对付提丰，这样我们就不用去对付他了！"
    }
    {
      Id = "Artemis_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "我会帮你掩盖踪迹，不过先选一个吧，路上用得着。"
    }
    {
      Id = "Artemis_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "下次多给我留几个，好么？"
    }
    {
      Id = "Artemis_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "干净利落，妹妹，我就喜欢这样。"
    }
    {
      Id = "Artemis_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "来，给你点额外的月亮魔法，感谢你一直以来的付出，以及未来将要做出的努力。"
    }
    {
      Id = "Artemis_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "附近安全。"
    }
    {
      Id = "Artemis_0321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "找到什么了吗？"
    }
    {
      Id = "Artemis_0322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好眼力。"
    }
    {
      Id = "Artemis_0323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又找到炼金材料了？"
    }
    {
      Id = "Artemis_0324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "用在炼金釜里的吗？"
    }
    {
      Id = "Artemis_0325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我先看到的。"
    }
    {
      Id = "Artemis_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "专心，妹妹！"
    }
    {
      Id = "Artemis_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "别分神，妹妹！"
    }
    {
      Id = "Artemis_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这个不能等等吗？"
    }
    {
      Id = "Artemis_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "快回来战斗呀！"
    }
    {
      Id = "Artemis_0318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在？{#Emph}真的吗？"
    }
    {
      Id = "Artemis_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我来掩护你！"
    }
    {
      Id = "Artemis_0371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这些怎么样？"
