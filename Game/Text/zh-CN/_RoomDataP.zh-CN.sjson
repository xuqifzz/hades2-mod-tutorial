  lang = "zh-CN"
  Texts = [
    {
      Id = "Storyteller_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}巍峨的奥林匹斯山半埋在皑皑白雪之中；其下掩盖的，是长久围攻所致的累累伤痕。"
    }
    {
      Id = "Melinoe_1113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好美……"
    }
    {
      Id = "Storyteller_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}王女脚下的山峰隆隆作响、震颤不休；地壳起起伏伏、变化莫测，与她父王的领域有异曲同工之妙。"
    }
    {
      Id = "Melinoe_1114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这么一说，还真有家的感觉。"
    }
    {
      Id = "MelinoeField_2455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "奥林匹斯山……"
    }
    {
      Id = "MelinoeField_2456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我到了……"
    }
    {
      Id = "MelinoeField_2457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "走了这么远……"
    }
    {
      Id = "Melinoe_1463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里好冷……"
    }
    {
      Id = "Melinoe_1464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于……"
    }
    {
      Id = "MelinoeField_2458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "现在该爬山了……"
    }
    {
      Id = "Storyteller_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在这高耸入云之地，冥界的摆渡人显然不宜公开露面。然而，他的货物仍在此陈列，令人百思不得其解；或许是由某些匿踪遁形的盟友带来这里的吧。"
    }
    {
      Id = "MelinoeField_2828"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……真的很感谢这些盟友。"
    }
    {
      Id = "MelinoeField_2513"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少这里很安静……"
    }
    {
      Id = "Storyteller_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}奥林匹斯山那巍峨的山顶，从这个角度看去本应雄伟无比；然而此时一堵无比黑暗的风暴之墙将它裹挟其中，看起来是凶多吉少。"
    }
    {
      Id = "MelinoeField_2526"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一场风暴将要来临……"
    }
    {
      Id = "Heracles_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是她……"
    }
    {
      Id = "Prometheus_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……我跟你说过的吧？"
    }
    {
      Id = "Heracles_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她来了。"
    }
    {
      Id = "Heracles_0371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "女巫。"
    }
    {
      Id = "Heracles_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他预料到了。"
    }
    {
      Id = "Heracles_0365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "被他说中了……"
    }
    {
      Id = "Heracles_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯？"
    }
    {
      Id = "Heracles_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们不是才刚见过么？"
    }
    {
      Id = "Heracles_0373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又见面了。"
    }
    {
      Id = "Heracles_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "她受伤了……"
    }
    {
      Id = "Prometheus_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "站住。"
    }
    {
      Id = "Prometheus_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "停。"
    }
    {
      Id = "Prometheus_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "是你。"
    }
    {
      Id = "Prometheus_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就知道。"
    }
    {
      Id = "Prometheus_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我就知道！"
    }
    {
      Id = "Prometheus_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我们的猎物来了。"
    }
    {
      Id = "Prometheus_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "先听我一言？"
    }
    {
      Id = "Prometheus_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "众神……"
    }
    {
      Id = "Prometheus_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我的预感。"
    }
    {
      Id = "Prometheus_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "又见面了。"
    }
    {
      Id = "Prometheus_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我想你也该出现了。"
    }
    {
      Id = "Prometheus_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，没错……"
    }
    {
      Id = "Prometheus_0494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不出所料……"
    }
    {
      Id = "Prometheus_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一路上爬得顺利么？"
    }
    {
      Id = "Prometheus_0497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还没受够么？"
    }
    {
      Id = "Prometheus_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "变革的使者……"
    }
    {
      Id = "Prometheus_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是想不到啊。"
    }
    {
      Id = "Prometheus_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "夜夜如此。"
    }
    {
      Id = "Prometheus_0490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "都到齐了。"
    }
    {
      Id = "Prometheus_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "跟你说过了，大块头。"
    }
    {
      Id = "Prometheus_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看到了吧，大块头？"
    }
    {
      Id = "Prometheus_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看那边，兄弟。"
    }
    {
      Id = "Prometheus_0491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "打个招呼吧，赫拉克勒斯。"
    }
    {
      Id = "Heracles_0367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "行。"
    }
    {
      Id = "Heracles_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你就得瑟吧。"
    }
    {
      Id = "Heracles_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "嗯。"
    }
    {
      Id = "Heracles_0103_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不要。"
    }
    {
      Id = "MelinoeField_2514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "普罗米修斯。"
    }
    {
      Id = "MelinoeField_2515"
      InheritFrom = "BaseSubtitle"
      DisplayName = "泰坦。"
    }
    {
      Id = "MelinoeField_2516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "出乎意料么？"
    }
    {
      Id = "MelinoeField_2517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "猜猜是谁来了。"
    }
    {
      Id = "Storyteller_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}先见泰坦和他的老鹰伙伴现在无迹可寻，只有孤零零的一根羽毛留在了原地，仿佛在用激将之法，诱使王女继续向上攀登。"
    }
    {
      Id = "MelinoeField_2826"
      InheritFrom = "BaseSubtitle"
      DisplayName = "老鹰别再回来就好……"
    }
    {
      Id = "Storyteller_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}哪怕是这座山正中央的火炉喷射出的高温火焰，也无法彻底驱散空气中的寒冷气息；这场即将来临的风暴并非由神明造成——幕后黑手，另有其人。"
    }
    {
      Id = "MelinoeField_2825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……这个另有其人，他友好吗？"
    }
    {
      Id = "Storyteller_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}看起来，这位曾违抗奥林匹斯之王的、洞察入微的泰坦，与奥林匹斯之王最为魁梧、最为令人闻风丧胆的儿子，如今正团结一致，并肩作战……"
    }
    {
      Id = "MelinoeField_3618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看起来确实是这样。"
    }
    {
      Id = "Storyteller_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}这片圣洁的山脉本应只属于众神，或许再最多算上众神的信徒；然而现在，他们昔日的盟友与最苦大仇深的死敌在此聚首，对他们统治天地的神权图谋不轨。"
    }
    {
      Id = "MelinoeField_3658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他们在酝酿什么样的阴谋……？"
    }
    {
      Id = "Storyteller_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在奥林匹斯山的连天烽火之外，有条孤独的小径通往顶峰，在那里矗立着一座要塞，哪怕是最为强壮的神明或是泰坦，都无法将它摧垮。"
    }
    {
      Id = "MelinoeField_3250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "而在那之后，就是宙斯的圣殿……"
    }
    {
      Id = "MelinoeField_2512"
      InheritFrom = "BaseSubtitle"
      DisplayName = "山顶就在前面……"
    }
    {
      Id = "MelinoeField_2683"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看起来自动机不想和我做朋友……"
    }
    {
      Id = "Storyteller_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}奥林匹斯之战战况胶着；山上的机械卫士与泰坦的军队杀得昏天黑地，让整个天界都为之震颤。"
    }
    {
      Id = "MelinoeField_2824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "整个世界都在为之颤栗……"
    }
    {
      Id = "Storyteller_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}在重重围困的奥林匹斯山上，有一方净土免于战火侵扰；它仿佛在邀请冥界王女，在此稍作歇息，恢复一些气力，尽管这可能是杯水车薪。"
    }
    {
      Id = "MelinoeField_2529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不能在这休息太久……"
    }
    {
      Id = "MelinoeField_2510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这里是在干什么……？"
    }
    {
      Id = "MelinoeField_2511"
      InheritFrom = "BaseSubtitle"
      DisplayName = "还在狂欢……"
    }
    {
      Id = "Storyteller_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}饱受战火摧残的奥林匹斯山上，所剩无几的欢乐似乎都聚集在了这里；这场宴会的东道主乃是酒神迪奥尼索司，受到宴请的则都是最受他青睐的狂欢者。"
    }
    {
      Id = "MelinoeField_2525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "至少这些萨提尔没打算把我开膛破肚……"
    }
    {
      Id = "Storyteller_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}令人闻风丧胆的塔罗斯，奥林匹斯山上最为强力的自动机，伟大的赫菲斯托斯的杰作，有着不胜枚举的防御性能，其中一项便是缓慢的自我修复……"
    }
    {
      Id = "MelinoeField_2528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "塔罗斯下次一定能意识到，这一切都是一场误会吧……"
    }
    {
      Id = "Storyteller_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}神山地势险要，要打包围战绝非易事；因此狡猾的时间泰坦找到了会飞的野兽，用花言巧语收买了它们，让它们从天而降，搅得奥林匹斯山不得安宁。"
    }
    {
      Id = "MelinoeField_2827"
      InheritFrom = "BaseSubtitle"
      DisplayName = "看起来它们把这当自己家了……"
    }
  ]
