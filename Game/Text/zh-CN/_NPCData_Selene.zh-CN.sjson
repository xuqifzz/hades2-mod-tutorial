  lang = "zh-CN"
  Texts = [
    {
      Id = "Selene_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，小星！在月相的这一阶段，我在夜空中无需现身，因此可以稍事休息。所以我们可以多交谈一阵子，哪怕谈话会让我的光芒变得暗淡也无须顾忌。你的任务进展如何？"
    }
    {
      Id = "Melinoe_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "伟大的塞勒涅，能在这里见到你是我的荣幸。我觉得现在任务正在按计划进展，不过你也一定知道，还有很多工作尚待完成。感谢你一直在夜空中照看着我。"
    }
    {
      Id = "Selene_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "也感谢你赐予了我这样的机会。我有“夜之眼”的称号，而在我看来，你如今已然成为了“夜之剑”。我得先告辞了；愿我们在黑夜的笼罩下再次相会。"
    }
    {
      Id = "Melinoe_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再会了。"
    }
    {
      Id = "Selene_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "再次见到你令我很是欣慰，赫卡忒。我观察到，奥林匹斯山上的僵局如今依然悬而未决，但泰坦仍在埃费拉城屯兵备战。需要我继续监视那里的局势么？"
    }
    {
      Id = "Hecate_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "是的，塞勒涅，继续观察。如今沦陷的埃费拉城是这里在地表最近的出口。倘若我们派出一人长驱直入，你觉得敌人的防御工事足以将其拒之门外吗？"
    }
    {
      Id = "Selene_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦的兵力如今调度混乱。因此，我的答案是否定的；我觉得他们的防御工事，无法阻拦我们其中一人长驱直入。但我会继续密切关注，确保万无一失。现在，我必须告辞了。我们一同闪耀。"
    }
    {
      Id = "Hecate_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再会。我们一同闪耀。"
    }
    {
      Id = "Selene_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "我已归返，在这黑暗而安全的寓所歇息。很快，我将再次驰骋天际。"
    }
    {
      Id = "Selene_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的循环很快将再次开始，但目前，我必须稍事休息。"
    }
    {
      Id = "Selene_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若做不到张弛有度，我们的力量便永远无法达到顶峰。"
    }
    {
      Id = "Selene_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "又一个循环已然完成，此时宜思量得失，准备迎接下一个循环。"
    }
    {
      Id = "Selene_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这三岔路口之中，我的力量会快速恢复，很快便能再度高悬夜空。"
    }
    {
      Id = "Nyx_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "……我忠诚的夜之眼，我的孩子，谢谢你捍卫了我们界域的安全，并在天际为其守望。我自始至终都知道，你不会辜负我的期望。"
    }
    {
      Id = "Selene_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "可是，母亲，要是我们的守望更加尽责，这一切都不会发生……"
    }
    {
      Id = "Nyx_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "困顿的时代总会到来，考验我们的决心。这样一来，我们才能成长，我们之间的纽带亦是如此。哪怕现在，我也能感应到你与冥界王女之间强力的联系。"
    }
    {
      Id = "MelinoeField_5170"
      InheritFrom = "BaseNarrative"
      DisplayName = "能与银月塞勒涅共事是我的荣幸，尊敬的倪克斯。她一直是我的指路明光。您与她能再次相见，令我非常欣慰。"
    }
    {
      Id = "Nyx_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们之所以能够团聚，都是因为你，以及赫卡忒和所有匿踪者的不懈努力。你们对冥界的付出将会被铭记，尊敬的墨利诺厄王女。现在，去吧……还有更多的团聚在等着你。"
    }
    {
      Id = "Selene_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "谢谢您，母亲，那我便先告辞了。"
    }
    {
      Id = "Nyx_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "命里有时终须有。现在，去吧，每当你行经夜空中的黑暗时，记住，我永远与你同在。"
    }
    {
      Id = "MelinoeField_5171"
      InheritFrom = "BaseNarrative"
      DisplayName = "不得不说，我从没想过我们能引你来到这么深的地底，银月塞勒涅。我还以为就算像老师这样经验丰富的人，也做不到这样的事呢！"
    }
    {
      Id = "Selene_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "小星，准备好了我们便动身吧，免得逗留太久，不合时宜。我很荣幸能亲眼见到冥府的厅堂，并与你一同遁入阴影；带着胜利的喜悦，而非仓促的焦急。"
    }
    {
      Id = "HecateField_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "来吧，墨利诺厄，塞勒涅说得都在理。此外，我们还要送某人一程。"
    }
    {
      Id = "MelinoeField_3903"
      InheritFrom = "BaseNarrative"
      DisplayName = "（叹气）那就出发吧。要是阿尔忒弥斯在这里就好了，那样的话银月姊妹就可以真正团聚了，不是么？"
    }
    {
      Id = "Selene_0377"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我们便启程，驶入黑暗的苍穹。"
    }
    {
      Id = "Selene_0378"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……以及，出发之时，务必扶稳。"
    }
    {
      Id = "Nyx_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见。"
    }
    {
      Id = "Persephone_0013"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！！"
    }
    {
      Id = "Zagreus_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "后会有期！"
    }
    {
      Id = "Hades_0214_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见，女儿。"
    }
    {
      Id = "Melinoe_1881"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你的光芒永不黯淡。"
    }
    {
      Id = "Melinoe_1882"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿明月指引……{#Emph}呃。{#Prev}抱歉。说习惯了。"
    }
    {
      Id = "Selene_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "永远不会的。"
    }
    {
      Id = "Selene_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯。"
    }
    {
      Id = "Selene_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "永远如此。"
    }
    {
      Id = "Selene_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "向你致意。"
    }
    {
      Id = "Selene_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿黑暗指引你。"
    }
    {
      Id = "Selene_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "永远如此。"
    }
    {
      Id = "Selene_0136"
