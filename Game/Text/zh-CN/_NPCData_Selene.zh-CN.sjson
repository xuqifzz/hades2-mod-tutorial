      DisplayName = "乐意之至。"
    }
    {
      Id = "Selene_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "克洛诺斯必死无疑。"
    }
    {
      Id = "Selene_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "继续闪耀吧。"
    }
    {
      Id = "Selene_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "为了银月姊妹。"
    }
    {
      Id = "Selene_0489"
