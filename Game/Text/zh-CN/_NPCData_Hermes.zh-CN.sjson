  lang = "zh-CN"
  Texts = [
    {
      Id = "Hermes_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "拜托，墨……"
    }
    {
      Id = "Hermes_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不行哦！"
    }
    {
      Id = "Hermes_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "不可以哦。"
    }
    {
      Id = "Hermes_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "近况如何，你好吗？我很好。还算好！很高兴看到你任务开始啦，但是计划有变。虽然这个请求可能有点过分，但是：你最近有空到奥林匹斯山来一趟吗？"
    }
    {
      Id = "MelinoeField_2003"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯大人，稍等一下，你说{#Emph}到奥林匹斯山去{#Prev}是什么意思？我的任务是在冥界阻止克洛诺斯。地表的空气本身就会让我几乎无法呼吸，登上山顶就更不可能了！"
    }
    {
      Id = "Hermes_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "拜托，墨！你肯定有办法啦！爷爷在这里有什么阴谋，比他平常的进攻更糟，所以你就考虑一下啦。不严重的话，我也不会开口的，对吧？好了，得撤了，你也一样。我会用祝福传话的！"
    }
    {
      Id = "Hermes_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见啦！"
    }
    {
      Id = "MelinoeField_2004"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
    {
      Id = "Hermes_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "你一路跑到山顶了，真是个好消息！坏消息是提丰。 你大概已经碰上他了？像座山一样大的怪物，带着一群怪物后裔？"
    }
    {
      Id = "MelinoeField_2967"
      InheritFrom = "BaseNarrative"
      DisplayName = "这场风暴，这场……侵略。这样说来，这都是提丰的所作所为？他是怎么来到这里的？我们要怎么阻止他？"
    }
    {
      Id = "Hermes_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也答不上来，墨，我只知道都是爷爷干的，都在他的计划之中。其他人在爸爸的宫殿里可以撑住一会儿，但他们需要你的帮助。我得赶紧跟你老师汇报去！"
    }
    {
      Id = "Hermes_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一路顺风！"
    }
    {
      Id = "MelinoeField_2968"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你也是……"
    }
    {
      Id = "Hermes_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有种辜负了你的感觉，墨。我原本的任务是弄清楚爷爷的阴谋，但我不够快。所以你现在要直面提丰了！"
    }
    {
      Id = "MelinoeField_3174"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯大人，等到一切尘埃落定，我们会复盘哪一步可以走得更好的。但目前来说，当务之急是解决当下的危机，而不是执着于过去。"
    }
    {
      Id = "Hermes_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "我知道。你说得对。只是我刚刚才想明白爷爷环环相扣的计划：先是抓住命运三女神，让她们不能{#Emph}给他添乱{#Prev}，然后再唤醒提丰，让他{#Emph}给我们添乱{#Prev}……！再然后就是统治一切。"
    }
    {
      Id = "MelinoeField_3175"
      InheritFrom = "BaseNarrative"
      DisplayName = "你没有得知所有细节，但一早就发现了克洛诺斯有个大计划。要不是你的当机立断，我现在就不会站在这里，我们也不会有这样的机会。"
    }
    {
      Id = "Hermes_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "比起机会我更喜欢必然，墨！不过，你说得有道理耶。我们都是在形势所迫下尽力而为。"
    }
    {
      Id = "Hermes_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回头见！"
    }
    {
      Id = "MelinoeField_3032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "回头见。"
    }
    {
      Id = "Hermes_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "你上次让提丰尝到了点苦头，但他还是一副怒不可遏的样子。你或者你老师不能做些什么，让他彻底蒸发吗？"
    }
    {
      Id = "MelinoeField_4214"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果{#Emph}让他彻底蒸发{#Prev}指的是让他的毕生经历在无数眼睛前闪过，最终将他置于死地的话，能。我们已经在研究了。但这得花些时间。"
    }
    {
      Id = "Hermes_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "喔，太好了！如果一件事情不花时间的话，就不能做得更快了。既然如此，那我就不耽误你们的研究了，回头见，墨！"
    }
    {
      Id = "MelinoeField_3031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "保重！"
    }
    {
      Id = "Hermes_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "等一下，提丰到底死了没有？一点他的迹象都没有了，但爷爷搞出来了这些时间口袋，一钻进去，就好像提丰从来没消失过一样！"
    }
    {
      Id = "MelinoeField_4220"
      InheritFrom = "BaseNarrative"
      DisplayName = "差不多是这么回事，不过……你怎么会在{#Emph}这里？{#Prev}我不知道爷爷还会派其他人过来。你知道怎么回去吗？"
    }
    {
      Id = "Hermes_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "我跑得够快，我能回得去！爷爷还告诉了其他人怎么把我们弄出来，而且我们也盯着他呢。我最好四处看看！"
    }
    {
      Id = "MelinoeField_4221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "要小心啊！"
    }
    {
      Id = "Hermes_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "不用为我爸爸的宫殿过于担心，墨！老提丰很大很强壮，但他没法摧毁他看不到的东西！唔，至少摧毁起来不像他看得到的东西那样容易！"
    }
    {
      Id = "MelinoeField_3178"
      InheritFrom = "BaseNarrative"
      DisplayName = "听起来不是很让人安心啊。所以叔父宙斯和其他人是把他们的圣殿隐藏了起来，让提丰把怒火倾泻到这座要塞之上么？"
    }
    {
      Id = "Hermes_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "没错，差不多吧！他们觉得如果我们不得不跟提丰打的话——确实如此——那在这里迎战最合适不过了！毕竟，这里离山顶还有一大段路。但是我们{#Emph}很快{#Prev}就能赶过来！"
    }
    {
      Id = "Hermes_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "所以，觉得我爸的圣殿怎么样？你终于亲眼见到它的辉煌了，墨！重大成就耶，尤其是考虑到你本来都没法到地表来。"
    }
    {
      Id = "MelinoeField_4216"
      InheritFrom = "BaseNarrative"
      DisplayName = "宙斯的圣殿和我之前见过的任何地方都不一样……那里很美，但也很亮。我不知道你们是怎么在那么亮的地方住下的。不过我住的地方，对你们一定也很难想象吧。"
    }
    {
      Id = "Hermes_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "嗯，我其实挺喜欢暗一点的，不过我在冥界呆的时间，比他们加起来都长！至于圣殿，至少它能在这些纷争之中保护我们的安全。"
    }
    {
      Id = "MelinoeField_4217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那就让我们确保这点。"
    }
    {
      Id = "Hermes_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "真可惜我爸的宫殿暂时关闭了，说是加强戒备什么的。你不介意的，对吧？要是你问我的话，没必要在那逗留啦。"
    }
    {
      Id = "MelinoeField_4218"
      InheritFrom = "BaseNarrative"
      DisplayName = "……嗯。跟你实话说，我一点都不介意。我可以通过祝福跟天神、王后，以及其他人保持联络，而且现在这样意味着，在顺利的夜晚，我可以早一点回家了。"
    }
    {
      Id = "Hermes_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "哎，跟我想得一样嘛！你越早干掉趴在那扇巨门后面的魔物，就能越早回去，准备干掉{#Emph}下一个{#Prev}！"
    }
    {
      Id = "MelinoeField_4219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那么，该动身了。"
    }
    {
      Id = "MelinoeField_4224"
      InheritFrom = "BaseNarrative"
      DisplayName = "现在冥界不再由泰坦统治了，你和卡戎最近过得怎么样？"
    }
    {
      Id = "Hermes_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，好极了！意思就是，没什么变化。只要冥界没有重新开业，他就没办法回去运暗灵。"
    }
    {
      Id = "MelinoeField_4225"
      InheritFrom = "BaseNarrative"
      DisplayName = "按我的理解，这应该还需要一些时间。我父亲要将一切变动都一丝不苟地记录在册，而且他担心欲速则不达，希望等到万事俱备之后再重新对外开放。"
    }
    {
      Id = "Hermes_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "墨，实话说，你说完“欲速则不达”我就没在听了。只要你父亲知道，他需要人手的时候，随时有人愿意帮忙就好。"
    }
    {
      Id = "MelinoeField_4226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "必要的话，我会提醒他的！"
    }
    {
      Id = "Hermes_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "好了，墨，来都来了，我就不耽误你了，毕竟你有重要的事情做。我只是来看看你是不是完完整整的！"
    }
    {
      Id = "MelinoeField_3179"
      InheritFrom = "BaseNarrative"
      DisplayName = "目前还是完完整整的，赫尔墨斯大人，不过后面的事我没法保证。谁知道呢？不过话说回来，也许提丰会把我砸扁，而不是把我撕成碎片呢。"
    }
    {
      Id = "Hermes_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，好黑暗喔。不过你知道有什么一样黑暗吗？就是我们现在的处境啦。我的意思是，{#Emph}看看{#Prev}这个地方！所以我们都赶紧离开吧，好不？"
    }
    {
      Id = "Hermes_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "你从我的神龛订购的东西应该都送到了，免费加急哦！接下来就是最困难的环节了。你觉得你准备充分了吗，墨？"
    }
    {
      Id = "MelinoeField_3176"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果不是有你，我肯定不会准备得这么充分。谢谢你在这里等我。奥林匹斯众神知道你在做这些事吗？"
    }
    {
      Id = "Hermes_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "他们知道我送物资去了！反正我们都是一边的，对吧？他们现在手忙脚乱的，我就没必要把细节都一五一十告诉他们啦。"
    }
    {
      Id = "Hermes_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "走咯！"
    }
    {
      Id = "MelinoeField_3030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "再见！"
    }
    {
      Id = "Hermes_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "就知道能指望上你，墨，不仅是提丰的事，还有我的特殊神龛！你为正义的事业捐赠了好多金币，所以，{#Emph}谢啦！"
    }
    {
      Id = "MelinoeField_4209"
      InheritFrom = "BaseNarrative"
      DisplayName = "说起来，具体是什么事业呢？卡戎大人现在致力于销毁他能找到的所有金币……你该不会是要跟他在同样的事情上竞速吧？"
    }
    {
      Id = "Hermes_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "就当作是两个同事之间的良性竞争吧。他早开始了一点，而且目前还在领先，但多亏了你，我快追上了！"
    }
    {
      Id = "MelinoeField_4210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你可以的！不过他也可以。"
    }
    {
      Id = "MelinoeField_4211"
      InheritFrom = "BaseNarrative"
      DisplayName = "赫尔墨斯大人，趁你在这，我有份礼物想送给你，如果你不介意的话！愿这瓶仙酒让你的步履永远轻盈！"
    }
    {
      Id = "Hermes_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "真的很感谢，墨，但我不能收。我总不能提着个酒瓶子到处跑，无论{#Emph}我{#Prev}或者{#Emph}其他人{#Prev}有多想喝上一口。不过，谢啦！"
    }
    {
      Id = "Hermes_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "呼！墨，我回来了！"
    }
    {
