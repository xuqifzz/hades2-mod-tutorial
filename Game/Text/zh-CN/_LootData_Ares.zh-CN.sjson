  */
  lang = "zh-CN"
  Texts = [
    {
      Id = "MelinoeField_2915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "战士印记……"
    }
    {
      Id = "MelinoeField_2918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "战神……"
    }
    {
      Id = "MelinoeField_2919"
      InheritFrom = "BaseSubtitle"
      DisplayName = "他为暴力而来……"
    }
    {
      Id = "MelinoeField_2920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿瑞斯大人……"
    }
    {
      Id = "Ares_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "请原谅我，血亲，但是父亲大人正在和我讨论一件要紧的事情，恐怕一时抽不开身……我在遥远的大陆旅行时了解到的一些事。"
    }
    {
      Id = "Zeus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，那件事就先放一放吧，阿瑞斯！我们最好先把家门口的事情解决，再去担心远方的世界出了什么岔子！{#Emph}那些事情{#Prev}，我们会有时间解决的。"
    }
    {
      Id = "Ares_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "我实在无意麻烦母后大人，毕竟她的王冠无比沉重；然而她坚持要来，或许是担心我的祝福不够强力吧。果真如此么，母亲？"
    }
    {
      Id = "Hera_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "这就不用你操心了，阿瑞斯，以及在人前的时候，不要叫我{#Emph}母亲{#Prev}。如果连简单的礼仪都做不到，那我还有什么理由相信你的{#Emph}祝福{#Prev}？"
    }
    {
      Id = "Ares_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "波塞冬伯伯在家里最爱指点别人，兴许是以为给出的建议数量越多，质量就越高吧。伯伯，你说说看，我们接下来应该如何行动？"
    }
    {
      Id = "Poseidon_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们接下来应该直入敌营，像飓风摧毁航船一样， 把他们打得七零八落！啊，我现在真想痛痛快快地打一架！说起来，我的好侄儿阿瑞斯在旁边的时候，我就总是这样！"
    }
    {
      Id = "Ares_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "伟大的四季女神如此决绝地投入战事，令我备受鼓舞。私怨越深，战场上的寒意也就越彻骨！不是么，得墨忒尔女士？"
    }
    {
      Id = "Demeter_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "这私怨并非因我而起，阿瑞斯。也许在未来，你有了自己的子孙后代，却眼看他们被人夺走，那时你便能理解我的心情了。不过现在，你无需理解我……只需配合即可。"
    }
    {
      Id = "Ares_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "我同父异母的弟弟阿波罗说，他是我们家族中第一个与你联络的，我的血亲。也许不是他，而是{#Emph}我{#Prev}的话，这档事早就已经画上句号了……"
    }
    {
      Id = "Apollo_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，拜托，阿瑞斯，你从来都对结束冲突不怎么感兴趣。也许这就是你这次姗姗来迟的原因！但你看到大家一副{#Emph}乐在其中{#Prev}的样子，才不得不伸出援手。"
    }
    {
      Id = "Ares_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "爱与恨，我的血亲！这是最强烈的两种情感，亦是战争的底层逻辑。因此，美丽动人的阿弗洛狄忒对我的专业领域产生了兴趣，而我对她也是一样。"
    }
    {
      Id = "Aphrodite_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的关注点和我的兴趣不谋而合，阿瑞斯大人！究竟是什么让人彻底屈服于情感呢？我想知道{#Emph}每一种{#Prev}可能的原因。"
    }
    {
      Id = "Ares_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "奥林匹斯的王和王后亲生的儿子，除了我之外，就只有兢兢业业的赫菲斯托斯了。我一直在对他说，面对当前的挑战，我们应该挺身而出，当仁不让！"
    }
    {
      Id = "Hephaestus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿瑞斯，你想要更多的责任，那就尽管来拿！不然的话我也不知道你在追求什么，而且你看上的我都不想要，除了阿弗洛狄忒。我有我的熔炉，有我的老婆……这就够了。"
    }
    {
      Id = "Ares_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "很高兴看到亲爱的赫斯提亚女士把她的能力用在了更重要的事情上。说起来，她就在这里呢！我一直都知道您有着毁灭的倾向，女神，毕竟战场上总是战火纷飞！"
    }
    {
      Id = "Hestia_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可不太喜欢把这一面展现出来，虽然我看得出你还挺喜欢的，阿瑞斯。依我看，我们要是没办法控制好自己，就更不要说控制好自己的力量了。"
    }
    {
      Id = "MelinoeField_2916"
      InheritFrom = "BaseNarrative"
      DisplayName = "我都开始觉得这位神明永远不会现身了。{#Emph}以哈迪斯之名！奥林匹斯诸神，我在此领受神谕！"
    }
    {
      Id = "Ares_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，又一名研究死亡的学徒！能以如此的热忱与提丰对峙，实在可贵。我的家人坚持要我采取行动，而我也想亲眼见证你的非凡身手，所以，{#Emph}这个{#Prev}你收下……自此之后，你的事业有我助力。"
    }
    {
      Id = "Ares_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的血液殷红，与你兄长一样，而且你今夜已经流了不少血。只可惜我没能早些赶到，否则便能亲眼目睹更多血腥场面。"
    }
    {
      Id = "Ares_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "你怎么伤得如此严重，血亲！当然，在战争中，没人能毫发无伤。愿你能对一切胆敢伤害我们的敌人，施以{#Emph}百倍{#Prev}的报偿。"
    }
    {
      Id = "Ares_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜已经失去了那么多生命；不过我自己不该用这样的词汇。熄灭的生命永远不会{#Emph}失去{#Prev}，而是{#Emph}花费{#Prev}……就比如你这一腔热血，是为了你父亲的冥界而流。"
    }
    {
      Id = "Ares_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的伤势如此之重，哪怕是最强壮的凡人，受了这样的伤也只能束手就擒；但你却仍然能继续战斗，仿佛你毫发无伤那般！也许，你还能从这样的状态下获得刺激？"
    }
    {
      Id = "Ares_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "你前一夜战胜了时间泰坦，我们已经有所耳闻。对此我们都大喜过望，然而我也在暗自思忖：不知他在消散之前，有没有亲身领受到那濒死的痛楚。或许让他反复经受如此折磨，他便会最终罢休。"
    }
    {
      Id = "Ares_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的父辈杀死泰坦克洛诺斯时，我还没有出生……昨夜你亲手消灭克洛诺斯时，我也无法从旁见证。不过我从不缺少对此类事物的想象力。"
    }
    {
      Id = "Ares_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "我先前便想到，今夜有机会在这里找到你。你上次胜利之后，泰坦克洛诺斯想必仍在舔舐伤口；他在地表的军队定是阵脚大乱，让我们在这里有机可乘。"
    }
    {
      Id = "Ares_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "击退众魔之父乃是一件壮举，我的血亲。但战争仍未告捷！这就意味着还有更辉煌的胜利在等待；也许偶尔也会有耻辱的败退。"
    }
    {
      Id = "Ares_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "提丰真是好一个怪物……他行动迟缓，身形庞大，顽固不化地爬向山顶，而驱使他的只有满腔仇恨与愤怒……！在某些方面，我真的很欣赏他。但我也很感谢有你让他希望破灭。"
    }
    {
      Id = "Ares_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "我偏爱一波三折的战争——尤其是当一方使出浑身解数占据上风，却又转头将其拱手让人之时！现在，你占到了上风，我的血亲。好好保持。"
    }
    {
      Id = "Ares_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "在战争中，胜者往往是最为强大，或是最为无情的那方。不过我也有左右战争成败的能力；这份力量我现在便要授之于你。"
    }
    {
      Id = "Ares_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "于你今夜踏上征途之时，我将自始至终与你相伴；如此一来，你便可以了无顾虑，大开杀戒。"
    }
    {
      Id = "Ares_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感应到，你所在的地方很有可能将要发生大规模暴力事件。很快，杀戮便会开始。而你只需要选择完成杀戮的方式。"
    }
    {
      Id = "Ares_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "你最近一次阻止提丰的行动未能如愿，但你仍然令我们的敌人分了神，令我们得以对此加以利用，取得优势。现在该去对付克洛诺斯了，是么？"
    }
    {
      Id = "Ares_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "你脚下的土地一定很松软，而且依我所见，浸染的并不是雨水。想要在这片战火纷飞的大地上旅行的话，就让我来做你的向导吧。"
    }
    {
      Id = "Ares_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "在你抵达我们山脚的战场前，还有好一段路要走；不过，你大可放心，这一路保证能让你杀个痛快！"
    }
    {
      Id = "Ares_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若我没有理解错的话，命运三女神现在被关了起来？我本该为她们的安危忧心，但……也许这就意味着，这场战争终于可以不受外力影响杀个分晓了……！"
    }
    {
      Id = "Ares_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的父亲宙斯大人身经百战，打过的仗、征服过的土地不计其数。然而比起我的建议，他更青睐雅典娜，哪怕她在防守这座山峰时如此力不从心。至少你看得出，唯有{#Emph}进攻{#Prev}才能取得胜利。"
    }
    {
      Id = "Ares_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "我父亲的祝福确实强力无比。这可是能击败提丰的神力！不过在当前的形势下，我们的需求甚至不止于此，而我已经准备好贡献自己的力量。"
    }
    {
      Id = "Ares_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "母后大人向来谨慎，从不偏袒家族中的任何成员，哪怕是她的亲生儿女也不例外。我总是觉得，我看待事物客观公正的品质，便是继承自她。"
    }
    {
      Id = "Ares_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "波塞冬伯伯总是一副自信十足的模样，但我认为他额头上挂着的其实常常是冷汗，而不是海水。亲历战事，确实容易令人惶惶不安。"
    }
    {
      Id = "Ares_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "我同父异母的哥哥阿波罗已经赐予了你祝福，是么？当我追求唯一的志业时，他却朝三暮四，尽去学些华而不实之物，虽说有些杂七杂八的天赋，但到头来却是样样稀松。"
    }
    {
      Id = "Ares_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "得墨忒尔女神让庄稼茁壮成长的能力广为人知……然而，她要想让饥荒蔓延整块大陆，也是同样容易。此种力量，与我的力量正好相得益彰。"
    }
    {
      Id = "Ares_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "你知道么，若不是有美丽的阿弗洛狄忒为你降下祝福，我也不会如此心甘情愿地将我的祝福拱手送出。你得以品鉴我的刀光剑影中的美学，都是拜她所赐。"
    }
    {
      Id = "Ares_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "我可怜的弟弟赫菲斯托斯，一生都在铸造厂中埋头苦干……他打造的武器和盔甲立下了赫赫战功，可他却永远无法亲眼见证。至少他对{#Emph}你{#Prev}有所帮助，我的血亲。"
    }
    {
      Id = "Ares_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "就连避世的赫斯提亚，都为你所激励，加入了这场战斗！她的烈焰居然主要用于点燃凡人的炉灶，真是大材小用。我已经迫不及待想看她发挥全部潜力了！"
    }
    {
      Id = "Ares_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "狩猎女神性情隐秘莫测；我时常想要说服阿尔忒弥斯将她的才能用于战场，而不只局限于山林之间。但她顽固无比，或许你已有所耳闻。"
    }
    {
      Id = "Ares_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "一场成功的军事行动需要精准无误的沟通，而这点我们仍然仰仗捷足的赫尔墨斯。他先一步找到你，乃是意料之中；相信他带给你的，除了最新的消息，还有他的祝福。"
    }
    {
      Id = "Ares_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "在这样的夜晚，唯有塞勒涅的银光战车能为我们提供些许照明。你身上有着她的光辉，我的血亲；相信她隐秘的力量，也正为你所用？"
    }
    {
      Id = "Ares_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "我亲爱的妹妹雅典娜肩负重任，比她身上的盔甲更为沉重。她不仅要想方设法将敌人拒之门外，还要对战事的频频失利负责。相信她的智慧能帮她度过难关。"
    }
    {
      Id = "Ares_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "既然我们的祖父想要战争，那我又有什么理由阻止他呢？我明白这件事情听起来有些讽刺；我只是觉得，我们{#Emph}每个人{#Prev}都可以如愿以偿，也没什么不好。"
    }
    {
      Id = "Ares_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "在泰坦篡夺冥界之前，有位倪克斯女神的女儿常常会对贪得无厌之人降下神罚。她被唤作涅墨西斯，而我对她仰慕有加……或许她近来也在寻找为她的家人报仇的方法吧。"
    }
    {
      Id = "Ares_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "你见过了我母亲名下最健壮的斗士，他名为赫拉克勒斯，以强悍的武艺在凡间闻名于世。他那把巨槌夺走的生命恐怕比你还多！不过，他确实是抢先了一步开始。"
    }
    {
      Id = "Ares_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "女巫美狄亚在为你效力，是么？令她恶名昭彰的瘟疫与毒药，某种程度上会减轻战争发生的可能性，但它们能取得同样的结果，因此我们也需对其保持开放的心态。"
    }
    {
      Id = "Ares_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "我欠令尊许多人情，因为我做的工作越多，他要处理的亡者也就越多。相信伯父也很看重和我的合作吧？现在少了他，一切都不一样了。"
    }
    {
      Id = "Ares_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认识女神倪克斯，我的血亲，而且我对你们冥界及其习俗的了解都是自她而来。她与你的直系血亲关系十分亲近。现在需要一场战争才能赢回他们，倒也正合我意。"
    }
    {
      Id = "Ares_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神倪克斯回到了冥界，我的血亲！虽然战争接近尾声，令我多少有些悲哀，但是能够再一次感受到黑夜化身凌驾于世，让我无比欣慰。这世间怎能少得了她。"
    }
    {
      Id = "Ares_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "你和你的兄长有许多相似之处。他制造死亡的本领可谓炉火纯青，毕竟他自地狱最深处而来！不过，你们也未必相处得来，毕竟我和我的兄弟姐妹也时常吵架斗嘴。"
    }
    {
      Id = "Ares_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "你哥哥扎格列欧斯最近过得不错吧？相信你们一定会相处得非常融洽，因为你们有诸多共同点——比如残忍无情、杀伐果断……！要是我也有这样的兄弟姐妹，那该多好……"
    }
    {
      Id = "Ares_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "你向我们赶来的每一晚，女神厄里斯都会不知疲倦地试图拦住你，我对此有所耳闻。不得不说，这令我有些左右为难，因为纷争对我的工作的助力，比绝大多数人来得都要多。然而我知道，她是无法被控制的。"
    }
    {
      Id = "Ares_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "女神厄里斯在我们这相当不受欢迎；依我所见，在你们那应该也是一样。虽然其他人对她唯恐避之不及，但我对她却有些同情。身为不死不灭的神明，我们无法改变自己的本性；甚至就连毁灭，对我们来说都难以企及。"
    }
    {
      Id = "Ares_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "你与纷争化身之间，有着某种血亲一般的情谊，是么？我起初还以为，你们之间只是不睦而已。现在看来，你看待厄里斯的方式，似乎与我多有相同。我们都是自然之中的一股力量，不是么？"
    }
    {
      Id = "Ares_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦普罗米修斯对战事并不陌生，这点显而易见。比如，他很清楚绝大多数联盟能有多么脆弱。你说，他当初与我们的父辈结盟，会不会只是为了掌握他们的弱点？"
    }
    {
      Id = "Ares_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "我以前一直以为普罗米修斯是个和平主义者，毕竟他违抗父王的意志被抓的时候，只是坦然接受了自己的命运。所以是在那之后，他找到了自己的斗志，是么？有的时候，唯有在痛苦中才能发现真我。"
    }
    {
      Id = "Ares_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "这样说来，你与普罗米修斯是要对抗到底了？他给出了复杂的理由，而我的亲族不情不愿地接受了。至于我嘛，我很乐意看他战斗，仅此而已。"
    }
    {
      Id = "Ares_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "那巨大无比的提丰所带来的威胁远超我的想象，血亲！曾经，父辈们那些抵御众魔之父的事迹，让我好不羡慕……不过现在，我们都能亲眼见证他的嗜血狂怒了！"
    }
    {
      Id = "Ares_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们最近对提丰的战斗自然算不上是场胜利，但在你被迫撤退之后，我们终于得以将他驱离。然而，现在他似乎又在向上爬了……"
    }
    {
      Id = "Ares_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "众魔之父，命丧你手！我起初听到这条消息，几乎无法置信，但父王与母后坚持说这是真的。看来你手中的力量，远比我们那位现已亡故的大敌还要令人恐惧啊。"
    }
    {
      Id = "Ares_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "你抵达这里时，我没有机会与你相见，为此我深感抱歉，我的血亲。当时我需要优先处理一些闯入者。相信我们一定还有机会见面的吧？"
    }
    {
      Id = "Ares_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "位于大地之下的事务，我已经许久未能有幸观察了；当然，仅凭祝福也看不到多少。有些你大开杀戒的黑暗地带，我几乎什么都看不到。"
    }
    {
      Id = "Ares_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的父亲什么时候才会重新开放进入冥界的通道？也许他的界域还没有恢复到能同时接纳这么多新居民的地步。无妨，慢慢来吧。"
    }
    {
      Id = "Ares_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "痛苦与死亡内含如此多的奥秘，我的血亲。你所杀死的每个萨提尔，每个鹰身女妖，他们的牺牲之中，都有值得我们一探究竟之处。而你总是孜孜不倦地对其加以学习；但愿我们能长久学以致用。"
    }
    {
      Id = "Ares_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "今夜空气中渗透着恐惧的气息。敌人们如此狂热，就仿佛女神倪克斯本尊触碰了它们的心智一般。看来这会是一场硬仗！"
    }
    {
      Id = "Ares_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的血亲，你有没有察觉到，今夜的空气中有种恐惧挥之不去？想必你有所察觉；或许你就是那恐惧的根源……毕竟你不仅仅是位来自冥界的女神，你是梦魇女神本尊。"
    }
    {
      Id = "Ares_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "空气中有些异常的端倪……你也注意到了，是么？今夜充满了伟大而古老的可能性。让我们凭借武力，将可能变为必然吧。"
    }
    {
      Id = "Ares_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "我得承认，就算是我们众神，亦会受到我们超出我们认知和掌控的事物的摆布。现在，我便察觉到了这样的影响……让这场战争愈演愈烈，鞭策我们采取行动。"
    }
    {
      Id = "Ares_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "究竟是什么力量，令你刹那之间就能抵达这里？也许有些冥界的神明，就连我们也无法察觉其存在；有些你的盟友，就连我们也没有必要知晓。"
    }
    {
      Id = "Ares_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "你携带的那柄断剑曾经属于一位战士，在他的鲜血最终浸润大地之前，无数敌人都命丧他手。这柄剑别无独特之处，但它久经沙场，让我感觉自己和它有某种联系；或许对你来说也是如此。"
    }
    {
      Id = "Ares_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "我赐予你的断剑之柄如今已跟随你出生入死，历尽无数厮杀，想必它曾经的主人会深感欣慰！至少{#Emph}我{#Prev}深感欣慰，既是因为我能观看到如此精彩的表现，亦是因为我对此颇有助力。"
    }
    {
      Id = "Ares_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感觉到你身上有件来自毁灭本尊的神器！我与摩罗斯大人很有缘分，因为我们的专业领域有不少交集。面对当下的形势，他一定激动不已！"
    }
    {
      Id = "Ares_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "我最近从一场旅途中归来，因为我总有更多的工作要做。令我欣慰的是，这里的事态仍在控制之中；从各个方面来说，都比我离开时大有改进。想必你在其中有不小的功劳？"
    }
    {
      Id = "Ares_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "不瞒你说，我起初并不愿置身这件事中。战争是不可避免的。我常常会推动战争的发生，不错，但此后我总会冷眼旁观。然而，这一次，我不得不破了例。"
    }
    {
      Id = "Ares_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争有时是件非常复杂的事。我可以促使战争发生，不错，但那之后，它便仿佛获得了自己的生命；或许可以比作生孩子！这样说的话，我们现在对付的这个“孩子”，不得不说是有些叛逆啊。"
    }
    {
      Id = "Ares_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "这绝不是我们的家族第一次卷入战争。然而我从未见过有哪场战争，把这么多家族成员都卷了进去！每次说起来，都觉得有些激动……"
    }
    {
      Id = "Ares_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得你使用的那些武器；辉煌的倪克斯亲口向我介绍过！我对这样的知识有着难以满足的渴求，就和这些暗夜武器在冥界受到威胁时，激发的难以满足的嗜血欲望有着异曲同工之妙。"
    }
    {
      Id = "Ares_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "以我对我弟弟赫菲斯托斯的了解，他应该能认出你手中的每一件黑暗的武器！但我则能吧鉴别它们的形态、辨别它们的意图，而且还渴望亲眼目睹它们所能造成的破坏。"
    }
    {
      Id = "Ares_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "好一件精妙的武器！石狮巨锤有着无比传奇、无比血腥的过往，而如今在你手中，它将再造杀业。我之前从不知道，它居然是暗夜武器的众多形态之一……"
    }
    {
      Id = "Ares_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的武器上的纹饰让人不禁想起女神倪克斯。我知道是她监督了暗夜武器的制造，但她还曾亲手使用过它们么……？"
    }
    {
      Id = "Ares_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "我认得出你手中那柄做工精美的镰刀；它本应是死神本尊的武器！不过在你手中，也不算是埋没了它。真是难以置信，就连塔纳托斯也疏于提防，遭了那泰坦的毒手。"
    }
    {
      Id = "Ares_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "哦，整座埃费拉城真是{#Emph}死气{#Prev}沉沉！我在这里几乎都能闻到那股腥臭了。现在那里剩下的，只有悲惨与苦难；曾经的一切，恐怕都已付之东流。"
    }
    {
      Id = "Ares_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "前一阵子，我的职责需要我外出，因为我在这座偏远的山峰上所能做的事情有限。然而现在，在家门口就够我忙的了！"
    }
    {
      Id = "Ares_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "近来有许多精彩的战事在海上开展啊，我的血亲。而你在某些方面，可谓是海上战技的领军人物了！"
    }
    {
      Id = "Ares_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "虽然我是父王与母后的长子，但我的影响力却不比弟弟妹妹们更大。我们都会为父王母后献策，但他们愿意听谁的，谁说得准呢？他们常常提醒我，在战争中，外交亦是关键的一环。"
    }
    {
      Id = "Ares_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "迄今为止，你在战场上已经斩杀了超过1000个萨提尔；仅凭一个人，就消灭了一支军队！更何况，这对于你的杀戮总量而言，仅仅只是{#Emph}冰山一角{#Prev}！"
    }
    {
      Id = "Ares_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "为了你先选谁的祝福而争吵？这种所谓的试炼毫无益处，简直莫名其妙！在这种事情上剑拔弩张，也算是我们的传统了吧！"
    }
    {
      Id = "Ares_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "在战争结束时心中五味杂陈，是再正常不过的事了！尤其是没有能以暴力的方式令我们的苦难落幕……不过，据我所知，在未来仍有许多暴力等待施行。"
    }
    {
      Id = "Ares_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "最近这场大战注定难以超越；不得不说，这其中有我们众神亲自参与其中的因素。不过，相信早晚会有一场战争能超过它！向来如此。"
    }
    {
      Id = "Ares_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们是要继续与泰坦克洛诺斯战斗，但是{#Emph}时间{#Prev}有所不同？或者，也许我该说“前提”……那些时间出现的前提，是你未能在此前取得胜利。永无止尽的战争……噢，我的血亲。"
    }
    {
      Id = "Ares_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "依你看，这些冒牌克洛诺斯，我们要消灭多少个？真难以想象，我们要将他们尽数铲除，同一时间还只能对付一个。不过，世上不会有相同的两场战斗！"
    }
    {
      Id = "Ares_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "我理解你出于某种原因，仍然可以在这里面对众魔之父！这样说来，他愤怒的灵魂仍然存在，弥留在时间的某些黑暗角落中。要是我能亲眼见证就好了！"
    }
    {
      Id = "Ares_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "命运三女神终于被找到了？而她们想要让操弄他人命运的传统告一段落？我很难完全相信这件事，然而……若是战争的胜负再也没有定数，那该是多么振奋人心。"
    }
    {
      Id = "Ares_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "没有什么比亲眼见证敌人的死状更令人满足的了，你不觉得么？"
    }
    {
      Id = "Ares_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡是泼洒鲜血之处，就算我没有直接出手，也会饶有兴致地观看。"
    }
    {
      Id = "Ares_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "凡人终有一死；我只是希望他们死得其所。"
    }
    {
      Id = "Ares_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "有些冲突只能通过暴力解决；不必压抑你内心的杀意。"
    }
    {
      Id = "Ares_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "每当死亡接踵而至时，我便会寻找其根源。而最近，我总能找到你。"
    }
    {
      Id = "Ares_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "生命犹如瘟疫一般蔓延世间，但总有办法令其增长得到控制。"
    }
    {
      Id = "Ares_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争总有尽头，但尽头的尽头，总是下一场战争。"
    }
    {
      Id = "Ares_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "敌人在你面前简直是排队赴死；次次如此，毫无长进。"
    }
    {
      Id = "Ares_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "俗话说，好了伤疤忘了疼，那便让我们再次揭开他们的伤疤。"
    }
    {
      Id = "Ares_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "流血事件常常可以避免，但我力求不放过每一个良机。"
    }
    {
      Id = "Ares_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "真是个奇妙的时代：就连死亡都无法阻止这些人重返战场。"
    }
    {
      Id = "Ares_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "在毁灭的尘埃落定之前，让我们珍惜这些时刻吧。"
    }
    {
      Id = "Ares_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "每一个战场上都有阴魂不散，不是么？也许你甚至能看到这些亡魂。"
    }
    {
      Id = "Ares_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "征战乃是我们的本性；因此，我们不该拒绝战争，反而应该拥抱它。"
    }
    {
      Id = "Ares_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "暴力不一定总能结束冲突；但战火过后，再大的冲突也会暂时偃旗息鼓。"
    }
    {
      Id = "Ares_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "我那来自地狱的血亲啊，你的每一场战斗都令人赏心悦目。"
    }
    {
      Id = "Ares_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "无数的战争失落在了时间的长河之中，但也许这一场不会那么快遭人遗忘。"
    }
    {
      Id = "Ares_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "这场战争同时席卷地表和地底……真是不凡的成就，我的血亲。"
    }
    {
      Id = "Ares_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "这场恶战无需只因仇恨延续；让我们师出有名的，还有无数理由。"
    }
    {
      Id = "Ares_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "有些人居然厌恶我的工作！你已亲眼见证，自然知晓真相。"
    }
    {
      Id = "Ares_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "还有这么多场仗要打！战争有时会让人应接不暇，这点我是知道的。"
    }
    {
      Id = "Ares_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争的胜利总是苦乐参半；但世间万物，最宝贵的部分往往不在其终结。"
    }
    {
      Id = "Ares_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的工作有的时候看似不会有圆满的结局，但也许你逐渐会像我一样，意识到事实并非如此。"
    }
    {
      Id = "Ares_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的效率着实令人钦佩，但别忘记在风暴过后，花些时间细细品味那份清净。"
    }
    {
      Id = "Ares_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "每一夜都是新的机会，供我们尝试新的杀戮手段。"
    }
    {
      Id = "Ares_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "对于最宏大的冲突，我总是愿意出手相助，让冲突有个合情合理的结果。"
    }
    {
      Id = "Ares_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们都有战斗的欲望，难道不是么？我不过是希望我们对自己多一些坦诚。"
    }
    {
      Id = "Ares_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "你今夜的战斗刚刚开始，而我一次杀戮也不愿错过。"
    }
    {
      Id = "Ares_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果今夜注定要流血，那就不要让任何一滴血白流。"
    }
    {
      Id = "Ares_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "倘若不通过暴力，我们如何能统治这个世界？"
    }
    {
      Id = "Ares_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "严格来说，暴力通常并非必要，但它总是管用。"
    }
    {
      Id = "Ares_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "那些口口声声说着暴力不解决问题的人，一定从来没有亲自尝试过！"
    }
    {
      Id = "Ares_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "愿你能全凭自己的心意，选择最为高效或是最为残忍的手段，斩杀所有敌对之人。"
    }
    {
      Id = "Ares_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "大地豪饮着你洒下的鲜血；愿你能消解她的干渴。"
    }
    {
      Id = "Ares_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "你父亲的界域中，有许多敌人缺少血肉，但也只能将就一下了。"
    }
    {
      Id = "Ares_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的战争居然能在大地之下打响，真是令人兴奋的时代！"
    }
    {
      Id = "Ares_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "你想要再次杀出一条血路，登上我们的神山么？我绝不能错过这场好戏！"
    }
    {
      Id = "Ares_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "泰坦军团的残部仍有着对战斗的渴望，我看不如遂了他们的愿。"
    }
    {
      Id = "Ares_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争从不属于软弱之人，不过我看得出你陶醉其中。"
    }
    {
      Id = "Ares_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "看到你打算用何种手段对付你的敌人，是我夜夜期待的环节！"
    }
    {
      Id = "Ares_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许今夜我们某种振奋士气的战吼，我的血亲。你觉得{#Emph}“杀光他们”{#Prev}如何？"
    }
    {
      Id = "Ares_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊！看起来这则神谕以完全保密的形式传递成功了！我们应该多采取这样的防范措施，不过也许这会影响你做出规划的能力。"
    }
    {
      Id = "Ares_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "以这种方式联络到我，也不必惊讶。我们的家人常常喜欢更为直接的手段，但我对藏身阴影之中并不抵触；事实上，我对此颇为享受。"
    }
    {
      Id = "Ares_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "在战争中，我们必须为一切可能做足准备。这原本可能是另一位血亲的祝福，但我眼疾手快，斩钉截铁地代其采取了行动。"
    }
    {
      Id = "Ares_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "我们的祝福难以抗拒，不是么？就算不知道祝福是什么，甚至不知道祝福来自谁，你都仍然愿意支付摆渡人的价码。"
    }
    {
      Id = "Ares_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "这个船夫虽然不再为冥界运送亡魂，但他在这场战争中发挥的作用不容小觑。那柄船桨在他手中，有如神兵利器！"
    }
    {
      Id = "Ares_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "以前有的时候，我会亲自支付摆渡亡魂的费用，毕竟我一次就要往冥界输送一大批亡魂！真怀念啊。"
    }
    {
      Id = "Ares_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "兵马未动，粮草先行；倘若补给线长期受到骚扰，前线的将士便将不战自溃。因此，我很感激你的这位摆渡人，因为若不是他，我便永远无法像现在这样找到你。"
    }
    {
      Id = "Ares_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "黄金真是一种神奇的金属，不是么？凡人常常为了它自相残杀。能让他们更加着迷的，只有你父亲领地中最为珍稀的宝石！"
    }
    {
      Id = "Ares_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "你明白这意味着什么，对吧，我的血亲？相信我无需多言。"
    }
    {
      Id = "Ares_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "即使更为微不足道的小事，也曾成为战争的导火索；事实上，战争往往不需要什么理由。"
    }
    {
      Id = "Ares_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "也许这不过是一场误会，但我向来睚眦必报。"
    }
    {
      Id = "Ares_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "我其他的血亲有时也会这样将我置之不顾；看看他们如今落入了什么境地。"
    }
    {
      Id = "Ares_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果你真的想要与我开战，那我乐意之至。"
    }
    {
      Id = "Ares_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的血亲，我非常理解你；毫无回旋余地，只能被迫选择立场，然后承受另一方的怒火。"
    }
    {
      Id = "Ares_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的血亲啊，我本想说被迫与你刀剑相向不会令我感到快乐，可我不愿撒谎。"
    }
    {
      Id = "Ares_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "我对你的决定并不反感；事实上，我对此很是感激，因为这意味着我可以{#Emph}这样{#Prev}。"
    }
    {
      Id = "Ares_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "曾经有人不选我而选了我的好弟弟；那一次我很不好受。"
    }
    {
      Id = "Ares_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "如果我是你，也会做出相似的选择，但轻慢我总要付出代价。"
    }
    {
      Id = "Ares_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "站在阿弗洛狄忒那边是明智的选择，但就现在来说，这也意味着与{#Emph}我{#Prev}为敌。"
    }
    {
      Id = "Ares_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "或许是个精心考虑后的选择，但这不意味着你能逃脱残酷的后果。"
    }
    {
      Id = "Ares_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "如此表现，不愧和我是一家人！应该给你个奖励。"
    }
    {
      Id = "Ares_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "我有时喜欢给占据下风的人尝尝甜头，为他们营造出虚假的希望。"
    }
    {
      Id = "Ares_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "你说，你刚刚面对的那些愚蠢的敌人，会不会以为能将你拿下？"
    }
    {
      Id = "Ares_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "偶尔露出獠牙，正是我们立威的方法，我的血亲。"
    }
    {
      Id = "Ares_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "还有这么多场仗要打，可我有的时候实在控制不住自己……"
    }
    {
      Id = "Ares_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "啊，真是精彩，不过今夜最为精彩的战斗或许还在后面。"
    }
    {
      Id = "Ares_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "你满足了我复仇的欲望，或者至少满足了我对鲜血的渴望。暂时如此。"
    }
    {
      Id = "Ares_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "我感应到，这场冲突除你之外无人生还。令人满意的结果。"
    }
    {
      Id = "Ares_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争的胜利者，自然应当得到奖励。而我也欣赏到了一场精彩的演出。"
    }
    {
      Id = "Ares_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "我的工作有时需要我与自己的血亲为敌。你肯定能理解，对吧？"
    }
    {
      Id = "Ares_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "这不过是场无足轻重的混战，但就算如此，也看得我赏心悦目。"
    }
    {
      Id = "Ares_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "你的敌人坚信自己有机会战胜你；如此乐观的精神，实在耐人寻味。"
    }
    {
      Id = "MelinoeField_2962"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿瑞斯大人，我知道凡间的战士在冲锋陷阵之前，常常会向你献上祭礼。我也想以这样的方式，向你表示我的敬意。愿我们将敌人斩尽杀绝！"
    }
    {
      Id = "Ares_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "如此大礼，我自然要予以回报；更何况送上礼物的你，还如此懂得我工作的意义。这份礼物送给你这样的人型武器正合适。"
    }
    {
      Id = "MelinoeField_2964"
      InheritFrom = "BaseNarrative"
      DisplayName = "我还需战斗多久，不由我自己决定；但是，知道我每一场战斗都有你的支持，对我意义非凡，大人。愿我们能早日达成目的，赢得胜利。"
    }
    {
      Id = "Ares_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "如此上等的蜜露，往往要留到胜利时享用。不过，从许多方面而言，我感觉我们就和已经赢了一样！至少对我来说是这样，所以我会找个时间好好享用的。"
    }
    {
      Id = "MelinoeField_2965"
      InheritFrom = "BaseNarrative"
      DisplayName = "战争总有结束的一天，但我们永远是家人，对么，大人？希望这件小小的礼物足以表示，我们之间的纽带不仅仅是战争的激情。"
    }
    {
      Id = "Ares_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "这瓶蜜露固然品质上乘，我对此不胜感激，但你送给我的礼物远比它来的贵重。你迄今为止所造成的杀戮……再没有礼物能与之媲美。"
    }
    {
      Id = "MelinoeField_3378"
      InheritFrom = "BaseNarrative"
      DisplayName = "有时，战争的刺激会让我陷入其中，无法自拔；这种感觉我曾经想要抑制。而现在，我明白它能引我走向胜利……以及走向你，阿瑞斯大人。"
    }
    {
      Id = "Ares_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "我曾以为这一家人中，再没有人与我志趣相投。很高兴看到我大错特错。每当你心中燃起杀伐之欲时，我一定会与你同在。"
    }
    {
      Id = "MelinoeField_3669"
      InheritFrom = "BaseNarrative"
      DisplayName = "在我与您相遇之前，我完全不知道该作何期待，阿瑞斯大人。但我发现，比起他人，你身上有着一种独特的坦率。谢谢您始终对我毫无隐瞒。"
    }
    {
      Id = "Ares_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "我必须承认，出于我的性情，我不常会收到这样的献礼。许多人{#Emph}很容易{#Prev}便会感到不安，无法欣赏他人的坦率，又或者无法容忍他人的雅致。然而，你看来却并非如此，我的血亲。"
    }
    {
      Id = "MelinoeField_3670"
      InheritFrom = "BaseNarrative"
      DisplayName = "阿瑞斯大人，我想知道，如果战争双方的凡人都向你祈求胜利的话，你会如何选择祝福哪一方呢？当然，我相信这件礼物不会让您陷入这种困境。"
    }
    {
      Id = "Ares_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "这些礼物的作用也有限度。凡人以为赢得我的恩赐就可以赢下战争，但实际上决定他们能在战场上厮杀多久的，主要是他们自己的意志。很高兴能和你分享这些琐碎的细节！"
    }
    {
      Id = "MelinoeField_3671"
      InheritFrom = "BaseNarrative"
      DisplayName = "这一瓶仙酒敬你过去与未来的所有胜利，阿瑞斯大人！但它的意义不止如此……我知道你也会在苦涩的失利中学习。在这一方面，我觉得我们格外相像。"
    }
    {
      Id = "Ares_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "我也深有同感，我诞生于地狱的血亲。我们的家族总是过于看重胜利，因而在面对失败时往往惭愧难当，不愿从中深挖教训。在这件事，以及许多其他事上，我都很庆幸家族之中能有你这个例外。"
    }
    {
      Id = "MelinoeField_2963"
      InheritFrom = "BaseSubtitle"
      DisplayName = "那我就收下了，大人。"
    }
    {
      Id = "Ares_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "血流漂杵！"
    }
    {
      Id = "Ares_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "战个痛快吧！"
    }
    {
      Id = "Ares_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "暴力与破坏！"
    }
    {
      Id = "Ares_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "血流成河！"
    }
    {
      Id = "Ares_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "卑鄙小人，死有余辜！"
    }
    {
      Id = "Ares_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "真是无礼！"
    }
    {
      Id = "Ares_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "敢轻视我，就要付出代价！"
    }
    {
      Id = "ErisField_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "刚才那是{#Emph}阿瑞斯{#Prev}吗？！"
    }
    {
      Id = "ErisField_0478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}阿瑞斯{#Prev}，是你吗？！"
    }
    {
      Id = "Chronos_1269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "手段狠辣的战神……"
    }
    {
      Id = "Chronos_1270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿瑞斯从没见过真正的战争……"
    }
    {
      Id = "Zagreus_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿瑞斯，{#Emph}是我啊！"
    }
    {
      Id = "Zagreus_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "阿瑞斯，{#Emph}别这样……！"
    }
    {
      Id = "Ares_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你要么是我的盟友，要么是我的敌人，血亲。除此之外别无选择。"
    }
    {
      Id = "Ares_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "你一定以为自己会赢下这场小小战争。"
    }
    {
      Id = "Ares_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "冷酷无情乃是我的天性，难道你不清楚么？"
    }
    {
      Id = "Ares_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "当然。"
    }
    {
      Id = "Ares_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这是自然。"
    }
    {
      Id = "Ares_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "很好。"
    }
    {
      Id = "Ares_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "如你所愿。"
    }
    {
      Id = "Ares_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "依你所愿。"
    }
    {
      Id = "Ares_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好。"
    }
    {
      Id = "Ares_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "好了。"
    }
    {
      Id = "Ares_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "这样么？"
    }
    {
      Id = "Ares_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "向你致意。"
    }
    {
      Id = "Ares_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "啊，正合我意。"
    }
    {
      Id = "Ares_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "终于来了。"
    }
    {
      Id = "Ares_0123"
