      InheritFrom = "BaseSubtitle"
      DisplayName = "你在这啊。"
    }
    {
      Id = "MelinoeField_3529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}我见你伸展四条臂膀，播撒喜乐与毁灭……"
    }
    {
      Id = "Selene_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一位神明可能与你在道路尽头相逢……"
    }
    {
      Id = "Selene_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "一位女神可能与你在道路尽头相逢……"
    }
    {
      Id = "Selene_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "见证吧。"
    }
    {
      Id = "Selene_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "请做出选择吧。"
    }
    {
      Id = "Selene_0178"
