      DisplayName = "{#Emph}万象之鼎，亡者之灵，\n {#Emph}听我言语，塑愿成形。"
    }
    {
      Id = "Melinoe_0529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}混沌之源，听我一言，\n {#Emph}彰显潜能，遂我心愿。"
    }
    {
      Id = "Melinoe_0530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}明月之光，骸骨之霜，\n {#Emph}入我锅釜，醒转异象。"
    }
    {
      Id = "Melinoe_0531"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}白云苍狗，石火电光，\n {#Emph}成我魔咒，现我念想。"
    }
    {
      Id = "Melinoe_1078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}地灵夜灵，应我敬恳，\n {#Emph}止我痛苦，振我精神！"
    }
    {
      Id = "Melinoe_1079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}服我神权，听我号令：\n {#Emph}至黑之黯，助我使命。"
    }
    {
      Id = "Melinoe_1080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}冥界众灵，尊我神威：\n {#Emph}凡我所需，速速齐备！"
    }
    {
      Id = "Melinoe_1081"
      InheritFrom = "BaseSubtitle"
