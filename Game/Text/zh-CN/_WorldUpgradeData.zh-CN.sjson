      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}水仙之池，复归清明，\n{#Emph}莫再浑浊，还他安宁。"
    }
    {
      Id = "Melinoe_3505"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}众神祝福，我将洞悉；\n {#Emph}元素奥秘，助我克敌。"
    }
    {
