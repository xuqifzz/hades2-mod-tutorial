      DisplayName = "没有效果么……？"
    }
    {
      Id = "Melinoe_1598"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我想，现在我知道该如何为命运三女神效力了……"
    }
    {
      Id = "Melinoe_1595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}毁灭之神，听我呼唤，\n{#Emph}我祈求您的帮助，无论您身在何处。"
    }
    {
      Id = "Melinoe_1597"
      InheritFrom = "BaseSubtitle"
      DisplayName = "……摩罗斯大人，您究竟身在何处……？"
    }
    {
      Id = "Hecate_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "有些时候，事情就是这样的。"
    }
    {
      Id = "Melinoe_2823"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}克洛诺斯必死无疑……{#Prev}一定有什么办法……"
    }
    {
      Id = "Melinoe_1346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我得自己开辟一条通往地面世界的路……"
    }
    {
      Id = "Melinoe_2575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}保护我的咒语就此解消，\n{#Emph}因为我已准备好上天入地，哪怕千里迢迢！"
    }
    {
      Id = "Melinoe_1347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "我能在地面世界抑制住病症吗？"
    }
    {
      Id = "Melinoe_2576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}命运束缚我的鲜血，鲜血却仍自由流淌；\n{#Emph}请让我像鲜血一样，在那地表自由闯荡！"
    }
    {
      Id = "Melinoe_3071"
      InheritFrom = "BaseSubtitle"
