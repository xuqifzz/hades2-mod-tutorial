      InheritFrom = "BaseSubtitle"
      DisplayName = "暗夜武器似乎仍然有所保留……"
    }
    {
      Id = "Melinoe_2574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}既然暗夜武器注定为我醒来，\n{#Emph}请让我看清它们暗藏的形态！"
    }
    {
      Id = "Melinoe_3488"
