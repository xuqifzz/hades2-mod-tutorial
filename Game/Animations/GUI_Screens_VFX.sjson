{ Animations = [

	/* Start / End Screen */

	
	{
		Name = "MainMenuIn"
		ChainTo = "MainMenuLoop"
		FilePath = "Screens\MainMenu\MainMenu"			
		VideoTexture = "MainMenu"
		EndFrame = 90
		NumFrames = 90
		PlaySpeed = 30.0
		StartFrame = 1
		Ambient = 0.0
		OnlyWhenVisible = true
		HoldLastFrame = false
		Slides =
		[
			{ DurationFrames = 1 Sound = "/SFX/IrisMainMenuSFX" Frame = 1 }
			{ DurationFrames = 1 Sound = "/SFX/Menu Sounds/MenuMagicFlashMainMenu" Frame = 43 }
		]
	}

	{
		Name = "MainMenuLoop"
		InheritFrom = "MainMenuIn"
		FilePath = "Screens\MainMenu\MainMenu"
		VideoTexture = "MainMenu"
