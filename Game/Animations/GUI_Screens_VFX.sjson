{ Animations = [

	/* Start / End Screen */
	
	{
		Name = "MainMenuIn"
		ChainTo = "MainMenuLoop"
		FilePath = "Screens\MainMenuIn\MainMenuIn"			
		VideoTexture = "MainMenuIn"
		EndFrame = 90
		NumFrames = 90
		PlaySpeed = 30.0
		StartFrame = 1
		Ambient = 0.0
		OnlyWhenVisible = true
		HoldLastFrame = false
		Slides =
		[
			{ DurationFrames = 1 Sound = "/SFX/IrisMainMenuSFX" Frame = 1 }
		]
	}

	{
		Name = "MainMenuLoop"
		InheritFrom = "MainMenuIn"
		FilePath = "Screens\MainMenuLoop\MainMenuLoop"
		VideoTexture = "MainMenuLoop"
		ClearSlides = true
		Loop = true
		ChainTo = null
		PlaySpeed = 30
		ChildAnimation = "MainMenuMelHair"
	}

	{
		Name = "MainMenuMel"
